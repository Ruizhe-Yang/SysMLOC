//grammar dut.control.sysmloc.SysMLOC hidden(WS, ML_NOTE, SL_NOTE)
grammar dut.control.sysmloc.SysMLOC hidden(WS)

import "http://www.eclipse.org/emf/2002/Ecore" as Ecore

generate sysMLOC "http://www.control.dut/sysmloc/SysMLOC"
 
Namespace:
	(intro+=CodeAnnotation)?
	(packages+=Package)*
;

Package:
    'package' 
    declaredName=QualifiedName 
    '{' (elements+=PackageBodyElement)* '}'
;

// TODO --------------------------------- Body Level ---------------------------------//

PackageBodyElement:
    Package
    | AnnotatingElement 
    | DefinitionElement
    | UsageElement
//  | ElementFilterMember
    | AliasElement
    | ImportElement
    | CodeAnnotation
;

DefinitionBodyElement:
	AnnotatingElement
    | ImportElement
    | DefinitionElement
    | UsageElement
    | AliasElement
    | CodeAnnotation
;

UsageBodyElement:
	DefinitionBodyElement
;

InterfaceBodyElement:
	UsageBodyElement
;

EnumerationBodyElement:
	AnnotatingElement
	| EnumerationElement
;

ActionBodyElement:
	AnnotatingElement
	| ImportElement
	| AliasElement
	| DefinitionElement
//	| VariantUsageMember
	| NonOccurrenceUsageElement
	| StructureUsageElement
	| InitialNodeElement
	| BehaviorUsageElement 
	| ActionNodeElement
	| GuardedSuccessionNodeElement
	| TargetSuccessionNodeElement
    | CodeAnnotation
;

CalculationBodyElement:
	ActionBodyElement
;

StateBodyElement:
	AnnotatingElement
	| ImportElement
	| AliasElement
	| DefinitionElement
//	| VariantUsageMember
	| NonOccurrenceUsageElement
	| StructureUsageElement
	| BehaviorUsageElement
	| TransitionUsageElement
	| EntryActionNodeElement
	| DoActionNodeElement
	| ExitActionNodeElement
    | CodeAnnotation
;

AnnotatingBodyElement:
	AnnotatingElement
	| CodeAnnotation
;

ActionNodeBodyElement:
	AnnotatingElement
	| CodeAnnotation
;

// TODO --------------------------------- Abstract Level ---------------------------------//
// Annotating

AnnotatingElement:
	Comment
	| Documentation
	| TextualRepresentation
//	| MetadataUsage
;

// Importing

ImportElement:
	=> NamespaceImport
	| MembershipImport
;

// Definitions

DefinitionElement:
	AttributeDefinition
	| EnumerationDefinition
	| OccurrenceDefinition
	| IndividualDefinition
	| ItemDefinition
//	| MetadataDefinition
	| PartDefinition
	| ConnectionDefinition
	| FlowConnectionDefinition
	| InterfaceDefinition
//	| AllocationDefinition
	| PortDefinition
	| ActionDefinition
	| CalculationDefinition
	| StateDefinition
	| ConstraintDefinition
//	| RequirementDefinition
//	| ConcernDefinition
//	| CaseDefinition
//	| AnalysisCaseDefinition
//	| VerificationCaseDefinition
//	| UseCaseDefinition
//	| ViewDefinition
//	| ViewpointDefinition
//	| RenderingDefinition
//	| ExtendedDefinition
;

// Usages

UsageElement:
	NonOccurrenceUsageElement 
	| OccurrenceUsageElement
;

NonOccurrenceUsageElement:
	DefaultReferenceUsage
	| ReferenceUsage
	| AttributeUsage
	| EnumerationUsage
	| BindingConnectorAsUsage
	| SuccessionAsUsage
//	| ExtendedUsage
	
;

OccurrenceUsageElement:
	StructureUsageElement 
	| BehaviorUsageElement
;

StructureUsageElement:
	OccurrenceUsage
	| IndividualUsage
	| PortionUsage
	| EventOccurrenceUsage
	| ItemUsage
	| PartUsage
//	| ViewUsage
//	| RenderingUsage
	| PortUsage
	| ConnectionUsage
	| InterfaceUsage
//	| AllocationUsage
	| Message
	| FlowConnectionUsage
	| SuccessionFlowConnectionUsage
;

BehaviorUsageElement:
	ActionUsage
	| CalculationUsage
	| StateUsage
	| ConstraintUsage
//	| RequirementUsage
//	| ConcernUsage
//	| CaseUsage
//	| AnalysisCaseUsage
//	| VerificationCaseUsage
//	| UseCaseUsage
//	| ViewpointUsage
	| PerformActionUsage
	| ExhibitStateUsage
//	| IncludeUseCaseUsage
	| AssertConstraintUsage
//	| SatisfyRequirementUsage
;

EnumerationElement:
	EnumeratedValue
;

InitialNodeElement:
	InitialNode
;

ActionNodeElement:
	SendNode
	| AcceptNode
	| AssignmentNode 
	| IfNode 
	| WhileLoopNode 
	| ForLoopNode
	| TerminateNode
	| MergeNode
	| DecisionNode
	| JoinNode
	| ForkNode
;

GuardedSuccessionNodeElement:
	GuardedSuccessionElement
;

TargetSuccessionNodeElement:
	TargetSuccessionElement
;

TransitionUsageElement:
	TransitionUsage
;

EntryActionNodeElement:
	EntryAction
;

DoActionNodeElement:
	DoActionNode
;

ExitActionNodeElement:
	ExitActionNode
;

// TODO --------------------------------- Instance Level ---------------------------------//
NamespaceImport:
    visibility=VisibilityIndicator 'import' (isImportAll?='all')? declaredName=QualifiedName '::' ( '*' | isRecursive ?= '**' )? ';'
;

MembershipImport:
	visibility=VisibilityIndicator 'import' (isImportAll?='all')? declaredName=QualifiedName ( '*' | isRecursive ?= '**' )? ';'
;
    
CodeAnnotation:
    body=SL_NOTE | body=ML_NOTE
;

Comment:
	( 'comment' Identification? 
	  ('about' annotatedElement += QualifiedName
	     ( ',' annotatedElement += QualifiedName )* )? 
	)?
    ( 'locale' locale = STRING_VALUE )?
    body=REGULAR_COMMENT
;

Documentation:
    'doc' Identification? 
    ( 'locale' locale = STRING_VALUE )?
    body=REGULAR_COMMENT
;

TextualRepresentation:
    ( 'rep' Identification? )?
    'language' language = STRING_VALUE 
    body = REGULAR_COMMENT
;

DefaultReferenceUsage:
    MemberPrefix
    isReturnPrefix
    ( isEnd ?= 'end' )?
    RefPrefix
    UsageDeclaration
    ValuePart?
     (';' | '{' (elements+=UsageBodyElement)* '}')
;

ReferenceUsage:
    MemberPrefix
    isReturnPrefix
    ( EndUsagePrefix | RefPrefix) 
    'ref'
    Usage
     (';' | '{' (elements+=UsageBodyElement)* '}')
;

AttributeDefinition:
	MemberPrefix DefinitionPrefix 'attribute' 'def' DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

AttributeUsage:
    MemberPrefix
    isReturnPrefix
    UsagePrefix 'attribute' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

EnumerationDefinition:
	MemberPrefix
//	DefinitionExtensionKeyword*
	'enum' 'def' DefinitionDeclaration
	(';' | '{' (elements+=EnumerationBodyElement)* '}')
;

EnumeratedValue:
	MemberPrefix
	UsageExtensionKeyword*
	'enum'? Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

EnumerationUsage:
	MemberPrefix
	isReturnPrefix
	UsagePrefix 'enum' Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

BindingConnectorAsUsage:
	MemberPrefix
	isReturnPrefix
	UsagePrefix 
	( 'binding' UsageDeclaration? )?
	'bind' connectorPart += ConnectorEnd '=' connectorPart += ConnectorEnd
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

SuccessionAsUsage:
	MemberPrefix
	isReturnPrefix
	UsagePrefix
	( 'succession' UsageDeclaration? )? 
	'first' connectorPart += ConnectorEnd
	'then' connectorPart += ConnectorEnd
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;


OccurrenceDefinition:
	MemberPrefix OccurrenceDefinitionPrefix 'occurrence' 'def' DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

OccurrenceUsage:
	EmptySuccessionPrefix
    MemberPrefix
    isReturnPrefix
    OccurrenceUsagePrefix 'occurrence' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

PortionUsage:
	EmptySuccessionPrefix
	MemberPrefix 
	isReturnPrefix
	BasicUsagePrefix ( isIndividual ?= 'individual' )? portionKind = PortionKind
	UsageExtensionKeyword*
	Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

EventOccurrenceUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix
    OccurrenceUsagePrefix 'event'
    ( ReferenceSubsetting FeatureSpecializationPart? | 'occurrence' UsageDeclaration? )
    ValuePart? 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

IndividualDefinition:
	MemberPrefix
	BasicDefinitionPrefix? 
	isIndividual ?= 'individual' 
	UsageExtensionKeyword*
	'def' 
	DefinitionDeclaration
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

IndividualUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	BasicUsagePrefix 
	isIndividual ?= 'individual' 
	UsageExtensionKeyword* 
	Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

ItemDefinition:
    MemberPrefix OccurrenceDefinitionPrefix 'item' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ItemUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix
    OccurrenceUsagePrefix 'item' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

PartDefinition:
    MemberPrefix OccurrenceDefinitionPrefix 'part' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

PartUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix
    OccurrenceUsagePrefix 'part' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

PortDefinition:
    MemberPrefix DefinitionPrefix 'port' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

PortUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix
    OccurrenceUsagePrefix 'port' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

ConnectionDefinition:
	MemberPrefix OccurrenceDefinitionPrefix 'connection' 'def' DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix 
	isReturnPrefix
	OccurrenceUsagePrefix
	('connection' UsageDeclaration? FeatureValue? ('connect' ConnectorPart)?
	 | 'connect' ConnectorPart) 
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

InterfaceDefinition:
	MemberPrefix OccurrenceDefinitionPrefix 'interface' 'def' DefinitionDeclaration 
	(';' | '{' (elements += DefinitionBodyElement)* '}')
;

InterfaceUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'interface' 
	(UsageDeclaration? ('connect' ConnectorPart )? | ConnectorPart) 
	(';' | '{' (elements+=InterfaceBodyElement)* '}')
;

Message:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix 'message' 
	UsageDeclaration? ValuePart?
	( 'of' ItemFeatureParameterPart )?
    ( 'from'? FlowEnd += FeatureChainName 'to' FlowEnd += FeatureChainName )?
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

FlowConnectionDefinition:
	MemberPrefix 
	OccurrenceDefinitionPrefix 
	'flow' 'def' 
	DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

FlowConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'flow' 
	UsageDeclaration? FeatureValue?
	( 'of' ItemFeatureParameterPart )?
    ( 'from'? FlowEnd += FeatureChainName 'to' FlowEnd += FeatureChainName )?
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

ItemFeatureParameter:
	PayloadFeature
;

SuccessionFlowConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'succession' 'flow'
	UsageDeclaration? FeatureValue?
	( 'of' ItemFeatureParameterPart )?
    ( 'from'? FlowEnd += FeatureChainName 'to' FlowEnd += FeatureChainName )?
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ActionDefinition:
	MemberPrefix
	OccurrenceDefinitionPrefix 'action' 'def' DefinitionDeclaration
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

ActionUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix 
    OccurrenceUsagePrefix 'action' ActionUsageDeclaration 
    (';' | '{' (elements+=ActionBodyElement)* '}')
;

CalculationDefinition:
	MemberPrefix
	OccurrenceDefinitionPrefix 'calc' 'def' DefinitionDeclaration
	(';' | '{' => ( elements+=CalculationBodyElement )* (resultExpressionParameter+=ResultExpression)? '}')  
;

CalculationUsage:
	EmptySuccessionPrefix
    MemberPrefix isReturnPrefix 
    OccurrenceUsagePrefix 'calc' ActionUsageDeclaration 
	(';' | '{' => ( elements+=CalculationBodyElement )* (resultExpressionParameter+=ResultExpression)? '}')  
;

StateDefinition:
	MemberPrefix 
	OccurrenceDefinitionPrefix 
	'state' 'def'
	DefinitionDeclaration
	(';' | ( isParallel ?= 'parallel' )? '{' (elements += StateBodyElement)* '}')
;

StateUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'state'
	ActionUsageDeclaration
	(';' | ( isParallel ?= 'parallel' )? '{' (elements += StateBodyElement)* '}')
;

ConstraintDefinition:
	MemberPrefix 
	OccurrenceDefinitionPrefix 
	'constraint' 'def' 
	DefinitionDeclaration
	(';' | '{' => ( elements+=CalculationBodyElement )* (resultExpressionParameter+=ResultExpression)? '}')  
;

ConstraintUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'constraint'
	ConstraintUsageDeclaration
	(';' | '{' => ( elements+=CalculationBodyElement )* (resultExpressionParameter+=ResultExpression)? '}')  
;


TransitionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
			
//	'transition'
//	( UsageDeclaration? 'first' )? 
//	transitionSourceElement=FeatureChainName
//	('accept' AcceptParameterPart)?
//	('if' conditionalExpression=Expression)?
////	('do' PerformedActionParameterPart=PerformedActionUsage ( '{' elements+=ActionBodyElement* '}' )?)?
//	('do' PerformedActionParameterPart ( '{' elements+=ActionBodyElement* '}' )?)?

	(	
		'transition'
		( UsageDeclaration? 'first' )? 
		( transitionSourceElement=FeatureChainName)?
		('accept' AcceptParameterPart)?
		('if' conditionalExpression=Expression)?
		('do' PerformedActionParameterPart ( '{' elements+=ActionBodyElement* '}' )?)?
	|	'accept' AcceptParameterPart
		('if' conditionalExpression=Expression)?
		('do' PerformedActionParameterPart ( '{' elements+=ActionBodyElement* '}' )?)?
	| 	'if' conditionalExpression=Expression
		('do' PerformedActionParameterPart ( '{' elements+=ActionBodyElement* '}' )?)?
	)?
	
	'then' TransitionSuccession
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

PerformActionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix 'perform' 
	( ReferenceSubsetting FeatureSpecializationPart? | 'action' UsageDeclaration? )
    ValuePart?
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

ExhibitStateUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix 'exhibit'
	( ReferenceSubsetting FeatureSpecializationPart? | 'state' UsageDeclaration? )
    ValuePart?
	(';' | ( isParallel ?= 'parallel' )? '{' (elements+=StateBodyElement)* '}')
;

AssertConstraintUsage:
	EmptySuccessionPrefix
	MemberPrefix
	isReturnPrefix
	OccurrenceUsagePrefix
	'assert' 
	( isNegated ?= 'not' )?
	( ReferenceSubsetting FeatureSpecializationPart? | 'constraint' ConstraintUsageDeclaration)
	(';' | '{' => ( elements+=CalculationBodyElement )* (resultExpressionParameter+=ResultExpression)? '}')  
;

ResultExpression:
	MemberPrefix resultExpression=Expression
;

AliasElement:
	MemberPrefix 'alias' ( '<' memberShortName = Name '>' )? ( memberName = Name )? 
	'for' memberElement = QualifiedName
	(';' | '{' (elements+=AnnotatingBodyElement)* '}')
;

ConnectorEnd:
	MultiplicityRange?
	( delcaredName = Name ('::>' | 'references') )?
	ReferenceSubsetting
;

InitialNode:
	MemberPrefix 'first' memberElement = QualifiedName
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

SendNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration?
	'send'
	sendNodeParameter?=Expression
	('via' viaNodeParameter=Expression)?
	('to' toNodeParameter=Expression)?
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

AcceptNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration? 
	'accept' 
	AcceptParameterPart
	(';' | '{' (elements+=ActionBodyElement)* '}')
; 

PayloadParameter:
	( PayloadFeature | Identification? PayloadFeatureSpecializationPart? TriggerValuePart)
	('via' viaNodeParameter=Expression)?
;

AssignmentNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	AssignmentNodeDeclaration
	(';' | '{' (elements+=ActionBodyElement)* '}')
; 

IfNode:
	EmptySuccessionPrefix
	MemberPrefix
	ActionNodePrefix
	'if'
	ifConditionExpression = Expression
	(('action' actionParameterEnd+=ActionParameterEnd )? '{' (elements+=ActionBodyElement)* '}'
	| 'then' TransitionSuccession (';' | '{' (elements+=UsageBodyElement)* '}'))
	( 'else' 
		(('action' actionParameterEnd+=ActionParameterEnd )? '{' (elements+=ActionBodyElement)* '}'
		| elseNode+=IfNode))?
; 

WhileLoopNode:
	EmptySuccessionPrefix
	MemberPrefix
	ActionNodePrefix
	('while' whileConditionExpression = Expression | 'loop' )
	('action' actionParameterEnd+=ActionParameterEnd )?
	'{' (elements+=ActionBodyElement)* '}'
	( 'until' untilConditionExpression = Expression ';' )?
; 

MergeNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'merge' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

DecisionNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'decide' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

JoinNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'join' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

ForkNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'fork' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

ActionParameterEnd:
	UsageDeclaration
;

ForLoopNode:
	EmptySuccessionPrefix
	MemberPrefix 
	ActionNodePrefix
	'for' ForVariableParameter=ForVariableParameter
	'in' NodeParameter=Expression
	('action' actionParameterEnd+=ActionParameterEnd )?
	'{' (elements+=ActionBodyElement)* '}'
;

ForVariableParameter:
	UsageDeclaration
;

TerminateNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration?
	'terminate'
	NodeParameter?=Expression
	(';' | '{' (elements+=ActionBodyElement)* '}')
;


GuardedSuccessionElement:
	( 'succession' UsageDeclaration )?
	'first'
	memberElement = FeatureChainName
	'if' conditionalExpression=Expression
	'then'
	TransitionSuccession
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

TargetSuccessionElement:
	MemberPrefix
	( TargetSuccession
//	| GuardedTargetSuccession 
	| DefaultTargetSuccession
	)
	(';' | '{' (elements+=UsageBodyElement)* '}')
//	MemberPrefix
//	((( TargetSuccession | DefaultTargetSuccession) (';' | '{' (elements+=UsageBodyElement)* '}'))
//	| GuardedTargetSuccession ';')
;


EntryAction:
	MemberPrefix
	'entry'
	PerformedActionParameterPart?
	( ';' | '{' elements+=ActionBodyElement* '}' )
//	( ownedRelationship += EntryTransitionMember )*
;

DoActionNode:
	MemberPrefix
	'do'
	PerformedActionParameterPart?
	( ';' | '{' elements+=ActionBodyElement* '}' )
;

ExitActionNode:
	MemberPrefix
	'exit'
	PerformedActionParameterPart?
	( ';' | '{' elements+=ActionBodyElement* '}' )
;


PerformedActionUsage:
	{PerformActionUsage} PerformActionUsageDeclaration
	| {AcceptActionUsage} AcceptNodeDeclaration
	| {SendActionUsage} SendNodeDeclaration
	| {AssignmentActionUsage} AssignmentNodeDeclaration
;

// TODO --------------------------------- Fragment Level ---------------------------------//

fragment UsageExtensionKeyword:
	'#' UsageExtension += QualifiedName
;

fragment EmptySuccessionPrefix:
	( isThen ?= 'then' )?
	( '[' ThenMultiplicity += MultiplicityExpression ']' | '[' ThenMultiplicity += MultiplicityExpression '..' ThenMultiplicity += MultiplicityExpression ']')?
;

fragment MultiplicityRange:
	'[' Multiplicity += MultiplicityExpression ']' | '[' Multiplicity += MultiplicityExpression '..' Multiplicity += MultiplicityExpression ']'
;

fragment ValuePart:
	FeatureValue
;

fragment MemberPrefix:
	( visibility = VisibilityIndicator )?
;

fragment isReturnPrefix:
	( isReturn ?= 'return' )?
;

fragment DefinitionPrefix:
	BasicDefinitionPrefix? 
	//DefinitionExtensionKeyword*
;

fragment OccurrenceDefinitionPrefix:
	BasicDefinitionPrefix?
	( isIndividual ?= 'individual' 
//		ownedRelationship += LifeClassMembership
	)?
//	DefinitionExtensionKeyword*
;

fragment BasicDefinitionPrefix:
	isAbstract ?= 'abstract' 
	| isVariation ?= 'variation'
;

fragment UsagePrefix:
	UnextendedUsagePrefix
	UsageExtensionKeyword*
;

fragment UnextendedUsagePrefix:
	EndUsagePrefix | BasicUsagePrefix
;

fragment EndUsagePrefix:
	isEnd ?= 'end' 
//	( ownedRelationship += OwnedCrossFeatureMember )?
;

fragment OccurrenceUsagePrefix:
	isEnd ?= 'end'
	| BasicUsagePrefix
	  ( isIndividual ?= 'individual' )?
	  ( portionKind = PortionKind )?
;

fragment RefPrefix:
    ( direction = FeatureDirection )?
    ( isAbstract ?= 'abstract' | isVariation ?= 'variation')?
    ( isReadOnly ?= 'readonly' )?
    ( isDerived ?= 'derived' )?
;

fragment BasicUsagePrefix:
	RefPrefix
	( isReference ?= 'ref' )?
;

fragment ConnectorPart:
	(connectorPart += ConnectorEnd 'to' connectorPart += ConnectorEnd)
	| ('(' connectorPart += ConnectorEnd ','  connectorPart += ConnectorEnd (',' connectorPart += ConnectorEnd)* ')')
;

fragment DefinitionDeclaration:
	(declaredName = Name)? ((':'|':>'|'specializes') superclassifiers+=FeatureChainName (',' superclassifiers+=FeatureChainName)*)?
;

fragment ActionUsageDeclaration:
	UsageDeclaration? FeatureValue?
;

fragment ConstraintUsageDeclaration:
	UsageDeclaration? ValuePart?
;

fragment ActionNodeUsageDeclaration:
	'action' UsageDeclaration?
;

fragment Usage:
	UsageDeclaration? FeatureValue?
;

fragment UsageDeclaration:
	FeatureDeclaration
;

fragment FeatureValue:
	( '=' 
	| isInitial ?= ':='
	| isDefault ?= 'default' ( '=' | isInitial ?= ':=' )?
	)
	valuePart += Expression
;

fragment FeatureDeclaration:
	  declaredName = Name FeatureSpecializationPart?
	| FeatureSpecializationPart
;

fragment FeatureSpecializationPart:
	( -> FeatureSpecialization )+ MultiplicityPart? FeatureSpecialization*
	| MultiplicityPart FeatureSpecialization*
;

fragment PerformActionUsageDeclaration:
	( referencedFeature=FeatureChainName FeatureSpecializationPart?
	| 'action' UsageDeclaration?)
	ValuePart?
;

fragment AcceptNodeDeclaration:
	ActionNodeUsageDeclaration? 'accept' AcceptParameterPart
;

fragment AcceptParameterPart:
	acceptParameter+=PayloadParameter
;

fragment ItemFeatureParameterPart:
	itemFeatureParameter+=ItemFeatureParameter
;

fragment PayloadFeature:
//	Identification? PayloadFeatureSpecializationPart? TriggerValuePart
	Identification? PayloadFeatureSpecializationPart ValuePart?
	// Warning
	| Identification? ValuePart
	| payloadFeatureElement=FeatureChainName MultiplicityRange?
	| MultiplicityRange payloadFeatureElement=FeatureChainName
;

fragment PayloadFeatureSpecializationPart:
	( -> FeatureSpecialization )+ MultiplicityPart? FeatureSpecialization*
	| MultiplicityPart FeatureSpecialization+
;

fragment TriggerValuePart:
	triggerkind=TriggerKind
	triggerExpression=Expression
;


fragment SendNodeDeclaration:
	ActionNodeUsageDeclaration?
	'send'
	sendNodeParameter?=Expression
	('via' viaNodeParameter=Expression)?
	('to' toNodeParameter=Expression)?
;

fragment AssignmentNodeDeclaration:
	ActionNodeUsageDeclaration? 'assign' 
	targetParameter=TargetExpression?
	featureChain=FeatureChainName ':=' 
	NodeParameter=Expression
;

fragment Identification:
	'<' declaredShortName = Name '>' ( declaredName = Name )?
	| declaredName = Name
;

fragment MultiplicityPart:
	MultiplicityRange
	| (MultiplicityRange? ( isOrdered ?= 'ordered' isNonunique ?= 'nonunique'? | isNonunique ?= 'nonunique' isOrdered ?= 'ordered'? ))
;

fragment FeatureSpecialization:
	(':'|'defined' 'by') typings+=FeatureTypingName (',' typings+=FeatureTypingName)*
	| (':>'|'specializes'|'subsets') subsetting+=FeatureChainName (',' subsetting+=FeatureChainName)*
	| ('::>'|'references')  references+=FeatureChainName (',' references+=FeatureChainName)*
	| ('=>'|'crosses') crosses+=FeatureChainName (',' crosses+=FeatureChainName)*
	| (':>>'|'redefines') redefinitions+=FeatureChainName (',' redefinitions+=FeatureChainName)*
;

fragment TransitionSuccession:
	transitionSuccessionElement += ConnectorEnd
;

fragment TargetSuccession:
	MultiplicityRange?
	'then'
	TransitionSuccession
;

//fragment GuardedTargetSuccession:
//	'if' ConditionalExpression=Expression 
//	'then' TransitionSuccession
//;

fragment DefaultTargetSuccession:
	'else' TransitionSuccession
;

fragment ReferenceSubsetting:
	refElement = FeatureChainName
;

fragment ActionNodePrefix:
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration?
;

fragment ControlNodePrefix:
	  RefPrefix
	  ( isIndividual ?= 'individual' )?
	  ( portionKind = PortionKind )?
	  UsageExtensionKeyword*
;

fragment PerformedActionParameterPart:
	performedActionParameterPart+=PerformedActionUsage 
;

// TODO --------------------------------- Text Level ---------------------------------//

//ConnectorEnd:
//	('[' MultiplicityExpression '..' MultiplicityExpression ']')?
//	( Name ('::>' | 'references') )?
//	FeatureChainName
//;

/* NAMES */

Name:
	ID | UNRESTRICTED_NAME
;

//QualifiedName:
//	Name ('::' Name)*
//;

Qualification :
	( Name '::' )+
;

QualifiedName:
	Qualification? Name
;

FeatureChainName:
	'USELESS'? 
//	'~'?
	QualifiedName ('.' Name)*
;

FeatureTypingName:
	FeatureChainName | '~' QualifiedName
;

//ExpressionName:
//	FeatureChainName | RealValue
//;

//Expression:
//	OPERATOR* ExpressionName (OPERATOR ExpressionName?)* | '(' SequenceExpression ')' | '(' ')'
//;
Expression:
	OwnedExpression
;

OwnedExpression:
	ConditionalExpression
;

ConditionalExpression:
	NullCoalescingExpression
	| 'if' NullCoalescingExpression '?' OwnedExpression 'else' OwnedExpression
;

NullCoalescingExpression:
	ImpliesExpression ('??' ImpliesExpression)*
;

ImpliesExpression:
	OrExpression ('implies' OrExpression)*
;

OrExpression:
	XorExpression ('|' XorExpression | 'or' XorExpression)*
;

XorExpression:
	AndExpression ('xor' AndExpression)*
;

AndExpression:
	EqualityExpression ('&' EqualityExpression | 'and' EqualityExpression)*
;

EqualityExpression:
	ClassificationExpression (('==' | '!=' | '===' | '!==') ClassificationExpression)*
;

ClassificationExpression:
	RelationalExpression (('hastype' | 'istype' | '@') ReferenceTypingName | 'as' ReferenceTypingName)?
	| ('hastype' | 'istype' | '@') ReferenceTypingName
	| MetadataReferenceName '@@' ReferenceTypingName
	| 'as' ReferenceTypingName
	| MetadataReferenceName 'meta' ReferenceTypingName
;

ReferenceTypingName:
	QualifiedName
;

MetadataReferenceName:
	QualifiedName
;

RelationalExpression:
	RangeExpression (('<' | '>' | '<=' | '>=') RangeExpression)*
;

RangeExpression:
	AdditiveExpression ('..' AdditiveExpression)?
;

AdditiveExpression:
	MultiplicativeExpression (('+'|'-') MultiplicativeExpression)*
;

MultiplicativeExpression:
	ExponentiationExpression (('*' | '/' | '%') ExponentiationExpression)*
;

ExponentiationExpression:
	UnaryExpression (('**' | '^') ExponentiationExpression)?
;

UnaryExpression:
	('+' | '-' | '~' | 'not') ExtentExpression
	| ExtentExpression
;

ExtentExpression:
	'all' ReferenceTypingName
	| PrimaryExpression
;

PrimaryExpression:
	BaseExpression
	('.' FeatureChainName)?
	(	( '#' '(' SequenceExpression ')'
		| '[' SequenceExpression ']'
		| '->' ReferenceTypingName (BodyExpression | FunctionReferenceExpression | ArgumentList)
		| '.' BodyExpression
		| '.?' BodyExpression
		)
		('.' FeatureChainName)?	
	)*
;

BaseExpression:
	  NullExpression
	| LiteralExpression 
	| FeatureReferenceExpression 
	| MetadataAccessExpression
	| InvocationExpression 
	| BodyExpression
	| '(' SequenceExpression ')'
;


FunctionReferenceExpression:
	QualifiedName
;

ArgumentList:
	'(' ( PositionalArgumentList | NamedArgumentList )? ')'
;

PositionalArgumentList:
	ArgumentValue (',' ArgumentValue)*
;

NamedArgumentList:
	NamedArgument (',' NamedArgument)*
;

ArgumentValue:
	OwnedExpression
;

NamedArgument:
	QualifiedName '=' ArgumentValue
;

NullExpression:
	'null' 
	| '(' ')' 
;

MetadataAccessExpression:
	QualifiedName '.' 'metadata'
;

InvocationExpression:
//	(QualifiedName | FeatureChainName) ArgumentList
	FeatureChainName ArgumentList
;

BodyExpression:
	'{'
	('in' Name FeatureSpecializationName* ';')*
	OwnedExpression
	'}'
;

FeatureSpecializationName:
	(':'|'defined' 'by') FeatureTypingName (',' FeatureTypingName)*
	| (':>'|'specializes'|'subsets') FeatureChainName (',' FeatureChainName)*
	| ('::>'|'references') FeatureChainName (',' FeatureChainName)*
	| ('=>'|'crosses') FeatureChainName (',' FeatureChainName)*
	| (':>>'|'redefines') FeatureChainName (',' FeatureChainName)*
;

SequenceExpression:
	OwnedExpression (',' SequenceExpression)?
;

MultiplicityExpression:
	LiteralExpression | FeatureReferenceExpression
;

LiteralExpression:
	LiteralBoolean
	| LiteralString
	| LiteralInteger
	| LiteralReal
	| LiteralInfinity
;

LiteralBoolean:
	BooleanValue
;

BooleanValue:
	'true' | 'false'
;

LiteralString:
	STRING_VALUE
;

LiteralInteger:
	DECIMAL_VALUE
;

LiteralReal:
	RealValue
;

RealValue:
	DECIMAL_VALUE? '.' ( DECIMAL_VALUE | EXP_VALUE ) | EXP_VALUE
;

LiteralInfinity:
	'*'
;

FeatureReferenceExpression:
	QualifiedName
;

TargetExpression:
	BaseExpression
	('.' FeatureChainName)?
	(	( '#' '(' SequenceExpression ')'
		| '[' SequenceExpression ']'
		| '->' ReferenceTypingName (BodyExpression | FunctionReferenceExpression | ArgumentList)
		| '.' BodyExpression
		| '.?' BodyExpression
		)
	)*
;

// TODO --------------------------------- Enum Level ---------------------------------//

// enum

enum VisibilityIndicator:
	null='NULLVisibility' | public = 'public' | private = 'private' | protected = 'protected'
;

enum FeatureDirection:
	null='NULLFeature' | inout = 'inout' | in = 'in' | out = 'out' 
;

enum PortionKind:
	null='NULLPortion' | snapshot = 'snapshot' | timeslice = 'timeslice'
;

enum TriggerKind:
	null='NULLTrigger' | at='at' | after='after'| when='when'
;

// TODO --------------------------------- Terminal Level ---------------------------------//

/* TERMINALS */
	
terminal DECIMAL_VALUE returns Ecore::EInt:
	'0'..'9' ('0'..'9')*;

terminal EXP_VALUE:
	DECIMAL_VALUE (('e' | 'E') ('+' | '-')? DECIMAL_VALUE)?;

terminal ID:
	('a'..'z' | 'A'..'Z' | '_') ('a'..'z' | 'A'..'Z' | '_' | '0'..'9')*;

terminal UNRESTRICTED_NAME returns Ecore::EString:
	'\'' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '\''))* '\'';

terminal STRING_VALUE returns Ecore::EString:
	'"' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '"'))* '"';

terminal REGULAR_COMMENT:
	'/*' -> '*/';

terminal ML_NOTE:
	'//*'-> '*/';

terminal SL_NOTE:
	'//' (!('\n' | '\r') !('\n' | '\r')*)? ('\r'? '\n')?;

terminal WS:
	(' ' | '\t' | '\r' | '\n')+;