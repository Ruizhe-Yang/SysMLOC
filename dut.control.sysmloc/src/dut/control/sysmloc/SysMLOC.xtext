//grammar dut.control.sysmloc.SysMLOC hidden(WS, ML_NOTE, SL_NOTE)
grammar dut.control.sysmloc.SysMLOC hidden(WS)

import "http://www.eclipse.org/emf/2002/Ecore" as Ecore

generate sysMLOC "http://www.control.dut/sysmloc/SysMLOC"
 
Namespace:
	(intro+=CodeAnnotation)?
	(packages+=Package)*
;

Package:
    'package' 
    declaredName=QualifiedName 
    '{' (elements+=PackageBodyElement)* '}'
;

// TODO --------------------------------- Body Level ---------------------------------//

PackageBodyElement:
    Package
    | AnnotatingElement 
    | DefinitionElement
    | UsageElement
//  | ElementFilterMember
    | AliasElement
    | ImportElement
    | CodeAnnotation
;

DefinitionBodyElement:
	AnnotatingElement
    | ImportElement
    | DefinitionElement
    | UsageElement
    | CodeAnnotation
    | AliasElement
;

UsageBodyElement:
	DefinitionBodyElement
;

InterfaceBodyElement:
	UsageBodyElement
;

EnumerationBodyElement:
	AnnotatingElement
	| EnumerationElement
;

ActionBodyElement:
	AnnotatingElement
	| ImportElement
	| AliasElement
	| DefinitionElement
//	| VariantUsageMember
	| NonOccurrenceUsageElement
	| StructureUsageElement
	| InitialNodeElement
	| BehaviorUsageElement
	| ActionNodeElement
	| TargetSuccessionNodeElement
	| GuardedSuccessionNodeElement
;

AnnotatingBodyElement:
	AnnotatingElement
;

ActionNodeBodyElement:
	AnnotatingElement
;
// TODO --------------------------------- Abstract Level ---------------------------------//
// Annotating

AnnotatingElement:
	Comment
	| Documentation
	| TextualRepresentation
//	| MetadataUsage
;

// Importing

ImportElement:
	NamespaceImport
	| MembershipImport
;

// Definitions

DefinitionElement:
	AttributeDefinition
	| EnumerationDefinition
//	| OccurrenceDefinition
//	| IndividualDefinition
	| ItemDefinition
//	| MetadataDefinition
	| PartDefinition
	| ConnectionDefinition
	| FlowConnectionDefinition
	| InterfaceDefinition
//	| AllocationDefinition
	| PortDefinition
	| ActionDefinition
//	| CalculationDefinition
//	| StateDefinition
//	| ConstraintDefinition
//	| RequirementDefinition
//	| ConcernDefinition
//	| CaseDefinition
//	| AnalysisCaseDefinition
//	| VerificationCaseDefinition
//	| UseCaseDefinition
//	| ViewDefinition
//	| ViewpointDefinition
//	| RenderingDefinition
//	| ExtendedDefinition
;

// Usages

UsageElement:
	NonOccurrenceUsageElement 
	| OccurrenceUsageElement
;

NonOccurrenceUsageElement:
	DefaultReferenceUsage
	| ReferenceUsage
	| AttributeUsage
	| EnumerationUsage
	| BindingConnectorAsUsage
	| SuccessionAsUsage
//	| ExtendedUsage
	
;

OccurrenceUsageElement:
	StructureUsageElement 
	| BehaviorUsageElement
;

StructureUsageElement:
//	OccurrenceUsage
//	| IndividualUsage
//	| PortionUsage
//	| EventOccurrenceUsage
	ItemUsage
	| PartUsage
//	| ViewUsage
//	| RenderingUsage
	| PortUsage
	| ConnectionUsage
	| InterfaceUsage
//	| AllocationUsage
//	| Message
	| FlowConnectionUsage
	| SuccessionFlowConnectionUsage
;
//
BehaviorUsageElement:
	ActionUsage
//	| CalculationUsage
//	| StateUsage
//	| ConstraintUsage
//	| RequirementUsage
//	| ConcernUsage
//	| CaseUsage
//	| AnalysisCaseUsage
//	| VerificationCaseUsage
//	| UseCaseUsage
//	| ViewpointUsage
	| PerformActionUsage
//	| ExhibitStateUsage
//	| IncludeUseCaseUsage
//	| AssertConstraintUsage
//	| SatisfyRequirementUsage
;

EnumerationElement:
	EnumeratedValue
;

InitialNodeElement:
	InitialNode
;

ActionNodeElement:
	SendNode
//	| AcceptNode 
//	| AssignmentNode 
//	| IfNode 
	| WhileLoopNode 
//	| ForLoopNode
//	| TerminateNode
	| MergeNode
	| DecisionNode
	| JoinNode
	| ForkNode
;

GuardedSuccessionNodeElement:
	GuardedSuccessionElement
;

TargetSuccessionNodeElement:
	TargetSuccessionElement
;

// TODO --------------------------------- Instance Level ---------------------------------//
NamespaceImport:
    visibility=VisibilityIndicator isImportAllFragment? 'import' declaredName=QualifiedName '::' ( '*' | isRecursive ?= '**' )? ';'
;

MembershipImport:
	visibility=VisibilityIndicator isImportAllFragment? 'import' declaredName=QualifiedName ( '*' | isRecursive ?= '**' )? ';'
;
    
CodeAnnotation:
    body=SL_NOTE | body=ML_NOTE
;

Comment:
	( 'comment' Identification? 
	  ('about' annotatedElement += QualifiedName
	     ( ',' annotatedElement += QualifiedName )* )? 
	)?
    ( 'locale' locale = STRING_VALUE )?
    body=REGULAR_COMMENT
;

Documentation:
    'doc' Identification? 
    ( 'locale' locale = STRING_VALUE )?
    body=REGULAR_COMMENT
;

TextualRepresentation:
    ( 'rep' Identification? )?
    'language' language = STRING_VALUE 
    body = REGULAR_COMMENT
;

DefaultReferenceUsage:
    MemberPrefix
    ( isEnd ?= 'end' )?
    RefPrefix
    UsageDeclaration
    ValuePart?
     (';' | '{' (elements+=UsageBodyElement)* '}')
;

ReferenceUsage:
    MemberPrefix
    ( EndUsagePrefix | RefPrefix) 
    'ref'
    Usage
     (';' | '{' (elements+=UsageBodyElement)* '}')
;

AttributeDefinition:
	MemberPrefix DefinitionPrefix 'attribute' 'def' DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

AttributeUsage:
    MemberPrefix UsagePrefix 'attribute' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

EnumerationDefinition:
	MemberPrefix
//	DefinitionExtensionKeyword*
	'enum' 'def' DefinitionDeclaration
	(';' | '{' (elements+=EnumerationBodyElement)* '}')
;

EnumeratedValue:
	MemberPrefix
//	UsageExtensionKeyword*
	'enum'? Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

EnumerationUsage:
	MemberPrefix
	UsagePrefix 'enum' Usage
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

BindingConnectorAsUsage:
	MemberPrefix
	UsagePrefix 
	( 'binding' UsageDeclaration? )?
	'bind' connectorPart += ConnectorEnd '=' connectorPart += ConnectorEnd
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

SuccessionAsUsage:
	MemberPrefix
	UsagePrefix
	( 'succession' UsageDeclaration? )? 
	'first' connectorPart += ConnectorEnd
	'then' connectorPart += ConnectorEnd
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ItemDefinition:
    MemberPrefix OccurrenceDefinitionPrefix 'item' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ItemUsage:
	EmptySuccessionPrefix
    MemberPrefix OccurrenceUsagePrefix 'item' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

PartDefinition:
    MemberPrefix OccurrenceDefinitionPrefix 'part' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

PartUsage:
	EmptySuccessionPrefix
    MemberPrefix OccurrenceUsagePrefix 'part' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

PortDefinition:
    MemberPrefix DefinitionPrefix 'port' 'def' DefinitionDeclaration 
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

PortUsage:
	EmptySuccessionPrefix
    MemberPrefix OccurrenceUsagePrefix 'port' Usage 
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

ConnectionDefinition:
	MemberPrefix OccurrenceDefinitionPrefix 'connection' 'def' DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix 
	OccurrenceUsagePrefix
	('connection' UsageDeclaration? FeatureValue? ('connect' ConnectorPart)?
	 | 'connect' ConnectorPart) 
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

InterfaceDefinition:
	MemberPrefix OccurrenceDefinitionPrefix 'interface' 'def' DefinitionDeclaration 
	(';' | '{' (elements += DefinitionBodyElement)* '}')
;

InterfaceUsage:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	'interface' 
	(UsageDeclaration? ('connect' ConnectorPart )? | ConnectorPart) 
	(';' | '{' (elements+=InterfaceBodyElement)* '}')
;

FlowConnectionDefinition:
	MemberPrefix 
	OccurrenceDefinitionPrefix 
	'flow' 'def' 
	DefinitionDeclaration 
	(';' | '{' (elements+=DefinitionBodyElement)* '}')
;

FlowConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	'flow' 
	UsageDeclaration? FeatureValue?
	( 'of' ItemFeature += Name )?
    ( 'from'? FlowEnd += FeatureChainName 'to' FlowEnd += FeatureChainName )?
    (';' | '{' (elements+=UsageBodyElement)* '}')
;

SuccessionFlowConnectionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	'succession' 'flow'
	UsageDeclaration? FeatureValue?
	( 'of' ItemFeature += Name )?
    ( 'from'? FlowEnd += FeatureChainName 'to' FlowEnd += FeatureChainName )?
    (';' | '{' (elements+=DefinitionBodyElement)* '}')
;

ActionDefinition:
	OccurrenceDefinitionPrefix 'action' 'def' DefinitionDeclaration
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

ActionUsage:
	EmptySuccessionPrefix
    MemberPrefix OccurrenceUsagePrefix 'action' ActionUsageDeclaration 
    (';' | '{' (elements+=ActionBodyElement)* '}')
;

PerformActionUsage:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix 'perform' 
	( ReferenceSubsetting FeatureSpecializationPart? | 'action' UsageDeclaration? )
    ValuePart?
	(';' | '{' (elements+=ActionBodyElement)* '}')
;

AliasElement:
	MemberPrefix 'alias' ( '<' memberShortName = Name '>' )? ( memberName = Name )? 
	'for' memberElement = QualifiedName
	(';' | '{' (elements+=AnnotatingBodyElement)* '}')
;

ConnectorEnd:
	MultiplicityRange?
	( delcaredName = Name ('::>' | 'references') )?
	ReferenceSubsetting
;

InitialNode:
	MemberPrefix 'first' memberElement = QualifiedName
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

SendNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration?
	'send'
//	( ActionBody
//	| ( => 
//		( ownedRelationship += NodeParameterMember SenderReceiverPart?
//	    | ownedRelationship += EmptyParameterMember SenderReceiverPart
//	    )
//	    ActionBody
//	  )
//	)
;

AcceptNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	AcceptNodeDeclaration
	(';' | '{' (elements+=ActionBodyElement)* '}')
; 

AssignmentNode:
	EmptySuccessionPrefix
	MemberPrefix
	OccurrenceUsagePrefix
	AssignmentNodeDeclaration
	(';' | '{' (elements+=ActionBodyElement)* '}')
; 

IfNode:
	EmptySuccessionPrefix
	MemberPrefix
	ActionNodePrefix
	'if'
	ifConditionExpression = Expression
	('action' actionParameterEnd+=ActionParameterEnd )?
	(';' | '{' (elements+=ActionBodyElement)* '}')
//	( 'else' 
//		(('action' actionParameterEnd+=ActionParameterEnd )? '{' (elements+=ActionBodyElement)* '}')
//		| (elseNode+=IfNode))?
; 

WhileLoopNode:
	EmptySuccessionPrefix
	MemberPrefix
	ActionNodePrefix
	('while' whileConditionExpression = Expression | 'loop' )
	('action' actionParameterEnd+=ActionParameterEnd )?
	('{' (elements+=ActionBodyElement)* '}')
	( 'until' untilConditionExpression = Expression ';' )?
; 

MergeNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'merge' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

DecisionNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'decide' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

JoinNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'join' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;

ForkNode:
	EmptySuccessionPrefix
	MemberPrefix
	ControlNodePrefix 'fork' UsageDeclaration?
	(';' | '{' (elements+=ActionNodeBodyElement)* '}')
;


ActionParameterEnd:
	UsageDeclaration
;

ForLoopNode:
	MemberPrefix
;

TerminateNode:
	MemberPrefix
;


GuardedSuccessionElement:
	( 'succession' UsageDeclaration )?
	'first'
	memberElement = FeatureChainName
	GuardExpression
	'then'
	TransitionSuccession
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

TargetSuccessionElement:
	MemberPrefix
	( TargetSuccession
	| GuardedTargetSuccession 
	| DefaultTargetSuccession
	)
	(';' | '{' (elements+=UsageBodyElement)* '}')
;

// TODO --------------------------------- Enum Level ---------------------------------//

// enum

enum VisibilityIndicator:
	public = 'public' | private = 'private' | protected = 'protected'
;

enum FeatureDirection:
	inout = 'inout' | in = 'in' | out = 'out' 
;

enum PortionKind:
	snapshot = 'snapshot' | timeslice = 'timeslice'
;

// TODO --------------------------------- Fragment Level ---------------------------------//

fragment EmptySuccessionPrefix:
	(isThen ?= 'then')? 
	( '[' ThenMultiplicity += MultiplicityExpression ']' | '[' ThenMultiplicity += MultiplicityExpression '..' ThenMultiplicity += MultiplicityExpression ']')?
;

fragment MultiplicityRange:
	'[' Multiplicity += MultiplicityExpression ']' | '[' Multiplicity += MultiplicityExpression '..' Multiplicity += MultiplicityExpression ']'
;

fragment ValuePart:
	FeatureValue
;

fragment isImportAllFragment:
	isImportAll ?= 'all'
;

fragment MemberPrefix:
	( visibility = VisibilityIndicator )?
;

fragment DefinitionPrefix:
	BasicDefinitionPrefix? 
	//DefinitionExtensionKeyword*
;

fragment OccurrenceDefinitionPrefix:
	BasicDefinitionPrefix?
	( isIndividual ?= 'individual' 
//		ownedRelationship += LifeClassMembership
	)?
//	DefinitionExtensionKeyword*
;

fragment BasicDefinitionPrefix:
	isAbstract ?= 'abstract' 
	| isVariation ?= 'variation'
;

fragment UsagePrefix:
	UnextendedUsagePrefix
//	UsageExtensionKeyword*	
;

fragment UnextendedUsagePrefix:
	EndUsagePrefix | BasicUsagePrefix
;

fragment EndUsagePrefix:
	isEnd ?= 'end' 
//	( ownedRelationship += OwnedCrossFeatureMember )?
;

fragment OccurrenceUsagePrefix:
	isEnd ?= 'end'
	| BasicUsagePrefix
	  ( isIndividual ?= 'individual' )?
	  ( portionKind = PortionKind )?
;

fragment RefPrefix:
    ( direction = FeatureDirection )?
    ( isAbstract ?= 'abstract' | isVariation ?= 'variation')?
    ( isReadOnly ?= 'readonly' )?
    ( isDerived ?= 'derived' )?
;

fragment BasicUsagePrefix:
	RefPrefix
	( isReference ?= 'ref' )?
;

fragment ConnectorPart:
	(connectorPart += ConnectorEnd 'to' connectorPart += ConnectorEnd)
	| ('(' connectorPart += ConnectorEnd ','  connectorPart += ConnectorEnd (',' connectorPart += ConnectorEnd)* ')')
;

fragment DefinitionDeclaration:
	(declaredName = Name)? ((':'|':>'|'specializes') superclassifiers+=FeatureChainName (',' superclassifiers+=FeatureChainName)*)?
;

fragment ActionUsageDeclaration:
	UsageDeclaration? FeatureValue?
;

fragment ActionNodeUsageDeclaration:
	'action' UsageDeclaration?
;

fragment Usage:
	UsageDeclaration? FeatureValue?
;

fragment UsageDeclaration:
	FeatureDeclaration
;

fragment FeatureValue:
	( '=' 
	| isInitial ?= ':='
	| isDefault ?= 'default' ( '=' | isInitial ?= ':=' )?
	)
	valuePart += Expression
;

fragment FeatureDeclaration:
	  declaredName = Name FeatureSpecializationPart?
	| FeatureSpecializationPart
;

fragment FeatureSpecializationPart:
	( -> FeatureSpecialization )+ MultiplicityPart? FeatureSpecialization*
	| MultiplicityPart FeatureSpecialization*
;

fragment AcceptNodeDeclaration:
	ActionNodeUsageDeclaration? 'accept' AcceptParameterPart
;

fragment AcceptParameterPart:
	'null'
//	ownedRelationship += PayloadParameterMember
//	( 'via' ownedRelationship += NodeParameterMember )?
;

fragment AssignmentNodeDeclaration:
	ActionNodeUsageDeclaration? 'assign' 
//	ownedRelationship += AssignmentTargetMember
//	ownedRelationship += FeatureChainMember ':=' 
//	ownedRelationship += NodeParameterMember
;

fragment Identification:
	'<' declaredShortName = Name '>' ( declaredName = Name )?
	| declaredName = Name
;

fragment MultiplicityPart:
	MultiplicityRange
	| (MultiplicityRange? ( isOrdered ?= 'ordered' isNonunique ?= 'nonunique'? | isNonunique ?= 'nonunique' isOrdered ?= 'ordered'? ))
;

fragment FeatureSpecialization:
	(':'|'defined' 'by') typings+=FeatureChainName (',' typings+=FeatureChainName)*
	| (':>'|'specializes'|'subsets') subsetting+=FeatureChainName (',' subsetting+=FeatureChainName)*
	| ('::>'|'references')  references+=FeatureChainName (',' references+=FeatureChainName)*
	| ('=>'|'crosses') crosses+=FeatureChainName (',' crosses+=FeatureChainName)*
	| (':>>'|'redefines') redefinitions+=FeatureChainName (',' redefinitions+=FeatureChainName)*
;

fragment GuardExpression:
	'if' ConditionalExpression=Expression
;

fragment TransitionSuccession:
	transitionSuccessionElement += ConnectorEnd
;

fragment TargetSuccession:
	MultiplicityRange?
	'then'
	TransitionSuccession
;

fragment GuardedTargetSuccession:
	GuardExpression 'then' TransitionSuccession
;

fragment DefaultTargetSuccession:
	'else' TransitionSuccession
;

fragment ReferenceSubsetting:
	refElement = FeatureChainName
;

fragment ActionNodePrefix:
	OccurrenceUsagePrefix
	ActionNodeUsageDeclaration?
;

fragment ControlNodePrefix:
	  RefPrefix
	  ( isIndividual ?= 'individual' )?
	  ( portionKind = PortionKind )?
//	  UsageExtensionKeyword*
;

// TODO --------------------------------- Terminal Level ---------------------------------//

//ConnectorEnd:
//	('[' MultiplicityExpression '..' MultiplicityExpression ']')?
//	( Name ('::>' | 'references') )?
//	FeatureChainName
//;

MultiplicityExpression:
	LiteralExpression | FeatureReferenceExpression
;

LiteralExpression:
	LiteralBoolean
	| LiteralString
	| LiteralInteger
	| LiteralReal
	| LiteralInfinity
;

LiteralBoolean:
	BooleanValue
;

BooleanValue:
	'true' | 'false'
;

LiteralString:
	STRING_VALUE
;

LiteralInteger:
	DECIMAL_VALUE
;

LiteralReal:
	RealValue
;

RealValue:
	DECIMAL_VALUE? '.' ( DECIMAL_VALUE | EXP_VALUE ) | EXP_VALUE
;

LiteralInfinity:
	'*'
;

FeatureReferenceExpression:
	QualifiedName
;
/* NAMES */

Name:
	ID | UNRESTRICTED_NAME
;

QualifiedName:
	Name ('::' Name)*
;

FeatureChainName:
	'~'? QualifiedName ('.' Name)*
;

ExpressionName:
	FeatureChainName | RealValue
;

Expression:
	OPERATOR* ExpressionName (OPERATOR ExpressionName?)* | '(' SequenceExpression ')' | '(' ')'
;

//Expression:
//	ConditionalExpression
//;
//
//ConditionalExpression:
//	NullCoalescingExpression 
//	| 'if' NullCoalescingExpression '?' OwnedExpressionReference
//;

SequenceExpression:
	Expression (',' Expression)*
;

/* TERMINALS */

terminal OPERATOR:
	'if' | '??' | 'implies' | '|' | 'or' | 'xor' | '&' | 'and' | '==' | '!=' | '===' | '!==' | 'hastype' | 'istype' | '@'|
	'@@' | 'as' | 'meta' | '<' | '>' | '<=' | '>=' | '+' | '-' | '*' | '/' | '%' | '..' | '**' | '^' | '~' | 'not' |
	'true' | 'false';
	
terminal DECIMAL_VALUE returns Ecore::EInt:
	'0'..'9' ('0'..'9')*;

terminal EXP_VALUE:
	DECIMAL_VALUE (('e' | 'E') ('+' | '-')? DECIMAL_VALUE)?;

terminal ID:
	('a'..'z' | 'A'..'Z' | '_') ('a'..'z' | 'A'..'Z' | '_' | '0'..'9')*;

terminal UNRESTRICTED_NAME returns Ecore::EString:
	'\'' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '\''))* '\'';

terminal STRING_VALUE returns Ecore::EString:
	'"' ('\\' ('b' | 't' | 'n' | 'f' | 'r' | '"' | "'" | '\\') | !('\\' | '"'))* '"';

terminal REGULAR_COMMENT:
	'/*' -> '*/';

terminal ML_NOTE:
	'//*'-> '*/';

terminal SL_NOTE:
	'//' (!('\n' | '\r') !('\n' | '\r')*)? ('\r'? '\n')?;

terminal WS:
	(' ' | '\t' | '\r' | '\n')+;