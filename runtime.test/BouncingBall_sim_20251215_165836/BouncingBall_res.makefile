# Makefile generated by OpenModelica
# Platform: win64

# Simulations use -O3 by default
CC=clang
CXX=clang++
LINK=clang++ -shared -Xlinker --export-all-symbols
EXEEXT=.exe
DLLEXT=.dll
CFLAGS_BASED_ON_INIT_FILE=
# define OMC_CFLAGS_OPTIMIZATION env variable to your desired optimization level to override this
OMC_CFLAGS_OPTIMIZATION=-Os
DEBUG_FLAGS=$(OMC_CFLAGS_OPTIMIZATION)
CFLAGS=-municode $(CFLAGS_BASED_ON_INIT_FILE) $(DEBUG_FLAGS) -DOM_HAVE_PTHREADS -Wno-parentheses-equality -falign-functions -mstackrealign -msse2 -mfpmath=sse ${MODELICAUSERCFLAGS}   
CPPFLAGS= -I"F:/OpenModelica1.25.5-64bit/include/omc/c" -I"F:/OpenModelica1.25.5-64bit/include/omc" -I. -DOPENMODELICA_XML_FROM_FILE_AT_RUNTIME -DOMC_MODEL_PREFIX=BouncingBall_res -DOMC_NUM_MIXED_SYSTEMS=0 -DOMC_NUM_LINEAR_SYSTEMS=0 -DOMC_NUM_NONLINEAR_SYSTEMS=0 -DOMC_NDELAY_EXPRESSIONS=0 -DOMC_NVAR_STRING=0
# define OMC_LDFLAGS_LINK_TYPE env variable to "static" to override this
OMC_LDFLAGS_LINK_TYPE=dynamic
RUNTIME_LIBS=-lSimulationRuntimeC -Wl,-Bdynamic -lomcgc -lryu -lopenblas -Wl,-B$(OMC_LDFLAGS_LINK_TYPE)  -lstdc++ -Wl,-Bdynamic 
LDFLAGS=-L"F:/OpenModelica1.25.5-64bit/lib//omc" -L"F:/OpenModelica1.25.5-64bit/lib" -Wl,--stack,16777216,-rpath,"F:/OpenModelica1.25.5-64bit/lib//omc" -L"F:/OpenModelica1.25.5-64bit/bin" -Wl,-rpath,"F:/OpenModelica1.25.5-64bit/lib"  -fopenmp -Wl,-Bstatic -lregex -ltre -lintl -liconv -lexpat -lpthread -loleaut32 -limagehlp -lhdf5 -lz -lsz -Wl,-Bdynamic $(RUNTIME_LIBS) 
DIREXTRA=-L"E:/GitYang/SysMLOC/runtime.test"
MAINFILE=BouncingBall_res.c
MAINOBJ=BouncingBall_res.o
CFILES=BouncingBall_res_functions.c BouncingBall_res_records.c \
BouncingBall_res_01exo.c BouncingBall_res_02nls.c BouncingBall_res_03lsy.c BouncingBall_res_04set.c BouncingBall_res_05evt.c BouncingBall_res_06inz.c BouncingBall_res_07dly.c \
BouncingBall_res_08bnd.c BouncingBall_res_09alg.c BouncingBall_res_10asr.c BouncingBall_res_11mix.c BouncingBall_res_12jac.c BouncingBall_res_13opt.c BouncingBall_res_14lnz.c \
BouncingBall_res_15syn.c BouncingBall_res_16dae.c BouncingBall_res_17inl.c BouncingBall_res_18spd.c 

OFILES=$(CFILES:.c=.o)
GENERATEDFILES=$(MAINFILE) BouncingBall_res.makefile BouncingBall_res_literals.h BouncingBall_res_functions.h $(CFILES)

.PHONY: omc_main_target clean bundle

# This is to make sure that BouncingBall_res_*.c are always compiled.
.PHONY: $(CFILES)

omc_main_target: $(MAINOBJ) BouncingBall_res_functions.h BouncingBall_res_literals.h $(OFILES)
	$(CC) -I. -o BouncingBall_res$(EXEEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

omc_dll_target: $(MAINOBJ) BouncingBall_res_functions.h BouncingBall_res_literals.h $(OFILES)
	$(CC) -DOMC_DLL_MAIN_DEFINE -o $(MAINOBJ) -c $(MAINFILE) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)
	$(CC) -shared -I. -o BouncingBall_res$(DLLEXT) $(MAINOBJ) $(OFILES) $(DIREXTRA)   $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

clean:
	@rm -f BouncingBall_res_records.o $(MAINOBJ)

bundle:
	@tar -cvf BouncingBall_res_Files.tar $(GENERATEDFILES)