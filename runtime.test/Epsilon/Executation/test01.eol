operation SysMLOC!EObject run(){
	if (self.hasProperty("elements")){
		for (e in self.elements){
			e.operate();
			e.run();
		}
	}
}

operation SysMLOC!EObject operate(){
//	self.println();
	if (self.isTypeOf(SysMLOC!ImportElement)){
		getLibrary(self.declaredName).println();
		
	}
}

operation SysMLOC!EObject checkElement(){
	var result = true;
	if (self.hasProperty("elements")){
		for (e in self.elements){
			if (e.isKindOf(SysMLOC!DefinitionDeclaration)){
				if (not e.checkSuperclassifier()){
					result = false;
					("[Error]" + e.declaredName + " : SuperClassifier error." ).println();
					return result;
				}
				else{
	//				("[Check]" + e.declaredName + " : " + result.asString()).println();
				}
			}
			if (e.isKindOf(SysMLOC!FeatureSpecialization)){
				if (not e.checkFeatureSpecialization()){
					result = false;
					("[Error]" + e.declaredName + " : FeatureSpecialization error.").println();
					return result;
				}
				else{
	//				("[Check]" + e.declaredName + " : " + result.asString()).println();
				}
			}
			if (result and e.elements.size() >= 0){
				result = e.checkElement();
			}
		}
		return result;
	}
	else{
		return result;
	}
}