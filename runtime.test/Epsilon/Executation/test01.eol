var root = SysMLOC!Package.all.first();
//root.checkElement();
root.run();

operation SysMLOC!EObject run(){
	if (self.hasProperty("elements")){
		for (e in self.elements){
			e.operate();
			e.run();
		}
	}
}

operation SysMLOC!EObject operate(){
//	self.println();
	if (self.isTypeOf(SysMLOC!ImportElement)){
		getLibrary(self.declaredName).println();
		
	}
}

operation SysMLOC!EObject checkElement(){
	var result = true;
	if (self.hasProperty("elements")){
		for (e in self.elements){
			if (e.isKindOf(SysMLOC!DefinitionDeclaration)){
				if (not e.checkSuperclassifier()){
					result = false;
					("[Error]" + e.declaredName + " : SuperClassifier error." ).println();
					return result;
				}
				else{
	//				("[Check]" + e.declaredName + " : " + result.asString()).println();
				}
			}
			if (e.isKindOf(SysMLOC!FeatureSpecialization)){
				if (not e.checkFeatureSpecialization()){
					result = false;
					("[Error]" + e.declaredName + " : FeatureSpecialization error.").println();
					return result;
				}
				else{
	//				("[Check]" + e.declaredName + " : " + result.asString()).println();
				}
			}
			if (result and e.elements.size() >= 0){
				result = e.checkElement();
			}
		}
		return result;
	}
	else{
		return result;
	}
}

operation SysMLOC!DefinitionDeclaration checkSuperclassifier(){
	for (t in self.superclassifiers){
		if (getElement(t) == null){
			return false;
		}
	}
	return true;
}

operation SysMLOC!FeatureSpecialization checkFeatureSpecialization(){
	for (t in self.typings){
		if (getElement(t) == null){
			return false;
		}
	}
	for (t in self.subsetting){
		if (getElement(t) == null){
			return false;
		}
	}
	for (t in self.references){
		if (getElement(t) == null){
			return false;
		}
	}
	for (t in self.crosses){
		if (getElement(t) == null){
			return false;
		}
	}
	for (t in self.redefinitions){
		if (getElement(t) == null){
			return false;
		}
	}
	return true;
}

operation getElement( name : String ){
	var e = SysMLOC!EObject.all.select(s|s.hasProperty("declaredName") and s.declaredName==name);
	if (e.size() == 1){
		return e.first();
	}
	else if (e.size() == 0){
		return null;
	}
	else{
		"Modeling Error.".println();
		return null;
	}
}

operation getLibrary( name : String ){
	var sysmlpackage = SysmlLibrary!Package.all.select(s|s.hasProperty("declaredName") and s.declaredName==name);
	var kermlpackage = KermlLibrary!Package.all.select(s|s.hasProperty("declaredName") and s.declaredName==name);
	var sysmllibrarypackage = SysmlLibrary!LibraryPackage.all.select(s|s.hasProperty("declaredName") and s.declaredName==name);
	var kermllibrarypackage = KermlLibrary!LibraryPackage.all.select(s|s.hasProperty("declaredName") and s.declaredName==name);
	
	if (sysmlpackage.size() == 1){
		return sysmlpackage.first();
	}
	else if (kermlpackage.size() == 1){
		return kermlpackage.first();
	}
	else if (sysmllibrarypackage.size() == 1){
		return sysmllibrarypackage.first();
	}
	else if (kermllibrarypackage.size() == 1){
		return kermllibrarypackage.first();
	}
	else{
		"Modeling Error.".println();
		return null;
	}
}
