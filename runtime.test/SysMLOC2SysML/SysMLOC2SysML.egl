[% import "SysMLOC2SysML-util.eol"; %]
[%root.lineOfCode();%]

[%operation SysMLOC!EObject write(i){%]
[%=i.Tab()%][%=self.lineOfCode()%][%if (self.isEnd()){%];
[%}else{%]{
[%for (e in self.elements){e.write(i+1);}%]
[%=i.Tab()%]}
[%i++;}%] 
[%}%]

[%
operation SysMLOC!Namespace lineOfCode(){%]
[%for (e in self.elements){e.write(0);}%]
[%}%]

[% 
operation SysMLOC!Package lineOfCode(){%]
package [%=self.declaredName%]
[%}%]

[% 
operation SysMLOC!Documentation lineOfCode(){%]
doc [%=self.Identification()%] [%=self.body%]
[%}%]

[% 
operation SysMLOC!PartDefinition lineOfCode(){%]
part def [%=self.DefinitionDeclaration()%]
[%}%]

[% 
operation SysMLOC!PartUsage lineOfCode(){%]
[%=self.GeneralUsagePrefix()%][%=self.OccurrenceUsagePrefix()%]part [%=self.Usage()%]
[%}%]

[% 
operation SysMLOC!EObject lineOfCode(){%]
// == Unfinished [%=self.type().name%] ==
[%}%]

[%
operation Integer Tab(){
	var str = "";
	if (self == 0){
		return str;
	}
	for (i in 1.to(self)){
		str += "\t";
	}
	return str;
}
%]