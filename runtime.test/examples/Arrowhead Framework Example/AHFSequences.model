<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ** This is the Norwegian use-case for Arrowhead Framework */&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:Package" declaredName="AHFNorwaySequences">
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Here we show sequences of the Norwegian use-case&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AHFProfileLib" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AHFCoreLib" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AHFNorway" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="AHFN_LocalCloudDD_Seqs" valuePart="AHFNorway_LocalCloudDD">
      <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="APIS_transfer_lifetime">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// lifetime orderings &#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="tlc" valuePart="AHFNorway_LocalCloudDD.TellUConsumer">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="call_getItems1"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="return_getItems1"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="call_getItems2"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="return_getItems2"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="apsp" valuePart="AHFNorway_LocalCloudDD.APISProducer">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="send_publish_returnallitems"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="receive_call_getItems1"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="send_returnallitems1"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="return_getItems_ack1"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="receive_call_getItems2"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="send_returnallitems2"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="return_getItems_ack2"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="mqtts" valuePart="AHFNorway_LocalCloudDD.MQTTServer">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="receive_publish_returnallitems"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="receive_subscribe_returnallitems"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="forw1">
            <typings>MQTTforwarding</typings>
          </elements>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="forw2">
            <typings>MQTTforwarding</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="apsc" valuePart="AHFNorway_LocalCloudDD.APISConsumer">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="send_subscribe_returnallitems"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="forw1">
            <typings>MQTTforwarding</typings>
          </elements>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="forw2">
            <typings>MQTTforwarding</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="forw1">
          <typings>MQTTforwarding</typings>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="forw2">
          <typings>MQTTforwarding</typings>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="publish_returnallitems">
          <itemFeatureParameter payloadFeatureElement="Publish"/>
          <FlowEnd>apsp.send_publish_returnallitems</FlowEnd>
          <FlowEnd>mqtts.receive_publish_returnallitems</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="subscribe_returnallitems">
          <itemFeatureParameter payloadFeatureElement="Subscribe"/>
          <FlowEnd>apsc.send_subscribe_returnallitems</FlowEnd>
          <FlowEnd>mqtts.receive_subscribe_returnallitems</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="call_getItems1">
          <itemFeatureParameter payloadFeatureElement="CallGiveItems">
            <Multiplicity>1</Multiplicity>
          </itemFeatureParameter>
          <FlowEnd>tlc.call_getItems1</FlowEnd>
          <FlowEnd>apsp.receive_call_getItems1</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="apsp.send_returnallitems1"/>
          <connectorPart refElement="forw1.mq"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// binding the sending to the actual gate&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:Comment" body="/* How to express that this event sends a Return_AllItems? */"/>
        <elements xsi:type="sysMLOC:Message" declaredName="returnack1">
          <itemFeatureParameter payloadFeatureElement="ResultGiveItems"/>
          <FlowEnd>apsp.return_getItems_ack1</FlowEnd>
          <FlowEnd>tlc.return_getItems1</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="call_getItems2">
          <itemFeatureParameter payloadFeatureElement="CallGiveItems">
            <Multiplicity>1</Multiplicity>
          </itemFeatureParameter>
          <FlowEnd>tlc.call_getItems2</FlowEnd>
          <FlowEnd>apsp.receive_call_getItems2</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="apsp.send_returnallitems2"/>
          <connectorPart refElement="forw2.mq"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// binding the sending to the actual gate&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:Message" declaredName="returnack2">
          <itemFeatureParameter payloadFeatureElement="ResultGiveItems"/>
          <FlowEnd>apsp.return_getItems_ack2</FlowEnd>
          <FlowEnd>tlc.return_getItems2</FlowEnd>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="MQTTforwarding">
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="mqttsf" valuePart="AHFNorway_LocalCloudDD.MQTTServer">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="receive_returnallitems"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="send_returnallitems"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="apscf">
          <subsetting>AHFNorway_LocalCloudDD.APISConsumer</subsetting>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="receive_returnallitems"/>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" direction="in" declaredName="mq"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// parameter for gate&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:Message" declaredName="sendallitems1">
          <itemFeatureParameter payloadFeatureElement="Return_AllItems"/>
          <FlowEnd>mq</FlowEnd>
          <FlowEnd>mqttsf.receive_returnallitems</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="sendallitems2">
          <itemFeatureParameter payloadFeatureElement="Return_AllItems"/>
          <FlowEnd>mqttsf.send_returnallitems</FlowEnd>
          <FlowEnd>apscf.receive_returnallitems</FlowEnd>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// port reference&#xD;&#xA;"/>
      <elements xsi:type="sysMLOC:InterfaceUsage" declaredName="APIS_transfer_interface">
        <typings>Interfaces::Interface</typings>
        <connectorPart refElement="AHFNorway_LocalCloudDD.TellUConsumer.apisp.APIS_HTTP" delcaredName="tlu"/>
        <connectorPart refElement="AHFNorway_LocalCloudDD.APISProducer.tellu.APIS_HTTP" delcaredName="apsph"/>
        <connectorPart refElement="AHFNorway_LocalCloudDD.APISProducer.apisc.APIS_MQTT" delcaredName="apspm"/>
        <connectorPart refElement="AHFNorway_LocalCloudDD.APISConsumer.apisp.APIS_MQTT" delcaredName="apsc"/>
        <connectorPart refElement="AHFNorway_LocalCloudDD.MQTTServer.getTopic" delcaredName="mqget"/>
        <connectorPart refElement="AHFNorway_LocalCloudDD.MQTTServer.giveTopic" delcaredName="mqgive"/>
        <elements xsi:type="sysMLOC:Message" declaredName="publish_returnallitems">
          <itemFeatureParameter payloadFeatureElement="Publish"/>
          <FlowEnd>apspm</FlowEnd>
          <FlowEnd>mqget</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="subscribe_returnallitems">
          <itemFeatureParameter payloadFeatureElement="Subscribe"/>
          <FlowEnd>apsc</FlowEnd>
          <FlowEnd>mqgive</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="call_getItems">
          <itemFeatureParameter payloadFeatureElement="CallGiveItems">
            <Multiplicity>1</Multiplicity>
          </itemFeatureParameter>
          <FlowEnd>tlu</FlowEnd>
          <FlowEnd>apsph</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="returnallitems">
          <itemFeatureParameter payloadFeatureElement="Return_AllItems"/>
          <FlowEnd>apspm</FlowEnd>
          <FlowEnd>mqget</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="sendallitems">
          <itemFeatureParameter payloadFeatureElement="Return_AllItems"/>
          <FlowEnd>mqgive</FlowEnd>
          <FlowEnd>apsc</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:Message" declaredName="returnack">
          <itemFeatureParameter payloadFeatureElement="ResultGiveItems"/>
          <FlowEnd>apsph</FlowEnd>
          <FlowEnd>tlu</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Successions on each lifetime&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// tlu&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="call_getItems.startShot"/>
          <connectorPart refElement="returnack.endShot"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// apisp (taking both ports)&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="publish_returnallitems.startShot"/>
          <connectorPart refElement="call_getItems.endShot"/>
        </elements>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="call_getItems.endShot"/>
          <connectorPart refElement="returnallitems.startShot"/>
        </elements>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="returnallitems.startShot"/>
          <connectorPart refElement="returnack.startShot"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// MQTTServer&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="publish_returnallitems.endShot"/>
          <connectorPart refElement="subscribe_returnallitems.endShot"/>
        </elements>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="subscribe_returnallitems"/>
          <connectorPart refElement="returnallitems.endShot"/>
        </elements>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="returnallitems.endShot"/>
          <connectorPart refElement="sendallitems.startShot"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// apisc&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:SuccessionAsUsage">
          <connectorPart refElement="subscribe_returnallitems.startShot"/>
          <connectorPart refElement="sendallitems.endShot"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
