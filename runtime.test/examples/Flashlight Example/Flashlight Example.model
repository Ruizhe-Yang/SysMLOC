<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Flashlight Example'">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="OnOffCmd"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Light"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="OnOffCmdPort">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="onOffCmd">
        <typings>OnOffCmd</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="LightPort">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="light">
        <typings>Light</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="context">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="user">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="onOffCmdPort">
          <typings>OnOffCmdPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="illuminateRegion.sendOnOffCmd">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="onOffCmd">
            <valuePart>onOffCmdPort.onOffCmd</valuePart>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceUsage" declaredName="userToFlashlight">
        <connectorPart refElement="user.onOffCmdPort"/>
        <connectorPart refElement="flashlight.onOffCmdPort"/>
        <elements xsi:type="sysMLOC:FlowUsage" isReference="true">
          <references>illuminateRegion.onOffCmdFlow</references>
          <FlowEnd>source.onOffCmd</FlowEnd>
          <FlowEnd>target.onOffCmd</FlowEnd>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="flashlight">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="onOffCmdPort">
          <typings>~OnOffCmdPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="illuminateRegion.produceDirectedLight">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="onOffCmd">
            <valuePart>onOffCmdPort.onOffCmd</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="light">
            <valuePart>lightPort.light</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="lightPort">
          <typings>LightPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="reflectingSource">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="lightPort">
          <typings>~LightPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="illuminateRegion.reflectLight">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="light">
            <valuePart>lightPort.light</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="illuminateRegion">
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="sendOnOffCmd">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="onOffCmd">
          <typings>OnOffCmd</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionFlowUsage" declaredName="onOffCmdFlow">
        <FlowEnd>sendOnOffCmd.onOffCmd</FlowEnd>
        <FlowEnd>produceDirectedLight.onOffCmd</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="produceDirectedLight">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="onOffCmd"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="light">
          <typings>Light</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionFlowUsage" declaredName="lightFlow">
        <FlowEnd>produceDirectedLight.light</FlowEnd>
        <FlowEnd>reflectLight.light</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="reflectLight">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="light">
          <typings>Light</typings>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
