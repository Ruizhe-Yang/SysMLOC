<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="ExternalShapeRefExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ShapeItems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::mass"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::mm"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ExternalShapeRef">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Metadata to reference an externally defined shape.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="purpose" Multi0="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="shapeIri" Multi0="1">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="myBatteryUnit">
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Shell</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ExternalShapeRef">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="purpose" valuePart="&quot;highLoD&quot;"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="shapeIri" valuePart="&quot;file:/detailed-geometry/LEMS-250W_BatteryHousing_Example.step&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" visibility="private" declaredName="envelopingBoxBatteryUnit">
        <typings>Box</typings>
        <subsetting>envelopingShapes</subsetting>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="140[mm]">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="148[mm]">
          <redefinitions>width</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="90[mm]">
          <redefinitions>height</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
