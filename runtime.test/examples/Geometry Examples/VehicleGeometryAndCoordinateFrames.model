<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VehicleGeometryAndCoordinateFrames">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TrigFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ShapeItems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SpatialItems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::CoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::TranslationRotationSequence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::Translation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::Rotation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Collections::Array"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <superclassifiers>SpatialItem</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Chassis">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>shape</redefinitions>
        <valuePart>Box(4800 [mm], 1840 [mm], 1350 [mm])</valuePart>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Generic wheel with lugbolts&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * The radius is estimated for a 22 inch hub plus 110 mm tire height.&#xD;&#xA;&#x9;&#x9; * The wheel width is equal to the cylinder height.&#xD;&#xA;&#x9;&#x9; * The wheel has 5 lugbolts that are evenly distributed along a circle centered at the wheel's center.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
        <typings>Wheel</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Cylinder</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>radius</redefinitions>
          <valuePart>22/2*25.4 + 110 [mm]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>height</redefinitions>
          <valuePart>220 [mm]</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="wcf" declaredName="wheelCoordinateFrame">
        <typings>CoordinateFrame</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="numberOfBolts">
        <typings>Natural</typings>
        <valuePart>5</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="lugBolts">
        <typings>LugBolt</typings>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>numberOfBolts</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* &#xD;&#xA;&#x9;&#x9; * As an example of a more involved placement of composite parts, constrain the positions of the coordinate frame origins &#xD;&#xA;&#x9;&#x9; * of the lugbolts to a circle with radius lbpr distributed evenly over 360&#xb0;.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="lbpr" declaredName="lugBoltPlacementRadius" isDefault="true">
        <redefinitions>radius</redefinitions>
        <valuePart>60 [mm]</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lugBoltDistributionAngle">
        <redefinitions>planeAngle</redefinitions>
        <valuePart>360/numberOfBolts ['&#xb0;']</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lbda">
        <typings>Real</typings>
        <valuePart>lugBoltDistributionAngle.num * (pi/180)</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// lugBoltDistributionAngle in radian&#xD;&#xA;"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="(1..numberOfBolts)->forAll { in i : Natural; private attribute lbcf = lugBolts#(i).coordinateFrame; private attribute trs : TranslationRotationSequence { :>> source = wcf; :>> target = lbcf; :>> elements = Translation((lbpr*cos((i-1)*lbda), lbpr*sin((i-1)*lbda), -8)[wcf]); } lbcf.transformation == trs }"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LugBolt">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Cylinder</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>radius</redefinitions>
          <valuePart>14 [mm]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>height</redefinitions>
          <valuePart>40 [mm]</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <typings>SpatialItem</typings>
      <elements xsi:type="sysMLOC:Comment" body="/* &#xD;&#xA;&#x9;&#x9; * Vehicle frame origin at center of bottom plate of chassis&#xD;&#xA;&#x9;&#x9; * with +Z upwards and +X in the forward (front) direction&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="datum">
        <redefinitions>coordinateFrame</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>mRefs</redefinitions>
          <valuePart>(mm, mm, mm)</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="chassis">
        <typings>Chassis</typings>
        <subsetting>componentItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>source</redefinitions>
              <valuePart>datum</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>elements</redefinitions>
              <valuePart>Translation((-(shape as Box).length/2, -(shape as Box).width/2, 0)[datum])</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="plusXAxis">
        <typings>Array</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>dimensions</redefinitions>
          <valuePart>3</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>Real</typings>
          <redefinitions>elements</redefinitions>
          <Multiplicity>3</Multiplicity>
          <valuePart>(1, 0, 0)</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="frontWheelXShift">
        <typings>Real</typings>
        <valuePart>1670</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="rearWheelXShift">
        <typings>Real</typings>
        <valuePart>-1820</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="wheelYShift">
        <typings>Real</typings>
        <valuePart>720</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="leftFrontWheel">
        <typings>Wheel</typings>
        <subsetting>componentItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>source</redefinitions>
              <valuePart>datum</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>elements</redefinitions>
              <valuePart>(Translation((frontWheelXShift, wheelYShift, 80)[datum]), Rotation(plusXAxis[datum], -90['&#xb0;']))</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="rightFrontWheel">
        <typings>Wheel</typings>
        <subsetting>componentItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>source</redefinitions>
              <valuePart>datum</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>elements</redefinitions>
              <valuePart>(Translation((frontWheelXShift, -wheelYShift, 80)[datum]), Rotation((1, 0, 0)[datum], 90['&#xb0;']))</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="leftRearWheel">
        <typings>Wheel</typings>
        <subsetting>componentItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>source</redefinitions>
              <valuePart>datum</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>elements</redefinitions>
              <valuePart>(Translation((rearWheelXShift, wheelYShift, 80)[datum]), Rotation((1, 0, 0)[datum], 90['&#xb0;']))</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="rightRearWheel">
        <typings>Wheel</typings>
        <subsetting>componentItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>source</redefinitions>
              <valuePart>datum</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>elements</redefinitions>
              <valuePart>(Translation((rearWheelXShift, -wheelYShift, 80)[datum]), Rotation((-1, 0, 0)[datum], 90['&#xb0;']))</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
