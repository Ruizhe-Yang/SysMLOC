<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="ServerSequenceModel">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SignalDefinitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="SignalDefinitions">
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Subscribe">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="topic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="subscriber"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Publish">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="topic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="publication"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Deliver">
        <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="publication"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="PubSubSequence">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="producer">
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="publish_source_event"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="publish_message">
        <FlowEnd>producer.publish_source_event</FlowEnd>
        <FlowEnd>server.publish_target_event</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="server">
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="subscribe_target_event"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="publish_target_event"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="deliver_source_event"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="subscribe_message">
        <FlowEnd>consumer.subscribe_source_event</FlowEnd>
        <FlowEnd>server.subscribe_target_event</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="deliver_message">
        <FlowEnd>server.deliver_source_event</FlowEnd>
        <FlowEnd>consumer.deliver_target_event</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="consumer">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="subscribe_source_event"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="deliver_target_event"/>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
