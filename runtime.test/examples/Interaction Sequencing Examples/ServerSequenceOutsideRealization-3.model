<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="ServerSequenceOutsideRealization_3">
    <elements xsi:type="sysMLOC:MembershipImport" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:NamespaceImport" visibility="private" declaredName="ServerSequenceModelOutside"/>
    <elements xsi:type="sysMLOC:NamespaceImport" visibility="private" declaredName="Configuration"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Configuration">
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="PublicationPort">
        <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="publish">
          <typings>Publish</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="SubscriptionPort">
        <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="subscribe">
          <typings>Subscribe</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" direction="out" declaredName="deliver">
          <typings>Deliver</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="PublicationInterface">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="source" isEnd="true">
          <typings>~PublicationPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="target" isEnd="true">
          <typings>PublicationPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="SubscriptionInterface">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="source" isEnd="true">
          <typings>~SubscriptionPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="target" isEnd="true">
          <typings>SubscriptionPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="producer_3">
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="someTopic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" visibility="private" declaredName="somePublication"/>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="publicationPort">
          <typings>~PublicationPort</typings>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="out">
            <redefinitions>publish</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="producerBehavior">
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="publish">
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="out" declaredName="request">
              <typings>Publish</typings>
              <Multiplicity>1</Multiplicity>
              <valuePart>Publish(someTopic, somePublication)</valuePart>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/* Internal flows are instantaneous to make arrival/leave ordering in SequenceModelOutside.sysml&#xD;&#xA;&#x9;&#x9;&#x9; * equivalent to ordering participant internals in ServerSequenceRealization-3.sysml. */"/>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="publish_request">
          <FlowEnd>producerBehavior.publish.request</FlowEnd>
          <FlowEnd>publicationPort.publish</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceUsage" declaredName="publication_interface">
        <typings>PublicationInterface</typings>
        <connectorPart refElement="producer_3.publicationPort"/>
        <connectorPart refElement="server_3.publicationPort"/>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="publish_request">
          <FlowEnd>publication_interface.source.publish</FlowEnd>
          <FlowEnd>publication_interface.target.publish</FlowEnd>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="server_3">
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="publicationPort">
          <typings>PublicationPort</typings>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in">
            <redefinitions>publish</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="subscriptionPort">
          <typings>SubscriptionPort</typings>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in">
            <redefinitions>subscribe</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="out">
            <redefinitions>deliver</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="subscribe_request">
          <FlowEnd>subscriptionPort.subscribe</FlowEnd>
          <FlowEnd>serverBehavior.subscribing.request</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="publish_request">
          <FlowEnd>publicationPort.publish</FlowEnd>
          <FlowEnd>serverBehavior.publishing.request</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="deliver_response">
          <FlowEnd>serverBehavior.delivering.response</FlowEnd>
          <FlowEnd>subscriptionPort.deliver</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="serverBehavior">
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="subscribing">
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="request">
              <typings>Subscribe</typings>
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" direction="out" declaredName="topic">
              <typings>String</typings>
              <Multiplicity>1</Multiplicity>
              <valuePart>request.topic</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CommonNode" isThen="true" declaredName="continuePublishing"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="publishing">
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="request">
              <typings>Publish</typings>
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" direction="out" declaredName="topic">
              <Multiplicity>1</Multiplicity>
              <valuePart>request.topic</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="out" declaredName="publication">
              <Multiplicity>1</Multiplicity>
              <valuePart>request.publication</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CommonNode" isThen="true" nodeKind="decide"/>
          <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="publishing.topic == subscribing.topic">
            <transitionSuccessionElement refElement="delivering"/>
          </elements>
          <elements xsi:type="sysMLOC:TargetSuccessionElement">
            <transitionSuccessionElement refElement="continuePublishing"/>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="delivering">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="topic">
              <typings>String</typings>
              <Multiplicity>1</Multiplicity>
              <valuePart>subscribing.topic</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="publication">
              <Multiplicity>1</Multiplicity>
              <valuePart>publishing.publication</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="out" declaredName="response">
              <typings>Deliver</typings>
              <valuePart>Deliver(publication)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:TargetSuccessionElement">
            <transitionSuccessionElement refElement="continuePublishing"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceUsage" declaredName="subscription_interface">
        <typings>SubscriptionInterface</typings>
        <connectorPart refElement="consumer_3.subscriptionPort"/>
        <connectorPart refElement="server_3.subscriptionPort"/>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="subscribe_request">
          <FlowEnd>subscription_interface.source.subscribe</FlowEnd>
          <FlowEnd>subscription_interface.target.subscribe</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="deliver_response">
          <FlowEnd>subscription_interface.target.deliver</FlowEnd>
          <FlowEnd>subscription_interface.source.deliver</FlowEnd>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="consumer_3">
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="myTopic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="subscriptionPort">
          <typings>~SubscriptionPort</typings>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="out">
            <redefinitions>subscribe</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in">
            <redefinitions>deliver</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="subscribe_request">
          <FlowEnd>consumerBehavior.subscribe.request</FlowEnd>
          <FlowEnd>subscriptionPort.subscribe</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="deliver_response">
          <FlowEnd>subscriptionPort.deliver</FlowEnd>
          <FlowEnd>consumerBehavior.delivery.response</FlowEnd>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>isInstant</redefinitions>
            <valuePart>true</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="consumerBehavior">
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="subscribe">
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="out" declaredName="request">
              <typings>Subscribe</typings>
              <valuePart>Subscribe(myTopic)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="delivery">
            <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="response">
              <typings>Deliver</typings>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="realization_2">
      <typings>PubSubSequence</typings>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>producer_3</subsetting>
        <redefinitions>producer</redefinitions>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="producerBehavior.publish">
          <redefinitions>publish_source_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>server_3</subsetting>
        <redefinitions>server</redefinitions>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="serverBehavior.subscribing">
          <redefinitions>subscribe_target_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="serverBehavior.publishing">
          <redefinitions>publish_target_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="serverBehavior.delivering">
          <redefinitions>deliver_source_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>consumer_3</subsetting>
        <redefinitions>consumer</redefinitions>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="consumerBehavior.subscribe">
          <redefinitions>subscribe_source_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="consumerBehavior.delivery">
          <redefinitions>deliver_target_event</redefinitions>
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <redefinitions>publish_message</redefinitions>
        <FlowEnd>producer.producerBehavior.publish.request</FlowEnd>
        <FlowEnd>server.serverBehavior.publishing.request</FlowEnd>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="producer.publish_request">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="publication_interface.publish_request">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="server.publish_request">
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <redefinitions>subscribe_message</redefinitions>
        <FlowEnd>consumer.consumerBehavior.subscribe.request</FlowEnd>
        <FlowEnd>server.serverBehavior.subscribing.request</FlowEnd>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="consumer.subscribe_request">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="subscription_interface.subscribe_request">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="server.subscribe_request">
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <redefinitions>deliver_message</redefinitions>
        <FlowEnd>server.serverBehavior.delivering.response</FlowEnd>
        <FlowEnd>consumer.consumerBehavior.delivery.response</FlowEnd>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="server.deliver_response">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="subscription_interface.deliver_response">
          <Multiplicity>1</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="consumer.deliver_response">
          <Multiplicity>1</Multiplicity>
        </elements>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
