<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="MassConstraintExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="NumericalFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <subsetting>mass</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <subsetting>mass</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle1">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m" valuePart="eng.m + trans.m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <typings>Transmission</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle2">
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="m == eng.m + trans.m"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <typings>Transmission</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="MassConstraint3">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="totalMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses">
        <typings>MassValue</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>*</Multiplicity>
      </elements>
      <resultExpressionParameter resultExpression="totalMass == sum(partMasses)"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle3">
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="massConstraint">
        <typings>MassConstraint3</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="totalMass" valuePart="m"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" valuePart="(eng.m, trans.m)"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
          <typings>MassValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
          <typings>MassValue</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="MassConstraint4">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="totalMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses">
        <typings>MassValue</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>*</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="mc">
      <typings>MassConstraint4</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="totalMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses">
        <typings>MassValue</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>*</Multiplicity>
      </elements>
      <resultExpressionParameter resultExpression="totalMass == sum(partMasses)"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle4">
      <elements xsi:type="sysMLOC:AssertConstraintUsage" refElement="mc">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="totalMass" valuePart="m"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" valuePart="(eng.m, trans.m)"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <typings>Transmission</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="MassLimit">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="maxMass">
        <typings>MassValue</typings>
      </elements>
      <resultExpressionParameter resultExpression="mass &lt;= maxMass"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle5">
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="ml">
        <typings>MassLimit</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass" valuePart="m"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="maxMass" valuePart="2500 [kg]"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m" valuePart="eng.m + trans.m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <typings>Transmission</typings>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <typings>MassValue</typings>
          <redefinitions>m</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
