<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="MassRollup">
    <elements xsi:type="sysMLOC:NamespaceImport" visibility="private" declaredName="NumericalFunctions"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="MassedThing">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="totalMass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="simpleThing">
      <typings>MassedThing</typings>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>totalMass</redefinitions>
        <valuePart>mass</valuePart>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="compositeThing">
      <typings>MassedThing</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="subcomponents">
        <typings>MassedThing</typings>
        <Multiplicity>*</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true">
        <redefinitions>totalMass</redefinitions>
        <valuePart>mass + sum(subcomponents.totalMass)</valuePart>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="filteredMassThing">
      <subsetting>compositeThing</subsetting>
      <elements xsi:type="sysMLOC:AttributeUsage" isAbstract="true" declaredName="minMass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>totalMass</redefinitions>
        <valuePart>mass + sum(subcomponents.totalMass.?{in p :> ISQ::mass; p > minMass})</valuePart>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
