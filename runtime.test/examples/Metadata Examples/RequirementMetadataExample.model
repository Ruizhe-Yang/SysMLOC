<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="RequirementMetadataExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ModelingMetadata" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RiskMetadata" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RiskLevelEnum" isNamespace="true"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="Goal"/>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="goals" isNonunique="true">
      <typings>Goal</typings>
      <Multiplicity>*</Multiplicity>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="goal">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <redefinitions>baseType</redefinitions>
        <valuePart>goals meta SysML::RequirementUsage</valuePart>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'1'" declaredName="vehicleMassRequirement">
      <elements xsi:type="sysMLOC:Documentation" body="/* The total mass of a vehicle shall be less than or equal to the required mass. */"/>
      <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="StatusInfo">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="status">
          <valuePart>StatusKind::tbd</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="risk">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="totalRisk">
            <valuePart>high</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="technicalRisk">
            <valuePart>medium</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="scheduleRisk">
            <valuePart>low</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="costRisk">
            <valuePart>medium</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="originator">
          <valuePart>&quot;Bob&quot;</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="owner">
          <valuePart>&quot;Mary&quot;</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="deliverPayload">
      <prefixMetadataExtension>#goal</prefixMetadataExtension>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" declaredName="payloadMassLimit">
        <prefixMetadataExtension>#goal</prefixMetadataExtension>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" declaredName="vehicleMassRequirement" kind="require">
        <prefixMetadataExtension>#goal</prefixMetadataExtension>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
