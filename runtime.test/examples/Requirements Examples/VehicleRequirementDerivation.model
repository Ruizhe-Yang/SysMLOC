<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VehicleRequirementDerivation">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RequirementDerivation" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="chassis">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MassRequirement">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massLimit">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
        <resultExpressionParameter resultExpression="mass &lt;= massLimit"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="vehicleMassRequirement">
      <typings>MassRequirement</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" valuePart="vehicle.mass">
        <redefinitions>mass</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="chassisMassRequirement">
      <typings>MassRequirement</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" valuePart="vehicle.chassis.mass">
        <redefinitions>mass</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="engineMassRequirement">
      <typings>MassRequirement</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" valuePart="vehicle.engine.mass">
        <redefinitions>mass</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage">
      <prefixMetadataExtension>#derivation</prefixMetadataExtension>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
        <prefixMetadataExtension>#original</prefixMetadataExtension>
        <references>vehicleMassRequirement</references>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
        <prefixMetadataExtension>#derive</prefixMetadataExtension>
        <references>chassisMassRequirement</references>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
        <prefixMetadataExtension>#derive</prefixMetadataExtension>
        <references>engineMassRequirement</references>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
