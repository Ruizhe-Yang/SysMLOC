<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// SysML v2 Interpretation of the SysML v1 Room Connection Example&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:Package" declaredName="RoomModel">
    <elements xsi:type="sysMLOC:Package" declaredName="RoomDefinitionModelLibrary">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Port_Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Flow_Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="Part_Definitions">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Rooms&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Classroom">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="classEntry">
            <typings>EntryWay_to_Classroom</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Storageroom">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="storageEntry">
            <typings>EntryWay_to_Storageroom</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Hallway">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// conjugate ports with ~&#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="hallExit_to_Classroom">
            <typings>~EntryWay_to_Classroom</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="hallExit_to_Storageroom">
            <typings>~EntryWay_to_Storageroom</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="Port_Definitions">
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="EntryWay_to_Classroom">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="//flow properties&#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="student">
            <typings>Student</typings>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="teacher">
            <typings>Teacher</typings>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="furniture">
            <typings>Furniture</typings>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="air">
            <typings>Air</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="EntryWay_to_Storageroom">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="//flow properties&#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="furniture">
            <typings>Furniture</typings>
          </elements>
          <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="air">
            <typings>Air</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="Flow_Definitions">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Conveyed items between Hallway, Classroom, and Storageroom&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Air"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Furniture"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Student"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Teacher"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Room_Configuration">
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// defining the parts and their interconnection in context &#xD;&#xA;"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RoomDefinitionModelLibrary" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RoomDefinitionModelLibrary::Part_Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RoomDefinitionModelLibrary::Port_Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RoomDefinitionModelLibrary::Flow_Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="roomContext">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="c">
          <typings>Classroom</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="s">
          <typings>Storageroom</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="h">
          <typings>Hallway</typings>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//  Connectors and item flows between hallway and classroom&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToClassroom_Air">
          <FlowEnd>h.hallExit_to_Classroom.air</FlowEnd>
          <FlowEnd>c.classEntry.air</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToClassroom_Furniture">
          <FlowEnd>h.hallExit_to_Classroom.furniture</FlowEnd>
          <FlowEnd>c.classEntry.furniture</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToClassroom_Student">
          <FlowEnd>h.hallExit_to_Classroom.student</FlowEnd>
          <FlowEnd>c.classEntry.student</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToClassroom_Teacher">
          <FlowEnd>h.hallExit_to_Classroom.teacher</FlowEnd>
          <FlowEnd>c.classEntry.teacher</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToStorageroom_Air">
          <FlowEnd>h.hallExit_to_Storageroom.air</FlowEnd>
          <FlowEnd>s.storageEntry.air</FlowEnd>
        </elements>
        <elements xsi:type="sysMLOC:FlowConnectionUsage" declaredName="HallToStorageroom_Furniture">
          <FlowEnd>h.hallExit_to_Storageroom.furniture</FlowEnd>
          <FlowEnd>s.storageEntry.furniture</FlowEnd>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
