<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="AliasTest">
    <elements xsi:type="sysMLOC:MembershipImport" visibility="private" declaredName="ISQSpaceTime::breadth"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// import of an alias&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="b">
      <subsetting>breadth</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="P1">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="porig1"/>
      <elements xsi:type="sysMLOC:AliasElement" memberName="po1" memberElement="porig1"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="p1">
      <typings>P1</typings>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="po1">
        <redefinitions>po1</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="p2">
      <typings>P1</typings>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="pdest"/>
      <elements xsi:type="sysMLOC:AliasElement" memberName="pd1" memberElement="pdest"/>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage">
      <connectorPart>p1.po1</connectorPart>
      <connectorPart>p2.pdest</connectorPart>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage">
      <connectorPart>p1.po1</connectorPart>
      <connectorPart>p2.pd1</connectorPart>
    </elements>
  </packages>
</sysMLOC:Namespace>
