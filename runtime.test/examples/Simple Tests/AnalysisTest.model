<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="AnalysisTest">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="V">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="m"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vv">
      <typings>V</typings>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="AnalysisObjective">
      <elements xsi:type="sysMLOC:Documentation" body="/* ... */"/>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="AnalysisCase">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v">
        <typings>V</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="obj">
        <typings>AnalysisObjective</typings>
        <elements xsi:type="sysMLOC:SubjectUsage" valuePart="result"/>
      </elements>
      <resultExpressionParameter resultExpression="v.m"/>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="AnalysisPlan">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v">
        <typings>V</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <elements xsi:type="sysMLOC:Documentation" body="/* ... */"/>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="analysisCase">
        <typings>AnalysisCase</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="mass"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="analysisContext">
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="analysisPlan">
        <typings>AnalysisPlan</typings>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v" valuePart="vv"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
