<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="AssignmentTest">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Counter">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="count" isInitial="true">
        <typings>ScalarValues::Integer</typings>
        <valuePart>0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="incr">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="count" NodeParameter="count + 1"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="decr">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="count" NodeParameter="count - 1"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Incr"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Decr"/>
    <elements xsi:type="sysMLOC:StateDefinition" declaredName="Counting">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="counter">
        <typings>Counter</typings>
      </elements>
      <elements xsi:type="sysMLOC:EntryAction">
        <performedActionParameterPart xsi:type="sysMLOC:AssignmentActionUsage" featureChain="counter.count" NodeParameter="0"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isThen="true" declaredName="wait"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="Incr"/>
        <transitionSuccessionElement refElement="increment"/>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="Decr"/>
        <transitionSuccessionElement refElement="decrement"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="increment">
        <elements xsi:type="sysMLOC:DoActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:AssignmentActionUsage" featureChain="counter.count" NodeParameter="counter.count + 1"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <transitionSuccessionElement refElement="wait"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="decrement">
        <elements xsi:type="sysMLOC:DoActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:AssignmentActionUsage" featureChain="counter.count" NodeParameter="counter.count - 1"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <transitionSuccessionElement refElement="wait"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Increment">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="c">
        <typings>Counter</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>Counter</typings>
      </elements>
      <elements xsi:type="sysMLOC:PerformActionUsage" refElement="c.incr"/>
      <resultExpressionParameter resultExpression="c"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="a">
      <elements xsi:type="sysMLOC:StateUsage" declaredName="counting">
        <typings>Counting</typings>
      </elements>
      <elements xsi:type="sysMLOC:AssignmentNode" featureChain="counting.counter.count" NodeParameter="counting.counter.count + 1"/>
      <elements xsi:type="sysMLOC:AssignmentNode" featureChain="counting.counter.count" NodeParameter="Increment(counting.counter).count"/>
    </elements>
  </packages>
</sysMLOC:Namespace>
