<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:ActionDefinition" declaredName="DecisionTest">
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x">
      <valuePart>1</valuePart>
    </elements>
    <elements xsi:type="sysMLOC:CommonNode" declaredName="'test x'" nodeKind="decide"/>
    <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="x == 1">
      <transitionSuccessionElement refElement="A1"/>
    </elements>
    <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="x > 1">
      <transitionSuccessionElement refElement="A2"/>
    </elements>
    <elements xsi:type="sysMLOC:ElseNode">
      <elseEnd refElement="A3"/>
    </elements>
    <elements xsi:type="sysMLOC:CommonNode" isThen="true" nodeKind="decide"/>
    <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="true">
      <transitionSuccessionElement refElement="A1"/>
    </elements>
    <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="false">
      <transitionSuccessionElement refElement="A2"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="A1"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="A2"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="A3"/>
    <elements xsi:type="sysMLOC:IfNode" isSuccession="true" isFirst="true" firstElement="A1" ifConditionExpression="x == 0">
      <transitionSuccessionElement refElement="A2"/>
      <successionElement declaredName="S"/>
    </elements>
    <elements xsi:type="sysMLOC:InitialNode" memberElement="A3"/>
    <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="x > 0">
      <transitionSuccessionElement refElement="'test x'"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
