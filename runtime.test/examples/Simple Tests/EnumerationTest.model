<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="EnumerationTest">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Color">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="val">
        <typings>ScalarValues::Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="ColorKind">
      <superclassifiers>Color</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EnumerationDefinition can contain only EnumerationUsages. However,&#xD;&#xA;&#x9;&#x9; * it can specialize an AttributeDefinition in order to inherit&#xD;&#xA;&#x9;&#x9; * common features for its enumeration values.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="red">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>val</redefinitions>
          <valuePart>0</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="blue">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>val</redefinitions>
          <valuePart>1</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="green">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>val</redefinitions>
          <valuePart>2</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationUsage" declaredName="color">
      <typings>ColorKind</typings>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationUsage" declaredName="color1">
      <valuePart>ColorKind::blue</valuePart>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Implicitly typed by ColorKind.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="color2">
      <typings>ColorKind</typings>
      <valuePart>color1</valuePart>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="E1">
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="a"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="b"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="c"/>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The &quot;enum&quot; keyword is optional for EnumerationUsages used to define the&#xD;&#xA;&#x9;&#x9; * enumerated values of an EnumerationDefinition.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="E2"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Size">
      <superclassifiers>ScalarValues::Real</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EnumerationDefinition can also be used to restrict a supertype to&#xD;&#xA;&#x9;&#x9; * specific values.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="SizeChoice">
      <superclassifiers>Size</superclassifiers>
      <elements xsi:type="sysMLOC:EnumeratedValue">
        <valuePart>60.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue">
        <valuePart>70.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue">
        <valuePart>80.0</valuePart>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationUsage" declaredName="size">
      <typings>SizeChoice</typings>
      <valuePart>60.0</valuePart>
    </elements>
  </elements>
</sysMLOC:Namespace>
