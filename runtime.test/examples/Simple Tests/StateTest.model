<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="StateTest">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Sig">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="x"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Exit"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="p"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="act"/>
    <elements xsi:type="sysMLOC:StateDefinition" declaredName="S">
      <elements xsi:type="sysMLOC:DoActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="A"/>
      </elements>
      <elements xsi:type="sysMLOC:EntryActionNode"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <transitionSuccessionElement refElement="S1"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="S1"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter declaredName="s">
          <typings>Sig</typings>
        </acceptParameter>
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="D"/>
        <transitionSuccessionElement refElement="S2"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="S2">
        <elements xsi:type="sysMLOC:DoActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="Sig(T.s.x)" toNodeParameter="p"/>
        </elements>
        <elements xsi:type="sysMLOC:StateUsage" declaredName="S3"/>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="Exit"/>
        <transitionSuccessionElement refElement="done"/>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage" transitionSourceElement="S1">
        <acceptParameter declaredName="s">
          <typings>Sig</typings>
        </acceptParameter>
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="D"/>
        <transitionSuccessionElement refElement="S2.S3"/>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage" declaredName="T" transitionSourceElement="S2.S3" conditionalExpression="true">
        <acceptParameter declaredName="s" viaNodeParameter="p">
          <typings>Sig</typings>
        </acceptParameter>
        <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="s" toNodeParameter="p"/>
        <transitionSuccessionElement refElement="S1"/>
      </elements>
      <elements xsi:type="sysMLOC:ExitActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="act"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" declaredName="s" isParallel="true">
      <elements xsi:type="sysMLOC:StateUsage" declaredName="s1"/>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="s2"/>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" declaredName="s4">
      <elements xsi:type="sysMLOC:DoActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="a"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="c"/>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" declaredName="s5">
      <subsetting>s4</subsetting>
      <elements xsi:type="sysMLOC:DoActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="b">
          <redefinitions>c</redefinitions>
        </performedActionParameterPart>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
