<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="StructuredControlTest">
    <elements xsi:type="sysMLOC:ActionUsage">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="i" isInitial="true">
        <typings>ScalarValues::Integer</typings>
        <valuePart>0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="b">
        <typings>ScalarValues::Boolean</typings>
      </elements>
      <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="i &lt; 0">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="0"/>
        <elseNode ifConditionExpression="i == 0">
          <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="1"/>
          <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i + 1"/>
        </elseNode>
      </elements>
      <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="i > 0">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i + 1"/>
      </elements>
      <elements xsi:type="sysMLOC:WhileLoopNode" isThen="true" declaredName="aLoop" whileConditionExpression="i > 0" untilConditionExpression="b">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i - 1"/>
      </elements>
      <elements xsi:type="sysMLOC:WhileLoopNode" isThen="true" whileConditionExpression="i > 0">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i - 1"/>
      </elements>
      <elements xsi:type="sysMLOC:WhileLoopNode" untilConditionExpression="b">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i - 1"/>
      </elements>
      <elements xsi:type="sysMLOC:ForLoopNode" NodeParameter="(1, 2, 3)">
        <ForVariableParameter declaredName="n">
          <typings>ScalarValues::Integer</typings>
        </ForVariableParameter>
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="i" NodeParameter="i * n"/>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
