<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <intro body="// State Space Representation cart example&#xD;&#xA;"/>
  <packages declaredName="CartSample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="StateSpaceRepresentation" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cart">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartInput">
        <superclassifiers>Input</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="force">
          <subsetting>ISQ::force</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
          <subsetting>ISQ::speed</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartState">
        <superclassifiers>StateSpace</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
          <subsetting>ISQ::speed</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartStateDerivative">
        <superclassifiers>StateDerivative</superclassifiers>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <typings>CartState</typings>
          <redefinitions>stateSpace</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="accel">
          <subsetting>ISQ::acceleration</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Pusher">
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PusherOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="force">
          <subsetting>ISQ::force</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="context">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="cart">
        <typings>Cart</typings>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="cartBehavior">
          <typings>ContinuousStateSpaceDynamics</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
            <typings>CartInput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
            <typings>CartOutput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>CartState</typings>
            <redefinitions>stateSpace</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:CalculationUsage">
            <redefinitions>getDerivative</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
              <typings>CartInput</typings>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="stateSpace">
              <typings>CartState</typings>
            </elements>
            <resultExpressionParameter resultExpression="CartStateDerivative(input.force / mass)"/>
          </elements>
          <elements xsi:type="sysMLOC:CalculationUsage">
            <redefinitions>getOutput</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
              <typings>CartState</typings>
              <redefinitions>stateSpace</redefinitions>
            </elements>
            <resultExpressionParameter resultExpression="CartOutput(stateSpace.velocity)"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="pusher">
        <typings>Pusher</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pusherForce">
          <subsetting>ISQ::force</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="pusherBehavior">
          <typings>ContinuousStateSpaceDynamics</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
            <typings>PusherOutput</typings>
          </elements>
          <elements xsi:type="sysMLOC:CalculationUsage">
            <redefinitions>getOutput</redefinitions>
            <resultExpressionParameter resultExpression="PusherOutput(pusherForce)"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>pusher.pusherBehavior.output.force</FlowEnd>
        <FlowEnd>cart.cartBehavior.input.force</FlowEnd>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
