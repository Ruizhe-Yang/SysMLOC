<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// State Space Representation EV example&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:Package" declaredName="EVSample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="StateSpaceRepresentation" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'A&#x22c5;h'" declaredName="'ampere hour'">
      <typings>ElectricChargeUnit</typings>
      <valuePart>A*h</valuePart>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleInput">
        <superclassifiers>Input</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="force">
          <subsetting>ISQ::force</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="accel">
          <subsetting>ISQ::acceleration</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
          <subsetting>ISQ::speed</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="distance">
          <subsetting>ISQ::distance</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleState">
        <superclassifiers>StateSpace</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
          <subsetting>ISQ::speed</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="distance">
          <subsetting>ISQ::distance</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Battery">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="baseVoltage">
        <subsetting>ISQ::electricPotential</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="socInit">
        <typings>ScalarValues::Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="capacity">
        <subsetting>ISQ::electricCharge</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="internalResistance">
        <subsetting>ISQ::resistance</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="BatteryInput">
        <superclassifiers>Input</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="current">
          <subsetting>ISQ::electricCurrent</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="BatteryOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="voltage">
          <subsetting>ISQ::electricPotential</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="BatteryState">
        <superclassifiers>StateSpace</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="soc">
          <typings>ScalarValues::Real</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Motor">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="torquePerCurrent">
        <subsetting>Quantities::scalarQuantities</subsetting>
        <valuePart>ISQ::torque / ISQ::electricCurrent</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="motR">
        <subsetting>ISQ::resistance</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="motL">
        <subsetting>ISQ::inductance</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MotorInput">
        <superclassifiers>Input</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="voltage">
          <subsetting>ISQ::electricPotential</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="friction">
          <subsetting>ISQ::torque</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MotorOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="current">
          <subsetting>ISQ::electricCurrent</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="torque">
          <subsetting>ISQ::torque</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MotorState">
        <superclassifiers>StateSpace</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="current">
          <subsetting>ISQ::electricCurrent</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Tire">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="radius">
        <subsetting>ISQ::length</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="moment">
        <subsetting>ISQ::momentOfInertia</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TireInput">
        <superclassifiers>Input</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="torque">
          <subsetting>ISQ::torque</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="accel">
          <subsetting>ISQ::acceleration</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TireOutput">
        <superclassifiers>Output</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="force">
          <subsetting>ISQ::force</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="outTorque">
          <subsetting>ISQ::torque</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="VehicleRequirement">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="VehicleAnalysis">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="vehicleRequirement">
        <typings>VehicleRequirement</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="RangeRequirement">
      <superclassifiers>VehicleRequirement</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* The range of EV must be longer than the required spec under the flat road. */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="actualRange">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="requiredRange">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
        <resultExpressionParameter resultExpression="actualRange >= requiredRange"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="RangeAnalysis">
      <superclassifiers>VehicleAnalysis</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedRange">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="rangeRequirement">
        <typings>RangeRequirement</typings>
        <redefinitions>vehicleRequirement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="rangeAnalysisObjective">
        <elements xsi:type="sysMLOC:Documentation" body="/* This analysis is to estimate the range of&#xD;&#xA;                 * the EV by simulating the vehicle driving under the compact vehicle regulation.&#xD;&#xA;                 */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="rangeRequirement" kind="require">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>actualRange</redefinitions>
            <valuePart>simulatedRange</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="EfficiencyRequirement">
      <superclassifiers>VehicleRequirement</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* The efficiency of EV must be better than the required spec. */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="actualEfficiency"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="requiredEfficiency"/>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
        <resultExpressionParameter resultExpression="actualEfficiency >= requiredEfficiency"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="EfficiencyAnalysis">
      <superclassifiers>VehicleAnalysis</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedEfficiency"/>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="efficiencyRequirement">
        <typings>EfficiencyRequirement</typings>
        <redefinitions>vehicleRequirement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="efficiencyAnalysisObjective">
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="efficiencyRequirement" kind="require">
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>actualEfficiency</redefinitions>
            <valuePart>simulatedEfficiency</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MaxSpeedRequirement">
      <superclassifiers>VehicleRequirement</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* The maximum speed of EV must be larger than the required spec. */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="actualMaxSpeed">
        <subsetting>ISQ::speed</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="requiredMaxSpeed">
        <subsetting>ISQ::speed</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="MaxSpeedAnalysis">
      <superclassifiers>VehicleAnalysis</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedMaxSpeed"/>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="maxSpeedRequirement">
        <typings>MaxSpeedRequirement</typings>
        <redefinitions>vehicleRequirement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="maxSpeedAnalysisObjective">
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="maxSpeedRequirement" kind="require">
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>actualMaxSpeed</redefinitions>
            <valuePart>simulatedMaxSpeed</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true">
        <redefinitions>mass</redefinitions>
        <valuePart>1000[kg]</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* airFrictionCoefficient [kg / m] = 1/2 * rho[kg/m^3] * Cd * S[m^2],&#xD;&#xA;         * where rho is air density, S is front projected area. */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="airFrictionCoefficient">
        <valuePart>0.2</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="efficiency"/>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="vehicleBehavior">
        <typings>ContinuousStateSpaceDynamics</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
          <typings>VehicleInput</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
          <typings>VehicleOutput</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>VehicleState</typings>
          <redefinitions>stateSpace</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="battery">
        <typings>Battery</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>baseVoltage</redefinitions>
          <valuePart>300[V]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>capacity</redefinitions>
          <valuePart>50['A&#x22c5;h']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>socInit</redefinitions>
          <valuePart>0.8</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>internalResistance</redefinitions>
          <valuePart>1.8['&#x3a9;']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="batteryBehavior">
          <typings>ContinuousStateSpaceDynamics</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
            <typings>BatteryInput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
            <typings>BatteryOutput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>BatteryState</typings>
            <redefinitions>stateSpace</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>battery.batteryBehavior.output.voltage</FlowEnd>
        <FlowEnd>motor.motorBehavior.input.voltage</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>motor.motorBehavior.output.current</FlowEnd>
        <FlowEnd>battery.batteryBehavior.input.current</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="motor">
        <typings>Motor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>motR</redefinitions>
          <valuePart>4['&#x3a9;']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>motL</redefinitions>
          <valuePart>0.2[H]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="motorBehavior">
          <typings>ContinuousStateSpaceDynamics</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
            <typings>MotorInput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
            <typings>MotorOutput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>MotorState</typings>
            <redefinitions>stateSpace</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>motor.motorBehavior.output.torque</FlowEnd>
        <FlowEnd>tire.tireBehavior.input.torque</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>vehicleBehavior.output.accel</FlowEnd>
        <FlowEnd>tire.tireBehavior.input.accel</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="tire">
        <typings>Tire</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true">
          <redefinitions>moment</redefinitions>
          <valuePart>300['kg&#x22c5;m&#xb2;']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true">
          <redefinitions>radius</redefinitions>
          <valuePart>0.7[m]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="tireBehavior">
          <typings>ContinuousStateSpaceDynamics</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
            <typings>TireInput</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="output">
            <typings>TireOutput</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>tire.tireBehavior.output.outTorque</FlowEnd>
        <FlowEnd>motor.motorBehavior.input.friction</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <FlowEnd>tire.tireBehavior.output.force</FlowEnd>
        <FlowEnd>vehicleBehavior.input.force</FlowEnd>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_compact">
      <subsetting>vehicle</subsetting>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>mass</redefinitions>
        <valuePart>800[kg]</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>tire</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>moment</redefinitions>
          <valuePart>200['kg&#x22c5;m&#xb2;']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>radius</redefinitions>
          <valuePart>0.5[m]</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="smallEVRangeContext">
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="smallEVRequirement">
        <typings>VehicleRequirement</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/* The small EVs must be ligher than 900[kg] */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
          <redefinitions>vehicle</redefinitions>
          <valuePart>vehicle_compact</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/*  To comform with the regulation and the battery mass will impact it. */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage">
          <resultExpressionParameter resultExpression="vehicle.mass &lt; 900[kg]"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="smallEVAnalysis">
        <typings>VehicleAnalysis</typings>
        <elements xsi:type="sysMLOC:SubjectUsage">
          <subsetting>vehicle_compact</subsetting>
          <redefinitions>vehicle</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>vehicleRequirement</redefinitions>
          <valuePart>smallEVRequirement</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="C1" declaredName="rangeRequirementSmall">
        <typings>RangeRequirement</typings>
        <subsetting>smallEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The small EVs must run longer than 130km */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredRange</redefinitions>
          <valuePart>130[km]</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="rangeAnalysisSmall">
        <typings>RangeAnalysis</typings>
        <subsetting>smallEVAnalysis</subsetting>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>rangeRequirement</redefinitions>
          <valuePart>rangeRequirementSmall</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedRange">
          <valuePart>vehicle.vehicleBehavior.output.distance</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="C2" declaredName="efficiencyRequirementSmall">
        <typings>EfficiencyRequirement</typings>
        <subsetting>smallEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The target efficiency of small EVs is 0.9. */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredEfficiency</redefinitions>
          <valuePart>0.9</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="efficiencyAnalysisSmall">
        <typings>EfficiencyAnalysis</typings>
        <subsetting>smallEVAnalysis</subsetting>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>efficiencyRequirement</redefinitions>
          <valuePart>efficiencyRequirementSmall</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedEfficiency">
          <valuePart>vehicle.efficiency</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="C3" declaredName="maxSpeedRequirementSmall">
        <typings>MaxSpeedRequirement</typings>
        <subsetting>smallEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The target maximum speed of small EVs is 130 [km/h]. */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredMaxSpeed</redefinitions>
          <valuePart>130 [km/h]</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="maxSpeedAnalysisSmall">
        <typings>MaxSpeedAnalysis</typings>
        <subsetting>smallEVAnalysis</subsetting>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>maxSpeedRequirement</redefinitions>
          <valuePart>maxSpeedRequirementSmall</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="voltage">
          <subsetting>ISQ::electricPotential</subsetting>
          <valuePart>vehicle.battery.batteryBehavior.output.voltage</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedMaxSpeed">
          <valuePart>vehicle.vehicleBehavior.output.velocity</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_large">
      <subsetting>vehicle</subsetting>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>mass</redefinitions>
        <valuePart>1100[kg]</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>tire</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>moment</redefinitions>
          <valuePart>300['kg&#x22c5;m&#xb2;']</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>radius</redefinitions>
          <valuePart>0.7[m]</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="largeEVRangeContext">
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="largeEVRequirement">
        <typings>VehicleRequirement</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/* The large EVs must be ligher than 900[kg] */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
          <redefinitions>vehicle</redefinitions>
          <valuePart>vehicle_large</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/*  To comform with the regulation and the battery mass will impact it. */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage">
          <resultExpressionParameter resultExpression="vehicle.mass &lt; 1200[kg]"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="largeEVAnalysis">
        <typings>VehicleAnalysis</typings>
        <elements xsi:type="sysMLOC:SubjectUsage">
          <subsetting>vehicle_large</subsetting>
          <redefinitions>vehicle</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>vehicleRequirement</redefinitions>
          <valuePart>largeEVRequirement</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="L1" declaredName="rangeRequirementLarge">
        <typings>RangeRequirement</typings>
        <subsetting>largeEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The large EVs must run longer than 200km */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredRange</redefinitions>
          <valuePart>200[km]</valuePart>
        </elements>
      </elements>
