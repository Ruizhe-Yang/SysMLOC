        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="voltage">
          <valuePart>vehicle.battery.batteryBehavior.output.voltage</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedMaxSpeed">
          <valuePart>vehicle.vehicleBehavior.output.velocity</valuePart>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
