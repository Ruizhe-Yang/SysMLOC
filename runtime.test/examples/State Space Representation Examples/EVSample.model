          <redefinitions>rangeRequirement</redefinitions>
          <valuePart>rangeRequirementLarge</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedRange">
          <valuePart>vehicle.vehicleBehavior.output.distance</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="L2" declaredName="efficiencyRequirementLarge">
        <typings>EfficiencyRequirement</typings>
        <subsetting>largeEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The target efficiency of large EVs is 0.8. */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredEfficiency</redefinitions>
          <valuePart>0.8</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="efficiencyAnalysisLarge">
        <typings>EfficiencyAnalysis</typings>
        <subsetting>largeEVAnalysis</subsetting>
        <elements xsi:type="sysMLOC:RequirementUsage">
          <redefinitions>efficiencyRequirement</redefinitions>
          <valuePart>efficiencyRequirementLarge</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="simulatedEfficiency">
          <valuePart>vehicle.efficiency</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="L3" declaredName="maxSpeedRequirementLarge">
        <typings>MaxSpeedRequirement</typings>
        <subsetting>largeEVRequirement</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* The target maximum speed of large EVs is 140 [km/h]. */"/>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>requiredMaxSpeed</redefinitions>
          <valuePart>140 [km/h]</valuePart>
        </elements>
