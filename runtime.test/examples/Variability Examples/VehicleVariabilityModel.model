<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VehicleVariabilityModel">
    <elements xsi:type="sysMLOC:Package" declaredName="DesignModel">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="PartDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="PartsTree" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ActionDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ActionTree" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="PartDefinitions">
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Diameter"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cylinder">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="diameter">
            <typings>Diameter</typings>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Sunroof"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="AutoPort"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
          <typings>Vehicle</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
            <typings>Engine</typings>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
            <typings>Transmission</typings>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="sunroof">
            <typings>Sunroof</typings>
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
          <typings>Engine</typings>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="autoPort">
            <typings>AutoPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="cylinder">
            <typings>Cylinder</typings>
            <Multiplicity>2</Multiplicity>
            <Multiplicity>*</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="'4cylEngine'">
          <subsetting>engine</subsetting>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>cylinder</redefinitions>
            <Multiplicity>4</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="'6cylEngine'">
          <subsetting>engine</subsetting>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>cylinder</redefinitions>
            <Multiplicity>6</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
          <typings>Transmission</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="manualTransmission">
          <subsetting>transmission</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="automaticTransmission">
          <subsetting>transmission</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ActionDefinitions">
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="GenerateTorque"/>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AmplifyTorque"/>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ProvidePower"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ActionTree">
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateTorque4Cyl">
          <typings>GenerateTorque</typings>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateTorque6Cyl">
          <typings>GenerateTorque</typings>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="amplifyTorqueManual">
          <typings>AmplifyTorque</typings>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="amplifyTorqueAutomatic">
          <typings>AmplifyTorque</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'150% Model'">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="DesignModel" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Variation point definitions&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" isVariation="true" declaredName="DiameterChoices">
          <superclassifiers>Diameter</superclassifiers>
          <elements xsi:type="sysMLOC:AttributeUsage" isVariant="true" declaredName="diameterSmall"/>
          <elements xsi:type="sysMLOC:AttributeUsage" isVariant="true" declaredName="diameterLarge"/>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" isVariation="true" declaredName="EngineChoices">
          <superclassifiers>Engine</superclassifiers>
          <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="'4cylEngine'"/>
          <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="'6cylEngine'">
            <elements xsi:type="sysMLOC:PortUsage" isVariation="true">
              <redefinitions>autoPort</redefinitions>
              <elements xsi:type="sysMLOC:PortUsage" isVariant="true" declaredName="autoPort1"/>
              <elements xsi:type="sysMLOC:PortUsage" isVariant="true" declaredName="autoPort2"/>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage">
              <redefinitions>cylinder</redefinitions>
              <elements xsi:type="sysMLOC:AttributeUsage">
                <typings>DiameterChoices</typings>
                <redefinitions>diameter</redefinitions>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:AssertConstraintUsage">
              <resultExpressionParameter resultExpression="(autoPort == autoPort::autoPort1 &amp; cylinder.diameter == cylinder::diameter::diameterSmall) ^ (autoPort == autoPort::autoPort2 &amp; cylinder.diameter == cylinder::diameter::diameterLarge)"/>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Part superset model&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="vehicleFamily">
          <subsetting>vehicle</subsetting>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Variation point usage&#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage">
            <typings>EngineChoices</typings>
            <redefinitions>engine</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Variation point with embedded variant definitions&#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" isVariation="true">
            <typings>Transmission</typings>
            <redefinitions>transmission</redefinitions>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="manualTransmission"/>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="automaticTransmission"/>
          </elements>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="(engine == '4cylEngine' &amp; transmission == transmission::manualTransmission) ^ (engine == '6cylEngine' &amp; transmission == transmission::automaticTransmission)"/>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Variation point on variant multiplicity (inherited multiplicity is [0..1]) &#xD;&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" isVariation="true">
            <redefinitions>sunroof</redefinitions>
            <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="withSunroof">
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="withoutSunroof">
              <Multiplicity>0</Multiplicity>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="ActionTree::providePowerFamily"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ActionTree">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Action superset Model&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="providePowerFamily">
          <typings>ProvidePower</typings>
          <elements xsi:type="sysMLOC:ActionUsage" isVariation="true" declaredName="generateTorque">
            <typings>GenerateTorque</typings>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="generateTorque4Cyl"/>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="generateTorque6Cyl"/>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isVariation="true" declaredName="amplifyTorque">
            <typings>AmplifyTorque</typings>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="amplifyTorqueManual"/>
            <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="amplifyTorqueAutomatic"/>
          </elements>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="(generateTorque == generateTorque::generateTorque4Cyl &amp; amplifyTorque == amplifyTorque::amplifyTorqueManual ) xor (generateTorque == generateTorque::generateTorque6Cyl &amp; amplifyTorque == amplifyTorque::amplifyTorqueAutomatic )"/>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'100% Model'">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'150% Model'" isNamespace="true"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Vehicle instance model&#xD;&#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle4Cyl">
        <subsetting>PartsTree::vehicleFamily</subsetting>
        <elements xsi:type="sysMLOC:PartUsage" valuePart="engine::'4cylEngine'">
          <redefinitions>engine</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" valuePart="transmission::manualTransmission">
          <redefinitions>transmission</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" valuePart="sunroof::withoutSunroof">
          <redefinitions>sunroof</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage">
          <redefinitions>providePowerFamily</redefinitions>
          <elements xsi:type="sysMLOC:ActionUsage" valuePart="generateTorque::generateTorque4Cyl">
            <redefinitions>generateTorque</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" valuePart="amplifyTorque::amplifyTorqueManual">
            <redefinitions>amplifyTorque</redefinitions>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
