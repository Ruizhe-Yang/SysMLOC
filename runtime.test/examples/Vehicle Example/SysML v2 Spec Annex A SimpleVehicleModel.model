        <elements xsi:type="sysMLOC:Package" declaredName="ActionTree">
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="providePower">
            <typings>ProvidePower</typings>
            <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelCmd">
              <typings>FuelCmd</typings>
              <redefinitions>pwrCmd</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelToRoadTorque">
              <redefinitions>wheelToRoadTorque</redefinitions>
              <Multiplicity>2</Multiplicity>
              <valuePart>distributeTorque.wheelToRoadTorque</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateTorque">
              <typings>GenerateTorque</typings>
              <elements xsi:type="sysMLOC:ItemUsage" direction="in">
                <valuePart>providePower.fuelCmd</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="amplifyTorque">
              <typings>AmplifyTorque</typings>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="transferTorque">
              <typings>TransferTorque</typings>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="distributeTorque">
              <typings>DistributeTorque</typings>
            </elements>
            <elements xsi:type="sysMLOC:CodeAnnotation" body="//named flow&#xA;"/>
            <elements xsi:type="sysMLOC:FlowUsage" declaredName="generateToAmplify">
              <FlowEnd>generateTorque.engineTorque</FlowEnd>
              <FlowEnd>amplifyTorque.engineTorque</FlowEnd>
            </elements>
            <elements xsi:type="sysMLOC:CodeAnnotation" body="//unnamed flows&#xA;"/>
            <elements xsi:type="sysMLOC:FlowUsage">
              <FlowEnd>amplifyTorque.transmissionTorque</FlowEnd>
              <FlowEnd>transferTorque.transmissionTorque</FlowEnd>
            </elements>
            <elements xsi:type="sysMLOC:FlowUsage">
              <FlowEnd>transferTorque.driveshaftTorque</FlowEnd>
              <FlowEnd>distributeTorque.driveshaftTorque</FlowEnd>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="performSelfTest">
            <typings>PerformSelfTest</typings>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="applyParkingBrake">
            <typings>ApplyParkingBrake</typings>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="senseTemperature">
            <typings>SenseTemperature</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Package" declaredName="DiscreteInteractions">
          <elements xsi:type="sysMLOC:Package" declaredName="Sequence">
            <elements xsi:type="sysMLOC:PartDefinition" declaredName="Driver">
              <elements xsi:type="sysMLOC:PortUsage" declaredName="p1"/>
              <elements xsi:type="sysMLOC:PortUsage" declaredName="p2"/>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="part0">
              <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="startVehicle">
                <elements xsi:type="sysMLOC:SendNode" declaredName="turnVehicleOn" sendNodeParameter="true" viaNodeParameter="driver.p1">
                  <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="ignitionCmd">
                    <typings>IgnitionCmd</typings>
                  </elements>
                </elements>
                <elements xsi:type="sysMLOC:AcceptNode" declaredName="trigger1">
                  <acceptParameter declaredName="ignitionCmd" viaNodeParameter="vehicle.ignitionCmdPort">
                    <typings>IgnitionCmd</typings>
                  </acceptParameter>
                </elements>
                <elements xsi:type="sysMLOC:FlowUsage">
                  <itemFeatureParameter payloadFeatureElement="IgnitionCmd"/>
                  <FlowEnd>trigger1.ignitionCmd</FlowEnd>
                  <FlowEnd>startEngine.ignitionCmd</FlowEnd>
                </elements>
                <elements xsi:type="sysMLOC:ActionUsage" declaredName="startEngine">
                  <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="ignitionCmd">
                    <typings>IgnitionCmd</typings>
                  </elements>
                  <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="es">
                    <typings>EngineStatus</typings>
                  </elements>
                </elements>
                <elements xsi:type="sysMLOC:FlowUsage">
                  <itemFeatureParameter payloadFeatureElement="EngineStatus"/>
                  <FlowEnd>startEngine.es</FlowEnd>
                  <FlowEnd>sendStatus.es</FlowEnd>
                </elements>
                <elements xsi:type="sysMLOC:SendNode" declaredName="sendStatus" sendNodeParameter="true" viaNodeParameter="vehicle.statusPort">
                  <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="es">
                    <typings>EngineStatus</typings>
                  </elements>
                </elements>
                <elements xsi:type="sysMLOC:AcceptNode" declaredName="trigger2">
                  <acceptParameter declaredName="es" viaNodeParameter="driver.p2">
                    <typings>EngineStatus</typings>
                  </acceptParameter>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="driver">
                <typings>Driver</typings>
                <elements xsi:type="sysMLOC:PerformActionUsage" refElement="startVehicle.turnVehicleOn"/>
                <elements xsi:type="sysMLOC:PerformActionUsage" refElement="startVehicle.trigger2"/>
                <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="driverReady"/>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
                <typings>Vehicle</typings>
                <elements xsi:type="sysMLOC:PerformActionUsage" refElement="startVehicle.trigger1"/>
                <elements xsi:type="sysMLOC:PerformActionUsage" refElement="startVehicle.sendStatus"/>
                <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="doorClosed"/>
              </elements>
              <elements xsi:type="sysMLOC:SuccessionAsUsage">
                <connectorPart refElement="vehicle.doorClosed"/>
                <connectorPart refElement="driver.driverReady"/>
              </elements>
              <elements xsi:type="sysMLOC:Message">
                <itemFeatureParameter declaredName="ignitionCmd">
                  <typings>IgnitionCmd</typings>
                </itemFeatureParameter>
                <FlowEnd>driver.turnVehicleOn</FlowEnd>
                <FlowEnd>vehicle.trigger1</FlowEnd>
              </elements>
              <elements xsi:type="sysMLOC:Message">
                <itemFeatureParameter declaredName="es">
                  <typings>EngineStatus</typings>
                </itemFeatureParameter>
                <FlowEnd>vehicle.sendStatus</FlowEnd>
                <FlowEnd>driver.trigger2</FlowEnd>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="CruiseControl1">
            <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b">
              <subsetting>PartsTree::vehicle_b</subsetting>
              <elements xsi:type="sysMLOC:PortUsage">
                <redefinitions>setSpeedPort</redefinitions>
                <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="setSpeedReceived"/>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>speedSensor</redefinitions>
                <elements xsi:type="sysMLOC:PortUsage">
                  <redefinitions>speedSensorPort</redefinitions>
                  <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="sensedSpeedSent"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>vehicleSoftware</redefinitions>
                <elements xsi:type="sysMLOC:PartUsage">
                  <redefinitions>vehicleController</redefinitions>
                  <elements xsi:type="sysMLOC:PartUsage">
                    <redefinitions>cruiseController</redefinitions>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>setSpeedPort</redefinitions>
                      <elements xsi:type="sysMLOC:CodeAnnotation" body="//analagous to gate: event occurrence bound but may not need this since the port is bound&#xA;"/>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="setSpeedReceived">
                        <valuePart>vehicle_b.setSpeedPort.setSpeedReceived</valuePart>
                      </elements>
                    </elements>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>speedSensorPort</redefinitions>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="sensedSpeedReceived"/>
                    </elements>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>cruiseControlPort</redefinitions>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="fuelCmdSent"/>
                    </elements>
                  </elements>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>engine</redefinitions>
                <elements xsi:type="sysMLOC:PortUsage">
                  <redefinitions>fuelCmdPort</redefinitions>
                  <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="fuelCmdReceived"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:Message" declaredName="sendSensedSpeed">
                <itemFeatureParameter payloadFeatureElement="SensedSpeed"/>
                <FlowEnd>speedSensor.speedSensorPort.sensedSpeedSent</FlowEnd>
                <FlowEnd>vehicleSoftware.vehicleController.cruiseController.speedSensorPort.sensedSpeedReceived</FlowEnd>
              </elements>
              <elements xsi:type="sysMLOC:Message" declaredName="sendFuelCmd">
                <itemFeatureParameter payloadFeatureElement="FuelCmd"/>
                <FlowEnd>vehicleSoftware.vehicleController.cruiseController.cruiseControlPort.fuelCmdSent</FlowEnd>
                <FlowEnd>engine.fuelCmdPort.fuelCmdReceived</FlowEnd>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="CruiseControl2">
            <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b">
              <subsetting>PartsTree::vehicle_b</subsetting>
              <elements xsi:type="sysMLOC:PortUsage">
                <redefinitions>setSpeedPort</redefinitions>
                <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="setSpeedReceived"/>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>speedSensor</redefinitions>
                <elements xsi:type="sysMLOC:PortUsage">
                  <redefinitions>speedSensorPort</redefinitions>
                  <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="sendSensedSpeed.source"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>vehicleSoftware</redefinitions>
                <elements xsi:type="sysMLOC:PartUsage">
                  <redefinitions>vehicleController</redefinitions>
                  <elements xsi:type="sysMLOC:PartUsage">
                    <redefinitions>cruiseController</redefinitions>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>setSpeedPort</redefinitions>
                      <elements xsi:type="sysMLOC:CodeAnnotation" body="//analagous to gate: event occurrence bound but may not need this since the port is bound&#xA;"/>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="setSpeedReceived">
                        <valuePart>vehicle_b.setSpeedPort.setSpeedReceived</valuePart>
                      </elements>
                    </elements>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>speedSensorPort</redefinitions>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="setSpeedReceived">
                        <valuePart>setSpeedPort.setSpeedReceived</valuePart>
                      </elements>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="sendSensedSpeed.target"/>
                    </elements>
                    <elements xsi:type="sysMLOC:PortUsage">
                      <redefinitions>cruiseControlPort</redefinitions>
                      <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="sendFuelCmd.source"/>
                    </elements>
                  </elements>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage">
                <redefinitions>engine</redefinitions>
                <elements xsi:type="sysMLOC:PortUsage">
                  <redefinitions>fuelCmdPort</redefinitions>
                  <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="sendFuelCmd.target"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:Message" declaredName="sendSensedSpeed">
                <itemFeatureParameter payloadFeatureElement="SensedSpeed"/>
              </elements>
              <elements xsi:type="sysMLOC:Message" declaredName="sendFuelCmd">
                <itemFeatureParameter payloadFeatureElement="FuelCmd"/>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Package" declaredName="Requirements">
          <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="RequirementDerivation" isNamespace="true"/>
          <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ModelingMetadata" isNamespace="true"/>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// incudes status info&#xA;"/>
          <elements xsi:type="sysMLOC:ItemUsage" declaredName="marketSurvey"/>
          <elements xsi:type="sysMLOC:Dependency">
            <client>vehicleSpecification</client>
            <supplier>marketSurvey</supplier>
          </elements>
          <elements xsi:type="sysMLOC:RequirementUsage" declaredName="vehicleSpecification">
            <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
              <typings>Vehicle</typings>
            </elements>
            <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'1'" declaredName="vehicleMassRequirement">
              <typings>MassRequirement</typings>
              <elements xsi:type="sysMLOC:Documentation" body="/* The total mass of the vehicle shall be less than or equal to the required mass.&#xA;                        Assume total mass includes a full tank of gas of 60 kg*/"/>
              <elements xsi:type="sysMLOC:AttributeUsage">
                <redefinitions>massRequired</redefinitions>
                <valuePart>2000 [kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true">
                <redefinitions>massActual</redefinitions>
                <valuePart>vehicle.dryMass + fuelMassActual</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelMassActual">
                <subsetting>ISQ::mass</subsetting>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelMassMax">
                <subsetting>ISQ::mass</subsetting>
                <valuePart>60 [kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:RequirementConstraintUsage">
                <resultExpressionParameter resultExpression="fuelMassActual==fuelMassMax"/>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:AllocationUsage">
              <connectorPart refElement="vehicleMassRequirement"/>
              <connectorPart refElement="PartsTree::vehicle_b.mass"/>
            </elements>
            <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'2'" declaredName="vehicleFuelEconomyRequirements">
              <elements xsi:type="sysMLOC:Documentation" body="/* fuel economy requirements group */"/>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="assumedCargoMass">
                <subsetting>ISQ::mass</subsetting>
              </elements>
              <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'2_1'" declaredName="cityFuelEconomyRequirement">
                <typings>FuelEconomyRequirement</typings>
                <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                  <redefinitions>requiredFuelEconomy</redefinitions>
                  <valuePart>10 [km / L]</valuePart>
                </elements>
                <elements xsi:type="sysMLOC:RequirementConstraintUsage">
                  <resultExpressionParameter resultExpression="assumedCargoMass&lt;=500 [kg]"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'2_2'" declaredName="highwayFuelEconomyRequirement">
                <typings>FuelEconomyRequirement</typings>
                <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                  <redefinitions>requiredFuelEconomy</redefinitions>
                  <valuePart>12.75 [km / L]</valuePart>
                </elements>
                <elements xsi:type="sysMLOC:RequirementConstraintUsage">
                  <resultExpressionParameter resultExpression="assumedCargoMass&lt;=500 [kg]"/>
                </elements>
                <elements xsi:type="sysMLOC:CodeAnnotation" body="//StatusInfo is contained in ModelingMetadata library&#xA;"/>
                <elements xsi:type="sysMLOC:CodeAnnotation" body="// StatusKind has values for open, closed, tbd, tbr, tbd&#xA;"/>
                <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="StatusInfo">
                  <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="status">
                    <valuePart>StatusKind::closed</valuePart>
                  </elements>
                  <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="originator">
                    <valuePart>&quot;Bob&quot;</valuePart>
                  </elements>
                  <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="owner">
                    <valuePart>&quot;Mary&quot;</valuePart>
                  </elements>
                </elements>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:RequirementUsage" declaredName="engineSpecification">
            <elements xsi:type="sysMLOC:SubjectUsage" declaredName="engine1">
              <typings>Engine</typings>
            </elements>
            <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'1'" declaredName="engineMassRequirement">
              <typings>MassRequirement</typings>
              <elements xsi:type="sysMLOC:Documentation" body="/* The total mass of the engine shall be less than or equal to the required mass.*/"/>
              <elements xsi:type="sysMLOC:AttributeUsage">
                <redefinitions>massRequired</redefinitions>
                <valuePart>200 [kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage">
                <redefinitions>massActual</redefinitions>
                <valuePart>engine1.mass</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:RequirementUsage" declaredName="torqueGenerationRequirement">
              <typings>TorqueGenerationRequirement</typings>
              <elements xsi:type="sysMLOC:SubjectUsage" declaredName="generateTorque" isDefault="true">
                <valuePart>engine1.generateTorque</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:RequirementUsage" declaredName="drivePowerOutputRequirement">
              <typings>DrivePowerOutputRequirement</typings>
              <elements xsi:type="sysMLOC:PortUsage" declaredName="torqueOutPort">
                <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="torque">
                  <typings>Torque</typings>
                </elements>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// the engine mass requirement is derived from the vehicle mass requirement&#xA;"/>
          <elements xsi:type="sysMLOC:ConnectionUsage">
            <prefixMetadataExtension>#derivation</prefixMetadataExtension>
            <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
              <prefixMetadataExtension>#original</prefixMetadataExtension>
              <references>vehicleSpecification.vehicleMassRequirement</references>
            </elements>
            <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
              <prefixMetadataExtension>#derive</prefixMetadataExtension>
              <references>engineSpecification.engineMassRequirement</references>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="Engine4Cyl_Variant">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ModelingMetadata" isNamespace="true"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// incudes refinement&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
