      <elements xsi:type="sysMLOC:Package" declaredName="FuelEconomyAnalysisModel">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SampledFunctions::SampledFunction"/>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;            This analysis model was provided by Hisashi Miyashita on January 27, 2021&#xA;              We use the simplest fuel consumption analysis model introduced in:&#xA;              Akcelik, R. &quot;Fuel efficiency and other objectives in traffic system management.&quot; Traffic Engineering and Control 22.2 (1981): 54-65. &#xA;&#xA;              Fuel consumption rate f can be decomposed to:&#xA;              f = f_a + f_b * tpd_avg,&#xA;              where tpd_avg is average interrupted travel time per unit distance, actually the inverse of the average velocity [t/km];&#xA;              f_a is the best fuel consumption per distance; and&#xA;              f_b is the additional fuel consumption per distance and average travel time, which can be regarded as the idling fuel consumption.&#xA;              Approximately, it is proportional to engine displacement and it ranges from 0.5 to 0.6 [l/hour/litre of engine displacement]&#xA;              according to:&#xA;              Review of the Incidence, Energy Use and Costs of Passenger Vehicle Idling; Gordon W. Taylor, P.Eng. Prepared for the Office of Energy Efficiency, Natural Resources Canada, 2003&#xA;&#xA;              We assume f_a can be approximated to&#xA;              fuel_consumption / distance = BSFC * SGG * required_power_avg * tpd_avg,&#xA;              where required_power_avg is the required power, and it can be approximately derived from:&#xA;                  total_energy == P_req * tpd_avg * distance == 1/2 * mass / tpd_avg^2&#xA;              This part is computed with BestFuelConsumptionPerDistance calc def.&#xA;&#xA;              BSFC means Brake-Specific Fuel Consumption, defined as gram/power.  SGG is the specific gravity of gasoline.&#xA;              The high octane gasoline is about 0.76[l/kg].&#xA;            */"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Scenario">
          <superclassifiers>SampledFunction</superclassifiers>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="wayPoint">
            <Multiplicity>1</Multiplicity>
            <Multiplicity>*</Multiplicity>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="elapseTime">
              <subsetting>ISQ::time</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="position">
              <subsetting>ISQ::distance</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="FuelConsumption">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="bestFuelConsumption">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="idlingFuelConsumption">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="tpd_avg">
            <subsetting>timePerDistance</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="f">
            <valuePart>bestFuelConsumption + idlingFuelConsumption * tpd_avg</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="dpv">
            <subsetting>distancePerVolume</subsetting>
            <valuePart>1/f</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="AverageTravelTimePerDistance">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="scenario">
            <typings>Scenario</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="tpd_avg">
            <subsetting>timePerDistance</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="TraveledDistance">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="scenario">
            <typings>Scenario</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="distance">
            <subsetting>length</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="IdlingFuelConsumptionPerTime">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
            <typings>Engine</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="idlingFuelConsumptionPerDisplacement">
            <typings>Real</typings>
            <valuePart>0.5</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="f_a">
            <typings>Real</typings>
            <valuePart>engine.displacement * idlingFuelConsumptionPerDisplacement</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="specificGravityOfGasoline">
          <typings>Real</typings>
          <valuePart>0.76</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="BestFuelConsumptionPerDistance">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass">
            <typings>MassValue</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="bsfc">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="tpd_avg">
            <subsetting>timePerDistance</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="distance">
            <subsetting>length</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="required_power_avg">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:ConstraintUsage">
            <resultExpressionParameter resultExpression="required_power_avg == 1/2 * mass * tpd_avg **(-3) / distance"/>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="f_b">
            <typings>Real</typings>
            <valuePart>bsfc * specificGravityOfGasoline * required_power_avg * tpd_avg</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="ComputeBSFC">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
            <typings>Engine</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="fuelEconomyAnalysis">
          <elements xsi:type="sysMLOC:SubjectUsage">
            <valuePart>vehicle_b</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="fuelEconomyAnalysisObjective">
            <elements xsi:type="sysMLOC:Documentation" body="/*estimate the vehicle fuel economy*/"/>
            <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="vehicleSpecification.vehicleFuelEconomyRequirements" kind="require"/>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="scenario">
            <typings>Scenario</typings>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// define a series of waypoints&#xA;"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="distance">
            <valuePart>TraveledDistance(scenario)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tpd_avg">
            <valuePart>AverageTravelTimePerDistance(scenario)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="bsfc">
            <valuePart>ComputeBSFC(vehicle_b.engine)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="f_a">
            <valuePart>BestFuelConsumptionPerDistance(vehicle_b.mass, bsfc, tpd_avg, distance)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="f_b">
            <valuePart>IdlingFuelConsumptionPerTime(vehicle_b.engine)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="calculatedFuelEconomy">
            <subsetting>distancePerVolume</subsetting>
            <valuePart>FuelConsumption(f_a, f_b, tpd_avg)</valuePart>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ElectricalPowerAnalysis"/>
      <elements xsi:type="sysMLOC:Package" declaredName="ReliabilityAnalyis"/>
      <elements xsi:type="sysMLOC:Package" declaredName="VehicleTradeOffAnalysis">
        <elements xsi:type="sysMLOC:Comment" body="/* The following example provides the rationale for selecting the engine4cyl. &#xA;            The rationale and risk are contained in a metadata library. */"/>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Rationale">
          <annotatedElement>engineTradeOffAnalysis::vehicle_b_engine4cyl</annotatedElement>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="explanation">
            <valuePart>VehicleAnalysis::VehicleTradeOffAnalysis::engineTradeOffAnalysis</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="text">
            <valuePart>&quot;the engine4cyl was evaluated to have a higher objective function compared to the engine6cyl based on the trade-off analyiss&quot;</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// The following risk for the engine4cyl could have been included as part of the objective evaluaiton criteria&#xA;"/>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Risk">
          <annotatedElement>engineTradeOffAnalysis::vehicle_b_engine4cyl</annotatedElement>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="totalRisk">
            <valuePart>medium</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="technicalRisk">
            <valuePart>medium</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="scheduleRisk">
            <valuePart>medium</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="costRisk">
            <valuePart>RiskLevelEnum::low</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Risk">
          <annotatedElement>engineTradeOffAnalysis::vehicle_b_engine4cyl::engine::fuelEfficiency</annotatedElement>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="technicalRisk">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="probability">
              <valuePart>0.3</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="impact">
              <valuePart>0.5</valuePart>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="TradeStudies" isNamespace="true"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//evaluation function with criterion engine mass, engine power, and engine cost&#xA;"/>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="EngineEvaluation">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enginePower">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineFuelEfficiency">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineCost">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="eval">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="EngineEvaluation_4cyl">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enginePower">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineFuelEfficiency">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineCost">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="eval">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="EngineEvaluation_6cyl">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enginePower">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineFuelEfficiency">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineCost">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="eval">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="engineTradeOffAnalysis">
          <typings>TradeStudy</typings>
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicleAlternatives">
            <subsetting>vehicle_b</subsetting>
            <Multiplicity>2</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b_engine4cyl">
            <subsetting>vehicleAlternatives</subsetting>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
              <redefinitions>engine</redefinitions>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="cylinders">
                <redefinitions>cylinders</redefinitions>
                <Multiplicity>4</Multiplicity>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
                <redefinitions>mass</redefinitions>
                <valuePart>180 [kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="peakHorsePower">
                <redefinitions>peakHorsePower</redefinitions>
                <valuePart>180 [W]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelEfficiency">
                <redefinitions>fuelEfficiency</redefinitions>
                <valuePart>.6</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cost">
                <redefinitions>cost</redefinitions>
                <valuePart>1000</valuePart>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b_engine6cyl">
            <subsetting>vehicleAlternatives</subsetting>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
              <redefinitions>engine</redefinitions>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="cylinders">
                <redefinitions>cylinders</redefinitions>
                <Multiplicity>6</Multiplicity>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
                <redefinitions>mass</redefinitions>
                <valuePart>220 [kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="peakHorsePower">
                <redefinitions>peakHorsePower</redefinitions>
                <valuePart>220 [W]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelEfficiency">
                <redefinitions>fuelEfficiency</redefinitions>
                <valuePart>.5</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cost">
                <redefinitions>cost</redefinitions>
                <valuePart>1500</valuePart>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
            <typings>MaximizeObjective</typings>
          </elements>
          <elements xsi:type="sysMLOC:Comment" body="/*Select vehicle alternative with the engine whose evaluation function returns the max value*/"/>
          <elements xsi:type="sysMLOC:CalculationUsage">
            <subsetting>evaluationFunction</subsetting>
            <elements xsi:type="sysMLOC:PartUsage" direction="in" declaredName="vehicle">
              <subsetting>vehicle_b_engine4cyl</subsetting>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="eval">
              <typings>Real</typings>
              <valuePart>EngineEvaluation_4cyl (vehicle.engine.mass, vehicle.engine.peakHorsePower, vehicle.engine.fuelEfficiency, vehicle.engine.cost)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CalculationUsage">
            <subsetting>evaluationFunction</subsetting>
            <elements xsi:type="sysMLOC:PartUsage" direction="in" declaredName="vehicle">
              <subsetting>vehicle_b_engine6cyl</subsetting>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="eval">
              <typings>Real</typings>
              <valuePart>EngineEvaluation_6cyl (vehicle.engine.mass, vehicle.engine.peakHorsePower, vehicle.engine.fuelEfficiency, vehicle.engine.cost)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" isReturn="true" declaredName="selectedVehicle">
            <subsetting>vehicle_b</subsetting>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleVerification">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleConfigurations::VehicleConfiguration_b" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VerificationCaseDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VerificationCases1" isNamespace="true"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// the following is a model library which contains VerdictKind&#xA;"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VerificationCases" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VerificationSystem" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="VerificationCaseDefinitions">
        <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="MassTest"/>
        <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="AccelerationTest"/>
        <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="ReliabilityTest"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VerificationCases1">
        <elements xsi:type="sysMLOC:VerificationCaseUsage" declaredName="massTests">
          <typings>MassTest</typings>
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle_uut">
            <subsetting>vehicle_b</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="vehicleVerificationSubSystem_1">
            <valuePart>verificationContext.massVerificationSystem</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
            <elements xsi:type="sysMLOC:RequirementVerificationUsage" refElement="vehicleSpecification.vehicleMassRequirement">
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>massActual</redefinitions>
                <valuePart>weighVehicle.massMeasured</valuePart>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// method kinds are test, demo, analyze, should also include inspection, similarity&#xA;"/>
          <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="VerificationMethod">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="kind">
              <valuePart>(VerificationMethodKind::test, VerificationMethodKind::analyze)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="weighVehicle">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="massMeasured">
              <subsetting>ISQ::mass</subsetting>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="evaluatePassFail">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="massMeasured">
              <subsetting>ISQ::mass</subsetting>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="verdict">
              <valuePart>PassIf(vehicleSpecification.vehicleMassRequirement(vehicle_uut))</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:FlowUsage">
            <FlowEnd>weighVehicle.massMeasured</FlowEnd>
            <FlowEnd>evaluatePassFail.massMeasured</FlowEnd>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
            <redefinitions>verdict</redefinitions>
            <valuePart>evaluatePassFail.verdict</valuePart>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VerificationSystem">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="verificationContext">
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="massTests"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_UnitUnderTest">
            <subsetting>vehicle_b</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="massVerificationSystem">
            <elements xsi:type="sysMLOC:PartUsage" declaredName="scale">
              <elements xsi:type="sysMLOC:PerformActionUsage" refElement="massTests.weighVehicle"/>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="operator">
              <elements xsi:type="sysMLOC:PerformActionUsage" refElement="massTests.evaluatePassFail"/>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleIndividuals">
      <elements xsi:type="sysMLOC:IndividualUsage" declaredName="a" isIndividual="true">
        <typings>VehicleRoadContext_1</typings>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_t2_a" portionKind="timeslice">
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_a" portionKind="snapshot">
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t0">
              <redefinitions>time</redefinitions>
              <valuePart>0 [s]</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_r" portionKind="snapshot">
              <typings>Road_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::incline</redefinitions>
                <valuePart>0</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::friction</redefinitions>
                <valuePart>.1</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_v" portionKind="snapshot">
              <typings>Vehicle_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::position</redefinitions>
                <valuePart>0 [m]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::velocity</redefinitions>
                <valuePart>0 [m]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::acceleration</redefinitions>
                <valuePart>1.96 [m/s**2]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:CodeAnnotation" body="// .2 g where 1 g = 9.8 meters/sec^2&#xA;"/>
              <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_fa" portionKind="snapshot">
                <typings>FrontAxleAssembly_1</typings>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_leftFront" portionKind="snapshot">
                  <typings>Wheel_1</typings>
                </elements>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t0_rightFront" portionKind="snapshot">
                  <typings>Wheel_2</typings>
                </elements>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_a" portionKind="snapshot">
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t1">
              <redefinitions>time</redefinitions>
              <valuePart>1 [s]</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_r" portionKind="snapshot">
              <typings>Road_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::incline</redefinitions>
                <valuePart>0</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::friction</redefinitions>
                <valuePart>.1</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_v" portionKind="snapshot">
              <typings>Vehicle_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::position</redefinitions>
                <valuePart>.98 [m]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::velocity</redefinitions>
                <valuePart>1.96 [m/s]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::acceleration</redefinitions>
                <valuePart>1.96 [m/s**2]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:CodeAnnotation" body="// .2 g where 1 g = 9.8 meters/sec^2&#xA;"/>
              <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_fa" portionKind="snapshot">
                <typings>FrontAxleAssembly_1</typings>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_leftFront" portionKind="snapshot">
                  <typings>Wheel_1</typings>
                </elements>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t1_rightFront" portionKind="snapshot">
                  <typings>Wheel_2</typings>
                </elements>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_a" portionKind="snapshot">
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t2">
              <redefinitions>time</redefinitions>
              <valuePart>2 [s]</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_r" portionKind="snapshot">
              <typings>Road_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::incline</redefinitions>
                <valuePart>0</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Road::friction</redefinitions>
                <valuePart>.1</valuePart>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_v" portionKind="snapshot">
              <typings>Vehicle_1</typings>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::position</redefinitions>
                <valuePart>3.92 [m]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::velocity</redefinitions>
                <valuePart>3.92 [m/s]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage">
                <redefinitions>Vehicle::acceleration</redefinitions>
                <valuePart>1.96 [m/s**2]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:CodeAnnotation" body="// .2 g where 1 g = 9.8 meters/sec^2&#xA;"/>
              <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_fa" portionKind="snapshot">
                <typings>FrontAxleAssembly_1</typings>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_leftFront" portionKind="snapshot">
                  <typings>Wheel_1</typings>
                </elements>
                <elements xsi:type="sysMLOC:PortionUsage" declaredName="t2_rightFront" portionKind="snapshot">
                  <typings>Wheel_2</typings>
                </elements>
              </elements>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="MissionContext">
      <elements xsi:type="sysMLOC:Comment" body="/* Define mission context with mission use cases for vehicle_b */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleConfigurations::VehicleConfiguration_b" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ParametersOfInterestMetadata::moe"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="TransportPassengerScenario" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="ContextDefinitions">
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="MissionContext">
          <superclassifiers>GenericContext::Context</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Road"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Driver">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="handPort">
            <typings>HandPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="driverStates">
            <elements xsi:type="sysMLOC:StateUsage" declaredName="initial"/>
            <elements xsi:type="sysMLOC:StateUsage" declaredName="wait"/>
            <elements xsi:type="sysMLOC:TransitionUsage" transitionSourceElement="initial">
              <transitionSuccessionElement refElement="wait"/>
            </elements>
            <elements xsi:type="sysMLOC:CodeAnnotation" body="//ignition on&#xA;"/>
            <elements xsi:type="sysMLOC:TransitionUsage" declaredName="'wait-wait-1'" transitionSourceElement="wait">
              <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new IgnitionCmd (ignitionOnOff=IgnitionOnOff::on)" viaNodeParameter="handPort"/>
              <transitionSuccessionElement refElement="wait"/>
            </elements>
            <elements xsi:type="sysMLOC:CodeAnnotation" body="// ignition off&#xA;"/>
            <elements xsi:type="sysMLOC:TransitionUsage" declaredName="'wait-wait-2'" transitionSourceElement="wait">
              <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new IgnitionCmd (ignitionOnOff=IgnitionOnOff::off)" viaNodeParameter="handPort"/>
              <transitionSuccessionElement refElement="wait"/>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Passenger"/>
        <elements xsi:type="sysMLOC:RequirementUsage" declaredName="transportRequirements"/>
        <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="TransportPassenger">
          <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="TransportObjective">
            <elements xsi:type="sysMLOC:Documentation" body="/*deliver passenger to destination safely, comfortably, and within acceptable time*/"/>
            <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="transportRequirements" kind="require"/>
          </elements>
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
            <typings>Vehicle</typings>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="environment"/>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="road"/>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver"/>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="passenger">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>4</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:IncludeUseCaseUsage" declaredName="getInVehicle_a">
            <subsetting>getInVehicle</subsetting>
            <Multiplicity>1</Multiplicity>
            <Multiplicity>5</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:IncludeUseCaseUsage" declaredName="getOutOfVehicle_a">
            <subsetting>getOutOfVehicle</subsetting>
            <Multiplicity>1</Multiplicity>
            <Multiplicity>5</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="getInVehicle">
          <typings>GetInVehicle</typings>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="unlockDoor_in">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="openDoor_in"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="enterVehicle"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="closeDoor_in"/>
        </elements>
        <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="GetInVehicle">
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
            <typings>Vehicle</typings>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="passenger">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="driver != null xor passenger != null"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="getOutOfVehicle">
          <typings>GetOutOfVehicle</typings>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="openDoor_out"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="exitVehicle"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="closeDoor_out"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="lockDoor_out"/>
        </elements>
        <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="GetOutOfVehicle">
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
            <typings>Vehicle</typings>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActorUsage" declaredName="passenger">
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="driver != null xor passenger != null"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="TransportPassengerScenario">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ContextDefinitions::TransportPassenger"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// this version uses nesting vs fork and join for concurrent actions&#xA;"/>
        <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="transportPassenger">
          <typings>TransportPassenger</typings>
          <elements xsi:type="sysMLOC:InitialNode" memberElement="start"/>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="a">
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="driverGetInVehicle">
              <subsetting>getInVehicle_a</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="passenger1GetInVehicle">
              <subsetting>getInVehicle_a</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:AcceptNode" isThen="true" declaredName="trigger">
            <acceptParameter declaredName="ignitionCmd">
              <typings>IgnitionCmd</typings>
            </acceptParameter>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="b">
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="driveVehicleToDestination"/>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="providePower"/>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="c">
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="driverGetOutOfVehicle">
              <subsetting>getOutOfVehicle_a</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="passenger1GetOutOfVehicle">
              <subsetting>getOutOfVehicle_a</subsetting>
              <Multiplicity>1</Multiplicity>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="done"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//this version uses forks and joins&#xA;"/>
        <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="transportPassenger_1">
          <typings>TransportPassenger</typings>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// declare actions&#xA;"/>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="driverGetInVehicle">
            <subsetting>getInVehicle_a</subsetting>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="passenger1GetInVehicle">
            <subsetting>getInVehicle_a</subsetting>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="driverGetOutOfVehicle">
            <subsetting>getOutOfVehicle_a</subsetting>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="passenger1GetOutOfVehicle">
            <subsetting>getOutOfVehicle_a</subsetting>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="driveVehicleToDestination"/>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="providePower"/>
          <elements xsi:type="sysMLOC:ItemDefinition" declaredName="VehicleOnSignal"/>
          <elements xsi:type="sysMLOC:CommonNode" declaredName="join1" nodeKind="join"/>
          <elements xsi:type="sysMLOC:CommonNode" declaredName="join2" nodeKind="join"/>
          <elements xsi:type="sysMLOC:CommonNode" declaredName="join3" nodeKind="join"/>
          <elements xsi:type="sysMLOC:AcceptNode" declaredName="trigger">
            <acceptParameter declaredName="ignitionCmd">
              <typings>IgnitionCmd</typings>
            </acceptParameter>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// define control flow&#xA;"/>
          <elements xsi:type="sysMLOC:InitialNode" memberElement="start"/>
          <elements xsi:type="sysMLOC:CommonNode" isThen="true" declaredName="fork1" nodeKind="fork"/>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="driverGetInVehicle"/>
          </elements>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="passenger1GetInVehicle"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="driverGetInVehicle"/>
            <connectorPart refElement="join1"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="passenger1GetInVehicle"/>
            <connectorPart refElement="join1"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="join1"/>
            <connectorPart refElement="trigger"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="trigger"/>
            <connectorPart refElement="fork2"/>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="//succession trigger if trigger.ignitionCmd.ignitionOnOff==IgnitionOnOff::on then fork2;&#xA;"/>
          <elements xsi:type="sysMLOC:CommonNode" declaredName="fork2" nodeKind="fork"/>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="driveVehicleToDestination"/>
          </elements>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="providePower"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="driveVehicleToDestination"/>
            <connectorPart refElement="join2"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="providePower"/>
            <connectorPart refElement="join2"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="join2"/>
            <connectorPart refElement="fork3"/>
          </elements>
          <elements xsi:type="sysMLOC:CommonNode" declaredName="fork3" nodeKind="fork"/>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="driverGetOutOfVehicle"/>
          </elements>
          <elements xsi:type="sysMLOC:ThenNode">
            <thenElement refElement="passenger1GetOutOfVehicle"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="driverGetOutOfVehicle"/>
            <connectorPart refElement="join3"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="passenger1GetOutOfVehicle"/>
            <connectorPart refElement="join3"/>
          </elements>
          <elements xsi:type="sysMLOC:SuccessionAsUsage">
            <connectorPart refElement="join3"/>
            <connectorPart refElement="done"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="missionContext">
        <typings>ContextDefinitions::MissionContext</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="transportTime">
          <prefixMetadataExtension>#moe</prefixMetadataExtension>
          <subsetting>ISQ::time</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// bind parts to actors of use case&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="road">
          <typings>ContextDefinitions::Road</typings>
          <valuePart>transportPassenger.road</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="driver">
          <typings>ContextDefinitions::Driver</typings>
          <valuePart>transportPassenger.driver</valuePart>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.driverGetInVehicle.unlockDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.driverGetInVehicle.openDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.driverGetInVehicle.enterVehicle"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.driverGetInVehicle.closeDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.driverGetOutOfVehicle.openDoor_out"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.driverGetOutOfVehicle.exitVehicle"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.driverGetOutOfVehicle.closeDoor_out"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.driverGetOutOfVehicle.lockDoor_out"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.b.driveVehicleToDestination"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="passenger1">
          <typings>ContextDefinitions::Passenger</typings>
          <valuePart>transportPassenger.passenger</valuePart>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.passenger1GetInVehicle.unlockDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.passenger1GetInVehicle.openDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.passenger1GetInVehicle.enterVehicle"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.a.passenger1GetInVehicle.closeDoor_in"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.passenger1GetOutOfVehicle.openDoor_out"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.passenger1GetOutOfVehicle.exitVehicle"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.passenger1GetOutOfVehicle.closeDoor_out"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.c.passenger1GetOutOfVehicle.lockDoor_out"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b_1">
          <subsetting>vehicle_b</subsetting>
          <valuePart>transportPassenger.vehicle</valuePart>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>position3dVector</redefinitions>
            <valuePart>(0,0,0) [spatialCF]</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.b.providePower">
            <redefinitions>providePower</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="transportPassenger.trigger"/>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <connectorPart refElement="driver.handPort"/>
          <connectorPart refElement="vehicle_b_1.ignitionCmdPort"/>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <connectorPart refElement="road"/>
          <connectorPart refElement="vehicle_b_1.vehicleToRoadPort"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleSuperSetModel">
      <elements xsi:type="sysMLOC:Comment" body="/* all of vehicleFamily is included in the superset model to enable subsetting a specific vehicle configuration*/"/>
      <elements xsi:type="sysMLOC:Package" declaredName="VariationPointDefinitions">
        <elements xsi:type="sysMLOC:PartDefinition" isVariation="true" declaredName="TransmissionChoices">
          <superclassifiers>Transmission</superclassifiers>
          <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="transmissionAutomatic">
            <typings>TransmissionAutomatic</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="transmissionManual">
            <typings>TransmissionManual</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VehiclePartsTree">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VariationPointDefinitions" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="vehicleFamily">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// variation with nested variation&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="engine">
            <typings>Engine</typings>
            <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="engine4Cyl">
              <typings>Engine4Cyl</typings>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="engine6Cyl">
              <typings>Engine6Cyl</typings>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="cylinder">
                <typings>Cylinder</typings>
                <Multiplicity>6</Multiplicity>
                <elements xsi:type="sysMLOC:AttributeUsage" isVariation="true" declaredName="diameter">
                  <typings>LengthValue</typings>
                  <elements xsi:type="sysMLOC:AttributeUsage" isVariant="true" declaredName="smallDiameter">
                    <typings>LengthValue</typings>
                  </elements>
                  <elements xsi:type="sysMLOC:AttributeUsage" isVariant="true" declaredName="largeDiagmeter">
                    <typings>LengthValue</typings>
                  </elements>
                </elements>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// variation point based on variation of part definition&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="transmissionChoices">
            <typings>TransmissionChoices</typings>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// optional variation point&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="sunroof">
            <typings>Sunroof</typings>
            <Multiplicity>0</Multiplicity>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// selection constraint&#xA;"/>
          <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="selectionConstraint">
            <resultExpressionParameter resultExpression="(engine==engine::engine4Cyl and transmissionChoices==TransmissionChoices::transmissionManual) xor (engine==engine::engine6Cyl and transmissionChoices==TransmissionChoices::transmissionAutomatic)"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="driveshaft"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="SafetyandSecurityGroups">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleConfigurations::VehicleConfiguration_b::PartsTree" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="SafetyGroup">
        <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety. */"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle_b" isRecursive="true"/>
        <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="SecurityGroup">
        <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to security. */"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle_b" isRecursive="true"/>
        <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Security"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="SafetyandSecurityGroup">
        <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety OR security. */"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle_b" isRecursive="true"/>
        <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety or @Security"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="MandatorySafetyGroup">
        <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety AND are mandatory. */"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle_b" isRecursive="true"/>
        <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety and Safety::isMandatory"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Views_Viewpoints">
      <elements xsi:type="sysMLOC:Package" declaredName="ViewpointDefinitions">
        <elements xsi:type="sysMLOC:ViewpointDefinition" declaredName="BehaviorViewpoint"/>
        <elements xsi:type="sysMLOC:ViewpointDefinition" declaredName="SafetyViewpoint">
          <elements xsi:type="sysMLOC:FramedConcernUsage" declaredName="vs">
            <typings>VehicleSafety</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="SafetyEngineer"/>
        <elements xsi:type="sysMLOC:ConcernDefinition" declaredName="VehicleSafety">
          <elements xsi:type="sysMLOC:Documentation" body="/* identify system safety features */"/>
          <elements xsi:type="sysMLOC:StakeholderUsage" declaredName="se">
            <typings>SafetyEngineer</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ViewDefinitions">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//public import Views to access rendering method library &#xA;"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Views" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="TreeView">
          <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTreeDiagram"/>
        </elements>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="NestedView"/>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="RelationshipView"/>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="TableView"/>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="PartsTreeView">
          <superclassifiers>TreeView</superclassifiers>
          <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@SysML::PartUsage"/>
        </elements>
        <elements xsi:type="sysMLOC:ViewDefinition" declaredName="PartsInterconnection">
          <superclassifiers>NestedView</superclassifiers>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VehicleViews">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ViewpointDefinitions" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ViewDefinitions" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleConfigurations::VehicleConfiguration_b" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ViewUsage" declaredName="vehiclePartsTree_Safety">
          <typings>PartsTreeView</typings>
          <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="sv">
            <typings>SafetyViewpoint</typings>
          </elements>
          <elements xsi:type="sysMLOC:ExposeElement" declaredName="PartsTree" isRecursive="true"/>
          <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
