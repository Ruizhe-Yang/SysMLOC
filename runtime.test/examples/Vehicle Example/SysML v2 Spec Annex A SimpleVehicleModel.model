        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// alternative 2 - w multiple nesxted interfaces&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="wheelHubAssy2">
