<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="SimpleVehicleModel">
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// 2023-02 release&#xA;"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Definitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="PartDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="PortDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ItemDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SignalDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="InterfaceDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="AllocationDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ActionDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="StateDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="RequirementDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="AttributeDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="IndividualDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="MetadataDefinitions" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="KeyWord_MetadataDefinitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Package" declaredName="PartDefinitions">
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dryMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cargoMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="position">
            <subsetting>ISQ::length</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
            <subsetting>ISQ::speed</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="acceleration">
            <subsetting>ISQ::acceleration</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="electricalPower">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="Tmax">
            <subsetting>ISQ::temperature</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="maintenanceTime">
            <typings>Time::DateTime</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="brakePedalDepressed">
            <typings>Boolean</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="ignitionCmdPort">
            <typings>IgnitionCmdPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="pwrCmdPort">
            <typings>PwrCmdPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="vehicleToRoadPort">
            <typings>VehicleToRoadPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="statusPort">
            <typings>StatusPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="providePower"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="provideBraking"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="controlDirection"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="performSelfTest"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="applyParkingBrake"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="senseTemperature"/>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="vehicleStates" isParallel="true">
            <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="controller">
              <typings>VehicleController</typings>
            </elements>
            <elements xsi:type="sysMLOC:StateUsage" declaredName="operatingStates">
              <elements xsi:type="sysMLOC:EntryActionNode">
                <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="initial"/>
              </elements>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="off"/>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="starting"/>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="on">
                <elements xsi:type="sysMLOC:EntryActionNode">
                  <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="performSelfTest"/>
                </elements>
                <elements xsi:type="sysMLOC:DoActionNode">
                  <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="providePower"/>
                </elements>
                <elements xsi:type="sysMLOC:ExitActionNode">
                  <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="applyParkingBrake"/>
                </elements>
                <elements xsi:type="sysMLOC:ConstraintUsage">
                  <resultExpressionParameter resultExpression="electricalPower&lt;=500[W]"/>
                </elements>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" transitionSourceElement="initial">
                <transitionSuccessionElement refElement="off"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="off_To_starting" transitionSourceElement="off" conditionalExpression="ignitionCmd.ignitionOnOff==IgnitionOnOff::on and brakePedalDepressed">
                <acceptParameter declaredName="ignitionCmd" viaNodeParameter="ignitionCmdPort">
                  <typings>IgnitionCmd</typings>
                </acceptParameter>
                <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new StartSignal()" toNodeParameter="controller"/>
                <transitionSuccessionElement refElement="starting"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="starting_To_on" transitionSourceElement="starting">
                <acceptParameter payloadFeatureElement="VehicleOnSignal"/>
                <transitionSuccessionElement refElement="on"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="on_To_off" transitionSourceElement="on">
                <acceptParameter payloadFeatureElement="VehicleOffSignal"/>
                <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new OffSignal()" toNodeParameter="controller"/>
                <transitionSuccessionElement refElement="off"/>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:StateUsage" declaredName="healthStates">
              <elements xsi:type="sysMLOC:EntryActionNode">
                <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="initial"/>
              </elements>
              <elements xsi:type="sysMLOC:DoActionNode">
                <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="senseTemperature"/>
                <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="temp"/>
              </elements>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="normal"/>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="maintenance"/>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="degraded"/>
              <elements xsi:type="sysMLOC:TransitionUsage" transitionSourceElement="initial">
                <transitionSuccessionElement refElement="normal"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="normal_To_maintenance" transitionSourceElement="normal">
                <acceptParameter triggerkind="at" triggerExpression="maintenanceTime"/>
                <transitionSuccessionElement refElement="maintenance"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="normal_To_degraded" transitionSourceElement="normal">
                <acceptParameter triggerkind="when" triggerExpression="senseTemperature.temp > Tmax"/>
                <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new OverTemp()" toNodeParameter="controller"/>
                <transitionSuccessionElement refElement="degraded"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="maintenance_To_normal" transitionSourceElement="maintenance">
                <acceptParameter payloadFeatureElement="ReturnToNormal"/>
                <transitionSuccessionElement refElement="normal"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="degraded_To_normal" transitionSourceElement="degraded">
                <acceptParameter payloadFeatureElement="ReturnToNormal"/>
                <transitionSuccessionElement refElement="normal"/>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="peakHorsePower">
            <subsetting>ISQ::power</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelEfficiency">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cost">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="displacement">
            <subsetting>ISQ::volume</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="engineControlPort">
            <typings>~ControlPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelInPort">
            <typings>~ FuelPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelCmdPort">
            <typings>FuelCmdPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="drivePwrPort">
            <typings>DrivePwrPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="ignitionCmdPort">
            <typings>IgnitionCmdPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="flyWheelPort"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="generateTorque"/>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="engineStates">
            <elements xsi:type="sysMLOC:StateUsage" declaredName="off"/>
            <elements xsi:type="sysMLOC:StateUsage" declaredName="starting"/>
            <elements xsi:type="sysMLOC:StateUsage" declaredName="on">
              <elements xsi:type="sysMLOC:DoActionNode">
                <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="generateTorque"/>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="StarterMotor">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="gearPort">
            <typings>GearPort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cylinder"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="gearRatio">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="clutchPort">
            <typings>~DrivePwrPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="transmissionStates"/>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Driveshaft"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="FrontAxle">
          <superclassifiers>Axle</superclassifiers>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="steeringAngle">
            <subsetting>ISQ::angularMeasure</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="HalfAxle">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="shankCompositePort">
            <typings>ShankCompositePort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Differential"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="diameter">
            <typings>LengthValue</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="lugNutCompositePort">
            <typings>LugNutCompositePort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Hub">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="shankCompositePort">
            <typings>ShankCompositePort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" isAbstract="true" declaredName="Software"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleSoftware">
          <superclassifiers>Software</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleController">
          <superclassifiers>Software</superclassifiers>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="controlPort">
            <typings>ControlPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="controllerStates" isParallel="true">
            <elements xsi:type="sysMLOC:StateUsage" declaredName="operatingStates">
              <elements xsi:type="sysMLOC:EntryActionNode">
                <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="initial"/>
              </elements>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="off"/>
              <elements xsi:type="sysMLOC:StateUsage" declaredName="on"/>
              <elements xsi:type="sysMLOC:TransitionUsage" transitionSourceElement="initial">
                <transitionSuccessionElement refElement="off"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="'off-on'" transitionSourceElement="off">
                <acceptParameter payloadFeatureElement="StartSignal"/>
                <transitionSuccessionElement refElement="on"/>
              </elements>
              <elements xsi:type="sysMLOC:TransitionUsage" declaredName="'on-off'" transitionSourceElement="on">
                <acceptParameter payloadFeatureElement="OffSignal"/>
                <transitionSuccessionElement refElement="off"/>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="CruiseController">
          <superclassifiers>Software</superclassifiers>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="setSpeedPort">
            <typings>~SetSpeedPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="speedSensorPort">
            <typings>~SpeedSensorPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="cruiseControlPort">
            <typings>CruiseControlPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="cruiseControllerStates"/>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="SpeedSensor">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="speedSensorPort">
            <typings>SpeedSensorPort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="FuelTank">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="fuel">
            <typings>Fuel</typings>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>fuelMass</redefinitions>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelKind">
            <typings>FuelKind</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelMassMax">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="fuelConstraint">
            <resultExpressionParameter resultExpression="fuel.fuelMass&lt;=fuelMassMax"/>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelOutPort">
            <typings>FuelPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelInPort">
            <typings>~FuelPort</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="BodyAssy"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Body">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="color">
            <typings>Colors</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Thermostat"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="WaterHose"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Road">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="incline">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="friction">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine4Cyl"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine6Cyl"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="TransmissionChoices"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="TransmissionAutomatic"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="TransmissionManual"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Sunroof"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//logical Components&#xA;"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="ElectricalGenerator"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="TorqueGenerator"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="SteeringSubsystem"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="BrakingSubsystem"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="PortDefinitions">
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="IgnitionCmdPort">
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="ignitionCmd">
            <typings>IgnitionCmd</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="StatusPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="GearPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="PwrCmdPort">
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="pwrCmd">
            <typings>PwrCmd</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="FuelCmdPort">
          <superclassifiers>PwrCmdPort</superclassifiers>
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelCmd">
            <typings>FuelCmd</typings>
            <redefinitions>pwrCmd</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="FuelPort">
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="fuel">
            <typings>Fuel</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="DrivePwrPort">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="torque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_a"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_b"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_c"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_d"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="DiffPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="AxlePort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="AxleToWheelPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="WheelToAxlePort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="WheelToRoadPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="LugNutCompositePort">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="lugNutPort">
            <typings>LugNutPort</typings>
            <Multiplicity>*</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShankCompositePort">
          <elements xsi:type="sysMLOC:PortUsage" declaredName="shankPort">
            <typings>ShankPort</typings>
            <Multiplicity>*</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="LugNutPort">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="threadDia"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="threadPitch"/>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShankPort">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="threadDia"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="threadPitch"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="shaftLength"/>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="VehicleToRoadPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="ControlPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="CruiseControlPort">
          <superclassifiers>ControlPort</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="SpeedSensorPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="SetSpeedPort"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="DriverCmdPort">
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="driverCmd">
            <typings>DriverCmd</typings>
            <Multiplicity>*</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="HandPort">
          <superclassifiers>DriverCmdPort</superclassifiers>
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="ignitionCmd">
            <typings>IgnitionCmd</typings>
            <subsetting>driverCmd</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="pwrCmd">
            <typings>PwrCmd</typings>
            <subsetting>driverCmd</subsetting>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ItemDefinitions">
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="PwrCmd">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="throttleLevel">
            <typings>Real</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="FuelCmd">
          <superclassifiers>PwrCmd</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Fuel">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelMass">
            <subsetting>ISQ::mass</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SensedSpeed">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="speed">
            <subsetting>ISQ::speed</subsetting>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="SignalDefinitions">
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Cmd"/>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="DriverCmd"/>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="IgnitionCmd">
          <superclassifiers>DriverCmd</superclassifiers>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="ignitionOnOff">
            <typings>IgnitionOnOff</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ItemDefinition" declaredName="EngineStatus"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleStartSignal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleOnSignal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleOffSignal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="StartSignal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="OffSignal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="OverTemp"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ReturnToNormal"/>
        <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SetSpeed">
          <superclassifiers>Real</superclassifiers>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="InterfaceDefinitions">
        <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="EngineToTransmissionInterface">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="p1" isEnd="true">
            <typings>DrivePwrPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="p2" isEnd="true">
            <typings>~DrivePwrPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:FlowUsage">
            <FlowEnd>p1.torque</FlowEnd>
            <FlowEnd>p2.torque</FlowEnd>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="FuelInterface">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="fuelOutPort" isEnd="true">
            <typings>FuelPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="fuelInPort" isEnd="true">
            <typings>~FuelPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:FlowUsage">
            <itemFeatureParameter payloadFeatureElement="Fuel"/>
            <FlowEnd>fuelOutPort.fuel</FlowEnd>
            <FlowEnd>fuelInPort.fuel</FlowEnd>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="WheelFastenerInterface">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="lugNutPort" isEnd="true">
            <typings>LugNutPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="shankPort" isEnd="true">
            <typings>ShankPort</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="maxTorque">
            <typings>Torque</typings>
          </elements>
          <elements xsi:type="sysMLOC:ConstraintUsage">
            <resultExpressionParameter resultExpression="lugNutPort.threadDia == shankPort.threadDia"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="WheelHubInterface">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="lugNutCompositePort" isEnd="true">
            <typings>LugNutCompositePort</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="shankCompositePort" isEnd="true">
            <typings>ShankCompositePort</typings>
          </elements>
          <elements xsi:type="sysMLOC:InterfaceUsage" declaredName="wheelFastenerInterface">
            <typings>WheelFastenerInterface</typings>
            <Multiplicity>5</Multiplicity>
            <connectorPart refElement="lugNutCompositePort.lugNutPort"/>
            <connectorPart refElement="shankCompositePort.shankPort"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="AllocationDefinitions">
        <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="LogicalToPhysical">
          <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true" declaredName="logicalEnd">
            <prefixMetadataExtension>#logical</prefixMetadataExtension>
          </elements>
          <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true" declaredName="physicalEnd">
            <prefixMetadataExtension>#physical</prefixMetadataExtension>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="ActionDefinitions">
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ProvidePower">
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="pwrCmd">
            <typings>PwrCmd</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelToRoadTorque">
            <typings>Torque</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="GenerateTorque">
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelCmd">
            <typings>FuelCmd</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="engineTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AmplifyTorque">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineTorque">
            <typings>Torque</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="transmissionTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="TransferTorque">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transmissionTorque">
            <typings>Torque</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="driveshaftTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="DistributeTorque">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="driveshaftTorque">
            <typings>Torque</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelToRoadTorque">
            <typings>Torque</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="PerformSelfTest"/>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ApplyParkingBrake"/>
        <elements xsi:type="sysMLOC:ActionDefinition" declaredName="SenseTemperature">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="temp">
            <typings>ISQ::TemperatureValue</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="StateDefinitions">
        <elements xsi:type="sysMLOC:StateDefinition" declaredName="VehicleStates"/>
        <elements xsi:type="sysMLOC:StateDefinition" declaredName="ControllerStates"/>
        <elements xsi:type="sysMLOC:StateDefinition" declaredName="CruiseControllerStates"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="RequirementDefinitions">
        <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MassRequirement">
          <elements xsi:type="sysMLOC:Documentation" body="/*The actual mass shall be less than the required mass*/"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massRequired">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massActual">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
            <resultExpressionParameter resultExpression="massActual&lt;=massRequired"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="ReliabilityRequirement">
          <elements xsi:type="sysMLOC:Documentation" body="/*The actual reliability shall be greater than the required reliability*/"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="reliabilityRequired">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="reliabilityActual">
            <typings>Real</typings>
          </elements>
          <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
            <resultExpressionParameter resultExpression="reliabilityActual>=reliabilityRequired"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="TorqueGenerationRequirement">
          <elements xsi:type="sysMLOC:Documentation" body="/* The engine shall generate torque as a function of RPM as shown in Table 1. */"/>
          <elements xsi:type="sysMLOC:SubjectUsage" declaredName="generateTorque">
            <typings>ActionDefinitions::GenerateTorque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="DrivePowerOutputRequirement">
          <elements xsi:type="sysMLOC:Documentation" body="/* The engine shall provide a connection point to transfer torque to the transmission.*/"/>
        </elements>
        <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="FuelEconomyRequirement">
          <elements xsi:type="sysMLOC:Documentation" body="/* The vehicle shall maintain an average fuel economomy of at least x miles per gallon for the nominal &#xA;                driving scenario */"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="actualFuelEconomy">
            <subsetting>distancePerVolume</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="requiredFuelEconomy">
            <subsetting>distancePerVolume</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
            <resultExpressionParameter resultExpression="actualFuelEconomy >= requiredFuelEconomy"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="AttributeDefinitions">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Quantities" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="MeasurementReferences::DerivedUnit"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SIPrefixes::kilo"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Numerical Functions provides basic operators such as Sum expression&#xA;"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="NumericalFunctions" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SI" isNamespace="true"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="USCustomaryUnits" isNamespace="true"/>
        <elements xsi:type="sysMLOC:AliasElement" memberName="Torque" memberElement="ISQ::TorqueValue"/>
        <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="Colors">
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="black"/>
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="grey"/>
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="red"/>
        </elements>
        <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="DiameterChoices">
          <superclassifiers>ISQ::LengthValue</superclassifiers>
          <elements xsi:type="sysMLOC:EnumeratedValue">
            <valuePart>60 [mm]</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:EnumeratedValue">
            <valuePart>80 [mm]</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:EnumeratedValue">
            <valuePart>100 [mm]</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cylinderDiameter">
          <typings>DiameterChoices</typings>
          <valuePart>80 [mm]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="IgnitionOnOff">
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="on"/>
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="off"/>
        </elements>
        <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="FuelKind">
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="gas"/>
          <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="diesel"/>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="distancePerVolume">
          <subsetting>scalarQuantities</subsetting>
          <valuePart>distance / volume</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="timePerDistance">
          <subsetting>scalarQuantities</subsetting>
          <valuePart>time / distance</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="volumePerDistance">
          <subsetting>scalarQuantities</subsetting>
          <valuePart>volume / distance</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="volumePerTime">
          <subsetting>scalarQuantities</subsetting>
          <valuePart>volume / time</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// kpl is approx .425 * mpg&#xA;"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="kpl">
          <typings>DerivedUnit</typings>
          <valuePart>km / L</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="rpm">
          <typings>DerivedUnit</typings>
          <valuePart>1 / SI::min</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="kW">
          <typings>DerivedUnit</typings>
          <valuePart>kilo * W</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="IndividualDefinitions">
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="VehicleRoadContext_1" isIndividual="true">
          <superclassifiers>GenericContext::Context</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="Vehicle_1" isIndividual="true">
          <superclassifiers>Vehicle</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="FrontAxleAssembly_1" isIndividual="true">
          <superclassifiers>AxleAssembly</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="FrontAxle_1" isIndividual="true">
          <superclassifiers>FrontAxle</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="Wheel_1" isIndividual="true">
          <superclassifiers>Wheel</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="Wheel_2" isIndividual="true">
          <superclassifiers>Wheel</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="RearAxleAssembly_1" isIndividual="true">
          <superclassifiers>AxleAssembly</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="Road_1" isIndividual="true">
          <superclassifiers>Road</superclassifiers>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="MetadataDefinitions">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="AnalysisTooling" isNamespace="true"/>
        <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Safety">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isMandatory">
            <typings>Boolean</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Security"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="KeyWord_MetadataDefinitions">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Metaobjects::SemanticMetadata"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// the following is used to define the key word failureMode&#xA;"/>
        <elements xsi:type="sysMLOC:StateUsage" declaredName="failureModes" isNonunique="true">
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// with alias &lt;fm>&#xA;"/>
        <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="fm" declaredName="failureMode">
          <superclassifiers>SemanticMetadata</superclassifiers>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>baseType</redefinitions>
            <valuePart>failureModes meta SysML::StateUsage</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="logicalOccurrences" isNonunique="true">
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="l" declaredName="logical">
          <superclassifiers>SemanticMetadata</superclassifiers>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>baseType</redefinitions>
            <valuePart>logicalOccurrences meta SysML::Usage</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="physicalOccurrences" isNonunique="true">
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="p" declaredName="physical">
          <superclassifiers>SemanticMetadata</superclassifiers>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>baseType</redefinitions>
            <valuePart>physicalOccurrences meta SysML::Usage</valuePart>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="GenericContext">
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Context">
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="time">
            <typings>TimeValue</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="spatialCF">
            <typings>CartesianSpatial3dCoordinateFrame</typings>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>mRefs</redefinitions>
              <valuePart>(m, m, m)</valuePart>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocityCF">
            <typings>CartesianVelocity3dCoordinateFrame</typings>
            <Multiplicity>1</Multiplicity>
            <valuePart>spatialCF/s</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="accelarationCF">
            <typings>CartesianAcceleration3dCoordinateFrame</typings>
            <Multiplicity>1</Multiplicity>
            <valuePart>velocityCF/s</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleLogicalConfiguration">
      <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleLogical">
          <prefixMetadataExtension>#logical</prefixMetadataExtension>
          <typings>Vehicle</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="torqueGenerator">
            <typings>TorqueGenerator</typings>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateTorque"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="electricalGenerator">
            <typings>ElectricalGenerator</typings>
            <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateElectricity"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="steeringSystem">
            <typings>SteeringSubsystem</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="brakingSubsystem">
            <typings>BrakingSubsystem</typings>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleLogicalToPhysicalAllocation">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleConfigurations::VehicleConfiguration_b::PartsTree" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleLogicalConfiguration::PartsTree" isNamespace="true"/>
      <elements xsi:type="sysMLOC:AllocationUsage" declaredName="vehicleLogicalToPhysicalAllocation">
        <typings>LogicalToPhysical</typings>
        <connectorPart refElement="vehicleLogical"/>
        <connectorPart refElement="vehicle_b"/>
        <elements xsi:type="sysMLOC:AllocationUsage">
          <connectorPart refElement="vehicleLogical.torqueGenerator"/>
          <connectorPart refElement="vehicle_b.engine"/>
          <elements xsi:type="sysMLOC:AllocationUsage">
            <connectorPart refElement="vehicleLogical.torqueGenerator.generateTorque"/>
            <connectorPart refElement="vehicle_b.engine.generateTorque"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AllocationUsage">
          <connectorPart refElement="vehicleLogical.electricalGenerator"/>
          <connectorPart refElement="vehicle_b.engine"/>
          <elements xsi:type="sysMLOC:AllocationUsage">
            <connectorPart refElement="vehicleLogical.electricalGenerator.generateElectricity"/>
            <connectorPart refElement="vehicle_b.engine.alternator.generateElectricity"/>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleConfigurations">
      <elements xsi:type="sysMLOC:Package" declaredName="VehicleConfiguration_a">
        <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_a">
            <typings>Vehicle</typings>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
              <redefinitions>Vehicle::mass</redefinitions>
              <valuePart>dryMass+cargoMass+fuelTank.fuel.fuelMass</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dryMass">
              <redefinitions>Vehicle::dryMass</redefinitions>
              <valuePart>sum(partMasses)</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage">
              <redefinitions>Vehicle::cargoMass</redefinitions>
              <valuePart>0 [kg]</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="partMasses" isNonunique="true">
              <subsetting>ISQ::mass</subsetting>
              <Multiplicity>*</Multiplicity>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="fuelTank">
              <typings>FuelTank</typings>
              <elements xsi:type="sysMLOC:AttributeUsage">
                <redefinitions>mass</redefinitions>
                <valuePart>75[kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
                <redefinitions>fuel</redefinitions>
                <elements xsi:type="sysMLOC:AttributeUsage">
                  <redefinitions>fuelMass</redefinitions>
                  <valuePart>50[kg]</valuePart>
                </elements>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly">
              <typings>AxleAssembly</typings>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
                <subsetting>ISQ::mass</subsetting>
                <valuePart>800[kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle">
                <typings>Axle</typings>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheels">
                <typings>Wheel</typings>
                <Multiplicity>2</Multiplicity>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
              <typings>AxleAssembly</typings>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
                <subsetting>ISQ::mass</subsetting>
                <valuePart>875[kg]</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:AttributeUsage" declaredName="driveTrainEfficiency">
                <typings>Real</typings>
                <valuePart>0.6</valuePart>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
                <typings>Axle</typings>
              </elements>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheels">
                <typings>Wheel</typings>
                <Multiplicity>2</Multiplicity>
                <elements xsi:type="sysMLOC:AttributeUsage">
                  <redefinitions>diameter</redefinitions>
                </elements>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Package" declaredName="ActionTree"/>
        <elements xsi:type="sysMLOC:Package" declaredName="Requirements"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VehicleConfiguration_b">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//Shapes library for simple geometry&#xA;"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ShapeItems::Box"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ParametersOfInterestMetadata::mop"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ModelingMetadata" isNamespace="true"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// incudes status info&#xA;"/>
        <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle_b">
            <typings>Vehicle</typings>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
              <prefixMetadataExtension>#mop</prefixMetadataExtension>
              <redefinitions>mass</redefinitions>
              <valuePart>dryMass+cargoMass+fuelTank.fuel.fuelMass</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dryMass">
              <redefinitions>dryMass</redefinitions>
              <valuePart>sum(partMasses)</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true">
              <redefinitions>cargoMass</redefinitions>
              <valuePart>0 [kg]</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="partMasses">
              <valuePart>(fuelTank.mass,frontAxleAssembly.mass,rearAxleAssembly.mass,engine.mass,transmission.mass,driveshaft.mass)</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="avgFuelEconomy">
              <subsetting>distancePerVolume</subsetting>
            </elements>
