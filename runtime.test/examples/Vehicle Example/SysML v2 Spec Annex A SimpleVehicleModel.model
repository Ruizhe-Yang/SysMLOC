      <elements xsi:type="sysMLOC:Package" declaredName="WheelHubAssemblies">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// alternative 1 - w/o explicit nesxted interfaces&#xA;"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="wheelHubAssy1">
