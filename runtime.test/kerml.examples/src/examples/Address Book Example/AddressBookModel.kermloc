<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
  <elements xsi:type="kerMLOC:Package" declaredName="AddressBookModel">
    <elements xsi:type="kerMLOC:Class" declaredName="Entry">
      <elements xsi:type="kerMLOC:Feature" declaredName="name" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="address" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="AddressBook">
      <elements xsi:type="kerMLOC:Feature" declaredName="entries" MultiLow="*" isSemicolon="true">
        <typings>Entry</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
