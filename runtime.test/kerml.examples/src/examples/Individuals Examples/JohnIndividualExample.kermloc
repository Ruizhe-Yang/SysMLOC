<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="JohnIndividualExample">
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Person">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of persons, each of whom has an age.&#xA;&#x9;&#x9;  It is NOT restricted to maximal portions.&#xA;&#x9;&#x9;  (The specialization of Object would normally be left implicit.)&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Class" declaredName="Life">
        <subsetting>Person</subsetting>
        <subsetting>Occurrences::Life</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="age" isFeature="true" isSemicolon="true">
        <typings>ScalarValues::Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isFeature="true">
        <typings>Person</typings>
        <redefinitions>portions</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;    These redefinitions enforce the &quot;rigidity&quot; constraint for Person.&#xA;&#x9;&#x9;    They ensure that all portions of a person are also persons and &#xA;&#x9;&#x9;    that a person can only be a portion of another person. This implies&#xA;&#x9;&#x9;    that the class Person must also include all the portions of any one &#xA;&#x9;&#x9;    of its instances. The redefinitions for the portion features&#xA;&#x9;&#x9;    also implicitly constraint the typing of the time slice and snapshot&#xA;&#x9;&#x9;    features, since they are subsets of portioning.&#xA;&#x9;&#x9;    (It is currently awkward to have to declare these redefinitions&#xA;&#x9;&#x9;    explicitly.)&#xA;&#x9;&#x9;  */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>Person</typings>
        <redefinitions>portionOf</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="President">
      <subsetting>Person</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of presidents, each of which must be a time slice&#xA;&#x9;&#x9;  of the life of some individual person.&#xA;&#x9;&#x9;  (Note that this class is NOT &quot;rigid&quot;.)&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Person::Life</typings>
        <redefinitions>timeSliceOf</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="John">
      <subsetting>Person</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of the specific (individual) person who is John.&#xA;&#x9;&#x9;  There is at most one such person.&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Class" declaredName="JohnLife" MultiLow="0" MultiHigh="1" isSufficient="true">
        <subsetting>John</subsetting>
        <subsetting>Occurrences::Life</subsetting>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="JohnAsPresident">
      <subsetting>John</subsetting>
      <subsetting>President</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of time slices of John's life in which he is&#xA;&#x9;&#x9;  a president.&#xA;&#x9;&#x9;*/"/>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Country">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of countries, each of which may have at most one&#xA;&#x9;&#x9;  president.&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Class" declaredName="Life" isSufficient="true">
        <subsetting>Country</subsetting>
        <subsetting>Occurrences::Life</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="presidentOfCountry" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
        <typings>President</typings>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Rigidity constraint.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>Country</typings>
        <redefinitions>portions</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>Country</typings>
        <redefinitions>portionOf</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="UnitedStates">
      <subsetting>Country</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of the specific country that is the&#xA;&#x9;&#x9;  United States. It contains a single instance. The United States&#xA;&#x9;&#x9;  always has a president who must be at least 35 years old.&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Class" declaredName="USLife" MultiLow="1" isSufficient="true">
        <subsetting>UnitedStates</subsetting>
        <subsetting>Occurrences::Life</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="presidentOfUS" MultiLow="1" isFeature="true">
        <redefinitions>presidentOfCountry</redefinitions>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="age >= 35"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="UnitedStatesWithJohnAsPresident">
      <subsetting>UnitedStates</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;  This is the class of time slices of the United States during&#xA;&#x9;&#x9;  which John is president of the United States.&#xA;&#x9;&#x9;*/"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>UnitedStates::Life</typings>
        <redefinitions>timeSliceOf</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>JohnAsPresident</typings>
        <redefinitions>presidentOfUS</redefinitions>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
