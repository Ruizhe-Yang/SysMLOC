<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="Classifications">
    <elements xsi:type="kerMLOC:Class" declaredName="T"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="x" isSemicolon="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="y" valuePart="x istype T or x hastype z" isSemicolon="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="z" valuePart="(all T)#(3)" isSemicolon="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="a" valuePart="x as T" isSemicolon="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="b" valuePart="x meta KerML::Feature" isSemicolon="true"/>
  </elements>
</kerMLOC:RootNamespace>
