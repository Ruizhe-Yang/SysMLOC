<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="MetadataTest">
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="'User Defined Extensions'" isNamespace="true"/>
    <elements xsi:type="kerMLOC:LibraryPackage" declaredName="'User Defined Extensions'" isLibrary="true">
      <elements xsi:type="kerMLOC:DataType" declaredName="ClassificationLevel">
        <subsetting>ScalarValues::Natural</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="uncl" MultiLow="1" valuePart="0" isFeature="true" isSemicolon="true">
        <typings>ClassificationLevel</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="conf" MultiLow="1" valuePart="1" isFeature="true" isSemicolon="true">
        <typings>ClassificationLevel</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="secret" MultiLow="1" valuePart="2" isFeature="true" isSemicolon="true">
        <typings>ClassificationLevel</typings>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Classified">
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <typings>KerML::Feature</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="classificationLevel" isFeature="true" isSemicolon="true">
          <typings>ClassificationLevel</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Security"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="x" isFeature="true">
      <elements xsi:type="kerMLOC:MetadataFeature" metadataTyping="Classified">
        <elements xsi:type="kerMLOC:MetadataBodyFeature" valuePart="conf">
          <redefinedFeature>classificationLevel</redefinedFeature>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="y" isFeature="true">
      <elements xsi:type="kerMLOC:MetadataFeature" metadataTyping="Classified">
        <elements xsi:type="kerMLOC:MetadataBodyFeature" valuePart="conf">
          <redefinedFeature>classificationLevel</redefinedFeature>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:MetadataFeature" metadataTyping="Security"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="z1" isFeature="true" isSemicolon="true">
      <prefixMetadataExtension>#Classified</prefixMetadataExtension>
      <prefixMetadataExtension>#Security</prefixMetadataExtension>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="z2" isSemicolon="true">
      <prefixMetadataExtension>#Classified</prefixMetadataExtension>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="z" isFeature="true">
      <elements xsi:type="kerMLOC:MetadataFeature" metadataTyping="Classified">
        <prefixMetadataExtension>#Security</prefixMetadataExtension>
        <prefixMetadataExtension>#Classified</prefixMetadataExtension>
        <elements xsi:type="kerMLOC:MetadataBodyFeature" valuePart="secret">
          <redefinedFeature>classificationLevel</redefinedFeature>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="CC"/>
    <elements xsi:type="kerMLOC:Structure" declaredName="SS">
      <elements xsi:type="kerMLOC:Feature" declaredName="cc" isFeature="true" isSemicolon="true">
        <typings>CC</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Metaclass" declaredName="M">
      <subsetting>Metaobjects::SemanticMetadata</subsetting>
      <elements xsi:type="kerMLOC:Feature" isSemicolon="true">
        <typings>KerML::Class</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" valuePart="if annotatedElement istype KerML::Structure ? SS meta KerML::Type else CC meta KerML::Class" isSemicolon="true">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="T">
      <prefixMetadataExtension>#M</prefixMetadataExtension>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <redefinitions>cc</redefinitions>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
