<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="VehicleDefinitions">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * Example vehicle definitions model.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:Comment" body="/* BLOCKS */"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Vehicle"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Transmission"/>
    <elements xsi:type="kerMLOC:Class" declaredName="AxleAssembly"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Axle"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Wheel"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Lugbolt">
      <elements xsi:type="kerMLOC:Feature" declaredName="tighteningTorque" MultiLow="1" isSemicolon="true">
        <typings>ScalarValues::Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Comment" body="/* INTERFACE BLOCKS */"/>
    <elements xsi:type="kerMLOC:Class" declaredName="DriveIF">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="driveTorque" isSemicolon="true">
        <typings>ScalarValues::Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="AxleMountIF">
      <elements xsi:type="kerMLOC:Feature" direction="out" declaredName="transferredTorque" isSemicolon="true">
        <typings>ScalarValues::Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="WheelHubIF">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="appliedTorque" isSemicolon="true">
        <typings>ScalarValues::Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Comment" body="/* ASSOCIATION BLOCKS */"/>
    <elements xsi:type="kerMLOC:Association" declaredName="Mounting">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; *  mounting a Wheel to an Axle.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="axleMount" isSemicolon="true">
        <typings>AxleMountIF</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="hub" isSemicolon="true">
        <typings>WheelHubIF</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
