<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="ProductSelection_N_ary">
    <elements xsi:type="kerMLOC:Class" declaredName="ShoppingCart"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Product"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Account"/>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// User-specified association definition&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection">
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="*"/>
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <crossingFeature MultiLow="1" MultiHigh="1"/>
        <typings>Account</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition with named end features.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection1">
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature declaredName="inCart" MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature declaredName="selectedProducts" MultiLow="0" MultiHigh="*"/>
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <crossingFeature declaredName="withAccount" MultiLow="1" MultiHigh="1"/>
        <typings>Account</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition with nested cross features.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection2">
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart" MultiLow="0" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned cross feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProducts" MultiLow="0" MultiHigh="*"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned cross feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <typings>Account</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="withAccount" MultiLow="1" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned cross feature&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition showing library model specialization &#xA;"/>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// implied cross subsetting, and &quot;Cartesian product&quot; features.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection3">
      <subsetting>Links::Link</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <crosses>cart::product_account.inCart</crosses>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart" MultiLow="0" MultiHigh="1">
          <typings>ShoppingCart</typings>
          <featuringType>Product_Account</featuringType>
          <elements xsi:type="kerMLOC:CodeAnnotation" body="// Represents the &quot;Cartesian product&quot; of Product X Account.&#xA;"/>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Product_Account">
            <typings>Account</typings>
            <featuringType>Product</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="product_account">
          <typings>inCart::Product_Account</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="inCart"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <crosses>selectedProduct::cart_account.selectedProducts</crosses>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProducts" MultiLow="0" MultiHigh="*">
          <typings>Product</typings>
          <featuringType>Cart_Account</featuringType>
          <elements xsi:type="kerMLOC:CodeAnnotation" body="// Represents the &quot;Cartesian product&quot; of ShoppingCart X Account.&#xA;"/>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Cart_Account">
            <typings>Account</typings>
            <featuringType>ShoppingCart</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="cart_account">
          <typings>selectedProducts::Cart_Account</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="selectedProducts"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <typings>Account</typings>
        <crosses>account::cart_product.withAccount</crosses>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="withAccount" MultiLow="1" MultiHigh="1">
          <typings>Account</typings>
          <featuringType>Cart_Product</featuringType>
          <elements xsi:type="kerMLOC:CodeAnnotation" body="// Represents the &quot;Cartesian product&quot; of ShoppingCart X Product.&#xA;"/>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Cart_Product">
            <typings>Product</typings>
            <featuringType>ShoppingCart</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="cart_product">
          <typings>withAccount::Cart_Product</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="withAccount"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection">
      <subsetting>ProductSelection</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <crossingFeature MultiLow="1" MultiHigh="1"/>
        <typings>Account</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection1">
      <subsetting>ProductSelection1</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature declaredName="inCart1" MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature declaredName="selectedProduct1" MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <crossingFeature declaredName="withAccount1" MultiLow="1" MultiHigh="1"/>
        <typings>Account</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection2">
      <subsetting>ProductSelection2</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart1" MultiLow="0" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned crossing feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProducts1" MultiLow="0" MultiHigh="*"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned crossing feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <typings>Account</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="withAccount1" MultiLow="0" MultiHigh="*"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned crossing feature&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection3">
      <subsetting>ProductSelection3</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <crosses>cart::product_account1.inCart1</crosses>
        <redefinitions>cart</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart1" MultiLow="0" MultiHigh="1">
          <typings>ShoppingCart</typings>
          <featuringType>Product_Account1</featuringType>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Product_Account1">
            <typings>Account</typings>
            <subsetting>Product_Account</subsetting>
            <featuringType>Product</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="product_account1">
          <typings>inCart1::Product_Account1</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="inCart1"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <crosses>selectedProduct::cart_account1.selectedProduct1</crosses>
        <redefinitions>selectedProduct</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProduct1" MultiLow="1" MultiHigh="1">
          <typings>Product</typings>
          <featuringType>Cart_Account1</featuringType>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Cart_Account1">
            <typings>Account</typings>
            <subsetting>Cart_Account</subsetting>
            <featuringType>ShoppingCart</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="cart_account1">
          <typings>selectedProduct1::Cart_Account1</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="selectedProduct1"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="account" MultiLow="1">
        <typings>Account</typings>
        <crosses>account::cart_product1.withAccount1</crosses>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="withAccount1" MultiLow="1" MultiHigh="1">
          <typings>Account</typings>
          <featuringType>cart_product1</featuringType>
          <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Cart_Product1">
            <typings>Product</typings>
            <subsetting>Cart_Product</subsetting>
            <featuringType>ShoppingCart</featuringType>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="cart_product1">
          <typings>withAccount1::Cart_Product1</typings>
          <featuringType>ProductSelection3</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="withAccount1"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="OnlineCustomer">
      <elements xsi:type="kerMLOC:Feature" declaredName="myCart" MultiLow="1">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="products" MultiLow="0" MultiHigh="*">
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="myAccount" MultiLow="1">
        <typings>Account</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps1">
        <typings>ProductSelection</typings>
        <connectorPart refElement="myCart"/>
        <connectorPart refElement="products"/>
        <connectorPart refElement="myAccount"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps2">
        <typings>ProductSelection</typings>
        <connectorPart MultiLow="1" refElement="myCart"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="products"/>
        <connectorPart MultiLow="1" refElement="myAccount"/>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
