<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="ProductSelection_OwnedEnds">
    <elements xsi:type="kerMLOC:Class" declaredName="SelectionInfo"/>
    <elements xsi:type="kerMLOC:Class" declaredName="ShoppingCart"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Product"/>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// User-specified association definition&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection">
      <elements xsi:type="kerMLOC:Feature" declaredName="info">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="*" isNonunique="true"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition with named end features.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection1">
      <elements xsi:type="kerMLOC:Feature" declaredName="info">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature declaredName="inCart" MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature declaredName="selectedProducts" MultiLow="0" MultiHigh="*"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition with nested cross features.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection2">
      <elements xsi:type="kerMLOC:Feature" declaredName="info">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart" MultiLow="0" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned cross feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProducts" MultiLow="0" MultiHigh="*"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned cross feature&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association definition showing library model specialization &#xA;"/>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// and implied cross subsetting.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection3">
      <subsetting>Links::BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="info">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <crosses>selectedProduct.inCart</crosses>
        <redefinitions>source</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart" MultiLow="0" MultiHigh="1">
          <typings>ShoppingCart</typings>
          <featuringType>Product</featuringType>
        </elements>
        <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="selectedProduct::selectedProducts"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <crosses>cart.selectedProducts</crosses>
        <redefinitions>target</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProducts" MultiLow="0" MultiHigh="*">
          <typings>Product</typings>
          <featuringType>ShoppingCart</featuringType>
        </elements>
        <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="cart::inCart"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection">
      <subsetting>ProductSelection</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection1">
      <subsetting>ProductSelection1</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <crossingFeature declaredName="inCart1" MultiLow="0" MultiHigh="1"/>
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossingFeature declaredName="selectedProduct1" MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection2">
      <subsetting>ProductSelection2</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart1" MultiLow="0" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned crossing feature&#xA;"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProduct1" MultiLow="0" MultiHigh="1"/>
        <elements xsi:type="kerMLOC:CodeAnnotation" body="// owned crossing feature&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection3">
      <subsetting>ProductSelection3</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <crosses>selectedProduct.inCart1</crosses>
        <redefinitions>cart</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="inCart1" MultiLow="0" MultiHigh="1">
          <subsetting>inCart</subsetting>
          <featuringType>Product</featuringType>
        </elements>
        <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="selectedProduct::selectedProduct1"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <crosses>cart.selectedProduct1</crosses>
        <redefinitions>selectedProduct</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProduct1" MultiLow="0" MultiHigh="1">
          <subsetting>selectedProducts</subsetting>
          <featuringType>ShoppingCart</featuringType>
        </elements>
        <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="cart::inCart1"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="OnlineCustomer">
      <elements xsi:type="kerMLOC:Feature" declaredName="info1">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="myCart" MultiLow="1">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="products" MultiLow="0" MultiHigh="*">
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps1">
        <typings>ProductSelection</typings>
        <connectorPartBinary refElement="myCart"/>
        <connectorPartBinary refElement="products"/>
        <elements xsi:type="kerMLOC:Feature" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps2">
        <typings>ProductSelection</typings>
        <connectorPartBinary MultiLow="1" refElement="myCart"/>
        <connectorPartBinary MultiLow="1" refElement="products"/>
        <elements xsi:type="kerMLOC:Feature" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
