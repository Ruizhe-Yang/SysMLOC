<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="ProductSelection_UnownedEnds">
    <elements xsi:type="kerMLOC:Class" declaredName="SelectionInfo"/>
    <elements xsi:type="kerMLOC:Class" declaredName="ShoppingCart">
      <elements xsi:type="kerMLOC:Feature" declaredName="selectedProducts" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Product">
      <elements xsi:type="kerMLOC:Feature" declaredName="inCart" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>ShoppingCart</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="ProductSelection">
      <elements xsi:type="kerMLOC:Feature" declaredName="info" MultiLow="1" isFeature="true">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1" isFeature="true">
        <typings>ShoppingCart</typings>
        <crosses>selectedProduct.inCart</crosses>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1" isFeature="true">
        <typings>Product</typings>
        <crosses>cart.selectedProducts</crosses>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection">
      <subsetting>ProductSelection</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1" isFeature="true">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1" isFeature="true">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Equivalent association showing implied relationships explicitly.&#xA;"/>
    <elements xsi:type="kerMLOC:Association" declaredName="SingleProductSelection1">
      <subsetting>ProductSelection</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="cart" MultiLow="1" isFeature="true">
        <typings>ShoppingCart</typings>
        <redefinitions>cart</redefinitions>
        <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="selectedProduct::selectedProduct1"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selectedProduct" MultiLow="1" isFeature="true">
        <typings>Product</typings>
        <crosses>cart.selectedProduct1</crosses>
        <redefinitions>selectedProduct</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="selectedProduct1" MultiLow="0" MultiHigh="1" isFeature="true">
          <subsetting>ShoppingCart::selectedProducts</subsetting>
          <featuringType>ShoppingCart</featuringType>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="OnlineCustomer">
      <elements xsi:type="kerMLOC:Feature" declaredName="info1" isFeature="true">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="myCart" MultiLow="1" isFeature="true">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="products" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Product</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps1" isFrom="true">
        <typings>ProductSelection</typings>
        <connectorPart refElement="myCart"/>
        <connectorPart refElement="products"/>
        <elements xsi:type="kerMLOC:Feature" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="ps2" isFrom="true">
        <typings>ProductSelection</typings>
        <connectorPart MultiLow="1" refElement="myCart"/>
        <connectorPart MultiLow="1" refElement="products"/>
        <elements xsi:type="kerMLOC:Feature" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
