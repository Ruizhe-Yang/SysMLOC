<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Behavior" declaredName="TakePicture">
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Camera"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="camera" MultiLow="1" isFeature="true">
      <typings>Camera</typings>
      <subsetting>involvedObjects</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Exposure"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Focus">
      <elements xsi:type="kerMLOC:Feature" direction="out" declaredName="xrsl">
        <typings>Exposure</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Shoot">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="xsf">
        <typings>Exposure</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" declaredName="step1" MultiLow="1">
      <typings>Focus</typings>
    </elements>
    <elements xsi:type="kerMLOC:Step" declaredName="step2" MultiLow="1">
      <typings>Shoot</typings>
    </elements>
    <elements xsi:type="kerMLOC:SuccessionFlow" declaredName="exposure" MultiLow="1">
      <payload payloadFeatureElement="Exposure"/>
      <FlowEnd>step1.xrsl</FlowEnd>
      <FlowEnd>step2.xsf</FlowEnd>
    </elements>
    <elements xsi:type="kerMLOC:Succession">
      <connectorPart refElement="step1"/>
      <connectorPart refElement="camera.focusedState"/>
    </elements>
    <elements xsi:type="kerMLOC:Succession">
      <connectorPart refElement="step2"/>
      <connectorPart refElement="camera.shotState"/>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
