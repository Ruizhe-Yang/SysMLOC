<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="SequencesModelToBeExecuted">
    <elements xsi:type="kerMLOC:Documentation" body="/* &#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Manufacture">
      <elements xsi:type="kerMLOC:Step" declaredName="paint" MultiLow="1">
        <typings>Paint</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="dry" MultiLow="*">
        <typings>Dry</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession" declaredName="p_before_d" isFirst="true">
        <connectorPart MultiLow="1" refElement="paint"/>
        <connectorPart MultiLow="1" refElement="dry"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="ship" MultiLow="*">
        <typings>Ship</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession" declaredName="d_before_s" isFirst="true">
        <connectorPart MultiLow="1" refElement="dry"/>
        <connectorPart MultiLow="1" refElement="ship"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Paint"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Dry"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="Ship"/>
  </elements>
  <elements xsi:type="kerMLOC:Package" declaredName="SequencesExecution">
    <elements xsi:type="kerMLOC:Documentation" body="/* &#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Atoms" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequencesModelToBeExecuted" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensBefore"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyPaint">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>Paint</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyDry">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>Dry</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="MyPaint_Before_Dry_Link">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>HappensBefore</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true">
        <typings>MyPaint</typings>
        <redefinitions>earlierOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true">
        <typings>MyDry</typings>
        <redefinitions>laterOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyManufactureStepsPD">
      <unioning>MyPaint</unioning>
      <unioning>MyDry</unioning>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyShip">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>Ship</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="MyDry_Before_Ship_Link">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>HappensBefore</subsetting>
      <elements xsi:type="kerMLOC:Feature" isEnd="true">
        <typings>MyDry</typings>
        <redefinitions>earlierOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true">
        <typings>MyShip</typings>
        <redefinitions>laterOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyManufactureStepsPDS">
      <unioning>MyManufactureStepsPD</unioning>
      <unioning>MyShip</unioning>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MyManufacture">
      <prefixMetadataExtension>#atom</prefixMetadataExtension>
      <subsetting>Manufacture</subsetting>
      <elements xsi:type="kerMLOC:Feature" MultiLow="3">
        <typings>MyManufactureStepsPDS</typings>
        <redefinitions>timeEnclosedOccurrences</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Step">
        <typings>MyPaint</typings>
        <redefinitions>paint</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Step" MultiLow="1">
        <typings>MyDry</typings>
        <redefinitions>dry</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Succession" MultiLow="1" isFirst="true">
        <typings>MyPaint_Before_Dry_Link</typings>
        <redefinitions>p_before_d</redefinitions>
        <connectorPart refElement="paint"/>
        <connectorPart refElement="dry"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" MultiLow="1">
        <typings>MyShip</typings>
        <redefinitions>ship</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Succession" MultiLow="1" isFirst="true">
        <typings>MyDry_Before_Ship_Link</typings>
        <redefinitions>d_before_s</redefinitions>
        <connectorPart refElement="dry"/>
        <connectorPart refElement="ship"/>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
