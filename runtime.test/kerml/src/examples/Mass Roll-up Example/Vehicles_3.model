<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="Vehicles_3">
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="MassRollup_2" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Class" declaredName="CarPart">
      <subsetting>MassedThing</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="serialNumber">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="m">
        <redefinitions>MassedThing::mass</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="subparts">
        <redefinitions>carParts</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="carParts" MultiLow="0" MultiHigh="*">
      <typings>CarPart</typings>
      <subsetting>massedThings</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="vehicle">
      <subsetting>carParts</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="vin">
        <redefinitions>serialNumber</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature">
        <redefinitions>engine</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature">
        <redefinitions>transmission</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="engine">
      <subsetting>carParts</subsetting>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//...&#xA;"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="transmission">
      <subsetting>carParts</subsetting>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//...&#xA;"/>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Example usage&#xA;"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="v">
      <typings>vehicle</typings>
      <elements xsi:type="kerMLOC:Feature" declaredName="m" valuePart="1000">
        <redefinitions>CarPart::m</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isComposite="true" valuePart="e">
        <redefinitions>engine</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isComposite="true" valuePart="t">
        <redefinitions>transmission</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="e">
      <subsetting>engine</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="m" valuePart="100">
        <redefinitions>CarPart::m</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="t">
      <subsetting>transmission</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="m" valuePart="50">
        <redefinitions>CarPart::m</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// v.totalMass evaluates to 1150.0&#xA;"/>
  </elements>
</kerMLOC:RootNamespace>
