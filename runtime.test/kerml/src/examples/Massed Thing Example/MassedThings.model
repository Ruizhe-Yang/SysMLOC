<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
  <elements xsi:type="kerMLOC:Package" declaredName="MassedThings">
    <elements xsi:type="kerMLOC:Class" visibility="public" declaredName="MassedThing">
      <elements xsi:type="kerMLOC:Feature" visibility="public" declaredName="name">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="public" declaredName="mass" valuePart="0">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" visibility="public" declaredName="MassedThingAssembly">
      <elements xsi:type="kerMLOC:Feature" visibility="public" isEnd="true" declaredName="assembly">
        <crossingFeature MultiLow="0" MultiHigh="1"/>
        <typings>MassedThing</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="public" isEnd="true" declaredName="parts">
        <crossingFeature MultiLow="0" MultiHigh="*"/>
        <typings>MassedThing</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
