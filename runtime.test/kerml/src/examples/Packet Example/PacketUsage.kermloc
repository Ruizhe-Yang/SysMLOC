<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Packets" isNamespace="true"/>
  <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
  <elements xsi:type="kerMLOC:Package" declaredName="'Packet Usage'">
    <elements xsi:type="kerMLOC:Feature" declaredName="packet1" isFeature="true">
      <typings>'Thermal Data Packet'</typings>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="packet2" isFeature="true">
      <typings>'Thermal Data Packet'</typings>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="packet3" isFeature="true">
      <typings>'Thermal Data Packet'</typings>
      <elements xsi:type="kerMLOC:Feature" declaredName="'special data field'" isFeature="true">
        <redefinitions>'packet data field'</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <redefinitions>'user data field'</redefinitions>
          <elements xsi:type="kerMLOC:Feature" declaredName="'special data'" isFeature="true">
            <typings>Real</typings>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
