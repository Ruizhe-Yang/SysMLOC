<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="ArgumentResolutionBug">
    <elements xsi:type="kerMLOC:Class" declaredName="A">
      <elements xsi:type="kerMLOC:Feature" declaredName="x"/>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="B">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x"/>
      <elements xsi:type="kerMLOC:Feature" direction="out" valuePart="new A(x)">
        <typings>A</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="C">
      <elements xsi:type="kerMLOC:Feature" declaredName="a">
        <typings>A</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="b">
        <typings>B</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector">
        <connectorPartBinary delcaredName="a" refElement="a.x"/>
        <connectorPartBinary refElement="b"/>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
