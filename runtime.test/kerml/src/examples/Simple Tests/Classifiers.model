<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="Classifiers">
    <elements xsi:type="kerMLOC:Classifier" declaredName="A"/>
    <elements xsi:type="kerMLOC:Classifier" declaredName="B"/>
    <elements xsi:type="kerMLOC:Subclassification" declaredName="Super" isSpecialization="true" subclassifier="A" superclassifier="B"/>
    <elements xsi:type="kerMLOC:Subclassification" isSpecialization="true" subclassifier="B" superclassifier="A"/>
    <elements xsi:type="kerMLOC:Subclassification" subclassifier="C" superclassifier="A"/>
    <elements xsi:type="kerMLOC:Subclassification" subclassifier="C" superclassifier="B"/>
    <elements xsi:type="kerMLOC:Classifier" declaredName="C">
      <subsetting>A</subsetting>
      <subsetting>B</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Classifier" declaredName="D">
      <disjoining>C</disjoining>
      <differencing>A</differencing>
      <differencing>B</differencing>
    </elements>
    <elements xsi:type="kerMLOC:Classifier" declaredName="E">
      <subsetting>C</subsetting>
      <intersecting>A</intersecting>
      <intersecting>B</intersecting>
    </elements>
    <elements xsi:type="kerMLOC:Classifier" declaredName="F">
      <unioning>A</unioning>
      <unioning>B</unioning>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
