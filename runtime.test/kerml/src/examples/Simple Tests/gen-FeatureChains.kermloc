<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="FeatureChains">
    <elements xsi:type="kerMLOC:Classifier" declaredName="F">
      <elements xsi:type="kerMLOC:Feature" declaredName="a" isFeature="true">
        <typings>A</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="f" isFeature="true">
      <typings>F</typings>
    </elements>
    <elements xsi:type="kerMLOC:Classifier" declaredName="A">
      <elements xsi:type="kerMLOC:Feature" declaredName="g" valuePart="f.a" isFeature="true"/>
    </elements>
    <elements xsi:type="kerMLOC:Classifier" declaredName="B">
      <elements xsi:type="kerMLOC:Feature" declaredName="f" isFeature="true">
        <typings>F</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="a" isFeature="true">
        <typings>A</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="b" isFeature="true">
      <typings>B</typings>
      <elements xsi:type="kerMLOC:Connector">
        <connectorPart refElement="f.a"/>
        <connectorPart refElement="a.g"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="f.a"/>
        <connectorPart refElement="a.g"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="g" isFeature="true">
      <subsetting>f.a</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="g.g" subsettedFeature="b.f.a"/>
    <elements xsi:type="kerMLOC:Redefinition" redefiningFeature="b.f" redefinedFeature="b.a"/>
    <elements xsi:type="kerMLOC:Specialization" specific="g.g" general="b.f.a"/>
    <elements xsi:type="kerMLOC:Disjoining" typeDisjoined="b.f.a" disjoiningType="b.a"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="h1" isFeature="true">
      <unioning>f</unioning>
      <unioning>b.f</unioning>
      <unioning>b.a</unioning>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="h2" isFeature="true">
      <disjoining>h1</disjoining>
      <intersecting>f.a</intersecting>
      <intersecting>g</intersecting>
      <differencing>b.f</differencing>
      <differencing>b.a</differencing>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="b_f_a" isFeature="true">
      <chainingFeature>b</chainingFeature>
      <chainingFeature>f.a</chainingFeature>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
