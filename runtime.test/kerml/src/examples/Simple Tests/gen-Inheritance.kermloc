<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="Inheritance">
    <elements xsi:type="kerMLOC:Class" declaredName="A">
      <elements xsi:type="kerMLOC:Feature" declaredName="f" isFeature="true"/>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="B">
      <subsetting>A</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="y" isFeature="true">
      <typings>A</typings>
      <elements xsi:type="kerMLOC:AliasElement" memberName="x" memberElement="B::f"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="g" isFeature="true">
        <redefinitions>f</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:AliasElement" memberName="z" memberElement="y::g"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="w" isFeature="true">
      <subsetting>y</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:AliasElement" memberName="us" memberElement="w::g"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="yy" isFeature="true">
      <typings>y</typings>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
