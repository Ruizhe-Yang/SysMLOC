<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="ExtendedOccurrences">
    <elements xsi:type="kerMLOC:Class" declaredName="Interval"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Moment">
      <subsetting>Interval</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Timeslice">
      <elements xsi:type="kerMLOC:Feature" declaredName="interval">
        <typings>Interval</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature">
        <typings>Timeslice</typings>
        <redefinitions>self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Snapshot">
      <subsetting>Timeslice</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="moment">
        <typings>Moment</typings>
        <redefinitions>interval</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature">
        <typings>Snapshot</typings>
        <redefinitions>self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Life">
      <subsetting>Timeslice</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="ExtendedOccurrence">
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1" MultiHigh="*">
        <typings>Timeslice</typings>
        <redefinitions>timeSlices</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1" MultiHigh="*">
        <typings>Snapshot</typings>
        <subsetting>timeSlices</subsetting>
        <redefinitions>snapshots</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:ExpressionClass" declaredName="at">
        <elements xsi:type="kerMLOC:Feature">
          <typings>Timeslice</typings>
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="interval">
          <typings>Interval</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result">
          <typings>Timeslice</typings>
        </elements>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="result.portionOf"/>
          <connectorPart refElement="that"/>
        </elements>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="result.interval"/>
          <connectorPart refElement="interval"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:ExpressionClass" declaredName="while">
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="timeslice">
          <typings>Timeslice</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" valuePart="at(timeslice.interval)">
          <typings>Timeslice</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="activeOccurrences">
        <subsetting>Occurrences::occurrences</subsetting>
        <elements xsi:type="kerMLOC:Connector">
          <typings>Occurrences::HappensDuring</typings>
          <connectorPartBinary MultiLow="1" refElement="that"/>
          <connectorPartBinary MultiLow="1" refElement="self"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="activeSuboccurrences">
        <subsetting>Occurrences::occurrences</subsetting>
        <elements xsi:type="kerMLOC:Connector">
          <typings>Occurrences::HappensDuring</typings>
          <connectorPartBinary MultiLow="1" refElement="that"/>
          <connectorPartBinary MultiLow="1" refElement="self"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// occurrences and performances are abstract package-level features.&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// It would be nice to put the variable next to them, but they cannot &#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// be package-level, or featured by Anything. Nevertheless, since&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Occurrence is a specialization of Anything, it will have these &#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// features (might be worth redefining them explicitly), so the&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// variables can subset them. In the case below, performances will&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// contain every step in the occurrence, which is the correct domain&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// for the variable.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="activePerformances">
        <subsetting>Performances::performances</subsetting>
        <elements xsi:type="kerMLOC:Connector">
          <typings>Occurrences::HappensDuring</typings>
          <connectorPartBinary MultiLow="1" refElement="that"/>
          <connectorPartBinary MultiLow="1" refElement="self"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="ExtendedObject">
      <subsetting>ExtendedOccurrence</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="self">
        <typings>ExtendedObject</typings>
        <redefinitions>Objects::Object::self</redefinitions>
        <redefinitions>ExtendedOccurrence::self</redefinitions>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
