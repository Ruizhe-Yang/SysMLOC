<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="TimeVaryingSteps">
    <elements xsi:type="kerMLOC:Behavior" declaredName="TakePicture">
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step merge : MergePerformance [0..1];&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="merge" MultiLow="0" MultiHigh="1">
        <typings>ControlPerformances::MergePerformance</typings>
        <featuringType>TakePicture_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="TakePicture_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>TakePicture</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="merge"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step focus [0..1];&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="focus" MultiLow="0" MultiHigh="1">
        <featuringType>TakePicture_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="TakePicture_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>TakePicture</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="focus"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step shoot [0..1];&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="shoot" MultiLow="0" MultiHigh="1">
        <featuringType>TakePicture_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="TakePicture_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>TakePicture</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="shoot"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step decide : DecisionPerformance [0..1];&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="decide" MultiLow="0" MultiHigh="1">
        <typings>ControlPerformances::DecisionPerformance</typings>
        <featuringType>TakePicture_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="TakePicture_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>TakePicture</featuringType>
          <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="decide"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="startShot"/>
        <connectorPart MultiLow="1" refElement="merge::TakePicture_snapshots.merge"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="1" refElement="merge::TakePicture_snapshots.merge"/>
        <connectorPart MultiLow="1" refElement="focus::TakePicture_snapshots.focus"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="1" refElement="focus::TakePicture_snapshots.focus"/>
        <connectorPart refElement="shoot::TakePicture_snapshots.shoot"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="1" refElement="shoot::TakePicture_snapshots.shoot"/>
        <connectorPart MultiLow="1" refElement="decide::TakePicture_snapshots.decide"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="decide::TakePicture_snapshots.decide"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="merge::TakePicture_snapshots.merge"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" isFirst="true">
        <connectorPart MultiLow="1" refElement="decide::TakePicture_snapshots.decide"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="endShot"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Camera">
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Is always taking a picture, one at a time.&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step takePic : TakePicture [1];&#x9;&#x9;&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="takePic" MultiLow="1">
        <typings>TakePicture</typings>
        <featuringType>Camera_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Camera_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>Camera</featuringType>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="MultiCamera">
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Can take many pictures at one time.&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// var step takePics : TakePicture [0..*];&#x9;&#x9;&#xA;"/>
      <elements xsi:type="kerMLOC:Step" isMember="true" declaredName="takePics" MultiLow="0" MultiHigh="*">
        <typings>TakePicture</typings>
        <featuringType>Camera_snapshots</featuringType>
        <elements xsi:type="kerMLOC:Feature" isMember="true" declaredName="Camera_snapshots">
          <redefinitions>Occurrences::Occurrence::snapshots</redefinitions>
          <featuringType>Camera</featuringType>
        </elements>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
