<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:Package" declaredName="Moments">
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Life"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Eternity">
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Nothing before/after or outside.&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Could be many of these, see universal below.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" MultiLow="0">
        <redefinitions>predecessors</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" MultiLow="0">
        <redefinitions>successors</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" MultiLow="0">
        <redefinitions>outsideOfOccurrences</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="UniversalEternity" MultiLow="1">
      <subsetting>Eternity</subsetting>
      <elements xsi:type="kerMLOC:Feature">
        <typings>Period</typings>
        <redefinitions>timeSlices</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//Includes life.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature">
        <typings>Moment</typings>
        <redefinitions>snapshots</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="universalEternity" MultiLow="1" isFeature="true">
      <typings>UniversalEternity</typings>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="Period">
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//Includes life and snapshots.&#xA;"/>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//&#x2193;&#x2193; With UE redef, exactly UE timeslices.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1">
        <typings>UniversalEternity</typings>
        <redefinitions>timeSliceOf</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" declaredName="InstantOccurrence" isSufficient="true">
      <subsetting>Occurrence</subsetting>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Probly useful elsewhere, eg, to type snapshots.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1">
        <redefinitions>snapshots</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Or startShot subsets endShot;&#xA;"/>
    </elements>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="// Or middleTimeslice [0];&#xA;"/>
    <elements xsi:type="kerMLOC:Class" declaredName="Moment">
      <subsetting>Period</subsetting>
      <subsetting>InstantOccurrence</subsetting>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="//&#x2193;&#x2193; With UE redef, exactly UE snapshots.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" MultiLow="1">
        <typings>UniversalEternity</typings>
        <redefinitions>snapshotOf</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrence::spaceTimeCoincidentOccurrences"/>
    <elements xsi:type="kerMLOC:CodeAnnotation" body="//UE portion &quot;corresponding&quot; to an occurrence.&#xA;"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="coincidentUEPortion" MultiLow="1" isFeature="true">
      <typings>Occurrence</typings>
      <subsetting>spaceTimeCoincidentOccurrences</subsetting>
      <subsetting>universalEternity.portions</subsetting>
      <featuringType>Occurrence</featuringType>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
