<?xml version="1.0" encoding="ASCII"?>
<mOloc:StoredDefinition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <classes name="BouncingBall" name_end="BouncingBall">
    <composition>
      <priv_elist>
        <elem xsi:type="mOloc:ComponentClause" prefix="parameter">
          <type name="Real"/>
          <comps>
            <comps>
              <decl name="g">
                <mod dh="true">
