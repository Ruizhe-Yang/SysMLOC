                </mod>
              </decl>
              <comment comment="&quot;Gravity acceleration (m/s^2)&quot;"/>
            </comps>
          </comps>
        </elem>
        <elem xsi:type="mOloc:ComponentClause" prefix="parameter">
          <type name="Real"/>
          <comps>
            <comps>
              <decl name="e">
                <mod dh="true">
                  <expr xsi:type="mOloc:FloatPrimary" val="0.8"/>
                </mod>
              </decl>
              <comment comment="&quot;Coefficient of restitution&quot;"/>
            </comps>
          </comps>
        </elem>
        <elem xsi:type="mOloc:ComponentClause">
          <type name="Real"/>
          <comps>
            <comps>
              <decl name="h">
                <mod>
                  <mod>
                    <args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
