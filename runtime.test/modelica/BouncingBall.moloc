        </equations>
        <equations xsi:type="mOloc:LREquation">
          <commment/>
          <left xsi:type="mOloc:FunctionCall" comp_ref="der">
            <args>
              <res>
                <args xsi:type="mOloc:ComponentReference">
                  <idents>v</idents>
