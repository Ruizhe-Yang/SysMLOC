<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <classes classType="model" className="BouncingBall">
    <elements xsi:type="mOloc:GeneralClause" parameterType="parameter" typeSpecifier="Real">
      <component_list expression="9.81" declarationName="g" description="&quot;Gravity acceleration (m/s^2)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" parameterType="parameter" typeSpecifier="Real">
      <component_list expression="0.8" declarationName="e" description="&quot;Coefficient of restitution&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real">
      <component_list declarationName="h" description="&quot;Height (m)&quot;">
        <arguments expression="1.0" elementName="start"/>
        <arguments expression="true" elementName="fixed"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real">
      <component_list declarationName="v" description="&quot;Velocity (m/s)&quot;">
        <arguments expression="0.0" elementName="start"/>
        <arguments expression="true" elementName="fixed"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="der(h)" right="v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="der(v)" right="-g"/>
      <equations xsi:type="mOloc:WhenEquation" condition="h &lt;= 0">
        <equations xsi:type="mOloc:FunctionEquation" component="reinit" function="(v, -e * v)"/>
      </equations>
    </elements>
  </classes>
</mOloc:Stored_definition>
