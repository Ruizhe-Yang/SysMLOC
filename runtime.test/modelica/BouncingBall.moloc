        </elem>
        <elem xsi:type="mOloc:ComponentClause">
          <type name="Real"/>
          <comps>
            <comps>
              <decl name="v">
                <mod>
                  <mod>
                    <args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
                        <element xsi:type="mOloc:ElementModification" name="start">
                          <mod dh="true">
                            <expr xsi:type="mOloc:FloatPrimary"/>
                          </mod>
                        </element>
                      </args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
                        <element xsi:type="mOloc:ElementModification" name="fixed">
