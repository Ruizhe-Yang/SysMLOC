          </arguments>
        </equations>
        <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="gainPID.y" right="addFF.u1">
          <arguments elementName="Line">
            <arguments expression="{{41,0},{44,0},{44,3.6}, {46.8,3.6} }" elementName="points"/>
            <arguments expression="{0,0,127}" elementName="color"/>
          </arguments>
        </equations>
        <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="FFzero.y" right="addFF.u2">
          <arguments elementName="Line">
