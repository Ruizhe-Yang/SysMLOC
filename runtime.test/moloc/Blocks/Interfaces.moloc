        <arguments expression="{ Polygon( lineColor={0,0,127}, fillColor={0,0,127}, fillPattern=FillPattern.Solid, points={{-100.0,100.0},{100.0,0.0},{-100.0,-100.0}} ) }" elementName="graphics"/>
