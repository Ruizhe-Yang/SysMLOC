      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter">
        <component_list declarationName="samplePeriod" description="&quot;Sample period of component&quot;">
          <arguments expression="100*Modelica.Constants.eps" elementName="min"/>
          <arguments expression="0.1" elementName="start"/>
