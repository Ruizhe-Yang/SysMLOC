        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" classType="block" className="Sign" description="&quot;Output the sign of the input&quot;" isLongClassSpecifier="true" classNameEnd="Sign" isOver="true">
