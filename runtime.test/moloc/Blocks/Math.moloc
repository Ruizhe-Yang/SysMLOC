    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This package contains basic &lt;strong>mathematical operations&lt;/strong>,&#xA;such as summation and multiplication, and basic &lt;strong>mathematical&#xA;functions&lt;/strong>, such as &lt;strong>sqrt&lt;/strong> and &lt;strong>sin&lt;/strong>, as&#xA;input/output blocks. All blocks of this library can be either&#xA;connected with continuous blocks or with sampled-data blocks.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
