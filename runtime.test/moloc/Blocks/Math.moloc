          </modifications>
          <modifications expression="{Text( extent={{-90,36},{90,-36}}, textColor={160,160,164}, textString=&quot;edge()&quot; ) }" elementName="graphics"/>
        </annotations>
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This block sets the Boolean output &lt;strong>y&lt;/strong> to true,&#xA;when the Boolean input &lt;strong>u&lt;/strong> shows a &lt;em>rising edge&lt;/em>:&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;y = &lt;strong>edge&lt;/strong>( u );&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" classType="block" className="BooleanChange" description="&quot;Indicates Boolean signal changing&quot;" isLongClassSpecifier="true" classNameEnd="BooleanChange" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.BooleanSISO" isOver="true"/>
      <elements xsi:type="mOloc:EquationSection">
        <equations xsi:type="mOloc:SimpleEquation" left="y" right="change(u)"/>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Icon">
          <modifications isModificationOver="true" elementName="coordinateSystem">
            <modifications expression="true" elementName="preserveAspectRatio"/>
            <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
          </modifications>
          <modifications expression="{Text( extent={{-90,36},{90,-36}}, textColor={160,160,164}, textString=&quot;change()&quot; ) }" elementName="graphics"/>
        </annotations>
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This block sets the Boolean output &lt;strong>y&lt;/strong> to true, when the&#xA;Boolean input &lt;strong>u&lt;/strong> shows a &lt;em>rising or falling edge&lt;/em>,&#xA;i.e., when the signal changes:&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;y = &lt;strong>change&lt;/strong>( u );&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" classType="block" className="IntegerChange" description="&quot;Indicates integer signal changing&quot;" isLongClassSpecifier="true" classNameEnd="IntegerChange" isOver="true">
