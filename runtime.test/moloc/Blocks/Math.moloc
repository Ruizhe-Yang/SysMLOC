    <elements xsi:type="mOloc:ComponentClause" classType="block" className="RealToInteger" description="&quot;Convert Real to Integer signal&quot;" isLongClassSpecifier="true" classNameEnd="RealToInteger" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Icons.IntegerBlock" isOver="true"/>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.RealInput" isPublic="true" isOver="true">
        <component_list declarationName="u" description="&quot;Connector of Real input signal&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Placement">
            <modifications isModificationOver="true" elementName="transformation">
              <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
            </modifications>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.IntegerOutput" isOver="true">
        <component_list declarationName="y" description="&quot;Connector of Integer output signal&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Placement">
            <modifications isModificationOver="true" elementName="transformation">
              <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
            </modifications>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:EquationSection">
        <equations xsi:type="mOloc:SimpleEquation" left="y" right="if (u > 0) then integer(floor(u + 0.5)) else integer(ceil(u - 0.5))"/>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Icon">
          <modifications isModificationOver="true" elementName="coordinateSystem">
            <modifications expression="true" elementName="preserveAspectRatio"/>
            <modifications expression="{{-100.0,-100.0},{100.0,100.0}}" elementName="extent"/>
          </modifications>
          <modifications expression="{ Text( textColor={0,0,127}, extent={{-100.0,-40.0},{0.0,40.0}}, textString=&quot;R&quot; ) , Text( textColor={255,127,0}, extent={{20.0,-40.0},{120.0,40.0}}, textString=&quot;I&quot; ) , Polygon( lineColor={255,127,0}, fillColor={255,127,0}, fillPattern=FillPattern.Solid, points={{50.0,0.0},{30.0,20.0},{30.0,10.0},{0.0,10.0},{0.0,-10.0},{ 30.0,-10.0} ,{30.0,-20.0},{50.0,0.0} } ) }" elementName="graphics"/>
        </annotations>
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This block computes the output &lt;strong>y&lt;/strong>&#xA;as &lt;em>nearest integer value&lt;/em> of the input &lt;strong>u&lt;/strong>:&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;y = &lt;strong>integer&lt;/strong>( &lt;strong>floor&lt;/strong>( u + 0.5 ) )  for  u &amp;gt; 0;&#xA;y = &lt;strong>integer&lt;/strong>( &lt;strong>ceil &lt;/strong>( u - 0.5 ) )  for  u &amp;lt; 0;&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
