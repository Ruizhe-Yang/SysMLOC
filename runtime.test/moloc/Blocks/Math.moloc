    <elements xsi:type="mOloc:ComponentClause" classType="block" className="Abs" description="&quot;Output the absolute value of the input&quot;" isLongClassSpecifier="true" classNameEnd="Abs" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.SISO" isOver="true"/>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
