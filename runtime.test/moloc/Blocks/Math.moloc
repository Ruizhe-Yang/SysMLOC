    <elements xsi:type="mOloc:ComponentClause" classType="block" className="LinearDependency" description="&quot;Output a linear combination of the two inputs&quot;" isLongClassSpecifier="true" classNameEnd="LinearDependency" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.SI2SO" isOver="true"/>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
        <component_list expression="0" declarationName="y0" description="&quot;Initial value&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
        <component_list expression="0" declarationName="k1" description="&quot;Gain of u1&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
        <component_list expression="0" declarationName="k2" description="&quot;Gain of u2&quot;"/>
      </elements>
      <elements xsi:type="mOloc:EquationSection">
        <equations xsi:type="mOloc:SimpleEquation" left="y" right="y0 + k1*u1 + k2*u2"/>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Icon">
          <modifications isModificationOver="true" elementName="coordinateSystem">
