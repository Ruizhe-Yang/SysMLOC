            <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
          </modifications>
          <modifications expression="{ Line( points={{-100,60},{100,0},{-100,-60}}, color={0,0,127} ) , Text( extent={{-14,88},{94,32}}, textString=&quot;%k1&quot; ) , Text( extent={{-40,-48},{96,-96}}, textString=&quot;%k2&quot; ) , Text( extent={{-94,26},{8,-30}}, textString=&quot;%y0&quot; ) }" elementName="graphics"/>
        </annotations>
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>Determine the linear combination of the two inputs: &lt;code>y = y0 + k1*u1 + k2*u2&lt;/code>&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" classType="block" className="Edge" description="&quot;Indicates rising edge of Boolean signal&quot;" isLongClassSpecifier="true" classNameEnd="Edge" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.BooleanSISO" isOver="true"/>
