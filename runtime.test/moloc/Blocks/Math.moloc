    <elements xsi:type="mOloc:ComponentClause" classType="block" className="WrapAngle" description="&quot;Wrap angle to interval ]-pi,pi] or [0,2*pi[&quot;" isLongClassSpecifier="true" classNameEnd="WrapAngle" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.SISO" isOver="true">
