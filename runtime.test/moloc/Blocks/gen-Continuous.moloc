        <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="addFF.y" right="addSat.u2">
          <annotations isModificationOver="true" elementName="Line">
            <modifications expression="{{60.6,0},{64,0},{64,-20}, {74,-20},{74,-38} }" elementName="points"/>
