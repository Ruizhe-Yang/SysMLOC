            <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
              <component_list subscripts="[mod(order, 2)]" declarationName="c1" description="&quot;[p] coefficients of Bessel denominator polynomials (a*p + 1)&quot;"/>
