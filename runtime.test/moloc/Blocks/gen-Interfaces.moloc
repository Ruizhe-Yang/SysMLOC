    <elements xsi:type="mOloc:ComponentClause" isPartial="true" classType="block" className="PartialNoise" description="&quot;Partial noise generator&quot;" isLongClassSpecifier="true" classNameEnd="PartialNoise" isOver="true">
      <elements xsi:type="mOloc:ImportClause" selfName="generator" importName="Modelica.Math.Random.Generators.Xorshift128plus" isOver="true"/>
      <elements xsi:type="mOloc:ImportClause" importName="Modelica.Math.Random.Utilities.automaticLocalSeed" isOver="true"/>
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.SO" isOver="true"/>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Period" parameterType="parameter" isOver="true">
        <component_list isModificationOver="true" declarationName="samplePeriod" description="&quot;Period for sampling the raw random numbers&quot;" isAnnotation="true" isAnnotationOver="true">
          <modifications expression="0.01" elementName="start"/>
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="enableNoise" elementName="enable"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
        <component_list expression="globalSeed.enableNoise" declarationName="enableNoise" description="&quot;= true: y = noise, otherwise y = y_off&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="choices">
            <modifications expression="true" elementName="checkBox"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Noise generation&quot;" elementName="group"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
        <component_list expression="0.0" declarationName="y_off" description="&quot;Sets y = y_off if enableNoise=false (or time&lt;startTime, see below)&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Noise generation&quot;" elementName="group"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
        <component_list expression="true" declarationName="useGlobalSeed" description="&quot;= true: use global seed, otherwise ignore it&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="choices">
            <modifications expression="true" elementName="checkBox"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Initialization&quot;" elementName="group"/>
            <modifications expression="enableNoise" elementName="enable"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
        <component_list expression="true" declarationName="useAutomaticLocalSeed" description="&quot;= true: use automatic local seed, otherwise use fixedLocalSeed&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="choices">
            <modifications expression="true" elementName="checkBox"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Initialization&quot;" elementName="group"/>
            <modifications expression="enableNoise" elementName="enable"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
        <component_list expression="1" declarationName="fixedLocalSeed" description="&quot;Local seed (any Integer number)&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Initialization&quot;" elementName="group"/>
            <modifications expression="enableNoise and not useAutomaticLocalSeed" elementName="enable"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
        <component_list expression="0.0" declarationName="startTime" description="&quot;Start time for sampling the raw random numbers&quot;" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Dialog">
            <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
            <modifications expression="&quot;Initialization&quot;" elementName="group"/>
            <modifications expression="enableNoise" elementName="enable"/>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isfinal="true" isOver="true">
        <component_list isModificationOver="true" declarationName="localSeed" description="&quot;The actual localSeed&quot;">
          <modifications expression="false" elementName="fixed"/>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Noise.GlobalSeed" isProtected="true" isOuter="true" isOver="true">
        <component_list declarationName="globalSeed" description="&quot;Definition of global seed via inner/outer&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
        <component_list expression="if useGlobalSeed then globalSeed.seed else 0" declarationName="actualGlobalSeed" description="&quot;The global seed, which is actually used&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
        <component_list expression="enableNoise and globalSeed.enableNoise" declarationName="generateNoise" description="&quot;= true, if noise shall be generated, otherwise no noise&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" isOver="true">
        <component_list subscripts="[generator.nState]" declarationName="state" description="&quot;Internal state of random number generator&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="discrete" isOver="true">
        <component_list declarationName="r" description="&quot;Random number according to the desired distribution&quot;"/>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="discrete" isOver="true">
        <component_list declarationName="r_raw" description="&quot;Uniform random number in the range (0,1]&quot;"/>
      </elements>
      <elements xsi:type="mOloc:EquationSection" isInitial="true">
        <equations xsi:type="mOloc:SimpleEquation" left="localSeed" right="if useAutomaticLocalSeed then automaticLocalSeed(getInstanceName()) else fixedLocalSeed"/>
        <equations xsi:type="mOloc:SimpleEquation" left="pre(state)" right="generator.initialState(localSeed, actualGlobalSeed)"/>
        <equations xsi:type="mOloc:SimpleEquation" left="r_raw" right="generator.random(pre(state))"/>
      </elements>
      <elements xsi:type="mOloc:EquationSection">
        <equations xsi:type="mOloc:WhenEquation" condition="generateNoise and sample(startTime, samplePeriod)">
          <whenEquations xsi:type="mOloc:SimpleEquation" left="(r_raw, state)" right="generator.random(pre(state))"/>
        </equations>
        <equations xsi:type="mOloc:SimpleEquation" left="y" right="if not generateNoise or time &lt; startTime then y_off else r"/>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Icon">
          <modifications isModificationOver="true" elementName="coordinateSystem">
