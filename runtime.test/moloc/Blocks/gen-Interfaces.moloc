          <modifications expression="&quot;&lt;html>&lt;p>Block has one input and one output signalwhich are sampled due to the defined &lt;strong>samplePeriod&lt;/strong> parameter.See the base-class &lt;a href=\&quot;modelica://Modelica.Blocks.Interfaces.DiscreteBlock\&quot;>DiscreteBlock&lt;/a> for more information.&#xA;&lt;/p>&lt;/html>&quot;" elementName="info"/>
        </annotations>
