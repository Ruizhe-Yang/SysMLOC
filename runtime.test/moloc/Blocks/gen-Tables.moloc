      <elements xsi:type="mOloc:ComponentClause" isPure="true" classType="function" className="getTimeTableValueNoDer2" description="&quot;Interpolate 1-dim. table where first column is time (but do not provide a second derivative function)&quot;" isLongClassSpecifier="true" classNameEnd="getTimeTableValueNoDer2" isOver="true">
