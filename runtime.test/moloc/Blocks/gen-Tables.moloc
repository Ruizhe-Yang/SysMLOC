      <elements xsi:type="mOloc:ComponentClause" isPure="true" classType="function" className="getDerTimeTableValue" description="&quot;Derivative of interpolated 1-dim. table where first column is time&quot;" isLongClassSpecifier="true" classNameEnd="getDerTimeTableValue" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Types.ExternalCombiTimeTable" directionType="input" isOver="true">
          <component_list declarationName="tableID" description="&quot;External table object&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" directionType="input" isOver="true">
          <component_list declarationName="icol" description="&quot;Column number&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="input" isOver="true">
          <component_list declarationName="timeIn" description="&quot;(Scaled) time value&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="discrete" directionType="input" isOver="true">
          <component_list declarationName="nextTimeEvent" description="&quot;(Scaled) next time event in table&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="discrete" directionType="input" isOver="true">
          <component_list declarationName="pre_nextTimeEvent" description="&quot;Pre-value of (scaled) next time event in table&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="input" isOver="true">
          <component_list declarationName="der_timeIn" description="&quot;Derivative of (scaled) time value&quot;"/>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
