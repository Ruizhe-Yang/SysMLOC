          <annotations expression="&quot;modelica://Modelica/Resources/C-Sources&quot;" elementName="IncludeDirectory"/>
          <annotations expression="{&quot;ModelicaStandardTables&quot;, &quot;ModelicaIO&quot;, &quot;ModelicaMatIO&quot;, &quot;zlib&quot;}" elementName="Library"/>
        </elements>
