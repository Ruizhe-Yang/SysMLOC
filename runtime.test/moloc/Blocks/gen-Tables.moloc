        <elements xsi:type="mOloc:ExternalElement" isAnnotation="true" isAnnotationOver="true" language_specification="C" ref="y" refValue="ModelicaStandardTables_CombiTimeTable_getValue" expressionList="tableID, icol, timeIn, nextTimeEvent, pre_nextTimeEvent" isOver="true">
          <annotations expression="&quot;modelica://Modelica/Resources/C-Sources&quot;" elementName="IncludeDirectory"/>
          <annotations expression="{&quot;ModelicaStandardTables&quot;, &quot;ModelicaIO&quot;, &quot;ModelicaMatIO&quot;, &quot;zlib&quot;}" elementName="Library"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" expression="getDerTimeTableValueNoDer" elementName="derivative">
