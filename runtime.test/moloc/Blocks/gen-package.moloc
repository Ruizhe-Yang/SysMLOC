            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sources.BooleanConstant" isOver="true">
          <component_list declarationName="const" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
