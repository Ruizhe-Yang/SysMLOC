                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Nonlinear.SlewRateLimiter" isOver="true">
            <component_list isModificationOver="true" declarationName="slewRateLimiter" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="50" elementName="Rising"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-20,40},{-40,60}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Translational.Components.Mass" isOver="true">
            <component_list isModificationOver="true" declarationName="rodMass" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="3" elementName="m"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-4,-10},{16,10}}" elementName="extent"/>
