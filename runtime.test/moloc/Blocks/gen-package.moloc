            </equations>
            <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="elastoGap.flange_b" right="mass.flange_a">
              <annotations isModificationOver="true" elementName="Line">
                <modifications expression="{{42,0},{50,0}}" elementName="points"/>
