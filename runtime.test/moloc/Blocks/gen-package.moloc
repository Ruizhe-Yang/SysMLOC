              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{20,20},{80,40}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="experiment">
            <modifications expression="10" elementName="StopTime"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&lt;p>This simple example demonstrates the logical sources in&lt;a href=\&quot;modelica://Modelica.Blocks.Sources\&quot;>Modelica.Blocks.Sources&lt;/a> and demonstrate&#xA;their diagram animation (see \&quot;small circle\&quot; close to the output connector).The \&quot;booleanExpression\&quot; source shows how a logical expression can be definedin its parameter menu referring to variables available on this level of themodel.&lt;/p>&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:ComponentClause" classType="model" className="LogicalNetwork1" description="&quot;Demonstrates the usage of logical blocks&quot;" isLongClassSpecifier="true" classNameEnd="LogicalNetwork1" isOver="true">
