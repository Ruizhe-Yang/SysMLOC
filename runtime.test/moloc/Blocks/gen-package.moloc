              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:EquationSection">
            <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="controller.y1" right="motor.iq_rms1">
