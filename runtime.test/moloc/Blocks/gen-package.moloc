            </equations>
            <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="motor.flange" right="gearbox.flange_a">
              <annotations isModificationOver="true" elementName="Line">
                <modifications expression="{{-66,0},{-60,0}}" elementName="points"/>
