              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Translational.Components.SpringDamper" isOver="true">
            <component_list isModificationOver="true" declarationName="elastoGap" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="1e8" elementName="c"/>
              <modifications expression="1e5" elementName="d"/>
              <modifications isModificationOver="true" elementName="v_rel">
                <modifications expression="true" elementName="fixed"/>
              </modifications>
              <modifications isModificationOver="true" elementName="s_rel">
                <modifications expression="true" elementName="fixed"/>
              </modifications>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{22,-10},{42,10}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
