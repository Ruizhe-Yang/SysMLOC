            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="integerStep.y" right="add.u[2]">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-39,40},{-28,40},{-28,67.9},{-14,67.9}}" elementName="points"/>
              <modifications expression="{0,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="add.y" right="showValue.numberPort">
            <annotations isModificationOver="true" elementName="Line">
