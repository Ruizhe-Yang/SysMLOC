          <elements xsi:type="mOloc:ComponentClause" typeSpecifier=".Modelica.Blocks.Noise.GlobalSeed" isInner="true" isOver="true">
            <component_list isModificationOver="true" declarationName="globalSeed" isAnnotation="true" isAnnotationOver="true">
