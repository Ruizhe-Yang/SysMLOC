          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="product.y" right="showValue1.numberPort">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{19.02,30},{62.5,30}}" elementName="points"/>
              <modifications expression="{0,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="add.y" right="linearDependency1.u1">
