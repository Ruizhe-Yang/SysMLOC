          <elements xsi:type="mOloc:ComponentClause" isExpandable="true" classType="connector" className="ControlBus" description="&quot;Control bus that is adapted to the signals connected to it&quot;" isLongClassSpecifier="true" classNameEnd="ControlBus" isOver="true">
