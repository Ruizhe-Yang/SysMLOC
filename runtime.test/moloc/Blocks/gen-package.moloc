      <elements xsi:type="mOloc:ComponentClause" classType="model" className="RealNetwork1" description="&quot;Demonstrates the usage of blocks from Modelica.Blocks.Math&quot;" isLongClassSpecifier="true" classNameEnd="RealNetwork1" isOver="true">
