              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sources.BooleanPulse" isOver="true">
          <component_list isModificationOver="true" declarationName="pulse" isAnnotation="true" isAnnotationOver="true">
            <modifications expression="1.5" elementName="period"/>
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{-60,-20},{-40,0}}" elementName="extent"/>
