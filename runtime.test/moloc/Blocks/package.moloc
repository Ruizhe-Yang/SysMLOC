            </elements>
            <elements xsi:type="mOloc:AnnotationClause">
              <arguments elementName="Documentation">
                <arguments expression="&quot;&lt;html>&#xA;&lt;table border=\&quot;1\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;>&#xA;&lt;tr>&lt;th>Date&lt;/th> &lt;th align=\&quot;left\&quot;>Description&lt;/th>&lt;/tr>&#xA;&#xA;&lt;tr>&lt;td> June 22, 2015 &lt;/td>&#xA;    &lt;td>&#xA;&#xA;&lt;table border=\&quot;0\&quot;>&#xA;&lt;tr>&lt;td>&#xA;         &lt;img src=\&quot;modelica://Modelica/Resources/Images/Logos/dlr_logo.png\&quot; alt=\&quot;DLR logo\&quot;>&#xA;&lt;/td>&lt;td valign=\&quot;bottom\&quot;>&#xA;         Initial version implemented by&#xA;         A. Kl&amp;ouml;ckner, F. v.d. Linden, D. Zimmer, M. Otter.&lt;br>&#xA;         &lt;a href=\&quot;http://www.dlr.de/rmc/sr/en\&quot;>DLR Institute of System Dynamics and Control&lt;/a>&#xA;&lt;/td>&lt;/tr>&lt;/table>&#xA;&lt;/td>&lt;/tr>&#xA;&#xA;&lt;/table>&#xA;&lt;/html>&quot;" elementName="revisions"/>
                <arguments expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Parts used in the&#xA;&lt;a href=\&quot;modelica://Modelica.Blocks.Examples.Noise.ActuatorWithNoise\&quot;>Examples.Noise.ActuatorWithNoise&lt;/a>&#xA;actuator example&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
              </arguments>
