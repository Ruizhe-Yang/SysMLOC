                <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="dqToThreePhase.y" right="signalCurrent.i">
                  <arguments elementName="Line">
                    <arguments expression="{{ -29,50} ,{-22,50},{-22,50} }" elementName="points"/>
