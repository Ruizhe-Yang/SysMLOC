                    <arguments expression="{0,0,255}" elementName="color"/>
                  </arguments>
                </equations>
                <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="smpm.flange" right="rotorDisplacementAngle.flange">
                  <arguments elementName="Line">
                    <arguments expression="{{0,-40},{6,-40},{10,-40}}" elementName="points"/>
                  </arguments>
                </equations>
                <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="signalCurrent.plug_p" right="star.plug_p">
