              </elements>
              <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter">
                <component_list expression="1.2" declarationName="tStep" description="&quot;Time of load torque step&quot;"/>
              </elements>
              <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Inertia" parameterType="parameter">
                <component_list expression="0.29" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
              </elements>
              <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Machines.BasicMachines.SynchronousMachines.SM_PermanentMagnet">
