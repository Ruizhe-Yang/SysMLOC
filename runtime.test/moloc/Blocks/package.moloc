                  <arguments expression="smpmData.Lssigma" elementName="Lssigma"/>
                  <arguments expression="smpmData.Jr" elementName="Jr"/>
                  <arguments expression="smpmData.Js" elementName="Js"/>
                  <arguments expression="smpmData.frictionParameters" elementName="frictionParameters"/>
                  <arguments elementName="wMechanical">
                    <arguments expression="true" elementName="fixed"/>
                  </arguments>
                  <arguments expression="smpmData.statorCoreParameters" elementName="statorCoreParameters"/>
                  <arguments expression="smpmData.strayLoadParameters" elementName="strayLoadParameters"/>
                  <arguments expression="smpmData.VsOpenCircuit" elementName="VsOpenCircuit"/>
                  <arguments expression="smpmData.Lmd" elementName="Lmd"/>
                  <arguments expression="smpmData.Lmq" elementName="Lmq"/>
                  <arguments expression="smpmData.useDamperCage" elementName="useDamperCage"/>
                  <arguments expression="smpmData.Lrsigmad" elementName="Lrsigmad"/>
                  <arguments expression="smpmData.Lrsigmaq" elementName="Lrsigmaq"/>
                  <arguments expression="smpmData.Rrd" elementName="Rrd"/>
                  <arguments expression="smpmData.Rrq" elementName="Rrq"/>
                  <arguments expression="smpmData.TrRef" elementName="TrRef"/>
                  <arguments expression="smpmData.permanentMagnetLossParameters" elementName="permanentMagnetLossParameters"/>
                  <arguments elementName="phiMechanical">
                    <arguments expression="true" elementName="fixed"/>
                  </arguments>
                  <arguments expression="293.15" elementName="TsOperational"/>
                  <arguments expression="smpmData.alpha20s" elementName="alpha20s"/>
                  <arguments expression="293.15" elementName="TrOperational"/>
                  <arguments expression="smpmData.alpha20r" elementName="alpha20r"/>
                  <arguments elementName="Placement">
                    <arguments elementName="transformation">
                      <arguments expression="{{-20,-50},{0,-30}}" elementName="extent"/>
                    </arguments>
