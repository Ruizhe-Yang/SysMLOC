            </elements>
            <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Velocity">
              <component_list declarationName="realSignal2" description="&quot;Second Real signal&quot;" isAnnotation="true">
                <arguments expression="false" elementName="HideResult"/>
              </component_list>
            </elements>
            <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer">
              <component_list declarationName="integerSignal" description="&quot;Integer signal&quot;" isAnnotation="true">
                <arguments expression="false" elementName="HideResult"/>
