      <elements xsi:type="mOloc:GeneralClause" classType="package" className="BusUsage_Utilities" description="&quot;Utility models and connectors for example Modelica.Blocks.Examples.BusUsage&quot;" classNameEnd="BusUsage_Utilities">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.UtilitiesPackage"/>
        <elements xsi:type="mOloc:GeneralClause" classType="package" className="Interfaces" description="&quot;Interfaces specialised for this example&quot;" classNameEnd="Interfaces">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InterfacesPackage"/>
          <elements xsi:type="mOloc:GeneralClause" isExpandable="true" classType="connector" className="ControlBus" description="&quot;Control bus that is adapted to the signals connected to it&quot;" classNameEnd="ControlBus">
            <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.SignalBus"/>
