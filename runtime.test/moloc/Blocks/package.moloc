          <elements xsi:type="mOloc:AnnotationClause">
            <arguments elementName="Documentation">
              <arguments expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This package contains the bus definitions needed for the&#xA;&lt;a href=\&quot;modelica://Modelica.Blocks.Examples.BusUsage\&quot;>BusUsage&lt;/a> example.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </arguments>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="model" className="Part" description="&quot;Component with sub-control bus&quot;" classNameEnd="Part">
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.SubControlBus">
            <component_list declarationName="subControlBus" isAnnotation="true">
              <arguments elementName="Placement">
                <arguments elementName="transformation">
                  <arguments expression="{100,0}" elementName="origin"/>
                  <arguments expression="{{-20,-20},{20,20}}" elementName="extent"/>
                  <arguments expression="270" elementName="rotation"/>
                </arguments>
              </arguments>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Sources.RealExpression">
            <component_list declarationName="realExpression" isAnnotation="true">
              <arguments expression="time" elementName="y"/>
              <arguments elementName="Placement">
                <arguments elementName="transformation">
                  <arguments expression="{{-6,0},{20,20}}" elementName="extent"/>
                </arguments>
              </arguments>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Sources.BooleanExpression">
            <component_list declarationName="booleanExpression" isAnnotation="true">
              <arguments expression="time >= 0.5" elementName="y"/>
              <arguments elementName="Placement">
                <arguments elementName="transformation">
                  <arguments expression="{{-6,-30},{20,-10}}" elementName="extent"/>
                </arguments>
              </arguments>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:EquationSection">
            <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="realExpression.y" right="subControlBus.myRealSignal">
              <arguments elementName="Line">
                <arguments expression="{{21.3,10},{88,10},{88,6},{98,6},{98,0},{100,0}}" elementName="points"/>
                <arguments expression="{0,0,127}" elementName="color"/>
              </arguments>
            </equations>
            <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" left="booleanExpression.y" right="subControlBus.myBooleanSignal">
              <arguments elementName="Line">
                <arguments expression="{{21.3,-20},{60,-20},{60,0},{100,0}}" elementName="points"/>
                <arguments expression="{255,0,255}" elementName="color"/>
              </arguments>
            </equations>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause">
            <arguments elementName="Icon">
              <arguments elementName="coordinateSystem">
                <arguments expression="true" elementName="preserveAspectRatio"/>
