<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.ComplexMath">
  <classes classType="block" className="Gain" description="&quot;Output the product of a gain value with the input signal&quot;" isLongClassSpecifier="true" classNameEnd="Gain" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="k" description="&quot;Gain value multiplied with input signal&quot;">
        <modifications isModificationOver="true" elementName="re">
          <modifications expression="1" elementName="start"/>
        </modifications>
        <modifications isModificationOver="true" elementName="im">
          <modifications expression="0" elementName="start"/>
        </modifications>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list expression="false" declarationName="useConjugateInput" description="&quot;If true, input is processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.ComplexInput" isOver="true">
      <component_list declarationName="u" description="&quot;Input signal connector&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.ComplexOutput" isOver="true">
      <component_list declarationName="y" description="&quot;Output signal connector&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="k*(if useConjugateInput then Modelica.ComplexMath.conj(u) else u)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This block computes output &lt;code>y&lt;/code> as&#xA;&lt;em>product&lt;/em> of gain &lt;code>k&lt;/code> with the&#xA;input &lt;code>u&lt;/code>. Optionally, the input &lt;code>u&lt;/code> can be processed conjugate complex, when parameter &lt;code>useConjugateInput&lt;/code> is &lt;code>true&lt;/code>. Depending on &lt;code>useConjugateInput&lt;/code> either the original or the conjugate complex input signal are processed.&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;y = k * (if useConjugateInput then Modelica.ComplexMath.conj(u) else u);&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;p>&lt;strong>Example:&lt;/strong> If &lt;code>useConjugateInput = true&lt;/code> and &lt;code>k = 2&lt;/code> the output signal &lt;code>y = 2 * Modelica.ComplexMath.conj(u)&lt;/code>.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Polygon( points={{-100,-100},{-100,100},{100,0},{-100,-100}}, lineColor={85,170,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Text( extent={{-150,-140},{150,-100}}, textString=&quot;k=%k&quot; ) ,Text( extent={{-150,140},{150,100}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
