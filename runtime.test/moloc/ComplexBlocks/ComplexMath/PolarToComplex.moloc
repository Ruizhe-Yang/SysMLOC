<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.ComplexMath">
  <classes classType="block" className="PolarToComplex" description="&quot;Converts polar representation to complex&quot;" isLongClassSpecifier="true" classNameEnd="PolarToComplex" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSO" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Blocks.Interfaces.RealInput" isOver="true">
      <component_list declarationName="len" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-140,40}, {-100,80} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="phi" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;rad&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-80},{-100,-40}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-140, -80 } ,{-100,-40} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="Complex(len*cos(phi), len*sin(phi))"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Text( extent={{-100,80},{-20,40}}, textColor={0,0,127}, textString=&quot;len&quot; ) ,Text( extent={{-100,-40},{-20,-80}}, textColor={0,0,127}, textString=&quot;phi&quot; ) ,Polygon( points={{20,0},{0,20},{0,10},{-30,10},{-30,-10},{0,-10},{0,-20}, {20,0} } , lineColor={0,128,255}, fillColor={85,170,255}, fillPattern=FillPattern.Solid ) ,Text( extent={{20,60},{100,-60}}, textColor={85,170,255}, textString=&quot;C&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Converts the Real inputs &lt;em>len&lt;/em> (length, absolute) and &lt;em>phi&lt;/em> (angle, argument) to the Complex output &lt;em>y&lt;/em>.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
