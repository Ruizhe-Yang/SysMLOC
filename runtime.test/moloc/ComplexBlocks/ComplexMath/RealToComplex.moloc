<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.ComplexMath">
  <classes classType="block" className="RealToComplex" description="&quot;Converts Cartesian representation to complex&quot;" classNameEnd="RealToComplex">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSO"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Blocks.Interfaces.RealInput">
      <component_list declarationName="re" isAnnotation="true">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </arguments>
          <arguments elementName="iconTransformation">
            <arguments expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Blocks.Interfaces.RealInput">
      <component_list declarationName="im" isAnnotation="true">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-140,-80},{-100,-40}}" elementName="extent"/>
          </arguments>
          <arguments elementName="iconTransformation">
            <arguments expression="{{-140, -80 } ,{-100,-40} }" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="Complex(re, im)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause">
      <arguments elementName="Icon">
        <arguments expression="{Text( extent={{-100,80},{-20,40}}, textColor={0,0,127}, textString=&quot;re&quot; ) ,Text( extent={{-100,-40},{-20,-80}}, textColor={0,0,127}, textString=&quot;im&quot; ) ,Polygon( points={{20,0},{0,20},{0,10},{-30,10},{-30,-10},{0,-10},{0,-20}, {20,0} } , lineColor={0,128,255}, fillColor={85,170,255}, fillPattern=FillPattern.Solid ) ,Text( extent={{20,60},{100,-60}}, textColor={85,170,255}, textString=&quot;C&quot; ) }" elementName="graphics"/>
      </arguments>
      <arguments elementName="Documentation">
        <arguments expression="&quot;&lt;html>&#xA;&lt;p>Converts the Real inputs &lt;em>re&lt;/em> (real part) and &lt;em>im&lt;/em> (imaginary part) to the Complex output &lt;em>y&lt;/em>.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </arguments>
    </elements>
  </classes>
</mOloc:Stored_definition>
