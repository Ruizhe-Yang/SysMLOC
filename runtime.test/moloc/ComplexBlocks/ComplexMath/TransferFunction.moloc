<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.ComplexMath">
  <classes classType="block" className="TransferFunction" description="&quot;Complex Transfer Function&quot;" classNameEnd="TransferFunction">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSISO"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.j"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter">
      <component_list subscripts="[:]" expression="{1}" declarationName="b" description="&quot;Numerator coefficients of transfer function (e.g., 2*s+3 is specified as {2,3})&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter">
      <component_list subscripts="[:]" expression="{1}" declarationName="a" description="&quot;Denominator coefficients of transfer function (e.g., 5*s+6 is specified as {5,6})&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput">
      <component_list declarationName="w" description="&quot;Angular frequency input&quot;" isAnnotation="true">
        <modifications expression="&quot;rad/s&quot;" elementName="unit"/>
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" isProtected="true">
      <component_list subscripts="[size(b,1)]" declarationName="bw"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex">
      <component_list subscripts="[size(a,1)]" declarationName="aw"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex">
      <component_list declarationName="bSum"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex">
      <component_list declarationName="aSum"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="bw" right="{b[i]*(j*w)^(i-1) for i in 1:size(b,1)}"/>
      <equations xsi:type="mOloc:SimpleEquation" left="aw" right="{a[i]*(j*w)^(i-1) for i in 1:size(a,1)}"/>
      <equations xsi:type="mOloc:SimpleEquation" left="bSum" right="Complex(sum(bw.re), sum(bw.im))"/>
      <equations xsi:type="mOloc:SimpleEquation" left="aSum" right="Complex(sum(aw.re), sum(aw.im))"/>
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="u*bSum/aSum"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true">
      <annotations elementName="Icon">
        <modifications expression="{ Text( textColor={85,170,255}, extent={{-90,10},{90,90}}, textString=&quot;b(jw)&quot; ) , Line(points={{-80,0},{80,0}}, color={85,170,255} ) , Text( textColor={85,170,255}, extent={{-90,-90},{90,-10}}, textString=&quot;a(jw)&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;The complex input u is multiplied by the complex transfer function (depending on the angular frequency input w) to obtain the complex output y (nb = dimension of b, na = dimension of a):&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;        b[1]*(jw)^[nb-1] + b[2]*(jw)^[nb-2] + ... + b[nb]&#xA;y(jw) = ------------------------------------------------- * u(jw)&#xA;        a[1]*(jw)^[na-1] + a[2]*(jw)^[na-2] + ... + a[na]&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
