<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.ComplexBlocks.ComplexMath"/>
  <classes classType="block" className="Conj" description="&quot;Output is equal to the conjugate complex input signal&quot;" isLongClassSpecifier="true" classNameEnd="Conj" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSISO" isOver="true">
      <extendsModifications expression="true" elementName="useConjugateInput" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="uInternal"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This block computes output &lt;code>y&lt;/code> as&lt;em>conjugate complex&lt;/em> input &lt;code>u&lt;/code>.&lt;/p>&lt;blockquote>&lt;pre>y = Modelica.ComplexMath.conj(u)&lt;/pre>&lt;/blockquote>&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line( points={{-40,0},{40,0}}, color={85,170,255} ) , Line( points={{-40,0},{40,0}}, color={85,170,255}, rotation=60 ) ,Line( points={{-40,0},{40,0}}, color={85,170,255}, rotation=120 ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
