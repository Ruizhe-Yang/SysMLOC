<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.ComplexBlocks.ComplexMath"/>
  <classes classType="block" className="Sum" description="&quot;Output the sum of the elements of the input vector&quot;" isLongClassSpecifier="true" classNameEnd="Sum" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.ComplexMISO" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Complex" parameterType="parameter" isOver="true">
      <component_list subscripts="[nin]" expression="fill(Complex(1, 0), nin)" declarationName="k" description="&quot;Optional: sum coefficients&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="k*uInternal"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;sum1&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This blocks computes output &lt;code>y&lt;/code> as&lt;em>sum&lt;/em> of the elements of the input signal vector&lt;code>u&lt;/code>:&lt;/p>&lt;blockquote>&lt;pre>y = u[1] + u[2] + ...;&#xA;&lt;/pre>&lt;/blockquote>&lt;p>Example:&lt;/p>&lt;blockquote>&lt;pre> parameter: nin = 3;&#xA;results in the following equations: y = u[1] + u[2] + u[3];&#xA;&lt;/pre>&lt;/blockquote>&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line( points={{26,42},{-34,42},{6,2},{-34,-38},{26,-38}}, color={85, 170,255 } ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
