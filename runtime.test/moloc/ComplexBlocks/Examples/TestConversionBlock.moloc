<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.Examples">
  <classes classType="model" className="TestConversionBlock" description="&quot;Test the conversion blocks&quot;">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Sources.Ramp">
      <component_list declarationName="len">
        <arguments expression="1" elementName="duration"/>
        <arguments expression="1E-6" elementName="offset"/>
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-80,10},{-60,30}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Sources.Ramp">
      <component_list declarationName="phi">
        <arguments expression="4*Modelica.Constants.pi" elementName="height"/>
        <arguments expression="1" elementName="duration"/>
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-80,-30},{-60,-10}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.ComplexBlocks.ComplexMath.PolarToComplex">
      <component_list declarationName="polarToComplex">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-40,-10},{-20,10}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.ComplexBlocks.ComplexMath.ComplexToReal">
      <component_list declarationName="complexToReal">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{0,-10},{20,10}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" left="phi.y" right="polarToComplex.phi">
        <arguments elementName="Line">
          <arguments expression="{{-59,-20},{-50, -20 } ,{-50,-6},{-46,-6},{-42,-6} }" elementName="points"/>
          <arguments expression="{0,0,127}" elementName="color"/>
        </arguments>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" left="len.y" right="polarToComplex.len">
        <arguments elementName="Line">
          <arguments expression="{{-59,20},{-50,20},{-50,6},{-42,6}}" elementName="points"/>
          <arguments expression="{0,0,127}" elementName="color"/>
        </arguments>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" left="polarToComplex.y" right="complexToReal.u">
        <arguments elementName="Line">
          <arguments expression="{{-19,0},{-2,0}}" elementName="points"/>
          <arguments expression="{85,170,255}" elementName="color"/>
        </arguments>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause">
      <arguments elementName="Documentation">
        <arguments expression="&quot;&lt;html>&#xA;&lt;p>A Complex signal is defined by its length and angle, both linearly rising with time.&#xA;Plotting the imaginary part versus the real part, you will see an Archimedean spiral.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </arguments>
      <arguments elementName="experiment">
        <arguments expression="1.01" elementName="StopTime"/>
        <arguments expression="0.001" elementName="Interval"/>
      </arguments>
    </elements>
  </classes>
</mOloc:Stored_definition>
