<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.ComplexBlocks.Examples"/>
  <classes classType="model" className="ShowTransferFunction" description="&quot;Test Complex Transfer Function Block&quot;" isLongClassSpecifier="true" classNameEnd="ShowTransferFunction" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="1/sqrt(2)" declarationName="d" description="&quot;Damping coefficient&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[:]" expression="{1}" declarationName="b" description="&quot;Numerator polynomial coefficients of the transfer function&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[:]" expression="{1,2*d,1}" declarationName="a" description="&quot;Denominator polynomial coefficients of the transfer function&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="0.01" declarationName="wMin" description="&quot;Lower bound for frequency sweep&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="wMax" description="&quot;Upper bound for frequency sweep&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list expression="log10(logFrequencySweep.y)" declarationName="lg_w" description="&quot;Logarithm of frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list expression="20*log10(complexToPolar.len)" declarationName="dB" description="&quot;Magnitude of the transfer function in decibel&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Units.SI.Angle" isOver="true">
      <component_list isModificationOver="true" expression="complexToPolar.phi" declarationName="phi" description="&quot;Argument of the transfer function&quot;">
        <modifications expression="&quot;deg&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.LogFrequencySweep" isOver="true">
      <component_list isModificationOver="true" declarationName="logFrequencySweep" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="duration"/>
        <modifications expression="wMin" elementName="wMin"/>
        <modifications expression="wMax" elementName="wMax"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80,-40},{-60,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.Sources.ComplexConstant" isOver="true">
      <component_list isModificationOver="true" declarationName="const" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="k">
          <modifications expression="1" elementName="re"/>
          <modifications expression="0" elementName="im"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80,-10},{-60,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.ComplexMath.TransferFunction" isOver="true">
      <component_list isModificationOver="true" declarationName="transferFunction" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="b" elementName="b"/>
        <modifications expression="a" elementName="a"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-40,-10},{-20,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.ComplexMath.ComplexToPolar" isOver="true">
      <component_list declarationName="complexToPolar" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-10},{20,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="const.y" right="transferFunction.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-59,0},{-50.5,0},{-42,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="logFrequencySweep.y" right="transferFunction.w">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-59,-30},{-30,-30},{-30,-12}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transferFunction.y" right="complexToPolar.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-19,0},{-2,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="1" elementName="StopTime"/>
        <modifications expression="0.001" elementName="Interval"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This example shows the response of a PT2 defined by its transfer function&lt;/p>&lt;blockquote>&lt;pre> 1H(jw)=------------------- 1 + 2 d jw + (jw)^2&lt;/pre>&lt;/blockquote>&lt;p>Frequency performs a logarithmic ramp from 0.01 to 100 s^-1.&lt;/p>&lt;p>Plot the magnitude locus (in dB) dB versus lg_w and the phase locus versus lg_w.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
