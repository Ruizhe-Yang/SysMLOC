<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.Interfaces">
  <classes isPartial="true" classType="block" className="ComplexMI2MO" description="&quot;2 Multiple Input / Multiple Output continuous control block&quot;" classNameEnd="ComplexMI2MO">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Icons.ComplexBlock"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter">
      <component_list expression="1" declarationName="n" description="&quot;Dimension of input and output vectors.&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput">
      <component_list subscripts="[n]" declarationName="u1" description="&quot;Connector 1 of Complex input signals&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput">
      <component_list subscripts="[n]" declarationName="u2" description="&quot;Connector 2 of Complex input signals&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{-140,-80},{-100,-40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexOutput">
      <component_list subscripts="[n]" declarationName="y" description="&quot;Connector of Complex output signals&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter">
      <component_list subscripts="[n]" expression="fill(false, n)" declarationName="useConjugateInput1" description="&quot;If true, inputs 1 are processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter">
      <component_list subscripts="[n]" expression="fill(false, n)" declarationName="useConjugateInput2" description="&quot;If true, inputs 2 are processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" isProtected="true">
      <component_list subscripts="[n]" expression="{if useConjugateInput1[k] then Modelica.ComplexMath.conj(u1[k]) else u1[k] for k in 1:n }" declarationName="u1Internal" description="&quot;Equals either u1 or conjugate complex input u1 if useComplexInput = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex">
      <component_list subscripts="[n]" expression="{if useConjugateInput2[k] then Modelica.ComplexMath.conj(u2[k]) else u2[k] for k in 1:n }" declarationName="u2Internal" description="&quot;Equals either u1 or conjugate complex input u1 if useComplexInput = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true">
      <annotations elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Block has two continuous Complex input vectors u1 and u2 and one&#xA;continuous Complex output vector y.&#xA;All vectors have the same number of elements.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
