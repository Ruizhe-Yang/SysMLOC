<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.Interfaces">
  <classes isPartial="true" classType="block" className="ComplexMIMOs" description="&quot;Multiple Input Multiple Output continuous control block with same number of inputs and outputs&quot;" classNameEnd="ComplexMIMOs">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Icons.ComplexBlock"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter">
      <component_list expression="1" declarationName="n" description="&quot;Number of inputs (= number of outputs)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput">
      <component_list subscripts="[n]" declarationName="u" description="&quot;Connector of Complex input signals&quot;" isAnnotation="true">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexOutput">
      <component_list subscripts="[n]" declarationName="y" description="&quot;Connector of Complex output signals&quot;" isAnnotation="true">
        <arguments elementName="Placement">
          <arguments elementName="transformation">
            <arguments expression="{{100,-10},{120,10}}" elementName="extent"/>
          </arguments>
        </arguments>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter">
      <component_list subscripts="[n]" expression="fill(false, n)" declarationName="useConjugateInput" description="&quot;If true, inputs are processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" isProtected="true">
      <component_list subscripts="[n]" expression="{if useConjugateInput[k] then Modelica.ComplexMath.conj(u[k]) else u[k] for k in 1:n }" declarationName="uInternal" description="&quot;Equals either u or conjugate complex input u if useComplexInput = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause">
      <arguments elementName="Documentation">
        <arguments expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Block has a continuous Complex input vector and a continuous Complex output signal vector&#xA;where the signal sizes of the input and output vector are identical.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </arguments>
    </elements>
  </classes>
</mOloc:Stored_definition>
