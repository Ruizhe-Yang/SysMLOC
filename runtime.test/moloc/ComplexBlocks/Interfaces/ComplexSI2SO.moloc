<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.Interfaces">
  <classes isPartial="true" classType="block" className="ComplexSI2SO" description="&quot;2 Single Input / 1 Single Output continuous control block&quot;" classNameEnd="ComplexSI2SO">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Icons.ComplexBlock"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput">
      <component_list declarationName="u1" description="&quot;Connector of Complex input signal 1&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput">
      <component_list declarationName="u2" description="&quot;Connector of Complex input signal 2&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{-140,-80},{-100,-40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexOutput">
      <component_list declarationName="y" description="&quot;Connector of Complex output signal&quot;" isAnnotation="true">
        <annotations elementName="Placement">
          <modifications elementName="transformation">
            <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter">
      <component_list expression="false" declarationName="useConjugateInput1" description="&quot;If true, input 1 is processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter">
      <component_list expression="false" declarationName="useConjugateInput2" description="&quot;If true, input 2 is processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" isProtected="true">
      <component_list expression="(if useConjugateInput1 then Modelica.ComplexMath.conj( u1) else u1 )" declarationName="u1Internal" description="&quot;Equals either u1 or conjugate complex input u1 if useComplexInput1 = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex">
      <component_list expression="(if useConjugateInput2 then Modelica.ComplexMath.conj( u2) else u2 )" declarationName="u2Internal" description="&quot;Equals either u2 or conjugate complex input u2 if useComplexInput2 = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true">
      <annotations elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Block has two continuous Complex input signals u1 and u2 and one&#xA;continuous Complex output signal y.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
