<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.ComplexBlocks.Interfaces">
  <classes isPartial="true" classType="block" className="ComplexSISO" description="&quot;Single Input Single Output continuous control block&quot;" isLongClassSpecifier="true" classNameEnd="ComplexSISO" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Icons.ComplexBlock" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexInput" isOver="true">
      <component_list declarationName="u" description="&quot;Connector of Complex input signal&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ComplexOutput" isOver="true">
      <component_list declarationName="y" description="&quot;Connector of Complex output signal&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list expression="false" declarationName="useConjugateInput" description="&quot;If true, input is processed conjugate complex&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Complex" isProtected="true" isOver="true">
      <component_list expression="(if useConjugateInput then Modelica.ComplexMath.conj(u) else u )" declarationName="uInternal" description="&quot;Equals either u or conjugate complex input u if useComplexInput = true&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Block has one continuous Complex input and one continuous Complex output signal.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
