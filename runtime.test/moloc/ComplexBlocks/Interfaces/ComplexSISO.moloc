<?xml version="1.0" encoding="ASCII"?>
<mOloc:StoredDefinition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" within="Modelica.ComplexBlocks.Interfaces">
  <classes name="ComplexSISO" str_comment="&quot;Single Input Single Output continuous control block&quot;" name_end="ComplexSISO">
    <composition>
      <priv_elist>
        <elem xsi:type="mOloc:ExtendsClause" name="Modelica.ComplexBlocks.Icons.ComplexBlock"/>
        <elem xsi:type="mOloc:ComponentClause">
          <type name="ComplexInput"/>
          <comps>
            <comps>
              <decl name="u"/>
              <comment comment="&quot;Connector of Complex input signal&quot;">
                <annotation isannotation="true">
                  <cm>
                    <args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
                        <element xsi:type="mOloc:ElementModification" name="Placement">
                          <mod>
                            <mod>
                              <args>
                                <args xsi:type="mOloc:ElementModicationOrReplaceable">
                                  <element xsi:type="mOloc:ElementModification" name="transformation">
                                    <mod>
                                      <mod>
                                        <args>
                                          <args xsi:type="mOloc:ElementModicationOrReplaceable">
                                            <element xsi:type="mOloc:ElementModification" name="extent">
                                              <mod dh="true">
                                                <expr xsi:type="mOloc:Primary">
                                                  <fa>
                                                    <express xsi:type="mOloc:Primary">
                                                      <fa>
                                                        <express xsi:type="mOloc:Negation" neg_op="-">
                                                          <term xsi:type="mOloc:FloatPrimary" val="140.0"/>
                                                        </express>
                                                        <argu>
                                                          <express xsi:type="mOloc:Negation" neg_op="-">
                                                            <term xsi:type="mOloc:FloatPrimary" val="20.0"/>
                                                          </express>
                                                        </argu>
                                                      </fa>
                                                    </express>
                                                    <argu>
                                                      <express xsi:type="mOloc:Primary">
                                                        <fa>
                                                          <express xsi:type="mOloc:Negation" neg_op="-">
                                                            <term xsi:type="mOloc:FloatPrimary" val="100.0"/>
                                                          </express>
                                                          <argu>
                                                            <express xsi:type="mOloc:FloatPrimary" val="20.0"/>
                                                          </argu>
                                                        </fa>
                                                      </express>
                                                    </argu>
                                                  </fa>
                                                </expr>
                                              </mod>
                                            </element>
                                          </args>
                                        </args>
                                      </mod>
                                    </mod>
                                  </element>
                                </args>
                              </args>
                            </mod>
                          </mod>
                        </element>
                      </args>
                    </args>
                  </cm>
                </annotation>
              </comment>
            </comps>
          </comps>
        </elem>
        <elem xsi:type="mOloc:ComponentClause">
          <type name="ComplexOutput"/>
          <comps>
            <comps>
              <decl name="y"/>
              <comment comment="&quot;Connector of Complex output signal&quot;">
                <annotation isannotation="true">
                  <cm>
                    <args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
                        <element xsi:type="mOloc:ElementModification" name="Placement">
                          <mod>
                            <mod>
                              <args>
                                <args xsi:type="mOloc:ElementModicationOrReplaceable">
                                  <element xsi:type="mOloc:ElementModification" name="transformation">
                                    <mod>
                                      <mod>
                                        <args>
                                          <args xsi:type="mOloc:ElementModicationOrReplaceable">
                                            <element xsi:type="mOloc:ElementModification" name="extent">
                                              <mod dh="true">
                                                <expr xsi:type="mOloc:Primary">
                                                  <fa>
                                                    <express xsi:type="mOloc:Primary">
                                                      <fa>
                                                        <express xsi:type="mOloc:FloatPrimary" val="100.0"/>
                                                        <argu>
                                                          <express xsi:type="mOloc:Negation" neg_op="-">
                                                            <term xsi:type="mOloc:FloatPrimary" val="10.0"/>
                                                          </express>
                                                        </argu>
                                                      </fa>
                                                    </express>
                                                    <argu>
                                                      <express xsi:type="mOloc:Primary">
                                                        <fa>
                                                          <express xsi:type="mOloc:FloatPrimary" val="120.0"/>
                                                          <argu>
                                                            <express xsi:type="mOloc:FloatPrimary" val="10.0"/>
                                                          </argu>
                                                        </fa>
                                                      </express>
                                                    </argu>
                                                  </fa>
                                                </expr>
                                              </mod>
                                            </element>
                                          </args>
                                        </args>
                                      </mod>
                                    </mod>
                                  </element>
                                </args>
                              </args>
                            </mod>
                          </mod>
                        </element>
                      </args>
                    </args>
                  </cm>
                </annotation>
              </comment>
            </comps>
          </comps>
        </elem>
        <elem xsi:type="mOloc:ComponentClause" prefix="parameter">
          <type name="Boolean"/>
          <comps>
            <comps>
              <decl name="useConjugateInput">
                <mod dh="true">
                  <expr xsi:type="mOloc:LogicalPrimary"/>
                </mod>
              </decl>
              <comment comment="&quot;If true, input is processed conjugate complex&quot;"/>
            </comps>
          </comps>
        </elem>
      </priv_elist>
      <protected_elist>
        <ele>
          <elem xsi:type="mOloc:ComponentClause">
            <type name="Complex"/>
            <comps>
              <comps>
                <decl name="uInternal">
                  <mod dh="true">
                    <expr xsi:type="mOloc:Primary">
                      <oe>
                        <exprs xsi:type="mOloc:IfExpression">
                          <if xsi:type="mOloc:ComponentReference">
                            <idents>useConjugateInput</idents>
                          </if>
                          <then xsi:type="mOloc:FunctionCall" comp_ref="Modelica.ComplexMath.conj">
                            <args>
                              <res>
                                <args xsi:type="mOloc:ComponentReference">
                                  <idents>u</idents>
                                </args>
                              </res>
                            </args>
                          </then>
                          <else xsi:type="mOloc:ComponentReference">
                            <idents>u</idents>
                          </else>
                        </exprs>
                      </oe>
                    </expr>
                  </mod>
                </decl>
                <comment comment="&quot;Equals either u or conjugate complex input u if useComplexInput = true&quot;"/>
              </comps>
            </comps>
          </elem>
        </ele>
      </protected_elist>
      <anno isannotation="true">
        <cm>
          <args>
            <args xsi:type="mOloc:ElementModicationOrReplaceable">
              <element xsi:type="mOloc:ElementModification" name="Documentation">
                <mod>
                  <mod>
                    <args>
                      <args xsi:type="mOloc:ElementModicationOrReplaceable">
                        <element xsi:type="mOloc:ElementModification" name="info">
                          <mod dh="true">
                            <expr xsi:type="mOloc:StringPrimary" val="&lt;html>&#xA;&lt;p>&#xA;Block has one continuous Complex input and one continuous Complex output signal.&#xA;&lt;/p>&#xA;&lt;/html>"/>
                          </mod>
                        </element>
                      </args>
                    </args>
                  </mod>
                </mod>
              </element>
            </args>
          </args>
        </cm>
      </anno>
    </composition>
    <cp isPartial="true" kind="block"/>
  </classes>
</mOloc:StoredDefinition>
