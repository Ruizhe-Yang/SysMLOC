<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.ComplexBlocks.Routing"/>
  <classes classType="block" className="Replicator" description="&quot;Signal replicator&quot;" isLongClassSpecifier="true" classNameEnd="Replicator" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSIMO" isOver="true"/>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="fill(u, nout)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{-100,0},{-6,0}}, color={85,170,255}), Line(points={{100,0},{10,0}}, color={85,170,255}), Line(points={{0,0},{100,10}}, color={85,170,255}), Line(points={{0,0},{100,-10}}, color={85,170,255}), Ellipse( extent={{-14,16},{16,-14}}, fillColor={85,170,255}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This block replicates the input signal to an array of &lt;code>nout&lt;/code> identical output signals.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
