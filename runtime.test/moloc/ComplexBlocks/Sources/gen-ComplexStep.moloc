<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.ComplexBlocks.Sources"/>
  <classes classType="block" className="ComplexStep" description="&quot;Generate step signal of type Complex&quot;" isLongClassSpecifier="true" classNameEnd="ComplexStep" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Complex" parameterType="parameter" isOver="true">
      <component_list expression="Complex(1)" declarationName="height" description="&quot;Height of step&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="ComplexBlocks.Interfaces.ComplexSignalSource" isOver="true"/>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="offset + (if time &lt; startTime then Complex(0) else height)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;complexStep&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{-80,68},{-80,-80}}, color={ 192,192,192} ) ,Polygon( points={{-80,90},{-88,68},{-72,68},{-80,90}}, lineColor={192,192,192}, fillColor={192,192,192}, fillPattern=FillPattern.Solid ) ,Line(points={{-90,-70},{82,-70}}, color={192,192,192} ) ,Polygon( points={{90,-70},{68,-62},{68,-78},{90,-70}}, lineColor={192,192,192}, fillColor={192,192,192}, fillPattern=FillPattern.Solid ) ,Line(points={{-80,-70},{0,-70}, {0,50},{80,50} } , color={85,170,255} ) , Text( extent={{-150,-150},{150,-110}}, textString=&quot;startTime=%startTime&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The Complex output y is a step signal (of real and imaginary part):&lt;/p>&lt;p>&lt;img src=\&quot;modelica://Modelica/Resources/Images/Blocks/Sources/Step.png\&quot;&#xA;alt=\&quot;Step.png\&quot;>&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
