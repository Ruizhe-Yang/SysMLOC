<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Basic"/>
  <classes classType="model" className="Capacitor" description="&quot;Ideal linear electrical capacitor&quot;" isLongClassSpecifier="true" classNameEnd="Capacitor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.OnePort" isOver="true">
      <extendsModifications isModificationOver="true" elementName="v">
        <modifications expression="0" elementName="start"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="C" description="&quot;Capacitance&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="i" right="C*der(v)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The linear capacitor connects the branch voltage &lt;em>v&lt;/em> with the branch current &lt;em>i&lt;/em> by &lt;em>i = C * dv/dt&lt;/em>. The Capacitance &lt;em>C&lt;/em> is allowed to be positive or zero.&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;ul>&lt;li>&lt;em> 1998 &lt;/em> by Christoph Clauss&lt;br> initially implemented&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{-6,28},{-6,-28}}, color={0,0,255}), Line(points={{6,28},{6,-28}}, color={0,0,255}), Line(points={{-90,0},{-6,0}}, color={0,0,255}), Line(points={{6,0},{90,0}}, color={0,0,255}), Text( extent={{-150,-40},{150,-80}}, textString=&quot;C=%C&quot; ) , Text( extent={{-150,90},{150,50}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
