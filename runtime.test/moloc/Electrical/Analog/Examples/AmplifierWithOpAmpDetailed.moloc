      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.p" right="sineVoltage.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-74,17},{-80,17},{-80,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
