          <modifications expression="{{-11.93,20.29},{18.035,20.29},{18.035,20},{48,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="opAmp.m_supply" right="constantVoltage1.p">
        <annotations isModificationOver="true" elementName="Line">
