    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0.003" elementName="StopTime"/>
        <modifications expression="1.2e-6" elementName="Interval"/>
        <modifications expression="2e-007" elementName="Tolerance"/>
