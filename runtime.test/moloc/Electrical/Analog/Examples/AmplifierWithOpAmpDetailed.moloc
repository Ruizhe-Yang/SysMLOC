          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{48,10},{68,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sources.ConstantVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="constantVoltage1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="-15" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{48,-10},{68,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="resistor2.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="opAmp.q_fp1" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="opAmp.q_fr1" right="0"/>
