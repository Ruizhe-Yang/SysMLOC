    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.n" right="opAmp.m">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-56,17},{-34,17},{-34,17.07},{-26.07,17.07}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
