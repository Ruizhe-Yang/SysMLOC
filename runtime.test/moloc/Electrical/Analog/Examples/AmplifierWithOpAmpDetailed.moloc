          <modifications expression="{{21,-32},{21,-40},{-10,-40},{-10,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="opAmp.p_supply" right="constantVoltage.p">
