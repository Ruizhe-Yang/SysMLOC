      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="conductor4.v2" right="voltageToCurrent4b.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{41,-52},{57,-52}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="conductor4.i2" right="voltageToCurrent4b.f">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{42,-68},{57,-68}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltage4.p" right="inductor4a.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,-50},{-40,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
