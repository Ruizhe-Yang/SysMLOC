          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-98,100},{-4,72}}, textColor={0,0,255}, textString=&quot;Heating \&quot;PNP NOR\&quot; Gate&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>The heating &amp;quot;PNP NOR&amp;quot; gate shows a heat flow always if a transistor is conducting.&lt;/p>&#xA;&lt;p>Simulate until T=200 s. Plot V1.v and V2.v and C2.v to see the NOR-functionality. High potential is -6V which means logic &amp;quot;true&amp;quot;. Low potential is 0V which means logic &amp;quot;false&amp;quot;.&lt;/p>&#xA;&lt;p>To see which transistor is conducting one can have a look at the temperatures T1.heatPort.T and T2.heatPort.T and the heat flows T1.heatPort.Q_flow and T2.heatPort.Q_flow of the heatports of the transistors T1 and T2.&lt;/p>&#xA;&lt;p>They are different from zero if the transistor is conducting.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;h4>Release Notes&lt;/h4>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>May 02, 2018&lt;/em> by Kristin Majetta and Christoph Clauss&lt;br>realized&lt;br>&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="200" elementName="StopTime"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
