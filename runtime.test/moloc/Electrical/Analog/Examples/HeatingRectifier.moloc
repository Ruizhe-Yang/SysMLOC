<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples"/>
  <classes classType="model" className="HeatingRectifier" description="&quot;Heating rectifier&quot;" isLongClassSpecifier="true" classNameEnd="HeatingRectifier" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Semiconductors.Diode" isOver="true">
      <component_list isModificationOver="true" declarationName="HeatingDiode1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="true" elementName="useTemperatureDependency"/>
        <modifications expression="true" elementName="useHeatPort"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,40},{0,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="G" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80,0},{-60,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="V"/>
        <modifications expression="1" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-70,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="Capacitor1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="0" elementName="start"/>
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,40},{40,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Components.HeatCapacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="HeatCapacitor1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="C"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,-50}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Components.ThermalConductor" isOver="true">
      <component_list isModificationOver="true" declarationName="ThermalConductor1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="10" elementName="G"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,-10}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,70},{40,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="HeatCapacitor1.T" right="293.15"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.p" right="HeatingDiode1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,50},{-20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.n" right="G.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,30},{-70,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Capacitor1.n" right="G.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,50},{40,20},{-70,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="HeatingDiode1.n" right="Capacitor1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,50},{20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="HeatingDiode1.heatPort" right="ThermalConductor1.port_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,40},{-10,0},{-20,0}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ThermalConductor1.port_b" right="HeatCapacitor1.port">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-20}, {-20,-25.75},{-20,-40} }" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R.p" right="Capacitor1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,80},{20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R.n" right="Capacitor1.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,80},{40,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-94,102},{0,74}}, textString=&quot;HeatingRectifier&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>The heating rectifier shows a heat flow always if the electrical capacitor is loaded.&lt;/p>&#xA;&lt;p>Simulate until T=5 s.Plot in separate windows:&#xA;&lt;br>SineVoltage1.v and Capacitor1.p.v&#xA;&lt;br>HeatCapacitor1.port.T and HeatingDiode1.heatPort.T&#xA;&lt;br>HeatingDiode1.heatPort.Q_flow&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&lt;strong>Release Notes:&lt;/strong>&lt;/p>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>Mai 6, 2004   &lt;/em>&#xA;       by Christoph Clauss&lt;br> realized&lt;br>&#xA;       &lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="5" elementName="StopTime"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
