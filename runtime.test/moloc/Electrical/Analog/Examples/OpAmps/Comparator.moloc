<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Examples.OpAmps">
  <classes classType="model" className="Comparator" description="&quot;Comparator&quot;" isLongClassSpecifier="true" classNameEnd="Comparator" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="+15" declarationName="Vps" description="&quot;Positive supply&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="-15" declarationName="Vns" description="&quot;Negative supply&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="5" declarationName="Vin" description="&quot;Amplitude of input voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="10" declarationName="f" description="&quot;Frequency of input voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="Vref" description="&quot;Reference voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="(Vref - Vns)/(Vps - Vns)" declarationName="k" description="&quot;Calculated potentiometer ratio to reach Vref&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1000" declarationName="R" description="&quot;Resistance of potentiometer&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealizedOpAmpLimited" isOver="true">
      <component_list isModificationOver="true" declarationName="opAmp" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Vps" elementName="Vps"/>
        <modifications expression="Vns" elementName="Vns"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,10},{20,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-100},{0,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sources.TrapezoidVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="vIn" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.2/f" elementName="rising"/>
        <modifications expression="0.3/f" elementName="width"/>
        <modifications expression="0.2/f" elementName="falling"/>
        <modifications expression="1/f" elementName="period"/>
        <modifications expression="-1" elementName="nperiod"/>
        <modifications expression="-(vIn.rising + vIn.width/2)" elementName="startTime"/>
        <modifications expression="2*Vin" elementName="V"/>
        <modifications expression="-Vin" elementName="offset"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="vOut" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{50,-20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Potentiometer" isOver="true">
      <component_list isModificationOver="true" declarationName="potentiometer" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="R" elementName="R"/>
        <modifications expression="k" elementName="rConstant"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="{-10,-30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SupplyVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="supplyVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Vps" elementName="Vps"/>
        <modifications expression="Vns" elementName="Vns"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{-10,-50}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vIn.p" right="opAmp.in_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,10},{-10,10},{-10,6},{0,6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="opAmp.out" right="vOut.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,0},{50,0},{50,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="vOut.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-80},{50,-80},{50,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="vIn.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-80},{-80,-80},{-80,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="potentiometer.contact" right="opAmp.in_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-20},{0,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="potentiometer.pin_p" right="supplyVoltage.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-30},{-20,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="potentiometer.pin_n" right="supplyVoltage.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-30},{0,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="supplyVoltage.ground">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-80},{-10,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This is a comparator. Resistance R1 can be chosen, resistance R2 is defined by the desired reference voltage Vref (between Vn and Vp). The output switches between Vn for input voltage &amp;lt; Vref and Vp for input voltage &amp;gt; Vref.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0" elementName="StartTime"/>
        <modifications expression="1" elementName="StopTime"/>
        <modifications expression="1e-006" elementName="Tolerance"/>
        <modifications expression="0.001" elementName="Interval"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
