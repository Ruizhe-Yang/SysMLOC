    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="OpAmpCircuits.Add" isOver="true">
      <component_list isModificationOver="true" declarationName="addA" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="i1_2">
          <modifications expression="0" elementName="start"/>
        </modifications>
        <modifications isModificationOver="true" elementName="r">
          <modifications isModificationOver="true" elementName="i">
            <modifications expression="0" elementName="start"/>
          </modifications>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
