      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="stepB.y" right="feedbackB. u1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-79,70},{-68,70}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="feedbackB.y" right="PIB. u">
