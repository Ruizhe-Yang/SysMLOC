<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Examples.OpAmps">
  <classes classType="model" className="ControlCircuit" description="&quot;Control circuit&quot;" isLongClassSpecifier="true" classNameEnd="ControlCircuit" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.01" declarationName="T1" description="&quot;Small time constant&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.01" declarationName="T2" description="&quot;Large time constant&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="T2" declarationName="Ti" description="&quot;Integral time constant&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="T2/(2*T1)" declarationName="kp" description="&quot;Proportional gain&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-100,-100},{-80,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Sources.StepVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="stepA" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="10" elementName="V"/>
        <modifications expression="0.1" elementName="startTime"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-90,-62}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="OpAmpCircuits.Feedback" isOver="true">
      <component_list isModificationOver="true" declarationName="feedbackA" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="p1">
          <modifications isModificationOver="true" elementName="i">
            <modifications expression="0" elementName="start"/>
          </modifications>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-40},{-50,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="OpAmpCircuits.PI" isOver="true">
      <component_list isModificationOver="true" declarationName="PIA" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="v2">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications expression="kp" elementName="k"/>
        <modifications expression="Ti" elementName="T"/>
        <modifications isModificationOver="true" elementName="opAmp">
          <modifications isModificationOver="true" elementName="v_in">
            <modifications expression="0" elementName="start"/>
          </modifications>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
