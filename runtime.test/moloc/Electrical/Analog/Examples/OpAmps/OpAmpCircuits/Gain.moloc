<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Examples.OpAmps.OpAmpCircuits">
  <classes classType="model" className="Gain" description="&quot;Inverting operational amplifier circuit&quot;" isLongClassSpecifier="true" classNameEnd="Gain" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PartialOpAmp" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="k" description="&quot;Desired amplification&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1000" declarationName="R1" description="&quot;Resistance at negative input of OpAmp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="k*R1" declarationName="R2" description="&quot;Calculated resistance to reach desired amplification k&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="r1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="R1" elementName="R" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,20},{-30,40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="r2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="R2" elementName="R" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{30,20},{10,40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="opAmp.out" right="r2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{30,0},{30,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="opAmp.out" right="p2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{80,0},{80,100},{100,100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="r1.n" right="opAmp.in_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,30},{-10,30},{-10,6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="r1.n" right="r2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,30},{10,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="r1.p" right="p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,30},{-80,30},{-80,100},{ -100,100} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="n1" right="opAmp.in_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,-100},{-10,-100},{-10,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="n1" right="n2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,-100},{100,-100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Inverting amplifier = gain, based on the &lt;a href=\&quot;modelica://Modelica.Electrical.Analog.Ideal.IdealizedOpAmpLimited\&quot;>IdealizedOpAmpLimited&lt;/a> model.&lt;/p>&#xA;&lt;p>&lt;code>vOut = -k*vIn&lt;/code>&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(points={{-80,78},{-80,-90}}, color={192,192,192}), Polygon( points={{-80,90},{-88,68},{-72,68},{-80,90}}, lineColor={192,192,192}, fillColor={192,192,192}, fillPattern=FillPattern.Solid ) , Polygon( points={{90,-80},{68,-72},{68,-88},{90,-80}}, lineColor={192,192,192}, fillColor={192,192,192}, fillPattern=FillPattern.Solid ) , Line(points={{-90,-80},{82,-80}}, color={192,192,192}), Line(points={{-80,-80},{-80,40},{60,40}}, color = {0,0,127} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
