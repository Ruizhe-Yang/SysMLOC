        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{40,-80},{60,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SignalCurrent" isOver="true">
      <component_list declarationName="SignalCurrent1" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{60,0}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Constant" isOver="true">
      <component_list isModificationOver="true" declarationName="Constant1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="IDC" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-10},{80,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="Capacitor1.v" right="VAC*sqrt(2)/2"/>
      <equations xsi:type="mOloc:SimpleEquation" left="Capacitor2.v" right="VAC*sqrt(2)/2"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="uDC" right="Capacitor1.v + Capacitor2.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="iAC" right="{Inductor1.i,Inductor2.i,Inductor3.i}"/>
      <equations xsi:type="mOloc:SimpleEquation" left="uAC[1]" right="Inductor1.n.v - Inductor2.n.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="uAC[2]" right="Inductor2.n.v - Inductor3.n.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="uAC[3]" right="Inductor3.n.v - Inductor1.n.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="Losses" right="IdealDiode1.v*IdealDiode1.i + IdealDiode2.v*IdealDiode2.i + IdealDiode3.v*IdealDiode3.i + IdealDiode4.v*IdealDiode4.i + IdealDiode5.v*IdealDiode5.i + IdealDiode6.v*IdealDiode6.i"/>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.n" right="SineVoltage2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,20},{-90,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage2.n" right="SineVoltage3.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,0},{-90,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.p" right="Inductor1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,20},{-60,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage2.p" right="Inductor2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,0},{-67.5,0},{-65,0},{-60,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage3.p" right="Inductor3.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,-20},{-60,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode1.p" right="IdealDiode4.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,30},{-20,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode2.p" right="IdealDiode5.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,30},{0,16},{0,0},{0,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode3.p" right="IdealDiode6.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,30},{20,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode1.n" right="IdealDiode2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,50},{0,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode2.n" right="IdealDiode3.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,50},{20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode4.p" right="IdealDiode5.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-50},{0,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode5.p" right="IdealDiode6.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-50},{20,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Capacitor2.n" right="IdealDiode6.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,-50},{20,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="IdealDiode3.n" right="Capacitor1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,50},{40,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Capacitor1.n" right="Capacitor2.p">
        <annotations isModificationOver="true" elementName="Line">
