<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples"/>
  <classes classType="model" className="Rectifier" description="&quot;B6 diode bridge&quot;" isLongClassSpecifier="true" classNameEnd="Rectifier" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Electrical.Analog.Ideal" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="400" declarationName="VAC" description="&quot;RMS line-to-line&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="50" declarationName="f" description="&quot;Line frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="60E-6" declarationName="LAC" description="&quot;Line inductor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1E-3" declarationName="Ron" description="&quot;Diode forward resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list expression="1E-3" declarationName="Goff" description="&quot;Diode backward conductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="2" declarationName="Vknee" description="&quot;Diode threshold voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list expression="15E-3" declarationName="CDC" description="&quot;DC capacitance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list expression="500" declarationName="IDC" description="&quot;Load current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
      <component_list declarationName="uDC"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
      <component_list subscripts="[3]" declarationName="iAC"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
      <component_list subscripts="[3]" declarationName="uAC"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" directionType="output" isOver="true">
      <component_list declarationName="Losses"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="VAC*sqrt(2/3)" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,10},{ -90,30} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="-2/3*Modelica.Constants.pi" elementName="phase"/>
        <modifications expression="VAC*sqrt(2/3)" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-10},{-90, 10 } }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="-4/3*Modelica.Constants.pi" elementName="phase"/>
        <modifications expression="VAC*sqrt(2/3)" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-30},{-90, -10 } }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="Inductor1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="LAC" elementName="L"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,10},{-40,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="Inductor2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="LAC" elementName="L"/>
        <modifications isModificationOver="true" elementName="i">
          <modifications expression="0" elementName="start"/>
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-10},{-40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="Inductor3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="LAC" elementName="L"/>
        <modifications isModificationOver="true" elementName="i">
          <modifications expression="0" elementName="start"/>
