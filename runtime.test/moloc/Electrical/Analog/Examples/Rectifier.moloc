      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Constant1.y" right="SignalCurrent1.i">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{79,0},{79,0},{72,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
