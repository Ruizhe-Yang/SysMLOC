          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="IdealDiode1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Ron" elementName="Ron"/>
        <modifications expression="Goff" elementName="Goff"/>
        <modifications expression="Vknee" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="IdealDiode2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Ron" elementName="Ron"/>
        <modifications expression="Goff" elementName="Goff"/>
        <modifications expression="Vknee" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="IdealDiode3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Ron" elementName="Ron"/>
