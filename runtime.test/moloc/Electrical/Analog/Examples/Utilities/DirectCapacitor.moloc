<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples.Utilities"/>
  <classes classType="model" className="DirectCapacitor" description="&quot;Input/output block of a direct capacitor model&quot;" isLongClassSpecifier="true" classNameEnd="DirectCapacitor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Icons.Block" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="C" description="&quot;Capacitance&quot;">
        <modifications expression="0" elementName="min"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="capacitor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="C" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SignalCurrent" isOver="true">
      <component_list declarationName="currentSource" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-40,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="iDrive" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;A&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.GeneralCurrentToVoltageAdaptor" isOver="true">
      <component_list isModificationOver="true" declarationName="currentToVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="true" elementName="use_pder"/>
        <modifications expression="false" elementName="use_fder"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{12,-10},{28,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list isModificationOver="true" declarationName="v" description="&quot;Capacitor changes voltage due to current&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;V&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,70},{120,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list isModificationOver="true" declarationName="dv" description="&quot;Capacitor changes voltage due to current&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;V/s&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,20},{120,40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="i" description="&quot;Current to the capacitor&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;A&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{140,-100},{100,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-30,-30},{-10,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.f" right="i">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{22.4,-8},{60,-8},{60, -80 } ,{120,-80} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.p" right="v">
        <annotations isModificationOver="true" elementName="Line">
