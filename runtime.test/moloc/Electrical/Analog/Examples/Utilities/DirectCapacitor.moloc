          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.pder" right="dv">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{22.4,5},{80,5},{80, 30 } ,{110,30} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iDrive" right="currentSource.i">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,0},{-52,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="capacitor.p" right="currentToVoltage.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{ 1.77636e-015,10} ,{10,10},{10,8},{18.4,8} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="capacitor.n" right="currentToVoltage.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{ -1.77636e-015,-10} ,{10,-10},{10,-8},{18.4,-8} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
