        <modifications expression="{Text( extent={{0,-62},{96,-94}}, textColor={135,135,135}, textString=&quot;to FMU&quot; ) ,Text( extent={{-94,96},{-10,66}}, horizontalAlignment=TextAlignment.Left, textString=&quot;v&quot; ) , Text( extent={{-94,46},{-10,16}}, horizontalAlignment=TextAlignment.Left, textString=&quot;dv&quot; ) , Text( extent={{-150,-110},{150,-140}}, textString=&quot;C=%C&quot; ) , Bitmap(extent={{-58,-42},{98,48}}, fileName=&quot;modelica://Modelica/Resources/Images/Electrical/Analog/InverseCapacitor.png&quot; ) , Text( extent={{-90,-64},{-6,-94}}, horizontalAlignment=TextAlignment.Left, textString=&quot;i&quot; ) }" elementName="graphics"/>
      </annotations>
