<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples.Utilities"/>
  <classes classType="model" className="InverseInductor" description="&quot;Input/output block of an inverse inductor model&quot;" isLongClassSpecifier="true" classNameEnd="InverseInductor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Icons.Block" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="L" description="&quot;Inductance&quot;">
        <modifications expression="0" elementName="min"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="inductor" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="i">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <modifications expression="L" elementName="L"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{20,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.GeneralCurrentToVoltageAdaptor" isOver="true">
      <component_list isModificationOver="true" declarationName="currentToVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="use_pder"/>
        <modifications expression="true" elementName="use_fder"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{-30,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="i" description="&quot;Current to drive the Inductor&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;A&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-100},{-100,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="di" description="&quot;Current to drive the Inductor&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;A/s&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-50},{-100,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list isModificationOver="true" declarationName="v" description="&quot;Voltage needed to drive the oneport according to i, di&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;V&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-100,70},{-120,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-30},{10,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.pin_p" right="inductor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-18,8},{0,8},{0,10},{20,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="inductor.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-10},{20,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.pin_n" right="ground.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-18,-8},{0, -8 } ,{0,-10} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="i" right="currentToVoltage.f">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,-80},{-40,-80},{ -40,-8} ,{-23,-8} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="di" right="currentToVoltage.fder">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,-30},{-60,-30}, {-60,-5},{-23,-5} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentToVoltage.p" right="v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-23,8},{-40,8},{-40,80}, {-110,80} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{0,-62},{96,-94}}, textColor={135,135,135}, textString=&quot;to FMU&quot; ) ,Text( extent={{-94,96},{-10,66}}, horizontalAlignment=TextAlignment.Left, textString=&quot;v&quot; ) , Text( extent={{-94,-12},{-10,-42}}, horizontalAlignment=TextAlignment.Left, textString=&quot;di&quot; ) , Text( extent={{-150,-110},{150,-140}}, textString=&quot;L=%L&quot; ) , Bitmap(extent={{-58,-42},{98,48}}, fileName=&quot;modelica://Modelica/Resources/Images/Electrical/Analog/InverseInductor.png&quot; ) , Text( extent={{-90,-64},{-6,-94}}, horizontalAlignment=TextAlignment.Left, textString=&quot;i&quot; ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
