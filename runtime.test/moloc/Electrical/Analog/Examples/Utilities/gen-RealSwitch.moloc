  <within withName="Modelica.Electrical.Analog.Examples.Utilities"/>
  <classes classType="model" className="RealSwitch" description="&quot;Ideal switch with resistance&quot;" isLongClassSpecifier="true" classNameEnd="RealSwitch" isOver="true">
