<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples"/>
  <classes classType="model" className="CharacteristicIdealDiodes" description="&quot;Characteristic of ideal diodes&quot;" isLongClassSpecifier="true" classNameEnd="CharacteristicIdealDiodes" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="Ideal" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="Ron"/>
        <modifications expression="0" elementName="Goff"/>
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,40},{20,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="With_Ron_Goff" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.1" elementName="Ron"/>
        <modifications expression="0.1" elementName="Goff"/>
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,0},{20,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="With_Ron_Goff_Vknee" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.2" elementName="Ron"/>
        <modifications expression="0.2" elementName="Goff"/>
        <modifications expression="5" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-40},{20,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="10" elementName="V"/>
        <modifications expression="-9" elementName="offset"/>
        <modifications expression="1" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-40,0}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="Ground1" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-80},{-30,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1e-3" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,40},{80,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1e-3" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,0},{80,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1e-3" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,-40},{80,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="10" elementName="V"/>
        <modifications expression="0" elementName="offset"/>
        <modifications expression="1" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-60,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="10" elementName="V"/>
        <modifications expression="0" elementName="offset"/>
        <modifications expression="1" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,-40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Ground1.p" right="SineVoltage1.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,-60},{-40,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Ideal.n" right="R1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,50},{60,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="With_Ron_Goff.n" right="R2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,10},{60,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="With_Ron_Goff_Vknee.n" right="R3.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,-30},{60,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R1.n" right="R2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,50},{80,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R2.n" right="R3.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,10},{80,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R3.n" right="Ground1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,-30},{80,-60},{-40,-60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage2.p" right="Ideal.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,50},{0,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage2.n" right="Ground1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,30},{-60,-60},{-40,-60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.p" right="With_Ron_Goff.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,10},{0,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="With_Ron_Goff_Vknee.p" right="SineVoltage3.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-30},{-20,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage3.n" right="Ground1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-50},{-20,-60},{-40,-60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-88,102},{92,48}}, textString=&quot;Characteristic Ideal Diodes&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Three examples of ideal diodes are shown:&lt;br>the &lt;strong>totally ideal diode&lt;/strong> (Ideal) with all parameters to be zero,the &lt;strong>nearly ideal diode&lt;/strong> with &lt;em>Ron=0.1&lt;/em> and &lt;em>Goff=0.1&lt;/em> and the nearly ideal but &lt;strong>displaced diode&lt;/strong> with &lt;em>Vknee=5&lt;/em> and &lt;em>Ron=0.1&lt;/em> and &lt;em>Goff=0.1&lt;/em>.The resistance and conductance are chosen untypically high since the slopes should be seen in the graphics.&lt;/p>&lt;p>Simulate until T=1 s.Plot in separate windows:Ideal.i versus Ideal.v, With_Ron_Goff.i versus With_Ron_Goff.v, With_Ron_Goff_Vknee.i versus With_Ron_Goff_Vknee.v&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;p>&lt;strong>Release Notes:&lt;/strong>&lt;/p>&lt;ul>&lt;li>&lt;em>Mai 7, 2004 &lt;/em> by Christoph Clauss&lt;br> realized&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="1" elementName="StopTime"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
