<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Examples"/>
  <classes classType="model" className="ShowVariableResistor" description="&quot;Simple demo of a VariableResistor model&quot;" isLongClassSpecifier="true" classNameEnd="ShowVariableResistor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.VariableResistor" isOver="true">
      <component_list declarationName="VariableResistor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{0,0}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="Ground1" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-100,-80},{-80,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="Ground2" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,-40},{80,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,40},{-40,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,40},{0,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,40},{40,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R4" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-20},{-40,0}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="R5" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-20},{40,0}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="SineVoltage1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="V"/>
        <modifications expression="1" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-90,-30}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Ramp" isOver="true">
      <component_list isModificationOver="true" declarationName="Ramp1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="5" elementName="height"/>
        <modifications expression="2" elementName="offset"/>
        <modifications expression="2" elementName="duration"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-10,20}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R1.n" right="R2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,50},{-20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R2.n" right="R3.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,50},{20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R4.n" right="VariableResistor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,-10},{ -20,-10} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="VariableResistor.n" right="R5.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-10},{20, -10 } }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="R3.n" right="Ground2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,50},{70,50},{70, -20 } }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Ground2.p" right="R5.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,-20},{70,-10},{40, -10 } }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.p" right="Ground1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-40},{-90,-60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.n" right="R1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-20},{-90,50}, {-60,50} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="SineVoltage1.n" right="R4.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-20},{-90, -10 } ,{-60,-10} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Ramp1.y" right="VariableResistor.R">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,9},{-10,2},{-10,2}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>It is a simple test circuit for the VariableResistor. The VariableResistor should be compared with R2.&lt;/p>&lt;p>Simulate until T=1 s.&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;p>&lt;strong>Release Notes:&lt;/strong>&lt;/p>&lt;ul>&lt;li>&lt;em>Mai 6, 2004 &lt;/em> by Teresa Schlegel&lt;br> realized&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="1" elementName="StopTime"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-100,112},{80,40}}, textColor={0,0,255}, textString=&quot;Example VariableResistor&quot; ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
