  <within withName="Modelica.Electrical.Analog"/>
  <classes classType="package" className="Examples" description="&quot;Examples that demonstrate the usage of the Analog electrical components&quot;" isLongClassSpecifier="true" classNameEnd="Examples" isOver="true">
