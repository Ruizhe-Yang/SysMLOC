<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Ideal">
  <classes classType="model" className="ControlledIdealClosingSwitch" description="&quot;Controlled ideal electrical closer&quot;" isLongClassSpecifier="true" classNameEnd="ControlledIdealClosingSwitch" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0.5" declarationName="level" description="&quot;Switch level&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.IdealSwitch" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="control" description="&quot;Control pin: control.v > level switch closed, otherwise switch open&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,100}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="off" right="control.v &lt; level"/>
      <equations xsi:type="mOloc:SimpleEquation" left="control.i" right="0"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;switch&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;The switching behaviour of the controlled ideal closing switch is controlled by the control pin: off = control.v &amp;lt; level&lt;br>&#xA;For further details, see partial model &lt;a href=\&quot;modelica://Modelica.Electrical.Analog.Interfaces.IdealSwitch\&quot;>IdealSwitch&lt;/a>.&#xA;&lt;/p>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>February 7, 2016   &lt;/em>&#xA;       by Anton Haumer&lt;br> extending from partial IdealSwitch&lt;br>&#xA;       &lt;/li>&#xA;&lt;li>&lt;em> March 11, 2009   &lt;/em>&#xA;       by Christoph Clauss&lt;br> conditional heat port added&lt;br>&#xA;       &lt;/li>&#xA;&lt;li>&lt;em> 1998   &lt;/em>&#xA;       by Christoph Clauss&lt;br> initially implemented&lt;br>&#xA;       &lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line( visible=useHeatPort, points={{0,-100},{0,25}}, color={127,0,0}, pattern=LinePattern.Dot ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
