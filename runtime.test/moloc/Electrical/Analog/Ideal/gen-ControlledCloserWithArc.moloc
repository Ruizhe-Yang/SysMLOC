<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Ideal"/>
  <classes classType="model" className="ControlledCloserWithArc" description="&quot;Controlled ideal electrical closer with simple arc model&quot;" isLongClassSpecifier="true" classNameEnd="ControlledCloserWithArc" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0.5" declarationName="level" description="&quot;Switch level&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.IdealSwitchWithArc" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="control" description="&quot;Control pin: control.v > level switch closed, otherwise switch open&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,100}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="off" right="control.v &lt; level"/>
      <equations xsi:type="mOloc:SimpleEquation" left="control.i" right="0"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;switch&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This model is an extension to the &lt;a href=\&quot;modelica://Modelica.Electrical.Analog.Ideal.ControlledIdealClosingSwitch\&quot;>ControlledIdealClosingSwitch&lt;/a>.&#xA;&lt;/p>&lt;p>For details of the arc effect, see partial model &lt;a href=\&quot;modelica://Modelica.Electrical.Analog.Interfaces.IdealSwitchWithArc\&quot;>IdealSwitchWithArc&lt;/a>.&#xA;&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;ul>&lt;li>&lt;em>February 7, 2016 &lt;/em> by Anton Haumer&lt;br> extending from partial IdealSwitchWithArc&lt;br> &lt;/li>&lt;li>&lt;em>May, 2009 &lt;/em> by Anton Haumer&lt;br> initially implemented&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{40,40},{34,16},{48,24},{40,0}}, color={255,0,0})}" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
