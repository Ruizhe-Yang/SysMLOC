<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Ideal"/>
  <classes classType="model" className="DA_Converter" description="&quot;Simple digital to analog converter&quot;" isLongClassSpecifier="true" classNameEnd="DA_Converter" isOver="true">
    <elements xsi:type="mOloc:ImportClause" selfName="L" importName="Modelica.Electrical.Digital.Interfaces.Logic" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Digital.Interfaces.DigitalInput" isOver="true">
      <component_list declarationName="trig" description="&quot;Trigger input&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,92},{10,112}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="-90" elementName="rotation"/>
            <modifications expression="{0,100}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Digital.Interfaces.DigitalInput" isOver="true">
      <component_list subscripts="[N]" declarationName="x" description="&quot;Digital input&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="p" description="&quot;Positive electrical pin (output)&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,90},{110,110}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,90},{110,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="n" description="&quot;Negative electrical pin (output)&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list isModificationOver="true" declarationName="vout">
        <modifications expression="0" elementName="start"/>
        <modifications expression="true" elementName="fixed"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list isModificationOver="true" declarationName="y">
        <modifications expression="0" elementName="start"/>
        <modifications expression="true" elementName="fixed"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="N" description="&quot;Resolution - input signal width&quot;">
        <modifications expression="1" elementName="min" isfinal="true"/>
        <modifications expression="8" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Vref" description="&quot;Reference voltage&quot;">
        <modifications expression="10" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:AlgorithmSection">
      <statements xsi:type="mOloc:WhenStatement" condition="trig == L.'1' or trig == L.'H'">
        <whenStatements xsi:type="mOloc:FunctionStatement" component="y" expression="0"/>
        <whenStatements xsi:type="mOloc:ForStatement" forIndices="i in 1:N">
          <forStatements xsi:type="mOloc:FunctionStatement" component="y" expression="if (x[i] == L.'1' or x[i] == L.'H') then y + 2^(i - 1) else y"/>
        </whenStatements>
        <whenStatements xsi:type="mOloc:FunctionStatement" component="vout" expression="y*Vref/(2^N - 1)"/>
      </statements>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="p.v - n.v" right="vout"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p.i + n.i" right="0"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;converter&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Simple digital to analog converter with a variable input signal width of N bits. The input signal is an N-vector of type Logic (9-valued logic according to IEEE 1164 STD_ULOGIC). The output voltage of value &lt;code>y&lt;/code> is generated by an ideal voltage source. The output can only change if the trigger signal &lt;code>trig&lt;/code> of type Logic changes to &amp;#39;&#xA;1&amp;#39;&#xA;(forced or weak). In this case, the output voltage is calculated in the following way:&lt;/p>&lt;blockquote>&lt;pre> Ny = SUM ( x[i]*2^(i-1) )*Vref/(2^N-1), i=1&lt;/pre>&lt;/blockquote>&lt;p>where x[i], i=1,...,N is 1 or 0. and Vref is the reference value. Therefore, the first bit in the input vector x[1] is the least significant one (LSB) and x[N] is the most significant bit (MSB).&lt;/p>&lt;p>This is an abstract model of a DAC. Hence, it can not cover the dynamic behaviour of the converter. Therefore the output will change instantaneously when the trigger signal rises.&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;ul>&lt;li>&lt;em> October 13, 2009 &lt;/em> by Matthias Franke &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Rectangle(extent={{-100,100},{100,-100}}, lineColor={0,0,255} ) , Polygon( points={{-100,-100},{100,100},{-100,100},{-100,-100}}, lineColor={0,0,255}, fillColor={127,0,127}, fillPattern=FillPattern.Solid ) , Text( extent={{-60,50},{60,10}}, textColor={0,0,255}, textString=&quot;%n-bit&quot; ) , Text( extent={{-60,-10},{60,-50}}, textColor={0,0,255}, textString=&quot;DAC&quot; ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
