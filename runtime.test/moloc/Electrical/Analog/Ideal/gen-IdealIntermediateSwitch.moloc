<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Ideal"/>
  <classes classType="model" className="IdealIntermediateSwitch" description="&quot;Ideal intermediate switch&quot;" isLongClassSpecifier="true" classNameEnd="IdealIntermediateSwitch" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1e-5" declarationName="Ron" description="&quot;Closed switch resistance&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1e-5" declarationName="Goff" description="&quot;Opened switch conductance&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.ConditionalHeatPort" isOver="true">
      <extendsModifications expression="293.15" elementName="T" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.PositivePin" isOver="true">
      <component_list declarationName="p1" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,30},{-90,50}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,30},{-90,50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.PositivePin" isOver="true">
      <component_list declarationName="p2" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.NegativePin" isOver="true">
      <component_list declarationName="n1" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,30},{110,50}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,30},{110,50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.NegativePin" isOver="true">
      <component_list declarationName="n2" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.BooleanInput" isOver="true">
      <component_list declarationName="control" description="&quot;true => p1--n2, p2--n1 connected, otherwise p1--n1, p2--n2 connected&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isProtected="true" isOver="true">
      <component_list isModificationOver="true" declarationName="s1">
        <modifications expression="&quot;1&quot;" elementName="unit" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list isModificationOver="true" declarationName="s2">
        <modifications expression="&quot;1&quot;" elementName="unit" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list isModificationOver="true" declarationName="s3">
        <modifications expression="&quot;1&quot;" elementName="unit" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isOver="true">
      <component_list isModificationOver="true" declarationName="s4" description="&quot;Auxiliary variables&quot;">
        <modifications expression="&quot;1&quot;" elementName="unit" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="constant" isOver="true">
      <component_list expression="1" declarationName="unitVoltage" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="HideResult"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" parameterType="constant" isOver="true">
      <component_list expression="1" declarationName="unitCurrent" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="HideResult"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="p1.v - n1.v" right="(s1*unitCurrent)*(if (control) then 1 else Ron)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p2.v - n2.v" right="(s2*unitCurrent)*(if (control) then 1 else Ron)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p1.v - n2.v" right="(s3*unitCurrent)*(if (control) then Ron else 1)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p2.v - n1.v" right="(s4*unitCurrent)*(if (control) then Ron else 1)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p1.i" right="if control then s1*unitVoltage*Goff + s3*unitCurrent else s1* unitCurrent + s3*unitVoltage*Goff"/>
      <equations xsi:type="mOloc:SimpleEquation" left="p2.i" right="if control then s2*unitVoltage*Goff + s4*unitCurrent else s2* unitCurrent + s4*unitVoltage*Goff"/>
      <equations xsi:type="mOloc:SimpleEquation" left="n1.i" right="if control then -s1*unitVoltage*Goff - s4*unitCurrent else -s1* unitCurrent - s4*unitVoltage*Goff"/>
      <equations xsi:type="mOloc:SimpleEquation" left="n2.i" right="if control then -s2*unitVoltage*Goff - s3*unitCurrent else -s2* unitCurrent - s3*unitVoltage*Goff"/>
      <equations xsi:type="mOloc:SimpleEquation" left="LossPower" right="p1.i*p1.v + p2.i*p2.v + n1.i*n1.v + n2.i*n2.v"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;switch&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The intermediate switch has four switching contact pins p1, p2, n1, and n2. The switching behaviour is controlled by the input signal control. If control is true, the pin p1 is connected to the pin n2, and the pin p2 is connected to the pin n1. Otherwise,if control is false, the pin p1 is connected to n1, and the pin p2 is connected to n2.&lt;/p>&lt;p>&lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/Analog/IdealIntermediateSwitch1.png\&quot;&#xA;alt=\&quot;IdealIntermediateSwitch1.png\&quot;>&lt;/p>&lt;p>In order to prevent singularities during switching, the opened switch has a (very low) conductance Goff and the closed switch has a (very low) resistance Ron.&lt;/p>&lt;p>&lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/Analog/IdealIntermediateSwitch2.png\&quot;&#xA;alt=\&quot;IdealIntermediateSwitch2.png\&quot;>&lt;/p>&lt;p>The limiting case is also allowed, i.e., the resistance Ron of the closed switch could be exactly zero and the conductance Goff of the open switch could be also exactly zero. Note, there are circuits, where a description with zero Ron or zero Goff is not possible.&lt;/p>&lt;p>&lt;strong>Please note:&lt;/strong> In case of useHeatPort=true the temperature dependence of the electrical behavior is &lt;strong>not &lt;/strong>modelled. The parameters are not temperature dependent.&lt;/p>&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;ul>&lt;li>&lt;em> March 11, 2009 &lt;/em> by Christoph Clauss&lt;br> conditional heat port added&lt;br> &lt;/li>&lt;li>&lt;em> 1998 &lt;/em> by Christoph Clauss&lt;br> initially implemented&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Text( extent={{-150,90},{150,50}}, textString=&quot;%name&quot;, textColor={0,0,255} ) , Ellipse(extent={{-4,24},{4,16}}, lineColor= {0,0,255} ) ,Line(points={{-96,0},{-40,0}}, color={0,0,255}),Line( points={{-96,40},{-40,40}}, color={0,0,255}) ,Line(points={{-40,0},{40,40}}, color={0,0,255} ) ,Line(points={{-40,40},{40,0}}, color={0,0,255}), Line(points={{40,40},{96,40}}, color={0,0,255}), Line(points={{40,0},{96,0}}, color= {0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
