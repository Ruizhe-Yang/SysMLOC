<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Interfaces"/>
  <classes classType="connector" className="NegativePin" description="&quot;Negative pin of an electrical component&quot;" isLongClassSpecifier="true" classNameEnd="NegativePin" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ElectricPotential" isOver="true">
      <component_list declarationName="v" description="&quot;Potential at the pin&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="&quot;An electrical potential cannot be uniquely calculated.&#xA;The reason could be that&#xA;- a ground object is missing (Modelica.Electrical.Analog.Basic.Ground)&#xA;  to define the zero potential of the electrical circuit, or&#xA;- a connector of an electrical component is not connected.&quot;" elementName="unassignedMessage"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" relationshipType="flow" isOver="true">
      <component_list declarationName="i" description="&quot;Current flowing into the pin&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="&quot;An electrical current cannot be uniquely calculated.&#xA;The reason could be that&#xA;- a ground object is missing (Modelica.Electrical.Analog.Basic.Ground)&#xA;  to define the zero potential of the electrical circuit, or&#xA;- a connector of an electrical component is not connected.&quot;" elementName="unassignedMessage"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;pin_n&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Connectors PositivePin and NegativePin are nearly identical. The only difference is that the icons are different in order to identify more easily the pins of a component. Usually, connector PositivePin is used for the positive and connector NegativePin for the negative pin of an electrical component.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;dl>&#xA;&lt;dt>&lt;em>1998&lt;/em>&lt;/dt>&#xA;&lt;dd>by Christoph Clauss initially implemented&#xA;&lt;/dd>&#xA;&lt;/dl>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{Rectangle( extent={{-100,100},{100,-100}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Rectangle( extent={{-40,40},{40,-40}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Text( extent={{-40,110},{160,50}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
