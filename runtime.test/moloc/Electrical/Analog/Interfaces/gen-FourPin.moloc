  <within withName="Modelica.Electrical.Analog.Interfaces"/>
  <classes isPartial="true" classType="model" className="FourPin" description="&quot;Component with two pairs of each two electrical pins&quot;" isLongClassSpecifier="true" classNameEnd="FourPin" isOver="true">
