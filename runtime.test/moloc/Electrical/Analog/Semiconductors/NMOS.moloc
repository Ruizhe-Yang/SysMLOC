<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Semiconductors">
  <classes classType="model" className="NMOS" description="&quot;Simple NMOS transistor with heating port&quot;" isLongClassSpecifier="true" classNameEnd="NMOS" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="D" description="&quot;Drain&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,50},{110,70}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,50},{110,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="G" description="&quot;Gate&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-90,-50},{-110,-70}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-90,-50},{-110,-70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="S" description="&quot;Source&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-50},{110,-70}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,-50},{110,-70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.Pin" isOver="true">
      <component_list declarationName="B" description="&quot;Bulk&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
      <component_list expression="20.e-6" declarationName="W" description="&quot;Width&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
      <component_list expression="6.e-6" declarationName="L" description="&quot;Length&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Transconductance" parameterType="parameter" isOver="true">
      <component_list expression="0.041e-3" declarationName="Beta" description="&quot;Transconductance parameter&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0.8" declarationName="Vt" description="&quot;Zero bias threshold voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="1.144" declarationName="K2" description="&quot;Bulk threshold parameter&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="0.7311" declarationName="K5" description="&quot;Reduction of pinch-off region&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
      <component_list expression="-2.5e-6" declarationName="dW" description="&quot;Narrowing of channel&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
      <component_list expression="-1.5e-6" declarationName="dL" description="&quot;Shortening of channel&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1e7" declarationName="RDS" description="&quot;Drain-Source-Resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list expression="false" declarationName="useTemperatureDependency" description="&quot;= true, if parameters Beta, K2 and Vt depend on temperature&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
        <annotations expression="true" elementName="HideResult"/>
        <annotations isModificationOver="true" elementName="choices">
          <modifications expression="true" elementName="checkBox"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="300.15" declarationName="Tnom" description="&quot;Parameter measurement temperature&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="useTemperatureDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="-6.96e-3" declarationName="kvt" description="&quot;Fitting parameter for Vt&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="useTemperatureDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="6e-4" declarationName="kk2" description="&quot;Fitting parameter for K2&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="useTemperatureDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.ConditionalHeatPort" isOver="true">
      <extendsModifications expression="useTemperatureDependency" elementName="useHeatPort"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
      <component_list declarationName="v"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="uds"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="ubs"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="ugst"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="ud"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="us"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="id"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="gds"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="beta_t"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="vt_t"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list declarationName="k2_t"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(L + dL > 0, &quot;NMOS: Effective length must be positive&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(W + dW > 0, &quot;NMOS: Effective width must be positive&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(T_heatPort > 0,&quot;NMOS: Temperature must be positive&quot;)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="gds" right="if (RDS &lt; 1e-20 and RDS > -1e-20) then 1e20 else 1/RDS"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="beta_t*(W + dW)/(L + dL)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="ud" right="smooth(0,if (D.v &lt; S.v) then S.v else D.v)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="us" right="smooth(0,if (D.v &lt; S.v) then D.v else S.v)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="uds" right="ud - us"/>
      <equations xsi:type="mOloc:SimpleEquation" left="ubs" right="smooth(0,if (B.v > us) then 0 else B.v - us)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="ugst" right="(G.v - us - vt_t + k2_t*ubs)*K5"/>
      <equations xsi:type="mOloc:SimpleEquation" left="id" right="smooth(0,if (ugst &lt;= 0) then uds*gds else if (ugst > uds) then v*uds*( ugst - uds/2) + uds*gds else v*ugst*ugst/2 + uds*gds )"/>
      <equations xsi:type="mOloc:SimpleEquation" left="beta_t" right="if useTemperatureDependency then Beta*pow((T_heatPort/Tnom), -1.5) else Beta"/>
      <equations xsi:type="mOloc:SimpleEquation" left="vt_t" right="if useTemperatureDependency then Vt*(1 + (T_heatPort - Tnom)*kvt) else Vt"/>
      <equations xsi:type="mOloc:SimpleEquation" left="k2_t" right="if useTemperatureDependency then K2*(1 + (T_heatPort - Tnom)*kk2) else K2"/>
      <equations xsi:type="mOloc:SimpleEquation" left="G.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="D.i" right="smooth(0,if (D.v &lt; S.v) then -id else id)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="S.i" right="smooth(0,if (D.v &lt; S.v) then id else -id)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="B.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="LossPower" right="D.i*(D.v - S.v)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;nMOS&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>The NMOS model is a simple model of a n-channel metal-oxide semiconductor FET. It differs slightly from the device used in the SPICE simulator. For more details please care for [&lt;a href=\&quot;modelica://Modelica.Electrical.Analog.UsersGuide.References\&quot;>Spiro1990&lt;/a>].&#xA;&lt;br> A heating port is added for thermal electric simulation. The heating port is defined in the Modelica.Thermal library.&#xA;&lt;br>The model does not consider capacitances. A high drain-source resistance RDS is included to avoid numerical difficulties.&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;W       L      Beta         Vt      K2     K5       dW       dL&#xA;m       m      A/V^2        V       -      -        m        m&#xA;12.e-6  4.e-6  0.062e-3    -4.5     0.24   0.61    -1.2e-6  -0.9e-6      depletion&#xA;60.e-6  3.e-6  0.048e-3     0.1     0.08   0.68    -1.2e-6  -0.9e-6      enhancement&#xA;12.e-6  4.e-6  0.0625e-3   -0.8     0.21   0.78    -1.2e-6  -0.9e-6      zero&#xA;50.e-6  8.e-6  0.0299e-3    0.24    1.144  0.7311  -5.4e-6  -4.e-6&#xA;20.e-6  6.e-6  0.041e-3     0.8     1.144  0.7311  -2.5e-6  -1.5e-6&#xA;30.e-6  9.e-6  0.025e-3    -4.0     0.861  0.878   -3.4e-6  -1.74e-6&#xA;30.e-6  5.e-6  0.031e-3     0.6     1.5    0.72     0       -3.9e-6&#xA;50.e-6  6.e-6  0.0414e-3   -3.8     0.34   0.8     -1.6e-6  -2.e-6       depletion&#xA;50.e-6  5.e-6  0.03e-3      0.37    0.23   0.86    -1.6e-6  -2.e-6       enhancement&#xA;50.e-6  6.e-6  0.038e-3    -0.9     0.23   0.707   -1.6e-6  -2.e-6       zero&#xA;20.e-6  4.e-6  0.06776e-3   0.5409  0.065  0.71    -0.8e-6  -0.2e-6&#xA;20.e-6  4.e-6  0.06505e-3   0.6209  0.065  0.71    -0.8e-6  -0.2e-6&#xA;20.e-6  4.e-6  0.05365e-3   0.6909  0.03   0.8     -0.3e-6  -0.2e-6&#xA;20.e-6  4.e-6  0.05365e-3   0.4909  0.03   0.8     -0.3e-6  -0.2e-6&#xA;12.e-6  4.e-6  0.023e-3    -4.5     0.29   0.6      0        0           depletion&#xA;60.e-6  3.e-6  0.022e-3     0.1     0.11   0.65     0        0           enhancement&#xA;12.e-6  4.e-6  0.038e-3    -0.8     0.33   0.6      0        0           zero&#xA;20.e-6  6.e-6  0.022e-3     0.8     1      0.66     0        0&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;p>&lt;strong>References:&lt;/strong> [&lt;a href=\&quot;modelica://Modelica.Electrical.Analog.UsersGuide.References\&quot;>Spiro1990&lt;/a>]&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em> March 11, 2009   &lt;/em>&#xA;       by Christoph Clauss&lt;br> conditional heat port added&lt;br>&#xA;       &lt;/li>&#xA;&lt;li>&lt;em>December 7, 2005   &lt;/em>&#xA;       by Christoph Clauss&lt;br>&#xA;       error in RDS calculation deleted&lt;/li>&#xA;&lt;li>&lt;em>March 31, 2004   &lt;/em>&#xA;       by Christoph Clauss&lt;br> implemented&lt;br>&#xA;       &lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{-90,-60},{-10,-60}}, color={0,0,255}), Line(points={{-10,-60},{-10,60}}, color={0,0,255}), Line(points={{10,80},{10,39}}, color={0,0,255}), Line(points={{10,20},{10,-21}}, color={0,0,255}), Line(points={{10,-40},{10,-81}}, color={0,0,255}), Line(points={{10,60},{91,60}}, color={0,0,255}), Line(points={{10,0},{90,0}}, color={0,0,255}), Line(points={{10,-60},{90,-60}}, color={0,0,255}), Polygon( points={{40,0},{60,5},{60,-5},{40,0}}, fillColor={0,0,255}, fillPattern=FillPattern.Solid, lineColor={0,0,255} ) , Text( extent={{-150,130},{150,90}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
