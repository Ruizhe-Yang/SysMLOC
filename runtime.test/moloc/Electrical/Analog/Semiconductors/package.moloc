<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog">
  <classes classType="package" className="Semiconductors" description="&quot;Semiconductor devices such as diode, MOS and bipolar transistor&quot;" isLongClassSpecifier="true" classNameEnd="Semiconductors" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" description="&quot;Boltzmann's constant, [J/K]&quot;" importName="Modelica.Constants.k" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" description="&quot;Electron charge, [As]&quot;" importName="Modelica.Constants.q" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" classType="function" className="pow" description="&quot;Just a helper function for x^y in order that a symbolic engine can apply some transformations more easily&quot;" isLongClassSpecifier="true" classNameEnd="pow" isProtected="true" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="x"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="y"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
        <component_list declarationName="z"/>
      </elements>
      <elements xsi:type="mOloc:AlgorithmSection">
        <statements xsi:type="mOloc:FunctionStatement" component="z" expression="x^y"/>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="function" className="powlin" description="&quot;Power function (1 - x)^(-y) linearly continued for x > 0 (provided y = const.)&quot;" isLongClassSpecifier="true" classNameEnd="powlin" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="x"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="y"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
        <component_list declarationName="z"/>
      </elements>
      <elements xsi:type="mOloc:AlgorithmSection">
        <statements xsi:type="mOloc:FunctionStatement" component="z" expression="if x > 0 then 1 + y*x else pow(1 - x, -y)"/>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="function" className="exlin" description="&quot;Exponential function linearly continued for x > Maxexp&quot;" isLongClassSpecifier="true" classNameEnd="exlin" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="x"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="Maxexp"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
        <component_list declarationName="z"/>
      </elements>
      <elements xsi:type="mOloc:AlgorithmSection">
        <statements xsi:type="mOloc:FunctionStatement" component="z" expression="if x > Maxexp then exp(Maxexp)*(1 + x - Maxexp) else exp(x)"/>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="function" className="exlin2" description="&quot;Exponential function linearly continued for x &lt; MinExp and x > Maxexp&quot;" isLongClassSpecifier="true" classNameEnd="exlin2" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="x"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="Minexp"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
        <component_list declarationName="Maxexp"/>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
        <component_list declarationName="z"/>
      </elements>
      <elements xsi:type="mOloc:AlgorithmSection">
        <statements xsi:type="mOloc:FunctionStatement" component="z" expression="if x &lt; Minexp then exp(Minexp)*(1 + x - Minexp) else exlin(x, Maxexp)"/>
      </elements>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package contains semiconductor devices:&lt;/p>&#xA;&lt;ul>&#xA;&lt;li>diode&lt;/li>&#xA;&lt;li>MOS transistors&lt;/li>&#xA;&lt;li>bipolar transistors&lt;/li>&#xA;&lt;li>thyristor&lt;/li>&#xA;&lt;li>triac&lt;/li>&#xA;&lt;/ul>&#xA;&lt;p>Most of the semiconductor devices contain a conditional heat port, which is not active by default. If it is active the loss power is calculated to be used in a thermal net. The heating variants of the semiconductor devices are provided to use the thermal port temperature in the electric calculation. That means that for a true thermal electric interaction the heating device models have to be used.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;dl>&#xA;&lt;dt>&#xA;&lt;strong>Main Authors:&lt;/strong>&#xA;&lt;/dt>&#xA;&lt;dd>&#xA;Christoph Clau&amp;szlig;&#xA;    &amp;lt;&lt;a href=\&quot;mailto:christoph@clauss-it.com\&quot;>christoph@clauss-it.com&lt;/a>&amp;gt;&lt;br>&#xA;    Andr&amp;eacute; Schneider&#xA;    &amp;lt;&lt;a href=\&quot;mailto:Andre.Schneider@eas.iis.fraunhofer.de\&quot;>Andre.Schneider@eas.iis.fraunhofer.de&lt;/a>&amp;gt;&lt;br>&#xA;    Fraunhofer Institute for Integrated Circuits&lt;br>&#xA;    Design Automation Department&lt;br>&#xA;    Zeunerstra&amp;szlig;e 38&lt;br>&#xA;    D-01069 Dresden&#xA;&lt;/dd>&#xA;&lt;/dl>&#xA;&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(points={{-20,0},{-90,0}}), Line(points={{-20,60},{-20,-60}}), Line(points={{20,68},{-20,28}}), Line(points={{80,68},{20,68}}), Line(points={{-20,-30},{20,-70}}), Line(points={{20,-70},{80,-70}}) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
