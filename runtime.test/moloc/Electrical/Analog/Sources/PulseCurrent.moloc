<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Analog.Sources">
  <classes classType="model" className="PulseCurrent" description="&quot;Pulse current source&quot;" isLongClassSpecifier="true" classNameEnd="PulseCurrent" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="I" description="&quot;Amplitude of pulse&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="width" description="&quot;Width of pulse in % of period&quot;">
        <modifications expression="Modelica.Constants.small" elementName="min" isfinal="true"/>
        <modifications expression="100" elementName="max" isfinal="true"/>
        <modifications expression="50" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="period" description="&quot;Time for one period&quot;">
        <modifications expression="Modelica.Constants.small" elementName="min" isfinal="true"/>
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.CurrentSource" isOver="true">
      <extendsModifications typeSpecifier="Modelica.Blocks.Sources.Pulse" isModificationOver="true" declarationName="signalSource" isRedeclare="true">
        <modifications expression="I" elementName="amplitude" isfinal="true"/>
        <modifications expression="width" elementName="width" isfinal="true"/>
        <modifications expression="period" elementName="period" isfinal="true"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{-80,-67},{-50,-67},{-50,73},{-10, 73 } ,{-10,-67},{30,-67},{30,73},{70,73} } , color={192,192,192} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em> 1998   &lt;/em>&#xA;       by Christoph Clauss&lt;br> initially implemented&lt;br>&#xA;       &lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This current source uses the corresponding signal source of the Modelica.Blocks.Sources package. Care for the meaning of the parameters in the Blocks package. Furthermore, an offset parameter is introduced, which is added to the value calculated by the blocks source. The startTime parameter allows to shift the blocks source behavior on the time axis.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
