<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Analog.Sources"/>
  <classes classType="model" className="ExponentialsVoltage" description="&quot;Rising and falling exponential voltage source&quot;" isLongClassSpecifier="true" classNameEnd="ExponentialsVoltage" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="vMax" description="&quot;Upper bound for rising edge&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="riseTime" description="&quot;Rise time&quot;">
        <modifications expression="0" elementName="min"/>
        <modifications expression="0.5" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="riseTimeConst" description="&quot;Rise time constant&quot;">
        <modifications expression="Modelica.Constants.small" elementName="min"/>
        <modifications expression="0.1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="fallTimeConst" description="&quot;Fall time constant&quot;">
        <modifications expression="Modelica.Constants.small" elementName="min"/>
        <modifications expression="riseTimeConst" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.VoltageSource" isOver="true">
      <extendsModifications typeSpecifier="Modelica.Blocks.Sources.Exponentials" isModificationOver="true" declarationName="signalSource" isRedeclare="true">
        <modifications expression="vMax" elementName="outMax" isfinal="true"/>
        <modifications expression="riseTime" elementName="riseTime" isfinal="true"/>
        <modifications expression="riseTimeConst" elementName="riseTimeConst" isfinal="true"/>
        <modifications expression="fallTimeConst" elementName="fallTimeConst" isfinal="true"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100, 100 } }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{-76,-59},{-73.2,-44.3},{-70.3,-31.1}, {-66.8,-16.6},{-63.3,-4},{-59.7,6.92},{-55.5,18.18},{-51.3,27.7}, {-46.3,37},{-40.6,45.5},{-34.3,53.1},{-27.2,59.6},{-18.7,65.3}, {-8.1,70.2},{-6,71},{-3.88,58.5},{-1.05,43.7},{1.78,30.8},{ 4.606,19.45} ,{8.14,7.3},{11.68,-3},{15.9,-13.2},{20.2,-21.6},{ 25.1,-29.5} ,{30.8,-36.4},{37.1,-42.3},{44.9,-47.5},{54.8,-51.8}, {64,-54.4} } , color={192,192,192} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;ul>&lt;li>&lt;em> 1998 &lt;/em> by Christoph Clauss&lt;br> initially implemented&lt;br> &lt;/li>&lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
        <modifications expression="&quot;&lt;html>&lt;p>This voltage source uses the corresponding signal source of the Modelica.Blocks.Sources package. Care for the meaning of the parameters in the Blocks package. Furthermore, an offset parameter is introduced, which is added to the value calculated by the blocks source. The startTime parameter allows to shift the blocks source behavior on the time axis.&lt;/p>&lt;p>&lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/Analog/Sources/ExponentialsVoltage.png\&quot;&#xA;alt=\&quot;ExponentialsVoltage.png\&quot;>&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
