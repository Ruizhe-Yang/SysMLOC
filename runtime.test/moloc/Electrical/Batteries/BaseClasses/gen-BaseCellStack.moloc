<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Batteries.BaseClasses"/>
  <classes isPartial="true" classType="model" className="BaseCellStack" description="&quot;Battery with open-circuit voltage dependent on state of charge, self-discharge and inner resistance&quot;" isLongClassSpecifier="true" classNameEnd="BaseCellStack" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Batteries.Icons.BatteryIcon" isOver="true">
      <extendsModifications expression="SOC" elementName="displaySOC" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="Ns" description="&quot;Number of serial connected cells&quot;">
        <modifications expression="1" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="Np" description="&quot;Number of parallel connected cells&quot;">
        <modifications expression="1" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="ParameterRecords.CellData" parameterType="parameter" isReplaceable="true" isOver="true">
      <component_list declarationName="cellData" description="&quot;Cell parameters&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,60},{10,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="1e-9" declarationName="SOCtolerance" description="&quot;Tolerance to detect depleted of overcharged battery&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Advanced&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.TwoPin" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="p.i" declarationName="i" description="&quot;Current into the battery&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="v*i" declarationName="power" description="&quot;Power to the battery&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list isModificationOver="true" expression="limIntegrator.y" declarationName="SOC" description="&quot;State of charge&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="cellData.SOCmax" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="true" elementName="showStartAttribute"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="currentSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-90,10},{-70,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Blocks.Continuous.LimIntegrator" isOver="true">
      <component_list isModificationOver="true" declarationName="limIntegrator" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1/(Np*cellData.Qnom)" elementName="k" isfinal="true"/>
        <modifications expression="1 - SOCtolerance" elementName="outMax"/>
        <modifications expression="SOCtolerance" elementName="outMin"/>
        <modifications expression="Modelica.Blocks.Types.Init.NoInit" elementName="initType" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-80,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Tables.CombiTable1Ds" isOver="true">
      <component_list isModificationOver="true" declarationName="ocv_soc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="cellData.OCV_SOC_internal" elementName="table" isfinal="true"/>
        <modifications expression="cellData.smoothness" elementName="smoothness" isfinal="true"/>
        <modifications expression="Modelica.Blocks.Types.Extrapolation.HoldLastPoint" elementName="extrapolation"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,40},{-50,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="gainV" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Ns*cellData.OCVmax" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-40,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SignalVoltage" isOver="true">
      <component_list declarationName="ocv" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-10},{-30,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Conductor" isOver="true">
      <component_list isModificationOver="true" declarationName="selfDischarge" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Np*cellData.Idis/(Ns*cellData.OCVmax)" elementName="G" isfinal="true"/>
        <modifications expression="293.15" elementName="T_ref"/>
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-30},{-50,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="r0" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="cellData.T_ref" elementName="T_ref" isfinal="true"/>
        <modifications expression="cellData.alpha" elementName="alpha" isfinal="true"/>
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PartialConditionalHeatPort" isOver="true"/>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.OCVmax > cellData.OCVmin, &quot;Specify 0 &lt;= OCVmin &lt; OCVmax&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.SOCmax > cellData.SOCmin, &quot;Specify 0 &lt;= SOCmin &lt; SOCmax &lt;= 1&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.OCV_SOC[1, 1] >= 0, &quot;Specify OCV(SOC) table with minimum SOC >= 0&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.OCV_SOC[end, 1] &lt;= 1, &quot;Specify OCV(SOC) table with maximum SOC &lt;= 1&quot; )"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.OCV_SOC[1, 2] >= 0, &quot;Specify OCV(SOC) table with minimum OCV/OCVmax >= 0&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cellData.OCV_SOC[end, 2] &lt;= 1, &quot;Specify OCV(SOC) table with maximum OCV/OCVmax &lt;= 1&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(SOC &lt; cellData.SOCmax + SOCtolerance, &quot;Battery overcharged!&quot;)"/>
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(SOC > cellData.SOCmin - SOCtolerance, &quot;Battery exhausted!&quot;)"/>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="gainV.y" right="ocv.v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,19},{-40,12}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ocv_soc.y[1]" right="gainV.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-49,50},{-40,50},{-40,42}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="limIntegrator.y" right="ocv_soc.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,41},{-80,50},{-72,50}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.n" right="ocv.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,0},{-50,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="limIntegrator.u" right="currentSensor.i">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,18},{-80,11}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="p" right="currentSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,0},{-90,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ocv.n" right="r0.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,0},{-10,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.p" right="selfDischarge.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,0},{-90, -20 } ,{-70,-20} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ocv.n" right="selfDischarge.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,0},{-30,-20},{-50,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="selfDischarge.heatPort" right="internalHeatPort">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,-30}, {-60,-40},{0,-40},{0,-80} }" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="internalHeatPort" right="r0.heatPort">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-80},{ 0,-10} }" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The battery is modeled by open-circuit voltage (OCV) dependent on state of charge (SOC), a self-discharge component and an inner resistance.&lt;br>Parameters are collected in parameter record &lt;a href=\&quot;modelica://Modelica.Electrical.Batteries.ParameterRecords.CellData\&quot;>cellData&lt;/a>.&lt;br>&#xA;All losses are dissipated to the optional &lt;code>heatPort&lt;/code>.&lt;/p>&lt;p>For details, see &lt;a href=\&quot;modelica://Modelica.Electrical.Batteries.UsersGuide.Concept\&quot;>concept&lt;/a> and &lt;a href=\&quot;modelica://Modelica.Electrical.Batteries.UsersGuide.Parameterization\&quot;>parameterization&lt;/a>.&#xA;&lt;/p>&lt;h4>Note&lt;/h4>&lt;p>SOC &amp;gt;&#xA;SOCmax and SOC &amp;lt;&#xA;SOCmin triggers an error.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
