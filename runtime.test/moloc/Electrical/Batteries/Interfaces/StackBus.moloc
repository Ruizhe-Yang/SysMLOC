  <within withName="Modelica.Electrical.Batteries.Interfaces"/>
  <classes isExpandable="true" classType="connector" className="StackBus" description="&quot;Measurement signal bus for a stack&quot;" isLongClassSpecifier="true" classNameEnd="StackBus" isOver="true">
