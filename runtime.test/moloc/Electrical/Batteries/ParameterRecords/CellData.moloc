<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Batteries.ParameterRecords">
  <classes classType="record" className="CellData" description="&quot;Parameters of a battery cell&quot;" isLongClassSpecifier="true" classNameEnd="CellData" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Batteries.Icons.BaseCellRecord" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ElectricCharge" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Qnom" description="&quot;Nominal (maximum) charge&quot;">
        <modifications expression="&quot;A.h&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list expression="true" declarationName="useLinearSOCDependency" description="&quot;Use a linear SOC dependent OCV, otherwise table based&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="OCVmax" description="&quot;OCV at SOC = SOCmax&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="min" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="OCVmin" description="&quot;OCV at SOC = SOCmin&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="min" isfinal="true"/>
        <modifications expression="0" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
          <modifications expression="useLinearSOCDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="SOCmax" description="&quot;Maximum state of charge&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="max" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="0" declarationName="SOCmin" description="&quot;Minimum state of charge&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="min" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[:,2]" expression="[SOCmin,OCVmin/OCVmax; SOCmax,1]" declarationName="OCV_SOC" description="&quot;OCV/OCVmax versus SOC table&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
          <modifications expression="not useLinearSOCDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Types.Smoothness" parameterType="parameter" isOver="true">
      <component_list expression="Modelica.Blocks.Types.Smoothness.LinearSegments" declarationName="smoothness" description="&quot;Smoothness of table interpolation&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
          <modifications expression="not useLinearSOCDependency" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isfinal="true" isOver="true">
      <component_list subscripts="[:,2]" expression="if useLinearSOCDependency then [SOCmin,OCVmin/OCVmax; SOCmax,1] else OCV_SOC" declarationName="OCV_SOC_internal" description="&quot;OCV/OCVmax versus SOC used internal&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;OCV versus SOC&quot;" elementName="group"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list declarationName="Ri" description="&quot;Total inner resistance (= OCVmax/Isc)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="293.15" declarationName="T_ref" description="&quot;Reference temperature&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.LinearTemperatureCoefficient" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="alpha" description="&quot;Temperature coefficient of resistance at T_ref&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="Idis" description="&quot;Self-discharge current at SOC = SOCmax&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="Ri" declarationName="R0" description="&quot;Inner resistance without parallel C&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;parameter&quot;" elementName="defaultComponentPrefixes"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Collects parameters of battery cells:&lt;/p>&#xA;&lt;ul>&#xA;&lt;li>Nominal charge&lt;/li>&#xA;&lt;li>OCV versus SOC characteristic&lt;/li>&#xA;&lt;li>Inner resistance; can be calculated from OCVmax / short-circuit current (at OCVmax)&lt;/li>&#xA;&lt;/ul>&#xA;&lt;h4>Note&lt;/h4>&#xA;&lt;p>&#xA;If &lt;code>useLinearSOCDependency=true&lt;/code>, the OCV versus SOC table is built up internally from &lt;code>OCVmax, OCVmin, SOCmax, SOCmin&lt;/code>.&lt;br>&#xA;Otherwise, the OCV versus SOC table has to be specified: 1st column = SOC values in ascending order, 2nd column = corresponding OCV values with respect to OCVmax.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
