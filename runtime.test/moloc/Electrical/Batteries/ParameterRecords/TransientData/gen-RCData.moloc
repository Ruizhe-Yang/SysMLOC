<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Batteries.ParameterRecords.TransientData"/>
  <classes classType="record" className="RCData" description="&quot;Parameters of RC-elements&quot;" isLongClassSpecifier="true" classNameEnd="RCData" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Batteries.Icons.TransientCellRecord" isOver="true">
      <extendsModifications expression="&quot;RC elements&quot;" elementName="CellType"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list declarationName="R" description="&quot;Resistance of RC-element&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="293.15" declarationName="T_ref" description="&quot;Reference temperature&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.LinearTemperatureCoefficient" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="alpha" description="&quot;Temperature coefficient of resistance at T_ref&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list declarationName="C" description="&quot;Capacitance of RC-element (=T/R)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;parameter&quot;" elementName="defaultComponentPrefixes"/>
      <annotations expression="&quot;rcData&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Parameters for RC-elements of battery models&lt;/p>&lt;h4>Note&lt;/h4>&lt;p>Capacitance C can be calculated from time constant T by C = T/R.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
