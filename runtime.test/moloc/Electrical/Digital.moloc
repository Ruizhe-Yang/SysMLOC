          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>MIMO is a partial model for the connection pattern with &lt;strong>m&lt;/strong>ultiple (vector) digital &lt;strong>i&lt;/strong>nput and &lt;strong>m&lt;/strong>ultiple  (vector) digital &lt;strong>o&lt;/strong>utput. Besides the connectors it provides a rectangle for the icon which can be filled in by the component which inherits the MISO model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" isPartial="true" classType="model" className="MemoryBase" description="&quot;Base model for memory elements&quot;" isLongClassSpecifier="true" classNameEnd="MemoryBase" isOver="true">
        <elements xsi:type="mOloc:ImportClause" selfName="D" importName="Modelica.Electrical.Digital" isOver="true"/>
        <elements xsi:type="mOloc:ImportClause" selfName="L" importName="Modelica.Electrical.Digital.Interfaces.Logic" isOver="true"/>
        <elements xsi:type="mOloc:ImportClause" selfName="S" importName="Modelica.Electrical.Digital.Interfaces.Strength" isOver="true"/>
        <elements xsi:type="mOloc:ImportClause" selfName="T" importName="Modelica.Electrical.Digital.Tables" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="tHL" description="&quot;High->Low delay&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="tLH" description="&quot;Low->High delay&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="S" parameterType="parameter" isOver="true">
          <component_list expression="S.'S_X01'" declarationName="strength" description="&quot;Output strength&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" expression="2" declarationName="n_addr" description="&quot;Addr width&quot;">
            <modifications expression="1" elementName="min"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" expression="2" declarationName="n_data" description="&quot;Data width&quot;">
            <modifications expression="1" elementName="min"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="String" parameterType="parameter" isOver="true">
          <component_list expression="Modelica.Utilities.Files.loadResource(&quot;modelica://Modelica/Resources/Data/Electrical/Digital/Memory_Matrix.txt&quot;)" declarationName="fileName" description="&quot;File where matrix for memory is stored&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Dialog">
              <modifications expression="&quot;Table data definition&quot;" elementName="group"/>
              <modifications isModificationOver="true" elementName="loadSelector">
                <modifications expression="&quot;Text files (*.txt)&quot;" elementName="filter"/>
                <modifications expression="&quot;Open file in which table is present&quot;" elementName="caption"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DigitalInput" isOver="true">
          <component_list declarationName="RE" description="&quot;Read enable&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{-100,-30},{-84,-14}}" elementName="extent"/>
              </modifications>
              <modifications isModificationOver="true" elementName="iconTransformation">
                <modifications expression="{{-100,-30},{-84,-14}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DigitalInput" isOver="true">
          <component_list subscripts="[n_addr]" declarationName="addr" description="&quot;Address&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{-100,50},{-80,70}}" elementName="extent"/>
              </modifications>
              <modifications isModificationOver="true" elementName="iconTransformation">
                <modifications expression="{{-100,50},{-80,70}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DigitalOutput" isOver="true">
          <component_list subscripts="[n_data]" declarationName="dataOut" description="&quot;Data output&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{80,10},{100,30}}" elementName="extent"/>
              </modifications>
              <modifications isModificationOver="true" elementName="iconTransformation">
                <modifications expression="{{80,10},{100,30}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="getMemory" description="&quot;Get Memory&quot;" isLongClassSpecifier="true" classNameEnd="getMemory" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="String" directionType="input" isOver="true">
            <component_list declarationName="filename"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="n_addr" description="&quot;Addr width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="n_data" description="&quot;Data width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="L" directionType="output" isOver="true">
            <component_list subscripts="[integer(2^n_addr),n_data]" declarationName="m" description="&quot;Memory with data, lowest bit on left side&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="String" directionType="output" isOver="true">
            <component_list declarationName="data"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="output" isOver="true">
            <component_list declarationName="bit"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:ForStatement" forIndices="i in 1:(2^n_addr)">
              <forStatements xsi:type="mOloc:FunctionStatement" component="data" expression="Modelica.Utilities.Streams.readLine(filename, integer(i))"/>
              <forStatements xsi:type="mOloc:ForStatement" forIndices="j in 1:n_data">
                <forStatements xsi:type="mOloc:FunctionStatement" component="bit" expression="Modelica.Utilities.Strings.scanInteger(data, (2*j-1))"/>
                <forStatements xsi:type="mOloc:IfStatement" condition="bit == 1">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="m[integer(i),j]" expression="L.'1'"/>
                  <elseCondition>bit == 0</elseCondition>
                  <elseifStatements xsi:type="mOloc:FunctionStatement" component="m[integer(i),j]" expression="L.'0'"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="m[integer(i),j]" expression="L.'X'"/>
                </forStatements>
              </forStatements>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="L" isProtected="true" isOver="true">
          <component_list subscripts="[n_data]" isModificationOver="true" declarationName="nextstate">
            <modifications expression="fill(L.'U',n_data)" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="L" isOver="true">
          <component_list subscripts="[n_data]" isModificationOver="true" declarationName="mem_word">
            <modifications expression="fill(L.'U',n_data)" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" isOver="true">
          <component_list declarationName="int_addr"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DigitalOutput" isOver="true">
          <component_list subscripts="[n_data]" isModificationOver="true" declarationName="yy">
            <modifications expression="fill(L.'U',n_data)" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="D.Delay.InertialDelaySensitive" isOver="true">
          <component_list subscripts="[n_data]" isModificationOver="true" declarationName="inertialDelaySensitive">
            <modifications expression="tLH" elementName="tLH" isEach="true"/>
            <modifications expression="tHL" elementName="tHL" isEach="true"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="address" description="&quot;Compute memory address&quot;" isLongClassSpecifier="true" classNameEnd="address" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="n_addr"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="L" directionType="input" isOver="true">
            <component_list subscripts="[n_addr]" declarationName="addr"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="output" isOver="true">
            <component_list declarationName="int_addr"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="L" isProtected="true" isOver="true">
            <component_list declarationName="addr_bit"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="int_addr" expression="1"/>
            <statements xsi:type="mOloc:ForStatement" forIndices="i in 1:n_addr">
              <forStatements xsi:type="mOloc:FunctionStatement" component="addr_bit" expression="T.X01Table[addr[i]]"/>
              <forStatements xsi:type="mOloc:IfStatement" condition="addr_bit == L.'1'">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="int_addr" expression="int_addr + integer(2^(i-1))"/>
                <elseCondition>addr_bit == L.'X'</elseCondition>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="int_addr" expression="0"/>
                <elseifStatements xsi:type="mOloc:BreakStatement"/>
              </forStatements>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ForEquation" forIndices="i in 1:n_data">
            <forEquations xsi:type="mOloc:ConnectEquation" left="yy[i]" right="inertialDelaySensitive[i].x"/>
            <forEquations xsi:type="mOloc:ConnectEquation" left="inertialDelaySensitive[i].y" right="dataOut[i]"/>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="true" elementName="preserveAspectRatio"/>
              <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
            </modifications>
            <modifications expression="{ Rectangle( extent={{-60,80},{60,-80}}, lineColor={127,0,127}, lineThickness=0.5 ) , Line( points={{-84,60},{-60,60}}, color={127,0,127}, thickness=1 ) , Line( points={{60,20},{84,20}}, color={127,0,127}, thickness=1 ) , Line( points={{-84,-20},{-60,-20}}, color={127,0,127} ) , Line( points={{-60,-10},{-46,-20},{-60,-30}}, color={127,0,127} ) , Text( extent={{-41,-5},{-24,-34}}, textColor={127,33,107}, textString=&quot;RE&quot; ) }" elementName="graphics"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package contains basic definitions: Type definitions of Logic and Strength, interface definitions (connectors) for digital electrical components, and partial models for connection patterns which are often used.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="package" className="Tables" description="&quot;Truth tables for all components of package Digital&quot;" isLongClassSpecifier="true" classNameEnd="Tables" isOver="true">
      <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
