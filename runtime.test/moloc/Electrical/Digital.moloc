      <elements xsi:type="mOloc:GeneralClause" classType="type" className="Strength" description="&quot;Output strengths of registers&quot;" isAnnotation="true" isAnnotationOver="true" isShortClassSpecifier="true" isEnumeration="true" isOver="true">
        <enumerationLiteral description="&quot;S_X01  Forcing X, 0 and 1&quot;" title="'S_X01'"/>
        <enumerationLiteral description="&quot;S_X0H  Forcing X, 0 and Weak 1&quot;" title="'S_X0H'"/>
        <enumerationLiteral description="&quot;S_XL1  Forcing X, 1 and Weak 0&quot;" title="'S_XL1'"/>
        <enumerationLiteral description="&quot;S_X0Z  Forcing X, 0 and High Impedance&quot;" title="'S_X0Z'"/>
        <enumerationLiteral description="&quot;S_XZ1  Forcing X, 1 and High Impedance&quot;" title="'S_XZ1'"/>
        <enumerationLiteral description="&quot;S_WLH  Weak X, 0 and 1&quot;" title="'S_WLH'"/>
        <enumerationLiteral description="&quot;S_WLZ  Weak X, 0 and High Impedance&quot;" title="'S_WLZ'"/>
        <enumerationLiteral description="&quot;S_WZH  Weak X, 1 and High Impedance&quot;" title="'S_WZH'"/>
        <enumerationLiteral description="&quot;S_W0H  Weak X, 1 and Forcing 0&quot;" title="'S_W0H'"/>
        <enumerationLiteral description="&quot;S_WL1  Weak X, 0 and Forcing 1&quot;" title="'S_WL1'"/>
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&#xA;&lt;p>&lt;strong>Strength Table:&lt;/strong>&lt;/p>&#xA;&#xA;&lt;table border=\&quot;1\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;>&#xA;  &lt;tr>&lt;td>&lt;strong>Strength&lt;/strong>&lt;/td>&#xA;      &lt;td>&lt;strong>Output conversion to&lt;/strong>&lt;/td>&#xA;  &lt;/tr>&#xA;&#xA;  &lt;tr>&lt;td>'S_X01'&lt;/td> &lt;td>Forcing X, 0, 1&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_X0H'&lt;/td> &lt;td>Forcing X, 0 and Weak 1&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_XL1'&lt;/td> &lt;td>Forcing X, 1 and Weak 0&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_X0Z'&lt;/td> &lt;td>Forcing X, 0 and High Impedance&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_XZ1'&lt;/td> &lt;td>Forcing X, 1 and High Impedance&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_WLH'&lt;/td> &lt;td>Weak X, 0, 1&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_WLZ'&lt;/td> &lt;td>Weak X, 0 and High Impedance&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_WZH'&lt;/td> &lt;td>Weak X, 1 and High Impedance&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_W0H'&lt;/td> &lt;td>Weak X, 1 and Forcing 0&lt;/td>&lt;/tr>&#xA;  &lt;tr>&lt;td>'S_WL1'&lt;/td> &lt;td>Weak X, 0 and Forcing 1&lt;/td>&lt;/tr>&#xA;&lt;/table>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="connector" className="DigitalSignal" description="&quot;Digital port (both input/output possible)&quot;" typeSpecifier="Logic" isAnnotation="true" isAnnotationOver="true" isShortClassSpecifier="true" isOver="true">
