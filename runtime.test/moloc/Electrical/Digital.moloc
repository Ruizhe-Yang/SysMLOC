        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Enable.y" right="Counter.enable">
            <annotations isModificationOver="true" elementName="Line">
