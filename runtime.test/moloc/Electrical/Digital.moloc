        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Digital.Examples.Utilities.FullAdder" isOver="true">
          <component_list isModificationOver="true" declarationName="Adder1" isAnnotation="true" isAnnotationOver="true">
            <modifications isModificationOver="true" elementName="Adder1">
              <modifications isModificationOver="true" elementName="AND">
