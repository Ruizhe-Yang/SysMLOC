        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="b.y" right="Adder. b">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-60,-28},{-40,-28}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="a.y" right="Adder. a">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-60,28},{-40,28}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Adder.s" right="s.x[1]">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{40,28},{65,28}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Adder.c" right="c.x[1]">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{40,-28},{65,-28}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This example demonstrates an adding circuit for binary numbers, which internally realizes the interconnection to&#xA;And and to Xor in the final sum.&lt;/p>&#xA;&lt;br>&#xA;&lt;br>&#xA;1 + 0 = 1&lt;br>&#xA;0 + 1 = 1&lt;br>&#xA;1 + 1 = 10&lt;br>&#xA;0 + 0 = 0&#xA;&lt;br>&#xA;&lt;br>&#xA;&lt;strong>a&lt;/strong> + &lt;strong>b&lt;/strong> = &lt;strong>s&lt;/strong>&#xA;&lt;br>(The carry of this adding is &lt;strong>c&lt;/strong>.)&#xA;&lt;br>&#xA;&lt;br>and&#xA;&lt;br>&#xA;&lt;br>&#xA;&lt;strong>a&lt;/strong> * &lt;strong>b&lt;/strong> = &lt;strong>s&lt;/strong>&#xA;&lt;br>  (It is an interconnection to And.)&#xA;&lt;br>&#xA;&lt;br>&#xA;&lt;strong>a&lt;/strong> * &lt;strong>b&lt;/strong> + &lt;strong>a&lt;/strong> * &lt;strong>b&lt;/strong> = &lt;strong>a&lt;/strong> Xor &lt;strong>b&lt;/strong> = &lt;strong>c&lt;/strong>&#xA;&lt;br>(It is an interconnection to Xor.)&#xA;&lt;br>&#xA;&lt;blockquote>&lt;pre>&#xA;&lt;strong>a&lt;/strong>     &lt;strong>b&lt;/strong>     &lt;strong>c&lt;/strong>      &lt;strong>s&lt;/strong>     &lt;strong>t&lt;/strong>&#xA;&#xA;1     0     1      0     1&#xA;0     1     1      0     2&#xA;1     1     0      1     3&#xA;0     0     0      0     4&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;p>&#xA;&lt;strong>t&lt;/strong> is the pick-up instant of the next bit(s) in the simulation.&#xA;The simulation stop time should be 5 seconds.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
          <annotations isModificationOver="true" elementName="experiment">
            <modifications expression="5" elementName="StopTime"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="model" className="FullAdder" description="&quot;Full 1 Bit Adder Example&quot;" isLongClassSpecifier="true" classNameEnd="FullAdder" isOver="true">
        <elements xsi:type="mOloc:ImportClause" selfName="D" importName="Modelica.Electrical.Digital" isOver="true"/>
        <elements xsi:type="mOloc:ImportClause" selfName="L" importName="Modelica.Electrical.Digital.Interfaces.Logic" isOver="true"/>
