          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="D.Registers.DLATSR" isOver="true">
          <component_list isModificationOver="true" declarationName="dLATSR" isAnnotation="true" isAnnotationOver="true">
            <modifications expression="n" elementName="n"/>
            <modifications expression="ResetSetMap" elementName="ResetSetMap"/>
            <modifications expression="strength" elementName="strength"/>
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{-78,-23},{18,74}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="delay.y" right="dataOut">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{72.08,40},{92,40}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
              <modifications expression="1" elementName="thickness"/>
            </annotations>
          </equations>
