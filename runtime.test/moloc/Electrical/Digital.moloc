            </modifications>
            <modifications expression="{ Text( extent={{152,-160},{-148,-100}}, textColor={0,0,255}, textString=&quot;%name&quot; ) , Rectangle( extent={{-50,100},{50,-100}}, lineThickness=0.5, fillColor={213,170,255}, fillPattern=FillPattern.Solid ) , Text( extent={{-18,-60},{20,-100}}, textString=&quot;Gate&quot; ) , Text( extent={{-50,80},{50,40}}, textString=&quot;1&quot; ) }" elementName="graphics"/>
          </annotations>
