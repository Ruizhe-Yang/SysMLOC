        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dFFSR.dataOut" right="delay.x">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{9.5,40},{26.92,40},{26.92,39.86}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
              <modifications expression="1" elementName="thickness"/>
