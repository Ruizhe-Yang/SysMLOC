              </modifications>
            </modifications>
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{23,12},{79,68}}" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
