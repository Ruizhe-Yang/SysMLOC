            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>HalfAdder is a two bit adder which is composed by Gates components.&lt;/p>&#xA;&lt;p>Its logic behavior is like this:&lt;/p>&#xA;&lt;p>&lt;strong>HalfAdder behavior&lt;/strong>&lt;/p>&#xA;&lt;table cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot; border=\&quot;1\&quot;>&lt;tr>&#xA;&lt;td>&lt;h4>input a&lt;/h4>&lt;/td>&#xA;&lt;td>&lt;h4>input b&lt;/h4>&lt;/td>&#xA;&lt;td>&lt;h4>sum s&lt;/h4>&lt;/td>&#xA;&lt;td>&lt;h4>carry c&lt;/h4>&lt;/td>&#xA;&lt;/tr>&#xA;&lt;tr>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;/tr>&#xA;&lt;tr>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;/tr>&#xA;&lt;tr>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;/tr>&#xA;&lt;tr>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>0&lt;/p>&lt;/td>&#xA;&lt;td>&lt;p>1&lt;/p>&lt;/td>&#xA;&lt;/tr>&#xA;&lt;/table>&#xA;&lt;p>The parameter delayTime is the delay time (tLH=tHL) of both the components.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
