              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="CLK.y" right="Counter.count">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-70,-12},{-60,-12}}" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Enable.y" right="Counter.enable">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-70,16},{-60, 16 } }" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Counter.q2" right="Adder1.a">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-20,16},{-10,16}, {-10,21},{0,21} }" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Counter.q1" right="Adder1.b">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-20,2},{-10,2},{ -10,9} ,{0,9} }" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Counter.q0" right="Adder1.c_in">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-20,-12},{-10, -12 } ,{-10,-21},{0,-21} }" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
            </annotations>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;&lt;br>It is an adding circuit for binary numbers with input carry bit, which consists of two HalfAdders.&#xA;&lt;br>&#xA;&lt;br>&#xA;&lt;strong>a&lt;/strong>.y, &lt;strong>b&lt;/strong>.y and &lt;strong>c&lt;/strong>.y are the inputs of the FullAdder.&#xA;&lt;br>&#xA;&lt;strong>c&lt;/strong>out = &lt;strong>Or1&lt;/strong>.y and &lt;strong>h&lt;/strong>.s are the outputs of the FullAdder.&#xA;&lt;br>&#xA;&lt;br>&#xA;&lt;strong>t&lt;/strong> is the pick-up instant of the next bit(s) in the simulation.&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;&lt;strong>a&lt;/strong>.y      &lt;strong>b&lt;/strong>.y     &lt;strong>c&lt;/strong>.y      &lt;strong>c&lt;/strong>out       &lt;strong>h&lt;/strong>.s        &lt;strong>t&lt;/strong>&#xA;&#xA;1        0        0        0          1        1&#xA;0        1        0        0          1        2&#xA;0        0        1        0          1        3&#xA;1        1        0        1          0        4&#xA;0        1        1        1          0        5&#xA;1        0        1        1          0        6&#xA;1        1        1        1          1        7&#xA;0        0        0        0          0        8&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;p>&#xA;The simulation stop time should be 10 seconds.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
          <annotations isModificationOver="true" elementName="experiment">
            <modifications expression="10" elementName="StopTime"/>
          </annotations>
        </elements>
      </elements>
