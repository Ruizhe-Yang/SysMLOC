          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="D.Interfaces.DigitalOutput" isOver="true">
          <component_list subscripts="[n]" declarationName="y" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{40,-10}, {60,10} }" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" declarationName="n" description="&quot;Signal width&quot;">
            <modifications expression="1" elementName="min" isfinal="true"/>
            <modifications expression="1" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:AlgorithmSection">
          <statements xsi:type="mOloc:ForStatement" forIndices="i in 1:n">
            <forStatements xsi:type="mOloc:FunctionStatement" component="y[i]" expression="T.X01Table[x[i]]"/>
          </statements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Conversion of a nine valued digital input into a X01 digital output without&#xA;any delay according to IEEE 1164 To_X01 function.&#xA;&lt;/p>&#xA;&lt;p>&lt;strong>Conversion Table:&lt;/strong>&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;input                  output&#xA;'U' (coded by 1)       'X'  (coded by 2)&#xA;'X' (coded by 2)       'X'  (coded by 2)&#xA;'0' (coded by 3)       '0'  (coded by 3)&#xA;'1' (coded by 4)       '1'  (coded by 4)&#xA;'Z' (coded by 5)       'X'  (coded by 2)&#xA;'W' (coded by 6)       'X'  (coded by 2)&#xA;'L' (coded by 7)       '0'  (coded by 3)&#xA;'H' (coded by 8)       '1'  (coded by 4)&#xA;'-' (coded by 9)       'X'  (coded by 2)&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;p>&#xA;If the signal width is greater than 1 this conversion is done for each signal.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>September 15, 2004&lt;/em>&#xA;       by Christoph Clauss name converted from cvt_to_x01 into LogicToX01&lt;br>&#xA;       &lt;/li>&#xA;&lt;li>&lt;em>November 5, 2003&lt;/em>&#xA;       by Christoph Clauss&lt;br>&#xA;       initially modelled.&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Icon">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="true" elementName="preserveAspectRatio"/>
              <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
            </modifications>
            <modifications expression="{ Text( extent={{152,-100},{-148,-40}}, textColor={0,0,255}, textString=&quot;%name&quot; ) , Polygon( points={{-40,-40},{-40,40},{40,40},{-40,-40}}, lineColor={127,0,127}, fillColor={127,0,127}, fillPattern=FillPattern.Solid ) , Polygon( points={{-40,-40},{40,-40},{40,40},{-40,-40}}, lineColor={127,0,127}, lineThickness=0.5, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Text( extent={{0,-20},{40,-40}}, textString=&quot;X01&quot; ) , Rectangle( extent={{-40,40},{40,-40}}, lineThickness=0.5 ) }" elementName="graphics"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="block" className="LogicToX01Z" description="&quot;Conversion to X01Z&quot;" isLongClassSpecifier="true" classNameEnd="LogicToX01Z" isOver="true">
