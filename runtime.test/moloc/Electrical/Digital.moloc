        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Adder1.s" right="s.x[1]">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{60.3,21},{68,21},{68, 22 } ,{75,22} }" elementName="points"/>
              <modifications expression="{127,0,127}" elementName="color"/>
