        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Digital.Examples.Utilities.HalfAdder" isOver="true">
          <component_list isModificationOver="true" declarationName="Adder" isAnnotation="true" isAnnotationOver="true">
