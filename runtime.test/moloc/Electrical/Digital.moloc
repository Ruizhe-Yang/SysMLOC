              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Digital.Converters.LogicToReal" isOver="true">
          <component_list isModificationOver="true" declarationName="s" isAnnotation="true" isAnnotationOver="true">
            <modifications expression="1" elementName="n"/>
            <modifications expression="0.5" elementName="value_U"/>
            <modifications expression="0.5" elementName="value_X"/>
            <modifications expression="0" elementName="value_0"/>
            <modifications expression="1" elementName="value_1"/>
            <modifications expression="0.5" elementName="value_Z"/>
            <modifications expression="0.5" elementName="value_W"/>
            <modifications expression="0" elementName="value_L"/>
            <modifications expression="1" elementName="value_H"/>
            <modifications expression="0.5" elementName="value_m"/>
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
                <modifications expression="{{60, 18 } ,{80,38} }" elementName="extent"/>
              </modifications>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Digital.Converters.LogicToReal" isOver="true">
          <component_list isModificationOver="true" declarationName="c" isAnnotation="true" isAnnotationOver="true">
            <modifications expression="1" elementName="n"/>
            <modifications expression="0.5" elementName="value_U"/>
            <modifications expression="0.5" elementName="value_X"/>
            <modifications expression="0" elementName="value_0"/>
            <modifications expression="1" elementName="value_1"/>
            <modifications expression="0.5" elementName="value_Z"/>
            <modifications expression="0.5" elementName="value_W"/>
            <modifications expression="0" elementName="value_L"/>
            <modifications expression="1" elementName="value_H"/>
            <modifications expression="0.5" elementName="value_m"/>
            <annotations isModificationOver="true" elementName="Placement">
              <modifications isModificationOver="true" elementName="transformation">
