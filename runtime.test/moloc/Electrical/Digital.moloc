              <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
            </modifications>
            <modifications expression="{ Text( extent={{152,-100},{-148,-40}}, textColor={0,0,255}, textString=&quot;%name&quot; ) , Polygon( points={{-40,-40},{-40,40},{40,40},{-40,-40}}, lineColor={127,0,127}, fillColor={127,0,127}, fillPattern=FillPattern.Solid ) , Polygon( points={{-40,-40},{40,-40},{40,40},{-40,-40}}, lineColor={127,0,127}, lineThickness=0.5, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Text( extent={{0,-20},{40,-40}}, textString=&quot;X01Z&quot; ) , Rectangle( extent={{-40,40},{40,-40}}, lineThickness=0.5 ) }" elementName="graphics"/>
