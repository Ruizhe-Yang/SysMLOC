<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.BasicMachines.Components">
  <classes classType="model" className="AirGapDC" description="&quot;Linear airgap model of a DC machine&quot;" isLongClassSpecifier="true" classNameEnd="AirGapDC" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PartialAirGapDC" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list declarationName="Le" description="&quot;Excitation inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="psi_e" right="Le*ie"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;airGap&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Linear model of the airgap (without saturation effects) of a DC machine, using only equations.&lt;br>&#xA;Induced excitation voltage is calculated from der(flux), where flux is defined by excitation inductance times excitation current.&lt;br>&#xA;Induced armature voltage is calculated from flux times angular velocity.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
