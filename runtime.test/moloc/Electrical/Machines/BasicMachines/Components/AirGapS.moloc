<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.BasicMachines.Components"/>
  <classes classType="model" className="AirGapS" description="&quot;Airgap in stator-fixed coordinate system&quot;" isLongClassSpecifier="true" classNameEnd="AirGapS" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list declarationName="Lm" description="&quot;Main field inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PartialAirGap" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_ms" description="&quot;Magnetizing current space phasor with respect to the stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isProtected="true" isOver="true">
      <component_list subscripts="[2, 2]" expression="{{Lm,0},{0,Lm}}" declarationName="L" description="&quot;Inductance matrix&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="i_ms" right="i_ss + i_rs"/>
      <equations xsi:type="mOloc:SimpleEquation" left="psi_ms" right="L*i_ms"/>
      <equations xsi:type="mOloc:SimpleEquation" left="psi_mr" right="transpose(RotationMatrix)*psi_ms"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;airGap&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-80,40},{0,-40}}, textString=&quot;S&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Model of the airgap in stator-fixed coordinate system, using only equations.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
