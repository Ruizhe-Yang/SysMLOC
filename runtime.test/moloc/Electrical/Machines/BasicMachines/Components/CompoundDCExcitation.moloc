<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.BasicMachines.Components">
  <classes classType="model" className="CompoundDCExcitation" description="&quot;Compound excitation = shunt + series&quot;" isLongClassSpecifier="true" classNameEnd="CompoundDCExcitation" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list declarationName="excitationTurnsRatio" description="&quot;Ratio of series excitation turns over shunt excitation turns&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="pin_p.v - pin_n.v" declarationName="v"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="pin_p.i" declarationName="i"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="pin_ep.v - pin_en.v" declarationName="ve"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="pin_ep.i" declarationName="ie"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="pin_sep.v - pin_sen.v" declarationName="vse"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="pin_sep.i" declarationName="ise"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_p" description="&quot;Positive pin to airgap&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,110},{110,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_n" description="&quot;Negative pin to airgap&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,110},{-90,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_ep" description="&quot;Positive pin to shunt excitation&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-108},{110,-88}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_en" description="&quot;Negative pin to shunt excitation&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-110},{30,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_sep" description="&quot;Positive pin to series excitation&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-30,-110},{-10,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_sen" description="&quot;Negative pin to series excitation&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-110},{-90,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="pin_p.i + pin_n.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="pin_ep.i + pin_en.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="pin_sep.i + pin_sen.i" right="0"/>
      <equations xsi:type="mOloc:SimpleEquation" left="-i" right="ie + excitationTurnsRatio*ise"/>
      <equations xsi:type="mOloc:SimpleEquation" left="ve" right="v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="vse" right="v*excitationTurnsRatio"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;excitation&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Polygon( points={{-60,-40},{-40,-40},{0,4},{40,-40},{60,-40},{10, 20 } ,{10,60},{20,60},{0,80},{-20,60},{-10,60},{-10,20},{-60,-40} } , lineColor={0,0,255}, fillColor={0,0,255}, fillPattern=FillPattern.Solid ) ,Text( extent={{-80,-40},{-40,-80}}, textColor={0,0,255}, textString=&quot;S&quot; ) ,Text( extent={{40,-40},{80,-80}}, textColor={0,0,255}, textString=&quot;E&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Model to compound the shunt excitation current and the series excitation current to the total excitation current w.r.t. shunt excitation.&#xA;This model is intended to be placed between shunt and series excitation pins and the airgap;&#xA;the connection to airgap has to be grounded at one point.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
