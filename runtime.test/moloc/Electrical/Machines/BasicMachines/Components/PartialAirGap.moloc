<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.BasicMachines.Components">
  <classes isPartial="true" classType="model" className="PartialAirGap" description="&quot;Partial airgap model&quot;" isLongClassSpecifier="true" classNameEnd="PartialAirGap" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="p" description="&quot;Number of pole pairs&quot;">
        <modifications expression="1" elementName="min"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Torque" directionType="output" isOver="true">
      <component_list declarationName="tauElectrical"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Angle" isOver="true">
      <component_list declarationName="gamma" description="&quot;Rotor displacement angle&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_ss" description="&quot;Stator current space phasor with respect to the stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_sr" description="&quot;Stator current space phasor with respect to the rotor fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_rs" description="&quot;Rotor current space phasor with respect to the stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_rr" description="&quot;Rotor current space phasor with respect to the rotor fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.MagneticFlux" isOver="true">
      <component_list subscripts="[2]" declarationName="psi_ms" description="&quot;Magnetizing flux phasor with respect to the stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.MagneticFlux" isOver="true">
      <component_list subscripts="[2]" declarationName="psi_mr" description="&quot;Magnetizing flux phasor with respect to the rotor fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list subscripts="[2, 2]" declarationName="RotationMatrix" description="&quot;Matrix of rotation from rotor to stator&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Mechanics.Rotational.Interfaces.Flange_a" isPublic="true" isOver="true">
      <component_list declarationName="flange" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,110},{10,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Mechanics.Rotational.Interfaces.Flange_a" isOver="true">
      <component_list declarationName="support" description="&quot;Support at which the reaction torque is acting&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-110},{10,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Interfaces.SpacePhasor" isOver="true">
      <component_list declarationName="spacePhasor_s" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,90},{-90,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Interfaces.SpacePhasor" isOver="true">
      <component_list declarationName="spacePhasor_r" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,90},{110,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="gamma" right="p*(flange.phi - support.phi)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="RotationMatrix" right="{{+cos(gamma),-sin(gamma)},{+sin(gamma),+cos(gamma)}}"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i_ss" right="spacePhasor_s.i_"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i_ss" right="RotationMatrix*i_sr"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i_rr" right="spacePhasor_r.i_"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i_rs" right="RotationMatrix*i_rr"/>
      <equations xsi:type="mOloc:SimpleEquation" left="spacePhasor_s.v_" right="der(psi_ms)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="spacePhasor_r.v_" right="der(psi_mr)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="tauElectrical" right="m/2*p*(spacePhasor_s.i_[2]*psi_ms[1] - spacePhasor_s.i_[ 1] *psi_ms[2] )"/>
      <equations xsi:type="mOloc:SimpleEquation" left="flange.tau" right="-tauElectrical"/>
      <equations xsi:type="mOloc:SimpleEquation" left="support.tau" right="tauElectrical"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Ellipse( extent={{-90,90},{90,-92}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Ellipse(extent={{-80,80},{80,-80}}, lineColor={0,0,255}), Rectangle( extent={{-10,90},{10,-80}}, fillPattern=FillPattern.VerticalCylinder, fillColor={128,128,128} ) , Text( extent={{-150,-110},{150,-150}}, textColor={0,0,255}, textString=&quot;%name&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Partial model of the airgap, using only equations.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
