<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.BasicMachines.Components"/>
  <classes classType="model" className="AirGapR" description="&quot;Airgap in rotor-fixed coordinate system&quot;" isLongClassSpecifier="true" classNameEnd="AirGapR" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list declarationName="Lmd" description="&quot;Main field inductance d-axis&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list declarationName="Lmq" description="&quot;Main field inductance q-axis&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PartialAirGap" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[2]" declarationName="i_mr" description="&quot;Magnetizing current space phasor with respect to the rotor fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isProtected="true" isOver="true">
      <component_list subscripts="[2, 2]" expression="{{Lmd,0},{0,Lmq}}" declarationName="L" description="&quot;Inductance matrix&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="i_mr" right="i_sr + i_rr"/>
      <equations xsi:type="mOloc:SimpleEquation" left="psi_mr" right="L*i_mr"/>
      <equations xsi:type="mOloc:SimpleEquation" left="psi_ms" right="RotationMatrix*psi_mr"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;airGap&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{0,40},{80,-40}}, textString=&quot;R&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>Model of the airgap in rotor-fixed coordinate system, using only equations.&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
