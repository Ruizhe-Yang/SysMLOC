    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>This package contains components for modeling electrical machines, specially three-phase induction machines, based on space phasor theory.These models use package SpacePhasors.&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;dl> &lt;dt>&lt;strong>Main Authors:&lt;/strong>&lt;/dt> &lt;dd> &lt;a href=\&quot;https://www.haumer.at/\&quot;>Anton Haumer&lt;/a>&lt;br>&#xA;Technical Consulting &amp;amp;&#xA;Electrical Engineering&lt;br> D-93049 Regensburg&lt;br>Germany&lt;br> email: &lt;a href=\&quot;mailto:a.haumer@haumer.at\&quot;>a.haumer@haumer.at&lt;/a> &lt;/dd>&lt;/dl> &lt;ul> &lt;li> v1.00 2004/09/16 Anton Haumer&lt;/li> &lt;li> v1.02 2004/09/19 Anton Haumer&lt;br> added AirGapDC models&lt;/li> &lt;li> v1.2 2004/10/27 Anton Haumer&lt;br> fixed a bug with support (formerly bearing)&lt;/li> &lt;li> v1.52 2005/10/12 Anton Haumer&lt;br> added electrical excitation&lt;/li> &lt;li> v1.53 Beta 2005/10/14 Anton Haumer&lt;br> introduced unsymmetrical DamperCage for Synchronous Machines&lt;/li> &lt;li> v2.1.3 2010/02/10 Anton Haumer&lt;br> prepared ConditionalHeatPort of SquirrelCage and DamperCage&lt;/li> &lt;li> v2.2.0 2011/02/10 Anton Haumer&lt;br> conditional ThermalPort for all machines&lt;/li> &lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
    </elements>
