  <within withName="Modelica.Electrical.Machines.BasicMachines.Transformers.Dz"/>
  <classes classType="model" className="Dz06" description="&quot;Transformer Dz6&quot;" isLongClassSpecifier="true" classNameEnd="Dz06" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Interfaces.PartialBasicTransformer" isOver="true">
