        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-30},{30,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star1.pin_n" right="starpoint1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-90},{ -10,-100} ,{-50,-100} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="Delta2.plug_n" right="r2.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,20},{ 70,20} ,{70,0} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="l2sigma.plug_n" right="Rot2.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,0}, {70,-10},{50,-10},{50,-20} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="l1sigma.plug_n" right="core.plug_p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,0}, {-50,20},{-10,20},{-10,5} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="core.plug_n1" right="star1.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-5}, {-10,-70},{-10,-70} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="core.plug_n2" right="core.plug_p3">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,4},{10,-4}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="core.plug_p2" right="Delta2.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,10}, {10,20},{30,20} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
