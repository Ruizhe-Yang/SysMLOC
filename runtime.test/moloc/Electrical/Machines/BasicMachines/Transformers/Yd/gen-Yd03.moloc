          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{30,10},{50,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Delta" isOver="true">
      <component_list isModificationOver="true" declarationName="Rot2" isAnnotation="true" isAnnotationOver="true">
