<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.ControlledDCDrives.Utilities"/>
  <classes classType="model" className="DcdcInverter" description="&quot;DC-DC inverter&quot;" isLongClassSpecifier="true" classNameEnd="DcdcInverter" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list expression="true" declarationName="useIdealInverter" description="&quot;Use ideal averaging inverter, otherwise switching inverter&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list declarationName="fS" description="&quot;Switching frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.5/fS" declarationName="Td" description="&quot;Dead time&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="2/fS" declarationName="Tmf" description="&quot;Measurement filter time constant&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list declarationName="VMax" description="&quot;Maximum Voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="1e-6" declarationName="Ti" description="&quot;Time constant of integral power controller&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Averaging&quot;" elementName="group"/>
          <modifications expression="useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="RonT" description="&quot;Transistor closed resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="GoffT" description="&quot;Transistor opened conductance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="VkneeT" description="&quot;Transistor threshold voltage&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="RonD" description="&quot;Diode closed resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="GoffD" description="&quot;Diode opened conductance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="VkneeD" description="&quot;Diode threshold voltage&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Switching&quot;" elementName="group"/>
          <modifications expression="not useIdealInverter" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" directionType="output" isOver="true">
      <component_list expression="vDC*iDC" declarationName="pDC" description="&quot;DC power (from battery)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" directionType="output" isOver="true">
      <component_list expression="vMot*iMot" declarationName="pMot" description="&quot;Power to motor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pBat" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,110},{70,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nBat" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,110},{-50,90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-70,110},{-50,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-110},{70,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-110},{-50,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list declarationName="vRef" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list declarationName="vDC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-110,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list declarationName="iDC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{110,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list declarationName="vMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{110,-60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list declarationName="iMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-110,-60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="vDCSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{0,100}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="iMotSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-70},{-30,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Nonlinear.VariableLimiter" isOver="true">
      <component_list declarationName="variableLimiter" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-10},{-50,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="gain" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="-1" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-6,-6},{6,6}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-90,20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Continuous.FirstOrder" isOver="true">
      <component_list isModificationOver="true" declarationName="vDCFilter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="k"/>
        <modifications expression="Tmf" elementName="T"/>
        <modifications expression="Modelica.Blocks.Types.Init.InitialOutput" elementName="initType"/>
        <modifications expression="VMax" elementName="y_start"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,50},{-80,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Continuous.FirstOrder" isOver="true">
      <component_list isModificationOver="true" declarationName="iMotFilter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="k"/>
        <modifications expression="Tmf" elementName="T"/>
        <modifications expression="Modelica.Blocks.Types.Init.InitialOutput" elementName="initType"/>
        <modifications expression="0" elementName="y_start"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-70},{-80,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="IdealDcDc" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDcDc" isAnnotation="true" isAnnotationOver="true" condition_attribute="useIdealInverter">
        <modifications expression="Td" elementName="Td"/>
        <modifications expression="Ti" elementName="Ti"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-30},{30,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SwitchingDcDc" isOver="true">
      <component_list isModificationOver="true" declarationName="switchingDcDc" isAnnotation="true" isAnnotationOver="true" condition_attribute="not useIdealInverter">
        <modifications expression="fS" elementName="fS"/>
        <modifications expression="VMax" elementName="VMax"/>
        <modifications expression="RonT" elementName="RonT"/>
        <modifications expression="GoffT" elementName="GoffT"/>
        <modifications expression="VkneeT" elementName="VkneeT"/>
        <modifications expression="RonD" elementName="RonD"/>
        <modifications expression="GoffD" elementName="GoffD"/>
        <modifications expression="VkneeD" elementName="VkneeD"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-30,10},{-10,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="iDCSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,70},{30,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="vMotSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{0,-100}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Continuous.FirstOrder" isOver="true">
      <component_list isModificationOver="true" declarationName="vMotFilter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="k"/>
        <modifications expression="Tmf" elementName="T"/>
        <modifications expression="Modelica.Blocks.Types.Init.InitialOutput" elementName="initType"/>
        <modifications expression="0" elementName="y_start"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,-70},{80,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Continuous.FirstOrder" isOver="true">
      <component_list isModificationOver="true" declarationName="iDCFilter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="k"/>
        <modifications expression="Tmf" elementName="T"/>
        <modifications expression="Modelica.Blocks.Types.Init.InitialOutput" elementName="initType"/>
        <modifications expression="VMax" elementName="y_start"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,50},{80,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iMotSensor.p" right="pin_nMot">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,-80},{ -60,-80} ,{-60,-100} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vRef" right="variableLimiter.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,0},{-72,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="gain.y" right="variableLimiter.limit2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,13.4},{-90,-8},{-72,-8}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iMotSensor.i" right="iMotFilter.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,-69},{-40,-60},{-58,-60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iMotFilter.y" right="iMot">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-81,-60},{-110,-60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vDCFilter.y" right="vDC">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-81,60},{-110,60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vDCFilter.y" right="gain.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-81,60},{-90,60},{-90,27.2}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vDCFilter.y" right="variableLimiter.limit1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-81,60}, {-90,60},{-90,40},{-80,40},{-80,8},{-72,8} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableLimiter.y" right="idealDcDc.vRef">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-49,0},{-40, 0 } ,{-40,-20},{8,-20} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableLimiter.y" right="switchingDcDc.vRef">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-49,0},{-40,0},{-40,20},{-32,20}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vDCFilter.y" right="switchingDcDc.vMax">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-81,60},{-90, 60 } ,{-90,40},{-40,40},{-40,26},{-32,26} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iDCSensor.p" right="pin_pBat">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,80},{60,80},{60,100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iMotSensor.n" right="switchingDcDc.pin_nMot">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-80},{-30,-80},{-30,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vMotFilter.y" right="vMot">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{81,-60},{110,-60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iDCSensor.i" right="iDCFilter.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,69},{40,60},{58,60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="iDCFilter.y" right="iDC">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{81,60},{110,60}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDcDc.pin_pBat" right="iDCSensor.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{30,-10},{30,80}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_nBat" right="switchingDcDc.pin_nBat">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,100},{-30,100},{-30,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
