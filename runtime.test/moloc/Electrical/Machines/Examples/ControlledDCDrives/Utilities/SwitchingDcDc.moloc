<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Examples.ControlledDCDrives.Utilities">
  <classes classType="model" className="SwitchingDcDc" description="&quot;Switching DC-DC inverter&quot;" isLongClassSpecifier="true" classNameEnd="SwitchingDcDc" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list declarationName="fS" description="&quot;Switching frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list declarationName="VMax" description="&quot;Maximum Voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="RonT" description="&quot;Transistor closed resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="GoffT" description="&quot;Transistor opened conductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="VkneeT" description="&quot;Transistor threshold voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="RonD" description="&quot;Diode closed resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list expression="1e-05" declarationName="GoffD" description="&quot;Diode opened conductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="VkneeD" description="&quot;Diode threshold voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.PowerConverters.DCDC.Control.Voltage2DutyCycle" isOver="true">
      <component_list isModificationOver="true" declarationName="adaptor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="useConstantVoltageLimit"/>
        <modifications expression="VMax" elementName="VLim"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-10},{-40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.PowerConverters.DCDC.Control.SignalPWM" isOver="true">
      <component_list isModificationOver="true" declarationName="pwm" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="useConstantDutyCycle"/>
        <modifications expression="fS" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-30,-20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.PowerConverters.DCDC.HBridge" isOver="true">
      <component_list isModificationOver="true" declarationName="dcdc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="RonT" elementName="RonTransistor"/>
        <modifications expression="GoffT" elementName="GoffTransistor"/>
        <modifications expression="VkneeT" elementName="VkneeTransistor"/>
        <modifications expression="RonD" elementName="RonDiode"/>
        <modifications expression="GoffD" elementName="GoffDiode"/>
        <modifications expression="VkneeD" elementName="VkneeDiode"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,-20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nBat" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,110},{-90,90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,110},{-90,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pBat" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,110},{110,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nMot" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-110},{-90,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list declarationName="vRef" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list declarationName="vMax" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,40},{-100,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="adaptor.dutyCycle" right="pwm.dutyCycle">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-39,0},{-30,0},{-30,-8}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pwm.fire" right="dcdc.fire_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-19,-14},{-12,-14}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pwm.notFire" right="dcdc.fire_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-19,-26},{-12,-26}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_nBat" right="dcdc.dc_n1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,100},{-100,70},{-6, 70 } ,{-6,-10} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_pBat" right="dcdc.dc_p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{100,100},{100,70},{6,70}, {6,-10} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcdc.dc_p2" right="pin_pMot">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{6,-30},{6,-70}, {100,-70},{100,-100} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_nMot" right="dcdc.dc_n2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,-100},{ -100,-68} ,{-6,-68},{-6,-30} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vRef" right="adaptor.v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,0},{-62,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vMax" right="adaptor.vLim">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,60},{-50, 60 } ,{-50,12} }" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
        </modifications>
        <modifications expression="{ Rectangle( extent={{-98,98},{98,-98}}, lineColor={217,67,180}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Line(points={{98,98},{20,20}}, color={217,67,180} ) , Line(points={{-20,-20},{-98,-98}}, color={217,67,180} ) , Text( extent={{-40,80},{40,60}}, textColor={128,128,128}, textString=&quot;Bat&quot; ) , Text( extent={{-100,20},{100,-20}}, textColor={0,0,255}, textString=&quot;%name&quot; ) , Text( extent={{-40,-60},{40,-80}}, textColor={128,128,128}, textString=&quot;Mot&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This is a model of a switching DC-DC inverter based on a H-bridge.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
