<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.DCMachines"/>
  <classes classType="model" className="DCPM_Start" description="&quot;Test example: DC with permanent magnet starting with voltage ramp&quot;" isLongClassSpecifier="true" classNameEnd="DCPM_Start" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="Va" description="&quot;Actual armature voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.2" declarationName="tStart" description="&quot;Start of armature voltage ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.8" declarationName="tRamp" description="&quot;Armature voltage ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" parameterType="parameter" isOver="true">
      <component_list expression="63.66" declarationName="TLoad" description="&quot;Nominal load torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="1.5" declarationName="tStep" description="&quot;Time of load torque step&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.15" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.DCMachines.DC_PermanentMagnet" isOver="true">
      <component_list isModificationOver="true" declarationName="dcpm" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="dcpmData.VaNominal" elementName="VaNominal"/>
        <modifications expression="dcpmData.IaNominal" elementName="IaNominal"/>
        <modifications expression="dcpmData.wNominal" elementName="wNominal"/>
        <modifications expression="dcpmData.TaNominal" elementName="TaNominal"/>
        <modifications expression="dcpmData.Ra" elementName="Ra"/>
        <modifications expression="dcpmData.TaRef" elementName="TaRef"/>
        <modifications expression="dcpmData.La" elementName="La"/>
        <modifications expression="dcpmData.Jr" elementName="Jr"/>
        <modifications expression="false" elementName="useSupport"/>
        <modifications expression="dcpmData.Js" elementName="Js"/>
        <modifications expression="dcpmData.frictionParameters" elementName="frictionParameters"/>
        <modifications expression="dcpmData.coreParameters" elementName="coreParameters"/>
        <modifications expression="dcpmData.strayLoadParameters" elementName="strayLoadParameters"/>
        <modifications expression="dcpmData.brushParameters" elementName="brushParameters"/>
        <modifications expression="293.15" elementName="TaOperational"/>
        <modifications expression="dcpmData.alpha20a" elementName="alpha20a"/>
        <modifications isModificationOver="true" elementName="phiMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications isModificationOver="true" elementName="wMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications isModificationOver="true" elementName="ia">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-50},{0,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Ramp" isOver="true">
      <component_list isModificationOver="true" declarationName="ramp" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="tRamp" elementName="duration"/>
        <modifications expression="Va" elementName="height"/>
        <modifications expression="tStart" elementName="startTime"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80, 60 } ,{-60,80} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SignalVoltage" isOver="true">
      <component_list declarationName="signalVoltage" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,30},{-20,50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-70,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Components.Inertia" isOver="true">
      <component_list isModificationOver="true" declarationName="loadInertia" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="JLoad" elementName="J"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{40,-50},{60,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Sources.TorqueStep" isOver="true">
      <component_list isModificationOver="true" declarationName="loadTorqueStep" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="tStep" elementName="startTime"/>
        <modifications expression="-TLoad" elementName="stepTorque"/>
        <modifications expression="false" elementName="useSupport"/>
        <modifications expression="0" elementName="offsetTorque"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-50}, {70,-30} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Utilities.ParameterRecords.DcPermanentMagnetData" parameterType="parameter" isOver="true">
      <component_list declarationName="dcpmData" description="&quot;DC machine data&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-80},{0,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ramp.y" right="signalVoltage.v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-59,70},{-10,70},{-10,52}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="signalVoltage.p" right="dcpm.pin_ap">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,40},{ 0,-20} ,{-4,-20},{-4,-30} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="signalVoltage.n" right="ground.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,40},{-60,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcpm.pin_an" right="signalVoltage.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-16,-30}, {-16,-20},{-20,-20},{-20,40} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="loadInertia.flange_b" right="loadTorqueStep.flange">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{60,-40},{70,-40}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcpm.flange" right="loadInertia.flange_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-40},{40,-40}}" elementName="points"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="2.0" elementName="StopTime"/>
        <modifications expression="1E-4" elementName="Interval"/>
        <modifications expression="1E-6" elementName="Tolerance"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;strong>Test example: Permanent magnet DC machine started with an armature voltage ramp&lt;/strong>&lt;br>A voltage ramp is applied to the armature, causing the DC machine to start,and accelerating inertias.&lt;br>At time tStep a load step is applied.&lt;br>Simulate for 2 seconds and plot (versus time):&lt;ul>&lt;li>dcpm.ia: armature current&lt;/li>&lt;li>dcpm.wMechanical: motor's speed&lt;/li>&lt;li>dcpm.tauElectrical: motor's torque&lt;/li>&lt;/ul>Default machine parameters of model &lt;em>DC_PermanentMagnet&lt;/em> are used.&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
