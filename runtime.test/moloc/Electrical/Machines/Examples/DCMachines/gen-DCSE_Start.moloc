<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.DCMachines"/>
  <classes classType="model" className="DCSE_Start" description="&quot;Test example: DC with serial excitation starting with voltage ramp&quot;" isLongClassSpecifier="true" classNameEnd="DCSE_Start" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="Va" description="&quot;Actual armature voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.1" declarationName="tStart" description="&quot;Start of resistance ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.9" declarationName="tRamp" description="&quot;Resistance ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" parameterType="parameter" isOver="true">
      <component_list expression="63.66" declarationName="TLoad" description="&quot;Nominal load torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1410*2*Modelica.Constants.pi/60" declarationName="wLoad" description="&quot;Nominal load speed&quot;">
        <modifications expression="&quot;rev/min&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.15" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.DCMachines.DC_SeriesExcited" isOver="true">
      <component_list isModificationOver="true" declarationName="dcse" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="dcseData.VaNominal" elementName="VaNominal"/>
        <modifications expression="dcseData.IaNominal" elementName="IaNominal"/>
        <modifications expression="dcseData.wNominal" elementName="wNominal"/>
        <modifications expression="dcseData.TaNominal" elementName="TaNominal"/>
        <modifications expression="dcseData.TeNominal" elementName="TeNominal"/>
        <modifications expression="dcseData.Ra" elementName="Ra"/>
        <modifications expression="dcseData.TaRef" elementName="TaRef"/>
        <modifications expression="dcseData.La" elementName="La"/>
        <modifications expression="dcseData.Jr" elementName="Jr"/>
        <modifications expression="false" elementName="useSupport"/>
        <modifications expression="dcseData.Js" elementName="Js"/>
        <modifications expression="dcseData.frictionParameters" elementName="frictionParameters"/>
        <modifications expression="dcseData.coreParameters" elementName="coreParameters"/>
        <modifications expression="dcseData.strayLoadParameters" elementName="strayLoadParameters"/>
        <modifications expression="dcseData.brushParameters" elementName="brushParameters"/>
        <modifications expression="dcseData.Re" elementName="Re"/>
        <modifications expression="dcseData.TeRef" elementName="TeRef"/>
        <modifications expression="dcseData.Le" elementName="Le"/>
        <modifications expression="dcseData.sigmae" elementName="sigmae"/>
        <modifications expression="293.15" elementName="TaOperational"/>
        <modifications expression="dcseData.alpha20a" elementName="alpha20a"/>
        <modifications isModificationOver="true" elementName="phiMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications isModificationOver="true" elementName="wMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications isModificationOver="true" elementName="ia">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications expression="dcseData.alpha20e" elementName="alpha20e"/>
        <modifications expression="293.15" elementName="TeOperational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-50},{0,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Ramp" isOver="true">
      <component_list isModificationOver="true" declarationName="ramp" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="tRamp" elementName="duration"/>
        <modifications expression="tStart" elementName="startTime"/>
        <modifications expression="-1" elementName="height"/>
        <modifications expression="1" elementName="offset"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,0},{40,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.ConstantVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="constantVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Va" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,50},{-20,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-70,40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Components.Inertia" isOver="true">
      <component_list isModificationOver="true" declarationName="loadInertia" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="JLoad" elementName="J"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{40,-50},{60,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Sources.QuadraticSpeedDependentTorque" isOver="true">
      <component_list isModificationOver="true" declarationName="quadraticLoadTorque" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="wLoad" elementName="w_nominal"/>
        <modifications expression="false" elementName="TorqueDirection"/>
        <modifications expression="-TLoad" elementName="tau_nominal"/>
        <modifications expression="false" elementName="useSupport"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-50}, {70,-30} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.VariableResistor" isOver="true">
      <component_list declarationName="variableResistor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Utilities.ParameterRecords.DcSeriesExcitedData" parameterType="parameter" isOver="true">
      <component_list declarationName="dcseData" description="&quot;DC machine data&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-80},{0,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantVoltage.n" right="ground.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,40},{-60,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="loadInertia.flange_b" right="quadraticLoadTorque.flange">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{60,-40},{70,-40}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcse.pin_an" right="dcse.pin_ep">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-16,-30},{-20, -30 } ,{-20,-34} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcse.pin_en" right="constantVoltage.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-46}, {-30,-46},{-30,-20},{-20,-20},{-20,40} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="dcse.flange" right="loadInertia.flange_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-40},{40,-40}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantVoltage.p" right="variableResistor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,40},{0,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableResistor.n" right="dcse.pin_ap">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,0},{0,-20},{-4,-20},{-4,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ramp.y" right="variableResistor.R">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{39,10},{12,10}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="2.0" elementName="StopTime"/>
        <modifications expression="1E-4" elementName="Interval"/>
        <modifications expression="1E-6" elementName="Tolerance"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;strong>Test example: Series excited DC machine started with a series resistor&lt;/strong>&lt;br>At constant source voltage, a series resistor limiting the armature current, is reduced according to a ramp, causing the DC machine to start,and accelerating inertias against load torque quadratic dependent on speed, finally reaching nominal speed.&lt;br>Simulate for 2 seconds and plot (versus time):&lt;ul>&lt;li>dcse.ia: armature current&lt;/li>&lt;li>dcse.wMechanical: motor's speed&lt;/li>&lt;li>dcse.tauElectrical: motor's torque&lt;/li>&lt;/ul>Default machine parameters of model &lt;em>DC_SeriesExcited&lt;/em> are used.&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
