<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.DCMachines"/>
  <classes classType="model" className="DC_CompareCharacteristics" description="&quot;Test example: Compare torque-speed characteristic of DC motors&quot;" isLongClassSpecifier="true" classNameEnd="DC_CompareCharacteristics" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="Va" description="&quot;Actual armature voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="Ve" description="&quot;Actual excitation voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" parameterType="parameter" isOver="true">
      <component_list expression="63.66" declarationName="TLoad" description="&quot;Nominal load torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="0.5" declarationName="tStart" description="&quot;Start of load torque ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="5.0" declarationName="tRamp" description="&quot;Load torque ramp&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.15" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.ConstantVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="armatureVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Va" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-80,70}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
