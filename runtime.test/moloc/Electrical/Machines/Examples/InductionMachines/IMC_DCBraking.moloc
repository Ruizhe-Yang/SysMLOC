<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.InductionMachines"/>
  <classes classType="model" className="IMC_DCBraking" description="&quot;Induction machine with DC current braking&quot;" isLongClassSpecifier="true" classNameEnd="IMC_DCBraking" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="constant" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="2*pi*imcData.fsNominal/imcData.p" declarationName="w0" description="&quot;Initial mechanical speed&quot;">
        <modifications expression="&quot;rev/min&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="4*imcData.Jr" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" isOver="true">
      <component_list expression="imc.tauElectrical" declarationName="tauElectrical" description="&quot;Electrical torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" isOver="true">
      <component_list expression="imc.tauShaft" declarationName="tauShaft" description="&quot;Shaft torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AngularVelocity" isOver="true">
      <component_list isModificationOver="true" expression="imc.wMechanical" declarationName="wMechanical" description="&quot;Shaft speed&quot;">
        <modifications expression="&quot;rev/min&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Machines.Utilities.DcBrakeSettings" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="settings" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="100" elementName="INominal"/>
        <modifications expression="&quot;D3&quot;" elementName="layout"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,60},{40,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Machines.Utilities.ParameterRecords.IM_SquirrelCageData" parameterType="parameter" isOver="true">
      <component_list declarationName="imcData" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-40},{40,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Machines.BasicMachines.InductionMachines.IM_SquirrelCage" isOver="true">
      <component_list isModificationOver="true" declarationName="imc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="imcData.p" elementName="p"/>
        <modifications expression="imcData.fsNominal" elementName="fsNominal"/>
        <modifications expression="imcData.Rs" elementName="Rs"/>
        <modifications expression="imcData.TsRef" elementName="TsRef"/>
        <modifications isModificationOver="true" expression="imcData.alpha20s" elementName="alpha20s">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="imcData.Lssigma" elementName="Lssigma"/>
        <modifications expression="imcData.Jr" elementName="Jr"/>
        <modifications expression="imcData.Js" elementName="Js"/>
        <modifications expression="imcData.Lszero" elementName="Lszero"/>
        <modifications expression="imcData.frictionParameters" elementName="frictionParameters"/>
        <modifications isModificationOver="true" elementName="phiMechanical">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <modifications isModificationOver="true" elementName="wMechanical">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="w0" elementName="start"/>
        </modifications>
        <modifications expression="imcData.statorCoreParameters" elementName="statorCoreParameters"/>
        <modifications expression="imcData.strayLoadParameters" elementName="strayLoadParameters"/>
        <modifications expression="imcData.Lm" elementName="Lm"/>
        <modifications expression="imcData.Lrsigma" elementName="Lrsigma"/>
        <modifications expression="imcData.Rr" elementName="Rr"/>
        <modifications expression="imcData.TrRef" elementName="TrRef"/>
        <modifications expression="293.15" elementName="TsOperational"/>
        <modifications expression="imcData.alpha20r" elementName="alpha20r"/>
        <modifications expression="293.15" elementName="TrOperational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-10},{40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Components.Inertia" isOver="true">
      <component_list isModificationOver="true" declarationName="loadInertia" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="JLoad" elementName="J"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-10},{70,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Machines.Utilities.TerminalBox" isOver="true">
      <component_list isModificationOver="true" declarationName="terminalBox" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="settings.terminalConnection" elementName="terminalConnection"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,6},{40,26}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.PlugToPin_p" isOver="true">
      <component_list isModificationOver="true" declarationName="plugToPin1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="1" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,70},{-40,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.PlugToPin_p" isOver="true">
      <component_list isModificationOver="true" declarationName="plugToPin2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="2" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,30},{-40,50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.PlugToPin_p" isOver="true">
      <component_list isModificationOver="true" declarationName="plugToPin3" isAnnotation="true" isAnnotationOver="true" condition_attribute="settings.connect3">
        <modifications expression="m" elementName="m"/>
        <modifications expression="3" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-10},{-40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.ConstantCurrent" isOver="true">
      <component_list isModificationOver="true" declarationName="constantCurrent" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="settings.Idc" elementName="I"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-50,62}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,20},{-50,40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:IfEquation" condition="settings.layout==&quot;Y3&quot;">
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.is[2])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[1])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[2])" right="0"/>
      </equations>
      <equations xsi:type="mOloc:IfEquation" condition="settings.layout==&quot;Y2&quot;">
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[1])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[2])" right="0"/>
      </equations>
      <equations xsi:type="mOloc:IfEquation" condition="settings.layout==&quot;D2&quot;">
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.is[2])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[1])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[2])" right="0"/>
      </equations>
      <equations xsi:type="mOloc:IfEquation" condition="settings.layout==&quot;D3&quot;">
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.is[1])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.is[2])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[1])" right="0"/>
        <ifEquations xsi:type="mOloc:SimpleEquation" left="der(imc.idq_rs[2])" right="0"/>
      </equations>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="imc.flange" right="loadInertia.flange_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,0},{50,0}}" elementName="points"/>
          <modifications expression="{0,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin1.pin_p" right="constantCurrent.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-32,80},{-50,80},{-50,72}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin2.pin_p" right="constantCurrent.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-32,40},{-50,40},{-50,52}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantCurrent.p" right="plugToPin3.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,52},{-50,0},{-32,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin2.plug_p" right="plugToPin1.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-28,40}, {-20,40},{-20,80},{-28,80} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin2.plug_p" right="plugToPin3.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-28,40}, {-20,40},{-20,0},{-28,0} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sn" right="imc.plug_sn">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{24,10},{24,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sp" right="imc.plug_sp">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{36,10},{36,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin2.plug_p" right="terminalBox.plugSupply">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-28,40},{30,40},{30,12}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plugToPin2.pin_p" right="ground.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-32,40},{-60,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="25" elementName="StopTime"/>
        <modifications expression="0.001" elementName="Interval"/>
        <modifications expression="1e-06" elementName="Tolerance"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;The stator windings of an induction machine are fed by a DC current, causing a stationary current space phasor.&#xA;Since the rotor is turning, voltage is induced in the rotor cage which in turn drives rotor currents.&#xA;This creates a braking torque.&#xA;&lt;/p>&#xA;&lt;p>&#xA;Choose a layout and plot tauElectrical and tauShaft versus wMechanical.&#xA;&lt;/p>&#xA;&lt;p>Default machine parameters are used.&lt;/p>&#xA;&lt;h4>References&lt;/h4>&#xA;&lt;table border=\&quot;0\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;>&#xA;    &lt;tr>&#xA;      &lt;td>[Fischer2017]&lt;/td>&#xA;      &lt;td>R. Fischer,&#xA;         Elektrische Maschinen, 17&lt;sup>th&lt;/sup> ed., chapter 5.3.3.,&#xA;        &lt;em>Hanser&lt;/em>,&#xA;        ISBN 978-3-446-45218-3, 2017.&lt;/td>&#xA;    &lt;/tr>&#xA;&lt;/table>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
