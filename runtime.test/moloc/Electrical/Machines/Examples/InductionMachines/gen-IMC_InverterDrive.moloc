<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.InductionMachines"/>
  <classes classType="model" className="IMC_InverterDrive" description="&quot;Test example: InductionMachineSquirrelCage inverter drive&quot;" isLongClassSpecifier="true" classNameEnd="IMC_InverterDrive" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Electrical.Polyphase.Functions.factorY2DC" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="constant" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="400" declarationName="VNominal" description="&quot;Nominal RMS voltage per phase&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="50" declarationName="fNominal" description="&quot;Nominal frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="10e-3" declarationName="RGrid" description="&quot;Grid choke resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="500e-6" declarationName="LGrid" description="&quot;Grid choke inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="factorY2DC(m)*VNominal/sqrt(3)" declarationName="VDC" description="&quot;Theoretical DC voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list expression="5e-3" declarationName="CDC" description="&quot;DC capacitor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Torque" parameterType="parameter" isOver="true">
      <component_list expression="161.4" declarationName="TLoad" description="&quot;Nominal load torque&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list expression="1440.45*2*pi/60" declarationName="wLoad" description="&quot;Nominal load speed&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.29" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Polyphase.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="sineVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <modifications expression="-Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m)" elementName="phase" isfinal="true"/>
        <modifications expression="fill(fNominal, m)" elementName="f" isfinal="true"/>
        <modifications expression="zeros(m)" elementName="offset" isfinal="true"/>
        <modifications expression="zeros(m)" elementName="startTime" isfinal="true"/>
        <modifications expression="fill(VNominal*sqrt(2/3), m)" elementName="V" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,-30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,-60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-80,-90}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sensors.CurrentQuasiRMSSensor" isOver="true">
      <component_list declarationName="gridCurrent" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Polyphase.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="resistor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <modifications expression="fill(RGrid, m)" elementName="R" isfinal="true"/>
        <modifications expression="fill(20, m)" elementName="T_ref" isfinal="true"/>
        <modifications expression="zeros(m)" elementName="alpha" isfinal="true"/>
        <modifications expression="fill(20, m)" elementName="T" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-80,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Polyphase.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="inductor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(LGrid, m)" elementName="L" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-80,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PowerConverters.ACDC.DiodeBridge2mPulse" isOver="true">
      <component_list declarationName="rectifier" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-68,60},{-48,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="capacitor" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="VDC" elementName="start"/>
        </modifications>
        <modifications expression="CDC" elementName="C"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-30,70}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PowerConverters.DCAC.Polyphase2Level" isOver="true">
      <component_list declarationName="inverter" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{0,70}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Sensors.CurrentQuasiRMSSensor" isOver="true">
      <component_list declarationName="machineCurrent" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{30,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Utilities.TerminalBox" isOver="true">
      <component_list isModificationOver="true" declarationName="terminalBox" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;D&quot;" elementName="terminalConnection"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-24},{40,-4}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.InductionMachines.IM_SquirrelCage" isOver="true">
      <component_list isModificationOver="true" declarationName="aimc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="aimcData.p" elementName="p"/>
        <modifications expression="aimcData.fsNominal" elementName="fsNominal"/>
        <modifications expression="aimcData.Rs" elementName="Rs"/>
        <modifications expression="aimcData.TsRef" elementName="TsRef"/>
        <modifications isModificationOver="true" expression="aimcData.alpha20s" elementName="alpha20s">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="aimcData.Lszero" elementName="Lszero"/>
        <modifications expression="aimcData.Lssigma" elementName="Lssigma"/>
        <modifications expression="aimcData.Jr" elementName="Jr"/>
        <modifications expression="aimcData.Js" elementName="Js"/>
        <modifications expression="aimcData.frictionParameters" elementName="frictionParameters"/>
        <modifications isModificationOver="true" elementName="phiMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications isModificationOver="true" elementName="wMechanical">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications expression="aimcData.statorCoreParameters" elementName="statorCoreParameters"/>
        <modifications expression="aimcData.strayLoadParameters" elementName="strayLoadParameters"/>
        <modifications expression="aimcData.Lm" elementName="Lm"/>
        <modifications expression="aimcData.Lrsigma" elementName="Lrsigma"/>
        <modifications expression="aimcData.Rr" elementName="Rr"/>
        <modifications expression="aimcData.TrRef" elementName="TrRef"/>
        <modifications expression="293.15" elementName="TsOperational"/>
        <modifications expression="aimcData.alpha20r" elementName="alpha20r"/>
        <modifications expression="293.15" elementName="TrOperational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-40},{40,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Utilities.ParameterRecords.IM_SquirrelCageData" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="aimcData" description="&quot;Induction machine data&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.03*16" elementName="Rs"/>
        <modifications expression="0.04*16" elementName="Rr"/>
        <modifications expression="3*(1 - sqrt(1 - 0.0667))/(2*pi*aimcData.fsNominal)*16" elementName="Lssigma"/>
        <modifications expression="3*sqrt(1 - 0.0667)/(2*pi*aimcData.fsNominal)*16" elementName="Lm"/>
        <modifications expression="3*(1 - sqrt(1 - 0.0667))/(2*pi*aimcData.fsNominal)*16" elementName="Lrsigma"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-70},{40,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Components.Inertia" isOver="true">
      <component_list isModificationOver="true" declarationName="loadInertia" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="JLoad" elementName="J"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-40},{70,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Mechanics.Rotational.Sources.QuadraticSpeedDependentTorque" isOver="true">
      <component_list isModificationOver="true" declarationName="loadTorque" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="useSupport"/>
        <modifications expression="-TLoad" elementName="tau_nominal"/>
        <modifications expression="false" elementName="TorqueDirection"/>
        <modifications expression="wLoad" elementName="w_nominal"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-40},{80,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Ramp" isOver="true">
      <component_list isModificationOver="true" declarationName="ramp" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="fNominal" elementName="height"/>
        <modifications expression="0" elementName="startTime"/>
        <modifications expression="1.2" elementName="duration"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{-20,-50}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Utilities.VfController" isOver="true">
      <component_list isModificationOver="true" declarationName="vfController" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <modifications expression="VNominal" elementName="VNominal"/>
        <modifications expression="fNominal" elementName="fNominal"/>
        <modifications expression="true" elementName="EconomyMode"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SpacePhasors.Blocks.ToSpacePhasor" isOver="true">
      <component_list declarationName="toSpacePhasor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PowerConverters.DCAC.Control.PWM" isOver="true">
      <component_list isModificationOver="true" declarationName="pwm" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="VDC" elementName="uMax"/>
        <modifications expression="2000" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="inductor.i[1:2]" right="zeros(2)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="aimc.is[1:3]" right="zeros(3)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="aimc.ir" right="zeros(2)"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="loadTorque.flange" right="loadInertia.flange_b">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,-30},{70,-30}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plugSupply" right="machineCurrent.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{30,-18},{30,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sn" right="aimc.plug_sn">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{24,-20},{24,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sp" right="aimc.plug_sp">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{36,-20},{36,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="aimc.flange" right="loadInertia.flange_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,-30},{50,-30}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="vfController.u" right="ramp.y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-32},{0,-50},{-9,-50}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="toSpacePhasor.u" right="vfController.y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-2},{0,-9}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pwm.u" right="toSpacePhasor.y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,28},{0,21}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="inverter.fire_p" right="pwm.fire_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-6,58},{-6,51}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="inverter.fire_n" right="pwm.fire_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{6,58},{6,51}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="inverter.ac" right="machineCurrent.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,70},{30,70},{30,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="capacitor.p" right="inverter.dc_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,80},{-20,80}, {-20,76},{-10,76} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="capacitor.n" right="inverter.dc_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,60},{-20,60}, {-20,64},{-10,64} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="rectifier.dc_p" right="capacitor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-48,76},{-40,76}, {-40,80},{-30,80} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="rectifier.dc_n" right="capacitor.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-48,64},{-40,64}, {-40,60},{-30,60} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="sineVoltage.plug_n" right="star.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-40},{-80,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star.pin_n" right="ground.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-70},{-80,-80}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.plug_n" right="inductor.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,40},{-80,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="inductor.plug_n" right="rectifier.ac">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,70},{-68,70}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.plug_p" right="gridCurrent.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,20},{-80,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="gridCurrent.plug_n" right="sineVoltage.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-10},{-80,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
