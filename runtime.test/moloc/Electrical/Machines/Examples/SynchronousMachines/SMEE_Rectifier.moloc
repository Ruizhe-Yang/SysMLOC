<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Examples.SynchronousMachines">
  <classes classType="model" className="SMEE_Rectifier" description="&quot;Test example: ElectricalExcitedSynchronousMachine with rectifier&quot;" isLongClassSpecifier="true" classNameEnd="SMEE_Rectifier" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="constant" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list expression="2*pi*smeeData.fsNominal /smee.p" declarationName="wNominal" description="&quot;Nominal speed&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="sqrt(2*3)*smeeData.VsNominal" declarationName="VDC0" description="&quot;No-load DC voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="VDC0^2/smeeData.SNominal" declarationName="RLoad" description="&quot;Load resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="smee.IeOpenCircuit* Machines.Thermal.convertResistance( smee.Re, smee.TeRef, smee.alpha20e, smee.TeOperational )" declarationName="Ve0" description="&quot;No load excitation voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="2*Ve0/smeeData.VsNominal" declarationName="k" description="&quot;Voltage controller: gain&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
      <component_list expression="smeeData.Td0Transient/2" declarationName="Ti" description="&quot;Voltage controller: integral time constant&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.BasicMachines.SynchronousMachines.SM_ElectricalExcited" isOver="true">
      <component_list isModificationOver="true" declarationName="smee" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="smeeData.fsNominal" elementName="fsNominal"/>
        <modifications expression="smeeData.Rs" elementName="Rs"/>
        <modifications expression="smeeData.TsRef" elementName="TsRef"/>
        <modifications expression="smeeData.Lssigma" elementName="Lssigma"/>
        <modifications expression="smeeData.Lmd" elementName="Lmd"/>
        <modifications expression="smeeData.Lmq" elementName="Lmq"/>
        <modifications expression="smeeData.Lrsigmad" elementName="Lrsigmad"/>
        <modifications expression="smeeData.Lrsigmaq" elementName="Lrsigmaq"/>
        <modifications expression="smeeData.Rrd" elementName="Rrd"/>
        <modifications expression="smeeData.Rrq" elementName="Rrq"/>
        <modifications expression="smeeData.TrRef" elementName="TrRef"/>
        <modifications expression="smeeData.VsNominal" elementName="VsNominal"/>
        <modifications expression="smeeData.IeOpenCircuit" elementName="IeOpenCircuit"/>
        <modifications expression="smeeData.Re" elementName="Re"/>
        <modifications expression="smeeData.TeRef" elementName="TeRef"/>
        <modifications expression="smeeData.sigmae" elementName="sigmae"/>
        <modifications expression="true" elementName="useDamperCage"/>
        <modifications expression="2" elementName="p"/>
        <modifications expression="0.29" elementName="Jr"/>
        <modifications expression="0.29" elementName="Js"/>
        <modifications isModificationOver="true" elementName="statorCoreParameters">
          <modifications expression="100" elementName="VRef"/>
        </modifications>
        <modifications isModificationOver="true" elementName="strayLoadParameters">
          <modifications expression="100" elementName="IRef"/>
        </modifications>
        <modifications isModificationOver="true" elementName="brushParameters">
          <modifications expression="0.01" elementName="ILinear"/>
        </modifications>
        <modifications expression="293.15" elementName="TsOperational"/>
        <modifications expression="smeeData.alpha20s" elementName="alpha20s"/>
        <modifications isModificationOver="true" elementName="ir">
          <modifications expression="true" elementName="fixed" isEach="true"/>
        </modifications>
        <modifications expression="293.15" elementName="TrOperational"/>
        <modifications expression="smeeData.alpha20r" elementName="alpha20r"/>
        <modifications expression="smeeData.alpha20e" elementName="alpha20e"/>
        <modifications expression="293.15" elementName="TeOperational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-40},{20,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Utilities.SynchronousMachineData" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="smeeData" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="30e3" elementName="SNominal"/>
        <modifications expression="100" elementName="VsNominal"/>
        <modifications expression="50" elementName="fsNominal"/>
        <modifications expression="10" elementName="IeOpenCircuit"/>
        <modifications expression="0.1" elementName="x0"/>
        <modifications expression="1.6" elementName="xd"/>
        <modifications expression="1.6" elementName="xq"/>
        <modifications expression="0.1375" elementName="xdTransient"/>
        <modifications expression="0.121428571" elementName="xdSubtransient"/>
        <modifications expression="0.148387097" elementName="xqSubtransient"/>
        <modifications expression="0.014171268" elementName="Ta"/>
        <modifications expression="0.261177343" elementName="Td0Transient"/>
        <modifications expression="0.006963029" elementName="Td0Subtransient"/>
        <modifications expression="0.123345081" elementName="Tq0Subtransient"/>
        <modifications expression="293.15" elementName="TsSpecification"/>
        <modifications expression="293.15" elementName="TsRef"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20s">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="TrSpecification"/>
        <modifications expression="293.15" elementName="TrRef"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20r">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="TeSpecification"/>
        <modifications expression="293.15" elementName="TeRef"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20e">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-70},{20,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Utilities.TerminalBox" isOver="true">
      <component_list isModificationOver="true" declarationName="terminalBox" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;Y&quot;" elementName="terminalConnection"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-24},{20,-4}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,60}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Mechanics.Rotational.Sources.Speed" isOver="true">
      <component_list declarationName="speed" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-40},{30,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Blocks.Sources.Constant" isOver="true">
      <component_list isModificationOver="true" declarationName="constantSpeed" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="wNominal" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{80,-40},{60,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Mechanics.Rotational.Sensors.SpeedSensor" isOver="true">
      <component_list declarationName="speedSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{30,-50}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="setPointGain" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="(smeeData.VsNominal/wNominal)/ unitMagneticFlux" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-90},{-70,-70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Continuous.LimPID" isOver="true">
      <component_list isModificationOver="true" declarationName="voltageController" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Modelica.Blocks.Types.SimpleController.PI" elementName="controllerType"/>
        <modifications expression="k" elementName="k"/>
        <modifications expression="Ti" elementName="Ti"/>
        <modifications expression="2.5*Ve0" elementName="yMax"/>
        <modifications expression="0" elementName="yMin"/>
        <modifications expression="Modelica.Blocks.Types.Init.InitialState" elementName="initType"/>
        <modifications expression="0.001" elementName="Td"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70,-20},{-50,-40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SignalVoltage" isOver="true">
      <component_list declarationName="excitationVoltage" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-30,-30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundExcitation" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-30,-60}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-20,90}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1E-5, m)" elementName="Ron"/>
        <modifications expression="fill(1E-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1E-5, m)" elementName="Ron"/>
        <modifications expression="fill(1E-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-20,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="capacitor1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="2*10E-6" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-40,80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="capacitor2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="2*10E-6" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-40,40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="resistor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="RLoad" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-50,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="voltageSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Continuous.Filter" isOver="true">
      <component_list isModificationOver="true" declarationName="filter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Modelica.Blocks.Types.AnalogFilter.CriticalDamping" elementName="analogFilter"/>
        <modifications expression="Modelica.Blocks.Types.FilterType.LowPass" elementName="filterType"/>
        <modifications expression="2" elementName="order"/>
        <modifications expression="20" elementName="f_cut"/>
        <modifications expression="1/sqrt(2*3)" elementName="gain"/>
        <modifications expression="true" elementName="normalized"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-60,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.MagneticFlux" parameterType="constant" isProtected="true" isOver="true">
      <component_list expression="1" declarationName="unitMagneticFlux" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="HideResult"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="smee.is[1:2]" right="zeros(2)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="smee.ie" right="0"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sn" right="smee.plug_sn">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{4,-20},{4,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sp" right="smee.plug_sp">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{16,-20},{16,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="excitationVoltage.p" right="smee.pin_ep">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-20},{-20,-20},{-20,-24},{0,-24}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="excitationVoltage.n" right="smee.pin_en">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-40},{-20,-40},{-20,-36},{0,-36}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="excitationVoltage.n" right="groundExcitation.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-40},{-30,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="smee.flange" right="speed.flange">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,-30},{30,-30}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="speed.flange" right="speedSensor.flange">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{30,-30},{30,-40}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantSpeed.y" right="speed.w_ref">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{59,-30},{52,-30}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="setPointGain.y" right="voltageController.u_s">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-71,-80},{-80,-80},{-80,-30},{-72,-30}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="speedSensor.w" right="setPointGain.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{30,-61},{30,-80},{-48,-80}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageController.y" right="excitationVoltage.v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-49,-30},{-42,-30}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode1.plug_p" right="idealDiode2.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,70},{0,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode2.plug_p" right="star2.plug_p">
