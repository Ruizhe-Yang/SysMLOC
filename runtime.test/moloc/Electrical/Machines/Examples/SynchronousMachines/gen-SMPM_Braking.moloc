<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.SynchronousMachines"/>
  <classes classType="model" className="SMPM_Braking" description="&quot;Test example: PermanentMagnetSynchronousMachine acting as brake&quot;" isLongClassSpecifier="true" classNameEnd="SMPM_Braking" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="constant" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="constant" isOver="true">
      <component_list isModificationOver="true" expression="1" declarationName="unitK" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;rad/(s.Ohm)&quot;" elementName="unit"/>
        <annotations expression="true" elementName="HideResult"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1" declarationName="R" description="&quot;Nominal braking resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list expression="2*pi*smpmData.fsNominal/smpmData.p" declarationName="wNominal" description="&quot;Nominal speed&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.29" declarationName="JLoad" description="&quot;Load's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.SynchronousMachines.SM_PermanentMagnet" isOver="true">
      <component_list isModificationOver="true" declarationName="smpm" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="phiMechanical">
          <modifications expression="0" elementName="start"/>
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications expression="false" elementName="useSupport"/>
        <modifications expression="false" elementName="useThermalPort"/>
        <modifications expression="smpmData.p" elementName="p"/>
        <modifications expression="smpmData.fsNominal" elementName="fsNominal"/>
        <modifications expression="smpmData.Rs" elementName="Rs"/>
        <modifications expression="smpmData.TsRef" elementName="TsRef"/>
        <modifications expression="smpmData.Lszero" elementName="Lszero"/>
        <modifications expression="smpmData.Lssigma" elementName="Lssigma"/>
        <modifications expression="smpmData.Jr" elementName="Jr"/>
        <modifications expression="smpmData.Js" elementName="Js"/>
        <modifications expression="smpmData.frictionParameters" elementName="frictionParameters"/>
        <modifications expression="smpmData.statorCoreParameters" elementName="statorCoreParameters"/>
        <modifications expression="smpmData.strayLoadParameters" elementName="strayLoadParameters"/>
        <modifications expression="smpmData.VsOpenCircuit" elementName="VsOpenCircuit"/>
        <modifications expression="smpmData.Lmd" elementName="Lmd"/>
        <modifications expression="smpmData.Lmq" elementName="Lmq"/>
        <modifications expression="smpmData.useDamperCage" elementName="useDamperCage"/>
        <modifications expression="smpmData.Lrsigmad" elementName="Lrsigmad"/>
        <modifications expression="smpmData.Lrsigmaq" elementName="Lrsigmaq"/>
        <modifications expression="smpmData.Rrd" elementName="Rrd"/>
        <modifications expression="smpmData.Rrq" elementName="Rrq"/>
        <modifications expression="smpmData.TrRef" elementName="TrRef"/>
        <modifications expression="smpmData.permanentMagnetLossParameters" elementName="permanentMagnetLossParameters"/>
        <modifications expression="293.15" elementName="TsOperational"/>
        <modifications expression="smpmData.alpha20s" elementName="alpha20s"/>
        <modifications isModificationOver="true" elementName="wMechanical">
          <modifications expression="wNominal" elementName="start"/>
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <modifications expression="293.15" elementName="TrOperational"/>
        <modifications expression="smpmData.alpha20r" elementName="alpha20r"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-50},{0,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-80,60}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Utilities.TerminalBox" isOver="true">
      <component_list isModificationOver="true" declarationName="terminalBox" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;Y&quot;" elementName="terminalConnection"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-34},{0,-14}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Components.Inertia" isOver="true">
      <component_list isModificationOver="true" declarationName="inertiaLoad" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="JLoad" elementName="J"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-50},{70,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Mechanics.Rotational.Sensors.SpeedSensor" isOver="true">
      <component_list declarationName="speedSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{40,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Utilities.ParameterRecords.SM_PermanentMagnetData" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="smpmData" description="&quot;Synchronous machine data&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="useDamperCage"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-80},{0,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sensors.CurrentQuasiRMSSensor" isOver="true">
      <component_list declarationName="currentQuasiRMSSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-10,0}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PowerConverters.ACDC.DiodeBridge2mPulse" isOver="true">
      <component_list isModificationOver="true" declarationName="diodeBridge2mPulse" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-10,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Analog.Basic.VariableResistor" isOver="true">
      <component_list declarationName="variableResistor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,50},{-20,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="gain" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="unitK*R/wNominal" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{40,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Blocks.Nonlinear.Limiter" isOver="true">
      <component_list isModificationOver="true" declarationName="limiter" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.1" elementName="uMin"/>
        <modifications expression="10" elementName="uMax"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{40,60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="ac2dc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="pi^2/8" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{10,80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starM" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-60,-10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sensors.VoltageQuasiRMSSensor" isOver="true">
      <component_list declarationName="voltageQuasiRMSSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-30,-10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="grounding" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1e6" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-70,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="smpm.is[1:2]" right="zeros(2)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="smpm.i_0_s" right="0"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sn" right="smpm.plug_sn">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-16,-30},{-16,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.plug_sp" right="smpm.plug_sp">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-4,-30},{-4,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentQuasiRMSSensor.plug_n" right="terminalBox.plugSupply">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-10},{-10,-10},{-10,-28}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diodeBridge2mPulse.ac" right="currentQuasiRMSSensor.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,20},{-10,15},{-10,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableResistor.p" right="diodeBridge2mPulse.dc_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,60},{ 0,50} ,{-4,50},{-4,40} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableResistor.n" right="diodeBridge2mPulse.dc_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,60},{-20,50},{-16,50},{-16,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="smpm.flange" right="inertiaLoad.flange_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-40},{50,-40}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="gain.u" right="speedSensor.w">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,18},{40,11}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="limiter.u" right="gain.y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,48},{40,41}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="limiter.y" right="ac2dc.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,71},{40,80},{22,80}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ac2dc.y" right="variableResistor.R">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-1,80},{-10,80},{-10,72}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starM.plug_p" right="voltageQuasiRMSSensor.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,-10},{-48,-10},{-40,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageQuasiRMSSensor.plug_p" right="currentQuasiRMSSensor.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-10},{-20,-10},{-10,-10}}" elementName="points"/>
          <modifications expression="{0,0, 255 }" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="smpm.flange" right="speedSensor.flange">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-40},{40,-40},{40,-10}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="terminalBox.starpoint" right="starM.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-28},{-20,-28},{-70,-28},{-70,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="variableResistor.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,60},{-46,60},{-20,60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="grounding.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,60},{-70,60},{-70,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starM.pin_n" right="grounding.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,-10},{-70,5},{-70,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0.8" elementName="StopTime"/>
        <modifications expression="1E-4" elementName="Interval"/>
        <modifications expression="1e-06" elementName="Tolerance"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>A synchronous machine with permanent magnets starts braking from nominal speed by feeding a diode bridge,which in turn feeds a braking resistor.Since induced voltage is reduced proportional to falling speed, the braking resistance is set proportional to speed toachieve constant current and torque.&lt;/p>&lt;p>Default machine parameters are used.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
