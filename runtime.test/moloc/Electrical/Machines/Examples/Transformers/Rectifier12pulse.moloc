<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Examples.Transformers">
  <classes classType="model" className="Rectifier12pulse" description="&quot;12-pulse rectifier with 2 transformers&quot;" isLongClassSpecifier="true" classNameEnd="Rectifier12pulse" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Examples.Transformers.Rectifier6pulse" isOver="true">
      <extendsModifications expression="0.2" elementName="RL"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="diode3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1e-5, m)" elementName="Ron"/>
        <modifications expression="fill(1e-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,-20}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,0},{10,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="diode4" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1e-5, m)" elementName="Ron"/>
        <modifications expression="fill(1e-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,-60}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star4" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-60},{10,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.BasicMachines.Transformers.Dd.Dd00" isOver="true">
      <component_list isModificationOver="true" declarationName="transformer2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="transformerData2.n" elementName="n"/>
        <modifications expression="transformerData2.R1" elementName="R1"/>
        <modifications expression="transformerData2.L1sigma" elementName="L1sigma"/>
        <modifications expression="transformerData2.R2" elementName="R2"/>
        <modifications expression="transformerData2.L2sigma" elementName="L2sigma"/>
        <modifications expression="293.15" elementName="T1Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_1">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T2Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_2">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T1Operational"/>
        <modifications expression="293.15" elementName="T2Operational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-50},{-30,-30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Utilities.TransformerData" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="transformerData2" description="&quot;Data of transformer 2&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Modelica.Utilities.Strings.substring( transformer2.VectorGroup, 1, 1 )" elementName="C1"/>
        <modifications expression="Modelica.Utilities.Strings.substring( transformer2.VectorGroup, 2, 2 )" elementName="C2"/>
        <modifications expression="50" elementName="f"/>
        <modifications expression="100" elementName="V1"/>
        <modifications expression="100" elementName="V2"/>
        <modifications expression="30E3" elementName="SNominal"/>
        <modifications expression="0.05" elementName="v_sc"/>
        <modifications expression="300" elementName="P_sc"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-80},{-40,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="transformer2.core.plug_p1.pin[1:3].i" right="zeros(3)"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode3.plug_n" right="star3.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-10},{-10,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode4.plug_p" right="star4.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-70},{-10,-70}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode4.plug_n" right="diode3.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-50},{-20,-30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star4.pin_n" right="cDC2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,-70},{70,-70}, {70,-30} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star3.pin_n" right="cDC1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,-10},{18,-10}, {18,-8},{22,-8},{22,-10},{30,-10},{30,70},{70,70},{70,30} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformer2.plug2" right="diode4.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-40},{-20,-40},{-20,-50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformer2.plug1" right="currentSensor.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,-40},{-60,-40},{-60,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Test example with polyphase components:&lt;br>&#xA;Star-connected voltage source feeds via two transformers (Dd0 and Dy1) two diode bridge rectifiers with a single DC burden.&lt;br>&#xA;Using f=50 Hz, simulate for 0.1 seconds (5 periods) and compare voltages and currents of source and DC burden,&#xA;neglecting initial transient.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0.1" elementName="StopTime"/>
        <modifications expression="1E-4" elementName="Interval"/>
        <modifications expression="1E-6" elementName="Tolerance"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
