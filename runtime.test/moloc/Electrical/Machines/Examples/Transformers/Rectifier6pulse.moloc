<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Examples.Transformers"/>
  <classes classType="model" className="Rectifier6pulse" description="&quot;6-pulse rectifier with 1 transformer&quot;" isLongClassSpecifier="true" classNameEnd="Rectifier6pulse" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="constant" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100*sqrt(2/3)" declarationName="V" description="&quot;Amplitude of star-voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="50" declarationName="f" description="&quot;Frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="0.4" declarationName="RL" description="&quot;Load resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list expression="0.005" declarationName="C" description="&quot;Total DC-capacitance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="sqrt(3)*V" declarationName="VC0" description="&quot;Initial voltage of capacitance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="source" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(V, m)" elementName="V"/>
        <modifications expression="fill(f, m)" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-90,-10}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starAC" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-90,-40}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundAC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-100,-80},{-80,-60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Sensors.CurrentSensor" isOver="true">
      <component_list isModificationOver="true" declarationName="currentSensor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80,-10},{-60,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="diode1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1e-5, m)" elementName="Ron"/>
        <modifications expression="fill(1e-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,60}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,70}" elementName="origin"/>
            <modifications expression="{{10,10},{-10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="diode2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(1e-5, m)" elementName="Ron"/>
        <modifications expression="fill(1e-5, m)" elementName="Goff"/>
        <modifications expression="fill(0, m)" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-20,20}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,0},{10,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="load" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="RL" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{50,0}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="cDC1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="2*C" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="VC0/2" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{70,20}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Capacitor" isOver="true">
      <component_list isModificationOver="true" declarationName="cDC2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="2*C" elementName="C"/>
        <modifications isModificationOver="true" elementName="v">
          <modifications expression="VC0/2" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{70,-20}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundDC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{80,-20},{100,0}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Utilities.TransformerData" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="transformerData1" description="&quot;Data of transformer 1&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Modelica.Utilities.Strings.substring( transformer1.VectorGroup, 1, 1 )" elementName="C1"/>
        <modifications expression="Modelica.Utilities.Strings.substring( transformer1.VectorGroup, 2, 2 )" elementName="C2"/>
        <modifications expression="50" elementName="f"/>
        <modifications expression="100" elementName="V1"/>
        <modifications expression="100" elementName="V2"/>
        <modifications expression="30E3" elementName="SNominal"/>
        <modifications expression="0.05" elementName="v_sc"/>
        <modifications expression="300" elementName="P_sc"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,60},{-40,80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.Transformers.Dy.Dy01" isOver="true">
      <component_list isModificationOver="true" declarationName="transformer1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="transformerData1.n" elementName="n"/>
        <modifications expression="transformerData1.R1" elementName="R1"/>
        <modifications expression="transformerData1.L1sigma" elementName="L1sigma"/>
        <modifications expression="transformerData1.R2" elementName="R2"/>
        <modifications expression="transformerData1.L2sigma" elementName="L2sigma"/>
        <modifications expression="293.15" elementName="T1Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_1">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T2Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_2">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T1Operational"/>
        <modifications expression="293.15" elementName="T2Operational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,30},{-30,50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" left="cDC1.v" right="VC0/2"/>
      <equations xsi:type="mOloc:SimpleEquation" left="cDC2.v" right="VC0/2"/>
      <equations xsi:type="mOloc:SimpleEquation" left="transformer1.i2[1:2]" right="zeros(2)"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="cDC1.n" right="cDC2.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,10},{70,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="cDC1.n" right="groundDC.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,10},{70,0},{90,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starAC.plug_p" right="source.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-30},{-90,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode1.plug_n" right="star1.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,70},{-10,70}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode2.plug_p" right="star2.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,10},{-10,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode2.plug_n" right="diode1.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,30},{-20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starAC.pin_n" right="groundAC.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-50},{-90,-60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="source.plug_p" right="currentSensor.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,0},{-85,0},{-80,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="load.p" right="cDC1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,10},{50,30},{70,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="load.n" right="cDC2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,-10},{50,-30},{70, -30 } }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star1.pin_n" right="cDC1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,70},{70,70},{70,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star2.pin_n" right="cDC2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,10},{20,10},{ 20,-70} ,{70,-70},{70,-30} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformer1.plug1" right="currentSensor.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,40},{-60,40},{-60,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformer1.plug2" right="diode1.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,40},{-20,40},{-20,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Test example with polyphase components:&lt;br>&#xA;Star-connected voltage source feeds via a transformer a diode bridge rectifier with a DC burden.&lt;br>&#xA;Using f=50 Hz, simulate for 0.1 seconds (5 periods) and compare voltages and currents of source and DC burden,&#xA;neglecting initial transient.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0.1" elementName="StopTime"/>
        <modifications expression="1E-4" elementName="Interval"/>
        <modifications expression="1E-6" elementName="Tolerance"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
