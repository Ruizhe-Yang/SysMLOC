<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Interfaces.InductionMachines"/>
  <classes classType="connector" className="ThermalPortSMR" description="&quot;Thermal port of synchronous machine with reluctance rotor&quot;" isLongClassSpecifier="true" classNameEnd="ThermalPortSMR" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialThermalPortInductionMachines" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="useDamperCage" description="&quot;Enable / disable damper cage&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="true" elementName="start"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Interfaces.HeatPort_a" isOver="true">
      <component_list declarationName="heatPortRotorWinding" description="&quot;Heat port of damper cage (optional)&quot;" isAnnotation="true" isAnnotationOver="true" condition_attribute="useDamperCage">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-30},{0,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Thermal port for synchronous machine with reluctance rotor&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
