  <within withName="Modelica.Electrical.Machines.Interfaces.InductionMachines"/>
  <classes classType="record" className="PowerBalanceSMEE" description="&quot;Power balance of synchronous machines with electrical excitation&quot;" isLongClassSpecifier="true" classNameEnd="PowerBalanceSMEE" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialPowerBalanceInductionMachines" isOver="true">
      <extendsModifications expression="lossPowerStatorWinding + lossPowerStatorCore + lossPowerRotorCore + lossPowerStrayLoad + lossPowerFriction + lossPowerRotorWinding + lossPowerExcitation + lossPowerBrush" elementName="lossPowerTotal" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="lossPowerRotorWinding" description="&quot;Rotor copper losses&quot;"/>
