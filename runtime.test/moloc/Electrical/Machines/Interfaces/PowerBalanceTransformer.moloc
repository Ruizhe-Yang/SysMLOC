<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Interfaces">
  <classes classType="record" className="PowerBalanceTransformer" description="&quot;Power balance of transformers&quot;" isLongClassSpecifier="true" classNameEnd="PowerBalanceTransformer" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="power1" description="&quot;Primary power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="power2" description="&quot;Secondary power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="lossPower1 + lossPower2 + lossPowerCore" declarationName="lossPowerTotal" description="&quot;Total loss power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="lossPower1" description="&quot;Primary copper losses&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="lossPower2" description="&quot;Secondary copper losses&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list declarationName="lossPowerCore" description="&quot;Core losses&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;output&quot;" elementName="defaultComponentPrefixes"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Power balance of transformers.&#xA; &lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
