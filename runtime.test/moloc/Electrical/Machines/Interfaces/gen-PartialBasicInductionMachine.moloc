<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Interfaces"/>
  <classes isPartial="true" classType="model" className="PartialBasicInductionMachine" description="&quot;Partial model for induction machine&quot;" isLongClassSpecifier="true" classNameEnd="PartialBasicInductionMachine" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isfinal="true" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="p" description="&quot;Number of pole pairs (Integer)&quot;">
        <modifications expression="1" elementName="min"/>
        <modifications expression="2" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="fsNominal" description="&quot;Nominal frequency&quot;">
        <modifications expression="50" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="TsOperational" description="&quot;Operational temperature of stator resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="293.15" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Operational temperatures&quot;" elementName="group"/>
          <modifications expression="not useThermalPort" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Rs" description="&quot;Stator resistance per phase at TRef&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.03" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal resistances and inductances&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="TsRef" description="&quot;Reference temperature of stator resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="293.15" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal resistances and inductances&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Thermal.LinearTemperatureCoefficient20" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="alpha20s" description="&quot;Temperature coefficient of stator resistance at 20 degC&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal resistances and inductances&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="Lssigma" declarationName="Lszero" description="&quot;Stator zero sequence inductance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal resistances and inductances&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Lssigma" description="&quot;Stator stray inductance per phase&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="3*(1 - sqrt(1 - 0.0667 ) ) /(2*pi*fsNominal)" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal resistances and inductances&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PartialBasicMachine" isOver="true">
      <extendsModifications isModificationOver="true" elementName="Jr">
        <modifications expression="0.29" elementName="start"/>
      </extendsModifications>
      <extendsModifications isModificationOver="true" elementName="frictionParameters">
        <modifications expression="2*pi*fsNominal/p" elementName="wRef"/>
      </extendsModifications>
      <extendsModifications isModificationOver="true" elementName="friction">
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Losses.CoreParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="statorCoreParameters" description="&quot;Stator core loss parameter record;&#xA;all parameters refer to stator side&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="3" elementName="m" isfinal="true"/>
        <modifications isModificationOver="true" elementName="VRef">
          <modifications expression="100" elementName="start"/>
        </modifications>
        <modifications expression="2*pi*fsNominal" elementName="wRef"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Losses.StrayLoadParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="strayLoadParameters" description="&quot;Stray load loss parameter record&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="IRef">
          <modifications expression="100" elementName="start"/>
        </modifications>
        <modifications expression="2*pi*fsNominal/p" elementName="wRef"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialPowerBalanceInductionMachines" directionType="output" isReplaceable="true" isOver="true">
      <component_list isModificationOver="true" declarationName="powerBalance" description="&quot;Power balance&quot;">
        <modifications expression="Machines.SpacePhasors.Functions.activePower(vs, is)" elementName="powerStator" isfinal="true"/>
        <modifications expression="wMechanical*tauShaft" elementName="powerMechanical" isfinal="true"/>
        <modifications expression="inertiaStator.J*inertiaStator.a*inertiaStator.w" elementName="powerInertiaStator" isfinal="true"/>
        <modifications expression="inertiaRotor.J*inertiaRotor.a*inertiaRotor.w" elementName="powerInertiaRotor" isfinal="true"/>
        <modifications expression="sum(rs.resistor.LossPower)" elementName="lossPowerStatorWinding" isfinal="true"/>
        <modifications expression="statorCore.lossPower" elementName="lossPowerStatorCore" isfinal="true"/>
        <modifications expression="strayLoad.lossPower" elementName="lossPowerStrayLoad" isfinal="true"/>
        <modifications expression="friction.lossPower" elementName="lossPowerFriction" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="plug_sp.pin.v - plug_sn.pin.v" declarationName="vs" description="&quot;Stator instantaneous voltages&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="plug_sp.pin.i" declarationName="is" description="&quot;Stator instantaneous currents&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
      <component_list isModificationOver="true" expression="spacePhasorS.zero.i" declarationName="i_0_s" description="&quot;Stator zero-sequence current&quot;">
        <modifications expression="StateSelect.prefer" elementName="stateSelect"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
      <component_list subscripts="[2]" declarationName="idq_ss" description="&quot;Stator space phasor current / stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
      <component_list subscripts="[2]" isModificationOver="true" declarationName="idq_sr" description="&quot;Stator space phasor current / rotor fixed frame&quot;">
        <modifications expression="StateSelect.prefer" elementName="stateSelect" isEach="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
      <component_list subscripts="[2]" declarationName="idq_rs" description="&quot;Rotor space phasor current / stator fixed frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
      <component_list subscripts="[2]" isModificationOver="true" declarationName="idq_rr" description="&quot;Rotor space phasor current / rotor fixed frame&quot;">
        <modifications expression="StateSelect.prefer" elementName="stateSelect" isEach="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Interfaces.PositivePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_sp" description="&quot;Positive stator plug&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50, 90 } ,{70,110} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Interfaces.NegativePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_sn" description="&quot;Negative stator plug&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-70, 90 } ,{-50,110} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="rs" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <modifications expression="fill(Rs, m)" elementName="R" isfinal="true"/>
        <modifications expression="fill(TsRef, m)" elementName="T_ref" isfinal="true"/>
        <modifications expression="fill(Machines.Thermal.convertAlpha(alpha20s, TsRef), m)" elementName="alpha" isfinal="true"/>
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
        <modifications expression="fill(TsRef, m)" elementName="T" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{ 60,70} ,{40,90} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.BasicMachines.Components.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="lssigma" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="fill(Lssigma, 2)" elementName="L" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{20,20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="lszero" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Lszero" elementName="L" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,40},{-20,60}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Losses.InductionMachines.Core" isOver="true">
      <component_list isModificationOver="true" declarationName="statorCore" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="statorCoreParameters" elementName="coreParameters" isfinal="true"/>
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
        <modifications expression="1" elementName="turnsRatio" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{0,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.SpacePhasors.Components.SpacePhasor" isOver="true">
      <component_list isModificationOver="true" declarationName="spacePhasorS" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="turnsRatio" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,70}" elementName="origin"/>
            <modifications expression="{{10,10},{-10,-10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Losses.InductionMachines.StrayLoad" isOver="true">
      <component_list isModificationOver="true" declarationName="strayLoad" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="strayLoadParameters" elementName="strayLoadParameters" isfinal="true"/>
        <modifications expression="true" elementName="useHeatPort" isfinal="true"/>
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,70},{70,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialThermalPortInductionMachines" isReplaceable="true" isOver="true">
      <component_list isModificationOver="true" declarationName="thermalPort" isAnnotation="true" isAnnotationOver="true" condition_attribute="useThermalPort">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-110},{10,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialThermalAmbientInductionMachines" isReplaceable="true" isOver="true">
      <component_list isModificationOver="true" declarationName="thermalAmbient" isAnnotation="true" isAnnotationOver="true" condition_attribute="not useThermalPort">
        <modifications expression="false" elementName="useTemperatureInputs" isfinal="true"/>
        <modifications expression="TsOperational" elementName="Ts" isfinal="true"/>
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-30,-80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="constant" isProtected="true" isOver="true">
      <component_list expression="Modelica.Constants.pi" declarationName="pi"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialThermalPortInductionMachines" isReplaceable="true" isOver="true">
      <component_list isModificationOver="true" declarationName="internalThermalPort" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-4,-84},{4,-76}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="spacePhasorS.plug_n" right="plug_sn">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,80},{-60,80},{-60,100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="strayLoad.plug_n" right="rs.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,80},{60,80}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="strayLoad.plug_p" right="plug_sp">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,80},{90,100},{60,100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="strayLoad.support" right="internalSupport">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,70},{80,50},{60,50},{60,-100}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="spacePhasorS.plug_p" right="rs.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,80},{40,80}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="spacePhasorS.zero" right="lszero.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,60},{0,50}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="lszero.n" right="spacePhasorS.ground">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,50},{-20,60},{-10,60}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="spacePhasorS.spacePhasor" right="lssigma.spacePhasor_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,60},{20,60},{20,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="statorCore.spacePhasor" right="lssigma.spacePhasor_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,30},{20,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="statorCore.heatPort" right="internalThermalPort.heatPortStatorCore">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,40},{50,40},{50,-79.2},{0.4,-79.2}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="strayLoad.heatPort" right="internalThermalPort.heatPortStrayLoad">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,70},{90,60},{50,60},{50,-80},{0.4,-80}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="rs.heatPort" right="internalThermalPort.heatPortStatorWinding">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,70},{50,-79.2},{-0.4,-79.2}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="friction.heatPort" right="internalThermalPort.heatPortFriction">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,-50},{50,-50},{50,-81.6},{0,-81.6}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="strayLoad.flange" right="inertiaRotor.flange_b">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,90},{100,90},{100,40},{90,40},{90,0}}" elementName="points"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="internalThermalPort" right="thermalPort">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-80},{0,-80},{0,-100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="thermalAmbient.thermalPort" right="internalThermalPort">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-80},{-12,-80},{0,-80}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>Partial model for induction machine models&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{-50,100},{-20,100},{-20,70}}, color={0,0,255} ) , Line(points={{50,100},{20,100},{20,70}}, color={0,0,255} ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
