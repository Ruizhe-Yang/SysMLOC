<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Losses.DCMachines">
  <classes classType="function" className="brushVoltageDrop" description="&quot;Voltage drop of carbon brushes&quot;" isLongClassSpecifier="true" classNameEnd="brushVoltageDrop" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Losses.BrushParameters" directionType="input" isOver="true">
      <component_list declarationName="brushParameters" description="&quot;Brush loss parameters&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
      <component_list declarationName="i" description="&quot;Actual current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
      <component_list declarationName="v" description="&quot;Voltage drop&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AlgorithmSection">
      <statements xsi:type="mOloc:IfStatement" condition="(brushParameters.V &lt;= 0)">
        <ifStatements xsi:type="mOloc:FunctionStatement" component="v" expression="0"/>
        <elseStatements xsi:type="mOloc:FunctionStatement" component="v" expression="if (i > +brushParameters.ILinear) then +brushParameters.V else if (i &lt; -brushParameters.ILinear) then -brushParameters.V else brushParameters.V*i/brushParameters.ILinear"/>
      </statements>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Calculates the voltage drop of carbon brushes, according to&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.Machines.Losses.DCMachines.Brush\&quot;>Brush&lt;/a> losses,&#xA;e.g., used for initial equations.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
