<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Blocks"/>
  <classes classType="block" className="LessThreshold" description="&quot;Sets angle to zero when length is below threshold&quot;" isLongClassSpecifier="true" classNameEnd="LessThreshold" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.MISO" isOver="true">
      <extendsModifications expression="2" elementName="nin" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="threshold" description="&quot;Threshold&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="if noEvent(u[1]&lt;threshold) then 0 else u[2]"/>
    </elements>
  </classes>
</mOloc:Stored_definition>
