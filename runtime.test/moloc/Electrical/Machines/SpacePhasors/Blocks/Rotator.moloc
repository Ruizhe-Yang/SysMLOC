<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Blocks"/>
  <classes classType="block" className="Rotator" description="&quot;Rotates space phasor&quot;" isLongClassSpecifier="true" classNameEnd="Rotator" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.MIMOs" isOver="true">
      <extendsModifications expression="2" elementName="n" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isProtected="true" isOver="true">
      <component_list subscripts="[2, 2]" expression="{{+cos(-angle),-sin(-angle)},{+sin(-angle),+ cos(-angle) } }" declarationName="RotationMatrix"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isPublic="true" isOver="true">
      <component_list isModificationOver="true" declarationName="angle" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;rad&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,-120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="RotationMatrix*u"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{0,0},{0,80},{-10, 60 } ,{10,60},{0,80} } , color={0,0,255} ) ,Line(points={{0,0},{80,0}, {60,10},{60,-10},{80,0} } , color={0,0,255} ) , Polygon( points={{50,0},{42,14},{54,16},{50,0}}, lineColor={0,0,255}, fillColor={0,0,255}, fillPattern=FillPattern.Solid ) ,Text( extent={{-88,-72},{84,-92}}, textString=&quot;angle&quot; ) , Line( points={{0,50},{18,48},{32,40},{42,28},{48,16},{50,0}}, color={0,0,255}, smooth=Smooth.Bezier ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Rotates a space phasor (voltage or current) input &lt;code>u&lt;/code> by the &lt;code>angle&lt;/code> in negative mathematical direction. This block represents the transformation of one space phasor &lt;code>u&lt;/code> from one rotating reference (coordinate) frame into another where the space phasor is &lt;code>y&lt;/code>. The output reference frame leads the input reference frame by angle &lt;code>angle&lt;/code>.&#xA;&#xA;&lt;table border=\&quot;0\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;>&#xA;  &lt;tr>&#xA;    &lt;td>&#xA;      &lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/Machines/Rotator.png\&quot;>&#xA;    &lt;/td>&#xA;  &lt;/tr>&#xA;  &lt;caption align=\&quot;bottom\&quot;>&lt;strong>Fig. 1:&lt;/strong> Original and rotated reference frame of a space phasor &lt;/caption>&#xA;&lt;/table>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
