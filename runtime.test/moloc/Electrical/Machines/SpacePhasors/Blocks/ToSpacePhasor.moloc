<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.SpacePhasors.Blocks">
  <classes classType="block" className="ToSpacePhasor" description="&quot;Conversion of polyphase instantaneous values to space phasors&quot;" isLongClassSpecifier="true" classNameEnd="ToSpacePhasor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.MIMO" isOver="true">
      <extendsModifications expression="m" elementName="nin" isfinal="true"/>
      <extendsModifications expression="2" elementName="nout" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Angle" parameterType="parameter" isProtected="true" isOver="true">
      <component_list subscripts="[m]" expression="Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m)" declarationName="phi"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[2, m]" expression="2/m*{+cos(+phi),+sin(+phi)}" declarationName="TransformationMatrix"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[m, 2]" expression="{{+cos(-phi[k]),-sin(-phi[k])} for k in 1:m }" declarationName="InverseTransformation"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isPublic="true" isOver="true">
      <component_list declarationName="zero" description="&quot;Zero sequence component&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-70},{120,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="m*zero" right="sum(u)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="TransformationMatrix*u"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line(points={{0,0},{80,80},{60,72},{72, 60 } ,{80,80} } , color={0,0,255} ) ,Line(points={{0,0},{80,-80},{72, -60 } ,{60,-72},{80,-80} } , color={0,0,255} ) ,Line( points={{-80,0},{-73.33,10},{-66.67,17.32},{-60,20},{-53.33, 17.32 } ,{-46.67,10},{-40,0},{-33.33,-10},{-26.67,-17.32},{-20, -20 } ,{-13.33,-17.32},{-6.67,-10},{0,0} } , color={0,0,255}, smooth=Smooth.Bezier ) ,Line( points={{-90,0},{-83.33,10},{-76.67,17.32},{-70,20},{-63.33, 17.32 } ,{-56.67,10},{-50,0},{-43.33,-10},{-36.67,-17.32},{-30, -20 } ,{-23.33,-17.32},{-16.67,-10},{-10,0} } , color={0,0,255}, smooth=Smooth.Bezier ) ,Line( points={{-70,0},{-63.33,10},{-56.67,17.32},{-50,20},{-43.33, 17.32 } ,{-36.67,10},{-30,0},{-23.33,-10},{-16.67,-17.32},{-10, -20 } ,{-3.33,-17.32},{3.33,-10},{10,0} } , color={0,0,255}, smooth=Smooth.Bezier ) ,Text( extent={{-12,-74},{64,-86}}, textString=&quot;zero&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Transformation of polyphase values (of voltages or currents) to space phasor and zero sequence value.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
