<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Blocks"/>
  <classes classType="block" className="QuasiRMS" isLongClassSpecifier="true" classNameEnd="QuasiRMS" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Interfaces.MISO" isOver="true">
      <extendsModifications expression="2" elementName="nin" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Machines.SpacePhasors.Blocks.ToPolar" isOver="true">
      <component_list declarationName="toPolar" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-40,-10},{-20,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.Gain" isOver="true">
      <component_list isModificationOver="true" declarationName="gain" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1/sqrt(2)" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-10},{40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="u" right="toPolar.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-120,0},{-42,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="toPolar.y[1]" right="gain.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-19,0},{0,0},{0,0},{18,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="gain.y" right="y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{41,0},{110,0}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This model determines the RMS value of the input space phasor &lt;code>u&lt;/code>.&lt;/p> &lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Text( extent={{-60,40},{60,-20}}, textColor={0,0,255}, textString=&quot;RMS&quot; ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
