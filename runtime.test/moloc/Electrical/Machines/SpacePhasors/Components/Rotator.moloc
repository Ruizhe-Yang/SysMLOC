<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Components"/>
  <classes classType="model" className="Rotator" description="&quot;Rotates space phasor&quot;" isLongClassSpecifier="true" classNameEnd="Rotator" isOver="true">
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isProtected="true" isOver="true">
      <component_list subscripts="[2, 2]" expression="{{+cos(-angle),-sin(-angle)},{+sin(-angle),+ cos(-angle) } }" declarationName="RotationMatrix"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.SpacePhasor" isPublic="true" isOver="true">
      <component_list declarationName="spacePhasor_a" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,90},{-90,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Interfaces.SpacePhasor" isOver="true">
      <component_list declarationName="spacePhasor_b" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,90},{110,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="angle" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;rad&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,-120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="spacePhasor_b.v_" right="RotationMatrix*spacePhasor_a.v_"/>
      <equations xsi:type="mOloc:SimpleEquation" left="spacePhasor_b.i_ + RotationMatrix*spacePhasor_a.i_" right="zeros(2)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{0,0},{80,0},{60,10},{ 60,-10} ,{80,0} } , color={0,0,255} ) ,Line(points={{0,0},{0,80},{-10, 60 } ,{10,60},{0,80} } , color={0,0,255} ) ,Polygon( points={{50,0},{42,14},{54,16},{50,0}}, lineColor={0,0,255}, fillColor={0,0,255}, fillPattern=FillPattern.Solid ) , Line( points={{0,50},{18,48},{32,40},{42,28},{48,16},{50,0}}, color={0,0,255}, smooth=Smooth.Bezier ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Rotates space phasors of left connector to right connector by the angle provided by the input signal \&quot;angle\&quot; from one coordinate system into another.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
