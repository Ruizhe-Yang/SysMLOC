  <within withName="Modelica.Electrical.Machines.SpacePhasors"/>
  <classes classType="package" className="Components" description="&quot;Basic space phasor models&quot;" isLongClassSpecifier="true" classNameEnd="Components" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>This package contains basic space phasor models.&lt;br>Real and imaginary part of voltage space phasor are the potentials v_[2] of the space phasor connector;&#xA;(implicit grounded).&lt;br>Real and imaginary part of current space phasor are the currents i_[2] at the space phasor connector;&#xA;a ground has to be used where necessary for currents flowing back.&lt;/html>&quot;" elementName="info"/>
        <modifications expression="&quot;&lt;html>&lt;dl> &lt;dt>&lt;strong>Main Authors:&lt;/strong>&lt;/dt> &lt;dd> &lt;a href=\&quot;https://www.haumer.at/\&quot;>Anton Haumer&lt;/a>&lt;br>&#xA;Technical Consulting &amp;amp;&#xA;Electrical Engineering&lt;br> D-93049 Regensburg&lt;br>Germany&lt;br> email: &lt;a href=\&quot;mailto:a.haumer@haumer.at\&quot;>a.haumer@haumer.at&lt;/a> &lt;/dd>&lt;/dl> &lt;ul> &lt;li> v1.00 2004/09/16 Anton Haumer&lt;/li> &lt;li> v1.60 2005/11/03 Anton Haumer&lt;br> added Rotator&lt;/li> &lt;li> v1.6.1 2005/11/10 Anton Haumer&lt;br> improved Transformation and Rotation&lt;/li> &lt;/ul>&lt;/html>&quot;" elementName="revisions"/>
      </annotations>
    </elements>
  </classes>
