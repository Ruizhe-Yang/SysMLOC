<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Functions"/>
  <classes classType="function" className="Rotator" description="&quot;Rotates space phasor&quot;" isLongClassSpecifier="true" classNameEnd="Rotator" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="input" isOver="true">
      <component_list subscripts="[2]" declarationName="x" description="&quot;Input space phasor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="input" isOver="true">
      <component_list declarationName="angle" description="&quot;Input angle of rotation&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[2]" declarationName="y" description="&quot;Output space phasor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" isProtected="true" isOver="true">
      <component_list subscripts="[2, 2]" expression="{{+cos(-angle),-sin(-angle)},{+sin(-angle),+ cos(-angle) } }" declarationName="RotationMatrix"/>
    </elements>
    <elements xsi:type="mOloc:AlgorithmSection">
      <statements xsi:type="mOloc:FunctionStatement" component="y" expression="RotationMatrix*x"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="true" elementName="Inline"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>Rotates a space phasor (voltage or current) input &lt;code>u&lt;/code> by the &lt;code>angle&lt;/code> in negative mathematical direction. This block represents the transformation of one space phasor &lt;code>u&lt;/code> from one rotating reference (coordinate) frame into another where the space phasor is &lt;code>y&lt;/code>. The output reference frame leads the input reference frame by angle &lt;code>angle&lt;/code>.&lt;table border=\&quot;0\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;> &lt;tr> &lt;td> &lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/Machines/Rotator.png\&quot;>&#xA;&lt;/td> &lt;/tr> &lt;caption align=\&quot;bottom\&quot;>&lt;strong>Fig. 1:&lt;/strong> Original and rotated reference frame of a space phasor &lt;/caption>&lt;/table>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
