<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.SpacePhasors.Functions"/>
  <classes classType="function" className="ToSpacePhasor" description="&quot;Conversion from polyphase input to space phasor and zero sequence component&quot;" isLongClassSpecifier="true" classNameEnd="ToSpacePhasor" isOver="true">
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="input" isOver="true">
      <component_list subscripts="[:]" declarationName="x" description="&quot;Polyphase (voltage or current) input&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[2]" declarationName="y" description="&quot;Space phasor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list declarationName="y0" description="&quot;Zero sequence component (of voltage or current)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isProtected="true" isOver="true">
      <component_list expression="size(x, 1)" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" expression="Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m)" declarationName="phi"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[2, m]" expression="2/m*{+cos(+phi),+sin(+phi)}" declarationName="TransformationMatrix"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list subscripts="[m, 2]" expression="{{+cos(-phi[k]),-sin(-phi[k])} for k in 1:m }" declarationName="InverseTransformation"/>
    </elements>
    <elements xsi:type="mOloc:AlgorithmSection">
      <statements xsi:type="mOloc:FunctionStatement" component="y" expression="TransformationMatrix*x"/>
      <statements xsi:type="mOloc:FunctionStatement" component="y0" expression="1/m*sum(x)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="true" elementName="Inline"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>Transformation of polyphase values (of voltages or currents) to space phasor and zero sequence value.&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
