<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Thermal.DCMachines">
  <classes classType="model" className="ThermalAmbientDCSE" description="&quot;Thermal ambient for DC machine with series excitation&quot;" isLongClassSpecifier="true" classNameEnd="ThermalAmbientDCSE" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Interfaces.DCMachines.PartialThermalAmbientDCMachines" isOver="true">
      <extendsModifications typeSpecifier="Machines.Interfaces.DCMachines.ThermalPortDCSE" declarationName="thermalPort" isRedeclare="true" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Tse" description="&quot;Temperature of series excitation&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="TDefault" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="not useTemperatureInputs" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.HeatFlowRate" directionType="output" isOver="true">
      <component_list expression="temperatureSeriesExcitation.port.Q_flow" declarationName="Q_flowSeriesExcitation" description="&quot;Heat flow rate of series excitation&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.HeatFlowRate" directionType="output" isOver="true">
      <component_list expression="Q_flowArmature + Q_flowCore + Q_flowStrayLoad + Q_flowFriction + Q_flowBrush + Q_flowSeriesExcitation" declarationName="Q_flowTotal"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature" isOver="true">
      <component_list declarationName="temperatureSeriesExcitation" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-50,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Sources.Constant" isOver="true">
      <component_list isModificationOver="true" declarationName="constTse" isAnnotation="true" isAnnotationOver="true" condition_attribute="not useTemperatureInputs">
        <modifications expression="Tse" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-50,-10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="T_se" description="&quot;Temperature of series excitation&quot;" isAnnotation="true" isAnnotationOver="true" condition_attribute="useTemperatureInputs">
        <modifications expression="&quot;K&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-120}" elementName="origin"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constTse.y" right="temperatureSeriesExcitation.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,1},{-50,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="T_se" right="temperatureSeriesExcitation.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-120},{0,-60},{-70,-60},{-70,8},{-50,8},{-50,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="temperatureSeriesExcitation.port" right="thermalPort.heatPortSeriesExcitation">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,40},{-50,100},{0,100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Text( extent={{-100,-20},{100,-80}}, textString=&quot;DCSE&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Thermal ambient for DC machines with serial excitation to prescribe winding temperatures either constant or via signal connectors.&#xA;Additionally, all losses = heat flows are recorded.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
