<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Thermal.SynchronousMachines"/>
  <classes classType="model" className="ThermalAmbientSMPM" description="&quot;Thermal ambient for synchronous machine with permanent magnets&quot;" isLongClassSpecifier="true" classNameEnd="ThermalAmbientSMPM" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="useDamperCage" description="&quot;Enable / disable damper cage&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="true" elementName="start"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Machines.Interfaces.InductionMachines.PartialThermalAmbientInductionMachines" isOver="true">
      <extendsModifications typeSpecifier="Machines.Interfaces.InductionMachines.ThermalPortSMPM" isModificationOver="true" declarationName="thermalPort" isRedeclare="true" isfinal="true">
        <modifications expression="useDamperCage" elementName="useDamperCage" isfinal="true"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Tpm" description="&quot;Temperature of permanent magnet&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="TDefault" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="not useTemperatureInputs" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="Tr" description="&quot;Temperature of damper cage (optional)&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="TDefault" elementName="start"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="( not useTemperatureInputs and useDamperCage)" elementName="enable"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.HeatFlowRate" directionType="output" isOver="true">
      <component_list expression="temperatureRotorWinding.port.Q_flow" declarationName="Q_flowRotorWinding" description="&quot;Heat flow rate of damper cage (optional)&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.HeatFlowRate" directionType="output" isOver="true">
      <component_list expression="temperaturePermanentMagnet.port.Q_flow" declarationName="Q_flowPermanentMagnet" description="&quot;Heat flow rate of permanent magnets&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.HeatFlowRate" directionType="output" isOver="true">
      <component_list expression="Q_flowStatorWinding + Q_flowRotorWinding + Q_flowPermanentMagnet + Q_flowStatorCore + Q_flowRotorCore + Q_flowStrayLoad + Q_flowFriction" declarationName="Q_flowTotal"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature" isOver="true">
      <component_list declarationName="temperatureRotorWinding" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-20,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="TRotorWinding" description="&quot;Temperature of damper cage (optional)&quot;" isAnnotation="true" isAnnotationOver="true" condition_attribute="( useTemperatureInputs and useDamperCage)">
        <modifications expression="&quot;K&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{100,-120}" elementName="origin"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{100,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Constant" isOver="true">
      <component_list isModificationOver="true" declarationName="constTr" isAnnotation="true" isAnnotationOver="true" condition_attribute="(not useTemperatureInputs or not useDamperCage )">
        <modifications expression="if useDamperCage then Tr else TDefault" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-20,-10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Sources.PrescribedTemperature" isOver="true">
      <component_list declarationName="temperaturePermanentMagnet" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-50,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.Constant" isOver="true">
      <component_list isModificationOver="true" declarationName="constTpm" isAnnotation="true" isAnnotationOver="true" condition_attribute="(not useTemperatureInputs )">
        <modifications expression="Tpm" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-50,-10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list isModificationOver="true" declarationName="TPermanentMagnet" description="&quot;Temperature of permanent magnet&quot;" isAnnotation="true" isAnnotationOver="true" condition_attribute="useTemperatureInputs">
        <modifications expression="&quot;K&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-120}" elementName="origin"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{0,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constTr.y" right="temperatureRotorWinding.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,1},{-20,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="temperatureRotorWinding.port" right="thermalPort.heatPortRotorWinding">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,40},{-20,100},{0,100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="TRotorWinding" right="temperatureRotorWinding.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{100,-120},{100,8},{-20,8},{-20,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="temperaturePermanentMagnet.port" right="thermalPort.heatPortPermanentMagnet">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,40},{-50,100},{0,100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constTpm.y" right="temperaturePermanentMagnet.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-50,1},{-50,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="TPermanentMagnet" right="temperaturePermanentMagnet.T">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-120},{0,-60},{-64,-60},{-64,8},{-50,8},{-50,18}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Text( extent={{-100,-20},{100,-80}}, textString=&quot;SMPM&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Thermal ambient for synchronous machines with permanent magnets to prescribe winding temperatures either constant or via signal connectors.&#xA;Additionally, all losses = heat flows are recorded.&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
