<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Machines.Utilities.ParameterRecords">
  <classes classType="record" className="DcPermanentMagnetData" description="&quot;Common parameters for DC machines&quot;" isLongClassSpecifier="true" classNameEnd="DcPermanentMagnetData" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="0.15" declarationName="Jr" description="&quot;Rotor's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Inertia" parameterType="parameter" isOver="true">
      <component_list expression="Jr" declarationName="Js" description="&quot;Stator's moment of inertia&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="VaNominal" description="&quot;Nominal armature voltage&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal parameters&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="IaNominal" description="&quot;Nominal armature current (>0..Motor, &lt;0..Generator)&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal parameters&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.AngularVelocity" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1425*2*pi/60" declarationName="wNominal" description="&quot;Nominal speed&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;rev/min&quot;" elementName="displayUnit"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal parameters&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="293.15" declarationName="TaNominal" description="&quot;Nominal armature temperature&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Nominal parameters&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="0.05" declarationName="Ra" description="&quot;Armature resistance at TaRef&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Armature&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="293.15" declarationName="TaRef" description="&quot;Reference temperature of armature resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Armature&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Thermal.LinearTemperatureCoefficient20" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="alpha20a" description="&quot;Temperature coefficient of armature resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Armature&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="0.0015" declarationName="La" description="&quot;Armature inductance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Armature&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Losses.FrictionParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="frictionParameters" description="&quot;Friction loss parameter record&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="PRef"/>
        <modifications expression="wNominal" elementName="wRef"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="VaNominal - Machines.Thermal.convertResistance( Ra, TaRef, alpha20a, TaNominal ) *IaNominal - Machines.Losses.DCMachines.brushVoltageDrop(brushParameters, IaNominal )" declarationName="ViNominal" description="&quot;Induced voltage at nominal operating point&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Losses.CoreParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="coreParameters" description="&quot;Armature core loss parameter record&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="m" isfinal="true"/>
        <modifications expression="0" elementName="PRef"/>
        <modifications expression="ViNominal" elementName="VRef"/>
        <modifications expression="wNominal" elementName="wRef"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Losses.StrayLoadParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="strayLoadParameters" description="&quot;Stray load losses&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="PRef"/>
        <modifications expression="IaNominal" elementName="IRef"/>
        <modifications expression="wNominal" elementName="wRef"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Machines.Losses.BrushParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="brushParameters" description="&quot;Brush loss parameter record&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="V"/>
        <modifications expression="0.01* IaNominal" elementName="ILinear"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;dcpmData&quot;" elementName="defaultComponentName"/>
      <annotations expression="&quot;parameter&quot;" elementName="defaultComponentPrefixes"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Basic parameters of DC machines are predefined with default values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
