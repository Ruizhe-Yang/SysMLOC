<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Machines.Utilities.ParameterRecords"/>
  <classes classType="record" className="SM_ElectricalExcitedData" description="&quot;Common parameters for synchronous machines with electrical excitation&quot;" isLongClassSpecifier="true" classNameEnd="SM_ElectricalExcitedData" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="SM_ReluctanceRotorData" isOver="true">
      <extendsModifications expression="1.5/(2*pi*fsNominal)" elementName="Lmd"/>
      <extendsModifications expression="1.5/(2*pi* fsNominal )" elementName="Lmq"/>
    </elements>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="VsNominal" description="&quot;Nominal stator RMS voltage per phase&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list expression="10" declarationName="IeOpenCircuit" description="&quot;Open circuit excitation current @ nominal voltage and frequency&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="2.5" declarationName="Re" description="&quot;Excitation resistance at TRef&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Temperature" parameterType="parameter" isOver="true">
      <component_list expression="293.15" declarationName="TeRef" description="&quot;Reference temperature of excitation resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Thermal.LinearTemperatureCoefficient20" parameterType="parameter" isOver="true">
      <component_list expression="0" declarationName="alpha20e" description="&quot;Temperature coefficient of excitation resistance&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="0.025" declarationName="sigmae" description="&quot;Stray fraction of total excitation inductance&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="min"/>
        <modifications expression="0.99" elementName="max"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Excitation&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Machines.Losses.BrushParameters" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="brushParameters" description="&quot;Brush loss parameter record&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="V"/>
        <modifications expression="0.01" elementName="ILinear"/>
        <annotations isModificationOver="true" elementName="Dialog">
          <modifications expression="&quot;Losses&quot;" elementName="tab"/>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;smeeData&quot;" elementName="defaultComponentName"/>
      <annotations expression="&quot;parameter&quot;" elementName="defaultComponentPrefixes"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Basic parameters of synchronous machines with electrical excitation are predefined with default values.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
