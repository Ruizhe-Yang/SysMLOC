  <within withName="Modelica.Electrical.Polyphase.Basic"/>
  <classes classType="model" className="Capacitor" description="&quot;Ideal linear electrical capacitors&quot;" isLongClassSpecifier="true" classNameEnd="Capacitor" isOver="true">
