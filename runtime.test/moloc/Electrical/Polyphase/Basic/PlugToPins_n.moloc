  <classes classType="model" className="PlugToPins_n" description="&quot;Connect all (negative) Pins&quot;" isLongClassSpecifier="true" classNameEnd="PlugToPins_n" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
