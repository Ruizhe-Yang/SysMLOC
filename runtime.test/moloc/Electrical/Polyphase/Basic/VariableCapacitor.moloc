<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Polyphase.Basic"/>
  <classes classType="model" className="VariableCapacitor" description="&quot;Ideal linear electrical capacitors with variable capacitance&quot;" isLongClassSpecifier="true" classNameEnd="VariableCapacitor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.TwoPlug" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Capacitance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" expression="fill(Modelica.Constants.eps, m )" declarationName="Cmin" description="&quot;Minimum capacitance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="C" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;F&quot;" elementName="unit" isEach="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.VariableCapacitor" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="variableCapacitor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Cmin" elementName="Cmin" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10}, {10,10} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableCapacitor.p" right="plug_p.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,0},{-100,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableCapacitor.n" right="plug_n.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{100,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="C" right="variableCapacitor.C">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,120},{0,56},{0,12}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;capacitor&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{-90,0},{-6,0}}, color={0,0,255}), Line(points={{6,0},{90,0}}, color={0,0,255}), Line(points={{-6,28},{-6,-28}}, color={0,0,255}), Line(points={{6,28},{6,-28}}, color={0,0,255}), Text( extent={{-150,-80},{150,-40}}, textString=&quot;m=%m&quot; ) , Text( extent={{-150,90},{150,50}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Contains m variable capacitors (Modelica.Electrical.Analog.Basic.VariableCapacitor)&#xA;&lt;/p>&#xA;&lt;p>&#xA;It is required that each C_Port.signal &amp;ge; 0, otherwise an&#xA;assertion is raised. To avoid a variable index system,&lt;br>&#xA;C = Cmin, if 0 &amp;le; C_Port.signal &amp;lt; Cmin, where&#xA;Cmin is a parameter with default value Modelica.Constants.eps.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
