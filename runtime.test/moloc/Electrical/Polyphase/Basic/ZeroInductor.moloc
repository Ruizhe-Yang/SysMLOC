<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Polyphase.Basic"/>
  <classes classType="model" className="ZeroInductor" description="&quot;Linear zero sequence inductor&quot;" isLongClassSpecifier="true" classNameEnd="ZeroInductor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Polyphase.Interfaces.OnePort" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list declarationName="Lzero" description="&quot;Zero sequence inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list declarationName="i0"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list declarationName="v0"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="m*i0" right="sum(i)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v0" right="Lzero*der(i0)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="fill(v0, m)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;inductor&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Model of a polyphase zero sequence inductor.&#xA;&lt;/p>&#xA;&lt;h4>Implementation&lt;/h4>&#xA;&lt;blockquote>&lt;pre>&#xA;v = Lzero*sum(der(i)) = Lzero*der(sum(i))&#xA;&lt;/pre>&lt;/blockquote>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(points={{-90,0},{-50,0}}, color={0,0,255}), Line(points={{52,0},{90,0}}, color={0,0,255}), Ellipse(extent={{-50,30},{-8,-32}}, lineColor={0,0,255}), Ellipse(extent={{-20,30},{22,-32}}, lineColor={0,0,255}), Ellipse(extent={{10,30},{52,-32}}, lineColor={0,0,255}), Text( extent={{-150,50},{150,90}}, textString=&quot;%name&quot;, textColor={0,0,255} ) , Text( extent={{-150,-80},{150,-40}}, textString=&quot;m=%m&quot; ) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
