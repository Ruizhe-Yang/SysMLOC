  <within withName="Modelica.Electrical.Polyphase.Basic"/>
  <classes classType="model" className="Transformer" description="&quot;Polyphase Transformer&quot;" isLongClassSpecifier="true" classNameEnd="Transformer" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.FourPlug" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="L1" description="&quot;Primary inductance&quot;">
        <modifications expression="fill(1, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="L2" description="&quot;Secondary inductance&quot;">
        <modifications expression="fill(1, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="M" description="&quot;Coupling inductance&quot;">
        <modifications expression="fill(1, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Transformer" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="transformer" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="L1" elementName="L1" isfinal="true"/>
        <modifications expression="L2" elementName="L2" isfinal="true"/>
        <modifications expression="M" elementName="M" isfinal="true"/>
