          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plug_p1.pin" right="transformer.p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,100},{-10,100},{-10,10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plug_p2.pin" right="transformer.p2">
        <annotations isModificationOver="true" elementName="Line">
