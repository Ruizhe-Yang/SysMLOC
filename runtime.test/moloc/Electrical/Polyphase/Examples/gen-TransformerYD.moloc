<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Polyphase.Examples"/>
  <classes classType="model" className="TransformerYD" description="&quot;Test example with polyphase components&quot;" isLongClassSpecifier="true" classNameEnd="TransformerYD" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="1" declarationName="V" description="&quot;Amplitude of Star-Voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="5" declarationName="f" description="&quot;Frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="1" declarationName="Lm" description="&quot;Transformer main inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Inductance" parameterType="parameter" isOver="true">
      <component_list expression="0.003" declarationName="LT" description="&quot;Transformer stray inductance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="0.05" declarationName="RT" description="&quot;Transformer resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="1" declarationName="RL" description="&quot;Load Resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
      <component_list expression="1/sqrt((1 - Modelica.Math.cos(2*Modelica.Constants.pi/m)) ^2 + (Modelica.Math.sin(2*Modelica.Constants.pi/m))^2 )" declarationName="nT" description="&quot;Transformer ratio&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="sineVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="fill(V, m)" elementName="V"/>
        <modifications expression="fill(f, m)" elementName="f"/>
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-80,20}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starS" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-90,-62}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundS" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-100,-100},{-80,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Ideal.IdealTransformer" isOver="true">
      <component_list isModificationOver="true" declarationName="idealTransformer" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(nT, m)" elementName="n"/>
        <modifications expression="fill(Lm, m)" elementName="Lm1"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-40,0},{ -20,20} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starT" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-40,-62}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Delta" isOver="true">
      <component_list isModificationOver="true" declarationName="deltaT2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{50,10}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundT" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-50,-100},{-30,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="transformerR" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(RT/nT^2, m)" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="transformerL" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(LT/nT^2, m)" elementName="L"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,10},{40,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="loadR" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <modifications expression="fill(RL, m)" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{70,10},{90,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starL" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{90,-62}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="groundL" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{80,-100},{100,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection" isInitial="true">
      <equations xsi:type="mOloc:SimpleEquation" description="&quot;D-connection&quot;" left="transformerL.i[1:m]" right="zeros(m)"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="groundS.p" right="starS.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-80},{-90,-72}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="groundT.p" right="starT.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,-80},{-40,-72}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starS.plug_p" right="sineVoltage.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-52},{-90,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="sineVoltage.plug_p" right="idealTransformer.plug_p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,20},{-40,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealTransformer.plug_n1" right="starT.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,0},{-40,-52}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealTransformer.plug_p2" right="transformerR.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,20},{-10,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformerR.plug_n" right="transformerL.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,20},{20,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformerL.plug_n" right="deltaT2.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,20},{50,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="deltaT2.plug_n" right="idealTransformer.plug_n2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,0},{-20,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="deltaT2.plug_p" right="loadR.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,20},{70,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="loadR.plug_n" right="starL.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,20},{90,-52}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starL.pin_n" right="groundL.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,-72},{90,-80}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Test example with polyphase components:&lt;br>Star-connected voltage source feeds via a Y-D-transformer with internal impedance (RT, LT) a load resistor RT.&lt;br>Using f=5 Hz LT=3mH defines nominal voltage drop of approximately 10 %.&lt;br>Simulate for 1 second (2 periods) and compare voltages and currents of source, transformer and load.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="1.0" elementName="StopTime"/>
        <modifications expression="0.001" elementName="Interval"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
