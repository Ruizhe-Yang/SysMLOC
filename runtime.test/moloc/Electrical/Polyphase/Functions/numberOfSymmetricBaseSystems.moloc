<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Polyphase.Functions"/>
  <classes classType="function" className="numberOfSymmetricBaseSystems" description="&quot;Determines the number of symmetric base systems of m phase symmetric system&quot;" isLongClassSpecifier="true" classNameEnd="numberOfSymmetricBaseSystems" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" directionType="input" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" directionType="output" isOver="true">
      <component_list declarationName="n" description="&quot;Number of symmetric base systems&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AlgorithmSection">
      <statements xsi:type="mOloc:FunctionStatement" component="n" expression="1"/>
      <statements xsi:type="mOloc:IfStatement" condition="mod(m, 2) == 0">
        <ifStatements xsi:type="mOloc:IfStatement" condition="m == 2">
          <ifStatements xsi:type="mOloc:FunctionStatement" component="n" expression="1"/>
          <elseStatements xsi:type="mOloc:FunctionStatement" component="n" expression="n*2*numberOfSymmetricBaseSystems(integer(m/2))"/>
        </ifStatements>
        <elseStatements xsi:type="mOloc:FunctionStatement" component="n" expression="1"/>
      </statements>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This function determines the number of base systems of the symmetrical winding with m phases.&#xA;&lt;/p>&#xA;&lt;h4>See also&lt;/h4>&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.Polyphase.UsersGuide.PhaseOrientation\&quot;>User's guide&lt;/a> on symmetrical components and orientation.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
