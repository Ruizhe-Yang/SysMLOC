<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Polyphase.Ideal">
  <classes classType="model" className="OpenerWithArc" description="&quot;Polyphase opener with arc&quot;" isLongClassSpecifier="true" classNameEnd="OpenerWithArc" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.TwoPlug" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="Ron" description="&quot;Closed switch resistance&quot;">
        <modifications expression="zeros(m)" elementName="min" isfinal="true"/>
        <modifications expression="fill(1e-5, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="Goff" description="&quot;Opened switch conductance&quot;">
        <modifications expression="zeros(m)" elementName="min" isfinal="true"/>
        <modifications expression="fill(1e-5, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="V0" description="&quot;Initial arc voltage&quot;">
        <modifications expression="fill(30, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.VoltageSlope" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="dVdt" description="&quot;Arc voltage slope&quot;">
        <modifications expression="fill(10E3, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="Vmax" description="&quot;Max. arc voltage&quot;">
        <modifications expression="fill(60, m)" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Polyphase.Interfaces.ConditionalHeatPort" isOver="true">
      <extendsModifications expression="m" elementName="mh" isfinal="true"/>
      <extendsModifications expression="fill( 293.15, m)" elementName="T" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.BooleanInput" isOver="true">
      <component_list subscripts="[m]" declarationName="control" description="&quot;true => switch open, false => p--n connected&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.OpenerWithArc" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="openerWithArc" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Ron" elementName="Ron" isfinal="true"/>
        <modifications expression="Goff" elementName="Goff" isfinal="true"/>
        <modifications expression="V0" elementName="V0" isfinal="true"/>
        <modifications expression="dVdt" elementName="dVdt" isfinal="true"/>
        <modifications expression="Vmax" elementName="Vmax" isfinal="true"/>
        <modifications expression="useHeatPort" elementName="useHeatPort" isEach="true" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plug_p.pin" right="openerWithArc.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,0},{-10,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="openerWithArc.n" right="plug_n.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{100,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="control" right="openerWithArc.control">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,120},{0,40},{0,11}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="openerWithArc.heatPort" right="heatPort">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-10},{0,-100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;switch&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{-90,0},{-44,0}}, color={0,0,255}), Ellipse(extent={{-44,4},{-36,-4}}, lineColor={0,0,255}), Line(points={{-37,2},{40,42}}, color={0,0,255}), Line(points={{40,0},{90,0}}, color={0,0,255}), Line(points={{40,20},{40,0}}, color={0,0,255}), Line(points={{40,42},{32,32},{48,28},{40,20}}, color={255,0,0}), Text( extent={{-150,90},{150,50}}, textString=&quot;%name&quot;, textColor={0,0,255} ) , Text( extent={{-150,-80},{150,-40}}, textString=&quot;m=%m&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Contains m opening switches with arc (Modelica.Electrical.Analog.Ideal.OpenerWithArc).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
