<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Polyphase.Interfaces">
  <classes classType="connector" className="NegativePlug" description="&quot;Negative polyphase electrical plug with m pins&quot;" isLongClassSpecifier="true" classNameEnd="NegativePlug" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Plug" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Ellipse( extent={{-100,100},{100,-100}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Ellipse( extent={{-40,40},{40,-40}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Connectors PositivePlug and NegativePlug are nearly identical.&#xA;The only difference is that the icons are different in order&#xA;to identify more easily the plugs of a component.&#xA;Usually, connector PositivePlug is used for the positive and&#xA;connector NegativePlug for the negative plug of an electrical component.&lt;br>&#xA;Connector Plug is a composite connector containing m Pins (Modelica.Electrical.Analog.Interfaces.Pin).&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
