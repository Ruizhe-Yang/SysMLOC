<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Polyphase.Interfaces">
  <classes isPartial="true" classType="model" className="TwoPlug" description="&quot;Component with one polyphase electrical port&quot;" isLongClassSpecifier="true" classNameEnd="TwoPlug" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list subscripts="[m]" declarationName="v" description="&quot;Voltage drops of the two polyphase plugs&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[m]" declarationName="i" description="&quot;Currents flowing into positive polyphase plugs&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="PositivePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_p" description="&quot;Positive polyphase electrical plug with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="NegativePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_n" description="&quot;Negative polyphase electrical plug with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="plug_p.pin.v - plug_n.pin.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i" right="plug_p.pin.i"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Superclass of elements which have &lt;strong>two&lt;/strong> electrical plugs:&#xA;the positive plug connector &lt;em>plug_p&lt;/em>, and the negative plug connector &lt;em>plug_n&lt;/em>.&#xA;The currents flowing into plug_p are provided explicitly as currents i[m].&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
