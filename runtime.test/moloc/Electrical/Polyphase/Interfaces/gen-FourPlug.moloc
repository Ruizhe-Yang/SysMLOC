<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.Polyphase.Interfaces"/>
  <classes isPartial="true" classType="model" className="FourPlug" description="&quot;Component with two polyphase electrical ports&quot;" isLongClassSpecifier="true" classNameEnd="FourPlug" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min" isfinal="true"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list subscripts="[m]" declarationName="v1" description="&quot;Voltage drops of port 1&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list subscripts="[m]" declarationName="v2" description="&quot;Voltage drops of port 2&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[m]" declarationName="i1" description="&quot;Currents flowing into positive polyphase plug of port 1&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list subscripts="[m]" declarationName="i2" description="&quot;Currents flowing into positive polyphase plug of port 2&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PositivePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_p1" description="&quot;Positive electrical polyphase plug of port 1 with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,90},{-90,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PositivePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_p2" description="&quot;Positive electrical polyphase plug of port 2 with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,90},{110,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="NegativePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_n1" description="&quot;Negative electrical polyphase plug of port 1 with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-110},{-90,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="NegativePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_n2" description="&quot;Negative electrical polyphase plug of port 2 with m pins&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="v1" right="plug_p1.pin.v - plug_n1.pin.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v2" right="plug_p2.pin.v - plug_n2.pin.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i1" right="plug_p1.pin.i"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i2" right="plug_p2.pin.i"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Superclass of elements which have &lt;strong>four&lt;/strong> electrical plugs.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
