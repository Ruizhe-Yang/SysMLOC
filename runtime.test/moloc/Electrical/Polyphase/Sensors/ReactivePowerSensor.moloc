    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Math.Add3" isOver="true">
      <component_list isModificationOver="true" declarationName="add" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1/sqrt(3)" elementName="k1" isfinal="true"/>
        <modifications expression="1/sqrt(3)" elementName="k2" isfinal="true"/>
