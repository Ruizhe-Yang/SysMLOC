<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.Polyphase.Sensors">
  <classes classType="model" className="VoltageQuasiRMSSensor" description="&quot;Continuous quasi voltage RMS sensor for polyphase system&quot;" isLongClassSpecifier="true" classNameEnd="VoltageQuasiRMSSensor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.RoundSensor" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Polyphase.Interfaces.TwoPlug" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.RealOutput" isOver="true">
      <component_list isModificationOver="true" declarationName="V" description="&quot;Continuous quasi RMS of voltage&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;V&quot;" elementName="unit"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-2,-110}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,-110}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Polyphase.Sensors.VoltageSensor" isOver="true">
      <component_list isModificationOver="true" declarationName="voltageSensor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Polyphase.Blocks.QuasiRMS" isOver="true">
      <component_list isModificationOver="true" declarationName="quasiRMS" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,-50}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="plug_p" right="voltageSensor.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100, 0 } ,{-100,0},{-10,0} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.plug_n" right="plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{ 100,0} ,{100,0} }" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.v" right="quasiRMS.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-11},{0,-38}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="quasiRMS.y" right="V">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-61},{0,-86},{0,-110},{-2,-110}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;voltageRMSSensor&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Text( extent={{-160,-70},{160,-100}}, textString=&quot;m=%m&quot; ) ,Line(points={{0,-70},{0,-100}}), Line(points={{-90,0},{-70,0}}, color={0,0,255}),Line(points={{70, 0 } ,{90,0} } , color={0,0,255} ) , Text( extent={{-150,80},{150,120}}, textString=&quot;%name&quot;, textColor={0,0,255} ) , Text( extent={{-30,-10},{30,-70}}, textString=&quot;V&quot;, textColor={64,64,64} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;/html>&quot;" elementName="revisions"/>
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This sensor determines the continuous quasi &lt;a href=\&quot;Modelica://Modelica.Blocks.Math.RootMeanSquare\&quot;>RMS&lt;/a> value of a polyphase voltage system, representing an equivalent RMS voltage &lt;code>V&lt;/code> vector or phasor. If the voltage waveform deviates from a sine curve, the output of the sensor will not be exactly the average RMS value.&#xA;&lt;/p>&#xA;&lt;blockquote>&lt;pre>&#xA;V = sqrt(sum(v[k]^2 for k in 1:m)/m)&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
