<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.ACDC"/>
  <classes classType="model" className="DiodeCenterTapmPulse" description="&quot;m pulse diode rectifier with center tap&quot;" isLongClassSpecifier="true" classNameEnd="DiodeCenterTapmPulse" isOver="true">
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Icons.Converter" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="3" elementName="min" isfinal="true"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1e-05" declarationName="RonDiode" description="&quot;Closed diode resistance&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="1e-05" declarationName="GoffDiode" description="&quot;Opened diode conductance&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="0" declarationName="VkneeDiode" description="&quot;Diode forward threshold voltage&quot;">
        <modifications expression="0" elementName="min" isfinal="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PowerConverters.Interfaces.ACDC.ACplug" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PowerConverters.Interfaces.ACDC.DCpin" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.ConditionalHeatPort" isOver="true">
      <extendsModifications expression="293.15" elementName="T" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="diode" description="&quot;Diodes connected to positive DC potential&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <modifications expression="fill(RonDiode, m)" elementName="Ron" isfinal="true"/>
        <modifications expression="fill(GoffDiode, m)" elementName="Goff" isfinal="true"/>
        <modifications expression="fill(VkneeDiode, m)" elementName="Vknee" isfinal="true"/>
        <modifications expression="useHeatPort" elementName="useHeatPort" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-10,0}" elementName="origin"/>
            <modifications expression="{{10,10},{-10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="star" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{70,10},{90,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Thermal.HeatTransfer.Components.ThermalCollector" isOver="true">
      <component_list isModificationOver="true" declarationName="thermalCollector" isAnnotation="true" isAnnotationOver="true" condition_attribute="useHeatPort">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-100},{40,-80}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(mod(m, 2) == 1, &quot;DiodeCenterTapmPulse: only odd phase numbers are allowed&quot; )"/>
      <equations xsi:type="mOloc:IfEquation" condition="not useHeatPort">
        <ifEquations xsi:type="mOloc:SimpleEquation" left="LossPower" right="sum(diode.idealDiode.LossPower)"/>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode.plug_n" right="star.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,0},{70,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="star.pin_n" right="dc_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,0},{100,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="heatPort" right="thermalCollector.port_b">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-100},{30,-100}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="diode.heatPort" right="thermalCollector.port_a">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-10},{-10,-20},{30,-20},{30,-80}}" elementName="points"/>
          <modifications expression="{191,0,0}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ac" right="diode.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,0},{-20,0}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;rectifier&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Text( extent={{-100,70},{0,50}}, textColor={0,0,255}, textString=&quot;AC&quot; ) , Text( extent={{0,-50},{100,-70}}, textColor={0,0,255}, textString=&quot;DC&quot; ) , Rectangle( extent={{-40,24},{40,-24}}, lineColor={255,255,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Line( points={{-40,0},{40,0}}, color={0,0,255} ) , Line( points={{20,24},{20,-24}}, color={0,0,255} ) , Line( points={{20,0},{-20,24},{-20,-24},{20,0}}, color={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;General information about AC/DC converters can be found at the&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.UsersGuide.ACDCConcept\&quot;>AC/DC converter concept&lt;/a>.&#xA;&lt;/p>&#xA;&#xA;&lt;p>&#xA;This is a m pulse diode rectifier with center tap. All voltage sources must have one interconnected plug (tap). This rectifiers works only with odd number of phases due the symmetry constrains of even phase numbers implemented in&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.Polyphase.Functions.symmetricOrientation\&quot;>symmetricOrientation&lt;/a>.&#xA;The circuit topology is the same as in&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierCenterTapmPulse\&quot;>Examples.ACDC.RectifierCenterTapmPulse&lt;/a>.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
