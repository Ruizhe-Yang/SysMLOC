<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.Examples.ACDC.ExampleTemplates"/>
  <classes isPartial="true" classType="model" className="Thyristor1Pulse" description="&quot;Template of single pulse rectifier&quot;" isLongClassSpecifier="true" classNameEnd="Thyristor1Pulse" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Icons.ExampleTemplate" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.pi" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list expression="110" declarationName="Vrms" description="&quot;RMS supply voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="50" declarationName="f" description="&quot;Frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="voltagesensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{50,10}" elementName="origin"/>
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sources.SineVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="sinevoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="sqrt(2)* Vrms" elementName="V"/>
        <modifications expression="f" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-80,0}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="-90" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-80,-50}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="currentSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{0,-40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.Mean" isOver="true">
      <component_list isModificationOver="true" declarationName="meanVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{80,40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.RootMeanSquare" isOver="true">
      <component_list isModificationOver="true" declarationName="rootMeanSquareVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{80,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Math.Mean" isOver="true">
      <component_list isModificationOver="true" declarationName="meanCurrent" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{80,-60}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="PowerConverters.ACDC.Control.VoltageBridge2Pulse" isOver="true">
      <component_list isModificationOver="true" declarationName="pulse2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="false" elementName="useFilter"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{-40, 0 }" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealThyristor" isOver="true">
      <component_list isModificationOver="true" declarationName="idealthyristor" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="off">
          <modifications expression="true" elementName="fixed"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-10,40}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="meanCurrent.u" right="currentSensor.i">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{68,-60},{0,-60},{0,-51}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="sinevoltage.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-40},{-80,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltagesensor.v" right="meanVoltage.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{61,10},{64,10},{64,40},{68,40}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltagesensor.v" right="rootMeanSquareVoltage.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{61,10},{68,10}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="sinevoltage.p" right="idealthyristor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,10},{-80,40},{-20,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="currentSensor.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-40},{-10,-40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pulse2.fire_p" right="idealthyristor.fire">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-46,11},{-46,20},{0,20},{0,28}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltagesensor.n" right="currentSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{50,0},{50,-40},{10,-40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealthyristor.n" right="voltagesensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,40},{50,40},{50,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="sinevoltage.p" right="pulse2.ac_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,10},{-80,10},{-80,20},{-60,20},{-60,6},{-50,6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="sinevoltage.n" right="pulse2.ac_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-10},{-80,-10},{-80,-20},{-60,-20},{-60,-6},{-50,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Template of&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse\&quot;>&#xA;single pulse rectifiers&lt;/a>; load is not yet included.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
