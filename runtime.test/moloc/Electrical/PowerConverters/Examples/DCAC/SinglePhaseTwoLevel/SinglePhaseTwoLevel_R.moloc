<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.Examples.DCAC.SinglePhaseTwoLevel"/>
  <classes classType="model" className="SinglePhaseTwoLevel_R" description="&quot;Single-phase DC to AC converter with resistive load&quot;" isLongClassSpecifier="true" classNameEnd="SinglePhaseTwoLevel_R" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="ExampleTemplates.SinglePhaseTwoLevel" isOver="true">
      <extendsModifications isModificationOver="true" elementName="sine">
        <modifications expression="0.5" elementName="amplitude"/>
        <modifications expression="0.5" elementName="offset"/>
        <modifications expression="f1" elementName="f"/>
      </extendsModifications>
    </elements>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="R" description="&quot;Resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="50" declarationName="f1" description="&quot;AC frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="resistor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="R" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{40,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.p" right="inverter.ac">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,20},{40,30},{-30,30}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.n" right="currentSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,0},{40,-70},{10,-70}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0" elementName="StartTime"/>
        <modifications expression="0.1" elementName="StopTime"/>
        <modifications expression="1e-06" elementName="Tolerance"/>
        <modifications expression="0.0002" elementName="Interval"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>Plot current &lt;code>currentSensor.i&lt;/code>, average current &lt;code>meanCurrent.y&lt;/code>, voltage &lt;code>voltageSensor.v&lt;/code> and average voltage &lt;code>meanVoltage.v&lt;/code>. The instantaneous voltage and current directly show the switch pattern of the inverter. The average voltage and average current reveal the fundamental wave of the voltage and current, each of them being basically in phase with the command &lt;code>sine.y&lt;/code>.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
