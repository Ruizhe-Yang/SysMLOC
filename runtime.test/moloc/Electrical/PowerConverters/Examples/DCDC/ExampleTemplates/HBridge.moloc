<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.PowerConverters.Examples.DCDC.ExampleTemplates">
  <classes isPartial="true" classType="model" className="HBridge" description="&quot;H bridge DC/DC converter&quot;" isLongClassSpecifier="true" classNameEnd="HBridge" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Icons.ExampleTemplate" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list expression="1000" declarationName="f" description="&quot;Switching frequency&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="PowerConverters.DCDC.HBridge" isOver="true">
      <component_list isModificationOver="true" declarationName="hbridge" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="false" elementName="useHeatPort"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-10},{-40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sources.ConstantVoltage" isOver="true">
      <component_list isModificationOver="true" declarationName="constantVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="100" elementName="V"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-80,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="PowerConverters.DCDC.Control.SignalPWM" isOver="true">
      <component_list isModificationOver="true" declarationName="signalPWM" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0.6" elementName="constantDutyCycle"/>
        <modifications expression="f" elementName="f"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-60,-70},{-40,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-90,-40},{-70,-20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="currentSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{0,-16},{-20,4}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="voltageSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{60,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Math.Mean" isOver="true">
      <component_list isModificationOver="true" declarationName="meanCurrent" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="0" elementName="x0"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-10,-40}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Math.Mean" isOver="true">
      <component_list isModificationOver="true" declarationName="meanVoltage" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="f" elementName="f"/>
        <modifications expression="0" elementName="x0"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="{90,10}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="hbridge.fire_p" right="signalPWM.fire">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-56,-12},{-56,-49}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.p" right="constantVoltage.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-20},{-80,-10}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantVoltage.p" right="hbridge.dc_p1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,10},{-68,10},{-68,6},{-60,6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="constantVoltage.n" right="hbridge.dc_n1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,-10},{-68,-10},{-68,-6},{-60,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.n" right="currentSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{60,0},{60,-6},{0,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.v" right="meanVoltage.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{71,10},{78,10}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.i" right="meanCurrent.u">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,-17},{-10,-28}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="hbridge.dc_p2" right="voltageSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,6},{-30,6},{-30,70},{60,70},{60,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.n" right="hbridge.dc_n2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,-6},{-40,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="signalPWM.notFire" right="hbridge.fire_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-44,-49},{-44,-12}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>H bridge example template including supply and sensors; load is not yet included&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
