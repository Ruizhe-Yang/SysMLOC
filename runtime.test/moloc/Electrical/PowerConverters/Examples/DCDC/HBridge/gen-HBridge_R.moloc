<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.Examples.DCDC.HBridge"/>
  <classes classType="model" className="HBridge_R" description="&quot;H bridge DC/DC converter with resistive load&quot;" isLongClassSpecifier="true" classNameEnd="HBridge_R" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="ExampleTemplates.HBridge" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
      <component_list expression="100" declarationName="R" description="&quot;Resistance&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="resistor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="R" elementName="R"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{20,50}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.p" right="hbridge.dc_p2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,60},{20,70},{-30,70},{-30,6},{-40,6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.n" right="currentSensor.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,40},{20,-6},{0,-6}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="0.1" elementName="StopTime"/>
        <modifications expression="0.0002" elementName="Interval"/>
        <modifications expression="1e-06" elementName="Tolerance"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This example demonstrates the switching on of a resistive load operated by an H bridge.DC output voltage is equal to &lt;code>2 * (dutyCycle - 0.5)&lt;/code> times the input voltage.Plot current &lt;code>currentSensor.i&lt;/code>, averaged current &lt;code>meanCurrent.y&lt;/code>, total voltage &lt;code>voltageSensor.v&lt;/code> and voltage &lt;code>meanVoltage.v&lt;/code>.&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
