<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.PowerConverters.Interfaces.ACDC">
  <classes isPartial="true" classType="model" className="DCpin" description="&quot;Single DC pin&quot;" isLongClassSpecifier="true" classNameEnd="DCpin" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="dc_p" description="&quot;Positive DC output&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="dc_p.v" declarationName="vDC" description="&quot;DC potential&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="dc_p.i" declarationName="iDC" description="&quot;DC current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="vDC*iDC" declarationName="powerDC" description="&quot;DC power&quot;"/>
    </elements>
  </classes>
</mOloc:Stored_definition>
