<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.PowerConverters.Interfaces.DCDC">
  <classes isPartial="true" classType="model" className="DCtwoPin1" description="&quot;Positive and negative pins of side 1&quot;" isLongClassSpecifier="true" classNameEnd="DCtwoPin1" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="dc_p1" description="&quot;Positive DC input&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,50},{-90,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="dc_n1" description="&quot;Negative DC input&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-70},{-90,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="dc_p1.v - dc_n1.v" declarationName="vDC1" description="&quot;DC voltage side 1&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="dc_p1.i" declarationName="iDC1" description="&quot;DC current side 1&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="vDC1*iDC1" declarationName="powerDC1" description="&quot;DC power side 1&quot;"/>
    </elements>
  </classes>
</mOloc:Stored_definition>
