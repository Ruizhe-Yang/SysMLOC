<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.PowerConverters.Interfaces.DCDC">
  <classes isPartial="true" classType="model" className="DCtwoPin2" description="&quot;Positive and negative pins of side 2&quot;" isLongClassSpecifier="true" classNameEnd="DCtwoPin2" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="dc_p2" description="&quot;Positive DC output&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,50},{110,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="dc_n2" description="&quot;Negative DC output&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-70},{110,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="dc_p2.v - dc_n2.v" declarationName="vDC2" description="&quot;DC voltages side 2&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="dc_p2.i" declarationName="iDC2" description="&quot;DC current side 2&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="vDC2*iDC2" declarationName="powerDC2" description="&quot;DC power side 2&quot;"/>
    </elements>
  </classes>
</mOloc:Stored_definition>
