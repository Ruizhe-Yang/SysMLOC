      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="enableLogic.internalEnable[1]" right="andCondition_p.u2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{79,-80},{76,-80},{76,-96},{40,-96},{40,-76},{-40,-76},{-40,-100}, {-52,-100},{-52,-92} }" elementName="points"/>
