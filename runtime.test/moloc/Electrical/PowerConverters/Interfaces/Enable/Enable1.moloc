<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.Interfaces.Enable"/>
  <classes isPartial="true" classType="model" className="Enable1" description="&quot;Partial model providing enable parameter and optional enable input for one firing signal&quot;" isLongClassSpecifier="true" classNameEnd="Enable1" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PowerConverters.Interfaces.Enable.Enable" isOver="true">
      <extendsModifications expression="1" elementName="m" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Logical.And" isOver="true">
      <component_list declarationName="andCondition_p" description="&quot;And condition for positive firing signal&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,10},{-10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-60,-80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.BooleanInput" isOver="true">
      <component_list declarationName="fire_p" description="&quot;Firing signal of positive potential transistor&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-60,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="andCondition_p.u1" right="fire_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,-92},{-60,-120}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="enableLogic.enable" right="enable">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{100,-92},{100,-120}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
