<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.Interfaces.Enable"/>
  <classes isPartial="true" classType="model" className="Enable2" description="&quot;Partial model providing enable parameter and optional enable input for two firing signals&quot;" isLongClassSpecifier="true" classNameEnd="Enable2" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="PowerConverters.Interfaces.Enable.Enable1" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Logical.And" isOver="true">
      <component_list declarationName="andCondition_n" description="&quot;And condition for negative firing signal&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{-10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{60,-80}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.BooleanInput" isOver="true">
      <component_list declarationName="fire_n" description="&quot;Firing signal of negative potential transistor&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{60,-120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="fire_n" right="andCondition_n.u1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{60,-120},{60,-92}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="enableLogic.internalEnable[1]" right="andCondition_n.u2">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{79,-80},{76,-80},{76,-96},{52,-96},{52,-92}}" elementName="points"/>
          <modifications expression="{255,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This partial model provides the enabling logic for two firing signal.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
