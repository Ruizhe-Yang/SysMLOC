<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.PowerConverters.UsersGuide">
  <classes classType="class" className="DCACConcept" description="&quot;DC/AC converter concept&quot;" isLongClassSpecifier="true" classNameEnd="DCACConcept" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Information" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="true" elementName="DocumentationClass"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&#xA;&lt;p>There are a single-phase and polyphase DC/AC converter model provided by the PowerConverters library.&lt;/p>&#xA;&#xA;&lt;h4>Control&lt;/h4>&#xA;&#xA;&lt;p>Currently there are&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.DCAC.Control.SVPWM\&quot;>space vector PWM&lt;/a> and&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.DCAC.Control.IntersectivePWM\&quot;>intersective PWM&lt;/a> models provided.&#xA;However, for operating the single-phase inverter the PWM&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.DCDC.Control.SignalPWM\&quot;>controller&lt;/a>&#xA;can be used.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>Examples&lt;/h4>&#xA;&#xA;&lt;p>Some examples are provided at&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.Examples.DCAC\&quot;>Examples.DCAC&lt;/a>.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
