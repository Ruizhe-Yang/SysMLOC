<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.PowerConverters.UsersGuide"/>
  <classes classType="class" className="DCDCConcept" description="&quot;DC/DC converter concept&quot;" isLongClassSpecifier="true" classNameEnd="DCDCConcept" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Information" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="true" elementName="DocumentationClass"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The following DC/DC converter topologies are currently included in the PowerConverters library.&lt;/p>&lt;ul>&lt;li>Chopper step down and step up converter&lt;/li>&lt;li>H bridge converter;&#xA;four quadrant operation&lt;/li>&lt;/ul>&lt;h4>Control&lt;/h4>&lt;p>A pulse width modulation (PWM)&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.DCDC.Control\&quot;>controller&lt;/a>&#xA;is provided.&lt;/p>&lt;h4>Examples&lt;/h4>&lt;p>Some examples are provided at&lt;a href=\&quot;modelica://Modelica.Electrical.PowerConverters.Examples.DCDC\&quot;>Examples.DCDC&lt;/a>.&#xA;&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
