  <within withName="Modelica.Electrical"/>
  <classes classType="package" className="PowerConverters" description="&quot;Rectifiers, Inverters, DC/DC and AC/AC converters&quot;" isLongClassSpecifier="true" classNameEnd="PowerConverters" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;info&quot;" elementName="preferredView"/>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This library provides power converters for DC and AC single-phase and polyphase electrical systems. The PowerConverters library contains four types of converters.&lt;/p>&lt;ul> &lt;li>AC/DC converters (rectifiers)&lt;/li> &lt;li>DC/AC converters (inverters)&lt;/li> &lt;li>DC/DC converters&lt;/li> &lt;li>AC/AC converters&lt;/li>&lt;/ul>&lt;p>Copyright &amp;copy;&#xA;2013-2020, Modelica Association and contributors&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line( points={{-78,0},{80,0}}, color={95,95,95} ) , Line( points={{36,50},{36,-52}}, color={95,95,95} ) , Polygon(points={{36,0},{-34,50},{-34,-50},{36,0}}, lineColor={95,95,95}) }" elementName="graphics"/>
      </annotations>
    </elements>
  </classes>
