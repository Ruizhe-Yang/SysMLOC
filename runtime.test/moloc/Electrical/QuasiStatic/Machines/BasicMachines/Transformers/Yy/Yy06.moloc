  <classes classType="model" className="Yy06" description="&quot;Transformer Yy6&quot;" isLongClassSpecifier="true" classNameEnd="Yy06" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="QuasiStatic.Machines.Interfaces.PartialBasicTransformer" isOver="true">
