          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorL.currentN" right="load.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{80,20},{80,20},{90,20},{90,10}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorL.voltageN" right="starL.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{70,10},{70,-20},{90,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorS.voltageN" right="starS.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-70,10},{-70,-20},{-90,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
