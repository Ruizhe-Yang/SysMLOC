        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{60,10},{80,30}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="QuasiStatic.Polyphase.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="load" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="RL" elementName="R_ref"/>
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{90,0}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="QuasiStatic.Polyphase.Basic.Star" isOver="true">
      <component_list isModificationOver="true" declarationName="starL" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{90,-30}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="QuasiStatic.SinglePhase.Basic.Ground" isOver="true">
      <component_list declarationName="groundL" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{80,-70},{100,-50}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Machines.Utilities.TransformerData" isOver="true">
      <component_list isModificationOver="true" declarationName="transformerData" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Modelica.Utilities.Strings.substring( transformer.VectorGroup, 1, 1 )" elementName="C1"/>
        <modifications expression="Modelica.Utilities.Strings.substring( transformer.VectorGroup, 2, 2 )" elementName="C2"/>
        <modifications expression="50" elementName="f"/>
        <modifications expression="100" elementName="V1"/>
        <modifications expression="100" elementName="V2"/>
        <modifications expression="30E3" elementName="SNominal"/>
        <modifications expression="0.05" elementName="v_sc"/>
        <modifications expression="300" elementName="P_sc"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,50},{10,70}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="QuasiStatic.Machines.BasicMachines.Transformers.Yd.Yd01" isOver="true">
      <component_list isModificationOver="true" declarationName="transformer" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="transformerData.n" elementName="n"/>
        <modifications expression="transformerData.R1" elementName="R1"/>
        <modifications expression="transformerData.L1sigma" elementName="L1sigma"/>
        <modifications expression="transformerData.R2" elementName="R2"/>
        <modifications expression="transformerData.L2sigma" elementName="L2sigma"/>
        <modifications expression="293.15" elementName="T1Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_1">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T2Ref"/>
        <modifications isModificationOver="true" expression="Modelica.Electrical.Machines.Thermal.Constants.alpha20Zero" elementName="alpha20_2">
          <modifications expression="&quot;1/K&quot;" elementName="displayUnit"/>
        </modifications>
        <modifications expression="293.15" elementName="T1Operational"/>
        <modifications expression="293.15" elementName="T2Operational"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-20,0},{20,40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Polyphase.Blocks.SymmetricalComponents" isOver="true">
      <component_list isModificationOver="true" declarationName="symmetricalComponentsIS" isAnnotation="true" isAnnotationOver="true">
