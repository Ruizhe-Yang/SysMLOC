    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starS.pin_n" right="groundS.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-40},{-90,-50}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="source.plug_n" right="starS.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-90,-10},{-90,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="starL.pin_n" right="groundL.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,-40},{90,-50}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="load.plug_n" right="starL.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{90,-10},{90,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorS.currentP" right="electricalPowerSensorS.voltageP">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-80,20},{-80,30},{-70,30}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorS.currentN" right="currentSensorS.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,20},{-60,20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensorS.plug_n" right="transformer.plug1">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,20},{-20,20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transformer.plug2" right="currentSensorL.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,20},{40,20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensorL.plug_n" right="electricalPowerSensorL.currentP">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{60,20},{60,20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="electricalPowerSensorL.currentP" right="electricalPowerSensorL.voltageP">
        <annotations isModificationOver="true" elementName="Line">
