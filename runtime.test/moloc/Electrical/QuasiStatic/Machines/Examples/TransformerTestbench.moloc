      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="earth.pin_n" right="groundT.pin">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,-40},{0,-50}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="deltaS.plug_p" right="voltageSensorS.plug_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-60,0},{-60,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="deltaS.plug_n" right="voltageSensorS.plug_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,0},{-40,-20}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
