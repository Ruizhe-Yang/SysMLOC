<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.Machines.SpacePhasors.Blocks"/>
  <classes classType="block" className="FromSpacePhasor" description="&quot;Conversion: space phasor -> three-phase&quot;" isLongClassSpecifier="true" classNameEnd="FromSpacePhasor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Blocks.Icons.Block" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.j" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.exp" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list subscripts="[2]" declarationName="u" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-140,-20},{-100,20}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexOutput" isOver="true">
      <component_list subscripts="[m]" declarationName="y" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{100,-10},{120,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" parameterType="parameter" isProtected="true" isOver="true">
      <component_list subscripts="[m]" expression="Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m)" declarationName="phi"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="{Complex(u[1], u[2])*exp(-j*phi[k])/sqrt(2) for k in 1:m}"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="true" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line(points={{0,0},{-80,80},{-60,72},{-72,60},{-80,80}}, color={ 85,170,255} ) , Line(points={{0,0},{-80,-80},{-72,-60},{-60,-72},{-80,-80}}, color={85,170,255} ) , Line( points={{0,0},{6.67,10},{13.33,17.32},{20,20},{26.67,17.32},{ 33.33,10} ,{40,0},{46.67,-10},{53.33,-17.32},{60,-20},{66.67, -17.32 } ,{73.33,-10},{80,0} } , color={85,170,255}, smooth=Smooth.Bezier ) , Line( points={{-10,0},{-3.33,10},{3.33,17.32},{10,20},{16.67,17.32},{ 23.33,10} ,{30,0},{36.67,-10},{43.33,-17.32},{50,-20},{56.67, -17.32 } ,{63.33,-10},{70,0} } , color={85,170,255}, smooth=Smooth.Bezier ) , Line( points={{10,0},{16.67,10},{23.33,17.32},{30,20},{36.67,17.32},{ 43.33,10} ,{50,0},{56.67,-10},{63.33,-17.32},{70,-20},{76.67, -17.32 } ,{83.33,-10},{90,0} } , color={85,170,255}, smooth=Smooth.Bezier ) , Text( extent={{-62,-74},{14,-86}}, textString=&quot;zero&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;Transformation of space phasor and zero sequence value to quasi-static polyphase values (voltages or currents).&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
