<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.QuasiStatic.Polyphase.Basic">
  <classes classType="model" className="PlugToPins_n" description="&quot;Connect all (negative) pins&quot;" isLongClassSpecifier="true" classNameEnd="PlugToPins_n" isOver="true">
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="min" isfinal="true"/>
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.NegativePlug" isOver="true">
      <component_list isModificationOver="true" declarationName="plug_n" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-30,-10},{-10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="QuasiStatic.SinglePhase.Interfaces.NegativePin" isOver="true">
      <component_list subscripts="[m]" declarationName="pin_n" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,-10},{30,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="PlugToPin_n" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="plugToPin_n" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="m" elementName="m" isEach="true" isfinal="true"/>
        <modifications expression="{j for j in 1:m}" elementName="k" isfinal="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ForEquation" forIndices="j in 1:m">
        <forEquations xsi:type="mOloc:ConnectEquation" left="plug_n" right="plugToPin_n[j].plug_n"/>
        <forEquations xsi:type="mOloc:ConnectEquation" left="plugToPin_n[j].pin_n" right="pin_n[j]"/>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;plugToPins&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Rectangle( extent={{-20,20},{40,-20}}, fillColor={170,255,255}, fillPattern=FillPattern.Solid ) , Ellipse( extent={{-40,20},{0,-20}}, fillColor={170,255,255}, fillPattern=FillPattern.Solid ) , Text( extent={{-150,50},{150,90}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Connects all &lt;code>m&lt;/code> single-phase (negative) pins of the polyphase (negative) plug to an array of &lt;code>m&lt;/code> single-phase (negative) pins.&#xA;&lt;/p>&#xA;&lt;h4>See also&lt;/h4>&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Basic.PlugToPin_p\&quot;>PlugToPin_p&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Basic.PlugToPin_n\&quot;>PlugToPin_n&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Basic.PlugToPins_p\&quot;>PlugToPins_p&lt;/a>&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
