<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Basic"/>
  <classes classType="model" className="VariableCapacitor" description="&quot;Polyphase variable capacitor&quot;" isLongClassSpecifier="true" classNameEnd="VariableCapacitor" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.TwoPlug" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Interfaces.RealInput" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" declarationName="C" description="&quot;Variable capacitance&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="&quot;F&quot;" elementName="unit" isEach="true"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{0,120}" elementName="origin"/>
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-20,-20},{20,20}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{0,120}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="QuasiStatic.SinglePhase.Basic.VariableCapacitor" isOver="true">
      <component_list subscripts="[m]" declarationName="variableCapacitor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableCapacitor.pin_p" right="plugToPins_p.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-10,0},{-24.5,0},{-24.5,0},{-39,0},{-39,0},{-68,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="variableCapacitor.pin_n" right="plugToPins_n.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{10,0},{39,0},{39,0},{68,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="C" right="variableCapacitor.C">
        <annotations isModificationOver="true" elementName="Line">
