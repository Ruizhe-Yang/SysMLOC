<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Blocks"/>
  <classes classType="block" className="FromSymmetricalComponents" description="&quot;Creates quasi-static phasors from symmetrical components&quot;" isLongClassSpecifier="true" classNameEnd="FromSymmetricalComponents" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexMIMOs" isOver="true">
      <extendsModifications expression="m" elementName="n" isfinal="true"/>
      <extendsModifications expression="fill(false,m)" elementName="useConjugateInput" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.abs" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.arg" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="abs(u)" declarationName="abs_u" description="&quot;Absolute of input&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="output" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" expression="arg(u)" declarationName="arg_u" description="&quot;Argument of input&quot;">
        <modifications expression="&quot;deg&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="abs(y)" declarationName="abs_y" description="&quot;Absolute of output&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="output" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" expression="arg(y)" declarationName="arg_y" description="&quot;Argument of output&quot;">
        <modifications expression="&quot;deg&quot;" elementName="displayUnit"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Complex" parameterType="parameter" isProtected="true" isfinal="true" isOver="true">
      <component_list subscripts="[m,m]" expression="Modelica.Electrical.Polyphase.Functions.symmetricBackTransformationMatrix(m)" declarationName="sbTM"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ForEquation" forIndices="j in 1:m">
        <forEquations xsi:type="mOloc:SimpleEquation" left="y[j]" right="Complex(sum({sbTM[j,k].re*u[k].re - sbTM[j,k].im*u[k].im for k in 1:m}), sum({sbTM[j,k].re*u[k].im + sbTM[j,k].im*u[k].re for k in 1:m}) )"/>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;symComp&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={-54,-40}, rotation=-90 ) , Line( points={{-44,-22},{-44,-22},{-8,-42},{-22,-38},{-18,-32},{-8,-42}}, color={85,170,255} ) , Line( points={{-44,-22},{-44,18},{-40,4},{-48,4},{-44,18}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={-54,30}, rotation=-90 ) , Line( points={{-44,48},{-44,88},{-40,74},{-48,74},{-44,88}}, color={85,170,255} ) , Line( points={{-44,48},{-44,48},{-8,28},{-22,32},{-18,38},{-8,28}}, color={85,170,255} ) , Line( points={{-54,-88},{-54,-48},{-50,-62},{-58,-62},{-54,-48}}, color={85,170,255} ) , Line( points={{-44,-88},{-44,-48},{-40,-62},{-48,-62},{-44,-48}}, color={85,170,255} ) , Line( points={{-34,-88},{-34,-48},{-30,-62},{-38,-62},{-34,-48}}, color={85,170,255} ) , Line( points={{42,-10},{42,30},{46,16},{38,16},{42,30}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={32,-28}, rotation=-90 ) , Line( points={{42,-10},{42,-10},{78,-30},{64,-26},{68,-20},{78,-30}}, color={85,170,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;Calculates the time phasors from the symmetric components according to Charles L. Fortescue.&#xA;&lt;/p>&#xA;&lt;h4>See also&lt;/h4>&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.Polyphase.UsersGuide.PhaseOrientation\&quot;>User's guide&lt;/a> on symmetrical components and orientation.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
