<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Blocks"/>
  <classes classType="block" className="SingleToPolyphase" description="&quot;Extends complex phase signal to complex polyphase signals using symmetricOrientation&quot;" isLongClassSpecifier="true" classNameEnd="SingleToPolyphase" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexSIMO" isOver="true">
      <extendsModifications expression="m" elementName="nout" isfinal="true"/>
      <extendsModifications expression="false" elementName="useConjugateInput" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="y" right="u*Modelica.ComplexMath.fromPolar(fill(1, m), - Modelica.Electrical.Polyphase.Functions.symmetricOrientation(m) )"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;adaptor&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Diagram">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{ -100,-100} ,{100,100} }" elementName="extent"/>
        </modifications>
        <modifications expression="{Line( points={{-60,-20},{-60,20},{-56,8},{-64,8},{-60,20}}, color={0,0,255} ) ,Line( points={{40,-20},{40,20},{44,8},{36,8},{40,20}}, color={0,0,255} ) ,Line( points={{40,-20},{40,-20},{76,-40},{64,-38},{68,-30},{76,-40}}, color={0,0,255} ) ,Line( points={{-18,10},{-18,10},{2,-24},{-8,-16},{-2,-10},{2,-24}}, color={0,0,255}, origin={30,-38}, rotation=-90 ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line( points={{-60,-20},{-60,20},{-56,8},{-64,8},{-60,20}}, color={85,170,255} ) , Line( points={{40,-20},{40,20},{44,6},{36,6},{40,20}}, color={85,170,255} ) , Line( points={{40,-20},{40,-20},{76,-40},{62,-36},{66,-30},{76,-40}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={30,-38}, rotation=-90 ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This function propagates the input phasor to m output phasors with &lt;a href=\&quot;modelica://Modelica.Electrical.Polyphase.UsersGuide.PhaseOrientation\&quot;>symmetricOrientation&lt;/a>.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
