<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Blocks"/>
  <classes classType="block" className="SymmetricalComponents" description="&quot;Creates symmetrical components from signals representing quasi-static phasors&quot;" isLongClassSpecifier="true" classNameEnd="SymmetricalComponents" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexMIMOs" isOver="true">
      <extendsModifications expression="m" elementName="n" isfinal="true"/>
      <extendsModifications expression="fill(false,m)" elementName="useConjugateInput" isfinal="true"/>
    </elements>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.abs" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.arg" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
        <annotations expression="true" elementName="Evaluate"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="abs(u)" declarationName="abs_u" description="&quot;Absolute of input&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="output" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" expression="arg(u)" declarationName="arg_u" description="&quot;Argument of input&quot;">
        <modifications expression="&quot;deg&quot;" elementName="displayUnit" isEach="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list subscripts="[m]" expression="abs(y)" declarationName="abs_y" description="&quot;Absolute of output&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="output" isOver="true">
      <component_list subscripts="[m]" isModificationOver="true" expression="arg(y)" declarationName="arg_y" description="&quot;Argument of output&quot;">
        <modifications expression="&quot;deg&quot;" elementName="displayUnit" isEach="true"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Complex" parameterType="parameter" isProtected="true" isfinal="true" isOver="true">
      <component_list subscripts="[m,m]" expression="Modelica.Electrical.Polyphase.Functions.symmetricTransformationMatrix( m)" declarationName="sTM"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ForEquation" forIndices="j in 1:m">
        <forEquations xsi:type="mOloc:SimpleEquation" left="y[j]" right="Complex(sum({sTM[j,k].re*u[k].re - sTM[j,k].im*u[k].im for k in 1:m}), sum({sTM[j,k].re*u[k].im + sTM[j,k].im*u[k].re for k in 1:m}) )"/>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;symComp&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="false" elementName="preserveAspectRatio"/>
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
        </modifications>
        <modifications expression="{ Line( points={{-44,0},{-44,0},{-8,-20},{-22,-16},{-18,-10},{-8,-20}}, color={85,170,255} ) , Line( points={{-44,0},{-44,40},{-40,26},{-48,26},{-44,40}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={-54,-18}, rotation=-90 ) , Line( points={{42,48},{42,48},{78,28},{64,32},{68,38},{78,28}}, color={85,170,255} ) , Line( points={{42,48},{42,88},{46,74},{38,74},{42,88}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={32,30}, rotation=-90 ) , Line( points={{42,-22},{42,-22},{78,-42},{64,-38},{68,-32},{78,-42}}, color={85,170,255} ) , Line( points={{42,-22},{42,18},{46,4},{38,4},{42,18}}, color={85,170,255} ) , Line( points={{-18,10},{-18,10},{2,-24},{-8,-14},{-2,-10},{2,-24}}, color={85,170,255}, origin={32,-40}, rotation=-90 ) , Line( points={{42,-88},{42,-48},{46,-62},{38,-62},{42,-48}}, color={85,170,255} ) , Line( points={{52,-88},{52,-48},{56,-62},{48,-62},{52,-48}}, color={85,170,255} ) , Line( points={{32,-88},{32,-48},{36,-62},{28,-62},{32,-48}}, color={85,170,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>Calculates the symmetric components according to Charles L. Fortescue from the time phasors.&lt;/p>&lt;h4>See also&lt;/h4>&lt;p>&lt;a href=\&quot;modelica://Modelica.Electrical.Polyphase.UsersGuide.PhaseOrientation\&quot;>User's guide&lt;/a> on symmetrical components and orientation.&#xA;&lt;/p>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
