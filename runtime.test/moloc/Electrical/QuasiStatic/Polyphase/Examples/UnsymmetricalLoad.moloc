  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Examples"/>
  <classes classType="model" className="UnsymmetricalLoad" description="&quot;Unsymmetrical three-phase load&quot;" isLongClassSpecifier="true" classNameEnd="UnsymmetricalLoad" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.abs" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
