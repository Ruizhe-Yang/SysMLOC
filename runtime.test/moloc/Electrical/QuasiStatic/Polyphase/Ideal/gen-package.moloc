  <within withName="Modelica.Electrical.QuasiStatic.Polyphase"/>
  <classes classType="package" className="Ideal" description="&quot;Ideal components for AC polyphase models&quot;" isLongClassSpecifier="true" classNameEnd="Ideal" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
          <modifications expression="true" elementName="preserveAspectRatio"/>
        </modifications>
        <modifications expression="{ Line(origin={10,34}, points={{-100,-60},{-54,-60}}), Ellipse(origin={10,34}, extent={{-54,-64},{-46,-56}}), Line(origin={10,34}, points={{-47,-58},{30,-10}}), Line(origin={10,34}, points={{30,-40},{30,-60}}), Line(origin={10,34}, points={{30,-60},{80,-60}}) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This package hosts ideal models for quasi-static polyphase circuits.Quasi-static theory can be found in the&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.References\&quot;>references&lt;/a>.&#xA;&lt;/p>&lt;h4>See also&lt;/h4>&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Ideal\&quot;>SinglePhase.Ideal&lt;/a>&#xA;&lt;/html>&quot;" elementName="info"/>
