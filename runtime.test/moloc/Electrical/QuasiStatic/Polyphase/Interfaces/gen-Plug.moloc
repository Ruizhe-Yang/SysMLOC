  <within withName="Modelica.Electrical.QuasiStatic.Polyphase.Interfaces"/>
  <classes classType="connector" className="Plug" description="&quot;Quasi-static polyphase plug&quot;" isLongClassSpecifier="true" classNameEnd="Plug" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
      <component_list expression="3" declarationName="m" description="&quot;Number of phases&quot;" isAnnotation="true" isAnnotationOver="true">
