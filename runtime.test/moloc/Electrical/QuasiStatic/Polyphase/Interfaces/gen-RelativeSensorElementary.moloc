      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>The relative sensor partial model relies on the&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Interfaces.TwoPlug\&quot;>TwoPlug&lt;/a> to measure the complex voltages, currents or power. Additionally this model contains a proper icon and a definition of the angular velocity.&#xA;&lt;/p>&lt;h4>See also&lt;/h4>&lt;p>&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Interfaces.AbsoluteSensor\&quot;>AbsoluteSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.AbsoluteSensor\&quot;>SinglePhase.Interfaces.AbsoluteSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.RelativeSensorElementary\&quot;>SinglePhase.Interfaces.RelativeSensorElementary&lt;/a>&#xA;&lt;/p>&lt;/html>&quot;" elementName="info"/>
