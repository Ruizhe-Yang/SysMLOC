<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase"/>
  <classes classType="package" className="Basic" description="&quot;Basic components for AC single-phase models&quot;" isLongClassSpecifier="true" classNameEnd="Basic" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(origin={10,40}, points={{-100,-40},{-80,-40}}), Line(origin={10,40}, points={{60,-40},{80,-40}}), Rectangle( lineColor={85,170,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid, extent={{-70,-30},{70,30}} ) }" elementName="graphics"/>
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="{{-100,-100}, {100,100} }" elementName="extent"/>
          <modifications expression="true" elementName="preserveAspectRatio"/>
        </modifications>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package hosts basic models for quasi-static single-phase circuits.&#xA;Quasi-static theory for single-phase circuits can be found in the&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.References\&quot;>references&lt;/a>.&#xA;&lt;/p>&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Basic\&quot;>Polyphase.Basic&lt;/a>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
