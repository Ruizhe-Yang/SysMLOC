<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Examples"/>
  <classes classType="model" className="SeriesBode" description="&quot;Series circuit with Bode analysis&quot;" isLongClassSpecifier="true" classNameEnd="SeriesBode" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Real" directionType="output" isOver="true">
      <component_list expression="bode.abs_y" declarationName="abs_y" description="&quot;Magnitude of voltage ratio&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.AmplitudeLevelDifference" directionType="output" isOver="true">
      <component_list expression="bode.dB_y" declarationName="dB_y" description="&quot;Log10 of magnitude of voltage ratio in dB&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" directionType="output" isOver="true">
      <component_list expression="bode.arg_y" declarationName="arg_y" description="&quot;Angle of voltage ratio&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Blocks.Sources.LogFrequencySweep" isOver="true">
      <component_list isModificationOver="true" declarationName="frequencySweep" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="duration"/>
        <modifications expression="0.01" elementName="wMin"/>
        <modifications expression="100" elementName="wMax"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-70,-40}" elementName="origin"/>
            <modifications expression="{{-10, -10 } ,{10,10} }" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="QuasiStatic.SinglePhase.Sources.VariableVoltageSource" isOver="true">
      <component_list isModificationOver="true" declarationName="voltageSource" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="gamma">
          <modifications expression="true" elementName="fixed"/>
          <modifications expression="0" elementName="start"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-30,-20}" elementName="origin"/>
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="QuasiStatic.SinglePhase.Basic.Ground" isOver="true">
      <component_list declarationName="ground" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-40,-60},{-20,-40}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="QuasiStatic.SinglePhase.Basic.Resistor" isOver="true">
      <component_list isModificationOver="true" declarationName="resistor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1" elementName="R_ref"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{20,-10},{40,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="QuasiStatic.SinglePhase.Basic.Inductor" isOver="true">
      <component_list isModificationOver="true" declarationName="inductor" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="1/(2*Modelica.Constants.pi)" elementName="L"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{50,-10},{70,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.Sources.ComplexConstant" isOver="true">
      <component_list isModificationOver="true" declarationName="complexConst" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="Complex(1, 0)" elementName="k"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-80,-10},{-60,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sensors.CurrentSensor" isOver="true">
      <component_list declarationName="currentSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{10,10},{-10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-10,0}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Sensors.VoltageSensor" isOver="true">
      <component_list declarationName="voltageSensor" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="{30,20}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.ComplexMath.Bode" isOver="true">
      <component_list declarationName="bode" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,10},{10,-10}}" elementName="extent"/>
            <modifications expression="180" elementName="rotation"/>
            <modifications expression="{-70,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="frequencySweep.y" right="voltageSource.f">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-59,-40},{-50,-40},{-50,-26},{-42,-26}}" elementName="points"/>
          <modifications expression="{0,0,127}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.pin" right="voltageSource.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-40}, {-30,-35},{-30,-30} }" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="resistor.pin_n" right="inductor.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,0},{50,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="complexConst.y" right="voltageSource.V">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-59,0},{-50,0},{-50,-14},{-42,-14}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.pin_p" right="resistor.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{20,20},{10,20},{10,0},{20,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="voltageSensor.pin_n" right="inductor.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,20},{50,20},{50,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="ground.pin" right="inductor.pin_n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-30,-40},{80,-40},{80,0},{70,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="bode.divisor" right="complexConst.y">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-58,24},{-50,24},{-50,0},{-59,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="bode.u" right="voltageSensor.v">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-58,36},{30,36},{30,31}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.pin_p" right="voltageSource.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-20,0},{-30,0},{-30,-10}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="currentSensor.pin_n" right="resistor.pin_p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{0,0},{20,0}}" elementName="points"/>
          <modifications expression="{85,170,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;The frequency of the voltage source is varied by a logarithmic ramp, the supply voltage magnitude is constant.&lt;/p>&#xA;&lt;p>Plot versus &lt;code>voltageSource.f&lt;/code> on a logarithmic scale in order to determine the Bode diagrams of the ratio of&#xA;the voltage of the resistor divided by the supply voltage:&lt;/p>&#xA;&lt;ul>&#xA;&lt;li>Gain response: &lt;code>dB_y&lt;/code>&lt;/li>&#xA;&lt;li>Phase response: &lt;code>arg_y&lt;/code>&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="experiment">
        <modifications expression="1.0" elementName="StopTime"/>
        <modifications expression="0.001" elementName="Interval"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
