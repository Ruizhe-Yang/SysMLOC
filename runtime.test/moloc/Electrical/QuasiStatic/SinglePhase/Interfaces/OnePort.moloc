  <classes isPartial="true" classType="model" className="OnePort" description="&quot;Two pins, current through&quot;" isLongClassSpecifier="true" classNameEnd="OnePort" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="TwoPin" isOver="true"/>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="pin_p.i + pin_n.i" right="Complex(0)"/>
