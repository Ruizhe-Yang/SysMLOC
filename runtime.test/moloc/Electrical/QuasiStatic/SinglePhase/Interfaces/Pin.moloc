<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces"/>
  <classes classType="connector" className="Pin" description="&quot;Quasi-static single-phase pin&quot;" isLongClassSpecifier="true" classNameEnd="Pin" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ComplexElectricPotential" isOver="true">
      <component_list declarationName="v" description="&quot;Complex potential at the quasi-static single-phase pin&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ComplexCurrent" relationshipType="flow" isOver="true">
      <component_list declarationName="i" description="&quot;Complex current flowing into the quasi-static single-phase pin&quot;"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;The potential of this connector is the complex voltage and the flow variable is the complex current.&#xA;The &lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.PositivePin\&quot;>positive&lt;/a> and&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.NegativePin\&quot;>negative pin&lt;/a> are&#xA;derived from this base connector.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.PositivePin\&quot;>PositivePin&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.NegativePin\&quot;>NegativePin&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Interfaces.Plug\&quot;>Plug&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Interfaces.PositivePlug\&quot;>PositivePlug&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase.Interfaces.NegativePlug\&quot;>NegativePlug&lt;/a>&#xA;&lt;/p>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
