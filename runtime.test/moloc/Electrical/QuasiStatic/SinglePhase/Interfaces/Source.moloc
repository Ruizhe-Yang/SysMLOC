  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces"/>
  <classes isPartial="true" classType="model" className="Source" description="&quot;Partial voltage / current source&quot;" isLongClassSpecifier="true" classNameEnd="Source" isOver="true">
