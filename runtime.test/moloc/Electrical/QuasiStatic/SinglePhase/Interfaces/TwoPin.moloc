<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces">
  <classes isPartial="true" classType="model" className="TwoPin" description="&quot;Two pins&quot;" isLongClassSpecifier="true" classNameEnd="TwoPin" isOver="true">
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.Constants.eps" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.TwoPinElementary" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ComplexVoltage" isOver="true">
      <component_list declarationName="v" description="&quot;Complex voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="Modelica.ComplexMath.abs(v)" declarationName="abs_v" description="&quot;Magnitude of complex voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Angle" isOver="true">
      <component_list expression="Modelica.ComplexMath.arg(v)" declarationName="arg_v" description="&quot;Argument of complex voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ComplexCurrent" isOver="true">
      <component_list declarationName="i" description="&quot;Complex current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="Modelica.ComplexMath.abs(i)" declarationName="abs_i" description="&quot;Magnitude of complex current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Angle" isOver="true">
      <component_list expression="Modelica.ComplexMath.arg(i)" declarationName="arg_i" description="&quot;Argument of complex current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ActivePower" isOver="true">
      <component_list expression="Modelica.ComplexMath.real(v* Modelica.ComplexMath.conj(i) )" declarationName="P" description="&quot;Active power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ReactivePower" isOver="true">
      <component_list expression="Modelica.ComplexMath.imag(v* Modelica.ComplexMath.conj(i) )" declarationName="Q" description="&quot;Reactive power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ApparentPower" isOver="true">
      <component_list expression="Modelica.ComplexMath.abs(v* Modelica.ComplexMath.conj(i) )" declarationName="S" description="&quot;Magnitude of complex apparent power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
      <component_list expression="cos(Modelica.ComplexMath.arg(Complex(P, Q)))" declarationName="pf" description="&quot;Power factor&quot;"/>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.AngularVelocity" isOver="true">
      <component_list declarationName="omega" description="&quot;Angular velocity of reference frame&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="pin_p.v - pin_n.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i" right="pin_p.i"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This partial model uses a &lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.PositivePin\&quot;>positive&lt;/a>&#xA;and &lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.NegativePin\&quot;>negative pin&lt;/a> and defines&#xA;the complex voltage difference as well as the complex current (into the positive pin).&#xA;Additionally, the angular velocity of the quasi-static system is explicitly defined as variable.&#xA;This model is mainly intended to be used with graphical representation of user models.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.PositivePin\&quot;>PositivePin&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.NegativePin\&quot;>NegativePin&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.TwoPinElementary\&quot;>TwoPinElementary&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Interfaces.OnePort\&quot;>OnePort&lt;/a>&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
