<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Sensors"/>
  <classes classType="model" className="PowerSensor" description="&quot;Power sensor&quot;" isLongClassSpecifier="true" classNameEnd="PowerSensor" isOver="true">
    <elements xsi:type="mOloc:ImportClause" importName="Modelica.ComplexMath.conj" isOver="true"/>
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.RoundSensor" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.PositivePin" isOver="true">
      <component_list declarationName="currentP" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-10},{-90,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.NegativePin" isOver="true">
      <component_list declarationName="currentN" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-10},{110,10}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.PositivePin" isOver="true">
      <component_list declarationName="voltageP" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,90},{10,110}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Interfaces.NegativePin" isOver="true">
      <component_list declarationName="voltageN" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-110},{10,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ComplexCurrent" directionType="output" isOver="true">
      <component_list declarationName="i"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ComplexVoltage" directionType="output" isOver="true">
      <component_list declarationName="v"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.ComplexBlocks.Interfaces.ComplexOutput" isOver="true">
      <component_list isModificationOver="true" declarationName="apparentPower" description="&quot;Complex apparent power = active power + j * reactive power&quot;" isAnnotation="true" isAnnotationOver="true">
        <modifications isModificationOver="true" elementName="re">
          <modifications expression="&quot;W&quot;" elementName="unit"/>
        </modifications>
        <modifications isModificationOver="true" elementName="im">
          <modifications expression="&quot;var&quot;" elementName="unit"/>
        </modifications>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{-100,-110}" elementName="origin"/>
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="270" elementName="rotation"/>
            <modifications expression="{-100,-110}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ApparentPower" isOver="true">
      <component_list expression="Modelica.ComplexMath.abs(apparentPower)" declarationName="abs_apparentPower" description="&quot;Magnitude of complex apparent power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" isOver="true">
      <component_list expression="Modelica.ComplexMath.arg(apparentPower)" declarationName="arg_apparentPower" description="&quot;Argument of complex apparent power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:FunctionEquation" component="Connections.branch" function="(currentP.reference, currentN.reference)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="currentP.reference.gamma" right="currentN.reference.gamma"/>
      <equations xsi:type="mOloc:FunctionEquation" component="Connections.branch" function="(voltageP.reference, voltageN.reference)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="voltageP.reference.gamma" right="voltageN.reference.gamma"/>
      <equations xsi:type="mOloc:FunctionEquation" component="Connections.branch" function="(currentP.reference, voltageP.reference)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="currentP.reference.gamma" right="voltageP.reference.gamma"/>
      <equations xsi:type="mOloc:SimpleEquation" left="currentP.i + currentN.i" right="Complex(0)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="currentP.v - currentN.v" right="Complex(0)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i" right="currentP.i"/>
      <equations xsi:type="mOloc:SimpleEquation" left="voltageP.i + voltageN.i" right="Complex(0)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="voltageP.i" right="Complex(0)"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="voltageP.v - voltageN.v"/>
      <equations xsi:type="mOloc:SimpleEquation" left="apparentPower" right="v*conj(i)"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(points={{0,100},{0,70}}, color={85,170,255}), Line(points={{0,-70},{0,-100}}, color={85,170,255}), Line(points={{-100,0},{100,0}}, color={85,170,255}), Text( extent={{-150,110},{150,150}}, textString=&quot;%name&quot;, textColor={0,0,255} ) , Line(points={{-100,-100},{-100,-80},{-58,-38}}, color={85,170,255}), Text( extent={{-30,-10},{30,-70}}, textColor={64,64,64}, textString=&quot;V.A&quot; ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&#xA;&lt;p>&#xA;This sensor can be used to measure the complex apparent power.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.ReferenceSensor\&quot;>ReferenceSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.FrequencySensor\&quot;>FrequencySensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.PotentialSensor\&quot;>PotentialSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.VoltageSensor\&quot;>VoltageSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.CurrentSensor\&quot;>CurrentSensor&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sensors.MultiSensor\&quot;>MultiSensor&lt;/a>&#xA;&lt;/p>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
