<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Sources"/>
  <classes classType="model" className="CurrentSource" description="&quot;Constant AC current&quot;" isLongClassSpecifier="true" classNameEnd="CurrentSource" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.Source" isOver="true"/>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="f" description="&quot;Frequency of the source&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="I" description="&quot;RMS current of the source&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Angle" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="phi" description="&quot;Phase shift of the source&quot;">
        <modifications expression="0" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="omega" right="2*Modelica.Constants.pi*f"/>
      <equations xsi:type="mOloc:SimpleEquation" left="i" right="Complex(I*cos(phi), I*sin(phi))"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Polygon( points={{90,0},{60,10},{60,-10},{90,0}}, lineColor={85,170,255}, fillColor={85,170,255}, fillPattern=FillPattern.Solid ) , Line(points={{0,50},{0,-50}}, color={85,170,255}) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&#xA;&lt;p>&#xA;This is a constant current source, specifying the complex current by the RMS current and the phase shift.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.VoltageSource\&quot;>VoltageSource&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.VariableVoltageSource\&quot;>VariableVoltageSource&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.VariableCurrentSource\&quot;>VariableCurrentSource&lt;/a>&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
