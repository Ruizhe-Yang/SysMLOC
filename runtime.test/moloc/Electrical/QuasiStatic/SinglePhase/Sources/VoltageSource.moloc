<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc" isWithin="true" within="Modelica.Electrical.QuasiStatic.SinglePhase.Sources">
  <classes classType="model" className="VoltageSource" description="&quot;Constant AC voltage&quot;" isLongClassSpecifier="true" classNameEnd="VoltageSource" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Interfaces.Source" isOver="true"/>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Frequency" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="f" description="&quot;Frequency of the source&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="V" description="&quot;RMS voltage of the source&quot;">
        <modifications expression="1" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Angle" parameterType="parameter" isOver="true">
      <component_list isModificationOver="true" declarationName="phi" description="&quot;Phase shift of the source&quot;">
        <modifications expression="0" elementName="start"/>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:SimpleEquation" left="omega" right="2*Modelica.Constants.pi*f"/>
      <equations xsi:type="mOloc:SimpleEquation" left="v" right="Complex(V*cos(phi), V*sin(phi))"/>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Line(points={{-50,0},{50,0}}, color={85,170,255}), Line(points={{-70,30},{-70,10}}, color={85,170,255}), Line(points={{-80,20},{-60,20}}, color={85,170,255}), Line(points={{60,20},{80,20}}, color={85,170,255}) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&#xA;&lt;p>&#xA;This is a constant voltage source, specifying the complex voltage by the RMS voltage and the phase shift.&#xA;&lt;/p>&#xA;&#xA;&lt;h4>See also&lt;/h4>&#xA;&#xA;&lt;p>&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.VariableVoltageSource\&quot;>VariableVoltageSource&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.CurrentSource\&quot;>CurrentSource&lt;/a>,&#xA;&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Sources.VariableCurrentSource\&quot;>VariableCurrentSource&lt;/a>&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
