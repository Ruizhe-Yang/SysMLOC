<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.SinglePhase.Utilities"/>
  <classes classType="model" className="GraetzRectifier" description="&quot;Graetz rectifier bridge&quot;" isLongClassSpecifier="true" classNameEnd="GraetzRectifier" isOver="true">
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="pin_pAC.v - pin_nAC.v" declarationName="vAC" description="&quot;AC voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="pin_pAC.i" declarationName="iAC" description="&quot;AC current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.ActivePower" isOver="true">
      <component_list expression="vAC*iAC" declarationName="pAC" description="&quot;AC power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Voltage" isOver="true">
      <component_list expression="pin_pDC.v - pin_nDC.v" declarationName="vDC" description="&quot;DC voltage&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Current" isOver="true">
      <component_list expression="pin_pDC.i" declarationName="iDC" description="&quot;DC current&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="SI.Power" isOver="true">
      <component_list expression="vDC*iDC" declarationName="pDC" description="&quot;DC power&quot;"/>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pAC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,110},{-90,90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,110},{-90,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nAC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-110,-110},{-90,-90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{-110,-110},{-90,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
      <component_list declarationName="pin_pDC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,110},{110,90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,110},{110,90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.NegativePin" isOver="true">
      <component_list declarationName="pin_nDC" isAnnotation="true" isAnnotationOver="true">
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
          <modifications isModificationOver="true" elementName="iconTransformation">
            <modifications expression="{{90,-110},{110,-90}}" elementName="extent"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode1" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-40,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode2" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{40,30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode3" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{-40,-30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:ComponentClause" typeSpecifier="Modelica.Electrical.Analog.Ideal.IdealDiode" isOver="true">
      <component_list isModificationOver="true" declarationName="idealDiode4" isAnnotation="true" isAnnotationOver="true">
        <modifications expression="0" elementName="Vknee"/>
        <annotations isModificationOver="true" elementName="Placement">
          <modifications isModificationOver="true" elementName="transformation">
            <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
            <modifications expression="90" elementName="rotation"/>
            <modifications expression="{40,-30}" elementName="origin"/>
          </modifications>
        </annotations>
      </component_list>
    </elements>
    <elements xsi:type="mOloc:EquationSection">
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode1.p" right="idealDiode3.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,20},{-40,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode2.p" right="idealDiode4.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,20},{40,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode3.p" right="idealDiode4.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,-40},{40,-40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode1.n" right="idealDiode2.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-40,40},{40,40}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_pAC" right="idealDiode1.p">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,100},{-100,10},{-40,10},{-40,20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="pin_nAC" right="idealDiode4.n">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{-100,-100},{-100,-10},{40,-10},{40,-20}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode2.n" right="pin_pDC">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,40},{40,100},{100,100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
      <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="idealDiode4.p" right="pin_nDC">
        <annotations isModificationOver="true" elementName="Line">
          <modifications expression="{{40,-40},{40,-100},{100,-100}}" elementName="points"/>
          <modifications expression="{0,0,255}" elementName="color"/>
        </annotations>
      </equations>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations expression="&quot;rectifier&quot;" elementName="defaultComponentName"/>
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{ Text( extent={{50,30},{100,0}}, textColor={0,0,255}, textString=&quot;DC&quot; ) , Text( extent={{-100,30},{-50,0}}, textColor={0,0,255}, textString=&quot;AC&quot; ) , Text( extent={{-150,90},{150,50}}, textColor={0,0,255}, textString=&quot;%name&quot; ) , Line( points={{-2,40},{-2,40},{-70,40},{-2,40},{-70,-50},{-2,-50},{-2,40},{-2,-50}}, color={0,0,255} ) , Line( points={{2,40},{70,40},{2,40},{70,-50},{2,-50},{2,40},{2,-50}}, color={0,0,255} ) }" elementName="graphics"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;This is a so called Graetz-bridge, a single-phase rectifier built from 4 diodes.&#xA;&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
