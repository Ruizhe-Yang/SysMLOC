<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic"/>
  <classes classType="package" className="SinglePhase" description="&quot;Single-phase AC components&quot;" isLongClassSpecifier="true" classNameEnd="SinglePhase" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Package" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Icon">
        <modifications expression="{Rectangle(lineColor={0,0,255}, extent={{-50,-50},{ 50,50} } ) , Rectangle( fillColor={170,213,255}, fillPattern=FillPattern.Solid, extent={{-20,-20},{20,20}} ) }" elementName="graphics"/>
        <modifications isModificationOver="true" elementName="coordinateSystem">
          <modifications expression="{{-100,-100},{ 100,100} }" elementName="extent"/>
          <modifications expression="true" elementName="preserveAspectRatio"/>
        </modifications>
      </annotations>
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>This package hosts models for quasi-static single-phase circuits.Quasi-static theory for single-phase circuits can be found in the&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.References\&quot;>references&lt;/a>.&#xA;&lt;/p>&lt;h4>See also&lt;/h4>&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.Polyphase\&quot;>Polyphase&lt;/a>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
