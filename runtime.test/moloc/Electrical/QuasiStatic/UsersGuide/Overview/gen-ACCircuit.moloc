<?xml version="1.0" encoding="ASCII"?>
<mOloc:Stored_definition xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mOloc="http://www.control.dut/moloc/MOloc">
  <within withName="Modelica.Electrical.QuasiStatic.UsersGuide.Overview"/>
  <classes classType="class" className="ACCircuit" description="&quot;AC circuit&quot;" isLongClassSpecifier="true" classNameEnd="ACCircuit" isOver="true">
    <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Information" isOver="true"/>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&lt;p>A simple&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Examples.SeriesResonance\&quot;>&#xA;example&lt;/a> of a series connection of a resistor, an inductor and a capacitoras depicted in Fig. 1 should be explained in the following. For various frequencies,the voltage drops across the resistor, the inductor and the capacitor should be determined.&lt;/p>&lt;table border=\&quot;0\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;> &lt;tr> &lt;td> &lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/resonance_circuit.png\&quot;&#xA;alt=\&quot;resonance_circuit.png\&quot;> &lt;/td> &lt;/tr> &lt;caption align=\&quot;bottom\&quot;>Fig. 1: Series AC circuit of a resistor and an inductor at variable frequency&lt;/caption>&lt;/table>&lt;p>The voltage drop across the resistor&lt;/p>&lt;p>&lt;img border=\&quot;0\&quot; src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/img1.png\&quot;&#xA;alt=\&quot;\\underline{v}_{r}=R\\underline{i}\&quot;>&lt;/p>&lt;p>and the inductor&lt;/p>&lt;p>&lt;img border=\&quot;0\&quot; src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/img2.png\&quot;&#xA;alt=\&quot;\\underline{v}_{l}=j\\omega L\\underline{i}\&quot;>&lt;/p>&lt;p>and the capacitor&lt;/p>&lt;p>&lt;img border=\&quot;0\&quot; src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/img3.png\&quot;&#xA;alt=\&quot;\\underline{v}_{l}=j\\omega L\\underline{i}\&quot;>&lt;/p>&lt;p>add up to the total voltage&lt;/p>&lt;p>&lt;img border=\&quot;0\&quot; src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/img4.png\&quot;&#xA;alt=\&quot;\\underline{v}=\\underline{v}_{r}+\\underline{v}_{l}\&quot;>&lt;/p>&lt;p>as illustrated in the phasor diagram of Fig. 2.&lt;/p>&lt;table border=\&quot;0\&quot; cellspacing=\&quot;0\&quot; cellpadding=\&quot;2\&quot;> &lt;tr> &lt;td> &lt;img src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/phasor_diagram.png\&quot;&#xA;alt=\&quot;phasor_diagram.png\&quot;> &lt;/td> &lt;/tr> &lt;caption align=\&quot;bottom\&quot;>Fig. 2: Phasor diagram of a resistor and inductance series connection&lt;/caption>&lt;/table>&lt;p>Due to the series connection of the resistor, inductor and capacitor, the three currents are all equal:&lt;/p>&lt;p>&lt;img border=\&quot;0\&quot; src=\&quot;modelica://Modelica/Resources/Images/Electrical/QuasiStatic/UsersGuide/Overview/ACCircuit/img5.png\&quot;&#xA;alt=\&quot;img5.png\&quot;>&lt;/p>&lt;h4>See also&lt;/h4>&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.Overview.Introduction\&quot;>&#xA;Introduction&lt;/a>,&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.Overview.Power\&quot;>&#xA;Power&lt;/a>,&lt;a href=\&quot;modelica://Modelica.Electrical.QuasiStatic.UsersGuide.Overview.ReferenceSystem\&quot;>&#xA;Reference system&lt;/a>&lt;/html>&quot;" elementName="info"/>
      </annotations>
    </elements>
  </classes>
</mOloc:Stored_definition>
