        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mos2.mos2RenameParametersRevised( modelcard)" declarationName="p_obsolete" description="&quot;Model line parameters&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
