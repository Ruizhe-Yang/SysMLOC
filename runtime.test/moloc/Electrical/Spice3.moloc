            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_invEarlyVoltR" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_invRollOffR" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bNPN" expression="1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bPNP" expression="1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_area" expression="1.0"/>
