              <modifications expression="{{-72,48},{-63,48},{-63,47.9},{-54,47.9}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="U0.n" right="ground.p">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-72,28},{-80,28},{-80,-6},{-44,-6}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="J1.D" right="RC.p">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-44,58},{-44,70}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="UDD.p" right="RC.n">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-10,70},{-24,70}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="UDD.n" right="ground.p">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-10,50},{-10,-6},{-44,-6}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>This model is a simple JFET cascode circuit. The J2 gate variation (v_sin.p.v) is transformed to the J2 drain variation (J2.D.v).&lt;/p>&#xA;&lt;p>&lt;br>Simulate until 0.2s, and display the mentioned voltages.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>Aug. 2011&lt;/em> by Kristin Majetta initially implemented&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
          </annotations>
