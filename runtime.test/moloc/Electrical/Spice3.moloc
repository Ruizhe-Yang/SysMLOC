        <elements xsi:type="mOloc:GeneralClause" classType="function" className="fetRenameParametersDev" description="&quot;Device Parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="fetRenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
