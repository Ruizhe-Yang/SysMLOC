      <elements xsi:type="mOloc:GeneralClause" classType="model" className="Graetz" description="&quot;Graetz rectifier circuit&quot;" isLongClassSpecifier="true" classNameEnd="Graetz" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Semiconductors.D_DIODE" isOver="true">
          <component_list isModificationOver="true" declarationName="D1" isAnnotation="true" isAnnotationOver="true">
