            <modifications expression="2e-4" elementName="Interval"/>
            <modifications expression="1e-007" elementName="Tolerance"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="model" className="Spice3BenchmarkDifferentialPair" description="&quot;Simple differential pair&quot;" isLongClassSpecifier="true" classNameEnd="Spice3BenchmarkDifferentialPair" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Example" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Sources.V_pulse" isOver="true">
