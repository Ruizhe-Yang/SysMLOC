            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_c4IsGiven" expression="if (ex.C4 > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_c4" expression="if (ex.C4 > -1e40) then ex.C4 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_betaR" expression="ex. BR"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_emissionCoeffR" expression="ex.NR"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_leakBCemissionCoeff" expression="ex.NC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_earlyVoltF" expression="ex.VAF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_rollOffF" expression="ex.IKF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_earlyVoltR" expression="ex.VAR"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_rollOffR" expression="ex.IKR"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_emitterResist" expression="ex.RE"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_collectorResist" expression="ex.RC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_baseCurrentHalfResist" expression="ex.IRB"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_baseResist" expression="ex.RB"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_minBaseResist" expression="if (ex.RBM > -1e40) then ex.RBM else intern.m_baseResist"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_depletionCapBE" expression="ex.CJE"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_potentialBE" expression="ex.VJE"/>
