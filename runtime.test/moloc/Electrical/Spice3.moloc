            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dICvbe" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bICvbeIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dICvce" expression="0"/>
