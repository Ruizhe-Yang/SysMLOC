          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="v2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xv"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="a1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="b1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="c1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="d1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="b2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="r1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="s1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="s2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="p1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="p0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="p2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="a3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="b3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="sargv"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dldsat"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xlfact"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xdv"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xlv"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="vqchan"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dqdsat"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="vl"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dfunds"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dfundg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dfundb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xls"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dfact"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="vdson"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="cdson"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gdson"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="didvds"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gmw"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gbson"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="expg"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c" expression="in_c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ*Spice3.Internal.SpiceConstants.REFTEMP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="phiMinVbs" expression="out_c.m_tPhi - vbs"/>
            <statements xsi:type="mOloc:IfStatement" condition="( vbs &lt;= 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="sqrt( phiMinVbs)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dsrgdb" expression="-0.5 / sarg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="d2sdb2" expression="0.5 * dsrgdb / phiMinVbs"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sphi" expression="sqrt(out_c.m_tPhi)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sphi3" expression="out_c.m_tPhi*sphi"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="sphi/(1.0 + 0.5*vbs/out_c.m_tPhi)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="sarg/sphi3"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dsrgdb" expression="-0.5*sarg*tmp"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="d2sdb2" expression="-dsrgdb*tmp"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="( (vds-vbs) >= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="barg" expression="sqrt( phiMinVbs + vds)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dbrgdb" expression="-0.5 / barg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="d2bdb2" expression="0.5 * dbrgdb / (phiMinVbs + vds)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="barg" expression="sphi / (1.0 + 0.5 * (vbs - vds) / out_c.m_tPhi)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="barg / sphi3"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dbrgdb" expression="-0.5 * barg * tmp"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="d2bdb2" expression="-dbrgdb * tmp"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="factor" expression="0.125*in_p.m_narrowFactor*2.0*Modelica.Constants.pi*Spice3.Internal.SpiceConstants.EPSSIL /out_c.m_capOx*out_c.m_lEff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="eta" expression="1.0 + factor"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vbin" expression="out_c.m_tVbi * in_m_type + factor * phiMinVbs"/>
            <statements xsi:type="mOloc:IfStatement" condition="( (in_p.m_gamma > 0.0) or (in_p.m_substrateDoping > 0.0))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xwd" expression="in_p.m_xd * barg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xws" expression="in_p.m_xd * sarg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="argss" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="argsd" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dbargs" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dbargd" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dgdvds" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dgddb2" expression="0.0"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="( in_p.m_junctionDepth > 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="2.0 / in_p.m_junctionDepth"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argxs" expression="1.0 + xws * tmp"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argxd" expression="1.0 + xwd * tmp"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="args" expression="sqrt( argxs)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argd" expression="sqrt( argxd)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="0.5 * in_p.m_junctionDepth / out_c.m_lEff"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argss" expression="tmp * (args - 1.0)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argsd" expression="tmp * (argd - 1.0)"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gamasd" expression="in_p.m_gamma * (1.0 - argss - argsd)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dbxwd" expression="in_p.m_xd * dbrgdb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dbxws" expression="in_p.m_xd * dsrgdb"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="( in_p.m_junctionDepth > 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="0.5 / out_c.m_lEff"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dbargs" expression="tmp * dbxws / args"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dbargd" expression="tmp * dbxwd / argd"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dasdb2" expression="-in_p.m_xd * (d2sdb2 + dsrgdb * dsrgdb * in_p.m_xd / (in_p.m_junctionDepth * argxs) ) / (out_c.m_lEff * args)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="daddb2" expression="-in_p.m_xd * (d2bdb2 + dbrgdb * dbrgdb * in_p.m_xd / (in_p.m_junctionDepth * argxd) ) / (out_c.m_lEff * argd)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dgddb2" expression="-0.5 * in_p.m_gamma * (dasdb2 + daddb2)"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dgddvb" expression="-in_p.m_gamma * (dbargs + dbargd)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="( in_p.m_junctionDepth > 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="ddxwd" expression="-dbxwd"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dgdvds" expression="-in_p.m_gamma * 0.5 * ddxwd / (out_c.m_lEff * argd)"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="gamasd" expression="in_p.m_gamma"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="gammad" expression="in_p.m_gamma"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dgddvb" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dgdvds" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dgddb2" expression="0.0"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_von" expression="vbin + gamasd * sarg"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vth" expression="out_c.m_von"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="0.0"/>
            <statements xsi:type="mOloc:IfStatement" condition="( in_p.m_fastSurfaceStateDensity &lt;> 0.0 and out_c.m_capOx &lt;> 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cfs" expression="Spice3.Internal.SpiceConstants.CHARGE*in_p.m_fastSurfaceStateDensity* 1.0e4"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cdonco" expression="-(gamasd * dsrgdb + dgddvb * sarg) + factor"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xn" expression="1.0 + cfs / out_c.m_capOx * in_m.m_width * out_c.m_lEff + cdonco"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="vt * xn"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_von" expression="out_c.m_von + tmp"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="argg" expression="1.0 / tmp"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vgst" expression="vgs - out_c.m_von"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="vgst" expression="vgs - out_c.m_von"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="( vgs &lt;= out_c.m_von)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="0.0"/>
                <ifStatements xsi:type="mOloc:ReturnStatement"/>
              </elseStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="sarg3" expression="sarg * sarg * sarg"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gammad" expression="gamasd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dgdvbs" expression="dgddvb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="body" expression="barg * barg * barg - sarg3"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gdbdv" expression="2.0 * gammad * (barg * barg * dbrgdb - sarg * sarg * dsrgdb)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dodvbs" expression="-factor + dgdvbs * sarg + gammad * dsrgdb"/>
            <statements xsi:type="mOloc:IfStatement" condition="( (in_p.m_fastSurfaceStateDensity &lt;> 0.0) and (out_c.m_capOx &lt;> 0.0))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dxndvb" expression="2.0 * dgdvbs * dsrgdb + gammad * d2sdb2 + dgddb2 * sarg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dodvbs" expression="dodvbs + vt * dxndvb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dxndvd" expression="dgdvds * dsrgdb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dodvds" expression="dgdvds * sarg + vt * dxndvd"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="ufact" expression="1.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ueff" expression="in_p.m_surfaceMobility * 1e-4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dudvgs" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dudvds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dudvbs" expression="0.0"/>
            <statements xsi:type="mOloc:IfStatement" condition="(out_c.m_capOx > 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="in_p.m_critField*Spice3.Internal.SpiceConstants.EPSSIL*100/in_p.m_oxideCapFactor"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vgst > tmp)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="ufact" expression="exp( in_p.m_critFieldExp * Modelica.Math.log( tmp / vgst))"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="ueff" expression="in_p.m_surfaceMobility * 1.0e-4 * ufact"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dudvgs" expression="-ufact * in_p.m_critFieldExp / vgst"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dudvds" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dudvbs" expression="in_p.m_critFieldExp * ufact * dodvbs / vgst"/>
              </ifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vgsx" expression="vgs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gammad" expression="gamasd / eta"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dgdvbs" expression="dgddvb"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_fastSurfaceStateDensity &lt;> 0 and out_c.m_capOx &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vgsx" expression="max( vgs, out_c.m_von)"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(gammad > 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gammd2" expression="gammad * gammad"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="argv" expression="(vgsx - vbin) / eta + phiMinVbs"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(argv &lt;= 0.0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dsdvgs" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dsdvbs" expression="0.0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="sqrt( 1.0 + 4.0 * argv / gammd2)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="(vgsx - vbin) / eta + gammd2 * (1.0 - arg) / 2.0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="max( out_c.m_vdsat, 0.0)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvgs" expression="(1.0 - 1.0 / arg) / eta"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvbs" expression="(gammad * (1.0 - arg) + 2.0 * argv / (gammad * arg)) / eta * dgdvbs + 1.0 / arg + factor * dsdvgs"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="(vgsx - vbin) / eta"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="max( out_c.m_vdsat, 0.0)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvgs" expression="1.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvbs" expression="0.0"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_maxDriftVel > 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="v1" expression="(vgsx - vbin) / eta + phiMinVbs"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="v2" expression="phiMinVbs"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xv" expression="in_p.m_maxDriftVel * out_c.m_lEff / ueff"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="a1" expression="gammad / 0.75"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="b1" expression="-2.0 * (v1 + xv)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="c1" expression="-2.0 * gammad * xv"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="d1" expression="2.0 * v1 * (v2 + xv) - v2 * v2 - 4.0 / 3.0 * gammad * sarg3"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="b2" expression="a1 * c1 - 4.0 * d1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="r1" expression="-b1 * b1 / 3.0 + b2"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="s1" expression="2.0 * b1 * b1 * (-b1) / 27.0 + b1 * b2 / 3.0 + (-d1) * (a1 * a1 - 4.0 * b1) - c1 * c1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="s2" expression="s1 * s1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="p1" expression="s2 / 4.0 + r1 * r1 * r1 / 27.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="p0" expression="abs( p1)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="p2" expression="sqrt( p0)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig1[1]" expression="1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig1[2]" expression="-1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig1[3]" expression="1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig1[4]" expression="-1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig2[1]" expression="1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig2[2]" expression="1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig2[3]" expression="-1.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sig2[4]" expression="-1.0"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(p1 &lt; 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="y3" expression="2.0 * exp( Modelica.Math.log( sqrt( s2 / 4.0 + p0)) / 3.0) * cos( Modelica.Math.atan( -2.0 * p2 / s1) / 3.0) + b1 / 3.0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="y3" expression="exp( Modelica.Math.log( abs( -s1 / 2.0 + p2)) / 3.0) + exp( Modelica.Math.log( abs( -s1 / 2.0 - p2)) / 3.0) + b1 / 3.0"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="a3" expression="sqrt( a1 * a1 / 4.0 - b1 + y3)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="b3" expression="sqrt( y3 * y3 / 4.0 - d1)"/>
              <ifStatements xsi:type="mOloc:ForStatement" forIndices="i in 1:4">
                <forStatements xsi:type="mOloc:FunctionStatement" component="a4[i]" expression="a1/2.0+sig1[i]*a3"/>
                <forStatements xsi:type="mOloc:FunctionStatement" component="b4[i]" expression="y3/2.0+sig2[i]*b3"/>
                <forStatements xsi:type="mOloc:FunctionStatement" component="delta4" expression="a4[i]*a4[i]/4.0-b4[i]"/>
                <forStatements xsi:type="mOloc:IfStatement" condition="(delta4 >= 0)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="iknt" expression="iknt+1"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="sqrt(delta4)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="x4[iknt]" expression="-a4[i]/2.0+tmp"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="iknt" expression="iknt+1"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="x4[iknt]" expression="-a4[i]/2.0-tmp"/>
                </forStatements>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="jknt" expression="0"/>
              <ifStatements xsi:type="mOloc:ForStatement" forIndices="j in 1:iknt">
                <forStatements xsi:type="mOloc:IfStatement" condition="(x4[j] > 0)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="poly4[j]" expression="x4[j]*x4[j]*x4[j]*x4[j]+a1*x4[j]*x4[j]*x4[j]"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="poly4[j]" expression="poly4[j]+b1*x4[j]*x4[j]+c1*x4[j]+d1"/>
                  <ifStatements xsi:type="mOloc:IfStatement" condition="(abs(poly4[j]) &lt;= 1.0e-6)">
                    <ifStatements xsi:type="mOloc:FunctionStatement" component="jknt" expression="jknt+1"/>
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(jknt &lt;= 1)">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="xvalid" expression="x4[j]"/>
                    </ifStatements>
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(x4[j] &lt;= xvalid)">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="xvalid" expression="x4[j]"/>
                    </ifStatements>
                  </ifStatements>
                </forStatements>
              </ifStatements>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(jknt > 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="xvalid * xvalid - phiMinVbs"/>
              </ifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="dldvgs" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dldvds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dldvbs" expression="0.0"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vds &lt;> 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gammad" expression="gamasd"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="((vbs - out_c.m_vdsat) &lt;= 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="bsarg" expression="sqrt(out_c.m_vdsat + phiMinVbs)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dbsrdb" expression="-0.5 / bsarg"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="bsarg" expression="sphi/(1.0 + 0.5*(vbs - out_c.m_vdsat)/out_c.m_tPhi)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dbsrdb" expression="-0.5*bsarg*bsarg/sphi3"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="bodys" expression="bsarg * bsarg * bsarg - sarg3"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gdbdvs" expression="2.0 * gammad * (bsarg * bsarg * dbsrdb - sarg * sarg * dsrgdb)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_maxDriftVel &lt;= 0)">
                <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_substrateDoping &lt;> 0.0 and (xlamda &lt;= 0.0))">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="argv" expression="(vds - out_c.m_vdsat) / 4.0"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="sargv" expression="sqrt(1.0 + argv * argv)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="sqrt(argv + sargv)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="xlfact" expression="in_p.m_xd / (out_c.m_lEff * vds)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="xlamda" expression="xlfact * arg"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldsat" expression="vds * xlamda / (8.0 * sargv)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvgs" expression="dldsat * dsdvgs"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvds" expression="-xlamda + dldsat"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvbs" expression="dldsat * dsdvbs"/>
                </ifStatements>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="argv" expression="(vgsx - vbin) / eta - out_c.m_vdsat"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="xdv" expression="in_p.m_xd / sqrt(in_p.m_channelCharge)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="xlv" expression="in_p.m_maxDriftVel * xdv / (2.0 * ueff)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vqchan" expression="argv - gammad * bsarg"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dqdsat" expression="-1.0 + gammad * dbsrdb"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vl" expression="in_p.m_maxDriftVel *out_c. m_lEff"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dfunds" expression="vl * dqdsat - ueff * vqchan"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dfundg" expression="(vl - ueff * out_c.m_vdsat) / eta"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dfundb" expression="-vl * (1.0 + dqdsat - factor / eta) + ueff * (gdbdvs - dgdvbs * bodys / 1.5) / eta"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvgs" expression="-dfundg / dfunds"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="dsdvbs" expression="-dfundb / dfunds"/>
                <elseStatements xsi:type="mOloc:IfStatement" condition="((in_p.m_substrateDoping &lt;> 0.0) and (xlamda &lt;= 0.0))">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="argv" expression="vds - out_c.m_vdsat"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="argv" expression="max(argv,0.0)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="xls" expression="sqrt(xlv * xlv + argv)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldsat" expression="xdv / (2.0 * xls)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="xlfact" expression="xdv / (out_c.m_lEff * vds)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="xlamda" expression="xlfact * (xls - xlv)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldsat" expression="dldsat / out_c.m_lEff"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvgs" expression="dldsat * dsdvgs"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvds" expression="-xlamda + dldsat"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvbs" expression="dldsat * dsdvbs"/>
                </elseStatements>
              </ifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="xwb" expression="in_p.m_xd*sqrt(out_c.m_tBulkPot)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="xld" expression="out_c.m_lEff - xwb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="clfact" expression="1.0 - xlamda*vds"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dldvds" expression="-xlamda - dldvds"/>
            <statements xsi:type="mOloc:FunctionStatement" component="xleff" expression="out_c.m_lEff*clfact"/>
            <statements xsi:type="mOloc:FunctionStatement" component="deltal" expression="xlamda*vds*out_c.m_lEff"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_substrateDoping == 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xwb" expression="0.25e-6"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(xleff &lt; xwb)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="xleff" expression="xwb / (1.0 + (deltal - xld) / xwb)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="clfact" expression="xleff / out_c.m_lEff"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dfact" expression="xleff * xleff / (xwb * xwb)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvgs" expression="dfact * dldvgs"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvds" expression="dfact * dldvds"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dldvbs" expression="dfact * dldvbs"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="beta1" expression="out_c.m_Beta * ufact / clfact"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gammad" expression="gamasd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dgdvbs" expression="dgddvb"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vds &lt;= 1.0e-10)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vgs &lt;= out_c.m_von)">
                <ifStatements xsi:type="mOloc:IfStatement" condition="((in_p.m_fastSurfaceStateDensity == 0.0) or (out_c.m_capOx == 0.0))">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="0.0"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="beta1 * (out_c.m_von - vbin - gammad * sarg) * exp(argg * (vgs - out_c.m_von))"/>
                </ifStatements>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="beta1*(vgs - vbin - gammad*sarg)"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="0.0"/>
              <ifStatements xsi:type="mOloc:ReturnStatement"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(vgs &lt;= out_c.m_von)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(out_c.m_vdsat &lt;= 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="0.0"/>
                <ifStatements xsi:type="mOloc:IfStatement" condition="(vgs > vth)">
                  <ifStatements xsi:type="mOloc:ReturnStatement"/>
                </ifStatements>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="0.0"/>
                <ifStatements xsi:type="mOloc:ReturnStatement"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vdson" expression="min(out_c.m_vdsat, vds)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vds > out_c.m_vdsat)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="barg" expression="bsarg"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="dbrgdb" expression="dbsrdb"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="body" expression="bodys"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="gdbdv" expression="gdbdvs"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cdson" expression="beta1 * ((out_c.m_von - vbin - eta * vdson * 0.5) * vdson - gammad * body / 1.5)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="didvds" expression="beta1 * (out_c.m_von - vbin - eta * vdson - gammad * barg)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gdson" expression="-cdson * dldvds / clfact - beta1 * dgdvds * body / 1.5"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vds &lt; out_c.m_vdsat)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="gdson" expression="gdson + didvds"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gbson" expression="-cdson * dldvbs / clfact + beta1 * (dodvbs * vdson + factor * vdson - dgdvbs * body / 1.5 - gdbdv)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vds > out_c.m_vdsat)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="gbson" expression="gbson + didvds * dsdvbs"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="expg" expression="exp(argg * (vgs - out_c.m_von))"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="cdson * expg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gmw" expression="out_c.m_cdrain * argg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="gmw"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vds > out_c.m_vdsat)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="gmw + didvds * dsdvgs * expg"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="tmp" expression="gmw * (vgs - out_c.m_von) / xn"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="gdson * expg - out_c.m_gm * dodvds - tmp * dxndvd"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="gbson * expg - out_c.m_gm * dodvbs - tmp * dxndvb"/>
              <elseCondition>(vds &lt;= out_c.m_vdsat)</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="beta1 * ((vgs - vbin - eta * vds / 2.0) * vds - gammad * body / 1.5)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="out_c.m_cdrain * (dudvgs / ufact - dldvgs / clfact)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="arg + beta1 * vds"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="out_c.m_cdrain * (dudvds / ufact - dldvds / clfact)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="arg + beta1 * (vgs - vbin - eta * vds - gammad * barg - dgdvds * body / 1.5 )"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="out_c.m_cdrain * (dudvbs / ufact - dldvbs / clfact)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="arg - beta1 * (gdbdv + dgdvbs * body / 1.5 - factor * vds)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="beta1 * ((vgs - vbin - eta * out_c.m_vdsat / 2.0 ) * out_c.m_vdsat - gammad * bodys / 1.5 )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="out_c.m_cdrain * (dudvgs / ufact - dldvgs / clfact)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="arg + beta1 * out_c.m_vdsat + beta1 * (vgs - vbin - eta * out_c.m_vdsat - gammad * bsarg) * dsdvgs"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="-out_c.m_cdrain * dldvds / clfact - beta1 * dgdvds * bodys / 1.5"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="out_c.m_cdrain * (dudvbs / ufact - dldvbs / clfact)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="arg - beta1 * (gdbdvs + dgdvbs * bodys / 1.5 - factor * out_c.m_vdsat) + beta1 * (vgs - vbin - eta * out_c.m_vdsat - gammad * bsarg) * dsdvbs"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function drainCurRevised calculates the main currents that flows from drain node to source node (level 2).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos2RenameParametersRevised" description="&quot;Parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="mos2RenameParametersRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.ModelcardMOS2" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Mos2.Mos2ModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_narrowFactor" expression="ex.DELTA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_critFieldExp" expression="ex.UEXP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_critField" expression="ex.UCRIT"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_maxDriftVel" expression="ex.VMAX"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_junctionDepth" expression="ex.XJ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_channelCharge" expression="ex.NEFF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fastSurfaceStateDensity" expression="ex.NFS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_oxideCapFactor" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_vtOIsGiven" expression="if (ex.VTO > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_vt0" expression="if (ex.VTO > -1e40) then ex.VTO else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBDIsGiven" expression="if (ex.CBD > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBD" expression="if (ex.CBD > -1e40) then ex.CBD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBSIsGiven" expression="if (ex.CBS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBS" expression="if (ex.CBS > -1e40) then ex.CBS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkCapFactor" expression="ex.CJ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sideWallCapFactor" expression="ex.CJSW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fwdCapDepCoeff" expression="ex.FC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_phiIsGiven" expression="if (ex.PHI > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_phi" expression="if (ex.PHI > -1e40) then ex.PHI else 0.6"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gammaIsGiven" expression="if (ex.GAMMA > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gamma" expression="if (ex.GAMMA > -1e40) then ex.GAMMA else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_lambda" expression="ex.LAMBDA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_substrateDopingIsGiven" expression="if (ex.NSUB > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_substrateDoping" expression="if (ex.NSUB > -1e40) then ex.NSUB else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gateType" expression="ex.TPG"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_surfaceStateDensity" expression="ex.NSS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_surfaceMobility" expression="ex.UO"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_latDiff" expression="ex.LD"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_jctSatCur" expression="ex.IS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainResistanceIsGiven" expression="if (ex.RD > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainResistance" expression="if (ex.RD > -1e40) then ex.RD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceResistanceIsGiven" expression="if (ex.RS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceResistance" expression="if (ex.RS > -1e40) then ex.RS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transconductanceIsGiven" expression="if (ex.KP > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transconductance" expression="if (ex.KP > -1e40) then ex.KP else 2e-5"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_tnom" expression="ex.TNOM + Spice3.Internal.SpiceConstants.CONSTCtoK"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_jctSatCurDensity" expression="ex.JS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sheetResistance" expression="ex.RSH"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkJctPotential" expression="ex.PB"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkJctBotGradingCoeff" expression="ex.MJ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkJctSideGradingCoeff" expression="ex.MJSW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_oxideThickness" expression="if (ex.TOX > -1e40) then ex.TOX else 1e-7"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gateSourceOverlapCapFactor" expression="ex.CGSO"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gateDrainOverlapCapFactor" expression="ex.CGDO"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gateBulkOverlapCapFactor" expression="ex.CGBO"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fNcoef" expression="ex.KF"/>
