          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Fet" directionType="output" isOver="true">
            <component_list declarationName="dev" description="&quot;Output record MESFET&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_capgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_capgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_cdrain" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_cgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_cgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_chargegd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_chargegs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_corDepCap" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dVt" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_f1" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_f2" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_f3" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_gds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_ggd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_ggs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_gm" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_tCGD" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_tCGS" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_tGatePot" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_tSatCur" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_vcrit" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_vds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_vgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_vgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_bICVDSIsGiven" expression="if ( IC_VDS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVDS" expression="if ( IC_VDS > -1e40) then IC_VDS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_bICVGSIsGiven" expression="if ( IC_VGS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVGS" expression="if ( IC_VGS > -1e40) then IC_VGS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_off" expression="OFF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_uic" expression="UIC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dTemp" expression="TEMP + Modelica.Electrical.Spice3.Internal.SpiceConstants.CONSTCtoK"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_area" expression="AREA"/>
