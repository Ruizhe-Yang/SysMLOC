            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transitTimeFVBC" expression="ex.VTF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_excessPhase" expression="ex.PTF"/>
