          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;dl>&#xA;&lt;dt>&lt;em> April 2009 &lt;/em>&lt;/dt>&#xA;&lt;dd>by Kristin Majetta initially implemented&lt;/dd>&#xA;&lt;/dl>&#xA;&lt;/html>&quot;" elementName="revisions"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Semiconductor resistance model&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="ModelcardR" description="&quot;Record with technology parameters (.model)&quot;" isLongClassSpecifier="true" classNameEnd="ModelcardR" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.LinearTemperatureCoefficientResistance" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="TC1" description="&quot;First order temperature coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.QuadraticTemperatureCoefficientResistance" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="TC2" description="&quot;Second order temperature coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="RSH" description="&quot;Sheet resistance&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="TNOM" description="&quot;Parameter measurement temperature, default 27&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="1e-5" declarationName="DEFW" description="&quot;Default device width&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="NARROW" description="&quot;Narrowing of resistor due to side etching&quot;"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Modelcard parameters for semiconductor resistance model&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="model" className="C_SEMI" description="&quot;Semiconductor capacitor&quot;" isLongClassSpecifier="true" classNameEnd="C_SEMI" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.OnePort" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="C" description="&quot;Capacitance, if specified, geometrical information is overwritten&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="27" declarationName="TEMP" description="&quot;Temperature of capacitor&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" declarationName="L" description="&quot;Length of the capacitor&quot;">
            <modifications expression="0" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="W" description="&quot;Width of the capacitor, default DEFW (modelcard)&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list expression="false" declarationName="SENS_AREA" description="&quot;Parameter for sensitivity analyses, not implemented yet&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="IC" description="&quot;Initial value&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Dialog">
              <modifications expression="UIC" elementName="enable"/>
            </annotations>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list expression="false" declarationName="UIC" description="&quot;Use initial conditions: true, if initial condition is used&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.ModelcardC" parameterType="parameter" isOver="true">
          <component_list declarationName="modelcard" description="&quot;Capacitor modelcard&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Csemiconductor.CapacitorModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Modelica.Electrical.Spice3.Internal.Csemiconductor.capacitorRenameParameters( modelcard)" declarationName="lp" description="&quot;Model Line Parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Csemiconductor.Capacitor" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Modelica.Electrical.Spice3.Internal.Csemiconductor.capacitorRenameParametersDev( C, W, L, TEMP, SENS_AREA, lp )" declarationName="cp" description="&quot;Renamed parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Csemiconductor.Capacitor" isOver="true">
          <component_list declarationName="vp"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
          <component_list declarationName="vinternal"/>
        </elements>
        <elements xsi:type="mOloc:EquationSection" isInitial="true">
          <equations xsi:type="mOloc:IfEquation" condition="UIC">
            <ifEquations xsi:type="mOloc:SimpleEquation" left="vinternal" right="IC"/>
            <elseEquations xsi:type="mOloc:SimpleEquation" left="der(vinternal)" right="0"/>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AlgorithmSection">
          <statements xsi:type="mOloc:IfStatement" condition="(cp.m_dCapIsGiven &lt; 0.5)">
            <ifStatements xsi:type="mOloc:FunctionStatement" component="assert" function="( L > 0, &quot;Length of capacitor must be greater than zero&quot;)"/>
          </statements>
          <statements xsi:type="mOloc:FunctionStatement" component="vp" expression="Modelica.Electrical.Spice3.Internal.Csemiconductor.capacitorInitEquations( cp, lp)"/>
          <statements xsi:type="mOloc:FunctionStatement" component="vinternal" expression="p.v - n.v"/>
          <statements xsi:type="mOloc:FunctionStatement" component="i" expression="vp.m_dCapac*der(vinternal)"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="true" elementName="preserveAspectRatio"/>
              <modifications expression="{{-100, -100 } ,{100,100} }" elementName="extent"/>
            </modifications>
            <modifications expression="{ Line( points={{-14,28},{-14,-28}}, color={0,0,255}, thickness=0.5 ) , Line( points={{14,28},{14,-28}}, color={0,0,255}, thickness=0.5 ) , Line(points={{-90,0},{-14,0}}, color={0,0,255}), Line(points={{14,0},{90,0}}, color={0,0,255}), Text( extent={{-130,-40},{134,-60}}, textString=&quot;C=%C&quot; ) , Text(extent={{-138,42},{136,62}}, textString=&quot;%name&quot;) }" elementName="graphics"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>April 2009&lt;/em> by Kristin Majetta&#xA;    &lt;br>initially implemented&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Semiconductor capacitance model&lt;/p>&#xA;&lt;p>&lt;br>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="ModelcardC" description="&quot;Record with technology parameters (.model)&quot;" isLongClassSpecifier="true" classNameEnd="ModelcardC" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.CapacitancePerArea" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="CJ" description="&quot;Junction bottom capacitance     F/meters2&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Permittivity" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="CJSW" description="&quot;Junction sidewall capacitance   F/meters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
