        <elements xsi:type="mOloc:GeneralClause" classType="function" className="limitJunctionVoltageRevised" description="&quot;Limitation of junction voltage&quot;" isLongClassSpecifier="true" classNameEnd="limitJunctionVoltageRevised" isOver="true">
