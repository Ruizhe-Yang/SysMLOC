          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="m_gbs" description="&quot;Gbs, Bulk-Source conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="m_cbd" description="&quot;Ibd, B-D junction current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="m_gbd" description="&quot;Gbd, Bulk-Drain conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="m_cdrain" description="&quot;Ids&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="m_gds" description="&quot;Gds, Drain-Source conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Transconductance" isOver="true">
            <component_list declarationName="m_gm" description="&quot;Gm, Transconductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Transconductance" isOver="true">
            <component_list declarationName="m_gmbs" description="&quot;Gmbs, Bulk-Source transconductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capbsb" description="&quot;Cbsb&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="m_chargebsb" description="&quot;Qbsb&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capbss" description="&quot;Cbss&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="m_chargebss" description="&quot;Qbss&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capbdb" description="&quot;Cbdb&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="m_chargebdb" description="&quot;Qbdb&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capbds" description="&quot;Cbds&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="m_chargebds" description="&quot;Qbds&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_Beta" description="&quot;Beta&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capGSovl" description="&quot;Cgso, Gate-source overlap cap.&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capGDovl" description="&quot;Cgdo, Gate-drain overlap cap.&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capGBovl" description="&quot;Cgbo, Gate-bulk overlap cap.&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="m_capOx" description="&quot;Cox&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="m_von" description="&quot;Von, Turn-on voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="m_vdsat" description="&quot;Vdsat&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" isOver="true">
            <component_list isModificationOver="true" declarationName="m_mode" description="&quot;Mode&quot;">
              <modifications expression="1" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list declarationName="m_lEff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" isOver="true">
            <component_list declarationName="m_sourceResistance" description="&quot;Rs&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" isOver="true">
            <component_list declarationName="m_drainResistance" description="&quot;Rd&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This record MosfetCalc contains variables that are needed for calculation within modeling the semiconductor models.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosfetInitEquations" description="&quot;MOSFET initial precalculations&quot;" isLongClassSpecifier="true" classNameEnd="mosfetInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input parameter set&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mosfet" directionType="output" isOver="true">
            <component_list declarationName="out_m" description="&quot;Changed parameter set&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_m" expression="in_m"/>
            <statements xsi:type="mOloc:IfStatement" condition="(out_m.m_drainSquares == 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_m.m_drainSquares" expression="1."/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_m.m_sourceSquares == 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_m.m_sourceSquares" expression="1."/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function initially precalculates some values for transistor area which can be used for all transistor models.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosfetModelLineInitEquations" description="&quot;Type transcription&quot;" isLongClassSpecifier="true" classNameEnd="mosfetModelLineInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input parameter set&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MosfetModelLine" directionType="output" isOver="true">
            <component_list declarationName="out_ml" description="&quot;Changed parameter set&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_ml.m_type" expression="if (in_m.m_bPMOS > 0.5) then -1 else 1"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>In this function during the initialization phase the transistor type is transcribed to another parameter for further usage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="getNumberOfElectricalPins" description="&quot;Number of Pins&quot;" isLongClassSpecifier="true" classNameEnd="getNumberOfElectricalPins" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Number of pins&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="4"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function getNumberOfElectricalPins identifies the number of electrical pins. At the current library version it is fixed to 4.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosfetRenameParametersDev" description="&quot;Device parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="mosfetRenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="W" description="&quot;Channel Width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="L" description="&quot;Channel Length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" directionType="input" isOver="true">
            <component_list declarationName="AD" description="&quot;Area of the drain diffusion&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" directionType="input" isOver="true">
            <component_list declarationName="AS" description="&quot;Area of the source diffusion&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="PD" description="&quot;Perimeter of the drain junction&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="PS" description="&quot;Perimeter of the source junction&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="NRD" description="&quot;Number of squares of the drain diffusions&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="NRS" description="&quot;Number of squares of the source diffusions&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="OFF" description="&quot;Optional initial condition: 0 - IC not used, 1 - IC used, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="IC_VDS" description="&quot;Initial condition value VDS, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="IC_VGS" description="&quot;Initial condition value VGS, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="IC_VBS" description="&quot;Initial condition value VBS, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="UIC" description="&quot;Use initial condition, UIC&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Mosfet.Mosfet" directionType="output" isOver="true">
            <component_list declarationName="dev" description="&quot;Output record Mosfet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;L, length of channel region&quot;" component="dev.m_len" expression="L"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;W, width of channel region&quot;" component="dev.m_width" expression="W"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;AD, area of drain diffusion&quot;" component="dev.m_drainArea" expression="AD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;AS, area of source diffusion&quot;" component="dev.m_sourceArea" expression="AS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;NRD, length of drain in squares&quot;" component="dev.m_drainSquares" expression="NRD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;NRS, length of source in squares&quot;" component="dev.m_sourceSquares" expression="NRS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;PD, Drain perimeter&quot;" component="dev.m_drainPerimeter" expression="PD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;PS, Source perimeter&quot;" component="dev.m_sourcePerimeter" expression="PS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;IC_VDS IsGivenValue&quot;" component="dev.m_dICVDSIsGiven" expression="if (IC_VDS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VDS&quot;" component="dev.m_dICVDS" expression="if (IC_VDS > -1e40) then IC_VDS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;IC_VGS IsGivenValue&quot;" component="dev.m_dICVGSIsGiven" expression="if (IC_VGS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VGS&quot;" component="dev.m_dICVGS" expression="if (IC_VGS > -1e40) then IC_VGS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;IC_VBS IsGivenValue&quot;" component="dev.m_dICVBSIsGiven" expression="if (IC_VBS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VBS&quot;" component="dev.m_dICVBS" expression="if (IC_VBS > -1e40) then IC_VBS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Non-zero to indicate device is off for dc analysis&quot;" component="dev.m_off" expression="OFF"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Use initial conditions&quot;" component="dev.m_uic" expression="UIC"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Device temperature&quot;" component="dev.m_dTemp" expression="TEMP + Spice3.Internal.SpiceConstants.CONSTCtoK"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;blockquote>&lt;pre>&#xA;This function mosfetRenameParametersDev assigns the external (given by the user) device parameters to the internal parameters. It also does the analysis of the IsGiven values (level 1).&#xA;&lt;/pre>&lt;/blockquote>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>The package Mosfet contains all functions and records that are used for all types of Mosfet transistors in SPICE3.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Mos" description="&quot;Records and functions for MOSFETs level 1,2,3,6&quot;" isLongClassSpecifier="true" classNameEnd="Mos" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="MosModelLineParams" description="&quot;Record for Mosfet model line parameters (for level 1, 2, 3 and 6)&quot;" isLongClassSpecifier="true" classNameEnd="MosModelLineParams" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Spice3.Internal.Mosfet.MosfetModelLineParams" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" declarationName="m_oxideCapFactor">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list isModificationOver="true" declarationName="m_vt0" description="&quot;VTO, Threshold voltage&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_vtOIsGiven" description="&quot;VTO IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list isModificationOver="true" declarationName="m_capBD" description="&quot;CBD, B-D junction capacitance&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_capBDIsGiven" description="&quot;CapBD IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list isModificationOver="true" declarationName="m_capBS" description="&quot;CBS, B-S junction capacitance&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_capBSIsGiven" description="&quot;CapBS IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.CapacitancePerArea" isOver="true">
            <component_list isModificationOver="true" declarationName="m_bulkCapFactor" description="&quot;CJ, Bottom junction cap per area&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_bulkCapFactorIsGiven" description="&quot;Bulk cap factor IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Permittivity" isOver="true">
            <component_list isModificationOver="true" declarationName="m_sideWallCapFactor" description="&quot;CJSW, Side grading coefficient&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" declarationName="m_fwdCapDepCoeff" description="&quot;FC, Forward bias junction fit parameter&quot;">
              <modifications expression="0.5" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list isModificationOver="true" declarationName="m_phi" description="&quot;PHI, Surface potential&quot;">
              <modifications expression="0.6" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_phiIsGiven" description="&quot;Phi IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list isModificationOver="true" declarationName="m_gamma" description="&quot;GAMMA, Bulk threshold parameter&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_gammaIsGiven" description="&quot;Gamma IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.InversePotential" isOver="true">
            <component_list declarationName="m_lambda" description="&quot;Channel-length modulation&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" declarationName="m_substrateDoping" description="&quot;NSUB, Substrate doping&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_substrateDopingIsGiven" description="&quot;Substrate doping IsGivenValue&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" declarationName="m_gateType" description="&quot;TPG, Gate type&quot;">
              <modifications expression="1.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.PerArea_cm" isOver="true">
            <component_list isModificationOver="true" declarationName="m_surfaceStateDensity" description="&quot;NSS, Gate type&quot;">
              <modifications expression="0.0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" declarationName="m_surfaceStateDensityIsGiven" description="&quot;surfaceStateDensityIsGivenValue&quot;">
              <modifications expression="0" elementName="start"/>
            </component_list>
