            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_betaExp" expression="ex.XTB"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_energyGap" expression="ex.EG"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_tempExpIS" expression="ex.XTI"/>
