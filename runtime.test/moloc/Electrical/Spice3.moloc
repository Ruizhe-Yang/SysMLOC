            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This record Mos1Calc contains further MOSFET variables (for level 2) that are needed for the calculations.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
