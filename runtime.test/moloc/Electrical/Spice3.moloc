        <elements xsi:type="mOloc:GeneralClause" classType="record" className="ResistorVariables" description="&quot;Variables for the resistor model&quot;" isLongClassSpecifier="true" classNameEnd="ResistorVariables" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
