            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVDSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVDS" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVGSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVGS" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dICVBSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
