        <elements xsi:type="mOloc:GeneralClause" classType="function" className="bjtModelLineInitEquations" description="&quot;Initial calculation&quot;" isLongClassSpecifier="true" classNameEnd="bjtModelLineInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with Bjt model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="out_p" description="&quot;Output record with Bjt model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_p" expression="in_p"/>
            <statements xsi:type="mOloc:IfStatement" condition="( not (out_p.m_leakBEcurrentIsGiven > 0.5) and (out_p.m_c2IsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_leakBEcurrent" expression="out_p.m_c2 * out_p.m_satCur"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="( not (out_p.m_leakBCcurrentIsGiven > 0.5) and (out_p.m_c4IsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_leakBCcurrent" expression="out_p.m_c4 * out_p.m_satCur"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_earlyVoltF &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_invEarlyVoltF" expression="1 / out_p.m_earlyVoltF"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_rollOffF &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_invRollOffF" expression="1 / out_p.m_rollOffF"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_earlyVoltR &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_invEarlyVoltR" expression="1 / out_p.m_earlyVoltR"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_rollOffR &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_invRollOffR" expression="1 / out_p.m_rollOffR"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_collectorResist &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_collectorConduct" expression="1 / out_p.m_collectorResist"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_emitterResist &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_emitterConduct" expression="1 / out_p.m_emitterResist"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_transitTimeFVBC &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_transitTimeVBCFactor" expression="1 / (out_p.m_transitTimeFVBC * 1.44)"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_p.m_excessPhaseFactor" expression="(out_p.m_excessPhase/(180.0/ Modelica.Constants.pi ) ) *out_p.m_transitTimeF"/>
            <statements xsi:type="mOloc:IfStatement" condition="(out_p.m_depletionCapCoeff > 0.9999)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_p.m_depletionCapCoeff" expression="0.9999"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>Within this function some parameters are initially precalculated from model line parameters.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="bjtInitEquations" description="&quot;Initial calculation&quot;" isLongClassSpecifier="true" classNameEnd="bjtInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Bjt" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record Bjt&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_pml" description="&quot;Input record with Bjt model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Bjt" directionType="output" isOver="true">
            <component_list declarationName="out_v" description="&quot;Output record with Bjt&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_v" expression="in_p"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_transitTimeHighCurrentF" expression="in_pml.m_transitTimeHighCurrentF * out_v.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_invRollOffF" expression="in_pml.m_invRollOffF / out_v.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_invRollOffR" expression="in_pml.m_invRollOffR / out_v.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_CScap" expression="in_pml.m_capCS * out_v.m_area"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>Within this function some parameters are initially precalculated from model line parameters.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="bjtCalcTempDependencies" description="&quot;Temperature dependency calculation&quot;" isLongClassSpecifier="true" classNameEnd="bjtCalcTempDependencies" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Bjt" directionType="input" isOver="true">
            <component_list declarationName="in_p3" description="&quot;Input record Bjt&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with Bjt model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtCalc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record BjtCalc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="fact1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="fact2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isOver="true">
            <component_list declarationName="egfet"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.GapEnergyPerEnergy" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="pbfact"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="ratlog"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="ratio1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="factlog"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="factor"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="bfactor"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="pbo"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gmanew"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gmaold"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="fact1" expression="in_p.m_tnom/Spice3.Internal.SpiceConstants.REFTEMP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="in_p3.m_dTemp*Spice3.Internal.SpiceConstants.CONSTKoverQ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="fact2" expression="in_p3.m_dTemp/Spice3.Internal.SpiceConstants.REFTEMP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="egfet" expression="Spice3.Internal.MaterialParameters.EnergyGapSi - (Spice3.Internal.MaterialParameters.FirstBandCorrFactorSi *in_p3.m_dTemp*in_p3.m_dTemp ) /(in_p3.m_dTemp + Spice3.Internal.MaterialParameters.SecondBandCorrFactorSi)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="arg" expression="-egfet/(2*Spice3.Internal.SpiceConstants.CONSTboltz*in_p3.m_dTemp) + Spice3.Internal.MaterialParameters.BandCorrFactorT300/(Spice3.Internal.SpiceConstants.CONSTboltz *(Spice3.Internal.SpiceConstants.REFTEMP + Spice3.Internal.SpiceConstants.REFTEMP) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbfact" expression="-2*vt*(1.5*Modelica.Math.log(fact2) + Spice3.Internal.SpiceConstants.CHARGE *arg )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratlog" expression="Modelica.Math.log(in_p3.m_dTemp/in_p.m_tnom)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratio1" expression="in_p3.m_dTemp / in_p.m_tnom - 1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="factlog" expression="ratio1 * in_p.m_energyGap / vt + in_p.m_tempExpIS * ratlog"/>
            <statements xsi:type="mOloc:FunctionStatement" component="factor" expression="exp( factlog)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="bfactor" expression="exp(ratlog * in_p.m_betaExp)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbo" expression="(in_p.m_potentialBE - pbfact) / fact1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmaold" expression="(in_p.m_potentialBE - pbo) / pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCur" expression="in_p.m_satCur * factor * in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBetaF" expression="in_p.m_betaF * bfactor"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBetaR" expression="in_p.m_betaR * bfactor"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBEleakCur" expression="in_p.m_leakBEcurrent * exp(factlog / in_p.m_leakBEemissionCoeff) / bfactor * in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBCleakCur" expression="in_p.m_leakBCcurrent * exp(factlog / in_p.m_leakBCemissionCoeff) / bfactor * in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBEcap" expression="in_p.m_depletionCapBE/(1 + in_p.m_junctionExpBE*(4e-4*( in_p.m_tnom - Spice3.Internal.SpiceConstants.REFTEMP) - gmaold ) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBEpot" expression="fact2 * pbo + pbfact"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmanew" expression="(out_c.m_tBEpot - pbo) / pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBEcap" expression="out_c.m_tBEcap*(1 + in_p.m_junctionExpBE*(4e-4*(in_p3.m_dTemp - Spice3.Internal.SpiceConstants.REFTEMP ) - gmanew ) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbo" expression="(in_p.m_potentialBC - pbfact) / fact1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmaold" expression="(in_p.m_potentialBC - pbo) / pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBCcap" expression="in_p.m_depletionCapBC/(1 + in_p.m_junctionExpBC*(4e-4*( in_p.m_tnom - Spice3.Internal.SpiceConstants.REFTEMP) - gmaold ) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBCpot" expression="fact2 * pbo + pbfact"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmanew" expression="(out_c.m_tBCpot - pbo) / pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBCcap" expression="out_c.m_tBCcap*(1 + in_p.m_junctionExpBC*(4e-4*(in_p3.m_dTemp - Spice3.Internal.SpiceConstants.REFTEMP ) - gmanew ) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDepCapBE" expression="in_p.m_depletionCapCoeff * out_c.m_tBEpot"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDepCapBC" expression="in_p.m_depletionCapCoeff * out_c.m_tBCpot"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVcrit" expression="vt*Modelica.Math.log(vt/(Spice3.Internal.SpiceConstants.CONSTroot2 *in_p.m_satCur ) )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_dVt" expression="vt"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBEcap" expression="out_c.m_tBEcap * in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBCcap" expression="out_c.m_tBCcap * in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_junctionExpBC, in_p.m_depletionCapCoeff, out_c.m_tBCpot )" output="out_c.m_tF1c,out_c.m_f2c,out_c.m_f3c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_junctionExpBE, in_p.m_depletionCapCoeff, out_c.m_tBEpot )" output="out_c.m_tF1e,out_c.m_f2e,out_c.m_f3e"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>In this function for the bipolar transistor model temperature dependencies are calculated using temperature treating functions from the equation package.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="bjtNoBypassCode" description="&quot;Calculation of currents&quot;" isLongClassSpecifier="true" classNameEnd="bjtNoBypassCode" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Bjt" directionType="input" isOver="true">
            <component_list declarationName="in_p3" description="&quot;Input record Bjt&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with Bjt model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="BjtCalc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record BjtCalc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[6]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CurrentsCapacitances" directionType="output" isOver="true">
            <component_list declarationName="out_cc" description="&quot;Output record with calculated currents and capacitances&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vce"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vbe"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vbx"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vbc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="gbe"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="cbe"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="gbc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cbc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="gben"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cben"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="gbcn"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cbcn"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cjbe"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cjbc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dqbdve"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="dqbdvc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="qb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="q1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="q2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="sqarg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="cc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cex"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="gex"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" isOver="true">
            <component_list declarationName="ttime"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="step"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="laststep"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="bcex0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="bcex1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="denom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="rbpr"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="rbpi"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gx"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="xjrb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="go"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list declarationName="captt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="chargebe"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="chargebc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="chargebx"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="argtf"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="exponent"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="temp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="aux1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="aux2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="chargecs"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vcs"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="sarg"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="temp" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vce" expression="in_p.m_type * (in_m_pVoltageValues[4] - in_m_pVoltageValues[6])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vbe" expression="in_p.m_type * (in_m_pVoltageValues[5] - in_m_pVoltageValues[6])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vbx" expression="in_p.m_type * (in_m_pVoltageValues[2] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p3.m_uic)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p3.m_bICvbeIsGiven > 0.5)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="vbe" expression="in_p.m_type * in_p3.m_dICvbe"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p3.m_bICvceIsGiven > 0.5)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="vce" expression="in_p.m_type * in_p3.m_dICvce"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vbx" expression="vbe - vce"/>
              <elseCondition>(Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="(in_p3.m_bOff)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="vbe" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="vce" expression="0.0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="vbx" expression="0.0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vbe" expression="in_c.m_tVcrit"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vce" expression="vbe"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vbx" expression="0.0"/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vbc" expression="vbe - vce"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3BJT" function="( vbe, in_p3.m_dTemp, in_p.m_emissionCoeffF, in_p.m_leakBEemissionCoeff, in_c.m_tSatCur, in_c.m_tBEleakCur )" output="cbe,gbe,cben,gben"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBE" expression="in_p.m_type * cbe / in_c.m_tBetaF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBEN" expression="in_p.m_type * cben"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3BJT" function="( vbc, in_p3.m_dTemp, in_p.m_emissionCoeffR, in_p.m_leakBCemissionCoeff, in_c.m_tSatCur, in_c.m_tBCleakCur )" output="cbc,gbc,cbcn,gbcn"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBC" expression="in_p.m_type * cbc / in_c.m_tBetaR"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBCN" expression="in_p.m_type * cbcn"/>
            <statements xsi:type="mOloc:FunctionStatement" component="cjbe" expression="cbe / in_c.m_tBetaF + cben"/>
            <statements xsi:type="mOloc:FunctionStatement" component="cjbc" expression="cbc / in_c.m_tBetaR + cbcn"/>
            <statements xsi:type="mOloc:FunctionStatement" component="q1" expression="1.0/(1.0 - in_p.m_invEarlyVoltF * vbc - in_p.m_invEarlyVoltR * vbe)"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_invRollOffF == 0 and in_p.m_invRollOffR == 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="qb" expression="q1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dqbdve" expression="q1*qb*in_p.m_invEarlyVoltR"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="dqbdvc" expression="q1*qb*in_p.m_invEarlyVoltF"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="q2" expression="in_p.m_invRollOffF*cbe + in_p.m_invRollOffR*cbc"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="max( 0.0, 1+4*q2)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sqarg" expression="1"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="(arg &lt;> 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="sqarg" expression="sqrt(arg)"/>
              </elseStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qb" expression="q1*(1+sqarg)/2"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dqbdve" expression="q1*(qb*in_p.m_invEarlyVoltR + in_p.m_invRollOffF*gbe/sqarg)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="dqbdvc" expression="q1*(qb*in_p.m_invEarlyVoltF + in_p.m_invRollOffR*gbc/sqarg)"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="cc" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="cex" expression="cbe"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gex" expression="gbe"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ttime" expression="1"/>
            <statements xsi:type="mOloc:IfStatement" condition="((in_p.m_excessPhaseFactor &lt;> 0) and (ttime > 0.0))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="step" expression="0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="laststep" expression="1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="bcex0" expression="0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="bcex1" expression="0"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="( bcex1 == 0.0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="bcex1" expression="cbe / qb"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="bcex0" expression="bcex1"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg1" expression="step / in_p.m_excessPhaseFactor"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg2" expression="3 * arg1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg1" expression="arg2 * arg1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="denom" expression="1 + arg1 + arg2"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg3" expression="arg1 / denom"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cc" expression="(bcex0 * (1 + step / laststep + arg2) - bcex1 * step / laststep ) / denom"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cex" expression="cbe * arg3"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gex" expression="gbe * arg3"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="cc" expression="cc+(cex-cbc)/qb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="rbpr" expression="in_p.m_minBaseResist / in_p3.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="rbpi" expression="in_p.m_baseResist / in_p3.m_area-rbpr"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gx" expression="rbpr + rbpi / qb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="xjrb" expression="in_p.m_baseCurrentHalfResist * in_p3.m_area"/>
            <statements xsi:type="mOloc:IfStatement" condition="(xjrb &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg1" expression="max( (cjbe + cjbc) / xjrb, 1e-9)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg2" expression="(-1 + sqrt( 1 + 14.59025 * arg1)) / 2.4317 / sqrt( arg1)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg1" expression="tan(arg2)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gx" expression="rbpr + 3 * rbpi * (arg1-arg2) / arg2 / arg1 / arg1"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(gx &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gx" expression="1 / gx"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.rx" expression="gx"/>
            <statements xsi:type="mOloc:FunctionStatement" component="go" expression="(gbc+(cex-cbc)*dqbdvc/qb)/qb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gm" expression="(gex-(cex-cbc)*dqbdve/qb)/qb - go"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iCC" expression="in_p.m_type * cc"/>
            <statements xsi:type="mOloc:FunctionStatement" component="captt" expression="0.0"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_transitTimeF &lt;> 0.0 and vbe > 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="argtf" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg2" expression="0.0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg3" expression="0.0"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_transitTimeBiasCoeffF &lt;> 0.0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="argtf" expression="in_p.m_transitTimeBiasCoeffF"/>
                <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_transitTimeVBCFactor &lt;> 0.0)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="exponent" expression="min( 50., vbc * in_p.m_transitTimeVBCFactor)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="argtf" expression="argtf * exp( exponent)"/>
                </ifStatements>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="arg2" expression="argtf"/>
                <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_transitTimeHighCurrentF &lt;> 0)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="temp" expression="cbe / (cbe + in_p.m_transitTimeHighCurrentF)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="argtf" expression="argtf * temp * temp"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="arg2" expression="argtf * (3-temp-temp)"/>
                </ifStatements>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="arg3" expression="cbe * argtf * in_p.m_transitTimeVBCFactor"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cbe" expression="cbe * (1 + argtf) / qb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="gbe" expression="(gbe * (1 + arg2) - cbe * dqbdve) / qb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="captt" expression="in_p.m_transitTimeF * (arg3 - cbe * dqbdvc) / qb"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.captt" expression="captt"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapTransTime" function="( in_c.m_tBEcap, vbe, in_c.m_tDepCapBE, in_p.m_junctionExpBE, in_c.m_tBEpot, in_c.m_tF1e, in_c.m_f2e, in_c.m_f3e, in_p.m_transitTimeF, gbe, cbe )" output="out_cc.capbe,chargebe"/>
            <statements xsi:type="mOloc:FunctionStatement" component="aux1" expression="in_c.m_tBCcap*in_p.m_baseFractionBCcap"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapTransTime" function="( aux1, vbc, in_c.m_tDepCapBC, in_p.m_junctionExpBC, in_c.m_tBCpot, in_c.m_tF1c, in_c.m_f2c, in_c.m_f3c, in_p.m_transitTimeR, gbc, cbc )" output="out_cc.capbc,chargebc"/>
            <statements xsi:type="mOloc:FunctionStatement" component="aux2" expression="in_c.m_tBCcap*(1. - in_p.m_baseFractionBCcap)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( aux2, vbx, in_c.m_tDepCapBC, in_p.m_junctionExpBC, in_c.m_tBCpot, in_c.m_tF1c, in_c.m_f2c, in_c.m_f3c )" output="out_cc.capbx,chargebx"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.capcs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="chargecs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vcs" expression="in_p.m_type * (0- in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vcs &lt; 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="1 - vcs / in_p.m_potentialSubstrate"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="exp(-in_p.m_exponentialSubstrate*Modelica.Math.log( arg) )"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_cc.capcs" expression="in_p3.m_CScap * sarg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="chargecs" expression="in_p.m_potentialSubstrate * in_p3.m_CScap * (1-arg*sarg)/(1-in_p.m_exponentialSubstrate)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_cc.capcs" expression="in_p3.m_CScap * (1 + in_p.m_exponentialSubstrate * vcs / in_p.m_potentialSubstrate)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="chargecs" expression="vcs * in_p3.m_CScap *(1+in_p.m_exponentialSubstrate*vcs/ (2*in_p.m_potentialSubstrate) )"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iXX" expression="1"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" expression="1" elementName="smoothOrder">
              <modifications expression="in_p3" elementName="normallyConstant"/>
            </annotations>
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function bjtNoBypassCode calculates the currents (and the capacitances) that are necessary for the currents to be used in the top-level model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="bjtRenameParameters" description="&quot;Technology parameter renaming&quot;" isLongClassSpecifier="true" classNameEnd="bjtRenameParameters" isOver="true">
