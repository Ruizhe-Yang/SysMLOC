        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.SpiceConstants" parameterType="constant" isOver="true">
          <component_list declarationName="C" description="&quot;General constants of SPICE simulator&quot;"/>
        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:FunctionEquation" component="assert" function="( NRD > 0, &quot;NRD, length of drain in squares, must be greater than zero&quot;)"/>
          <equations xsi:type="mOloc:FunctionEquation" component="assert" function="( NRS > 0, &quot;NRS, length of source in squares, must be greater than zero&quot;)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="cc" right="Spice3.Internal.Mos.mos2CalcNoBypassCodeRevised( m1, m_type, c22, p1, m_bInit, {G.v,B.v,Dinternal,Sinternal} )"/>
          <equations xsi:type="mOloc:SimpleEquation" left="vBD" right="B.v - Dinternal"/>
          <equations xsi:type="mOloc:SimpleEquation" left="vBS" right="B.v - Sinternal"/>
          <equations xsi:type="mOloc:SimpleEquation" left="vGB" right="G.v - B.v"/>
          <equations xsi:type="mOloc:SimpleEquation" left="vGD" right="G.v - Dinternal"/>
          <equations xsi:type="mOloc:SimpleEquation" left="vGS" right="G.v - Sinternal"/>
          <equations xsi:type="mOloc:SimpleEquation" left="ird * c11.m_drainResistance" right="(D.v - Dinternal)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="irs * c11.m_sourceResistance" right="(S.v - Sinternal)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icBD" right="cc.cBD * der(vBD)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icBS" right="cc.cBS * der(vBS)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icGB" right="cc.cGB * der(vGB)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icGD" right="cc.cGD * der(vGD)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icGS" right="cc.cGS * der(vGS)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="ibsgmin" right="Spice3.Internal.SpiceConstants.CKTgmin*(B.v - Sinternal )"/>
          <equations xsi:type="mOloc:SimpleEquation" left="ibdgmin" right="Spice3.Internal.SpiceConstants.CKTgmin*(B.v - Dinternal )"/>
          <equations xsi:type="mOloc:SimpleEquation" left="G.i" right="icGB + icGD + icGS"/>
          <equations xsi:type="mOloc:SimpleEquation" left="B.i" right="cc.iBD + cc.iBS+ ibdgmin + ibsgmin -icGB + icBD + icBS"/>
          <equations xsi:type="mOloc:SimpleEquation" left="D.i" right="ird"/>
          <equations xsi:type="mOloc:SimpleEquation" left="S.i" right="irs"/>
          <equations xsi:type="mOloc:SimpleEquation" left="0" right="-ird + cc.idrain - cc.iBD - ibdgmin - icGD - icBD"/>
          <equations xsi:type="mOloc:SimpleEquation" left="0" right="-irs - cc.idrain - cc.iBS - ibsgmin - icGS - icBS"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>MOSFET model, both N and P channel, LEVEL 2&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>January 2009&lt;/em> by Kristin Majetta &lt;br>initially implemented&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
