          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="ModelcardMOS2" description="&quot;Record with technology parameters (.model)&quot;" isLongClassSpecifier="true" classNameEnd="ModelcardMOS2" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Spice3.Internal.ModelcardMOS" isOver="true">
