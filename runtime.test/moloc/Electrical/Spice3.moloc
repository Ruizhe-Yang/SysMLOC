        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosCalcInitEquations" description="&quot;Mosfet initial precalculations (level 1)&quot;" isLongClassSpecifier="true" classNameEnd="mosCalcInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for MOS1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="in_C" description="&quot;Input record SPICE constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MosModelLineVariables" directionType="input" isOver="true">
            <component_list declarationName="in_vp" description="&quot;Input record model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1Calc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record Mos1 calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_drainResistance" expression="if (in_p.m_drainResistanceIsGiven > 0.5) then in_p.m_drainResistance else in_p.m_sheetResistance * in_m.m_drainSquares"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_sourceResistance" expression="if (in_p.m_sourceResistanceIsGiven > 0.5) then in_p.m_sourceResistance else in_p.m_sheetResistance * in_m.m_sourceSquares"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_lEff" expression="in_m.m_len - 2 * in_p.m_latDiff"/>
            <statements xsi:type="mOloc:IfStatement" condition="( abs( out_c.m_lEff) &lt; 1e-18)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_lEff" expression="1e-6"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGSovl" expression="in_p.m_gateSourceOverlapCapFactor * in_m.m_width"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGDovl" expression="in_p.m_gateDrainOverlapCapFactor * in_m.m_width"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGBovl" expression="in_p.m_gateBulkOverlapCapFactor * out_c.m_lEff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capOx" expression="in_vp.m_oxideCapFactor * out_c.m_lEff * in_m.m_width"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tTransconductance" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSurfMob" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tPhi" expression="0.7"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVto" expression="1."/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCurDens" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDrainSatCur" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSourceSatCur" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCj" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCjsw" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBulkPot" expression="0.7"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDepCap" expression="0.35"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVbi" expression="1."/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBScrit" expression="0.7"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBDcrit" expression="0.7"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f1b" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f2b" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f3b" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f1s" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f2s" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_f3s" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_dVt" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capgb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_qgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_qgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_qgb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vgs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vbs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_cbs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_gbs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_cbd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_gbd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capbsb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_chargebsb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capbss" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_chargebss" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capbdb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_chargebdb" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capbds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_chargebds" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_Beta" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_von" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_mode" expression="1"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mosCalcInitEquations does the initial precalculation of the MOSFET parameters (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosCalcCalcTempDependencies" description="&quot;Precalculation relating to temperature&quot;" isLongClassSpecifier="true" classNameEnd="mosCalcCalcTempDependencies" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for MOS1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="in_C" description="&quot;Input record SPICE constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MosModelLineVariables" directionType="input" isOver="true">
            <component_list declarationName="in_vp" description="&quot;Input record model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1Calc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record Mos1Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1Calc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record with calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="ratio"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="ratio4"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="res"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c" expression="in_c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratio" expression="in_m.m_dTemp / in_p.m_tnom"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratio4" expression="ratio * sqrt(ratio)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tTransconductance" expression="in_vp.m_transconductance / ratio4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_Beta" expression="out_c.m_tTransconductance * in_m.m_width / out_c.m_lEff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSurfMob" expression="in_p.m_surfaceMobility / ratio4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tPhi" expression="Spice3.Internal.Functions.junctionPotDepTemp( in_vp.m_phi, in_m.m_dTemp, in_p.m_tnom )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVbi" expression="in_vp.m_vt0 - in_m_type*(in_vp.m_gamma*sqrt(in_vp.m_phi)) + 0.5*(Spice3.Internal.Functions.energyGapDepTemp_old( in_p.m_tnom) - Spice3.Internal.Functions.energyGapDepTemp_old( in_m.m_dTemp) ) + in_m_type*0.5*(out_c.m_tPhi - in_vp.m_phi)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVto" expression="out_c.m_tVbi + in_m_type * in_vp.m_gamma * sqrt(out_c.m_tPhi)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBulkPot" expression="Spice3.Internal.Functions.junctionPotDepTemp( in_p.m_bulkJctPotential, in_m.m_dTemp, in_p.m_tnom )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDepCap" expression="in_p.m_fwdCapDepCoeff * out_c.m_tBulkPot"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_jctSatCurDensity == 0.0 or in_m.m_sourceArea == 0.0 or in_m.m_drainArea == 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDrainSatCur" expression="Spice3.Internal.Functions.saturationCurDepTempSPICE3MOSFET( in_p.m_jctSatCur, in_m.m_dTemp, in_p.m_tnom )"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSourceSatCur" expression="out_c.m_tDrainSatCur"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBScrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tSourceSatCur )"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBDcrit" expression="out_c.m_VBScrit"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCurDens" expression="Spice3.Internal.Functions.saturationCurDepTempSPICE3MOSFET( in_p.m_jctSatCurDensity, in_m.m_dTemp, in_p.m_tnom )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDrainSatCur" expression="out_c.m_tSatCurDens * in_m.m_drainArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSourceSatCur" expression="out_c.m_tSatCurDens * in_m.m_sourceArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBScrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tSourceSatCur )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBDcrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tDrainSatCur )"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="( not (in_p.m_capBDIsGiven > 0.5) or not (in_p.m_capBSIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_bulkCapFactor, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCj"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_sideWallCapFactor, in_p.m_bulkJctSideGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCjsw"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_bulkJctSideGradingCoeff, in_p.m_fwdCapDepCoeff, out_c.m_tBulkPot )" output="out_c.m_f1s,out_c.m_f2s,out_c.m_f3s"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_capBDIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_capBD, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCBDb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDs" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDb" expression="out_c.m_tCj * in_m.m_drainArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDs" expression="out_c.m_tCjsw * in_m.m_drainPerimeter"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_capBSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_capBS, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCBSb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSs" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSb" expression="out_c.m_tCj * in_m.m_sourceArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSs" expression="out_c.m_tCjsw * in_m.m_sourcePerimeter"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_bulkJctBotGradingCoeff, in_p.m_fwdCapDepCoeff, out_c.m_tBulkPot )" output="out_c.m_f1b,out_c.m_f2b,out_c.m_f3b"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_dVt" expression="in_m.m_dTemp*Spice3.Internal.SpiceConstants.CONSTKoverQ"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mosCalcCalcTempDependencies does precalculation relating to the temperature (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosCalcNoBypassCode" description="&quot;Calculation of currents and capacities (level 1)&quot;" isLongClassSpecifier="true" classNameEnd="mosCalcNoBypassCode" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1Calc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record Mos1Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for MOS1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="in_C" description="&quot;Input record SPICE constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MosModelLineVariables" directionType="input" isOver="true">
            <component_list declarationName="in_vp" description="&quot;Input record model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="in_m_bInit"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[4]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CurrrentsCapacitances" directionType="output" isOver="true">
            <component_list declarationName="out_cc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vbd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cur"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" isOver="true">
            <component_list declarationName="n"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DEVqmeyer" isOver="true">
            <component_list declarationName="qm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos1.Mos1Calc" isOver="true">
            <component_list declarationName="int_c"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="hlp"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="int_c" expression="in_c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.m_capgd" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="in_m_type * (in_m_pVoltageValues[1] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="in_m_type * (in_m_pVoltageValues[2] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="in_m_type * (in_m_pVoltageValues[3] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:IfStatement" condition="(Spice3.Internal.SpiceRoot.useInitialConditions()) and (in_m.m_dICVBSIsGiven > 0.5 )">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="in_m_type * in_m.m_dICVBS"/>
              <elseCondition>( Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="if (in_m.m_off >0.5) then 0. else int_c.m_VBScrit"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(Spice3.Internal.SpiceRoot.useInitialConditions()) and (in_m.m_dICVDSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="in_m_type * in_m.m_dICVDS"/>
              <elseCondition>( Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="if (in_m.m_off > 0.5) then 0. else (int_c.m_VBDcrit - int_c.m_VBScrit)"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(Spice3.Internal.SpiceRoot.useInitialConditions()) and (in_m.m_dICVGSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="in_m_type * in_m.m_dICVGS"/>
              <elseCondition>( Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="( in_m.m_off > 0.5)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="0."/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vbd" expression="int_c.m_vbs - int_c.m_vds"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vgd" expression="int_c.m_vgs - int_c.m_vds"/>
            <statements xsi:type="mOloc:IfStatement" condition="( int_c.m_vds >= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vbd" expression="int_c.m_vbs - int_c.m_vds"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="vbd + int_c.m_vds"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vgb" expression="int_c.m_vgs - int_c.m_vbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3MOSFETRevised" function="( vbd, in_m.m_dTemp, 1.0, int_c.m_tDrainSatCur )" output="int_c.m_cbd,int_c.m_gbd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBD" expression="in_m_type * int_c.m_cbd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3MOSFETRevised" function="( int_c.m_vbs, in_m.m_dTemp, 1.0, int_c.m_tSourceSatCur )" output="int_c.m_cbs,int_c.m_gbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBS" expression="in_m_type * int_c.m_cbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_mode" expression="if (int_c.m_vds >= 0) then 1 else -1"/>
            <statements xsi:type="mOloc:IfStatement" condition="(int_c.m_mode == 1)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c" expression="Spice3.Internal.Mos1.drainCur( int_c.m_vbs, int_c.m_vgs, int_c.m_vds, int_c, in_p, in_C, in_vp, in_m_type )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="int_c" expression="Spice3.Internal.Mos1.drainCur( vbd, vgd, -int_c.m_vds, int_c, in_p, in_C, in_vp, in_m_type )"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="n" expression="if (int_c.m_mode == 1) then 6 else 5"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.idrain" expression="in_m_type * int_c.m_cdrain * int_c.m_mode"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capbss" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_chargebss" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capbds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_chargebds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBSb, int_c.m_vbs, int_c.m_tDepCap, in_p.m_bulkJctBotGradingCoeff, int_c.m_tBulkPot, int_c.m_f1b, int_c.m_f2b, int_c.m_f3b )" output="int_c.m_capbsb,int_c.m_chargebsb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBDb, vbd, int_c.m_tDepCap, in_p.m_bulkJctBotGradingCoeff, int_c.m_tBulkPot, int_c.m_f1b, int_c.m_f2b, int_c.m_f3b )" output="int_c.m_capbdb,int_c.m_chargebdb"/>
            <statements xsi:type="mOloc:IfStatement" condition="( not (in_p.m_capBSIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBSs, int_c.m_vbs, int_c.m_tDepCap, in_p.m_bulkJctSideGradingCoeff, int_c.m_tBulkPot, int_c.m_f1s, int_c.m_f2s, int_c.m_f3s )" output="int_c.m_capbss,int_c.m_chargebss"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_capBDIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBDs, vbd, int_c.m_tDepCap, in_p.m_bulkJctSideGradingCoeff, int_c.m_tBulkPot, int_c.m_f1s, int_c.m_f2s, int_c.m_f3s )" output="int_c.m_capbds,int_c.m_chargebds"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cBS" expression="if (in_m_bInit) then 1e-15 else (int_c.m_capbsb + int_c.m_capbss)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cBD" expression="if (in_m_bInit) then 1e-15 else (int_c.m_capbdb + int_c.m_capbds)"/>
            <statements xsi:type="mOloc:IfStatement" condition="(int_c.m_mode > 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="qm" expression="mosCalcDEVqmeyer( int_c.m_vgs, vgd, vgb, int_c)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm" expression="mosCalcDEVqmeyer( vgd, int_c.m_vgs, vgb, int_c)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="hlp" expression="qm.qm_capgd"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm.qm_capgd" expression="qm.qm_capgs"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm.qm_capgs" expression="hlp"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgd" expression="2 * qm.qm_capgd + int_c.m_capGDovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgs" expression="2 * qm.qm_capgs + int_c.m_capGSovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgb" expression="2 * qm.qm_capgb + int_c.m_capGBovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGB" expression="if (in_m_bInit) then -1e40 else int_c.m_capgb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGD" expression="if (in_m_bInit) then -1e40 else int_c.m_capgd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGS" expression="if (in_m_bInit) then -1e40 else int_c.m_capgs"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mosCalcNoBypassCode calculates the currents (and the capacitances) that are necessary for the currents sum in the toplevelmodel (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mosCalcDEVqmeyer" description="&quot;Calculation of Meyer capacities&quot;" isLongClassSpecifier="true" classNameEnd="mosCalcDEVqmeyer" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgs"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MosCalc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input variable set&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DEVqmeyer" directionType="output" isOver="true">
            <component_list declarationName="out_qm" description="&quot;Qmeyer values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vds"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vddif"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vddif1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.VoltageSquare" isOver="true">
            <component_list declarationName="vddif2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgst"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vgst" expression="vgs - in_c.m_von"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vgst &lt;= -in_c.m_tPhi)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgb" expression="in_c.m_capOx / 2."/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgs" expression="0."/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgd" expression="0."/>
              <elseCondition>(vgst &lt;= -in_c.m_tPhi / 2.)</elseCondition>
              <elseCondition>(vgst &lt;= 0.)</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgb" expression="-vgst * in_c.m_capOx / (2. * in_c.m_tPhi)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgs" expression="0."/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgd" expression="0."/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgb" expression="-vgst * in_c.m_capOx / (2. * in_c.m_tPhi)"/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgs" expression="vgst * in_c.m_capOx / (1.5 * in_c.m_tPhi) + in_c.m_capOx / 3."/>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgd" expression="0."/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="vds" expression="vgs - vgd"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="(in_c.m_vdsat &lt;= vds)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgs" expression="in_c.m_capOx / 3."/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgd" expression="0."/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgb" expression="0."/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vddif" expression="2.0 * in_c.m_vdsat - vds"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vddif1" expression="in_c.m_vdsat - vds"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vddif2" expression="vddif * vddif"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgd" expression="in_c.m_capOx * (1. - in_c.m_vdsat * in_c.m_vdsat / vddif2 ) / 3."/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgs" expression="in_c.m_capOx * (1. - vddif1 * vddif1 / vddif2) / 3."/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_capgb" expression="0."/>
              </elseStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_qgs" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_qgb" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_qgd" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_vgs" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_vgb" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_qm.qm_vgd" expression="0.0"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mosCalcDEVqmeyer calculates the Meyer capacities and charge for the Meyer model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos2CalcInitEquationsRevised" description="&quot;Mosfet initial precalculations (level 2)&quot;" isLongClassSpecifier="true" classNameEnd="mos2CalcInitEquationsRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record Mos2 values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record Mos2 calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_drainResistance" expression="if (in_p.m_drainResistanceIsGiven > 0.5) then in_p.m_drainResistance else in_p.m_sheetResistance * in_m.m_drainSquares"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_sourceResistance" expression="if (in_p.m_sourceResistanceIsGiven > 0.5) then in_p.m_sourceResistance else in_p.m_sheetResistance * in_m.m_sourceSquares"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_lEff" expression="in_m.m_len - 2 * in_p.m_latDiff"/>
            <statements xsi:type="mOloc:IfStatement" condition="( abs( out_c.m_lEff) &lt; 1e-18)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_lEff" expression="1e-6"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGSovl" expression="in_p.m_gateSourceOverlapCapFactor * in_m.m_width"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGDovl" expression="in_p.m_gateDrainOverlapCapFactor * in_m.m_width"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capGBovl" expression="in_p.m_gateBulkOverlapCapFactor * out_c.m_lEff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_capOx" expression="in_p.m_oxideCapFactor * out_c.m_lEff * in_m.m_width"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos2CalcInitEquationsRevised does the initial precalculation of the MOSFET parameters (level 2).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos2CalcCalcTempDependenciesRevised" description="&quot;Precalculation relating to temperature&quot;" isLongClassSpecifier="true" classNameEnd="mos2CalcCalcTempDependenciesRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Output record Mos1 calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record Mos2Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record with calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="ratio"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="ratio4"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="res"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c" expression="in_c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratio" expression="in_m.m_dTemp / in_p.m_tnom"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ratio4" expression="ratio * sqrt(ratio)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tTransconductance" expression="in_p.m_transconductance / ratio4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_Beta" expression="out_c.m_tTransconductance * in_m.m_width / out_c.m_lEff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSurfMob" expression="in_p.m_surfaceMobility / ratio4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tPhi" expression="Spice3.Internal.Functions.junctionPotDepTemp( in_p.m_phi, in_m.m_dTemp, in_p.m_tnom )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVbi" expression="in_p.m_vt0 - in_m_type*(in_p.m_gamma*sqrt(in_p.m_phi)) + 0.5*( Spice3.Internal.Functions.energyGapDepTemp(in_p.m_tnom) - Spice3.Internal.Functions.energyGapDepTemp(in_m.m_dTemp) ) + in_m_type*0.5*( out_c.m_tPhi - in_p.m_phi)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVto" expression="out_c.m_tVbi + in_m_type * in_p.m_gamma * sqrt(out_c.m_tPhi)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBulkPot" expression="Spice3.Internal.Functions.junctionPotDepTemp( in_p.m_bulkJctPotential, in_m.m_dTemp, in_p.m_tnom )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDepCap" expression="in_p.m_fwdCapDepCoeff * out_c.m_tBulkPot"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_jctSatCurDensity == 0.0 or in_m.m_sourceArea == 0.0 or in_m.m_drainArea == 0.0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDrainSatCur" expression="Spice3.Internal.Functions.saturationCurDepTempSPICE3MOSFET( in_p.m_jctSatCur, in_m.m_dTemp, in_p.m_tnom )"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSourceSatCur" expression="out_c.m_tDrainSatCur"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBScrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tSourceSatCur )"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBDcrit" expression="out_c.m_VBScrit"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCurDens" expression="Spice3.Internal.Functions.saturationCurDepTempSPICE3MOSFET( in_p.m_jctSatCurDensity, in_m.m_dTemp, in_p.m_tnom )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tDrainSatCur" expression="out_c.m_tSatCurDens * in_m.m_drainArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSourceSatCur" expression="out_c.m_tSatCurDens * in_m.m_sourceArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBScrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tSourceSatCur )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_VBDcrit" expression="Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, 1.0, out_c.m_tDrainSatCur )"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="( not (in_p.m_capBDIsGiven > 0.5) or not (in_p.m_capBSIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_bulkCapFactor, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCj"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_sideWallCapFactor, in_p.m_bulkJctSideGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCjsw"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_bulkJctSideGradingCoeff, in_p.m_fwdCapDepCoeff, out_c.m_tBulkPot )" output="out_c.m_f1s,out_c.m_f2s,out_c.m_f3s"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_capBDIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_capBD, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCBDb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDs" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDb" expression="out_c.m_tCj * in_m.m_drainArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBDs" expression="out_c.m_tCjsw * in_m.m_drainPerimeter"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_capBSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_bulkJctPotential, in_p.m_capBS, in_p.m_bulkJctBotGradingCoeff, in_m.m_dTemp, in_p.m_tnom )" output="res,out_c.m_tCBSb"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSs" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSb" expression="out_c.m_tCj * in_m.m_sourceArea"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tCBSs" expression="out_c.m_tCjsw * in_m.m_sourcePerimeter"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_bulkJctBotGradingCoeff, in_p.m_fwdCapDepCoeff, out_c.m_tBulkPot )" output="out_c.m_f1b,out_c.m_f2b,out_c.m_f3b"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_dVt" expression="in_m.m_dTemp*Spice3.Internal.SpiceConstants.CONSTKoverQ"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos2CalcCalcTempDependenciesRevised does precalculation relating to the temperature (level 2).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos2CalcNoBypassCodeRevised" description="&quot;Calculation of currents and capacities (level 2)&quot;" isLongClassSpecifier="true" classNameEnd="mos2CalcNoBypassCodeRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record MOSFET parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record Mos2Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="in_m_bInit"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[4]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Mos.CurrrentsCapacitances" directionType="output" isOver="true">
            <component_list declarationName="out_cc" description="&quot;Calculated currents and capacitances&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vbd" description="&quot;Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgd" description="&quot;Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgb" description="&quot;Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Mos.DEVqmeyer" isOver="true">
            <component_list declarationName="qm" description="&quot;Qmeyer capacitances&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" isOver="true">
            <component_list declarationName="int_c" description="&quot;Record Mos2Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="hlp"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="int_c" expression="in_c"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="in_m_type * (in_m_pVoltageValues[1] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="in_m_type * (in_m_pVoltageValues[2] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="in_m_type * (in_m_pVoltageValues[3] - in_m_pVoltageValues[4])"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_m.m_uic and in_m.m_dICVBSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="in_m_type * in_m.m_dICVBS"/>
              <elseCondition>(Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="if (in_m.m_off == 1) then 0. else int_c.m_VBScrit"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_m.m_uic and in_m.m_dICVDSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="in_m_type * in_m.m_dICVDS"/>
              <elseCondition>(Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="if (in_m.m_off == 1) then 0. else (int_c.m_VBDcrit - int_c.m_VBScrit)"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_m.m_uic and in_m.m_dICVGSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="in_m_type * in_m.m_dICVGS"/>
              <elseCondition>(Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="( in_m.m_off == 1)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="0."/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(int_c.m_vds == 0 and int_c.m_vgs == 0 and int_c.m_vbs == 0 and not ( in_m.m_uic) and (in_m.m_off == 0) )">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="-1"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vgs" expression="in_m_type * int_c.m_tVto"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vds" expression="0"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vbd" expression="int_c.m_vbs - int_c.m_vds"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vgd" expression="int_c.m_vgs - int_c.m_vds"/>
            <statements xsi:type="mOloc:IfStatement" condition="( int_c.m_vds >= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="Spice3.Internal.SpiceRoot.limitJunctionVoltageRevised(int_c.m_vbs)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vbd" expression="int_c.m_vbs - int_c.m_vds"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="vbd" expression="Spice3.Internal.SpiceRoot.limitJunctionVoltageRevised(vbd)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="int_c.m_vbs" expression="vbd + int_c.m_vds"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="vgb" expression="int_c.m_vgs - int_c.m_vbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3MOSFETRevised" function="( vbd, in_m.m_dTemp, 1.0, int_c.m_tDrainSatCur )" output="int_c.m_cbd,int_c.m_gbd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBD" expression="in_m_type * int_c.m_cbd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junction2SPICE3MOSFETRevised" function="( int_c.m_vbs, in_m.m_dTemp, 1.0, int_c.m_tSourceSatCur )" output="int_c.m_cbs,int_c.m_gbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iBS" expression="in_m_type * int_c.m_cbs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_mode" expression="if (int_c.m_vds >= 0) then 1 else -1"/>
            <statements xsi:type="mOloc:IfStatement" condition="(int_c.m_mode == 1)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_c" expression="Spice3.Internal.Mos2.drainCurRevised( int_c.m_vbs, int_c.m_vgs, int_c.m_vds, in_m, int_c, in_p, in_m_type )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="int_c" expression="Spice3.Internal.Mos2.drainCurRevised( vbd, vgd, -int_c.m_vds, in_m, int_c, in_p, in_m_type )"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.idrain" expression="in_m_type * int_c.m_cdrain * int_c.m_mode"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capbss" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_chargebss" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capbds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_chargebds" expression="0.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBSb, int_c.m_vbs, int_c.m_tDepCap, in_p.m_bulkJctBotGradingCoeff, int_c.m_tBulkPot, int_c.m_f1b, int_c.m_f2b, int_c.m_f3b )" output="int_c.m_capbsb,int_c.m_chargebsb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBDb, vbd, int_c.m_tDepCap, in_p.m_bulkJctBotGradingCoeff, int_c.m_tBulkPot, int_c.m_f1b, int_c.m_f2b, int_c.m_f3b )" output="int_c.m_capbdb,int_c.m_chargebdb"/>
            <statements xsi:type="mOloc:IfStatement" condition="( not (in_p.m_capBSIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBSs, int_c.m_vbs, int_c.m_tDepCap, in_p.m_bulkJctSideGradingCoeff, int_c.m_tBulkPot, int_c.m_f1s, int_c.m_f2s, int_c.m_f3s )" output="int_c.m_capbss,int_c.m_chargebss"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_capBDIsGiven > 0.5))">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Spice3.Internal.Functions.junctionCapRevised" function="( int_c.m_tCBDs, vbd, int_c.m_tDepCap, in_p.m_bulkJctSideGradingCoeff, int_c.m_tBulkPot, int_c.m_f1s, int_c.m_f2s, int_c.m_f3s )" output="int_c.m_capbds,int_c.m_chargebds"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cBS" expression="if (in_m_bInit) then 1e-15 else (int_c.m_capbsb + int_c.m_capbss)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cBD" expression="if (in_m_bInit) then 1e-15 else (int_c.m_capbdb + int_c.m_capbds)"/>
            <statements xsi:type="mOloc:IfStatement" condition="(int_c.m_mode > 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="qm" expression="Modelica.Electrical.Spice3.Internal.Mos.mosCalcDEVqmeyer( int_c.m_vgs, vgd, vgb, int_c )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm" expression="Modelica.Electrical.Spice3.Internal.Mos.mosCalcDEVqmeyer( vgd, int_c.m_vgs, vgb, int_c )"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="hlp" expression="qm.qm_capgd"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm.qm_capgd" expression="qm.qm_capgs"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="qm.qm_capgs" expression="hlp"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgd" expression="2 * qm.qm_capgd + int_c.m_capGDovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgs" expression="2 * qm.qm_capgs + int_c.m_capGSovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_c.m_capgb" expression="2 * qm.qm_capgb + int_c.m_capGBovl"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGB" expression="if (in_m_bInit) then -1e40 else int_c.m_capgb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGD" expression="if (in_m_bInit) then -1e40 else int_c.m_capgd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.cGS" expression="if (in_m_bInit) then -1e40 else int_c.m_capgs"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos2CalcNoBypassCodeRevised calculates the currents (and the capacitances) that are necessary for the currents sum in the toplevelmodel (level 2).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package Mos contains functions and records with data of the MOSFET models level 1, 2, 3 and 6.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Mos1" description="&quot;Records and functions for MOSFETs level 1&quot;" isLongClassSpecifier="true" classNameEnd="Mos1" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="Mos1ModelLineParams" description="&quot;Record for Mosfet model line parameters (for level 1)&quot;" isLongClassSpecifier="true" classNameEnd="Mos1ModelLineParams" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Mos.MosModelLineParams" isOver="true">
            <extendsModifications isModificationOver="true" elementName="m_lambda">
              <modifications expression="0.0" elementName="start"/>
            </extendsModifications>
            <extendsModifications isModificationOver="true" elementName="m_transconductance">
              <modifications expression="2.0e-5" elementName="start"/>
            </extendsModifications>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This record Mos1ModelLineParams contains the model line parameters that are used for the MOSFET transistors level 1 in SPICE3.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="Mos1Calc" description="&quot;Further MOSFET variables (for level 1)&quot;" isLongClassSpecifier="true" classNameEnd="Mos1Calc" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Mos.MosCalc" isOver="true"/>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This record Mos1Calc contains further MOSFET variables (for level 1) that are needed for the calculations.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos1ModelLineParamsInitEquations" description="&quot;Initial precalculation&quot;" isLongClassSpecifier="true" classNameEnd="mos1ModelLineParamsInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos1ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for MOS1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="in_C" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos.MosModelLineVariables" directionType="output" isOver="true">
            <component_list declarationName="out_v" description="&quot;Output record model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vtnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="fermis"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="fermig"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="wkfng"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="wkfngs"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="egfet1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="vfb"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_oxideCapFactor" expression="in_p.m_oxideCapFactor"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_transconductance" expression="in_p.m_transconductance"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_phi" expression="in_p.m_phi"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_gamma" expression="in_p.m_gamma"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_vt0" expression="in_p.m_vt0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vtnom" expression="in_p.m_tnom*SpiceConstants.CONSTKoverQ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="egfet1" expression="1.16 - (7.02e-4*in_p.m_tnom*in_p.m_tnom)/(in_p.m_tnom + 1108)"/>
            <statements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_oxideThicknessIsGiven > 0.5) or in_p.m_oxideThickness == 0)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_oxideThickness == 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_oxideCapFactor" expression="0"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_oxideCapFactor" expression="3.9 * 8.854214871e-12 / in_p.m_oxideThickness"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="(out_v.m_oxideCapFactor &lt;> 0)">
                <ifStatements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_transconductanceIsGiven > 0.5))">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_transconductance" expression="in_p.m_surfaceMobility * out_v.m_oxideCapFactor * 1e-4"/>
                </ifStatements>
                <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_substrateDopingIsGiven > 0.5)">
                  <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_substrateDoping * 1e6 > 1.45e16)">
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_phiIsGiven > 0.5))">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_phi" expression="2*vtnom*Modelica.Math.log(in_p.m_substrateDoping*1e6/1.45e16)"/>
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_phi" expression="max(0.1, out_v.m_phi)"/>
                    </ifStatements>
                    <ifStatements xsi:type="mOloc:FunctionStatement" component="fermis" expression="in_m_type *0.5 * out_v.m_phi"/>
                    <ifStatements xsi:type="mOloc:FunctionStatement" component="wkfng" expression="3.2"/>
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_gateType &lt;> 0)">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="fermig" expression="in_m_type * in_p.m_gateType *0.5 * egfet1"/>
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="wkfng" expression="3.25 +0.5 * egfet1 - fermig"/>
                    </ifStatements>
                    <ifStatements xsi:type="mOloc:FunctionStatement" component="wkfngs" expression="wkfng - (3.25 +0.5 * egfet1 + fermis )"/>
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_gammaIsGiven > 0.5))">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_gamma" expression="sqrt(2 * 11.70 * 8.854214871e-12 * SpiceConstants.CHARGE * in_p.m_substrateDoping * 1e6 / out_v.m_oxideCapFactor )"/>
                    </ifStatements>
                    <ifStatements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_vtOIsGiven > 0.5))">
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="vfb" expression="wkfngs - in_p.m_surfaceStateDensity * 1e4 * SpiceConstants.CHARGE / out_v.m_oxideCapFactor"/>
                      <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_vt0" expression="vfb + in_m_type * (out_v.m_gamma * sqrt(out_v.m_phi) + out_v.m_phi)"/>
                    </ifStatements>
                  </ifStatements>
                </ifStatements>
              </elseStatements>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos1ModelLineParamsInitEquation does the initial precalculation of the MOSFET model line parameters for level 1.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="drainCur" description="&quot;Drain current calculation&quot;" isLongClassSpecifier="true" classNameEnd="drainCur" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vds"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos1Calc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record Mos1Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos1ModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for MOS1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="in_C" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos.MosModelLineVariables" directionType="input" isOver="true">
            <component_list declarationName="in_vp" description="&quot;Input record model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of Mos transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos1Calc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record Mos1Calc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="betap"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="sarg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgst"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_c" expression="in_c"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vb &lt;= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="sqrt( out_c.m_tPhi - vb)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="sqrt( out_c.m_tPhi)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="sarg - vb / (sarg + sarg)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="max( 0., sarg)"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_von" expression="(out_c.m_tVbi * in_m_type) + in_vp.m_gamma * sarg"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vgst" expression="vg - out_c.m_von"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_vdsat" expression="max( vgst, 0.)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="arg" expression="if (sarg &lt;= 0) then 0 else in_vp.m_gamma / (sarg + sarg)"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vgst &lt;= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="0"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="betap" expression="out_c.m_Beta*(1 + in_p.m_lambda*vds)"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="(vgst &lt;= vds)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="betap * vgst * vgst * 0.5"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="betap * vgst"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="in_p.m_lambda * out_c.m_Beta * vgst * vgst * 0.5"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="out_c.m_gm * arg"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_cdrain" expression="betap * vds * (vgst - 0.5 * vds)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gm" expression="betap * vds"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gds" expression="betap * (vgst - vds) + in_p.m_lambda * out_c.m_Beta * vds * (vgst - 0.5 * vds )"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_gmbs" expression="out_c.m_gm * arg"/>
              </elseStatements>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function drainCur calculates the main currents that flows from drain node to source node (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos1RenameParameters" description="&quot;Parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="mos1RenameParameters" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardMOS" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="con" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mos.MosModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_cgboIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_cgdoIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_cgsoIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_mjswIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_pbIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_surfaceStateDensityIsGiven" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_oxideCapFactor" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_vtOIsGiven" expression="if (ex.VTO > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_vt0" expression="if (ex.VTO > -1e40) then ex.VTO else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBDIsGiven" expression="if (ex.CBD > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBD" expression="if (ex.CBD > -1e40) then ex.CBD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBSIsGiven" expression="if (ex.CBS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capBS" expression="if (ex.CBS > -1e40) then ex.CBS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkCapFactorIsGiven" expression="if (ex.CJ > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bulkCapFactor" expression="if (ex.CJ > -1e40) then ex.CJ else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;F/m zero-bias junction sidewall cap. per meter of junction perimeter (default 0)&quot;" component="intern.m_sideWallCapFactor" expression="ex.CJSW"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Coefficient for forward-bias depletion capacitance formula (default 0.5)&quot;" component="intern.m_fwdCapDepCoeff" expression="ex.FC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_phiIsGiven" expression="if (ex.PHI > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_phi" expression="if (ex.PHI > -1e40) then ex.PHI else 0.6"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gammaIsGiven" expression="if (ex.GAMMA > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gamma" expression="if (ex.GAMMA > -1e40) then ex.GAMMA else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;1/V channel-length modulation (default 0)&quot;" component="intern.m_lambda" expression="ex.LAMBDA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_substrateDopingIsGiven" expression="if (ex.NSUB > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_substrateDoping" expression="if (ex.NSUB > -1e40) then ex.NSUB else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Type of gate material: +1 opp. to substrate, -1 same as substrate, 0 Al gate (default 1)&quot;" component="intern.m_gateType" expression="ex.TPG"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;IN 1/(cm*cm) surface state density (default 0)&quot;" component="intern.m_surfaceStateDensity" expression="ex.NSS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;In (cm*cm)/(Vs) surface mobility (default 600)&quot;" component="intern.m_surfaceMobility" expression="ex.UO"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;In m lateral diffusion (default 0)&quot;" component="intern.m_latDiff" expression="ex.LD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;A bulk junction saturation current (default 1e-14)&quot;" component="intern.m_jctSatCur" expression="ex.IS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainResistanceIsGiven" expression="if (ex.RD > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainResistance" expression="if (ex.RD > -1e40) then ex.RD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceResistanceIsGiven" expression="if (ex.RS > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceResistance" expression="if (ex.RS > -1e40) then ex.RS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transconductanceIsGiven" expression="if (ex.KP > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transconductance" expression="if (ex.KP > -1e40) then ex.KP else 2e-5"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Parameter measurement temperature (default 27 deg C)&quot;" component="intern.m_tnom" expression="if (ex.TNOM > -1e40) then ex.TNOM + SpiceConstants.CONSTCtoK else 300.15"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;A/(m*m) bulk junction saturation current per sq-meter of junction area (default 0)&quot;" component="intern.m_jctSatCurDensity" expression="ex.JS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Ohm drain and source diffusion sheet resistance (default 0)&quot;" component="intern.m_sheetResistance" expression="ex.RSH"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;V bulk junction potential (default 0.8)&quot;" component="intern.m_bulkJctPotential" expression="ex.PB"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Bulk junction bottom grading coeff. (default 0.5)&quot;" component="intern.m_bulkJctBotGradingCoeff" expression="ex.MJ"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Bulk junction sidewall grading coeff. (default 0.5)&quot;" component="intern.m_bulkJctSideGradingCoeff" expression="ex.MJSW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_oxideThicknessIsGiven" expression="if (ex.TOX > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_oxideThickness" expression="if (ex.TOX > -1e40) then ex.TOX else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;F/m gate-source overlap capacitance per meter channel width (default 0)&quot;" component="intern.m_gateSourceOverlapCapFactor" expression="ex.CGSO"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;F/m gate-drain overlap capacitance per meter channel width (default 0)&quot;" component="intern.m_gateDrainOverlapCapFactor" expression="ex.CGDO"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;F/m gate-bulk overlap capacitance per meter channel width (default 0)&quot;" component="intern.m_gateBulkOverlapCapFactor" expression="ex.CGBO"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Flicker-noise coefficient (default 0)&quot;" component="intern.m_fNcoef" expression="ex.KF"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Flicker-noise exponent (default 1)&quot;" component="intern.m_fNexp" expression="ex.AF"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos1RenameParameters assigns the external (given by the user, e.g., RD) technology parameters&#xA;to the internal parameters (e.g., m_drainResistance). It also does the analysis of the IsGiven values (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="mos1RenameParametersDev" description="&quot;Device parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="mos1RenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardMOS" directionType="input" isOver="true">
            <component_list declarationName="ex"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="mtype"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="W" description="&quot;Channel Width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="L" description="&quot;Channel Length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" directionType="input" isOver="true">
            <component_list declarationName="AD" description="&quot;Area of the drain diffusion&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" directionType="input" isOver="true">
            <component_list declarationName="AS" description="&quot;Area of the source diffusion&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="PD" description="&quot;Perimeter of the drain junction&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="PS" description="&quot;Perimeter of the source junction&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="NRD" description="&quot;Number of squares of the drain diffusions&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="NRS" description="&quot;Number of squares of the source diffusions&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="OFF" description="&quot;Optional initial condition: 0 - IC not used, 1 - IC used, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="IC" description="&quot;Initial condition values, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Mosfet.Mosfet" directionType="output" isOver="true">
            <component_list declarationName="dev" description="&quot;Output record Mosfet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;L, length of channel region&quot;" component="dev.m_len" expression="L"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;W, width of channel region&quot;" component="dev.m_width" expression="W"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;AD, area of drain diffusion&quot;" component="dev.m_drainArea" expression="AD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;AS, area of source diffusion&quot;" component="dev.m_sourceArea" expression="AS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;NRD, length of drain in squares&quot;" component="dev.m_drainSquares" expression="NRD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;NRS, length of source in squares&quot;" component="dev.m_sourceSquares" expression="NRS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;PD, Drain perimeter&quot;" component="dev.m_drainPerimeter" expression="PD"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;PS, Source perimeter&quot;" component="dev.m_sourcePerimeter" expression="PS"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;ICVDS IsGivenValue&quot;" component="dev.m_dICVDSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VDS&quot;" component="dev.m_dICVDS" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;ICVGS IsGivenValue&quot;" component="dev.m_dICVGSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VGS&quot;" component="dev.m_dICVGS" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;ICVBS IsGivenValue&quot;" component="dev.m_dICVBSIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Initial condition of VBS&quot;" component="dev.m_dICVBS" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Non-zero to indicate device is off for dc analysis&quot;" component="dev.m_off" expression="OFF"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;P type MOSFET model&quot;" component="dev.m_bPMOS" expression="mtype"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Level&quot;" component="dev.m_nLevel" expression="ex.LEVEL"/>
            <statements xsi:type="mOloc:FunctionStatement" component="assert" function="(ex.LEVEL== 1, &quot;only MOS Level1 implemented&quot;)"/>
            <statements xsi:type="mOloc:FunctionStatement" description="&quot;Device temperature&quot;" component="dev.m_dTemp" expression="TEMP + SpiceConstants.CONSTCtoK"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_uic" expression="false"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function mos1RenameParametersDev assigns the external (given by the user) device parameters to the internal parameters. It also does the analysis of the IsGiven values (level 1).&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package Mos1 contains functions and record with data of the MOSFET model level 1.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Mos2" description="&quot;Records and functions for MOSFETs level 2&quot;" isLongClassSpecifier="true" classNameEnd="Mos2" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="Mos2ModelLineParams" description="&quot;Record for Mosfet model line parameters (for level 2)&quot;" isLongClassSpecifier="true" classNameEnd="Mos2ModelLineParams" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Spice3.Internal.Mos.MosModelLineParams" isOver="true">
            <extendsModifications isModificationOver="true" elementName="m_lambda">
              <modifications expression="0.0" elementName="start"/>
