      <elements xsi:type="mOloc:GeneralClause" classType="model" className="J_PJFJFET" description="&quot;P-channel Junction Field-Effect Transistor model (JFET)&quot;" isLongClassSpecifier="true" classNameEnd="J_PJFJFET" isOver="true">
