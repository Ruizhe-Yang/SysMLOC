            </modifications>
            <modifications expression="{ Line(points={{0,92},{0,40},{-12,40},{-12,-40},{0,-40},{0,-94}}, color={0,0,255} ) , Line(points={{-92,0},{-20,0}}, color={0,0,255}), Line(points={{-20,40},{-20,-40}}, color={0,0,255}), Text( extent={{8,-34},{96,-54}}, textColor={0,0,255}, textString=&quot;%name&quot; ) }" elementName="graphics"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="ModelcardJFET" description="&quot;Record with technology parameters (.model)&quot;" isLongClassSpecifier="true" classNameEnd="ModelcardJFET" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="CGS" description="&quot;Zero-bias G-S junction capacitance, default 0&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="CGD" description="&quot;Zero-bias G-D junction capacitance, default 0&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
          <component_list expression="1e-14" declarationName="IS" description="&quot;Saturation current of pn junctions&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0.5" declarationName="FC" description="&quot;Coefficient for forward-bias depletion capacitance formula&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="RD" description="&quot;Drain ohmic resistance, default 0&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="RS" description="&quot;Source ohmic resistance, default 0&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="27" declarationName="TNOM" description="&quot;Parameter measurement temperature&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="VTO" description="&quot;Zero-bias threshold voltage, default -2&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.InversePotential" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="B" description="&quot;Dotierungsverlauf parameter, default 1&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="BETA" description="&quot;Output admittance parameter, default 1e-4&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.InversePotential" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="LAMBDA" description="&quot;Channel-length modulation, default 0&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="1.0" declarationName="PB" description="&quot;Junction potential of pn junctions&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="1.0" declarationName="AF" description="&quot;Flicker noise exponent&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="KF" description="&quot;Flicker noise coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Modelcard parameters for JFET model, both N and P channel&lt;/p>&#xA;&lt;p>The package Internal is not for user access. There all function, records and data are stored, that are needed for modeling the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="model" className="DIODE" description="&quot;Diode model&quot;" isLongClassSpecifier="true" classNameEnd="DIODE" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.TwoPin" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="1" declarationName="AREA" description="&quot;Area factor&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list expression="false" declarationName="OFF" description="&quot;Optional initial condition: false - IC not used, true - IC used, not implemented yet&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" declarationName="IC" description="&quot;Initial condition value (VD, not implemented yet&quot;">
            <modifications expression="-1e40" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="27" declarationName="TEMP" description="&quot;Operating temperature of the device&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" declarationName="SENS_AREA" description="&quot;Flag to request sensitivity WRT area, not implemented yet&quot;">
            <modifications expression="false" elementName="start"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardDIODE" parameterType="parameter" isOver="true">
          <component_list declarationName="modelcarddiode" description="&quot;DIODE modelcard&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" parameterType="constant" isOver="true">
          <component_list declarationName="C" description="&quot;General constants of SPICE simulator&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Diode.DiodeModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Diode.diodeRenameParameters(modelcarddiode, C)" declarationName="param" description="&quot;Model line parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Diode.DiodeParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Diode.diodeRenameParametersDev( TEMP, AREA, IC, OFF, SENS_AREA )" declarationName="dp" description="&quot;Renamed parameters&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Model.Model" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Diode.diodeRenameParametersDevTemp(TEMP)" declarationName="m" description="&quot;Renamed parameters&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Diode.DiodeVariables" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Diode.diodeInitEquations(param)" declarationName="c1" description="&quot;Precalculated values&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Diode.DiodeCalc" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Diode.diodeCalcTempDependencies( param, dp, m, c1 )" declarationName="c2" description="&quot;Precalculated values&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="constant" isOver="true">
          <component_list expression="false" declarationName="m_mbInit"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Diode.CurrentsCapacitances" isOver="true">
          <component_list declarationName="cc"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
          <component_list declarationName="icap"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
          <component_list declarationName="m_dCap"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
          <component_list declarationName="pin"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
          <component_list declarationName="ir"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
          <component_list declarationName="igmin"/>
        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:SimpleEquation" left="(cc,m_dCap)" right="Diode.diodeNoBypassCode( param, dp, c2, m, m_mbInit, {pin,n.v} )"/>
          <equations xsi:type="mOloc:SimpleEquation" left="icap" right="if (m_mbInit) then 0.0 else m_dCap*(der(pin)-der(n.v))"/>
          <equations xsi:type="mOloc:SimpleEquation" left="ir*param.m_resist" right="(p.v - pin)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="igmin" right="SpiceConstants.CKTgmin*(pin - n.v)"/>
          <equations xsi:type="mOloc:SimpleEquation" left="p.i" right="ir"/>
          <equations xsi:type="mOloc:SimpleEquation" left="n.i" right="-(cc.m_dCurrent +igmin) -icap"/>
          <equations xsi:type="mOloc:SimpleEquation" left="0" right="-ir + cc.m_dCurrent + igmin +icap"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
            <modifications expression="{ Line(points={{90,0},{-90,0}}, color={0,0,255}), Polygon( points={{30,0},{-30,40},{-30,-40},{30,0}}, lineColor={0,0,255}, fillColor={255,255,255}, fillPattern=FillPattern.Solid ) , Line(points={{-90,0},{40,0}}, color={0,0,255}), Line(points={{40,0},{90,0}}, color={0,0,255}), Line(points={{30,40},{30,-40}}, color={0,0,255}), Text( extent={{-154,100},{146,60}}, textString=&quot;%name&quot;, textColor={0,0,255} ) }" elementName="graphics"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>DIODE model&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            <modifications expression="&quot;&lt;html>&#xA;&lt;ul>&#xA;&lt;li>&lt;em>Nov. 2008&lt;/em> by Kristin Majetta &lt;br>initially implemented&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/html>&quot;" elementName="revisions"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="ModelcardDIODE" description="&quot;Record with technology parameters (.model)&quot;" isLongClassSpecifier="true" classNameEnd="ModelcardDIODE" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
          <component_list expression="1e-14" declarationName="IS" description="&quot;Saturation Current&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="RS" description="&quot;Ohmic resistance&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="1.0" declarationName="N" description="&quot;Emission coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="TT" description="&quot;Transit time&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="CJO" description="&quot;Junction capacitance&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="1.0" declarationName="VJ" description="&quot;Junction Potential&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0.5" declarationName="M" description="&quot;Grading coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.ActivationEnergy" parameterType="parameter" isOver="true">
          <component_list expression="1.11" declarationName="EG" description="&quot;Activation Energy&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="3.0" declarationName="XTI" description="&quot;Saturation current temperature exponent&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0.5" declarationName="FC" description="&quot;Forward bias junction fit parameter&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="BV" description="&quot;Reverse breakdown voltage, default infinity&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="parameter" isOver="true">
          <component_list expression="1e-3" declarationName="IBV" description="&quot;Current at reverse breakdown voltage&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="27" declarationName="TNOM" description="&quot;Parameter measurement temperature&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="KF" description="&quot;Flicker noise coefficient&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="1.0" declarationName="AF" description="&quot;Flicker noise exponent&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="G" description="&quot;Ohmic conductance&quot;"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Modelcard parameters for DIODE model&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="model" className="R_SEMI" description="&quot;Semiconductor resistor&quot;" isLongClassSpecifier="true" classNameEnd="R_SEMI" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.OnePort" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="R" description="&quot;Resistance, if specified, geometrical information is overwritten&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="TEMP" description="&quot;Temperature of resistor&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="L" description="&quot;Length of the resistor&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="W" description="&quot;Width of the resistor, default DEFW (modelcard)&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list expression="false" declarationName="SENS_AREA" description="&quot;Parameter for sensitivity analyses, not implemented yet&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardR" parameterType="parameter" isOver="true">
          <component_list declarationName="modelcard" description="&quot;Resistor modelcard&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" parameterType="constant" isOver="true">
          <component_list declarationName="C" description="&quot;General constants of SPICE simulator&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Rsemiconductor.ResistorModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Rsemiconductor.resistorRenameParameters(modelcard, C)" declarationName="lp" description="&quot;Model Line Parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Rsemiconductor.ResistorParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Rsemiconductor.resistorRenameParametersDev( R, W, L, TEMP, SENS_AREA, C )" declarationName="rp" description="&quot;Renamed parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Rsemiconductor.ResistorVariables" isOver="true">
          <component_list declarationName="vp"/>
        </elements>
        <elements xsi:type="mOloc:AlgorithmSection">
          <statements xsi:type="mOloc:FunctionStatement" component="vp" expression="Rsemiconductor.resistorInitEquations(rp, lp)"/>
          <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.resDepTemp" function="( vp.m_dResist, rp.m_dTemp, lp.m_dTnom, lp.m_dTC1, lp.m_dTC2 )" output="vp.m_dConduct,vp.m_dCond_dTemp"/>
          <statements xsi:type="mOloc:FunctionStatement" component="i" expression="vp.m_dConduct*v"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
