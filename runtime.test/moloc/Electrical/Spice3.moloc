      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Jfet" description="&quot;Records and functions for Jfet&quot;" isLongClassSpecifier="true" classNameEnd="Jfet" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="JfetModelLine" description="&quot;Record for Jfet model line parameters&quot;" isLongClassSpecifier="true" classNameEnd="JfetModelLine" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.FetModelLine" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.InversePotential" isOver="true">
            <component_list declarationName="m_bFac"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="jfetInitEquations" description="&quot;FET initial precalculations&quot;" isLongClassSpecifier="true" classNameEnd="jfetInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="input" isOver="true">
            <component_list declarationName="in_f"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="input" isOver="true">
            <component_list declarationName="in_fm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="output" isOver="true">
            <component_list declarationName="out_fm"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm" expression="in_fm"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm.m_beta" expression="in_fm.m_beta * in_f.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm.m_drainConduct" expression="in_fm.m_drainConduct * in_f.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm.m_sourceConduct" expression="in_fm.m_sourceConduct * in_f.m_area"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm.m_gateSatCurrent" expression="in_fm.m_gateSatCurrent * in_f.m_area"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="jfetModelLineInitEquations" description="&quot;Initial precalculation&quot;" isLongClassSpecifier="true" classNameEnd="jfetModelLineInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="input" isOver="true">
            <component_list declarationName="in_fm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="output" isOver="true">
            <component_list declarationName="out_fm"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm" expression="in_fm"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_fm.m_drainResist &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_fm.m_drainConduct" expression="1 / in_fm.m_drainResist"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_fm.m_sourceResist &lt;> 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_fm.m_sourceConduct" expression="1 / in_fm.m_sourceResist"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(out_fm.m_depletionCapCoeff > 0.95)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_fm.m_depletionCapCoeff" expression="0.95"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_fm.m_bFac" expression="(1 - out_fm.m_b) / (out_fm.m_gatePotential - out_fm.m_threshold)"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="drainCur" description="&quot;Drain current calculation&quot;" isLongClassSpecifier="true" classNameEnd="drainCur" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vds"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgs"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="input" isOver="true">
            <component_list declarationName="in_f"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="input" isOver="true">
            <component_list declarationName="in_fm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="output" isOver="true">
            <component_list declarationName="out_f"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vto"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgst"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="betap"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="Bfac"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="apart"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="cpart"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vgdt"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_f" expression="in_f"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vto" expression="in_fm.m_threshold"/>
            <statements xsi:type="mOloc:IfStatement" condition="(vds >= 0)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vgst" expression="vgs - vto"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(vgst &lt;= 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="betap" expression="in_fm.m_beta*(1 + in_fm.m_lModulation*vds)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="Bfac" expression="in_fm.m_bFac"/>
                <elseStatements xsi:type="mOloc:IfStatement" condition="(vgst >= vds)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="apart" expression="2*in_fm.m_b + 3*Bfac*(vgst - vds)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="cpart" expression="vds*(vds*(Bfac*vds - in_fm.m_b)+vgst*apart)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="betap*cpart"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="betap*vds*(apart + 3*Bfac*vgst)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="betap*(vgst - vds)*apart + in_fm.m_beta*in_fm.m_lModulation*cpart"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="Bfac" expression="vgst*Bfac"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="betap*vgst*(2*in_fm.m_b+3*Bfac)"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="cpart" expression="vgst*vgst*(in_fm.m_b+Bfac)"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="betap*cpart"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="in_fm.m_lModulation*in_fm.m_beta*cpart"/>
                </elseStatements>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="vgdt" expression="vgd - vto"/>
              <elseStatements xsi:type="mOloc:IfStatement" condition="(vgdt &lt;= 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="betap" expression="in_fm.m_beta*(1 - in_fm.m_lModulation*vds)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="Bfac" expression="in_fm.m_bFac"/>
                <elseStatements xsi:type="mOloc:IfStatement" condition="(vgdt + vds >= 0)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="apart" expression="2*in_fm.m_b + 3*Bfac*(vgdt + vds)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="cpart" expression="vds*(-vds*(-Bfac*vds-in_fm.m_b)+vgdt*apart)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="betap*cpart"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="betap*vds*(apart + 3*Bfac*vgdt)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="betap*(vgdt + vds)*apart - in_fm.m_beta*in_fm.m_lModulation*cpart - out_f.m_gm"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="Bfac" expression="vgdt*Bfac"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gm" expression="-betap*vgdt*(2*in_fm.m_b+3*Bfac)"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="cpart" expression="vgdt*vgdt*(in_fm.m_b+Bfac)"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_cdrain" expression="- betap*cpart"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="out_f.m_gds" expression="in_fm.m_lModulation*in_fm.m_beta*cpart - out_f.m_gm"/>
                </elseStatements>
              </elseStatements>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="calculateGateCap" description="&quot;Gate capacitance calculation&quot;" isLongClassSpecifier="true" classNameEnd="calculateGateCap" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="input" isOver="true">
            <component_list declarationName="in_f"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgs" description="&quot;Input voltage gate source&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vgd" description="&quot;Input voltage gate drain&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="capgs" description="&quot;Output capacitance gate source&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" directionType="output" isOver="true">
            <component_list declarationName="chargegs" description="&quot;Output charge gate source&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="capgd" description="&quot;Output capacitance gate drain&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" directionType="output" isOver="true">
            <component_list declarationName="chargegd" description="&quot;Output charge gate drain&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionCapRevised" function="( in_f.m_tCGS, vgs, in_f.m_corDepCap, 0.5, in_f.m_tGatePot, in_f.m_f1, in_f.m_f2, in_f.m_f3 )" output="capgs,chargegs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionCapRevised" function="( in_f.m_tCGD, vgd, in_f.m_corDepCap, 0.5, in_f.m_tGatePot, in_f.m_f1, in_f.m_f2, in_f.m_f3 )" output="capgd,chargegd"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="jfetCalcTempDependencies" description="&quot;Precalculations relating to temperature&quot;" isLongClassSpecifier="true" classNameEnd="jfetCalcTempDependencies" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="input" isOver="true">
            <component_list declarationName="in_f"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="input" isOver="true">
            <component_list declarationName="in_fm"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="output" isOver="true">
            <component_list declarationName="out_f"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_f" expression="in_f"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_fm.m_gatePotential, in_fm.m_capGS, 0.5, out_f.m_dTemp, in_fm.m_tnom )" output="out_f.m_tGatePot,out_f.m_tCGS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_tCGS" expression="out_f.m_area * out_f.m_tCGS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_fm.m_gatePotential, in_fm.m_capGD, 0.5, out_f.m_dTemp, in_fm.m_tnom )" output="out_f.m_tGatePot,out_f.m_tCGD"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_tCGD" expression="out_f.m_area * out_f.m_tCGD"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionCapCoeffs" function="( 0.5, in_fm.m_depletionCapCoeff, out_f.m_tGatePot )" output="out_f.m_f1,out_f.m_f2,out_f.m_f3"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_tSatCur" expression="Modelica.Electrical.Spice3.Internal.Functions.saturationCurDepTempSPICE3JFET( in_fm.m_gateSatCurrent, out_f.m_dTemp, in_fm.m_tnom )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_vcrit" expression="Modelica.Electrical.Spice3.Internal.Functions.junctionVCrit( out_f.m_dTemp, 1.0, out_f.m_tSatCur )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_dVt" expression="out_f.m_dTemp*Modelica.Electrical.Spice3.Internal.SpiceConstants.CONSTKoverQ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_f.m_corDepCap" expression="in_fm.m_depletionCapCoeff * out_f.m_tGatePot"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="jfetNoBypassCode" description="&quot;Calculations of currents and capacities&quot;" isLongClassSpecifier="true" classNameEnd="jfetNoBypassCode" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" directionType="input" isOver="true">
            <component_list declarationName="in_f" description="&quot;Input record fet parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="input" isOver="true">
            <component_list declarationName="in_fm" description="&quot;Input record model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" directionType="input" isOver="true">
            <component_list declarationName="in_m_type" description="&quot;Type of MOS transistor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="in_m_bInit"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[3]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.CurrrentsCapacitances" directionType="output" isOver="true">
            <component_list declarationName="out_cc" description="&quot;Calculated currents and capacitances&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Fet.Fet" isProtected="true" isOver="true">
            <component_list declarationName="int_f" description="&quot;Record Fet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="int_f" expression="in_f"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgd" expression="in_m_type * (in_m_pVoltageValues[1] - in_m_pVoltageValues[2])"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgs" expression="in_m_type * (in_m_pVoltageValues[1] - in_m_pVoltageValues[3])"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_f.m_uic and int_f.m_bICVGSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgs" expression="in_m_type * int_f.m_dICVGS"/>
              <elseCondition>(Modelica.Electrical.Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="(int_f.m_off == true)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgs" expression="0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgs" expression="int_f.m_vcrit"/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_f.m_uic and int_f.m_bICVDSIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgd" expression="in_m_type * int_f.m_dICVDS + int_f.m_vgs"/>
              <elseCondition>(Modelica.Electrical.Spice3.Internal.SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="(int_f.m_off == true)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgd" expression="0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgd" expression="int_f.m_vcrit"/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgs" expression="Modelica.Electrical.Spice3.Internal.SpiceRoot.limitJunctionVoltageRevised(int_f.m_vgs)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f.m_vgd" expression="Modelica.Electrical.Spice3.Internal.SpiceRoot.limitJunctionVoltageRevised(int_f.m_vgd)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f.m_vds" expression="int_f.m_vgs - int_f.m_vgd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junction2" function="( int_f.m_vgd, int_f.m_dTemp, 1.0, int_f.m_tSatCur )" output="int_f.m_cgd,int_f.m_ggd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iGD" expression="in_m_type * int_f.m_cgd"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junction2" function="( int_f.m_vgs, int_f.m_dTemp, 1.0, int_f.m_tSatCur )" output="int_f.m_cgs,int_f.m_ggs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.iGS" expression="in_m_type * int_f.m_cgs"/>
            <statements xsi:type="mOloc:FunctionStatement" component="int_f" expression="drainCur( int_f.m_vds, int_f.m_vgs, int_f.m_vgd, int_f, in_fm )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_cc.idrain" expression="in_m_type * int_f.m_cdrain"/>
            <statements xsi:type="mOloc:IfStatement" condition="(not in_m_bInit)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="calculateGateCap" function="( int_f, int_f.m_vgs, int_f.m_vgd )" output="int_f.m_capgs,int_f.m_chargegs,int_f.m_capgd,int_f.m_chargegd"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_cc.cGD" expression="if (in_m_bInit) then -1e40 else int_f.m_capgd"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_cc.cGS" expression="if (in_m_bInit) then -1e40 else int_f.m_capgs"/>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="jfetRenameParameters" description="&quot;Parameter renaming to internal names&quot;" isLongClassSpecifier="true" classNameEnd="jfetRenameParameters" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.ModelcardJFET" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="JfetModelLine" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainConduct" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceConduct" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bFac" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capGS" expression="if ( ex.CGS > -1e40) then ex.CGS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_capGD" expression="if ( ex.CGD > -1e40) then ex.CGD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gateSatCurrent" expression="ex.IS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_depletionCapCoeff" expression="ex.FC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_drainResist" expression="if ( ex.RD > -1e40) then ex.RD else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_sourceResist" expression="if ( ex.RS > -1e40) then ex.RS else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_tnom" expression="ex.TNOM + Modelica.Electrical.Spice3.Internal.SpiceConstants.CONSTCtoK"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_threshold" expression="if ( ex.VTO > -1e40) then ex.VTO else -2.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_b" expression="if ( ex.B > -1e40) then ex.B else 1.0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_beta" expression="if ( ex.BETA > -1e40) then ex.BETA else 1e-4"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_lModulation" expression="ex.LAMBDA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gatePotential" expression="ex.PB"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fNexp" expression="ex.AF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fNcoef" expression="ex.KF"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function jfetRenameParameters assigns the external (given by the user, e.g. RD) technology parameters&#xA;to the internal parameters (e.g. m_drainResistance). It also does the analysis of the IsGiven values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Csemiconductor" isLongClassSpecifier="true" classNameEnd="Csemiconductor" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="Capacitor" isLongClassSpecifier="true" classNameEnd="Capacitor" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.Model.Model" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" isOver="true">
            <component_list isModificationOver="true" declarationName="m_dCapac" description="&quot;Device is a Capacitor model&quot;">
              <modifications expression="1e-9" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="m_dCapIsGiven" description="&quot;Capacitor is given value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list isModificationOver="true" declarationName="m_dWidth" description="&quot;Width&quot;">
              <modifications expression="0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list isModificationOver="true" declarationName="m_dLength" description="&quot;Length&quot;">
              <modifications expression="0" elementName="start"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" isOver="true">
            <component_list isModificationOver="true" declarationName="m_bSensCapac" description="&quot;Flag to request sensitivity WRT Capacitor&quot;">
              <modifications expression="false" elementName="start"/>
            </component_list>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="CapacitorModelLineParams" description="&quot;Record for Capacitor model line parameters&quot;" isLongClassSpecifier="true" classNameEnd="CapacitorModelLineParams" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.CapacitancePerArea" isOver="true">
            <component_list declarationName="m_dCj" description="&quot;Junction bottom capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Permittivity" isOver="true">
            <component_list declarationName="m_dCjsw" description="&quot;Junction sidewall capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list declarationName="m_dDefW" description="&quot;Default device width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list declarationName="m_dNarrow" description="&quot;Narrowing due to side etching&quot;"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="capacitorInitEquations" isLongClassSpecifier="true" classNameEnd="capacitorInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Capacitor" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with capacitor parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CapacitorModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p2" description="&quot;Input record with capacitor model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Capacitor" directionType="output" isOver="true">
            <component_list declarationName="out" description="&quot;Output record with capacitor variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out" expression="in_p"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_dCapIsGiven &lt; 0.5)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(abs(in_p.m_dLength)>1e-18 and abs(in_p2.m_dCj)>1e-25)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out.m_dCapac" expression="Modelica.Electrical.Spice3.Internal.Functions.capDepGeom( in_p2.m_dCj, in_p2.m_dCjsw, out.m_dWidth, in_p.m_dLength, in_p2.m_dNarrow )"/>
              </ifStatements>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="capacitorRenameParameters" isLongClassSpecifier="true" classNameEnd="capacitorRenameParameters" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Spice3.Internal.ModelcardC" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CapacitorModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record with capacitor model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dCj" expression="ex.CJ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dCjsw" expression="ex.CJSW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dDefW" expression="ex.DEFW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dNarrow" expression="ex.NARROW"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="capacitorRenameParametersDev" isLongClassSpecifier="true" classNameEnd="capacitorRenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="input" isOver="true">
            <component_list declarationName="C" description="&quot;Capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="W" description="&quot;Width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="L" description="&quot;Length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="SENS_AREA" description="&quot;Parameter for sensitivity analyses, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CapacitorModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="p"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Capacitor" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record with capacitor parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dCapIsGiven" expression="if (C > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dCapac" expression="if (C > -1e40) then C else 1e-9"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dWidth" expression="if (W > -1e40) then W else p.m_dDefW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dLength" expression="L"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bSensCapac" expression="SENS_AREA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dTemp" expression="TEMP + Modelica.Electrical.Spice3.Internal.SpiceConstants.CONSTCtoK"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Documentation">
          <modifications expression="&quot;&lt;html>&#xA;&lt;p>The package Internal contains functions and auxiliary models that are necessary for the Spice3 models. The package should not be used by the users of the Spice3-library.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
      <annotations isModificationOver="true" elementName="Documentation">
        <modifications expression="&quot;&lt;html>&#xA;&lt;p>The Spice3 package contains models of the electronic simulator SPICE3. The models were translated into Modelica by rewriting the SPICE3 model code. &lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
      </annotations>
      <annotations isModificationOver="true" elementName="Icon">
