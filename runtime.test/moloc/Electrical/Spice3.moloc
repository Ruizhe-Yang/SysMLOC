        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list isModificationOver="true" declarationName="TBJT" description="&quot;Type of transistor (NPN=1, PNP=-1)&quot;">
