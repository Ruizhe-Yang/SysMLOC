        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="0" declarationName="NARROW" description="&quot;Narrowing due to side etching&quot;"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Modelcard parameters for semiconductor capacitance model&lt;/p>&#xA;&lt;p>&lt;br>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="SpiceConstants" description="&quot;General constants of SPICE simulator&quot;" isLongClassSpecifier="true" classNameEnd="SpiceConstants" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="(11.7 * 8.854214871e-12)" declarationName="EPSSIL"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="3.453133e-11" declarationName="EPSOX"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" parameterType="constant" isOver="true">
          <component_list expression="(1.6021918e-19)" declarationName="CHARGE"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="constant" isOver="true">
          <component_list expression="(273.15)" declarationName="CONSTCtoK"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.HeatCapacity" parameterType="constant" isOver="true">
          <component_list expression="(1.3806226e-23)" declarationName="CONSTboltz"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="constant" isOver="true">
          <component_list expression="300.15" declarationName="REFTEMP"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="sqrt(2.0)" declarationName="CONSTroot2"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list isModificationOver="true" expression="Modelica.Constants.k * Modelica.Units.Conversions.from_degC(27) / CHARGE" declarationName="CONSTvt0">
            <modifications expression="&quot;(J)/(A.s)&quot;" elementName="unit" isfinal="true"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list isModificationOver="true" expression="Modelica.Constants.k / CHARGE" declarationName="CONSTKoverQ">
            <modifications expression="&quot;(J/K)/(A.s)&quot;" elementName="unit" isfinal="true"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="exp(1.0)" declarationName="CONSTe"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" parameterType="constant" isOver="true">
          <component_list expression="1e-12" declarationName="CKTgmin"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="constant" isOver="true">
          <component_list expression="300.15" declarationName="CKTnomTemp"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="constant" isOver="true">
          <component_list expression="300.15" declarationName="CKTtemp"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" parameterType="constant" isOver="true">
          <component_list expression="0.0" declarationName="CKTdefaultMosAD"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Area" parameterType="constant" isOver="true">
          <component_list expression="0.0" declarationName="CKTdefaultMosAS"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="constant" isOver="true">
          <component_list expression="100e-6" declarationName="CKTdefaultMosL"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="constant" isOver="true">
          <component_list expression="100e-6" declarationName="CKTdefaultMosW"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="1e-10" declarationName="CKTreltol"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="1e-15" declarationName="CKTabstol"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="1e-10" declarationName="CKTvolttol"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
          <component_list expression="1e-3" declarationName="CKTtemptol"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>General constants used by SPICE&lt;/p>&#xA;&lt;p>The package Internal is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="record" className="MaterialParameters" isLongClassSpecifier="true" classNameEnd="MaterialParameters" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" parameterType="constant" isOver="true">
          <component_list expression="1.16" declarationName="EnergyGapSi"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.GapEnergyPerTemperature" parameterType="constant" isOver="true">
          <component_list expression="7.02e-4" declarationName="FirstBandCorrFactorSi"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" parameterType="constant" isOver="true">
          <component_list expression="1108" declarationName="SecondBandCorrFactorSi"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" parameterType="constant" isOver="true">
          <component_list expression="1.1150877" declarationName="BandCorrFactorT300"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.PerVolume" parameterType="constant" isOver="true">
          <component_list expression="1.45e16" declarationName="IntCondCarrDensity"/>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>Definition of Material parameters&lt;/p>&#xA;&lt;p>The package Repository is not for user access. There all function, records and data are stored, that are needed for the semiconductor models of the package Semiconductors.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Functions" description="&quot;Equations for semiconductor calculation&quot;" isLongClassSpecifier="true" classNameEnd="Functions" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionPotDepTemp" description="&quot;Temperature dependency of junction potential&quot;" isLongClassSpecifier="true" classNameEnd="junctionPotDepTemp" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="phi0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isProtected="true" isOver="true">
            <component_list declarationName="phibtemp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isOver="true">
            <component_list declarationName="phibtnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" parameterType="constant" isOver="true">
            <component_list expression="1" declarationName="unitGapEnergy"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="constant" isOver="true">
            <component_list expression="1" declarationName="unitVoltage"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="phibtemp" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(temp)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="phibtnom" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(tnom)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="(phi0 - phibtnom*(unitVoltage/unitGapEnergy)) * temp / tnom + phibtemp*(unitVoltage/unitGapEnergy) + vt * 3 * Modelica.Math.log( tnom / temp)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the temperature dependent junction potential based on the actual and the nominal temperature.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="saturationCurDepTempSPICE3MOSFET" description="&quot;Temperature dependency of saturation current&quot;" isLongClassSpecifier="true" classNameEnd="saturationCurDepTempSPICE3MOSFET" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur0" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vtnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isOver="true">
            <component_list declarationName="energygaptnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isOver="true">
            <component_list declarationName="energygaptemp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" parameterType="constant" isOver="true">
            <component_list expression="1" declarationName="unitGapEnergy"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="constant" isOver="true">
            <component_list expression="1" declarationName="unitVoltage"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vtnom" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* tnom"/>
            <statements xsi:type="mOloc:FunctionStatement" component="energygaptnom" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(tnom)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="energygaptemp" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(temp)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="satcur0 * exp( energygaptnom*(unitVoltage/unitGapEnergy) / vtnom - energygaptemp*(unitVoltage/unitGapEnergy) / vt)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the temperature dependent saturation current based on the actual and the nominal temperature.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionVCrit" description="&quot;Voltage limitation&quot;" isLongClassSpecifier="true" classNameEnd="junctionVCrit" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vte" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp*ncoeff"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="vte * Modelica.Math.log( vte / (sqrt(2) * satcur))"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="if ( ret > 1e10) then 1e10 else ret"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function limits the junction voltage. If it increases 1e10, it is hold to be constant at that value.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionParamDepTempSPICE3" description="&quot;Temperature dependency of junction parameters&quot;" isLongClassSpecifier="true" classNameEnd="junctionParamDepTempSPICE3" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="phi0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="cap0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="mcoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
            <component_list declarationName="junctionpot" description="&quot;Junction potential&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="junctioncap" description="&quot;Junction capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isProtected="true" isOver="true">
            <component_list declarationName="phibtemp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" isOver="true">
            <component_list declarationName="phibtnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vtnom"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="fact2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="pbfact"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="fact1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="pbfact1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="pbo"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gmaold"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="gmanew"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="phibtemp" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(temp)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="phibtnom" expression="Modelica.Electrical.Spice3.Internal.Functions.energyGapDepTemp(tnom)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ * temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vtnom" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ * tnom"/>
            <statements xsi:type="mOloc:FunctionStatement" component="arg" expression="-phibtemp/(2*Modelica.Constants.k*temp) + 1.1150877/(Modelica.Constants.k*(2*Spice3.Internal.SpiceConstants.REFTEMP))"/>
            <statements xsi:type="mOloc:FunctionStatement" component="fact2" expression="temp/Spice3.Internal.SpiceConstants.REFTEMP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbfact" expression="-2*vt*(1.5*Modelica.Math.log(fact2)+Spice3.Internal.SpiceConstants.CHARGE*arg)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="arg1" expression="-phibtnom/(Modelica.Constants.k*2*tnom) + 1.1150877/(2*Modelica.Constants.k*Spice3.Internal.SpiceConstants.REFTEMP)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="fact1" expression="tnom/Spice3.Internal.SpiceConstants.REFTEMP"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbfact1" expression="-2 * vtnom*(1.5*Modelica.Math.log(fact1)+Spice3.Internal.SpiceConstants.CHARGE*arg1)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="pbo" expression="(phi0-pbfact1)/fact1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="junctionpot" expression="pbfact+fact2*pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmaold" expression="(phi0 -pbo)/pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="gmanew" expression="(junctionpot-pbo)/pbo"/>
            <statements xsi:type="mOloc:FunctionStatement" component="junctioncap" expression="cap0 / (1+mcoeff* (400e-6*(tnom-Spice3.Internal.SpiceConstants.REFTEMP)-gmaold)) * (1+mcoeff* (400e-6*(temp-Spice3.Internal.SpiceConstants.REFTEMP)-gmanew))"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates several temperature dependent junction parameters based on the actual and the nominal temperature.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionCapCoeffs" description="&quot;Coefficient calculation&quot;" isLongClassSpecifier="true" classNameEnd="junctionCapCoeffs" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="mj"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="fc"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="phij"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
            <component_list declarationName="f1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="f2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="f3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="xfc"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="xfc" expression="Modelica.Math.log(1 - fc)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="f1" expression="phij * (1 - exp(( 1 - mj) * xfc )) / (1 - mj)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="f2" expression="exp(( 1 + mj) * xfc)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="f3" expression="1 - fc * (1 + mj)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal auxiliary function calculates some coefficients which are necessary for the calculation of junction capacities.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junction2SPICE3MOSFETRevised" description="&quot;Junction current and conductance calculation&quot;" isLongClassSpecifier="true" classNameEnd="junction2SPICE3MOSFETRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="out_current" description="&quot;Calculated current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="out_cond" description="&quot;Calculated conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="max_exponent"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evbd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
            <component_list expression="50." declarationName="max_exp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="constant" isOver="true">
            <component_list expression="1e4" declarationName="max_current"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:IfStatement" condition="(satcur > 1e-101)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vte" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ*temp*ncoeff"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="Modelica.Math.log(max_current/satcur)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="min(max_exp, max_exponent)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(voltage &lt;= 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_cond" expression="satcur/vte"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_current" expression="out_cond * voltage"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_cond" expression="out_cond + Spice3.Internal.SpiceConstants.CKTgmin"/>
                <elseCondition>(voltage >= max_exponent * vte)</elseCondition>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( max_exponent)"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_cond" expression="satcur * evd / vte"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="out_current" expression="satcur * (evd - 1) + out_cond * (voltage - max_exponent * vte)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="evbd" expression="exp( voltage / vte)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_cond" expression="satcur*evbd/vte + Spice3.Internal.SpiceConstants.CKTgmin"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out_current" expression="satcur *(evbd-1)"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_current" expression="0."/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="out_cond" expression="0."/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates both the junction current and the junction conductance dependent from the given voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionCapRevised" description="&quot;Junction capacity&quot;" isLongClassSpecifier="true" classNameEnd="junctionCapRevised" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="input" isOver="true">
            <component_list declarationName="capin" description="&quot;Input capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="depcap"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="mj"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="phij"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="f1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="f2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="f3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="capout" description="&quot;Output capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" directionType="output" isOver="true">
            <component_list declarationName="charge" description="&quot;Output charge&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="sarg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="czof2"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:IfStatement" condition="(voltage &lt; depcap)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="1 - (voltage / phij)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(mj == 0.5)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="1 / sqrt(arg)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="sarg" expression="exp(-1*mj*Modelica.Math.log(arg))"/>
              </ifStatements>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="capout" expression="capin * sarg"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="charge" expression="phij * (capin * (1 - arg * sarg) / (1 - mj))"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="czof2" expression="capin / f2"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="capout" expression="czof2 * (f3 + mj * voltage / phij)"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="charge" expression="capin * f1 + czof2 * (f3 * (voltage - depcap) + (mj / (2*phij)) * (voltage^2 - depcap^2))"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the charge and the capacitance of the junction capacity dependent from the given voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="saturationCurDepTempSPICE3" description="&quot;Temperature dependency of saturation current&quot;" isLongClassSpecifier="true" classNameEnd="saturationCurDepTempSPICE3" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur0" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="emissioncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="energygap"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="satcurexp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vte" expression="emissioncoeff * vt"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="satcur0 * exp( ((temp / tnom) - 1) * energygap / vte + satcurexp / emissioncoeff * Modelica.Math.log( temp / tnom) )"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the temperature dependent saturation current based on the actual and the nominal temperature.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionVoltage23SPICE3" description="&quot;Junction Voltage&quot;" isLongClassSpecifier="true" classNameEnd="junctionVoltage23SPICE3" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="vb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="ivb"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
            <component_list declarationName="v23" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="cbv"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="tol"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" isOver="true">
            <component_list declarationName="iter"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="v23" expression="vb"/>
            <statements xsi:type="mOloc:FunctionStatement" component="cbv" expression="ivb"/>
            <statements xsi:type="mOloc:IfStatement" condition="(cbv &lt; satcur * vb / vt)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cbv" expression="satcur * vb / vt"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="tol" expression="Spice3.Internal.SpiceConstants.CKTreltol* cbv"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="v23" expression="vb - vt * Modelica.Math.log( 1 + cbv / satcur)"/>
              <elseStatements xsi:type="mOloc:ForStatement" forIndices="iter in 0:24">
                <forStatements xsi:type="mOloc:FunctionStatement" component="v23" expression="vb - vt * Modelica.Math.log( cbv / satcur + 1 - v23 / vt)"/>
                <forStatements xsi:type="mOloc:IfStatement" condition="(abs( satcur * ( exp(( vb - v23) / vt) - 1 + v23 / vt) - cbv) &lt;= tol)"/>
              </elseStatements>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the junction voltage based on the actual temperature, voltage and saturation current.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junction3" description="&quot;Junction current and conductance calculation&quot;" isLongClassSpecifier="true" classNameEnd="junction3" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="v23"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="current" description="&quot;Output current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="cond" description="&quot;Output conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isProtected="true" isOver="true">
            <component_list expression="50.0" declarationName="max_exp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" parameterType="constant" isOver="true">
            <component_list expression="1.0e4" declarationName="max_current"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="max_exponent"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evrev"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vr"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:IfStatement" condition="(satcur > 1.0e-101)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vte" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp*ncoeff"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="Modelica.Math.log( max_current / satcur)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="min( max_exp, max_exponent)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(voltage >= max_exponent * vte)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( max_exponent)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur * evd / vte"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="satcur * (evd - 1) + cond * (voltage - max_exponent * vte)"/>
                <elseCondition>(voltage >= -3 * vte)</elseCondition>
                <elseCondition>(voltage >= -v23)</elseCondition>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( voltage / vte)"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="satcur*(evd - 1) + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur*evd/vte + Spice3.Internal.SpiceConstants.CKTgmin"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="3*vte/(voltage*Spice3.Internal.SpiceConstants.CONSTe)"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="arg * arg * arg"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="-1.*satcur*(1 + arg) + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur*3*arg/voltage + Spice3.Internal.SpiceConstants.CKTgmin"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="vr" expression="-( v23 + voltage)"/>
                <elseStatements xsi:type="mOloc:IfStatement" condition="(vr > max_exponent * vte)">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( max_exponent)"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur * evd / vte"/>
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="-1. * (satcur * (evd - 1) + cond * (vr - max_exponent * vte))"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="evrev" expression="exp( vr / vte)"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="current" expression="-1.*satcur*evrev + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
                  <elseStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur*evrev/vte + Spice3.Internal.SpiceConstants.CKTgmin"/>
                </elseStatements>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="current" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="0.0"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates both the junction current and the junction conductance dependent from the given voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junctionCapTransTime" description="&quot;Junction capacitance transittime calculation&quot;" isLongClassSpecifier="true" classNameEnd="junctionCapTransTime" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="input" isOver="true">
            <component_list declarationName="capin" description="&quot;Input capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="depcap"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="mj"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="phij"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="f1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="f2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="f3"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" directionType="input" isOver="true">
            <component_list declarationName="transittime"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="input" isOver="true">
            <component_list declarationName="conduct" description="&quot;Input conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="current" description="&quot;Input current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="capout" description="&quot;Output capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" directionType="output" isOver="true">
            <component_list declarationName="charge" description="&quot;Output charge&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="junctionCapRevised" function="( capin, voltage, depcap, mj, phij, f1, f2, f3 )" output="capout,charge"/>
            <statements xsi:type="mOloc:FunctionStatement" component="capout" expression="capout + transittime * conduct"/>
            <statements xsi:type="mOloc:FunctionStatement" component="charge" expression="charge + transittime * current"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the capacitance and the charge dependent on the transittime.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junction2" description="&quot;Junction current and conductance calculation&quot;" isLongClassSpecifier="true" classNameEnd="junction2" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="current" description="&quot;Output current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="cond" description="&quot;Output conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isProtected="true" isOver="true">
            <component_list expression="50.0" declarationName="max_exp"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="constant" isOver="true">
            <component_list expression="1.0e4" declarationName="max_current"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="max_exponent"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evd"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="arg"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:IfStatement" condition="(satcur > 1.0e-101)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="vte" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp*ncoeff"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="Modelica.Math.log( max_current / satcur)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="max_exponent" expression="min( max_exp, max_exponent)"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(voltage >= max_exponent * vte)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( max_exponent)"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur * evd / vte"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="satcur * (evd - 1) + cond * (voltage - max_exponent * vte)"/>
                <elseCondition>(voltage >= -5 * vte)</elseCondition>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( voltage / vte)"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="current" expression="satcur*(evd - 1) + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
                <elseifStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur*evd/vte + Spice3.Internal.SpiceConstants.CKTgmin"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="3*vte/(voltage*Spice3.Internal.SpiceConstants.CONSTe)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="arg" expression="arg * arg * arg"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="current" expression="-1*satcur*(1 + arg) + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="satcur*3*arg/voltage + Spice3.Internal.SpiceConstants.CKTgmin"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="current" expression="0.0"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="cond" expression="0.0"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates both the junction current and the junction conductance dependent from the given voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="resDepTemp" description="&quot;Temperature dependent conductance&quot;" isLongClassSpecifier="true" classNameEnd="resDepTemp" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" directionType="input" isOver="true">
            <component_list declarationName="resist" description="&quot;Input resistance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="tc1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="tc2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="conduct" description="&quot;Output conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="dCond_dTemp" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isProtected="true" isOver="true">
            <component_list declarationName="difference"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="factor"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="difference" expression="temp - tnom"/>
            <statements xsi:type="mOloc:FunctionStatement" component="factor" expression="1.0 + tc1 * difference + tc2 * difference * difference"/>
            <statements xsi:type="mOloc:FunctionStatement" component="conduct" expression="1.0 /(resist * factor)"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dCond_dTemp" expression="(tc1 + 2 * tc2 * difference) * conduct * conduct"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the conductance in dependency from the temperature.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="resDepGeom" description="&quot;Resistance dependent from width and narrow&quot;" isLongClassSpecifier="true" classNameEnd="resDepGeom" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="rsh" description="&quot;Input sheet resistance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="width" description="&quot;Input transistor width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="length" description="&quot;Input transistor length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="narrow" description="&quot;Input narrow&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="output" isOver="true">
            <component_list declarationName="out" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out" expression="rsh*(length - narrow)/(width - narrow)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the resistance in dependency from the geometrical values (width, narrow) and resistivity.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="saturationCurDepTempSPICE3JFET" description="&quot;Temperature dependency of saturation current&quot;" isLongClassSpecifier="true" classNameEnd="saturationCurDepTempSPICE3JFET" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur0" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="tnom" description="&quot;Nominal Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vt"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vt" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ*temp"/>
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="satcur0 * exp( (temp / tnom - 1) * 1.11 / vt)"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="capDepGeom" description="&quot;Capacitance dependent from width and narrow&quot;" isLongClassSpecifier="true" classNameEnd="capDepGeom" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.CapacitancePerArea" directionType="input" isOver="true">
            <component_list declarationName="cap0" description="&quot;Junction bottom capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Permittivity" directionType="input" isOver="true">
            <component_list declarationName="capsw0" description="&quot;Junction sidewall capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="width" description="&quot;Input capacitor width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="length" description="&quot;Input capacitor length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="narrow" description="&quot;Input narrow&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="out" description="&quot;Output value&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out" expression="cap0 * (width - narrow) * (length - narrow) + capsw0 * 2 * ((length - narrow) + (width - narrow))"/>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="energyGapDepTemp" description="&quot;Temperature dependency of energy gap&quot;" isLongClassSpecifier="true" classNameEnd="energyGapDepTemp" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.GapEnergy" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output Gap Energy&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="Spice3.Internal.MaterialParameters.EnergyGapSi - ( Spice3.Internal.MaterialParameters.FirstBandCorrFactorSi *temp*temp ) /(temp + Spice3.Internal.MaterialParameters.SecondBandCorrFactorSi)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the temperature dependent energy gap based on the actual temperature, and two coefficients given as input to the function.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="junction2SPICE3BJT" description="&quot;Junction current and conductance calculation&quot;" isLongClassSpecifier="true" classNameEnd="junction2SPICE3BJT" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="input" isOver="true">
            <component_list declarationName="voltage" description="&quot;Input Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Device Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff1"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="ncoeff2"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur1" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="input" isOver="true">
            <component_list declarationName="satcur2" description="&quot;Saturation current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="current1" description="&quot;Output current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="cond1" description="&quot;Output conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" directionType="output" isOver="true">
            <component_list declarationName="current2" description="&quot;Output current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" directionType="output" isOver="true">
            <component_list declarationName="cond2" description="&quot;Output conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="vte"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="vtn"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list declarationName="evd"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="vtn" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp*ncoeff1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="vte" expression="Spice3.Internal.SpiceConstants.CONSTKoverQ* temp*ncoeff2"/>
            <statements xsi:type="mOloc:IfStatement" condition="(voltage > -5 * vtn)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp( voltage / vtn)"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="current1" expression="satcur1*(evd - 1) + Spice3.Internal.SpiceConstants.CKTgmin *voltage"/>
              <ifStatements xsi:type="mOloc:FunctionStatement" component="cond1" expression="satcur1*evd/vtn + Spice3.Internal.SpiceConstants.CKTgmin"/>
              <ifStatements xsi:type="mOloc:IfStatement" condition="(satcur2 == 0)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="current2" expression="0"/>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="cond2" expression="0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="evd" expression="exp(voltage/vte)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="current2" expression="satcur2 * (evd-1)"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="cond2" expression="satcur2 * evd / vte"/>
              </ifStatements>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="cond1" expression="-satcur1/voltage + Spice3.Internal.SpiceConstants.CKTgmin"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="current1" expression="cond1 * voltage"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="cond2" expression="-satcur2/voltage"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="current2" expression="-satcur2"/>
            </statements>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="energyGapDepTemp_old" description="&quot;Temperature dependency of energy gap&quot;" isLongClassSpecifier="true" classNameEnd="energyGapDepTemp_old" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="temp" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" directionType="output" isOver="true">
            <component_list declarationName="ret" description="&quot;Output voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list expression="1.16" declarationName="gap0"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" isOver="true">
            <component_list isModificationOver="true" expression="7.02e-4" declarationName="coeff1">
              <modifications expression="&quot;V/K&quot;" elementName="unit" isfinal="true"/>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" isOver="true">
            <component_list expression="1108.0" declarationName="coeff2"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="ret" expression="gap0 - (coeff1 * temp * temp) / (temp + coeff2)"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This internal function calculates the temperature dependent energy gap based on the actual temperature, and two coefficients given as input to the function.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>The package Equation contains functions that are needed to model the semiconductor models. Some of these functions are used by several semiconductor models.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="SpiceRoot" description="&quot;Basic records and functions&quot;" isLongClassSpecifier="true" classNameEnd="SpiceRoot" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
