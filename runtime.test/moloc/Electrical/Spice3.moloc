        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.PerArea_cm" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="NFS" description="&quot;Fast surface state density&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="XJ" description="&quot;Metallurgical junction depth&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.ElectricFieldStrength_cm" parameterType="parameter" isOver="true">
          <component_list expression="1e4" declarationName="UCRIT" description="&quot;Critical field for mobility degradation (MOS2 only)&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
          <component_list expression="0.0" declarationName="UEXP" description="&quot;Critical field exponent in mobility degradation (MOS2 only)&quot;"/>
