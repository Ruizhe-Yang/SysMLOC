          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" isOver="true">
            <component_list declarationName="m_dLength"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" isOver="true">
            <component_list declarationName="m_dResist"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="m_dConduct"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" isOver="true">
            <component_list declarationName="m_dCond_dTemp"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This record contains the model variables that are used for the resistor model in SPICE3.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="resistorRenameParameters" description="&quot;Technology parameter renaming&quot;" isLongClassSpecifier="true" classNameEnd="resistorRenameParameters" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardR" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="con" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ResistorModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record with resistor model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dTC1" expression="ex.TC1"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dTC2" expression="ex.TC2"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dRshIsGiven" expression="if (ex.RSH > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dRsh" expression="if (ex.RSH > -1e40) then ex.RSH else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dDefW" expression="ex.DEFW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dNarrow" expression="ex.NARROW"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dTnom" expression="if (ex.TNOM > -1e40) then ex.TNOM + SpiceConstants.CONSTCtoK else 300.15"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function assigns the external (given by the user, e.g., N) technology parameters&#xA;to the internal parameters (e.g., m_emissionCoeff). It also does the analysis of the IsGiven values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="resistorRenameParametersDev" description="&quot;Device parameter renaming&quot;" isLongClassSpecifier="true" classNameEnd="resistorRenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Resistance" directionType="input" isOver="true">
            <component_list declarationName="R" description="&quot;Resistance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="W" description="&quot;Width&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Length" directionType="input" isOver="true">
            <component_list declarationName="L" description="&quot;Length&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="SENS_AREA" description="&quot;Parameter for sensitivity analyses, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="con" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ResistorParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record with resistor parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dResIsGiven" expression="if (R > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dResist" expression="if (R > -1e40) then R else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dWidthIsGiven" expression="if (W >-1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dWidth" expression="if (W > -1e40) then W else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dLengthIsGiven" expression="if (L >-1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dLength" expression="if (L > -1e40) then L else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_bSensResist" expression="SENS_AREA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_dTemp" expression="if (TEMP > -1e40) then TEMP + SpiceConstants.CONSTCtoK else 300.15"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function assigns the external (given by the user, e.g., AREA) device parameters&#xA;to the internal parameters (e.g., m_area). It also does the analysis of the IsGiven values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="resistorInitEquations" description="&quot;Initial calculation&quot;" isLongClassSpecifier="true" classNameEnd="resistorInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ResistorParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with resistor parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ResistorModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p2" description="&quot;Input record with resistor model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ResistorVariables" directionType="output" isOver="true">
            <component_list declarationName="out" description="&quot;Output record with resistor variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out.m_dLength" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out.m_dConduct" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out.m_dCond_dTemp" expression="0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out.m_dWidth" expression="in_p.m_dWidth"/>
            <statements xsi:type="mOloc:IfStatement" condition="( in_p.m_dResIsGiven &lt; 0.5)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(abs(in_p.m_dLength)>1e-8) and (abs(in_p2.m_dRsh)>1e-25)">
                <ifStatements xsi:type="mOloc:IfStatement" condition="(not (in_p.m_dWidthIsGiven > 0.5))">
                  <ifStatements xsi:type="mOloc:FunctionStatement" component="out.m_dWidth" expression="in_p2.m_dDefW"/>
                </ifStatements>
                <ifStatements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.resDepGeom" function="( in_p2.m_dRsh, out.m_dWidth, in_p.m_dLength, in_p2.m_dNarrow )" output="out.m_dResist"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="out.m_dResist" expression="1000"/>
              </ifStatements>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_dResist &lt; 1e-12) and (in_p.m_dResIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out.m_dResist" expression="1e-12"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_dResist > 1e-12) and (in_p.m_dResIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out.m_dResist" expression="in_p.m_dResist"/>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>In this function some initial calculations for the resistor model are done, especially concerning the handling of the breakthrough voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package Rsemiconductor contains functions and records with data of the semiconductor resistor model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
