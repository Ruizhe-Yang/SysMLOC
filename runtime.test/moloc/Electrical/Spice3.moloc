        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="IC_VGS" description="&quot;Initial condition value (VGS, not implemented yet)&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" parameterType="parameter" isOver="true">
          <component_list expression="-1e40" declarationName="IC_VBS" description="&quot;Initial condition value (VBS, not implemented yet)&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" parameterType="parameter" isOver="true">
          <component_list expression="false" declarationName="UIC" description="&quot;Use initial conditions: true, if initial condition is used&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" parameterType="parameter" isOver="true">
          <component_list expression="27" declarationName="TEMP" description="&quot;Operating temperature of the device&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.ModelcardMOS2" parameterType="parameter" isOver="true">
          <component_list declarationName="modelcard" description="&quot;MOSFET modelcard&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mos2.mos2RenameParametersRevised( modelcard)" declarationName="p" description="&quot;Model line parameters&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mosfet.mosfetRenameParametersDev( W, L, AD, AS, PD, PS, NRD, NRS, OFF, IC_VDS, IC_VGS, IC_VBS, UIC, TEMP )" declarationName="m" description="&quot;Renamed parameters&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="Evaluate"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mosfet.Mosfet" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mosfet.mosfetInitEquations(m)" declarationName="m1"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="if (m.m_bPMOS > 0.5) then -1 else 1" declarationName="m_type" description="&quot;Type of the transistor&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2ModelLineParams" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mos2.mos2ModelLineParamsInitEquationsRevised( p, m_type)" declarationName="p1" description="&quot;Model line variables&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mos.mos2CalcInitEquationsRevised( p1, m1)" declarationName="c11" description="&quot;Precalculated parameters&quot;"/>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Spice3.Internal.Mos2.Mos2Calc" parameterType="parameter" isfinal="true" isOver="true">
          <component_list expression="Spice3.Internal.Mos.mos2CalcCalcTempDependenciesRevised( p1, m1, c11, m_type )" declarationName="c22" description="&quot;Precalculated parameters&quot;"/>
