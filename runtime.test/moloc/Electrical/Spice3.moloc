            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_leakBEcurrentIsGiven" expression="if (ex.ISE > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_leakBEcurrent" expression="if (ex.ISE > -1e40) then ex.ISE else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_c2IsGiven" expression="if (ex.C2 > -1e40) then 1 else 0"/>
