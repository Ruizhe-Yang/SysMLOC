        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeModelLineInitEquations" description="&quot;Initial precalculation of model line parameters&quot;" isLongClassSpecifier="true" classNameEnd="diodeModelLineInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with diode model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineVariables" directionType="output" isOver="true">
            <component_list declarationName="out_v" description="&quot;Output record with diode model line variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_gradingCoeff > 0.9)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_gradingCoeff" expression="0.9"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_activationEnergy &lt; 0.1)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_activationEnergy" expression="0.1"/>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_depletionCapCoeff > 0.95)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_depletionCapCoeff" expression="0.95"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_conductance" expression="if (in_p.m_resist == 0.0) then 0.0 else 1.0 / in_p.m_resist"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>Within this function some parameters are initially precalculated from model line parameters.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeInitEquations" description="&quot;Initial calculation&quot;" isLongClassSpecifier="true" classNameEnd="diodeInitEquations" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with diode model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeVariables" directionType="output" isOver="true">
            <component_list declarationName="out_v" description="&quot;Output record with diode variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_v.m_pBvIsGiven" expression="in_p.m_pBvIsGiven"/>
            <statements xsi:type="mOloc:IfStatement" condition="(out_v.m_pBvIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:IfStatement" condition="(in_p.m_breakdownVoltage > 1.0e+100)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="out_v.m_pBvIsGiven" expression="1.0e-41"/>
              </ifStatements>
            </statements>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>In this function some initial calculations for the diode model are done, especially concerning the handling of the breakthrough voltage.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeCalcTempDependencies" description="&quot;Temperature dependency calculation&quot;" isLongClassSpecifier="true" classNameEnd="diodeCalcTempDependencies" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record diode model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeParams" directionType="input" isOver="true">
            <component_list declarationName="in_dp" description="&quot;Input record diode parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Model.Model" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record Model&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeVariables" directionType="input" isOver="true">
            <component_list declarationName="in_v" description="&quot;Input record diode variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeCalc" directionType="output" isOver="true">
            <component_list declarationName="out_c" description="&quot;Output record with calculated values&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionParamDepTempSPICE3" function="( in_p.m_junctionPot, in_p.m_junctionCap, in_p.m_gradingCoeff, in_m.m_dTemp, in_p.m_nomTemp )" output="out_c.m_tJctPot,out_c.m_tJctCap"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tJctCap" expression="in_dp.m_area * out_c.m_tJctCap"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionCapCoeffs" function="( in_p.m_gradingCoeff, in_p.m_depletionCapCoeff, out_c.m_tJctPot )" output="out_c.m_tF1,out_c.m_f2,out_c.m_f3"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCur" expression="Modelica.Electrical.Spice3.Internal.Functions.saturationCurDepTempSPICE3( in_p.m_satCur, in_m.m_dTemp, in_p.m_nomTemp, in_p.m_emissionCoeff, in_p.m_activationEnergy, in_p.m_saturationCurrentExp )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tVcrit" expression="Modelica.Electrical.Spice3.Internal.Functions.junctionVCrit( in_m.m_dTemp, in_p.m_emissionCoeff, out_c.m_tSatCur )"/>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_dVte" expression="in_m.m_dTemp*SpiceConstants.CONSTKoverQ*in_p.m_emissionCoeff"/>
            <statements xsi:type="mOloc:IfStatement" condition="(in_v.m_pBvIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="out_c.m_tBrkdwnV" expression="Modelica.Electrical.Spice3.Internal.Functions.junctionVoltage23SPICE3( in_p.m_breakdownVoltage, in_p.m_breakdownCurrent, out_c.m_tSatCur, in_m.m_dTemp, in_p.m_emissionCoeff )"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="out_c.m_tSatCur" expression="in_dp.m_area * out_c.m_tSatCur"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>In this function for the diode model temperature dependencies are calculated using temperature treating functions from the equation package.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeNoBypassCode" description="&quot;Calculation of currents&quot;" isLongClassSpecifier="true" classNameEnd="diodeNoBypassCode" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record model line parameters for diode&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeParams" directionType="input" isOver="true">
            <component_list declarationName="in_dp" description="&quot;Input record with parameters for diode&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeCalc" directionType="input" isOver="true">
            <component_list declarationName="in_c" description="&quot;Input record DiodeCalc&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Model.Model" directionType="input" isOver="true">
            <component_list declarationName="in_m" description="&quot;Input record model&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="in_m_mbInit"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[2]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="CurrentsCapacitances" directionType="output" isOver="true">
            <component_list declarationName="out_cc" description="&quot;Output record with calculated currents and capacitances&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Types.Capacitance" directionType="output" isOver="true">
            <component_list declarationName="m_dCap" description="&quot;Output capacitance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isProtected="true" isOver="true">
            <component_list declarationName="m_dPNVoltage" description="&quot;Voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="m_dCurrent" description="&quot;Current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Conductance" isOver="true">
            <component_list declarationName="m_dCond" description="&quot;Conductance&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Charge" isOver="true">
            <component_list declarationName="m_dCharge" description="&quot;Charge&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="m_dCapCurrent" description="&quot;Current&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="m_dPNVoltage" expression="in_m_pVoltageValues[1] - in_m_pVoltageValues[2]"/>
            <statements xsi:type="mOloc:IfStatement" condition="(SpiceRoot.useInitialConditions() and in_dp.m_pIcIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="m_dPNVoltage" expression="in_dp.m_dIC"/>
              <elseCondition>(SpiceRoot.initJunctionVoltagesRevised())</elseCondition>
              <elseifStatements xsi:type="mOloc:IfStatement" condition="(in_dp.m_bOff)">
                <ifStatements xsi:type="mOloc:FunctionStatement" component="m_dPNVoltage" expression="0.0"/>
                <elseStatements xsi:type="mOloc:FunctionStatement" component="m_dPNVoltage" expression="in_c.m_tVcrit"/>
              </elseifStatements>
            </statements>
            <statements xsi:type="mOloc:IfStatement" condition="(in_p.m_pBvIsGiven > 0.5)">
              <ifStatements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junction3" function="( m_dPNVoltage, in_m.m_dTemp, in_p.m_emissionCoeff, in_c.m_tSatCur, in_c.m_tBrkdwnV )" output="out_cc.m_dCurrent,m_dCond"/>
              <elseStatements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junction2" function="( m_dPNVoltage, in_m.m_dTemp, in_p.m_emissionCoeff, in_c.m_tSatCur )" output="out_cc.m_dCurrent,m_dCond"/>
            </statements>
            <statements xsi:type="mOloc:FunctionStatement" component="m_dCurrent" expression="out_cc.m_dCurrent"/>
            <statements xsi:type="mOloc:FunctionStatement" component="Modelica.Electrical.Spice3.Internal.Functions.junctionCapTransTime" function="( in_c.m_tJctCap, m_dPNVoltage, in_c.m_tJctPot*in_p.m_depletionCapCoeff, in_p.m_gradingCoeff, in_p.m_junctionPot, in_c.m_tF1, in_c.m_f2, in_c.m_f3, in_p.m_transitTime, m_dCond, m_dCurrent )" output="m_dCap,m_dCharge"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function diodeNoBypassCode calculates the currents (and the capacitances) that are necessary for the currents to be used in the top-level model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeCalcAdditionalValues" description="&quot;Calculation of additional values&quot;" isLongClassSpecifier="true" classNameEnd="diodeCalcAdditionalValues" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeVariables" directionType="input" isOver="true">
            <component_list declarationName="in_v" description="&quot;Input record with diode variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="input" isOver="true">
            <component_list declarationName="in_p" description="&quot;Input record with diode model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeParams" directionType="input" isOver="true">
            <component_list declarationName="in_dp" description="&quot;Input record with diode parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" subscripts="[2]" directionType="input" isOver="true">
            <component_list declarationName="in_m_pVoltageValues"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeVariables" directionType="output" isOver="true">
            <component_list declarationName="out_v" description="&quot;Output record with diode variables&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="out_v" expression="in_v"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function is prepared for additional calculations but it is plain (inputs are written to the outputs) in the actual version of this library.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeRenameParameters" description="&quot;Technology parameter renaming&quot;" isLongClassSpecifier="true" classNameEnd="diodeRenameParameters" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="ModelcardDIODE" directionType="input" isOver="true">
            <component_list declarationName="ex" description="&quot;Modelcard with technology parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SpiceConstants" directionType="input" isOver="true">
            <component_list declarationName="con" description="&quot;Spice constants&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeModelLineParams" directionType="output" isOver="true">
            <component_list declarationName="intern" description="&quot;Output record diode model line parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_satCur" expression="ex.IS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_resist" expression="ex.RS"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_emissionCoeff" expression="ex.N"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_transitTime" expression="ex.TT"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_junctionCap" expression="ex.CJO"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_junctionPot" expression="ex.VJ"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_gradingCoeff" expression="if (ex.M > 0.9) then 0.9 else ex.M"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_activationEnergy" expression="if (ex.EG &lt; 0.1) then 0.1 else ex.EG"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_saturationCurrentExp" expression="ex.XTI"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_depletionCapCoeff" expression="if (ex.FC > 0.95) then 0.95 else ex.FC"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_pBvIsGiven" expression="if (ex.BV > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_breakdownVoltage" expression="if (ex.BV > -1e40) then ex.BV else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_breakdownCurrent" expression="ex.IBV"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_nomTemp" expression="ex.TNOM + SpiceConstants.CONSTCtoK"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fNcoef" expression="ex.KF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_fNexp" expression="ex.AF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="intern.m_conductance" expression="if (ex.RS == 0) then 0 else 1/ex.RS"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function assigns the external (given by the user, e.g., IS) technology parameters&#xA;to the internal parameters (e.g., m_satCur). It also does the analysis of the IsGiven values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeRenameParametersDev" description="&quot;Temperature calculation&quot;" isLongClassSpecifier="true" classNameEnd="diodeRenameParametersDev" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Temperature" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="AREA" description="&quot;Area factor&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" directionType="input" isOver="true">
            <component_list declarationName="IC" description="&quot;Initial condition value (VD, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="OFF" description="&quot;Optional initial condition: false - IC not used, true - IC used, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
            <component_list declarationName="SENS_AREA" description="&quot;Flag to request sensitivity WRT area, not implemented yet&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="DiodeParams" directionType="output" isOver="true">
            <component_list declarationName="dev" description="&quot;Output record with calculated diode parameters&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_area" expression="AREA"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_pIcIsGiven" expression="if (IC > -1e40) then 1 else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_dIC" expression="if (IC > -1e40) then IC else 0"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_bOff" expression="OFF"/>
            <statements xsi:type="mOloc:FunctionStatement" component="dev.m_bSensArea" expression="SENS_AREA"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function assigns the external (given by the user, e.g., AREA) device parameters&#xA;to the internal parameters (e.g., m_area). It also does the analysis of the IsGiven values.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" classType="function" className="diodeRenameParametersDevTemp" description="&quot;Temperature calculation&quot;" isLongClassSpecifier="true" classNameEnd="diodeRenameParametersDevTemp" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Function" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Units.NonSI.Temperature_degC" directionType="input" isOver="true">
            <component_list declarationName="TEMP" description="&quot;Temperature&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Model.Model" directionType="output" isOver="true">
            <component_list declarationName="dev_temp" description="&quot;Input record Model&quot;"/>
          </elements>
          <elements xsi:type="mOloc:AlgorithmSection">
            <statements xsi:type="mOloc:FunctionStatement" component="dev_temp.m_dTemp" expression="TEMP + SpiceConstants.CONSTCtoK"/>
          </elements>
          <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
            <annotations isModificationOver="true" elementName="Documentation">
              <modifications expression="&quot;&lt;html>&#xA;&lt;p>This function calculates device parameters which are temperature dependent.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
            </annotations>
          </elements>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>This package Diode contains functions and record with data of the semiconductor diode model.&lt;/p>&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Rsemiconductor" description="&quot;Records and functions for semiconductor resistor model&quot;" isLongClassSpecifier="true" classNameEnd="Rsemiconductor" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.InternalPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="record" className="ResistorParams" description="&quot;Resistor device parameters&quot;" isLongClassSpecifier="true" classNameEnd="ResistorParams" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.Record" isOver="true"/>
