      <elements xsi:type="mOloc:GeneralClause" classType="model" className="BJT2" description="&quot;Bipolar junction transistor&quot;" isLongClassSpecifier="true" classNameEnd="BJT2" isOver="true">
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Electrical.Analog.Interfaces.PositivePin" isOver="true">
          <component_list declarationName="B" description="&quot;Base node&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations isModificationOver="true" elementName="Placement">
