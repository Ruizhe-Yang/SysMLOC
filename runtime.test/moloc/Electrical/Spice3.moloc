          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="m_vgs" description="&quot;Vgs, Gate-Source voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Voltage" isOver="true">
            <component_list declarationName="m_vbs" description="&quot;Vbs, Bulk-Source voltage&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Current" isOver="true">
            <component_list declarationName="m_cbs" description="&quot;Ibs, B-S junction current&quot;"/>
