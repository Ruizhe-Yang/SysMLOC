      <elements xsi:type="mOloc:GeneralClause" classType="connector" className="Step_in_forAlternative" description="&quot;Input port of a step (has special icon for usage in component 'Alternative')&quot;" isLongClassSpecifier="true" classNameEnd="Step_in_forAlternative" isProtected="true" isOver="true">
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="output" isOver="true">
          <component_list declarationName="occupied" description="&quot;= true, if step is active&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="HideResult"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
          <component_list declarationName="set" description="&quot;= true, if transition fires and step is activated&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="HideResult"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
            </modifications>
            <modifications expression="{Rectangle( extent={{-100,100},{100,-100}}, fillColor={175,175,175}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Diagram">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
            </modifications>
            <modifications expression="{Rectangle( extent={{-100,100},{100,-100}}, fillColor={175,175,175}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="connector" className="Step_out_forAlternative" description="&quot;Output port of a step (has special icon for usage in component 'Alternative')&quot;" isLongClassSpecifier="true" classNameEnd="Step_out_forAlternative" isOver="true">
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="output" isOver="true">
          <component_list declarationName="available" description="&quot;= true, if step is active&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="HideResult"/>
