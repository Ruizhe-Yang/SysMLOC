        </elements>
        <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Boolean" directionType="input" isOver="true">
          <component_list declarationName="reset" description="&quot;= true, if transition fires and step is deactivated&quot;" isAnnotation="true" isAnnotationOver="true">
            <annotations expression="true" elementName="HideResult"/>
          </component_list>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="Icon">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
            </modifications>
            <modifications expression="{Rectangle( extent={{-100,100},{100,-100}}, fillColor={175,175,175}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Diagram">
            <modifications isModificationOver="true" elementName="coordinateSystem">
              <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
            </modifications>
            <modifications expression="{Rectangle( extent={{-100,100},{100,-100}}, fillColor={175,175,175}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:EquationSection">
        <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cardinality(inPort) == 1, &quot;Connector inPort is not connected to exactly one other connector&quot; )"/>
        <equations xsi:type="mOloc:FunctionEquation" component="assert" function="(cardinality(outPort) == 1, &quot;Connector outPort is not connected to exactly one other connector&quot; )"/>
        <equations xsi:type="mOloc:ForEquation" forIndices="i in 1:nBranches">
          <forEquations xsi:type="mOloc:FunctionEquation" component="assert" function="(cardinality(split[i]) == 1, &quot;Connector is not connected to exactly one other connector&quot; )"/>
          <forEquations xsi:type="mOloc:FunctionEquation" component="assert" function="(cardinality(join[i]) == 1, &quot;Connector is not connected to exactly one other connector&quot; )"/>
        </equations>
        <equations xsi:type="mOloc:ForEquation" forIndices="i in 1:nBranches">
          <forEquations xsi:type="mOloc:SimpleEquation" left="split[i].available" right="if i==1 then inPort.available else split[i-1].available and not split[i-1].reset"/>
        </equations>
        <equations xsi:type="mOloc:SimpleEquation" left="join.occupied" right="fill(outPort.occupied, nBranches)"/>
        <equations xsi:type="mOloc:SimpleEquation" left="inPort.reset" right="Modelica.Math.BooleanVectors.anyTrue(split.reset)"/>
        <equations xsi:type="mOloc:SimpleEquation" left="outPort.set" right="Modelica.Math.BooleanVectors.anyTrue(join.set)"/>
      </elements>
      <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
        <annotations isModificationOver="true" elementName="Icon">
          <modifications isModificationOver="true" elementName="coordinateSystem">
            <modifications expression="false" elementName="preserveAspectRatio"/>
            <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
          </modifications>
          <modifications expression="{ Line( points={{-80,100},{80,100}}, pattern=LinePattern.Dot ) , Line( points={{-80,-100},{80,-100}}, pattern=LinePattern.Dot ) , Line(points={{-100,0},{-80,0}}), Line(points={{80,0},{100,0}}) }" elementName="graphics"/>
        </annotations>
        <annotations isModificationOver="true" elementName="Diagram">
          <modifications isModificationOver="true" elementName="coordinateSystem">
            <modifications expression="true" elementName="preserveAspectRatio"/>
            <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
          </modifications>
          <modifications expression="{Line(points={{-100,0},{-80,0}}), Line(points={{80,0},{100,0}}) }" elementName="graphics"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="block" className="Parallel" description="&quot;Parallel splitting of execution path (use component between two transitions)&quot;" isLongClassSpecifier="true" classNameEnd="Parallel" isOver="true">
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
        <component_list isModificationOver="true" expression="2" declarationName="nBranches" description="&quot;Number of parallel branches that are executed in parallel&quot;">
          <modifications expression="1" elementName="min"/>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.Step_in" isOver="true">
