            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-3.5,-20},{16,-20}}" elementName="points"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="transition4.outPort" right="compositeStep.resume[1]">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{21.5, -20 } ,{40,-20},{40,10},{2.5,10},{2.5,24} }" elementName="points"/>
            </annotations>
