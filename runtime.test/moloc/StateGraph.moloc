            <modifications expression="{{-100,-100},{100,100}}" elementName="extent"/>
          </modifications>
          <modifications expression="{Line(points={{-31,0},{-11,0}}), Rectangle( extent={{-10,100},{10,-100}}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="block" className="TransitionWithSignal" description="&quot;Transition where the fire condition is set by a Boolean input signal&quot;" isLongClassSpecifier="true" classNameEnd="TransitionWithSignal" isOver="true">
