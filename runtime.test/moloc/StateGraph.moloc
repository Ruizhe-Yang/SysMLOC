          <modifications expression="{Line(points={{-31,0},{-11,0}}), Rectangle( extent={{-10,100},{10,-100}}, fillPattern=FillPattern.Solid ) }" elementName="graphics"/>
        </annotations>
      </elements>
    </elements>
    <elements xsi:type="mOloc:GeneralClause" classType="block" className="Alternative" description="&quot;Alternative splitting of execution path (use component between two steps)&quot;" isLongClassSpecifier="true" classNameEnd="Alternative" isOver="true">
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Integer" parameterType="parameter" isOver="true">
        <component_list isModificationOver="true" expression="2" declarationName="nBranches" description="&quot;Number of alternative branches&quot;">
          <modifications expression="1" elementName="min"/>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.Transition_in" isOver="true">
        <component_list declarationName="inPort" isAnnotation="true" isAnnotationOver="true">
          <annotations isModificationOver="true" elementName="Placement">
            <modifications isModificationOver="true" elementName="transformation">
              <modifications expression="{{-106, -3 } ,{-100,3} }" elementName="extent"/>
            </modifications>
          </annotations>
        </component_list>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Interfaces.Transition_out" isOver="true">
