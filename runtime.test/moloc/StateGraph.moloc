          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank2.inflow1" right="valve2.inflow1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{46.5,-18.75},{46.5,9.5}}" elementName="points"/>
              <modifications expression="0.5" elementName="thickness"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank2.outflow1" right="valve3.outflow1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{74,-46.25},{74,-73.5},{73.5,-73.5}}" elementName="points"/>
              <modifications expression="0.5" elementName="thickness"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank1.inflow1" right="valve1.inflow1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{22.5,61.25},{22.5,69.25}}" elementName="points"/>
              <modifications expression="0.5" elementName="thickness"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="shut.on" right="tankController.shut">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-69,-30},{ -62,-30} ,{-62,-12},{-52,-12} }" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="stop.on" right="tankController.stop">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-69,0},{-52, 0 } }" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="start.on" right="tankController.start">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-69,30},{ -60,30} ,{-60,12},{-52,12} }" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank1.levelSensor" right="tankController.level1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{ {17.25,40},{-30,40},{-30,60},{-97,60},{-97,-50},{-42,-50},{-42, -22 } }" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank2.levelSensor" right="tankController.level2">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{ {41.25,-40},{-18,-40},{-18,-22}}" elementName="points"/>
              <modifications expression="{0,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tankController.valve1" right="valve1.valveControl">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-9,12},{10,12},{10,72},{18.1,72}}" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tankController.valve2" right="valve2.valveControl">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-9,0},{ 30,0} ,{30,13},{40.1,13} }" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tankController.valve3" right="valve3.valveControl">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{-9,-12},{23,-12},{23,-77},{67.1,-77}}" elementName="points"/>
              <modifications expression="{255,0,255}" elementName="color"/>
            </annotations>
          </equations>
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="source.outflow1" right="valve1.outflow1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{22.5,85.5},{22.5,74.75}}" elementName="points"/>
              <modifications expression="0.5" elementName="thickness"/>
            </annotations>
          </equations>
        </elements>
        <elements xsi:type="mOloc:AnnotationClause" isAnnotation="true" isAnnotationOver="true" isOver="true">
          <annotations isModificationOver="true" elementName="experiment">
            <modifications expression="100" elementName="StopTime"/>
          </annotations>
          <annotations isModificationOver="true" elementName="Documentation">
            <modifications expression="&quot;&lt;html>&#xA;&lt;p>&#xA;With this example the controller of a tank filling/emptying system&#xA;is demonstrated. This example is from Dressler (2004),&#xA;see &lt;a href=\&quot;modelica://Modelica.StateGraph.UsersGuide.Literature\&quot;>Literature&lt;/a>.&#xA;The basic operation is to fill and empty the two tanks:&#xA;&lt;/p>&#xA;&lt;ol>&#xA;&lt;li> Valve 1 is opened and tank 1 is filled.&lt;/li>&#xA;&lt;li> When tank 1 reaches its fill level limit,&#xA;     valve 1 is closed.&lt;/li>&#xA;&lt;li> After a waiting time, valve 2 is&#xA;     opened and the fluid flows from tank 1 into tank 2.&lt;/li>&#xA;&lt;li> When tank 1 is empty, valve 2 is closed.&lt;/li>&#xA;&lt;li> After a waiting time, valve 3 is opened and&#xA;     the fluid flows out of tank 2&lt;/li>&#xA;&lt;li> When tank 3 is empty, valve 3 is closed&lt;/li>&#xA;&lt;/ol>&#xA;&lt;p>&#xA;The above \&quot;normal\&quot; process can be influenced by three&#xA;buttons:&#xA;&lt;/p>&#xA;&lt;ul>&#xA;&lt;li> Button &lt;strong>start&lt;/strong> starts the above process.&#xA;     When this button is pressed after a \&quot;stop\&quot; or&#xA;     \&quot;shut\&quot; operation, the process operation continues.&#xA;     &lt;/li>&#xA;&lt;li> Button &lt;strong>stop&lt;/strong> stops the above process by&#xA;     closing all valves. Then, the controller waits for&#xA;     further input (either \&quot;start\&quot; or \&quot;shut\&quot; operation).&lt;/li>&#xA;&lt;li> Button &lt;strong>shut&lt;/strong> is used to shutdown the process,&#xA;     by emptying at once both tanks. When this is achieved,&#xA;     the process goes back to its start configuration.&#xA;     Clicking on \&quot;start\&quot;, restarts the process.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;/html>&quot;" elementName="info"/>
          </annotations>
        </elements>
      </elements>
      <elements xsi:type="mOloc:GeneralClause" classType="package" className="Utilities" description="&quot;Utility components for the examples&quot;" isLongClassSpecifier="true" classNameEnd="Utilities" isOver="true">
        <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="Modelica.Icons.UtilitiesPackage" isOver="true"/>
        <elements xsi:type="mOloc:GeneralClause" classType="model" className="TankController" description="&quot;Controller for tank system&quot;" isLongClassSpecifier="true" classNameEnd="TankController" isOver="true">
          <elements xsi:type="mOloc:ExtendsClause" typeSpecifier="StateGraph.Interfaces.PartialStateGraphIcon" isOver="true"/>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Real" parameterType="parameter" isOver="true">
            <component_list expression="0.98" declarationName="limit" description="&quot;Limit level of tank 1&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="SI.Time" parameterType="parameter" isOver="true">
            <component_list expression="3" declarationName="waitTime" description="&quot;Wait time&quot;"/>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="InitialStep" isOver="true">
            <component_list isModificationOver="true" declarationName="s1" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="2" elementName="nIn"/>
              <modifications expression="1" elementName="nOut"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-72,30},{-52,50}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="MakeProduct" isOver="true">
            <component_list isModificationOver="true" declarationName="makeProduct" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="limit" elementName="limit"/>
              <modifications expression="waitTime" elementName="waitTime"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-20,25},{10,55}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T1" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="start" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-50,50},{-30,30}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T2" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="level2&lt;0.001" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{27,50},{47,30}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T3" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="stop" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{-23,-1}" elementName="origin"/>
                  <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
                  <modifications expression="270" elementName="rotation"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Step" isOver="true">
            <component_list isModificationOver="true" declarationName="s2" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="1" elementName="nIn"/>
              <modifications expression="2" elementName="nOut"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-50,-60},{-30,-40}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T4" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="start" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{10,-1}" elementName="origin"/>
                  <modifications expression="{{-10,-10},{10,10}}" elementName="extent"/>
                  <modifications expression="90" elementName="rotation"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T5" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="shut" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-6,-60},{14,-40}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Step" isOver="true">
            <component_list isModificationOver="true" declarationName="emptyTanks" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="1" elementName="nIn"/>
              <modifications expression="1" elementName="nOut"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{22,-60},{42,-40}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Transition" isOver="true">
            <component_list isModificationOver="true" declarationName="T6" isAnnotation="true" isAnnotationOver="true">
              <modifications expression="level1+level2&lt;0.001" elementName="condition"/>
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{45,-60},{65,-40}}" elementName="extent"/>
                </modifications>
              </annotations>
            </component_list>
          </elements>
          <elements xsi:type="mOloc:GeneralClause" typeSpecifier="Modelica.Blocks.Interfaces.BooleanInput" isOver="true">
            <component_list declarationName="start" isAnnotation="true" isAnnotationOver="true">
              <annotations isModificationOver="true" elementName="Placement">
                <modifications isModificationOver="true" elementName="transformation">
                  <modifications expression="{{-120,50},{-100,70}}" elementName="extent"/>
                </modifications>
              </annotations>
