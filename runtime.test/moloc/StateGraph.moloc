        </elements>
        <elements xsi:type="mOloc:EquationSection">
          <equations xsi:type="mOloc:ConnectEquation" isAnnotation="true" isAnnotationOver="true" left="tank1.outflow1" right="valve2.outflow1">
            <annotations isModificationOver="true" elementName="Line">
              <modifications expression="{{50,33.75},{50,26.875},{46.5,26.875},{46.5,16.5}}" elementName="points"/>
              <modifications expression="0.5" elementName="thickness"/>
