<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Turbojet Stage Analysis'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::ScalarQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::DimensionOneValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="'Thermodynamic Functions'">
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Ideal Gas Law'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="rho"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="R_bar"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="T"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="p" valuePart="rho * R_bar * T"/>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Reversible Adiabatic Compression Density'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="rho_1"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p_1"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p_2"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="gamma"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="rho_2" valuePart="rho_1 * (p_2 / p_1)^(1/gamma)"/>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Reversible Adiabatic Compression Temperature'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="T_1"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p_1"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p_2"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="gamma"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="T_2" valuePart="T_1 * (p_2 / p_1)**((gamma - 1) / gamma)"/>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Total Pressure'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="P_static"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="rho"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="V"/>
        <resultExpressionParameter resultExpression="1/2 * rho * V^2 + P_static"/>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Showing explicit parameter typing&#xA;"/>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Total Temperature'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="T_static">
          <typings>TemperatureValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="Cp">
          <typings>DimensionOneValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="V">
          <typings>VolumeValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" valuePart="1/(2 * Cp) * V^2 + T_static">
          <typings>TemperatureValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'Total Enthalpy'">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="h_total"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="h_static"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="V"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="H_total" valuePart="1/2 * V^2 + h_static"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Thermodynamics Structure'">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Ideal Gas Parcel'">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;            The parcel is an infinitesimal volume used to analyze points in a flow&#xA;&#x9;            */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Molar Mass'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Density'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Pressure'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Temperature'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Enthalpy'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Specific Gas Constant'"/>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Moving Ideal Gas Parcel'">
        <superclassifiers>'Ideal Gas Parcel'</superclassifiers>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;            Stagnation pressure is the pressure of the parcel if the kinetic energy defined by its&#xA;&#x9;            velocity in a given coordinate frame is converted to gas internal energy through deceleration&#xA;&#x9;            to a velocity that matches the current frame.&#xA;&#x9;            */">
          <annotatedElement>'Stagnation Pressure'</annotatedElement>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Stagnation Pressure'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Stagnation Temperature'"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Stagnation Enthalpy'"/>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;            Static pressure is the pressure of the parcel as it moves&#xA;&#x9;            */">
          <annotatedElement>'Static Pressure'</annotatedElement>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Static Pressure'">
          <redefinitions>'Ideal Gas Parcel'::'Pressure'</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Static Temperature'">
          <redefinitions>'Ideal Gas Parcel'::'Temperature'</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'Static Enthalpy'">
          <redefinitions>'Ideal Gas Parcel'::'Enthalpy'</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionDefinition" declaredName="'Thermodynamic Process'"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// need start and end shots to show beginning and end attributes&#xA;"/>
      <elements xsi:type="sysMLOC:ActionDefinition" declaredName="'Adiabatic Process'">
        <superclassifiers>'Thermodynamic Process'</superclassifiers>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;        Thermodynamic process typically have their states defined at beginning and end&#xA;&#x9;        of the process (since these starts are path-independent)&#xA;&#x9;        */"/>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="'Stage 1'">
          <redefinitions>start</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="'Stage 2'">
          <redefinitions>done</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionDefinition" declaredName="'Reversible Adiabatic Process'">
        <superclassifiers>'Adiabatic Process'</superclassifiers>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Low-Pressure Compressor Analysis'">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="'Analysis Context'">
        <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Thermodynamic Functions'" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="'Inlet Gas'">
          <typings>'Thermodynamics Structure'::'Moving Ideal Gas Parcel'</typings>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Explicit binding notation&#xA;"/>
          <elements xsi:type="sysMLOC:CalculationUsage" declaredName="'Solve for Pressure1'">
            <typings>'Ideal Gas Law'</typings>
          </elements>
          <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
            <connectorPart refElement="'Density'"/>
            <connectorPart refElement="'Solve for Pressure1'.rho"/>
          </elements>
          <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
            <connectorPart refElement="'Specific Gas Constant'"/>
            <connectorPart refElement="'Solve for Pressure1'.R_bar"/>
          </elements>
          <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
            <connectorPart refElement="'Static Temperature'"/>
            <connectorPart refElement="'Solve for Pressure1'.T"/>
          </elements>
          <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
            <connectorPart refElement="'Static Pressure'"/>
            <connectorPart refElement="'Solve for Pressure1'.p"/>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Shorthand parameter binding notation&#xA;"/>
          <elements xsi:type="sysMLOC:CalculationUsage" declaredName="'Solve for Pressure2'">
            <typings>'Ideal Gas Law'</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="rho" valuePart="'Density'"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="R_bar" valuePart="'Specific Gas Constant'"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="T" valuePart="'Static Temperature'"/>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Invocation expression notation&#xA;"/>
          <elements xsi:type="sysMLOC:AttributeUsage" valuePart="'Ideal Gas Law'('Density', 'Specific Gas Constant', 'Static Temperature')">
            <redefinitions>'Static Pressure'</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Equation as a constraint (note &quot;==&quot;)&#xA;"/>
          <elements xsi:type="sysMLOC:ConstraintUsage">
            <resultExpressionParameter resultExpression="'Static Pressure' == 'Ideal Gas Law'('Density', 'Specific Gas Constant', 'Static Temperature')"/>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
