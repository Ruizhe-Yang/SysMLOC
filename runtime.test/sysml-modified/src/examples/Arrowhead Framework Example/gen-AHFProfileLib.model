<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="AHFProfileLib" isLibrary="true">
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Systems and Services and their functionalities&#xA;"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Design level&#xA;"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="SD">
      <elements xsi:type="sysMLOC:Documentation" body="/* Service definition */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="serviceDefinition">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="serviceURL">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="intrfce_protocol">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// which may be &quot;REST&quot; or &quot;MQTT&quot; etc.&#x9;&#x9; &#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SysLocalCloudsDesign">
      <elements xsi:type="sysMLOC:Documentation" body="/* System of Systems Definition */"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// System of Local Clouds &#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="locclouds" MultiLow="1" MultiHigh="*">
        <typings>LocalCloudDesign</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="system_of_systems">
      <typings>SysLocalCloudsDD</typings>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// defining a top level usage&#xA;"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LocalCloudDesign">
      <elements xsi:type="sysMLOC:Documentation" body="/* Local Cloud definition */"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="systems" MultiLow="1" MultiHigh="*">
        <typings>SysD</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SysD">
      <elements xsi:type="sysMLOC:Documentation" body="/* System definitions */"/>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="services" MultiLow="1" MultiHigh="*">
        <typings>SD</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="systemname">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="address">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="portno">
        <typings>Integer</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Design Description level&#xA;"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="IDD">
      <superclassifiers>SD</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* Interface Design Description of services */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="encoding_kind">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="SDDD">
      <superclassifiers>SD</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* Service Definition Design Description */"/>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="idds" MultiLow="*">
        <typings>IDD</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// nested protocol-specific services&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SysLocalCloudsDD">
      <superclassifiers>SysLocalCloudsDesign</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* System of Systems Detailed Description */"/>
      <elements xsi:type="sysMLOC:PartUsage" MultiLow="1" MultiHigh="*">
        <typings>LocalCloudDD</typings>
        <redefinitions>locclouds</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// the descriptions&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LocalCloudDD">
      <superclassifiers>LocalCloudDesign</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" MultiLow="1" MultiHigh="*">
        <typings>SysDD</typings>
        <redefinitions>systems</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SysDD">
      <superclassifiers>SysD</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* System Detailed Description */"/>
      <elements xsi:type="sysMLOC:PortUsage">
        <typings>SDDD</typings>
        <redefinitions>services</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="ServiceMethod" MultiLow="1" MultiHigh="*"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="//means general behaviors&#xA;"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="AHFProfileMetadata" isLibrary="true">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AHFProfileLib" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PortUsage" declaredName="global_sd">
      <typings>SD</typings>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="service" declaredName="SDMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType = system_of_systems.locclouds.systems.services meta SysML::PortUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType = SysD::services meta SysML::PortUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true" valuePart="global_sd meta SysML::PortUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="sos" declaredName="SysLocalCloudsMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="system_of_systems meta SysML::PartUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="cloud" declaredName="LocalCloudsMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true" valuePart="system_of_systems::locclouds meta SysML::PartUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="system" declaredName="SysDMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true" valuePart="system_of_systems::locclouds::systems meta SysML::PartUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType default LocalCloudDesign::systems meta SysML::PartUsage;&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="idd" declaredName="IDDMetadata">
      <superclassifiers>SDMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType = system_of_systems.locclouds.systems.services.idd meta SysML::PortUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="SDDD::idds meta SysML::PortUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> global_sddd.idd;&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PortUsage" declaredName="global_sddd">
      <typings>SDDD</typings>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="servicedd" declaredName="SDDDMetadata">
      <superclassifiers>SDMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType = system_of_systems.locclouds.systems.services meta SysML::PortUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="global_sddd meta SysML::PortUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="clouddd" declaredName="LocalCloudsDDMetadata">
      <superclassifiers>LocalCloudsMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="system_of_systems::locclouds meta SysML::PartUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="global_clouddd">
      <typings>LocalCloudDD</typings>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="global_systemsdd">
      <typings>SysDD</typings>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="systemdd" declaredName="SysDDMetadata">
      <superclassifiers>SysDMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// :>> baseType = system_of_systems.locclouds.systems meta SysML::PartUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="//:>> baseType = LocalCloudDD::systems meta SysML::PartUsage;&#xA;"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="global_systemsdd meta SysML::PartUsage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
