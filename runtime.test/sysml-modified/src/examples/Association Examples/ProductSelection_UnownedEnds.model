<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="ProductSelection_UnownedEnds_SysML">
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SelectionInfo"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ShoppingCart">
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="selectedProducts" MultiLow="0" MultiHigh="*">
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Product">
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="inCart" MultiLow="0" MultiHigh="1">
        <typings>ShoppingCart</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="ProductSelection">
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="info" MultiLow="1">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
        <crosses>selectedProduct.inCart</crosses>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <typings>Product</typings>
        <crosses>cart.selectedProducts</crosses>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="SingleProductSelection">
      <superclassifiers>ProductSelection</superclassifiers>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="cart" MultiLow="1">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="selectedProduct" MultiLow="1">
        <crossEndUsage MultiLow="0" MultiHigh="1"/>
        <typings>Product</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="OnlineCustomer">
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="info1">
        <typings>SelectionInfo</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="myCart" MultiLow="1">
        <typings>ShoppingCart</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="products" MultiLow="0" MultiHigh="*">
        <typings>Product</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" declaredName="ps1">
        <typings>ProductSelection</typings>
        <connectorPart refElement="myCart"/>
        <connectorPart refElement="products"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" declaredName="ps2">
        <typings>ProductSelection</typings>
        <connectorPart MultiLow="1" refElement="myCart"/>
        <connectorPart MultiLow="1" refElement="products"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="info1">
          <redefinitions>info</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
