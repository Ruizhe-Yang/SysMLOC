<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="PictureTaking">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Exposure"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="Focus">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="xrsl">
        <typings>Exposure</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="Shoot">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="xsf">
        <typings>Exposure</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="takePicture">
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="focus" MultiLow="1">
        <typings>Focus</typings>
      </elements>
      <elements xsi:type="sysMLOC:FlowUsage">
        <itemFeatureParameter payloadFeatureElement="Exposure"/>
        <FlowEnd>focus.xrsl</FlowEnd>
        <FlowEnd>shoot.xsf</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="shoot" MultiLow="1">
        <typings>Shoot</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
