<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="MedicalDeviceFailure">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="CauseAndEffect" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="medicalDevice">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="battery">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="depleted"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="cannotBeCharged"/>
      </elements>
      <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="deviceFails"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="patient">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="therapyDelayed"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <prefixMetadataExtension>#multicausation</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
          <prefixMetadataExtension>#cause</prefixMetadataExtension>
          <references>battery.depleted</references>
        </elements>
        <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
          <prefixMetadataExtension>#cause</prefixMetadataExtension>
          <references>battery.cannotBeCharged</references>
        </elements>
        <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true">
          <prefixMetadataExtension>#effect</prefixMetadataExtension>
          <references>deviceFails</references>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <prefixMetadataExtension>#causation</prefixMetadataExtension>
        <connectorPart refElement="deviceFails"/>
        <connectorPart refElement="patient.therapyDelayed"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
