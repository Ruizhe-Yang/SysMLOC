<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="CarWithEnvelopingShape">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ShapeItems::Box"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::mm"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Car">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Example car with simple enveloping shape that is a solid box&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="boundingBox" MultiLow="1">
        <typings>Box</typings>
        <subsetting>boundingShapes</subsetting>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="4800 [mm]">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1840 [mm]">
          <redefinitions>width</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1350 [mm]">
          <redefinitions>height</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
