<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="PrivateImportTest">
    <elements xsi:type="sysMLOC:Package" declaredName="P1">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="A"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="P2">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="P1" isNamespace="true"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="x">
      <typings>P1::A</typings>
    </elements>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P2" isNamespace="true"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// This should fail.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// A is not visible, because the import in P2 is private.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// part y: A;&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// part y1: P2::A;&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:Package" declaredName="P3">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="B"/>
    </elements>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="P3" isNamespace="true"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// This should not fail.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Private import only restricts visibility outside the package.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="z">
      <typings>B</typings>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="P4">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" isImportAll="true" declaredName="P2" isNamespace="true"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// This should not fail because &quot;import all&quot; overrides private import.&#xD;&#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="z1">
        <typings>A</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
