<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="CircularImport">
    <elements xsi:type="sysMLOC:Package" declaredName="P1">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P2" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="A"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="P2">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P1" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="B"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Test1">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P1" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="x">
        <typings>A</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="y">
        <typings>B</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Test2">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P2" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="x">
        <typings>A</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="y">
        <typings>B</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="x">
      <typings>P1::A</typings>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// The following should not fail.&#xA;"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="y">
      <typings>P1::B</typings>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
