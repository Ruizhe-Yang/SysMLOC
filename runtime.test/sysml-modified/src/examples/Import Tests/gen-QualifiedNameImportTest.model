<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="QualifiedNameImportTest">
    <elements xsi:type="sysMLOC:Package" declaredName="P1">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="A"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="P2">
      <elements xsi:type="sysMLOC:Package" declaredName="P2a">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="P1" isNamespace="true"/>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// The following should not fail.&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// A is a member of P2a because of the import.&#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="x">
        <typings>P2a::A</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
