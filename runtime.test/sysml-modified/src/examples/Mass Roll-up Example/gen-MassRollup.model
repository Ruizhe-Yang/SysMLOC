<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="MassRollup">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="NumericalFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="MassedThing">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="totalMass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="simpleThing">
      <typings>MassedThing</typings>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="mass">
        <redefinitions>totalMass</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="compositeThing">
      <typings>MassedThing</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="subcomponents" MultiLow="*">
        <typings>MassedThing</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="mass + sum(subcomponents.totalMass)">
        <redefinitions>totalMass</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="filteredMassThing">
      <subsetting>compositeThing</subsetting>
      <elements xsi:type="sysMLOC:AttributeUsage" isAbstract="true" declaredName="minMass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="mass + sum(subcomponents.totalMass.?{ in p :> ISQ::mass; p > minMass } )">
        <redefinitions>totalMass</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
