<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VerificationMetadataExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VerificationCases" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VerificationMethodKind" isNamespace="true"/>
    <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="MassTest"/>
    <elements xsi:type="sysMLOC:VerificationCaseUsage" declaredName="massTests">
      <typings>MassTest</typings>
      <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="VerificationMethod">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="kind" valuePart="(test,demo)"/>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage"/>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="weighVehicle">
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="VerificationMethod">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="kind" valuePart="analyze"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
