<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="AllocationTest">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Logical">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="component"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Physical">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="assembly">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="element"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="l">
      <typings>Logical</typings>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>component</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="p">
      <typings>Physical</typings>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>assembly</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>element</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AllocationUsage">
        <connectorPart refElement="l.component"/>
        <connectorPart refElement="assembly.element"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="A"/>
    <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="Logical_to_Physical">
      <superclassifiers>A</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="logical" isEnd="true">
        <typings>Logical</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="physical" isEnd="true">
        <typings>Physical</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage" declaredName="allocation1">
      <typings>Logical_to_Physical</typings>
      <connectorPart refElement="l"/>
      <connectorPart refElement="p"/>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage" declaredName="allocation2">
      <typings>Logical_to_Physical</typings>
      <connectorPart refElement="l" delcaredName="logical"/>
      <connectorPart refElement="p" delcaredName="physical"/>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage">
      <connectorPart refElement="l.component"/>
      <connectorPart refElement="p.assembly.element"/>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
