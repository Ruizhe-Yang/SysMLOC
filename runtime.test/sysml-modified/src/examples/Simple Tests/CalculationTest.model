<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="CalculationExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="NumericalFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehiclePart">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <typings>MassValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <superclassifiers>VehiclePart</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>VehiclePart</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trans">
        <typings>VehiclePart</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="ms.totalMass">
        <references>m</references>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="MassSum">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" MultiLow="0" MultiHigh="*">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="totalMass" valuePart="sum(partMasses)">
        <typings>MassValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationUsage" declaredName="ms">
      <typings>MassSum</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" valuePart="(vehicle.eng.m, vehicle.trans.m)"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="totalMass"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicles" MultiLow="*" valuePart="(vehicle, vehicle)"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="masses1" MultiLow="*" valuePart="(vehicles as VehiclePart).m"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="masses2" MultiLow="*" valuePart="(vehicles as vehicle).m"/>
  </elements>
</sysMLOC:RootNamespace>
