<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VerificationTest">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="V">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="m">
        <typings>ScalarValues::Integer</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vv">
      <typings>V</typings>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="R">
      <elements xsi:type="sysMLOC:Documentation" body="/* ... */"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="r">
      <typings>R</typings>
    </elements>
    <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="VerificationCase">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v">
        <typings>V</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <elements xsi:type="sysMLOC:RequirementVerificationUsage">
          <typings>R</typings>
        </elements>
      </elements>
      <resultExpressionParameter resultExpression="VerificationCases::PassIf(v.m == 0)"/>
    </elements>
    <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="VerificationPlan">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v">
        <typings>V</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <elements xsi:type="sysMLOC:RequirementVerificationUsage" refElement="r"/>
      </elements>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" declaredName="verificationCase">
        <typings>VerificationCase</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="verificationContext">
      <elements xsi:type="sysMLOC:VerificationCaseUsage" declaredName="verificationPlan">
        <typings>VerificationPlan</typings>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="v" valuePart="vv"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
