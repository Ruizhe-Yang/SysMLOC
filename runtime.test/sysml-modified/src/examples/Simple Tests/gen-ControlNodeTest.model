<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ControlNodeTest">
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="A1"/>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="J"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="A2">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="a"/>
    </elements>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="J"/>
    </elements>
    <elements xsi:type="sysMLOC:FlowUsage">
      <FlowEnd>A2.a</FlowEnd>
      <FlowEnd>F.a</FlowEnd>
    </elements>
    <elements xsi:type="sysMLOC:CommonNode" declaredName="J" nodeKind="join"/>
    <elements xsi:type="sysMLOC:CommonNode" isThen="true" declaredName="F" nodeKind="fork">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="a"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="b1"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="b2"/>
    </elements>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="B1"/>
    </elements>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="B2"/>
    </elements>
    <elements xsi:type="sysMLOC:FlowUsage">
      <FlowEnd>F.b1</FlowEnd>
      <FlowEnd>B1.b</FlowEnd>
    </elements>
    <elements xsi:type="sysMLOC:FlowUsage">
      <FlowEnd>F.b2</FlowEnd>
      <FlowEnd>B2.b</FlowEnd>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="B1">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="b"/>
    </elements>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="M"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="B2">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="b"/>
    </elements>
    <elements xsi:type="sysMLOC:ThenNode">
      <thenElement refElement="M"/>
    </elements>
    <elements xsi:type="sysMLOC:CommonNode" declaredName="M"/>
  </elements>
</sysMLOC:Namespace>
