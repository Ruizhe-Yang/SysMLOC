<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="TextualRepresentationTest">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="C">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="x_constraint">
        <elements xsi:type="sysMLOC:TextualRepresentation" declaredName="inOCL" language="&quot;ocl&quot;" body="/* self.x > 0.0 */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="setX">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="c">
        <typings>C</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="newX">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:TextualRepresentation" language="&quot;alf&quot;" body="/* c.x = newX;&#xA;&#x9;         * WriteLine(&quot;Set new x&quot;);&#xA;&#x9;         */"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
