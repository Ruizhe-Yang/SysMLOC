<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="UseCaseTest">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="System"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="User"/>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="UseSystem">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="system">
        <typings>System</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="user">
        <typings>User</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <elements xsi:type="sysMLOC:Comment" body="/* Goal */"/>
      </elements>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" declaredName="uc1">
        <typings>UC1</typings>
      </elements>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" declaredName="uc2">
        <elements xsi:type="sysMLOC:SubjectUsage" valuePart="system"/>
        <elements xsi:type="sysMLOC:ActorUsage" declaredName="user" valuePart="UseSystem::user"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="UC1"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="user">
      <typings>User</typings>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="uc2">
      <elements xsi:type="sysMLOC:SubjectUsage"/>
      <elements xsi:type="sysMLOC:ActorUsage">
        <redefinitions>user</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="u">
      <typings>UseSystem</typings>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="system">
      <typings>System</typings>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" refElement="uc2"/>
      <elements xsi:type="sysMLOC:PerformActionUsage" refElement="u"/>
      <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="uc1">
        <typings>UC1</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="uc3">
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" refElement="u"/>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" refElement="system.uc1"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
