<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="HSUVDynamics">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Horsepwr">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Weight">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Accel">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Vel">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Dist">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Time">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="PowerEquation">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="whlpwr">
        <typings>Horsepwr</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="Cd">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="Cf">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tw">
        <typings>Weight</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tp">
        <typings>Horsepwr</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v">
        <typings>Vel</typings>
      </elements>
      <resultExpressionParameter resultExpression="tp == whlpwr - Cd * v - Cf * tw * v"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="PositionEquation">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dt">
        <typings>Time</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>Vel</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>Dist</typings>
      </elements>
      <resultExpressionParameter resultExpression="(1..size(x)-1)->forAll{ in n : Natural; x#(n + 1) == x#(n) + v#(n) * (5280/3600) * dt }"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="VelocityEquation">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dt">
        <typings>Time</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>Vel</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="a">
        <typings>Accel</typings>
      </elements>
      <resultExpressionParameter resultExpression="(1..size(v)-1)->forAll{ in n: Natural; v#(n + 1) == v#(n) + a * 32 * (3600/5280) * dt }"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="AccelerationEquation">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tw">
        <typings>Weight</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dt">
        <typings>Time</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tp">
        <typings>Horsepwr</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="a">
        <typings>Accel</typings>
      </elements>
      <resultExpressionParameter resultExpression="a == (550/32) * tp * dt * tw"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="StraightLineVehicleDynamics">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dt">
        <typings>Time</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="whlpwr">
        <typings>Horsepwr</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="Cd">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="Cf">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tw">
        <typings>Weight</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="a">
        <typings>Accel</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>Vel</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>Dist</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="pwr">
        <typings>PowerEquation</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::whlpwr">
          <redefinitions>whlpwr</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::Cd">
          <redefinitions>Cd</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::Cf">
          <redefinitions>Cf</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::tw">
          <redefinitions>tw</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="vel.v">
          <redefinitions>v</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>tp</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="acc">
        <typings>AccelerationEquation</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="pwr.tp">
          <redefinitions>tp</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::tw">
          <redefinitions>tw</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::dt">
          <redefinitions>dt</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::a">
          <redefinitions>a</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="vel">
        <typings>VelocityEquation</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="acc.a">
          <redefinitions>a</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::v">
          <redefinitions>v</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::dt">
          <redefinitions>dt</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="pos">
        <typings>PositionEquation</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="vel.v">
          <redefinitions>v</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::x">
          <redefinitions>x</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="StraightLineVehicleDynamics::dt">
          <redefinitions>dt</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
