<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Comment Example'">
    <elements xsi:type="sysMLOC:Comment" body="/* This is a comment, which is a part of the model, &#xA;&#x9; * annotating (by default) it's owning namespace. */"/>
    <elements xsi:type="sysMLOC:Comment" declaredName="Comment1" body="/* This is a named comment. */"/>
    <elements xsi:type="sysMLOC:Comment" body="/* This is an unnamed comment, annotating an &#xA;&#x9; * explicitly specified element. &#xA;&#x9; */">
      <annotatedElement>Automobile</annotatedElement>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Automobile"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="Car" memberElement="Automobile">
      <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9; * This is a comment annotating its owning&#xA;&#x9;&#x9; * element.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// This is a note. It is in the text, but not part &#xA;"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// of the model.&#xA;"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="Torque" memberElement="ISQ::TorqueValue"/>
  </elements>
</sysMLOC:RootNamespace>
