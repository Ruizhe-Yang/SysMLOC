<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Redefinition Example'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SmallVehicle">
      <superclassifiers>Vehicle</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="smallEng">
        <typings>SmallEngine</typings>
        <redefinitions>eng</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="BigVehicle">
      <superclassifiers>Vehicle</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="bigEng">
        <typings>BigEngine</typings>
        <redefinitions>eng</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="cyl" MultiLow="4" MultiHigh="6">
        <typings>Cylinder</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SmallEngine">
      <superclassifiers>Engine</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" MultiLow="4">
        <redefinitions>cyl</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="BigEngine">
      <superclassifiers>Engine</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" MultiLow="6">
        <redefinitions>cyl</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cylinder"/>
  </elements>
</sysMLOC:Namespace>
