<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Port Example'">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Temp"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Fuel"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="FuelOutPort">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="temperature">
        <typings>Temp</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="fuelSupply">
        <typings>Fuel</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelReturn">
        <typings>Fuel</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="FuelInPort">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="temperature">
        <typings>Temp</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelSupply">
        <typings>Fuel</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="fuelReturn">
        <typings>Fuel</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="FuelTankAssembly">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelTankPort">
        <typings>FuelOutPort</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="engineFuelPort2222">
        <typings>FuelInPort</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
