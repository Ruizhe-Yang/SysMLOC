<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Flow Usage Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Port Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="tankAssy">
        <typings>FuelTankAssembly</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:FlowUsage">
        <itemFeatureParameter payloadFeatureElement="Fuel"/>
        <FlowEnd>tankAssy.fuelTankPort.fuelSupply</FlowEnd>
        <FlowEnd>eng.engineFuelPort.fuelSupply</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:FlowUsage">
        <itemFeatureParameter payloadFeatureElement="Fuel"/>
        <FlowEnd>eng.engineFuelPort.fuelReturn</FlowEnd>
        <FlowEnd>tankAssy.fuelTankPort.fuelReturn</FlowEnd>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
