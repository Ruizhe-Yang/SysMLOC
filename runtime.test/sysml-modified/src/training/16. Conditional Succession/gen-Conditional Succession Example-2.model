<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Conditional Succession Example-2'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Scene"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Image">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isWellFocused">
        <typings>ScalarValues::Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Picture"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="Focus">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="scene">
        <typings>Scene</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="image">
        <typings>Image</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="Shoot">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="image">
        <typings>Image</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="picture">
        <typings>Picture</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="TakePicture">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="scene">
        <typings>Scene</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="picture">
        <typings>Picture</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="takePicture">
      <typings>TakePicture</typings>
      <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="scene"/>
      <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="picture"/>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="focus">
        <typings>Focus</typings>
        <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="scene" valuePart="takePicture::scene"/>
        <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="image"/>
      </elements>
      <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="focus.image.isWellFocused">
        <transitionSuccessionElement refElement="shoot"/>
      </elements>
      <elements xsi:type="sysMLOC:FlowUsage">
        <FlowEnd>focus.image</FlowEnd>
        <FlowEnd>shoot.image</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="shoot">
        <typings>Shoot</typings>
        <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="image"/>
        <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="picture" valuePart="takePicture::picture"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
