<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Terminate Actions Example-1'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="monitorCriticalActivity"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="criticalActivity"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="waitForTimeOut"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="MonitoredActivity">
      <elements xsi:type="sysMLOC:InitialNode" memberElement="start"/>
      <elements xsi:type="sysMLOC:CommonNode" isThen="true" nodeKind="fork"/>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="performCriticalActivity"/>
      </elements>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="waitForTimeOut"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="performCriticalActivity">
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="monitorCriticalActivity"/>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="criticalActivity"/>
        <elements xsi:type="sysMLOC:TerminateNode" isThen="true" isSemicolon="true"/>
      </elements>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="stop"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="waitForTimeOut"/>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="stop"/>
      </elements>
      <elements xsi:type="sysMLOC:TerminateNode" declaredName="stop" isSemicolon="true"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
