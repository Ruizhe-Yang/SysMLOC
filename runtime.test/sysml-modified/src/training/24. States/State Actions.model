<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'State Actions'">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleStartSignal"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleOnSignal"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="VehicleOffSignal"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="performSelfTest">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:StateDefinition" declaredName="VehicleStates">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="operatingVehicle">
        <typings>Vehicle</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" declaredName="vehicleStates">
      <typings>VehicleStates</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="operatingVehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:EntryActionNode"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <transitionSuccessionElement refElement="off"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="off"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="VehicleStartSignal"/>
        <transitionSuccessionElement refElement="starting"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="starting"/>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="VehicleOnSignal"/>
        <transitionSuccessionElement refElement="on"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="on">
        <elements xsi:type="sysMLOC:EntryActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="performSelfTest"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="vehicle" valuePart="operatingVehicle"/>
        </elements>
        <elements xsi:type="sysMLOC:DoActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="providePower"/>
          <elements xsi:type="sysMLOC:Comment" body="/* ... */"/>
        </elements>
        <elements xsi:type="sysMLOC:ExitActionNode">
          <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="applyParkingBrake"/>
          <elements xsi:type="sysMLOC:Comment" body="/* ... */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:TransitionUsage">
        <acceptParameter payloadFeatureElement="VehicleOffSignal"/>
        <transitionSuccessionElement refElement="off"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
