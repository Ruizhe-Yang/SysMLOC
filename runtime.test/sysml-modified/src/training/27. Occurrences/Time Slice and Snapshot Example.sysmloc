<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Time Slice and Snapshot Example'">
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Date"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Person"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:PortionUsage" declaredName="assembly" portionKind="timeslice"/>
      <elements xsi:type="sysMLOC:SuccessionAsUsage">
        <connectorPart refElement="assembly"/>
        <connectorPart refElement="delivery"/>
      </elements>
      <elements xsi:type="sysMLOC:PortionUsage" declaredName="delivery" portionKind="snapshot">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="deliveryDate">
          <typings>Date</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PortionUsage" isThen="true" declaredName="ownership" MultiLow="0" MultiHigh="*" isOrdered="true" portionKind="timeslice">
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="sale" valuePart="start" portionKind="snapshot"/>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="owner" MultiLow="1">
          <typings>Person</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="driven" MultiLow="0" MultiHigh="*" portionKind="timeslice">
          <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="driver" MultiLow="1">
            <typings>Person</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PortionUsage" declaredName="junked" valuePart="done" portionKind="snapshot"/>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
