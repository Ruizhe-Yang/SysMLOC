<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Individuals and Roles'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Part Definition Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
    <elements xsi:type="sysMLOC:PartDefinition" isIndividual="true" declaredName="Vehicle_1">
      <superclassifiers>Vehicle</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="leftFrontWheel">
        <typings>Wheel</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="rightFrontWheel">
        <typings>Wheel</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" isIndividual="true" declaredName="Wheel_1">
      <superclassifiers>Wheel</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" isIndividual="true" declaredName="vehicle_1">
      <typings>Vehicle_1</typings>
      <elements xsi:type="sysMLOC:PartUsage" portionKind="snapshot" declaredName="vehicle_1_t0">
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="leftFrontWheel_t0" portionKind="snapshot">
          <typings>Wheel_1</typings>
          <redefinitions>leftFrontWheel</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isThen="true" portionKind="snapshot" declaredName="vehicle_1_t1">
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="rightFrontWheel_t1" portionKind="snapshot">
          <typings>Wheel_1</typings>
          <redefinitions>rightFrontWheel</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
