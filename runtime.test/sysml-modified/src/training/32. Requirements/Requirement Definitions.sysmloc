<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Requirement Definitions'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MassLimitationRequirement">
      <elements xsi:type="sysMLOC:Documentation" body="/* The actual mass shall be less than or equal to the required mass. */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massActual">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massReqd">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
        <resultExpressionParameter resultExpression="massActual &lt;= massReqd"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="dryMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelFullMass">
        <typings>MassValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredShortName="'1'" declaredName="VehicleMassLimitationRequirement">
      <superclassifiers>MassLimitationRequirement</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/* The total mass of a vehicle shall be less than or equal to the required mass. */"/>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="vehicle.dryMass + vehicle.fuelMass">
        <redefinitions>massActual</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage">
        <resultExpressionParameter resultExpression="vehicle.fuelMass > 0[kg]"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="ClutchPort"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="GenerateTorque"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredShortName="'2'" declaredName="DrivePowerInterface">
      <elements xsi:type="sysMLOC:Documentation" body="/* The engine shall transfer its generated torque to the transmission via the clutch interface. */"/>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="clutchPort">
        <typings>ClutchPort</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredShortName="'3'" declaredName="TorqueGeneration">
      <elements xsi:type="sysMLOC:Documentation" body="/* The engine shall generate torque as a function of RPM as shown in Table 1. */"/>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="generateTorque">
        <typings>GenerateTorque</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
