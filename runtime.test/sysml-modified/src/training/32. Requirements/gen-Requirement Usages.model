<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Requirement Usages'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Requirement Definitions'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'1.1'" declaredName="fullVehicleMassLimit">
      <typings>VehicleMassLimitationRequirement</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="2000[kg]">
        <redefinitions>massReqd</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage">
        <elements xsi:type="sysMLOC:Documentation" body="/* Full tank is full. */"/>
        <resultExpressionParameter resultExpression="vehicle.fuelMass == vehicle.fuelFullMass"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'1.2'" declaredName="emptyVehicleMassLimit">
      <typings>VehicleMassLimitationRequirement</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="1500[kg]">
        <redefinitions>massReqd</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage">
        <elements xsi:type="sysMLOC:Documentation" body="/* Full tank is empty. */"/>
        <resultExpressionParameter resultExpression="vehicle.fuelMass == 0[kg]"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
