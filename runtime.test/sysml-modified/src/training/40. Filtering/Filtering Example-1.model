<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Filtering Example-1'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Safety">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isMandatory">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="interior">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="alarm"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="seatBelt" MultiLow="2">
          <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="true"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontSeat" MultiLow="2"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="driverAirBag">
          <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="false"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="bodyAssy">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="body"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="bumper">
          <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="true"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="keylessEntry"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="wheelAssy">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="wheel" MultiLow="2"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="antilockBrakes" MultiLow="2">
          <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="false"/>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Safety Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Mandatory Safety Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety AND are mandatory. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@Safety and Safety::isMandatory"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
