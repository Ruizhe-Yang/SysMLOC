<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="'Model Library Example'" isLibrary="true">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RiskMetadata::Level"/>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" isAbstract="true" declaredName="Situation"/>
    <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="situations" MultiLow="*" isNonunique="true">
      <typings>Situation</typings>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" isAbstract="true" declaredName="Cause">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="probability">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="causes" MultiLow="*" isNonunique="true">
      <typings>Cause</typings>
      <subsetting>situations</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" isAbstract="true" declaredName="Failure">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="severity">
        <typings>Level</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="failures" MultiLow="*" isNonunique="true">
      <typings>Failure</typings>
      <subsetting>situations</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" isAbstract="true" declaredName="Causation">
      <superclassifiers>Occurrences::HappensBefore</superclassifiers>
      <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="cause">
        <crossEndUsage MultiLow="*"/>
        <typings>Situation</typings>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="effect">
        <crossEndUsage MultiLow="*"/>
        <typings>Situation</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="causations" MultiLow="*" isNonunique="true">
      <typings>Causation</typings>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Scenario">
      <elements xsi:type="sysMLOC:OccurrenceUsage">
        <redefinitions>situations</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage">
        <subsetting>situations</subsetting>
        <redefinitions>causes</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage">
        <subsetting>situations</subsetting>
        <redefinitions>failures</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemUsage" declaredName="scenarios" MultiLow="*" isNonunique="true">
      <typings>Scenario</typings>
    </elements>
  </elements>
</sysMLOC:Namespace>
