<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="'Semantic Metadata Example'" isLibrary="true">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Model Library Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="situation">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="situations meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="cause">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="causes meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="failure">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="failures meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="causation">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="causations meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="scenario">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="scenarios meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
