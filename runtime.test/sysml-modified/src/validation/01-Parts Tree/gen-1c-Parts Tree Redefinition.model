<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'1c-Parts Tree Redefinition'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::kg"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="FrontAxle">
        <superclassifiers>Axle</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="steeringAngle">
          <typings>ScalarValues::Real</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Usages">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Definitions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass" isDefault="true" valuePart="1750 [kg]">
          <redefinitions>Vehicle::mass</redefinitions>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The mass attribute is redefined to give it a default value.&#xA;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle">
            <typings>Axle</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel" MultiLow="2" isOrdered="true">
            <typings>Wheel</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
            <typings>Axle</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel" MultiLow="2" isOrdered="true">
            <typings>Wheel</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1_c1">
        <subsetting>vehicle1</subsetting>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * 'vehicle1_c1' is a specialization of 'vehicle1' (technically &#xA;&#x9;&#x9;&#x9; * a subset). It inherits all the parts of 'vehicle1' and&#xA;&#x9;&#x9;&#x9; * only needs to specify additional or redefined parts.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass" valuePart="2000 [kg]">
          <redefinitions>vehicle1::mass</redefinitions>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The mass is further redefined to override the default value&#xA;&#x9;&#x9;&#x9;&#x9; * with a bound value for 'vehicle_c1'.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly_c1">
          <redefinitions>frontAxleAssembly</redefinitions>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle_c1">
            <typings>FrontAxle</typings>
            <redefinitions>frontAxle</redefinitions>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * 'frontAxle_c1' redefines 'frontAxleAssembly'::'frontAxle'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * to give it a new name and the specialized type&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * 'FrontAxle'.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * 'frontWheel' is inherited from 'vehicle1'::'frontAxleAssembly',&#xA;&#x9;&#x9;&#x9;&#x9; * allowing it to be used in the following part declarations.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel_1" valuePart="frontWheel#(1)">
            <subsetting>frontWheel</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel_2" valuePart="frontWheel#(2)">
            <subsetting>frontWheel</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly_c1">
          <redefinitions>rearAxleAssembly</redefinitions>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle_c1">
            <redefinitions>rearAxle</redefinitions>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * 'rearAxle_c1' redefines 'rearAxleAssembly'::'rearAxle'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * to give it a new name. It inherits the type 'Axle'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * from the redefined part.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel_1" valuePart="rearWheel#(1)">
            <subsetting>rearWheel</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel_2" valuePart="rearWheel#(2)">
            <subsetting>rearWheel</subsetting>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
