<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'2a-Parts Interconnection'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Definitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Usages" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Port Definitions&#xA;"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="FuelCmdPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="DrivePwrPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="ClutchPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_a"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_b"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_c"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="ShaftPort_d"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="DiffPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="AxlePort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="AxleToWheelPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="WheelToAxlePort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="WheelToRoadPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="VehicleToRoadPort">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * A port definition can have nested ports.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="wheelToRoadPort" MultiLow="2">
          <typings>WheelToRoadPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Blocks&#xA;"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleA">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelCmdPort">
          <typings>FuelCmdPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="vehicleToRoadPort">
          <typings>VehicleToRoadPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="RearAxleAssembly">
        <superclassifiers>AxleAssembly</superclassifiers>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="shaftPort_d">
          <typings>ShaftPort_d</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="RearAxle">
        <superclassifiers>Axle</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="HalfAxle">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="axleToDiffPort">
          <typings>AxlePort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="axleToWheelPort">
          <typings>AxleToWheelPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="fuelCmdPort">
          <typings>FuelCmdPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="drivePwrPort">
          <typings>DrivePwrPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="clutchPort">
          <typings>ClutchPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="shaftPort_a">
          <typings>ShaftPort_a</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Driveshaft">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="shaftPort_b">
          <typings>ShaftPort_b</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="shaftPort_c">
          <typings>ShaftPort_c</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Differential">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * Ports do not have to be defined on part defs.&#xA;&#x9;&#x9;&#x9; * They can be added directly to their usages.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Interface Definitions&#xA;"/>
      <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="EngineToTransmissionInterface">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * The ends of an interface definition are always ports.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="drivePwrPort" isEnd="true">
          <typings>DrivePwrPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="clutchPort" isEnd="true">
          <typings>ClutchPort</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="DriveshaftInterface">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="shaftPort_a" isEnd="true">
          <typings>ShaftPort_a</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="shaftPort_d" isEnd="true">
          <typings>ShaftPort_d</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="driveshaft">
          <typings>Driveshaft</typings>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * 'driveshaft' is a reference to the driveshaft that will&#xA;&#x9;&#x9;&#x9;&#x9; * act as the &quot;interface medium&quot; for this interface.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <connectorPart refElement="shaftPort_a"/>
          <connectorPart refElement="driveshaft.shaftPort_b"/>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The two ends of 'DriveShaftInterface' are always connected&#xA;&#x9;&#x9;&#x9;&#x9; * via the referenced 'driveshaft'.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <connectorPart refElement="driveshaft.shaftPort_c"/>
          <connectorPart refElement="shaftPort_d"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Usages">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1_c1">
        <typings>VehicleA</typings>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="fuelCmdPort"/>
          <connectorPart refElement="engine.fuelCmdPort"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
          <typings>Engine</typings>
        </elements>
        <elements xsi:type="sysMLOC:InterfaceUsage">
          <typings>EngineToTransmissionInterface</typings>
          <connectorPart refElement="engine.drivePwrPort"/>
          <connectorPart refElement="transmission.clutchPort"/>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * A usage of an interface definition connects two ports relative to &#xA;&#x9;&#x9;&#x9;&#x9; * a containing context.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
          <typings>Transmission</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="driveshaft">
          <typings>Driveshaft</typings>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * This 'driveshaft' is the part of 'vehicle1_c1' that will act as the&#xA;&#x9;&#x9;&#x9;&#x9; * interface medium in the following 'DriveshaftInterface' usage.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:InterfaceUsage">
          <typings>DriveshaftInterface</typings>
          <connectorPart refElement="transmission.shaftPort_a"/>
          <connectorPart refElement="rearAxleAssembly.shaftPort_d"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="vehicle1_c1.driveshaft">
            <redefinitions>driveshaft</redefinitions>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * The reference property from 'DriveshaftInterface' is redefined&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * in order to bind it to the appropriate part of 'vehicle1_c1'.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
          <typings>RearAxleAssembly</typings>
          <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
            <connectorPart refElement="shaftPort_d"/>
            <connectorPart refElement="differential.shaftPort_d"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="differential">
            <typings>Differential</typings>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="shaftPort_d">
              <typings>ShaftPort_d</typings>
              <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * If the part def has no ports, then they can be defined directly in&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * a usage of the part def.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="leftDiffPort">
              <typings>DiffPort</typings>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="rightDiffPort">
              <typings>DiffPort</typings>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:InterfaceUsage">
            <connectorPart refElement="differential.leftDiffPort"/>
            <connectorPart refElement="rearAxle.leftHalfAxle.axleToDiffPort"/>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * A connection can be to a port that is arbitrarily deeply nested, on either end. &#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:InterfaceUsage">
            <connectorPart refElement="differential.rightDiffPort"/>
            <connectorPart refElement="rearAxle.rightHalfAxle.axleToDiffPort"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
            <typings>RearAxle</typings>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="leftHalfAxle">
              <typings>HalfAxle</typings>
            </elements>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="rightHalfAxle">
              <typings>HalfAxle</typings>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ConnectionUsage">
            <connectorPart refElement="rearAxle.leftHalfAxle.axleToWheelPort"/>
            <connectorPart refElement="leftWheel.wheelToAxlePort"/>
          </elements>
          <elements xsi:type="sysMLOC:ConnectionUsage">
            <connectorPart refElement="rearAxle.rightHalfAxle.axleToWheelPort"/>
            <connectorPart refElement="rightWheel.wheelToAxlePort"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel" MultiLow="2" isOrdered="true">
            <typings>Wheel</typings>
          </elements>
          <elements xsi:type="sysMLOC:Comment" body="/* The two rear wheels of 'rearAxleAssembly' must be given&#xA;&#x9;&#x9;&#x9;&#x9; * their own names in order to be referenced in connections.&#xA;&#x9;&#x9;&#x9;&#x9; * &#xA;&#x9;&#x9;&#x9;&#x9; * (&quot;:>&quot; is a shorthand here for &quot;subsets&quot;.)&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="leftWheel" valuePart="rearWheel#(1)">
            <subsetting>rearWheel</subsetting>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="wheelToAxlePort">
              <typings>WheelToAxlePort</typings>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="wheelToRoadPort">
              <typings>WheelToRoadPort</typings>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rightWheel" valuePart="rearWheel#(2)">
            <subsetting>rearWheel</subsetting>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="wheelToAxlePort">
              <typings>WheelToAxlePort</typings>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="wheelToRoadPort">
              <typings>WheelToRoadPort</typings>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="rearAxleAssembly.leftWheel.wheelToRoadPort"/>
          <connectorPart refElement="vehicleToRoadPort.leftWheelToRoadPort"/>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="rearAxleAssembly.rightWheel.wheelToRoadPort"/>
          <connectorPart refElement="vehicleToRoadPort.rightWheelToRoadPort"/>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="vehicleToRoadPort">
          <redefinitions>VehicleA::vehicleToRoadPort</redefinitions>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="leftWheelToRoadPort" valuePart="wheelToRoadPort#(1)">
            <subsetting>wheelToRoadPort</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:PortUsage" declaredName="rightWheelToRoadPort" valuePart="wheelToRoadPort#(2)">
            <subsetting>wheelToRoadPort</subsetting>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
