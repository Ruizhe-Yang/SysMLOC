<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'3e-Function-based Behavior-item'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Definitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="VehicleAssembly"/>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="AssembledVehicle">
        <superclassifiers>VehicleAssembly</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
        <superclassifiers>AssembledVehicle</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Usages">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="AssemblyLine">
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="'assemble vehicle'">
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="'assemble transmission into vehicle'">
            <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="'vehicle assy without transmission or engine'">
              <typings>VehicleAssembly</typings>
            </elements>
            <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="transmission">
              <typings>Transmission</typings>
              <elements xsi:type="sysMLOC:Comment" body="/* Note: A part can be treated as an item. */"/>
            </elements>
            <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="'vehicle assy without engine'" valuePart="'vehicle assy without transmission or engine'">
              <typings>VehicleAssembly</typings>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission" valuePart="'assemble transmission into vehicle'.transmission">
                <typings>Transmission</typings>
                <elements xsi:type="sysMLOC:Comment" body="/* Note: An item can become a part of something else. */"/>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:FlowUsage">
            <FlowEnd>'assemble transmission into vehicle'.'vehicle assy without engine'</FlowEnd>
            <FlowEnd>'assemble engine into vehicle'.'vehicle assy without engine'</FlowEnd>
          </elements>
          <elements xsi:type="sysMLOC:ActionUsage" declaredName="'assemble engine into vehicle'">
            <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="'vehicle assy without engine'">
              <typings>VehicleAssembly</typings>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
                <typings>Transmission</typings>
              </elements>
            </elements>
            <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="engine">
              <typings>Engine</typings>
            </elements>
            <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="assembledVehicle" valuePart="'vehicle assy without engine'">
              <typings>AssembledVehicle</typings>
              <elements xsi:type="sysMLOC:PartUsage" declaredName="engine" valuePart="'assemble engine into vehicle'.engine">
                <typings>Engine</typings>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="'assemble vehicle'.'assemble engine into vehicle'.assembledVehicle"/>
          <connectorPart refElement="vehicle"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
          <typings>Vehicle</typings>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * Note: An in item one context can become a part in an other.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
            <typings>Transmission</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
            <typings>Engine</typings>
          </elements>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="providePower"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
