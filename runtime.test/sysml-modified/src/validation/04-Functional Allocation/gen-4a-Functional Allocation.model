<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'4a-Functional Allocation'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'2a-Parts Interconnection'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'3a-Function-based Behavior-1'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'3a-Function-based Behavior-1'::'provide power'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1_c1_functional_allocation">
      <subsetting>vehicle1_c1</subsetting>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Note: The definitions of the port types in '2a-Parts Interconnection' do not include &#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// flow properties.&#xA;"/>
      <elements xsi:type="sysMLOC:PortUsage">
        <redefinitions>fuelCmdPort</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fuelCmd">
          <typings>FuelCmd</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PerformActionUsage" refElement="'provide power'">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This allocates the action '3a-Function-based Behavior-1'::'provide power' as an enacted &#xA;&#x9;&#x9; * performance of 'vehicle_c1_functional_allocation'.&#xA;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// This assigns the fuelCmdPort to provide the input to 'provide power'.&#xA;"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fuelCmd" valuePart="fuelCmdPort.fuelCmd"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>engine</redefinitions>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>fuelCmdPort</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fuelCmd">
            <typings>FuelCmd</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="'provide power'.'generate torque'">
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; *  This allocates one of the sub-steps of 'provide power' to a sub-part of vehicle_c1. &#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fuelCmd" valuePart="fuelCmdPort.fuelCmd"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="engineTorque" valuePart="drivePwrPort.engineTorque"/>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>drivePwrPort</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="engineTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>transmission</redefinitions>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>clutchPort</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="engineTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="'provide power'.'amplify torque'">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engineTorque" valuePart="clutchPort.engineTorque"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="transmissionTorque" valuePart="shaftPort_a.transmissionTorque"/>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>shaftPort_a</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="transmissionTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>driveshaft</redefinitions>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>shaftPort_b</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transmissionTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="'provide power'.'transfer torque'">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transmissionTorque" valuePart="shaftPort_b.transmissionTorque"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="driveshaftTorque" valuePart="shaftPort_c.driveshaftTorque"/>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>shaftPort_c</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="driveshaftTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>rearAxleAssembly</redefinitions>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>shaftPort_d</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="driveshaftTorque">
            <typings>Torque</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="'provide power'.'distribute torque'">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="driveshaftTorque" valuePart="shaftPort_d.driveshaftTorque"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelTorque1" valuePart="rearAxle.leftHalfAxle.axleToWheelPort.wheelTorque"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelTorque2" valuePart="rearAxle.rightHalfAxle.axleToWheelPort.wheelTorque"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>rearAxle</redefinitions>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>leftHalfAxle</redefinitions>
            <elements xsi:type="sysMLOC:PortUsage">
              <redefinitions>axleToWheelPort</redefinitions>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelTorque">
                <typings>Torque</typings>
              </elements>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>rightHalfAxle</redefinitions>
            <elements xsi:type="sysMLOC:PortUsage">
              <redefinitions>axleToWheelPort</redefinitions>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="wheelTorque">
                <typings>Torque</typings>
              </elements>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
