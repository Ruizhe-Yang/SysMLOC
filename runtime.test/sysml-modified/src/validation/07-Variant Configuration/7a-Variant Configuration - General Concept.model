<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'7a-Variant Configuration - General Concept'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part1"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part2"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part3"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part4"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part5"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part6"/>
    <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="anyVehicleConfig">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="subsystemA">
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem1">
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part1</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part2</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem2">
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part2</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part3</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="subsystemB">
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem3">
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part4</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part5</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem4">
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part5</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part6</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="subsystemA != subsystemA::subsystem2 | subsystemB == subsystemB::subsystem3"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleConfigA">
      <subsetting>anyVehicleConfig</subsetting>
      <elements xsi:type="sysMLOC:PartUsage" valuePart="subsystemA::subsystem1">
        <redefinitions>subsystemA</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" valuePart="subsystemB::subsystem3">
        <redefinitions>subsystemB</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="VehicleConfigB">
      <subsetting>anyVehicleConfig</subsetting>
      <elements xsi:type="sysMLOC:PartUsage" valuePart="subsystemA::subsystem2">
        <redefinitions>subsystemA</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" valuePart="subsystemB::subsystem3">
        <redefinitions>subsystemB</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
