<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'9-Verification-simplified'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VerificationCases" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Definitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:RequirementDefinition" declaredShortName="'2'" declaredName="MassRequirement">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massActual">
          <subsetting>ISQ::mass</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="massReqd">
          <subsetting>ISQ::mass</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:Documentation" body="/* The actual mass shall be less than or equal to the required mass limit. */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
          <resultExpressionParameter resultExpression="massActual &lt;= massReqd"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="MassVerificationSystem"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Scale"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="TestOperator"/>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="TestVehicle1" isIndividual="true">
        <superclassifiers>Vehicle</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="TestVehicle2" isIndividual="true">
        <superclassifiers>Vehicle</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="TestSystem" isIndividual="true">
        <superclassifiers>MassVerificationSystem</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:VerificationCaseDefinition" declaredName="MassTest">
        <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="massVerificationObjective">
          <elements xsi:type="sysMLOC:RequirementVerificationUsage" declaredName="massRequirement">
            <typings>MassRequirement</typings>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Usages">
      <elements xsi:type="sysMLOC:RequirementUsage" declaredShortName="'2.1'" declaredName="vehicleMassRequirement">
        <typings>MassRequirement</typings>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
          <typings>Vehicle</typings>
        </elements>
        <elements xsi:type="sysMLOC:Documentation" body="/* The vehicle mass shall be less than or equal to 2500 kg. */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="vehicle.mass">
          <redefinitions>massActual</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2500 [SI::kg]">
          <redefinitions>massReqd</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1_c2">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// ...&#xA;"/>
      </elements>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" declaredName="vehicleMassTest">
        <typings>MassTest</typings>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="testVehicle">
          <typings>Vehicle</typings>
        </elements>
        <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="vehicleMassVerificationObjective">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// The subject of the verify is automatically bound to 'testVehicle' here.&#xA;"/>
          <elements xsi:type="sysMLOC:RequirementVerificationUsage" refElement="vehicleMassRequirement">
            <redefinitions>massRequirement</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="collectData">
          <elements xsi:type="sysMLOC:PartUsage" direction="in" declaredName="testVehicle" valuePart="vehicleMassTest.testVehicle">
            <typings>Vehicle</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="massMeasured">
            <subsetting>ISQ::mass</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="processData">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="massMeasured" valuePart="collectData.massMeasured">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="massProcessed">
            <subsetting>ISQ::mass</subsetting>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="evaluateData">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="massProcessed" valuePart="processData.massProcessed">
            <subsetting>ISQ::mass</subsetting>
          </elements>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Check that 'testVehicle' statisfies 'vehicleMassRequirement' if its mass equals 'massProcessed'.&#xA;"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="verdict" valuePart="PassIf(vehicleMassRequirement(vehicle = new testVehicle(mass = massProcessed)))">
            <typings>VerdictKind</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="verdict" valuePart="evaluateData.verdict">
          <typings>VerdictKind</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="massVerificationSystem">
        <typings>MassVerificationSystem</typings>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="vehicleMassTest">
          <elements xsi:type="sysMLOC:PartUsage" direction="in" valuePart="vehicleUnderTest">
            <redefinitions>testVehicle</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="vehicleUnderTest">
          <typings>Vehicle</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="testOperator">
          <typings>TestOperator</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="scale">
          <typings>Scale</typings>
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="vehicleMassTest.collectData">
            <elements xsi:type="sysMLOC:PartUsage" direction="in">
              <redefinitions>testVehicle</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:CodeAnnotation" body="// In reality, this would be some more involved process.&#xA;"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="measurement" valuePart="testVehicle.mass"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" valuePart="measurement">
              <redefinitions>massMeasured</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:IndividualUsage" declaredName="testSystem" isIndividual="true">
        <typings>TestSystem</typings>
        <subsetting>massVerificationSystem</subsetting>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="test1" portionKind="timeslice">
          <elements xsi:type="sysMLOC:IndividualUsage" isReference="true" isIndividual="true">
            <typings>TestVehicle1</typings>
            <subsetting>vehicle1_c2</subsetting>
            <redefinitions>vehicleUnderTest</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2500 [SI::kg]">
              <redefinitions>mass</redefinitions>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortionUsage" isThen="true" declaredName="test2" portionKind="timeslice">
          <elements xsi:type="sysMLOC:IndividualUsage" isReference="true" isIndividual="true">
            <typings>TestVehicle2</typings>
            <subsetting>vehicle1_c2</subsetting>
            <redefinitions>vehicleUnderTest</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2500 [SI::kg]">
              <redefinitions>mass</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
