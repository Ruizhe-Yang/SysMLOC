<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'10d-Dynamics Analysis'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="VehicleModel">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="DynamicsModel">
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Acceleration">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p">
          <typings>PowerValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="m">
          <typings>MassValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v">
          <typings>SpeedValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" valuePart="p / (m * v)">
          <typings>AccelerationValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Velocity">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v0">
          <typings>SpeedValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="a">
          <typings>AccelerationValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="dt">
          <typings>TimeValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" valuePart="v0 + a * dt">
          <typings>SpeedValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Position">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x0">
          <typings>LengthValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v">
          <typings>SpeedValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="dt">
          <typings>TimeValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" valuePart="x0 + v * dt">
          <typings>LengthValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionDefinition" declaredName="StraightLineDynamics">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="power">
          <typings>PowerValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass">
          <typings>MassValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="delta_t">
          <typings>TimeValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_in">
          <typings>LengthValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_in">
          <typings>SpeedValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="x_out" valuePart="Position(x_in, v_in, delta_t)">
          <typings>LengthValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="v_out" valuePart="Velocity(v_in, a_out, delta_t)">
          <typings>SpeedValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="a_out" valuePart="Acceleration(power, mass, v_in)">
          <typings>AccelerationValue</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="AnalysisModel">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VehicleModel" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="DynamicsModel" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SampledFunctions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions" isNamespace="true"/>
      <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="DynamicsAnalysis">
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
          <typings>Vehicle</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="powerProfile" MultiLow="*">
          <subsetting>ISQ::power</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="initialPosition">
          <subsetting>ISQ::length</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="initialSpeed">
          <subsetting>ISQ::speed</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="deltaT">
          <subsetting>ISQ::time</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="accelerationProfile" MultiLow="*" isInitial="true" valuePart="()">
          <subsetting>ISQ::acceleration</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="position" isInitial="true" valuePart="initialPosition"/>
        <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="speed" isInitial="true" valuePart="initialSpeed"/>
        <elements xsi:type="sysMLOC:ForLoopNode" forNodeParameter="1..powerProfile->size()-1">
          <forVariableParameter declaredName="i"/>
          <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="dynamics">
            <typings>StraightLineDynamics</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="power" valuePart="powerProfile#(i)"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass" valuePart="vehicle.mass"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="delta_t" valuePart="deltaT"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_in" valuePart="position"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_in" valuePart="speed"/>
          </elements>
          <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" featureChain="position" NodeParameter="dynamics.x_out"/>
          <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" featureChain="speed" NodeParameter="dynamics.v_out"/>
          <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" featureChain="accelerationProfile" NodeParameter="accelerationProfile->including(dynamics.a_out)"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
