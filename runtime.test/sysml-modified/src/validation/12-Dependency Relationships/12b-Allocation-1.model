<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'12b-Allocation-1'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RequirementModel" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="LogicalModel" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="PhysicalModel" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="RequirementModel">
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="torqueGeneration">
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="generator">
          <typings>TorqueGenerator</typings>
        </elements>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
          <resultExpressionParameter resultExpression="generator.generateTorque.torque > 0.0 [N*m]"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="LogicalModel">
      <elements xsi:type="sysMLOC:ActionDefinition" declaredName="GenerateTorque">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="torque">
          <subsetting>ISQ::torque</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="LogicalElement"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="TorqueGenerator">
        <superclassifiers>LogicalElement</superclassifiers>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="generateTorque">
          <typings>GenerateTorque</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="providePower">
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="generateTorque">
          <typings>GenerateTorque</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="torqueGenerator">
        <typings>TorqueGenerator</typings>
        <elements xsi:type="sysMLOC:PerformActionUsage" refElement="providePower.generateTorque">
          <redefinitions>generateTorque</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" refElement="torqueGeneration" satisfactionParameter="torqueGenerator"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="PhysicalModel">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="PhysicalElement"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="PowerTrain">
        <superclassifiers>PhysicalElement</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="powerTrain">
        <typings>PowerTrain</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
          <elements xsi:type="sysMLOC:PerformActionUsage" refElement="providePower.generateTorque"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="LogicalToPhysical">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="logical" isEnd="true">
        <typings>LogicalElement</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="physical" isEnd="true">
        <typings>PhysicalElement</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage" declaredName="torqueGenAlloc">
      <typings>LogicalToPhysical</typings>
      <connectorPart refElement="torqueGenerator" delcaredName="logical"/>
      <connectorPart refElement="powerTrain" delcaredName="physical"/>
      <elements xsi:type="sysMLOC:AllocationUsage">
        <connectorPart refElement="torqueGenerator.generateTorque"/>
        <connectorPart refElement="powerTrain.engine.generateTorque"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
