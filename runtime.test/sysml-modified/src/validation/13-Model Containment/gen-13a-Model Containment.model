<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'13a-Model Containment'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'2a-Parts Interconnection'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'8-Requirements'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="BodyAndInteriorRequirements">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="MassLimitationRequirement"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="PowerTrainRequirements"/>
    <elements xsi:type="sysMLOC:Package" declaredName="'Vehicle Model'">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This package is used to represent a top-level &quot;model&quot;.&#xA;&#x9;&#x9; * There is no specific syntax for identifying a package&#xA;&#x9;&#x9; * used in this way.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:Package" declaredName="'Vehicle1-Configuration'">
        <elements xsi:type="sysMLOC:AliasElement" memberName="'Sport Sedan'" memberElement="vehicle1_c1"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="'vehicle1_c1 Specification Context'::'vehicle1-c1 Specification'"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="'Vehicle Reference Model'">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * This package is used to represent a &quot;model library&quot;.&#xA;&#x9;&#x9;&#x9; * There is no specific syntax for identifying a package&#xA;&#x9;&#x9;&#x9; * used in this way.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleA"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="VehicleSubsystems"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="VehicleSubsystems">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="'Body&amp;Interior'"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="'PowerTrain'"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="'Body&amp;Interior'">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="BodyAndInteriorRequirements"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="PowerTrain">
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Engine"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Transmission"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="PowerTrainRequirements"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
