<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'14b-Language-Extensions'">
    <elements xsi:type="sysMLOC:Package" declaredName="LibraryModel">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="ECU"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="UserModel">
      <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
        <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="LibraryModel" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleControlUnit">
          <superclassifiers>ECU</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="EngineControlUnit">
          <superclassifiers>ECU</superclassifiers>
        </elements>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="CanBus"/>
        <elements xsi:type="sysMLOC:PortDefinition" declaredName="BusIF"/>
      </elements>
      <elements xsi:type="sysMLOC:Package" declaredName="Usages">
        <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Definitions" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1">
          <typings>Vehicle</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleControlUnit">
            <typings>VehicleControlUnit</typings>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="busIF">
              <typings>~BusIF</typings>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ConnectionUsage">
            <connectorPart refElement="vehicleControlUnit.busIF"/>
            <connectorPart refElement="canBus.vehicleControlIF"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="canBus">
            <typings>CanBus</typings>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="vehicleControlIF">
              <typings>BusIF</typings>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="engineControlIF">
              <typings>BusIF</typings>
            </elements>
            <elements xsi:type="sysMLOC:PortUsage" declaredName="sensorIF">
              <typings>BusIF</typings>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:ConnectionUsage">
            <connectorPart refElement="engine.engineControlUnit.busIF"/>
            <connectorPart refElement="canBus.engineControlIF"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
            <typings>Engine</typings>
            <elements xsi:type="sysMLOC:PartUsage" declaredName="engineControlUnit">
              <typings>EngineControlUnit</typings>
              <elements xsi:type="sysMLOC:PortUsage" declaredName="busIF">
                <typings>~BusIF</typings>
              </elements>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
