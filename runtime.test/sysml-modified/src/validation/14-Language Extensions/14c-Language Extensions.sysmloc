<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'14c-Language-Extensions'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:LibraryPackage" declaredName="FMEALibrary" isLibrary="true">
      <elements xsi:type="sysMLOC:OccurrenceDefinition" isAbstract="true" declaredName="Situation"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="situations" MultiLow="*" isNonunique="true">
        <typings>Situation</typings>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="Cause">
        <superclassifiers>Situation</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="occurs" MultiLow="0" MultiHigh="1">
          <typings>Real</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="causes" MultiLow="*" isNonunique="true">
        <typings>Cause</typings>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="FailureMode">
        <superclassifiers>Situation</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="detected" MultiLow="0" MultiHigh="1">
          <typings>Real</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="failureModes" MultiLow="*" isNonunique="true">
        <typings>FailureMode</typings>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="Effect">
        <superclassifiers>Situation</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="severity" MultiLow="0" MultiHigh="1">
          <typings>String</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="effects" MultiLow="*" isNonunique="true">
        <typings>Effect</typings>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="FMEAItem">
        <superclassifiers>Situation</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="RPN" MultiLow="0" MultiHigh="1">
          <typings>Real</typings>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage">
          <redefinitions>causes</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage">
          <redefinitions>failureModes</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage">
          <redefinitions>effects</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isAbstract="true" declaredName="fmeaItems" MultiLow="*" isNonunique="true">
        <typings>FMEAItem</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Causation">
        <superclassifiers>Occurrences::HappensBefore</superclassifiers>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="cause">
          <crossEndUsage MultiLow="*"/>
          <typings>Situation</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="effect">
          <crossEndUsage MultiLow="*"/>
          <typings>Situation</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="causations" MultiLow="*" isNonunique="true">
        <typings>Causation</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="FMEARequirement"/>
      <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="fmeaRequirements" MultiLow="*" isNonunique="true">
        <typings>FMEARequirement</typings>
      </elements>
      <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="RequirementWithSIL">
        <superclassifiers>FMEARequirement</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sil">
          <typings>SIL</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="SIL">
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="A"/>
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="B"/>
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="C"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Violation">
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="sit">
          <crossEndUsage MultiLow="*"/>
          <typings>Situation</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="req">
          <crossEndUsage MultiLow="*"/>
          <typings>FMEARequirement</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="violations" MultiLow="*" isNonunique="true">
        <typings>Violation</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionDefinition" isAbstract="true" declaredName="ControllingMeasure">
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="sit">
          <crossEndUsage MultiLow="*"/>
          <typings>Situation</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="req">
          <crossEndUsage MultiLow="*"/>
          <typings>FMEARequirement</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Prevention">
        <superclassifiers>ControllingMeasure</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="preventions" MultiLow="*" isNonunique="true">
        <typings>Prevention</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Mitigation">
        <superclassifiers>ControllingMeasure</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="mitigations" MultiLow="*" isNonunique="true">
        <typings>Mitigation</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:LibraryPackage" declaredName="FMEAMetadata" isLibrary="true">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="FMEALibrary" isNamespace="true"/>
      <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="Status">
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="Approved"/>
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="NotApproved"/>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="StatusHolder">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="status">
          <typings>Status</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="situation" declaredName="SituationMetadata">
        <superclassifiers>SemanticMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isDefault="true" valuePart="situations meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="cause" declaredName="CauseMetadata">
        <superclassifiers>SituationMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="causes meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="failure" declaredName="FailureModeMetadata">
        <superclassifiers>SituationMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="failureModes meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="effect" declaredName="EffectMetadata">
        <superclassifiers>SituationMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="effects meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="fmea" declaredName="FMEAItemMetadata">
        <superclassifiers>SituationMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::ItemDefinition</typings>
          <subsetting>annotatedElement</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::ItemUsage</typings>
          <subsetting>annotatedElement</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="fmeaItems meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="causation" declaredName="CausationMetadata">
        <superclassifiers>SemanticMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::ConnectionUsage</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="causations meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="fmeaspec" declaredName="FMEARequirementMetadata">
        <superclassifiers>SemanticMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::RequirementUsage</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="fmeaRequirements meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="violation" declaredName="ViolationMetadata">
        <superclassifiers>SemanticMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::ConnectionUsage</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="violations meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ControllingMeasureMetadata" isAbstract="true">
        <superclassifiers>SemanticMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <typings>SysML::ConnectionUsage</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="prevention" declaredName="PreventionMetadata">
        <superclassifiers>ControllingMeasureMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="preventions meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="mitigation" declaredName="MitigationMetadata">
        <superclassifiers>ControllingMeasureMetadata</superclassifiers>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="mitigations meta SysML::Usage">
          <redefinitions>baseType</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="FMEAUserModel">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="FMEALibrary" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="FMEAMetadata" isNamespace="true"/>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="req1">
        <prefixMetadataExtension>#fmeaspec</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:Documentation" body="/* Meter designed according to ISO00124 */"/>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="req2">
        <prefixMetadataExtension>#fmeaspec</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:Documentation" body="/* Device working for 1 week without the need to replace batteries */"/>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" declaredName="req3">
        <prefixMetadataExtension>#fmeaspec</prefixMetadataExtension>
        <typings>RequirementWithSIL</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="StatusHolder">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="status" valuePart="Status::Approved"/>
        </elements>
        <elements xsi:type="sysMLOC:Documentation" body="/* Alarm when battery has sank */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="SIL::A">
          <redefinitions>sil</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="'Glucose FMEA Item'">
        <prefixMetadataExtension>#fmea</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <prefixMetadataExtension>#prevention</prefixMetadataExtension>
          <connectorPart refElement="'battery depleted'"/>
          <connectorPart refElement="req1"/>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="'battery depleted'">
          <prefixMetadataExtension>#cause</prefixMetadataExtension>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0.005">
            <redefinitions>occurs</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <prefixMetadataExtension>#causation</prefixMetadataExtension>
          <connectorPart refElement="'battery depleted'"/>
          <connectorPart refElement="'battery cannot be charged'"/>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="'battery cannot be charged'">
          <prefixMetadataExtension>#failure</prefixMetadataExtension>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0.013">
            <redefinitions>detected</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <prefixMetadataExtension>#causation</prefixMetadataExtension>
          <connectorPart refElement="'battery cannot be charged'"/>
          <connectorPart refElement="'glucose level undetected'"/>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="'glucose level undetected'">
          <prefixMetadataExtension>#effect</prefixMetadataExtension>
        </elements>
        <elements xsi:type="sysMLOC:ConnectionUsage">
          <prefixMetadataExtension>#causation</prefixMetadataExtension>
          <connectorPart refElement="'glucose level undetected'"/>
          <connectorPart refElement="'therapy delay'"/>
        </elements>
        <elements xsi:type="sysMLOC:OccurrenceUsage" declaredName="'therapy delay'">
          <prefixMetadataExtension>#effect</prefixMetadataExtension>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;High&quot;">
            <redefinitions>severity</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <prefixMetadataExtension>#violation</prefixMetadataExtension>
        <connectorPart refElement="'Glucose Meter in Use'"/>
        <connectorPart refElement="req2"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <prefixMetadataExtension>#mitigation</prefixMetadataExtension>
        <connectorPart refElement="'Glucose Meter in Use'"/>
        <connectorPart refElement="req3"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="'Glucose Meter in Use'">
        <prefixMetadataExtension>#fmea</prefixMetadataExtension>
        <typings>'Glucose FMEA Item'</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="'glucose meter'">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="'glucose level undetected'" MultiLow="*"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="battery">
            <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="'battery depleted'" MultiLow="*"/>
            <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="'battery cannot be charged'" MultiLow="*"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="pump"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="reservoir"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="patient">
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="'therapy delay'" MultiLow="*"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
