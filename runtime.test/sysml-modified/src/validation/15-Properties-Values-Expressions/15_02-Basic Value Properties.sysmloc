<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_02-Basic Value Properties'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="LengthValue">
      <superclassifiers>Real</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Real world user models would use a quantity type&#xA;&#x9;&#x9; * from the library model. A attribute def is defined&#xA;&#x9;&#x9; * here to show that it is possible.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Tire">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="manufacturer">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="hubDiameter">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="width">
        <typings>Integer</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="frenchTire">
      <typings>Tire</typings>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="&quot;Michelin&quot;">
        <redefinitions>manufacturer</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="18.0">
        <redefinitions>hubDiameter</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="245">
        <redefinitions>width</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
