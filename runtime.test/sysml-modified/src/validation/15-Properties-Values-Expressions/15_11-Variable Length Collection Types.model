<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_11-Variable Length Collection Types'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Collections" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="SparePart"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Person"/>
    <elements xsi:type="sysMLOC:Comment" body="/* Examples of declaring syntactic sugar-like names for instantiating collection types. */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'Bag&lt;SparePart>'">
      <superclassifiers>Bag</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true">
        <typings>SparePart</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'List&lt;Integer>'">
      <superclassifiers>List</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="value">
        <typings>Integer</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'Set&lt;String>'">
      <superclassifiers>Set</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>String</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'OrderedSet&lt;Person>'">
      <superclassifiers>OrderedSet</superclassifiers>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true">
        <typings>Person</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'List&lt;Set&lt;Person>>'">
      <superclassifiers>List</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Set</typings>
        <redefinitions>elements</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true">
          <typings>Person</typings>
          <redefinitions>elements</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="'Array&lt;Real>[4]'">
      <superclassifiers>Array</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>elements</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="4">
        <redefinitions>dimensions</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
