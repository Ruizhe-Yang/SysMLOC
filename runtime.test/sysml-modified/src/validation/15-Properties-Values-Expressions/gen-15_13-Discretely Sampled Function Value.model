<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_13-Discretely Sampled Function Value'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SampledFunctions::SampledFunction"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SampledFunctions::SamplePair"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Collections::Array"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MissionElapsedTimeScale">
      <superclassifiers>TimeScale</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="s">
        <redefinitions>unit</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>definitionalEpoch</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;time instant zero at launch&quot;">
          <redefinitions>definition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="definitionalEpochInUTC">
        <typings>Iso8601DateTime</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Map the definitional epoch (t = 0) of this scale to a reference epoch expressed in UTC&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// This modeled as a 1D coordinate transformation (translation only)&#xA;"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>CoordinateFramePlacement</typings>
        <redefinitions>transformation</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="UTC">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="definitionalEpochInUTC">
          <redefinitions>origin</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1 [UTC]">
          <redefinitions>basisDirections</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mets">
      <typings>MissionElapsedTimeScale</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Define mission elapsed time scale starting at given UTC date time (in microsecond resolution)&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <redefinitions>definitionalEpochInUTC</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;2020-08-23T22:42:32.924534Z&quot;">
          <redefinitions>val</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MissionElapsedTimeValue">
      <superclassifiers>TimeInstantValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Define scalar quantity value type for mission elapsed time&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="mets">
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="spatialCF" MultiLow="1">
      <typings>CartesianSpatial3dCoordinateFrame</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Define Cartesian 3D coordinate systems for position and velocity&#xA;&#x9;&#x9; * Create a velocity coordinate system from the spatial coordinate system through division by second&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(m, m, m)">
        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocityCF" MultiLow="1" valuePart="spatialCF/s">
      <typings>CartesianVelocity3dCoordinateFrame</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PositionAndVelocity">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="position" MultiLow="1">
        <typings>CartesianPosition3dVector</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity" MultiLow="1">
        <typings>CartesianVelocity3dVector</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AscentProfile">
      <superclassifiers>SampledFunction</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AscentSample">
        <superclassifiers>SamplePair</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
          <typings>MissionElapsedTimeValue</typings>
          <redefinitions>domainValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
          <typings>PositionAndVelocity</typings>
          <redefinitions>rangeValue</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="*" isOrdered="true">
        <typings>AscentSample</typings>
        <redefinitions>samples</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="ascentProfile1">
      <typings>AscentProfile</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/* Example ascent profile */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sample1">
        <typings>AscentSample</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0.0 [mets]">
          <redefinitions>domainValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="pv1">
          <redefinitions>rangeValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pv1">
          <typings>PositionAndVelocity</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0, 0, 0) [spatialCF]">
            <redefinitions>position</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0, 0, 0) [velocityCF]">
            <redefinitions>velocity</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sample2">
        <typings>AscentSample</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2.5 [mets]">
          <redefinitions>domainValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="pv1">
          <redefinitions>rangeValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pv1">
          <typings>PositionAndVelocity</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0.01, 0.03, 8.6) [spatialCF]">
            <redefinitions>position</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0, 0, 5.5) [velocityCF]">
            <redefinitions>velocity</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sample3">
        <typings>AscentSample</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="5.1 [mets]">
          <redefinitions>domainValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="pv1">
          <redefinitions>rangeValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pv1">
          <typings>PositionAndVelocity</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0.04, 0.12, 18.6) [spatialCF]">
            <redefinitions>position</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(0.05, 0.03, 25.3) [velocityCF]">
            <redefinitions>velocity</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="(sample1, sample2, sample3)">
        <redefinitions>samples</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
