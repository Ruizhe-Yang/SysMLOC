<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="JohnIndividualExample">
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Person">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This is the definition of the class of persons, each of whom has an age.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="age">
        <typings>ScalarValues::Natural</typings>
      </elements>
      <elements xsi:type="sysMLOC:PortionUsage" declaredName="asPresident" MultiLow="0" MultiHigh="*" portionKind="timeslice">
        <typings>Person</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * These are the periods during which a Person is president.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isIndividual="true" declaredName="John">
      <superclassifiers>Person</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This the definition of the individual Person who is John.&#xA;&#x9;&#x9; * There is at most one such person.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Country">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This is the definition of the class of countries, each of which may have &#xA;&#x9;&#x9; * at most one president (at any point in time).&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="presidentOfCountry" MultiLow="0" MultiHigh="1">
        <typings>Person</typings>
        <subsetting>presidentOfCountry.asPresident</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isIndividual="true" declaredName="UnitedStates">
      <superclassifiers>Country</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * This is the definition of the individual country that is the&#xA;&#x9;&#x9; * United States. It contains a single instance. The United States&#xA;&#x9;&#x9; * always has a president who must be at least 35 years old.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="presidentOfUS" MultiLow="1">
        <redefinitions>presidentOfCountry</redefinitions>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <resultExpressionParameter resultExpression="age >= 35"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:IndividualUsage" declaredName="UnitedStatesWithJohnAsPresident" isIndividual="true">
      <typings>UnitedStates</typings>
      <elements xsi:type="sysMLOC:ItemUsage" portionKind="timeslice" declaredName="UnitedStatesWhenJohnIsPresident" MultiLow="*">
        <typings>UnitedStates</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;    &#x9;&#x9; * These are the time slices of the United States during&#xA;    &#x9;&#x9; * which John is president of the United States.&#xA;    &#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <typings>John</typings>
          <redefinitions>presidentOfUS</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
