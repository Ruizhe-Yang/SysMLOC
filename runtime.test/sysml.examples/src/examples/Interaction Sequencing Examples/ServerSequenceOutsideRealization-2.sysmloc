<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="ServerSequenceOutsideRealization_2">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ServerSequenceModelOutside" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Configuration" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Configuration">
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="PublicationPort"/>
      <elements xsi:type="sysMLOC:PortDefinition" declaredName="SubscriptionPort"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="producer_2" MultiLow="1">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="someTopic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" visibility="private" declaredName="somePublication"/>
        <elements xsi:type="sysMLOC:Comment" body="/* Requiring FIFO sort (as opposed to just default) to make arrival/leave ordering&#xA;&#x9;&#x9;&#x9; * in ServerSequenceModelOutside.sysml equivalent to accept/send new ordering in&#xA;&#x9;&#x9;&#x9; * ServerSquenceRealization-2.sysml. */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="Occurrences::earlierFirstIncomingTransferSort">
          <redefinitions>incomingTransferSort</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="publicationPort">
          <typings>~PublicationPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="producerBehavior">
          <elements xsi:type="sysMLOC:SendNode" declaredName="publish" sendNodeParameter="new Publish(someTopic, somePublication)" viaNodeParameter="publicationPort"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceUsage">
        <connectorPart refElement="producer_2.publicationPort"/>
        <connectorPart refElement="server_2.publicationPort"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="server_2" MultiLow="1">
        <elements xsi:type="sysMLOC:PortUsage" declaredName="publicationPort">
          <typings>PublicationPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="subscriptionPort">
          <typings>SubscriptionPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="Occurrences::earlierFirstIncomingTransferSort">
          <redefinitions>incomingTransferSort</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="serverBehavior">
          <elements xsi:type="sysMLOC:EntryActionNode"/>
          <elements xsi:type="sysMLOC:TransitionUsage">
            <transitionSuccessionElement refElement="waitForSubscription"/>
          </elements>
          <elements xsi:type="sysMLOC:StateUsage" declaredName="waitForSubscription"/>
          <elements xsi:type="sysMLOC:TransitionUsage" declaredName="subscribing" transitionSourceElement="waitForSubscription">
            <acceptParameter declaredName="sub" isVia="true" viaNodeParameter="subscriptionPort">
              <typings>Subscribe</typings>
            </acceptParameter>
            <transitionSuccessionElement refElement="waitForPublication"/>
          </elements>
          <elements xsi:type="sysMLOC:StateUsage" declaredName="waitForPublication"/>
          <elements xsi:type="sysMLOC:TransitionUsage" declaredName="delivering" conditionalExpression="pub.topic == subscribing.sub.topic" transitionSourceElement="waitForPublication">
            <acceptParameter declaredName="pub" isVia="true" viaNodeParameter="publicationPort">
              <typings>Publish</typings>
            </acceptParameter>
            <performedActionParameterPart xsi:type="sysMLOC:SendActionUsage" sendNodeParameter="new Deliver(pub.publication)" toNodeParameter="subscribing.sub.subscriber"/>
            <transitionSuccessionElement refElement="waitForPublication"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:InterfaceUsage">
        <connectorPart refElement="consumer_2.subscriptionPort"/>
        <connectorPart refElement="server_2.subscriptionPort"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="consumer_2" MultiLow="1">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="myTopic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="Occurrences::earlierFirstIncomingTransferSort">
          <redefinitions>incomingTransferSort</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="subscriptionPort">
          <typings>~SubscriptionPort</typings>
        </elements>
        <elements xsi:type="sysMLOC:PerformActionUsage" declaredName="consumerBehavior">
          <elements xsi:type="sysMLOC:SendNode" declaredName="subscribe" sendNodeParameter="new Subscribe(myTopic, consumer_2)" toNodeParameter="server_2"/>
          <elements xsi:type="sysMLOC:AcceptNode" isThen="true" declaredName="delivery">
            <acceptParameter payloadFeatureElement="Deliver" isVia="true" viaNodeParameter="consumer_2"/>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="realization_2">
      <typings>PubSubSequence</typings>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>producer_2</subsetting>
        <redefinitions>producer</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>server_2</subsetting>
        <redefinitions>server</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <subsetting>consumer_2</subsetting>
        <redefinitions>consumer</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Message">
        <typings>Transfers::MessageTransfer</typings>
        <redefinitions>publish_message</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="producer.publicationPort" isEnd="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="server.publicationPort" isEnd="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Message">
        <typings>Transfers::MessageTransfer</typings>
        <redefinitions>subscribe_message</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="consumer.subscriptionPort" isEnd="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="server.subscriptionPort" isEnd="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Message">
        <typings>Transfers::MessageTransfer</typings>
        <redefinitions>deliver_message</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="server" isEnd="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="consumer" isEnd="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Binding sent/accept messages to specification model messages. */"/>
      <elements xsi:type="sysMLOC:Comment" body="/* Sends */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="producer_2.producerBehavior.publish.sentMessage"/>
        <connectorPart refElement="publish_message"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="consumer_2.consumerBehavior.subscribe.sentMessage"/>
        <connectorPart refElement="subscribe_message"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="server_2.serverBehavior.delivering.effect.sentMessage"/>
        <connectorPart refElement="deliver_message"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Accepts */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="consumer_2.consumerBehavior.delivery.acceptedMessage"/>
        <connectorPart refElement="subscribe_message"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="server_2.serverBehavior.subscribing.accepter.acceptedMessage"/>
        <connectorPart refElement="subscribe_message"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="server_2.serverBehavior.delivering.accepter.acceptedMessage"/>
        <connectorPart refElement="publish_message"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
