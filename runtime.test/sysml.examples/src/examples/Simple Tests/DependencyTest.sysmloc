<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="DependencyTest">
    <elements xsi:type="sysMLOC:Package" declaredName="System">
      <elements xsi:type="sysMLOC:Package" declaredName="'Application Layer'"/>
      <elements xsi:type="sysMLOC:Package" declaredName="'Service Layer'"/>
      <elements xsi:type="sysMLOC:Package" declaredName="'Data Layer'"/>
    </elements>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="System" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Dependency" declaredName="Use">
      <client>'Application Layer'</client>
      <supplier>'Service Layer'</supplier>
    </elements>
    <elements xsi:type="sysMLOC:Dependency">
      <client>'Service Layer'</client>
      <supplier>'Data Layer'</supplier>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="y"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="z"/>
    <elements xsi:type="sysMLOC:Dependency">
      <client>z</client>
      <supplier>x</supplier>
      <supplier>y</supplier>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
