<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Vehicle Decomposition - Updated'">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * Example from the SysML 1.6 spec, subclause 8.4.5 Constraining Decomposition,&#xA;&#x9; * updated for usage-focused approach.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Blocks&#xA;"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Chassis Assembly'"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LugBolt"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="RollBar"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HeavyRollBar">
      <superclassifiers>RollBar</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LightRollBar">
      <superclassifiers>RollBar</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cylinder"/>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Parts&#xA;"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="chs" MultiLow="1">
        <typings>'Chassis Assembly'</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rb" MultiLow="0" MultiHigh="1">
          <typings>RollBar</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="w" MultiLow="4">
          <typings>Wheel</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="lb" MultiLow="6" MultiHigh="10">
            <typings>LugBolt</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng" MultiLow="1">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="cyl" MultiLow="4" MultiHigh="8">
          <typings>Cylinder</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="'vehicle model 1'">
      <subsetting>vehicle</subsetting>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>chs</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" MultiLow="0" MultiHigh="1">
          <typings>LightRollBar</typings>
          <redefinitions>rb</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>w</redefinitions>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>lb</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>eng</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" MultiLow="4">
          <redefinitions>cyl</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Constrains total number of lugbolts.&#xA;"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="lugBolts" MultiLow="24" valuePart="chs.w.lb"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="'vehicle model 2'">
      <subsetting>vehicle</subsetting>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>chs</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" MultiLow="0">
          <redefinitions>rb</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>w</redefinitions>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Constrains number of lugbolts per wheel.&#xA;"/>
          <elements xsi:type="sysMLOC:PartUsage" MultiLow="6" MultiHigh="7">
            <redefinitions>lb</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>eng</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" MultiLow="6" MultiHigh="8">
          <redefinitions>cyl</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
