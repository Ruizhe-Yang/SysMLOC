<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'3c-Function-based Behavior-structure mod-2'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleFrame"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HitchBall"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerCoupler"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Trailer"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerFrame"/>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="TrailerHitch">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="hitch" isEnd="true">
        <typings>HitchBall</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="coupler" isEnd="true">
        <typings>TrailerCoupler</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="'vehicle-trailer system'">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleFrame">
          <typings>VehicleFrame</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="hitch">
            <typings>HitchBall</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" declaredName="trailerHitch" MultiLow="0" MultiHigh="1">
        <typings>TrailerHitch</typings>
        <connectorPart refElement="vehicle.vehicleFrame.hitch"/>
        <connectorPart refElement="trailer.trailerFrame.coupler"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trailer">
        <typings>Trailer</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="trailerFrame">
          <typings>TrailerFrame</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="coupler">
            <typings>TrailerCoupler</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PerformActionUsage">
        <elements xsi:type="sysMLOC:ActionUsage" declaredName="'connect trailer to vehicle'">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Assert that exactly one connection exists during the&#xA;"/>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// performance of this action.&#xA;"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" isAbstract="true" MultiLow="1">
            <redefinitions>trailerHitch</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="'disconnect trailer from vehicle'">
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// Assert that exactly no connection exists during the&#xA;"/>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="// performance of this action.&#xA;"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" isAbstract="true" MultiLow="0">
            <redefinitions>trailerHitch</redefinitions>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
