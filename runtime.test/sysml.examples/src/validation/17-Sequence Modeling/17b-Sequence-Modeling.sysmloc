<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'17b-Sequence-Modeling'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="PayloadDefinitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="PayloadDefinitions">
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Subscribe">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="topic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="subscriber"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Publish">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="topic">
          <typings>String</typings>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="publication"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Deliver">
        <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="publication"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="PubSubSequence">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="producer" MultiLow="1">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="publish_message.sourceEvent"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="publish_message">
        <itemFeatureParameter MultiLow="1" payloadFeatureElement="Publish"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="server" MultiLow="1">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="subscribe_message.targetEvent"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="publish_message.targetEvent"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="deliver_message.sourceEvent"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="subscribe_message">
        <itemFeatureParameter MultiLow="1" payloadFeatureElement="Subscribe"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="deliver_message">
        <itemFeatureParameter MultiLow="1" payloadFeatureElement="Deliver"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="consumer" MultiLow="1">
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="subscribe_message.sourceEvent"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="deliver_message.targetEvent"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
