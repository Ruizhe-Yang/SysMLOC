<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="SpatialItems" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package models physical items that have a spatial extent and act as a spatial frame of reference&#xA;&#x9; * for obtaining position and displacement vectors of points within them.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::Point"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SpatialFrames::SpatialFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::VectorQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::ThreeDCoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::nullTransformation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time::Clock"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time::TimeInstantValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::universalCartesianSpatial3dCoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::Position3dVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::Displacement3dVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VectorFunctions::isZeroVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SpatialItem">
      <superclassifiers>SpatialFrame</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A SpatialItem is an Item with a three-dimensional spatial extent that also acts as a SpatialFrame of reference.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" isReference="true" isDefault="true" valuePart="Time::universalClock">
        <typings>Clock</typings>
        <redefinitions>localClock</redefinitions>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * A local Clock to be used as the corresponding time reference within this SpatialItem. &#xA;&#x9;&#x9;&#x9; * By default this is the singleton universalClock.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="coordinateFrame" isDefault="true" valuePart="universalCartesianSpatial3dCoordinateFrame">
        <typings>ThreeDCoordinateFrame</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;             * The three-dimensional CoordinateFrame to be used as the measurement reference for position &#xA;             * and displacement vector values relative to this SpatialItem.&#xA;             * By default this is the singleton universalCartesianSpatial3dCoordinateFrame.&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="originPoint">
        <typings>Point</typings>
        <subsetting>spaceShots</subsetting>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The Point at the origin of the coordinateFrame of this SpatialItem.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="originPointConstraint">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The CurrentPositionOf the originPoint must always be a zero vector.&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="isZeroVector(CurrentPositionOf(originPoint, that))"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="subSpatialItems">
        <typings>SpatialItem</typings>
        <subsetting>subitems</subsetting>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>*</Multiplicity>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subitems::localClock</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="subSpatialParts">
        <typings>SpatialItem</typings>
        <subsetting>subSpatialItems</subsetting>
        <subsetting>subparts</subsetting>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>*</Multiplicity>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subSpatialItems::localClock</redefinitions>
          <redefinitions>subparts::localClock</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="componentItems">
        <typings>SpatialItem</typings>
        <subsetting>subSpatialItems</subsetting>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>*</Multiplicity>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * A SpatialItem with componentItems is entirely made up of those items (the SpatialItem occurs only&#xA;&#x9;&#x9;&#x9; * as a collection of its componentItems).  By default they have the same localClock and equivalent&#xA;&#x9;&#x9;&#x9; * coordinate frame as the SpatialItem they make up.  A SpatialItem without componentItems occurs&#xA;&#x9;&#x9;&#x9; * on its own, separately from its subitems.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true" isDefault="true" valuePart="(that as SpatialItem).localClock">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subSpatialItems::localClock</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="(that.that as SpatialItem).coordinateFrame.mRefs">
            <redefinitions>mRefs</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="nullTransformation">
            <redefinitions>transformation</redefinitions>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="(that.that.that as SpatialItem).coordinateFrame">
              <redefinitions>source</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="cunionNum" valuePart="if isEmpty(componentItems) ? 0 else 1">
        <typings>Natural</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="componentUnion">
        <subsetting>unionsOf</subsetting>
        <Multiplicity>cunionNum</Multiplicity>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * A SpatialItem with componentItems is is a spatial union of them.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" valuePart="componentItems">
          <typings>SpatialItem</typings>
          <redefinitions>elements</redefinitions>
          <Multiplicity>1</Multiplicity>
          <Multiplicity>*</Multiplicity>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="componentParts">
        <typings>SpatialItem</typings>
        <subsetting>componentItems</subsetting>
        <subsetting>subSpatialParts</subsetting>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>*</Multiplicity>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>componentItems::localClock</redefinitions>
          <redefinitions>subSpatialParts::localClock</redefinitions>
          <redefinitions>subparts::localClock</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="PositionOf">
      <superclassifiers>SpatialFrames::PositionOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * The PositionOf a Point relative to a SpatialItem, at a specific TimeInstantValue relative to a given Clock,&#xA;&#x9;&#x9; * is a positionVector that is a VectorQuantityValue in the coordinateFrame of the SpatialItem.&#xA;&#x9;&#x9; * The default Clock is the localClock of the SpatialItem.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInstant">
        <typings>TimeInstantValue</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enclosingItem">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" isDefault="true" valuePart="enclosingItem.localClock">
        <typings>Clock</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="positionVector">
        <typings>Position3dVector</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="enclosingItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="CurrentPositionOf">
      <superclassifiers>SpatialFrames::CurrentPositionOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * The CurrentPositionOf a Point relative to a SpatialItem and a Clock is the PositionOf&#xA;&#x9;&#x9; * the Point relative to the SpatialItem at the currentTime of the Clock.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enclosingItem">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" isDefault="true" valuePart="enclosingItem.localClock">
        <typings>Clock</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="positionVector">
        <typings>Position3dVector</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="enclosingItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="DisplacementOf">
      <superclassifiers>SpatialFrames::DisplacementOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * The DisplacementOf two Points relative to a SpatialItem, at a specific TimeInstantValue relative to a&#xA;&#x9;&#x9; * given Clock, is the displacementVector computed as the difference between the PositionOf the &#xA;&#x9;&#x9; * first Point and PositionOf the second Point, relative to that SpatialItem, at that timeInstant.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point1">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point2">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInstant">
        <typings>TimeInstantValue</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="spatialItem">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" isDefault="true" valuePart="spatialItem.localClock">
        <typings>Clock</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="displacementVector">
        <typings>Displacement3dVector</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="spatialItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="CurrentDisplacementOf">
      <superclassifiers>SpatialFrames::CurrentDisplacementOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * The CurrentDisplacementOf two Points relative to a SpatialItem and a Clock is the DisplacementOf&#xA;&#x9;&#x9; * the Points relative to the SpatialItem, at the currentTime of the Clock.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point1">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point2">
        <typings>Point</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="spatialItem">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" isDefault="true" valuePart="spatialItem.localClock">
        <typings>Clock</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="displacementVector">
        <typings>Displacement3dVector</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="spatialItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
