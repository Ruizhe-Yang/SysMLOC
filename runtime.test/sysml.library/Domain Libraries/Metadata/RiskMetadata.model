<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="RiskMetadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package defines metadata for annotating model elements with assessments of risk.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Level">
      <superclassifiers>Real</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A Level is a Real number in the interval 0.0 to 1.0, inclusive.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="that >= 0.0 and that &lt;= 1.0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="LevelEnum">
      <superclassifiers>Level</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LevelEnum provides standard probability Levels for low, medium and high risks.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="low" valuePart="0.25"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="medium" valuePart="0.50"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="high" valuePart="0.75"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="RiskLevel">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * RiskLevel gives the probability of a risk occurring and, optionally, the impact&#xA;&#x9;&#x9; * if the risk occurs.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="probability">
        <typings>Level</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The probability that a risk will occur.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="impact" Multi1="0" Multi02="1">
        <typings>Level</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The impact of the risk if it occurs (with 0.0 being no impact and 1.0 being &#xA;&#x9;&#x9;&#x9; * the most severe impact).&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="RiskLevelEnum">
      <superclassifiers>RiskLevel</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * RiskLevelEnum enumerates standard RiskLevels for low, medium and high risks&#xA;&#x9;&#x9; * (without including impact).&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="low" valuePart="new RiskLevel(probability = LevelEnum::low)"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="medium" valuePart="new RiskLevel(probability = LevelEnum::medium)"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="high" valuePart="new RiskLevel(probability = LevelEnum::high)"/>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Risk">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Risk is used to annotate a model element with an assessment of the risk related to it&#xA;&#x9;&#x9; * in some typical risk areas.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="totalRisk" Multi1="0" Multi02="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The total risk associated with the annotated element.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="technicalRisk" Multi1="0" Multi02="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The risk of unresolved technical issues regarding the annotated element.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="scheduleRisk" Multi1="0" Multi02="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The risk that work on the annotated element will not be completed on schedule.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="costRisk" Multi1="0" Multi02="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The risk that work on the annotated element will exceed its planned cost.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
