    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-3 item 3-1.1 length */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="LengthValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 3-1.1 length&#xA;         * symbol(s): `l`, `L`&#xA;         * application domain: generic&#xA;         * name: Length&#xA;         * quantity dimension: L^1&#xA;         * measurement unit(s): m&#xA;         * tensor order: 0&#xA;         * definition: linear extent in space between any two points&#xA;         * remarks: Length does not need to be measured along a straight line. Length is one of the seven base quantities in the International System of Units (ISO 80000-1).&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>LengthUnit</typings>
        <redefinitions>mRef</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
    </elements>
