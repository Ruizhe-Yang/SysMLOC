    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianMagneticMoment3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-23 magnetic moment, magnetic area moment (vector)&#xA;         * symbol(s): `vec(m)`&#xA;         * application domain: generic&#xA;         * name: MagneticMoment&#xA;         * quantity dimension: L^2*I^1&#xA;         * measurement unit(s): A*m^2&#xA;         * tensor order: 1&#xA;         * definition: `vec(m) = I vec(e_n) A` where `I` is electric current (item 6-1) in a small closed loop, `vec(e_n)` is a unit vector perpendicular to the loop, and `A` is area (ISO 80000-3, item 3-3) of the loop&#xA;         * remarks: The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain. See IEC 60050-121, items 121-11-49 and 121-11-50.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>CartesianMagneticMoment3dCoordinateFrame</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cartesianMagneticMoment3dVector">
      <typings>CartesianMagneticMoment3dVector</typings>
      <subsetting>vectorQuantities</subsetting>
    </elements>
