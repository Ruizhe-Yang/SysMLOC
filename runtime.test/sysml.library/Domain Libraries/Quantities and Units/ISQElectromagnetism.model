      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-35.1 phase speed of electromagnetic waves */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PhaseSpeedOfElectromagneticWavesValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-35.1 phase speed of electromagnetic waves&#xA;         * symbol(s): `c`&#xA;         * application domain: generic&#xA;         * name: PhaseSpeedOfElectromagneticWaves&#xA;         * quantity dimension: L^1*T^-1&#xA;         * measurement unit(s): m/s&#xA;         * tensor order: 0&#xA;         * definition: `c = &#x3c9;/k` where `&#x3c9;` is angular frequency (ISO 80000-3, item 3-16) and `k` is angular wavenumber (ISO 80000-3, item 3-19)&#xA;         * remarks: See ISO 80000-3, item 3-20.1.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>PhaseSpeedOfElectromagneticWavesUnit</typings>
