        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-35.2 speed of light, light speed */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpeedOfLightValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-35.2 speed of light, light speed&#xA;         * symbol(s): `c_0`&#xA;         * application domain: generic&#xA;         * name: SpeedOfLight&#xA;         * quantity dimension: L^1*T^-1&#xA;         * measurement unit(s): m/s&#xA;         * tensor order: 0&#xA;         * definition: speed of electromagnetic waves in vacuum; `c_0 = 299792458` m/s&#xA;         * remarks: For this value of `c_0` see ISO 80000-3, item 3-1.a. `c_0 = 1/sqrt(&#x3b5;_0 &#x3bc;_0)`. See IEC 60050-111, item 111-13-07.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>SpeedOfLightUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="speedOfLight" MultiValue="*" isNonunique="true">
      <typings>SpeedOfLightValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
