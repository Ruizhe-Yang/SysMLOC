    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-48 phase difference */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PhaseDifferenceValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-48 phase difference&#xA;         * symbol(s): `&#x3c6;`&#xA;         * application domain: generic&#xA;         * name: PhaseDifference&#xA;         * quantity dimension: 1&#xA;         * measurement unit(s): rad&#xA;         * tensor order: 0&#xA;         * definition: `&#x3c6; = &#x3c6;_u - &#x3c6;_i` where `&#x3c6;_u` is the initial phase of the voltage (item 6-11 .3) and `&#x3c6;_i` is the initial phase of the electric current (item 6-1)&#xA;         * remarks: When `u = hat(U) cos(&#x3c9;t - &#x3c6;_u)`, `i = hat(I) cos(&#x3c9;t - &#x3c6;_i)` where `u` is the voltage (item 6-11 . 3) and `i` is the electric current (item 6-1 ), `&#x3c9;` is angular frequency (ISO 80000-3, item 3-16) and `t` is time (ISO 80000-3, item 3-7), then `&#x3c6;` is phase difference. For phase angle, see items 6-49 and 6-50.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>PhaseDifferenceUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="phaseDifference" MultiValue="*" isNonunique="true">
