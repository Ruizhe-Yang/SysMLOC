    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-52.1 admittance, complex admittance */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AdmittanceValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-52.1 admittance, complex admittance&#xA;         * symbol(s): `underline(Y)`&#xA;         * application domain: generic&#xA;         * name: Admittance&#xA;         * quantity dimension: L^-2*M^-1*T^3*I^2&#xA;         * measurement unit(s): S&#xA;         * tensor order: 0&#xA;         * definition: `underline(Y) = 1/underline(Z)` where `underline(Z)` is impedance (item 6-51.1)&#xA;         * remarks: `underline(Y) = G + jB`, where `G` is conductance (item 6-52 .2) and `B` is susceptance (item 6-52 .3). `j` is the imaginary unit. `underline(Y) = |underline(Y)| e^-(j&#x3c6;)`. See IEC 60050-131, item 131 -12-51.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>AdmittanceUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
