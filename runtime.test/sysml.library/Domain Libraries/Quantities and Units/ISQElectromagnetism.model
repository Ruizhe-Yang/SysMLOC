      <typings>AdmittanceValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AdmittanceUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
