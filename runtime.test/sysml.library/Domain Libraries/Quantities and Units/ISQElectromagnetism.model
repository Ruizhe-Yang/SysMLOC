        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="3">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="electricCurrentPF" MultiValue="1">
