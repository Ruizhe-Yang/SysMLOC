        <typings>MagneticFieldStrengthUnit</typings>
        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="CartesianMagnetizingField3dCoordinateFrame" memberElement="CartesianMagneticFieldStrength3dCoordinateFrame"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="cartesianMagnetizingField3dVector" memberElement="cartesianMagneticFieldStrength3dVector"/>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-26.1 magnetic constant, permeability of vacuum */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MagneticConstantValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-26.1 magnetic constant, permeability of vacuum&#xA;         * symbol(s): `&#x3bc;_0`&#xA;         * application domain: generic&#xA;         * name: MagneticConstant&#xA;         * quantity dimension: L^1*M^1*T^-2*I^-2&#xA;         * measurement unit(s): H/m&#xA;         * tensor order: 0&#xA;         * definition: `&#x3bc;_0 = 4 &#x3c0; * 10^-7` H/m&#xA;         * remarks: For this definition of `&#x3bc;_0` see item 6-1.a. `&#x3bc;_0 ~~ 1.256637 * 10^-6` H/m. See IEC 60050-121, item 121-11-14.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>MagneticConstantUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="magneticConstant" MultiValue="*" isNonunique="true">
      <typings>MagneticConstantValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MagneticConstantUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="electricCurrentPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.I">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF, electricCurrentPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="PermeabilityOfVacuumUnit" memberElement="MagneticConstantUnit"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="PermeabilityOfVacuumValue" memberElement="MagneticConstantValue"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="permeabilityOfVacuum" memberElement="magneticConstant"/>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-26.2 permeability */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PermeabilityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-26.2 permeability&#xA;         * symbol(s): `&#x3bc;`&#xA;         * application domain: generic&#xA;         * name: Permeability&#xA;         * quantity dimension: L^1*M^1*T^-2*I^-2&#xA;         * measurement unit(s): H/m&#xA;         * tensor order: 0&#xA;         * definition: `vec(B) = &#x3bc; vec(H)` where `vec(B)` is magnetic flux density (item 6-21) and `vec(H)` is magnetic field strength (item 6-25)&#xA;         * remarks: This definition applies to an isotropic medium. For an anisotropic medium permeability is a second order tensor. See IEC 60050-121, item 121-12-28.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>PermeabilityUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="permeability" MultiValue="*" isNonunique="true">
      <typings>PermeabilityValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PermeabilityUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
