    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-14.1 electric constant, permittivity of vacuum */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ElectricConstantValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-14.1 electric constant, permittivity of vacuum&#xA;         * symbol(s): `&#x3b5;_0`&#xA;         * application domain: generic&#xA;         * name: ElectricConstant&#xA;         * quantity dimension: L^-3*M^-1*T^4*I^2&#xA;         * measurement unit(s): F/m&#xA;         * tensor order: 0&#xA;         * definition: `&#x3b5;_0 = 1 / (&#x3bc;_0 * c_0^2)` where `&#x3bc;_0` is the magnetic constant (item 6-26.1) and `c_0` is the speed of light (item 6-35.2)&#xA;         * remarks: `&#x3b5;_0 = 8.854188 * 10^-12` F/m. See IEC 60050-121, item 121-11-03.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>ElectricConstantUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="electricConstant" MultiValue="*" isNonunique="true">
      <typings>ElectricConstantValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ElectricConstantUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiValue="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-3">
