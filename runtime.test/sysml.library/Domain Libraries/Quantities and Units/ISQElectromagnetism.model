        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF, electricCurrentPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-44 resistivity */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ResistivityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 6-44 resistivity&#xA;         * symbol(s): `&#x3c1;`&#xA;         * application domain: generic&#xA;         * name: Resistivity&#xA;         * quantity dimension: L^3*M^1*T^-3*I^-2&#xA;         * measurement unit(s): &#x3a9;*m&#xA;         * tensor order: 0&#xA;         * definition: `&#x3c1; = 1/&#x3c3;` if is exists, where `&#x3c3;` is conductivity (item 6-43)&#xA;         * remarks: See IEC 60050-121, item 121-12-04.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <typings>ResistivityUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="resistivity" MultiValue="*" isNonunique="true">
      <typings>ResistivityValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
