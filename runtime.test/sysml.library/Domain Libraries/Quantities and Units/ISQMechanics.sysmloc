      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-11 angular momentum (vector)&#xA;         * symbol(s): `vec(L)`&#xA;         * application domain: generic&#xA;         * name: AngularMomentum&#xA;         * quantity dimension: L^2*M^1*T^-1&#xA;         * measurement unit(s): kg*m^2*s^-1&#xA;         * tensor order: 1&#xA;         * definition: vector (ISO 80000-2) quantity described by the vector product: `vec(L) = vec(r) xx vec(p)` where `vec(r)` is position vector (ISO 80000-3) with respect to the axis of rotation and `vec(p)` is momentum (item 4-8)&#xA;         * remarks: None.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>CartesianAngularMomentum3dCoordinateFrame</typings>
