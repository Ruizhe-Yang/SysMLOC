    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="cartesianStaticFriction3dVector" memberElement="cartesianStaticFrictionForce3dVector"/>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-9.4 kinetic friction force, dynamic friction force */"/>
