    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-14.1 pressure */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PressureValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-14.1 pressure&#xA;         * symbol(s): `p`&#xA;         * application domain: generic&#xA;         * name: Pressure&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xA;         * tensor order: 0&#xA;         * definition: quotient of the component of a force normal to a surface and its area: `p = (vec(e_n) * vec(F)) / A` where `vec(e_n)` is unit vector of the surface normal, `vec(F)` is force (item 4-9.1) and `A` is area (ISO 80000-3)&#xA;         * remarks: None.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>PressureUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pressure" MultiLow="*" isNonunique="true">
      <typings>PressureValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
