        <typings>MomentOfForceUnit</typings>
        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-12.2 torque */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TorqueValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-12.2 torque&#xA;         * symbol(s): `T`, `M_Q`&#xA;         * application domain: generic&#xA;         * name: Torque&#xA;         * quantity dimension: L^2*M^1*T^-2&#xA;         * measurement unit(s): N*m, kg*m^2*s^-2&#xA;         * tensor order: 0&#xA;         * definition: quantity described by the scalar product: `T = vec(M)*vec(e_Q)` where `vec(M)` is moment of force (item 4-12.1) and `vec(e_Q)` is unit vector of direction with respect to which the torque is considered&#xA;         * remarks: For example, torque is the twisting moment of force with respect to the longitudinal axis of a beam or shaft.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
