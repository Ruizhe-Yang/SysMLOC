    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="cartesianDynamicFrictionForce3dVector" memberElement="cartesianKineticFrictionForce3dVector"/>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-9.5 rolling resistance, rolling drag, rolling friction force */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianRollingResistance3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-9.5 rolling resistance, rolling drag, rolling friction force&#xA;         * symbol(s): `vec(F_&quot;rr&quot;)`&#xA;         * application domain: generic&#xA;         * name: RollingResistance (specializes Force)&#xA;         * quantity dimension: L^1*M^1*T^-2&#xA;         * measurement unit(s): N, kg*m*s^-2&#xA;         * tensor order: 1&#xA;         * definition: force (item 4-9.1) resisting the motion when a body rolls on a surface&#xA;         * remarks: For the rolling resistance factor, see item 4-23.3.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
