    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianMomentOfForce3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-12.1 moment of force (vector)&#xA;         * symbol(s): `vec(M)`&#xA;         * application domain: generic&#xA;         * name: MomentOfForce&#xA;         * quantity dimension: L^2*M^1*T^-2&#xA;         * measurement unit(s): N*m, kg*m^2*s^-2&#xA;         * tensor order: 1&#xA;         * definition: vector (ISO 80000-2) quantity described by the vector product: `vec(M) = vec(r) xx vec(F)` where `vec(r)` is position vector (ISO 80000-3) with respect to the axis of rotation and `vec(F)` is force (item 4-9.1)&#xA;         * remarks: The bending moment of force is denoted by `vec(M)_b`.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
