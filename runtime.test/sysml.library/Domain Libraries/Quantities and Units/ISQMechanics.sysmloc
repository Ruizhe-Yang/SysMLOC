    <elements xsi:type="sysMLOC:AliasElement" memberName="cartesianRollingFrictionForce3dVector" memberElement="cartesianRollingResistance3dVector"/>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-9.6 drag force */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianDragForce3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 4-9.6 drag force&#xA;         * symbol(s): `vec(F_D)`&#xA;         * application domain: generic&#xA;         * name: DragForce (specializes Force)&#xA;         * quantity dimension: L^1*M^1*T^-2&#xA;         * measurement unit(s): N, kg*m*s^-2&#xA;         * tensor order: 1&#xA;         * definition: force (item 4-9.1) resisting the motion of a body in a fluid&#xA;         * remarks: For the drag coefficient, see item 4-23.4.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
