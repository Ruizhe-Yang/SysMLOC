      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" Multi0="1">
        <typings>IsentropicCompressibilityUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isentropicCompressibility" Multi0="*" isNonunique="true">
      <typings>IsentropicCompressibilityValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="IsentropicCompressibilityUnit">
