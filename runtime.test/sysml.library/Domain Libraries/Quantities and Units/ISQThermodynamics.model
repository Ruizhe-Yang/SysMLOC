    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-14 thermal diffusivity */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ThermalDiffusivityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 5-14 thermal diffusivity&#xA;         * symbol(s): `a`&#xA;         * application domain: generic&#xA;         * name: ThermalDiffusivity&#xA;         * quantity dimension: L^2*T^-1&#xA;         * measurement unit(s): m^2*s^-1&#xA;         * tensor order: 0&#xA;         * definition: quotient of thermal conductivity and the product of mass density and specific heat capacity: `a = &#x3bb; / (&#x3c1; C_p)` where `&#x3bb;` is thermal conductivity (item 5-9), `&#x3c1;` is mass density (ISO 80000-4), and `c_p` is specific heat capacity at constant pressure (item 5-16.2)&#xA;         * remarks: None.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
