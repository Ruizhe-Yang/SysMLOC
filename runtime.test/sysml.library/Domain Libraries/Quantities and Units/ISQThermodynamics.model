        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" Multi0="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-5.2 isentropic compressibility */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="IsentropicCompressibilityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 5-5.2 isentropic compressibility&#xA;         * symbol(s): `&#x3f0;_S`&#xA;         * application domain: generic&#xA;         * name: IsentropicCompressibility&#xA;         * quantity dimension: L^1*M^-1*T^2&#xA;         * measurement unit(s): Pa^-1, kg^-1*m*s^2&#xA;         * tensor order: 0&#xA;         * definition: negative relative change of volume with pressure at constant entropy: `&#x3f0;_S = -1/V * ((partial V)/(partial p))_S` where `V` is volume (ISO 80000-3), `p` is pressure (ISO 80000-4), and `S` is entropy (item 5-18)&#xA;         * remarks: The subscripts in the symbols may be omitted when there is no risk of confusion.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
