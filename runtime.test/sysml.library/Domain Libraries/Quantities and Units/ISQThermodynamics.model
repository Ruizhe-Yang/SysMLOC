    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-16.4 specific heat capacity at saturated vapour pressure */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpecificHeatCapacityAtSaturatedVapourPressureValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 5-16.4 specific heat capacity at saturated vapour pressure&#xA;         * symbol(s): `c_&quot;sat&quot;`&#xA;         * application domain: generic&#xA;         * name: SpecificHeatCapacityAtSaturatedVapourPressure&#xA;         * quantity dimension: L^2*T^-2*&#x398;^-1&#xA;         * measurement unit(s): J/(kg*K), m^2*s^-2*K^-1&#xA;         * tensor order: 0&#xA;         * definition: specific heat capacity (item 5-16.1) at saturated vapour pressure (ISO 80000-4)&#xA;         * remarks: None.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" Multi0="1">
        <typings>SpecificHeatCapacityAtSaturatedVapourPressureUnit</typings>
        <redefinitions>mRef</redefinitions>
