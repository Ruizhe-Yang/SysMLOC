    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-16.1 specific heat capacity */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpecificHeatCapacityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 5-16.1 specific heat capacity&#xA;         * symbol(s): `c`&#xA;         * application domain: generic&#xA;         * name: SpecificHeatCapacity&#xA;         * quantity dimension: L^2*T^-2*&#x398;^-1&#xA;         * measurement unit(s): J/(kg*K), m^2*s^-2*K^-1&#xA;         * tensor order: 0&#xA;         * definition: quotient of heat capacity and mass: `c = C/m` where `C` is heat capacity (item 5-15) and `m` is mass (ISO 80000-4)&#xA;         * remarks: For the corresponding quantities related to the amount of substance, see ISO 80000-9.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
