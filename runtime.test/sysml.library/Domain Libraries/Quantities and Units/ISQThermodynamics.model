          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-3.2 cubic expansion coefficient */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CubicExpansionCoefficientValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * source: item 5-3.2 cubic expansion coefficient&#xA;         * symbol(s): `&#x3b1;_V`, `&#x3b3;`&#xA;         * application domain: generic&#xA;         * name: CubicExpansionCoefficient&#xA;         * quantity dimension: &#x398;^-1&#xA;         * measurement unit(s): K^-1&#xA;         * tensor order: 0&#xA;         * definition: relative change of volume with temperature: `&#x3b1;_V = 1/V * (dV)/(dT)` where `V` is volume (ISO 80000-3) and `T` is thermodynamic temperature (item 5-1)&#xA;         * remarks: Also called volumetric expansion coefficient. The subscripts in the symbols may be omitted when there is no risk of confusion.&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" Multi0="1">
        <typings>CubicExpansionCoefficientUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cubicExpansionCoefficient" Multi0="*" isNonunique="true">
      <typings>CubicExpansionCoefficientValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CubicExpansionCoefficientUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="thermodynamicTemperaturePF" Multi0="1">
