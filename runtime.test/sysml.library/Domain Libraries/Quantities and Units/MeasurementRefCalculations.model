<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="MeasurementRefCalculations" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package package defines calculations on MeasurementUnits and CoordinateFrames.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::MeasurementUnit"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::ScalarMeasurementReference"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::CoordinateFrame"/>
    <elements xsi:type="sysMLOC:Comment" body="/* MeasurementUnit operations */"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'*'">
      <superclassifiers>DataFunctions::'*'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'/'">
      <superclassifiers>DataFunctions::'/'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'**'">
      <superclassifiers>DataFunctions::'**'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'^'">
      <superclassifiers>DataFunctions::'^'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* CoordinateFrame and MeasurementUnit operations */"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'CoordinateFrame*'">
      <superclassifiers>DataFunctions::'*'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>CoordinateFrame</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>CoordinateFrame</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'CoordinateFrame/'">
      <superclassifiers>DataFunctions::'/'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>CoordinateFrame</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="y" MultiLow="1">
        <typings>MeasurementUnit</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>CoordinateFrame</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="ToString">
      <superclassifiers>BaseFunctions::ToString</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * Returns the Unicode string symbol representing a scalar measurement reference.&#xA;         */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" MultiLow="1">
        <typings>ScalarMeasurementReference</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="1">
        <typings>String</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
