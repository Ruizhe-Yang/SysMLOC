<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="TensorCalculations" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package package defines calculations for the construction of and computations on TensorQuantityValues.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Number"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::ScalarQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::VectorQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::TensorQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::TensorMeasurementReference"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::CoordinateTransformation"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'['">
      <superclassifiers>BaseFunctions::'['</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="elements" Multi1="1" Multi02="n" isOrdered="true">
        <typings>Number</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mRef" Multi0="1">
        <typings>TensorMeasurementReference</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="quantity" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="n" valuePart="mRef.flattenedSize"/>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="isZeroTensorQuantity">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="isUnitTensorQuantity">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Addition and subtraction */"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'+'">
      <superclassifiers>DataFunctions::'+'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="'-'">
      <superclassifiers>DataFunctions::'-'</superclassifiers>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Multiplication and division */"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="scalarTensorMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>Number</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="TensorScalarMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>Number</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="scalarQuantityTensorMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>ScalarQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="TensorScalarQuantityMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>ScalarQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="tensorVectorMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>VectorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>VectorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="vectorTensorMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>VectorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>VectorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="tensorTensorMult">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" Multi0="1">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Tensor transformation */"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="transform">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transformation">
        <typings>CoordinateTransformation</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="sourceTensor">
        <typings>TensorQuantityValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="targetTensor">
        <typings>TensorQuantityValue</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
