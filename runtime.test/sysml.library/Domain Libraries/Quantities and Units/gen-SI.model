        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="zeroDegreeCelsiusInKelvin">
          <redefinitions>origin</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
