    <elements xsi:type="sysMLOC:CodeAnnotation" body="//attribute &lt;kat> katal : CatalyticActivityUnit = mol/s;&#xA;"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="lm" declaredName="lumen" valuePart="cd*sr">
