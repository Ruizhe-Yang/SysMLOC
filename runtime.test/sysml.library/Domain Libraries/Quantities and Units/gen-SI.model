      <typings>InductanceUnit</typings>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>PermeanceUnit::quantityDimension</redefinitions>
        <redefinitions>InductanceUnit::quantityDimension</redefinitions>
