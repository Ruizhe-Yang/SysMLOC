        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1/100">
          <redefinitions>num</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;temperature in degree Celsius of pure water at the triple point&quot;">
          <redefinitions>definition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="celsiusToKelvinScaleMapping">
