        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="temperatureWaterAtTriplePointInC">
          <redefinitions>mappedQuantityValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="K.temperatureOfWaterAtTriplePointInK">
          <redefinitions>referenceQuantityValue</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="(temperatureWaterAtTriplePointInC, temperatureWaterAtFreezingPointInC)">
        <redefinitions>definitionalQuantityValues</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="celsiusToKelvinScaleMapping">
        <redefinitions>quantityValueMapping</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* CoordinateFramePlacement (zero shift) w.r.t. the kelvin thermodynamic temperature scale */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="zeroDegreeCelsiusInKelvin" valuePart="273.15 [K]">
        <typings>ThermodynamicTemperatureValue</typings>
