    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="nat" declaredName="'natural unit of information'" valuePart="one">
      <typings>InformationContentUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="o" declaredName="octet" valuePart="one">
      <typings>StorageCapacityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="oct" declaredName="octave" valuePart="one">
      <typings>LogarithmicFrequencyRangeUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="Pa" declaredName="pascal" valuePart="N/m^2">
      <typings>PressureUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="rad" declaredName="radian" valuePart="m/m">
      <typings>AngularMeasureUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="S" declaredName="siemens" valuePart="'&#x3a9;'^-1">
