<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="CollectionFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines functions on Collections (as defined in the Collections package). &#xA;&#x9; * For functions on general sequences of values, see the SequenceFunctions package.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::equals"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::exists"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="Collections" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>BaseFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col1" MultiLow="0" MultiHigh="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col2" MultiLow="0" MultiHigh="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="col1.elements->equals(col2.elements)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="size">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::size(col.elements)">
        <typings>Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::isEmpty(col.elements)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="notEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::notEmpty(col.elements)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="contains">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="*">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="col.elements->includes(values)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="containsAll">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col1" MultiLow="1">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col2" MultiLow="2">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="contains(col1, col2.elements)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="head">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="SequenceFunctions::head(col.elements)">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="tail">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="SequenceFunctions::tail(col.elements)">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="last">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="SequenceFunctions::last(col.elements)">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'#'">
      <subsetting>BaseFunctions::'#'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Cast ensures this function is not called recursively if the elements of col are OrderedCollections.&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="(col.elements as Anything)#(index)">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'array#'">
      <subsetting>BaseFunctions::'#'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="arr" MultiLow="1">
        <typings>Array</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="indexes" MultiLow="n" isOrdered="true" isNonunique="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="n" MultiLow="1" valuePart="arr.rank" isFeature="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Assumes row-major ordering for elements.&#xA;"/>
      <elements xsi:type="kerMLOC:Function" visibility="private" declaredName="index">
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="arr" MultiLow="1">
          <typings>Array</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="i">
          <typings>Natural</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="indexes" MultiLow="1" MultiHigh="*">
          <typings>Positive</typings>
        </elements>
        <resultExpressionParameter resultExpression="if i &lt;= 1? indexes#(1) else arr.dimensions#(i) * (index(arr, i-1, indexes) - 1) + indexes#(i)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="if n == 0 or (1..n)->exists {in i; indexes#(i) > arr.dimensions#(i)}? null else arr.elements#(index(arr, n, indexes))">
        <typings>Anything</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
