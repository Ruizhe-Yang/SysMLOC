<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="ComplexFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines functions on Complex values, including concrete specializations of the &#xA;&#x9; * general arithmetic and comparison operations.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="i" MultiLow="1" valuePart="rect(0.0, 1.0)" isFeature="true" isSemicolon="true">
      <typings>Complex</typings>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="rect">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="re" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="im" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="polar">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="abs" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="arg" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="re">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="im">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isZero">
      <subsetting>NumericalFunctions::isZero</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="re(x) == 0.0 and im(x) == 0.0" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isUnit">
      <subsetting>NumericalFunctions::isUnit</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="re(x) == 1.0 and im(x) == 0.0" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="abs">
      <subsetting>NumericalFunctions::abs</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="arg">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'+'">
      <subsetting>NumericalFunctions::'+'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'-'">
      <subsetting>NumericalFunctions::'-'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'*'">
      <subsetting>NumericalFunctions::'*'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'/'">
      <subsetting>NumericalFunctions::'/'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'**'">
      <subsetting>NumericalFunctions::'**'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'^'">
      <subsetting>NumericalFunctions::'^'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>DataFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToString">
      <subsetting>BaseFunctions::ToString</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToComplex">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="sum">
      <subsetting>NumericalFunctions::sum</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isDefault="true" valuePart="NumericalFunctions::sum0(collection, rect(0.0, 0.0))" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="product">
      <subsetting>NumericalFunctions::product</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isDefault="true" valuePart="NumericalFunctions::product1(collection, rect(1.0, 0.0))" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
