<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="DataFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines the abstract base functions corresponding to all the unary and binary operators &#xA;&#x9; * in the KerML expression notation that might be defined on various kinds of DataValues.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::DataValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::reduce"/>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'=='">
      <subsetting>BaseFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'==='">
      <subsetting>BaseFunctions::'==='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="x == y" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'+'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'-'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'*'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'/'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'**'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'^'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'%'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'not'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'xor'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'~'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'|'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'&amp;'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'&lt;'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'>'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'&lt;='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'>='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="max">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="min">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'..'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="lower" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="upper" MultiLow="1" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isSemicolon="true">
        <typings>DataValue</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
