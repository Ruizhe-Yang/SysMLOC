    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'>'">
      <subsetting>ScalarFunctions::'>'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'&lt;='">
      <subsetting>ScalarFunctions::'&lt;='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'>='">
      <subsetting>ScalarFunctions::'>='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="max">
      <subsetting>ScalarFunctions::max</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="min">
      <subsetting>ScalarFunctions::min</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
