<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="OccurrenceFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines utility functions that operate on occurrences, primarily related to &#xA;&#x9; * time during which those occurrences exist.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::add"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::addAt"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::remove"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::removeAt"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'==='">
      <subsetting>BaseFunctions::'==='</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Test whether two occurrences are portions of the same life. That is, whether they &#xA;&#x9;&#x9; * represent different portions of the same entity (colloquially, whether they have&#xA;&#x9;&#x9; * the same &quot;identity&quot;).&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="x.portionOfLife == y.portionOfLife">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isDuring">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Test whether a performance of this function happens during the input occurrence.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="occ" MultiLow="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="during" MultiLow="0" MultiHigh="1" isSufficient="true" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart refElement="self"/>
        <connectorPart refElement="occ"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="notEmpty(during)">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="create">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Ensure that the start of a given occurrence happens during a performance of this&#xA;&#x9;&#x9; * function. The occurrence is also returned from the function.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart refElement="occ.startShot"/>
        <connectorPart refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="destroy">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Ensure that the end of a given occurrence happens during a performance of this&#xA;&#x9;&#x9; * function. The occurrence is also returned from the function.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="0" MultiHigh="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="occ.endShot"/>
        <connectorPart refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="occ">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="addNew">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Add a newly created occurrence to the given group of occurrences and return the&#xA;&#x9;&#x9; * new occurrence.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isNonunique="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true">
        <typings>add</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq1" valuePart="group"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" valuePart="create(occ)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="addNewAt">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Add a newly created occurrence to the given ordered group of occurrences at the given&#xA;&#x9;&#x9; * index and return the new occurrence.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true">
        <typings>addAt</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" valuePart="group"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" valuePart="create(occ)"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="startIndex" valuePart="index"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="removeOld">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Remove a given occurrence from a group of occurrences and destroy it.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isNonunique="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="0" MultiHigh="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="removeStep">
        <typings>remove</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" valuePart="group"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" valuePart="occ"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart refElement="removeStep"/>
        <connectorPart refElement="destroyStep"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="destroyStep">
        <typings>destroy</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" valuePart="removeOld::occ"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="removeOldAt">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Removes the occurrence at a given index in an ordered group of occurrences &#xA;&#x9;&#x9; * and destroy it.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="oldOcc" valuePart="group#(index)" isFeature="true"/>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="removeStep">
        <typings>remove</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" valuePart="group"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" valuePart="removeOldAt::index"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart refElement="removeStep"/>
        <connectorPart refElement="destroyStep"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="destroyStep">
        <typings>destroy</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" valuePart="oldOcc"/>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
