<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="StringFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines functions on String values, including those corresponding to string concatenation &#xA;&#x9; * and comparison operators in the KerML expression notation.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'+'">
      <subsetting>ScalarFunctions::'+'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="Length">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="Substring">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="lower" MultiLow="1">
        <typings>Integer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="upper" MultiLow="1">
        <typings>Integer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'&lt;'">
      <subsetting>ScalarFunctions::'&lt;'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'>'">
      <subsetting>ScalarFunctions::'>'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'&lt;='">
      <subsetting>ScalarFunctions::'&lt;='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'>='">
      <subsetting>ScalarFunctions::'>='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>DataFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToString">
      <subsetting>BaseFunctions::ToString</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="x">
        <typings>String</typings>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
