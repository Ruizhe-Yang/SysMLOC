<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Links" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;     * This package defines associations and features that are related to the typing of links.&#xA;     */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:Association" isAbstract="true" declaredName="Link">
      <subsetting>Anything</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * Link is the most general association between two or more things.&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="participant" MultiLow="2" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="BinaryLink" isSufficient="true">
      <subsetting>Link</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * BinaryLink is the most general binary association between exactly two things, &#xA;         * nominally directed from source to target.&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="participant" MultiLow="2" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>Link::participant</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>participant</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>participant</subsetting>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SelfLink" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * SelfLink is a binary association in which the things at the two ends are asserted&#xA;         * to be the same.&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>sameThing</subsetting>
        <crosses>sameThing.self</crosses>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sameThing" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="self2" MultiLow="1"/>
        <typings>Anything</typings>
        <subsetting>thisThing</subsetting>
        <redefinitions>target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="links" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>Link</typings>
      <subsetting>things</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * links is the most general feature of links between individuals.&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="binaryLinks" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>BinaryLink</typings>
      <subsetting>links</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * binaryLinks is a specialization of links restricted to type BinaryLink.&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="selfLinks" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>SelfLink</typings>
      <subsetting>binaryLinks</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * selfLinks is a specialization of binaryLinks restricted to type SelfLink.&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>SelfLink::thisThing</redefinitions>
        <redefinitions>binaryLinks::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sameThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>SelfLink::sameThing</redefinitions>
        <redefinitions>binaryLinks::target</redefinitions>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
