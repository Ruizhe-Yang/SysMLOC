<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Objects" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines classifiers and features that are related to the typing of objects, including link objects.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::occurrences"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::WithinBoth"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::performances"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::union"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="CollectionFunctions::contains"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Integer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="Object">
      <subsetting>Occurrence</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Object is the most general class of structural occurrences that may change over time.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true">
        <typings>Object</typings>
        <redefinitions>Occurrence::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="subobjects" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <subsetting>objects</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>objects</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The suboccurrences of this Object that are also Objects.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="involvingPerformances" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Performance</typings>
        <subsetting>performances</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Performances in which this object is involved.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="enactedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>involvingPerformances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <intersecting>involvingPerformances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Performances that are enacted by this object.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="ownedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>involvingPerformances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>involvingPerformances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Performances that are owned by this object.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="that" isFeature="true">
          <redefinitions>this</redefinitions>
          <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The owning object is the default &quot;this&quot; reference for all ownedPerformances.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="structuredSpaceBoundary" MultiLow="0" MultiHigh="1">
        <typings>StructuredSpaceObject</typings>
        <subsetting>spaceBoundary</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * A space boundary that is a structured space object.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:AssociationStructure" isAbstract="true" declaredName="LinkObject">
      <subsetting>Link</subsetting>
      <subsetting>Object</subsetting>
      <intersecting>Link</intersecting>
      <intersecting>Object</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LinkObject is the most general association structure, being both a Link and an Object.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:AssociationStructure" declaredName="BinaryLinkObject">
      <subsetting>BinaryLink</subsetting>
      <subsetting>LinkObject</subsetting>
      <intersecting>BinaryLink</intersecting>
      <intersecting>LinkObject</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * BinaryLinkObject is the most general binary association structure, being both a &#xA;&#x9;&#x9; * BinaryLink and a LinkObject.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="objects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>Object</typings>
      <subsetting>occurrences</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * objects is a specialization of occurrences restricted to type Object.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="linkObjects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>LinkObject</typings>
      <subsetting>links</subsetting>
      <subsetting>objects</subsetting>
      <intersecting>links</intersecting>
      <intersecting>objects</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * linkObjects is a specializations of links and objects restricted to type LinkObjects. &#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="binaryLinkObjects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>BinaryLinkObject</typings>
      <subsetting>binaryLinks</subsetting>
      <subsetting>linkObjects</subsetting>
      <intersecting>binaryLinks</intersecting>
      <intersecting>linkObjects</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * binaryLinkObjects is a specialization of binaryLinks and linkObjects restricted to &#xA;&#x9;&#x9; * type BinaryLinkObjects.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Body" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A Body is an Object of inner space dimension 3.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="3" isFeature="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Surface" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A Surface is an Object of inner space dimension 2.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="2" isFeature="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/* The number of  &quot;holes&quot; in this Surface, assuming it isClosed. */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="genus" MultiLow="0" MultiHigh="1" isDefault="true" valuePart="0" isFeature="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="notEmpty(genus) implies isClosed"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Curve" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A Curve is an Object of inner space dimension 1.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="1" isFeature="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Point" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A Point is an Object of inner space dimension 0.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="0" isFeature="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="StructuredSpaceObject">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A StructuredSpaceObject is an Object that is broken up into smaller structured space objects (cells) of&#xA;&#x9;&#x9; * the same or lower inner space dimension: faces that are surfaces, edges that are curves, and vertices&#xA;&#x9;&#x9; * that are points, with edges and vertices on the boundary of faces, and vertices on the boundary of&#xA;&#x9;&#x9; * edges. Cells meet when a structured space object is closed, as required to be a space boundary of&#xA;&#x9;&#x9; * an object (faces meet at their edges and/or vertices, while edges meet at their vertices). The&#xA;&#x9;&#x9; * inner space dimension of structured space object is the highest of their cells.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isAbstract="true" isPortion="true" declaredName="structuredSpaceObjectCells" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>StructuredSpaceObject</typings>
        <subsetting>Occurrence::spaceSlices</subsetting>
        <elements xsi:type="kerMLOC:Feature" declaredName="cellOrientation" MultiLow="0" MultiHigh="1" isFeature="true">
          <typings>Integer</typings>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(cellOrientation) implies (cellOrientation >= -1 &amp; cellOrientation &lt;= 1)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/*&#xA;&#x9;&#x9; * The structures StructuredSurface, StructuredCurve and StructuredPoint provide common, necessary redefinitions of&#xA;&#x9;&#x9; * innerSpaceDimension. They also provide single types for the StructuredSpaceObject features faces, edges and&#xA;&#x9;&#x9; * vertices, which avoids problems when these features are related by connectors with ends that have owned&#xA;&#x9;&#x9; * cross features.&#xA;&#x9;&#x9; */">
        <annotatedElement>StructuredSurface</annotatedElement>
        <annotatedElement>StructuredCurve</annotatedElement>
        <annotatedElement>StructuredPoint</annotatedElement>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredSurface">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Surface</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Surface::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredCurve">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Curve</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Curve::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredPoint">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Point</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Point::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="faces" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>StructuredSurface</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <typings>StructuredSpaceObject</typings>
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <subsetting>that.edges</subsetting>
          <redefinitions>edges</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <subsetting>that.vertices</subsetting>
          <redefinitions>vertices</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isFeature="true">
          <redefinitions>spaceBoundary</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isEmpty(spaceBoundary) == isEmpty(union(edges, vertices))"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(spaceBoundary) implies contains(spaceBoundary.unionsOf, union(edges, vertices))"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="edges" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>StructuredCurve</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <typings>StructuredSpaceObject</typings>
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <subsetting>that.vertices</subsetting>
          <redefinitions>vertices</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isFeature="true">
          <redefinitions>spaceBoundary</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isEmpty(spaceBoundary) == isEmpty(vertices)"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(spaceBoundary) implies contains(spaceBoundary.unionsOf, vertices)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="vertices" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>StructuredPoint</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDerived="true" valuePart="if notEmpty(faces) ? 2 else if notEmpty(edges) ? 1 else 0" isFeature="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
