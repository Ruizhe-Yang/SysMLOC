<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Observation" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package models a framework for monitoring Boolean conditions and notifying&#xA;&#x9; * registered observers when they change from false to true.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Life"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::including"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::excluding"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::select"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::DecisionPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::IfThenPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="FeatureReferencingPerformances::FeatureWritePerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="FeatureReferencingPerformances::BooleanEvaluationResultToMonitorPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::TransferBefore"/>
    <elements xsi:type="kerMLOC:Structure" visibility="private" declaredName="DefaultMonitorLife" MultiLow="1">
      <subsetting>ChangeMonitor</subsetting>
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;         * DefaultMonitorLife is the classifier of the singleton Life of the defaultMonitor.&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="defaultMonitor" MultiLow="1" isFeature="true">
      <typings>DefaultMonitorLife</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * defaultMonitor is a single ChangeMonitor that can be used as a default.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="ChangeSignal">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A ChangeSignal is a signal to be sent when the Boolean result of its&#xA;&#x9;&#x9; * changeCondition Expression changes from false to true.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:BooleanExpression" declaredName="signalCondition">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * A BooleanExpression whose result is being monitored.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="signalMonitor" isFeature="true">
        <typings>ChangeMonitor</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The ChangeMonitor responsible for monitoring the signalCondition.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" visibility="private" declaredName="ObserveChange">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Each Performance of ObserveChange waits for the result of the Boolean &#xA;&#x9;&#x9; * condition of a given ChangeSignal to change from false to true, and, when &#xA;&#x9;&#x9; * it does, sends the ChangeSignal to a given observer Occurrence.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeObserver" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeSignal" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>ChangeSignal</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="wait">
        <typings>IfThenPerformance</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * If the result of the changeSignal.signalCondition is false, then wait for &#xA;&#x9;&#x9;&#x9; * it to become true.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:BooleanExpression" direction="in">
          <redefinitions>ifTest</redefinitions>
          <resultExpressionParameter resultExpression="not changeSignal.signalCondition()"/>
        </elements>
        <elements xsi:type="kerMLOC:Step" direction="in">
          <typings>BooleanEvaluationResultToMonitorPerformance</typings>
          <redefinitions>thenClause</redefinitions>
          <elements xsi:type="kerMLOC:BooleanExpression" direction="in" declaredName="onOccurrence" valuePart="changeSignal.signalCondition"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart refElement="wait"/>
        <connectorPart refElement="transfer"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="transfer" MultiLow="1">
        <typings>TransferBefore</typings>
        <subsetting>changeObserver.incomingTransfers</subsetting>
        <redefinitions>outgoingTransfersFromSelf</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Then send changeSignal to changeObserver.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true">
          <elements xsi:type="kerMLOC:Feature" valuePart="changeSignal" isFeature="true" isSemicolon="true">
            <redefinitions>sourceOutput</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="ChangeMonitor">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A ChangeMonitor is a collection of ongoing ChangeSignal observations &#xA;&#x9;&#x9; * for various observer Occurrences. It provides convenient operations for &#xA;&#x9;&#x9; * starting and canceling the observations it manages.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="thisMonitor" isSemicolon="true">
        <typings>ChangeMonitor</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" isComposite="true" declaredName="observations" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
        <typings>ObserveChange</typings>
      </elements>
      <elements xsi:type="kerMLOC:Behavior" visibility="private" declaredName="AssignObservations">
        <subsetting>FeatureWritePerformance</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Assign a replacement set of observations as those being managed by a&#xA;&#x9;&#x9;&#x9; * given ChangeMonitor.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" isFeature="true">
          <typings>ChangeMonitor</typings>
          <redefinitions>onOccurrence</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isFeature="true">
            <redefinitions>startingAt</redefinitions>
            <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
              <redefinitions>accessedFeature</redefinitions>
              <redefinitions>observations</redefinitions>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="inout" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>ObserveChange</typings>
          <redefinitions>replacementValues</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="startObservation">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Start an observation of a given ChangeSignal for a given Occurrence.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" MultiLow="1" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" MultiLow="1" isSemicolon="true">
          <typings>ChangeSignal</typings>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="observation">
          <typings>ObserveChange</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeObserver" valuePart="observer" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeSignal" valuePart="signal" isSemicolon="true"/>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="addObservation" MultiLow="1">
          <typings>AssignObservations</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" valuePart="thisMonitor" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="replacementValues" valuePart="observations->including(observation)" isSemicolon="true"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="cancelObservation">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Cancel all observations of a given ChangeSignal for a given Occurrence. &#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" MultiLow="1" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" MultiLow="1" isSemicolon="true">
          <typings>ChangeSignal</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="observations" MultiLow="0" MultiHigh="*" valuePart="observations->select{in observation : ObserveChange; observation.changeObserver == observer and observation.changeSignal == signal }" isFeature="true" isSemicolon="true">
          <typings>ObserveChange</typings>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="removeObservation" MultiLow="1">
          <typings>AssignObservations</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" valuePart="thisMonitor" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="replacementValues" valuePart="observations->excluding(observations)" isSemicolon="true"/>
        </elements>
      </elements>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
