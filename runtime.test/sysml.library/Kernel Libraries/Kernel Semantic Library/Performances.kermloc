<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Performances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9; * This package defines classifiers and features that related to the typing of performances and evaluations.&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::occurrences"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links::BinaryLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::Transfer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::transfers"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::TransferBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::transfersBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="Performance">
      <subsetting>Occurrence</subsetting>
      <disjoining>Object</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Performance is the most general class of behavioral Occurrences that may be performed over time.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true">
        <typings>Performance</typings>
        <redefinitions>Occurrence::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="involvedObjects" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Objects that are involved in this Performance.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="performers" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <subsetting>involvedObjects</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Objects that enact this Performance.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="true" isFeature="true">
        <redefinitions>isDispatch</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="thisPerformance" isFeature="true">
        <redefinitions>dispatchScope</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="enclosedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>performances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <intersecting>performances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * timeEnclosedOccurrences of this Performance that are also Performances.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="thisPerformance" MultiLow="1" isDefault="true" valuePart="self" isFeature="true">
        <typings>Performance</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Defaults to the root of the subperformance composition tree.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="self"/>
        <connectorPart MultiLow="1" refElement="thisPerformance"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="subperformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>enclosedPerformances</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>enclosedPerformances</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * enclosedPerformances that are composite. &#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Performance).this" isFeature="true">
          <redefinitions>this</redefinitions>
          <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The default &quot;this&quot; context of a subperformance is the same as that of its owning Performance.&#xA;&#x9;&#x9;&#x9;&#x9; * This means that the context for any Performance that is in a composition tree rooted&#xA;&#x9;&#x9;&#x9;&#x9; * in a Performance that is not itself owned by an Object is the root Performance. If the&#xA;&#x9;&#x9;&#x9;&#x9; * root Performance is an ownedPerformance of an Object, then that Object is the context.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Performance).thisPerformance" isFeature="true">
          <redefinitions>thisPerformance</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="Evaluation">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Evaluation is the most general class of functions that may be evaluated to compute&#xA;&#x9;&#x9; * a result.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="0" MultiHigh="*" isNonunique="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Predicate" isAbstract="true" declaredName="BooleanEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * BooleanEvaluation is a specialization of Evaluation that is the most general class of&#xA;&#x9;&#x9; * Predicates that may be evaluated to produce a Boolean truth value.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="MetadataAccessEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * MetadataAccessEvaluation is a specialization of Evaluation for the case of MetadataAccessExpressions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" MultiHigh="*">
        <typings>Metaobject</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LiteralEvaluation is a specialization of Evaluation for the case of LiteralExpressions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Predicate" isAbstract="true" declaredName="LiteralBooleanEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <subsetting>BooleanEvaluation</subsetting>
      <intersecting>LiteralEvaluation</intersecting>
      <intersecting>BooleanEvaluation</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LiteralBooleanEvaluation is a specialization of LiteralEvaluation for the case of LiteralBooleans.&#xA;&#x9;&#x9; * It is also a predicate and thus a specialization of BooleanEvaluation. &#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralIntegerEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LiteralIntegerEvaluation is a specialization of LiteralEvaluation for the case of LiteralIntegers.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Integer</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralRationalEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LiteralRationalEvaluation is a specialization of LiteralEvaluation for the case of LiteralRationals.&#xA;&#x9;&#x9; * (Note: Return type is Real to allow easy type conformance of LiteralRationals when a Real result is expected.)&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralStringEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * LiteralStringEvaluation is a specialization of LiteralEvaluation for the case of LiteralStrings.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="NullEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * NullEvaluation is a specialization of Evaluation for the case of NullExpressions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="0">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="InvolvedIn" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * InvolvedIn asserts that the involvedObject is involved in the Behavior carried out by the &#xA;&#x9;&#x9; * involvingPerformance.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="involvedObject" isFeature="true">
        <typings>Object</typings>
        <crosses>involvingPerformance.involvedObjects</crosses>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="involvingPerformance" isFeature="true">
        <typings>Performance</typings>
        <crosses>involvedObject.involvingPerformances</crosses>
        <redefinitions>target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="Performs" isSufficient="true">
      <subsetting>InvolvedIn</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Performs asserts that the performer enacts the Behavior carried out by the performance.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="performerObject" isFeature="true">
        <typings>Object</typings>
        <crosses>performance.performers</crosses>
        <redefinitions>involvedObject</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="performance" isFeature="true">
        <typings>Performance</typings>
        <crosses>performerObject.enactedPerformances</crosses>
        <redefinitions>involvingPerformance</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="performances" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Performance</typings>
      <subsetting>occurrences</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * performances is the most general feature for performances of Behaviors.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="evaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Evaluation</typings>
      <subsetting>performances</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * evaluations is a specialization of performances for evaluations of Functions.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="constructorEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;     * constructorEvaluations is a specialization of evaluations that restricts the multiplicity &#xA;&#x9;     * of its result parameter to 1..1, requiring a constructorEvaluation to result in a single value.&#xA;&#x9;     */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="1" MultiHigh="1"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="booleanEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>BooleanEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * booleanEvaluations is a specialization of evaluations restricted to type BooleanEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="trueEvaluations">
      <subsetting>booleanEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * trueEvaluations is a subset of booleanEvaluations that result in true. It is the most general&#xA;&#x9;&#x9; * feature of invariants that are not negated. &#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="trueValue" valuePart="true" isFeature="true"/>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="result"/>
        <connectorPart refElement="trueValue"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="falseEvaluations">
      <subsetting>booleanEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * falseEvaluations is a subset of booleanEvaluations that result in false. It is the most general&#xA;&#x9;&#x9; * feature of invariants that are negated.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="falseValue" valuePart="false" isFeature="true"/>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="result"/>
        <connectorPart refElement="falseValue"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="metadataAccessEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>MetadataAccessEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * metadataAccessEvaluations is a specialization of evaluations restricted to type MetadataAccessEvaluation. &#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * literalEvaluations is a specialization of evaluations restricted to type LiteralEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalBooleanEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralBooleanEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <subsetting>booleanEvaluations</subsetting>
      <intersecting>literalEvaluations</intersecting>
      <intersecting>booleanEvaluations</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * literaBooleanlEvaluations is a specialization of literalEvaluations and booleanEvaluations restricted &#xA;&#x9;&#x9; * to type LiteralBooleanEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalIntegerEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralIntegerEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * literalEvaluations is a specialization of evaluations restricted to type LiteralEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalRationalEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralRationalEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * literalRationalEvaluations is a specialization of literalEvaluations restricted to type LiteralRationalEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalStringEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralStringEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * literalStringEvaluations is a specialization of literalEvaluations restricted to type LiteralStringEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="nullEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>NullEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * nullEvaluations is a specialization of evaluations restricted to type NullEvaluation.&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
</kerMLOC:RootNamespace>
