<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Allocations" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package defines the base types for allocations and related structural elements&#xA;&#x9; * in the SysML language.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="Allocation">
      <superclassifiers>BinaryConnection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Allocation is the most general class of allocation, represented as a connection &#xA;&#x9;&#x9; * between the source of the allocation and the target. Allocation is the base type &#xA;&#x9;&#x9; * of all AllocationDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="source" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryConnection::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="target" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryConnection::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage" isAbstract="true" declaredName="allocations" Multi1="0" Multi02="*" isNonunique="true">
      <typings>Allocation</typings>
      <subsetting>binaryConnections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * allocations is the base feature of all AllocationUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
