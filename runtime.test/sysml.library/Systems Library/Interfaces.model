<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Interfaces" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;     * This package defines the base types for interfaces and related structural elements in the SysML language.&#xA;     */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::Connection"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::connections"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::BinaryConnection"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::binaryConnections"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Ports::Port"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::excludingAt"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::selectOne"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" visibility="private" declaredName="excludingOnce">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * Return a sequence that is the same as the input sequence, but with a single&#xA;         * instance of a given value removed. The given value must be in the input sequence.&#xA;         */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="seq" MultiLow="1" MultiHigh="*" isOrdered="true" isNonunique="true"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="value" MultiLow="1">
        <subsetting>seq</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="position" MultiLow="1" valuePart="(1..size(seq))->selectOne{in i; seq#(i) == value}">
        <typings>Natural</typings>
      </elements>
      <resultExpressionParameter resultExpression="seq->excludingAt(position)"/>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceDefinition" isAbstract="true" declaredName="Interface">
      <superclassifiers>Connection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * Interface is the most general class of links between Ports on Parts &#xA;         * within some containing structure. Interface is the base type of all&#xA;         * InterfaceDefinitions. &#xA;         * &#xA;         * Transfers outgoing from any one of the participant Ports of an Interface &#xA;         * may be targeted to one of the other participant Ports (depending on any &#xA;         * other Interfaces in which the Port is also participating).&#xA;         */"/>
      <elements xsi:type="sysMLOC:PortUsage" isReference="true" MultiLow="2" MultiHigh="*" isOrdered="true" isNonunique="true">
        <typings>Port</typings>
        <redefinitions>participant</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;             * The participants of an Interface must be Ports. The interfacingPorts of&#xA;             * each participant Port include all the other participants in the Interface.&#xA;             */"/>
        <elements xsi:type="sysMLOC:ReferenceUsage" visibility="protected" declaredName="thisParticipant">
          <redefinitions>self</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" visibility="protected" declaredName="otherParticipants" MultiLow="1" MultiHigh="*" isNonunique="true" isDefault="true" valuePart="participant->excludingOnce(thisParticipant)">
          <typings>Port</typings>
          <subsetting>interfacingPorts</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceDefinition" isAbstract="true" declaredName="BinaryInterface">
      <superclassifiers>Interface</superclassifiers>
      <superclassifiers>BinaryConnection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * BinaryInterface is the most general class of links between two Ports &#xA;         * on Parts within some containing structure. BinaryInterface is the base &#xA;         * type of all binary InterfaceDefinitions which have exactly two ends. &#xA;         * &#xA;         * Transfers outgoing from each participant Port of a BinaryInterface may be &#xA;         * targeted to the other participant Port (depending on any other Interfaces &#xA;         * in which the Port is also participating).&#xA;         */"/>
      <elements xsi:type="sysMLOC:PortUsage" isReference="true" MultiLow="2" isOrdered="true" isNonunique="true">
        <redefinitions>Interface::participant</redefinitions>
        <redefinitions>BinaryConnection::participant</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="source">
        <typings>Port</typings>
        <redefinitions>BinaryConnection::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="target">
        <typings>Port</typings>
        <redefinitions>BinaryConnection::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceUsage" isAbstract="true" declaredName="interfaces" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Interface</typings>
      <subsetting>connections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * interfaces is the base feature of all InterfaceUsages.&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceUsage" isAbstract="true" declaredName="binaryInterfaces" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>BinaryInterface</typings>
      <subsetting>interfaces</subsetting>
      <subsetting>binaryConnections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;         * interfaces is the base feature of all binary InterfaceUsages.&#xA;         */"/>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
