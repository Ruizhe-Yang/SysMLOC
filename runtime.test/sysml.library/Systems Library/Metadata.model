<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Metadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA; * This package defines the base types for metadata definitions and related &#xA; * metadata annotations in the SysML language.&#xA; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::metaobjects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::Item"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::items"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="MetadataItem" isAbstract="true">
      <superclassifiers>Metaobject</superclassifiers>
      <superclassifiers>Item</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * MetadataItem is the most general class of Items that represent Metaobjects. &#xA;&#x9;&#x9; * MetadataItem is the base type of all MetadataDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>MetadataItem</typings>
        <redefinitions>Metaobject::self</redefinitions>
        <redefinitions>Item::self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemUsage" isAbstract="true" declaredName="metadataItems" MultiLow="0" MultiHigh="*">
      <typings>MetadataItem</typings>
      <subsetting>metaobjects</subsetting>
      <subsetting>items</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * metadataItems is the base feature of all MetadataUsages.&#xA;&#x9;&#x9; * &#xA;&#x9;&#x9; * Note: It is not itself a MetadataUsage, because it is not being used as an&#xA;&#x9;&#x9; * AnnotatingElement here.&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
