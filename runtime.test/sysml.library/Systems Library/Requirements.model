<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Requirements" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package defines the base types for requirements and related elements in the SysML language.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::allTrue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::constraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::assertedConstraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::negatedConstraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Interfaces::Interface"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Attributes::AttributeValue"/>
    <elements xsi:type="sysMLOC:ConstraintDefinition" visibility="private" isAbstract="true" declaredName="RequirementConstraintCheck">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * RequirementConstraintCheck is the base ConstraintCheck for RequirementCheck, defining the&#xA;&#x9;&#x9; * separate assumptions and required constraints such that, if all the assumptions are true,&#xA;&#x9;&#x9; * then all the required constraints must be true.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="assumptions" MultiLow="0" MultiHigh="*">
        <subsetting>constraintChecks</subsetting>
        <subsetting>subperformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Assumptions that must hold for the required constraints to apply.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="constraints" MultiLow="0" MultiHigh="*">
        <subsetting>constraintChecks</subsetting>
        <subsetting>subperformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The required constraints that are to be checked.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" valuePart="allTrue(assumptions()) implies allTrue(constraints())">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * If all the assumptions are true, then all the required constraints must hold.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" isAbstract="true" declaredName="RequirementCheck">
      <superclassifiers>RequirementConstraintCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * RequirementCheck is the most general class for requirements checking. RequirementsCheck is the base&#xA;&#x9;&#x9; * type of all requirement definitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:RequirementUsage" isReference="true">
        <typings>RequirementCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" MultiValue="1">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The entity that is being checked for satisfaction of the required constraints.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="actors" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The Parts that fill the role of actors for this RequirementCheck.&#xA;&#x9;&#x9;&#x9; * (Note: This is not itself an actor parameter, because specific actor&#xA;&#x9;&#x9;&#x9; * parameters will be added for specific RequirementChecks.)&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="stakeholders" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The Parts that represent stakeholders interested in the concern being checked.&#xA;&#x9;&#x9;&#x9; * (Note: This is not itself a stakeholder parameter, because specific stakeholder&#xA;&#x9;&#x9;&#x9; * parameters will be added for specific RequirementChecks.)&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* &#xA;&#x9;&#x9; * Note: assumptions and constraints are redefined here solely to simplify the&#xA;&#x9;&#x9; * resolution of their qualified names as library elements.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="assumptions">
        <redefinitions>RequirementConstraintCheck::assumptions</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="constraints">
        <redefinitions>RequirementConstraintCheck::constraints</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="subrequirements" MultiLow="0" MultiHigh="*">
        <subsetting>requirementChecks</subsetting>
        <subsetting>constraints</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Nested requirements, which are also required constraints.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConcernUsage" isAbstract="true" declaredName="concerns" MultiLow="0" MultiHigh="*">
        <subsetting>concernChecks</subsetting>
        <subsetting>subrequirements</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The checks of any concerns being addressed (as required constraints).&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="FunctionalRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A functional requirement specifies an action that a system, or part of a system, must perform.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Action</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="InterfaceRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * An interface requirement specifies an interface for connecting systems and system parts, which&#xA;&#x9;&#x9; * optionally may include item flows across the interface and/or interface constraints.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Interface</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="PerformanceRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A performance requirement quantitavely measures the extent to which a system, or a system part, &#xA;&#x9;&#x9; * satisfies a required capability or condition.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>AttributeValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="PhysicalRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A physical requirement specifies physical characteristics and/or physical constraints of the &#xA;&#x9;&#x9; * system, or a system part.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Part</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="DesignConstraintCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A design constraint specifies a constraint on the implementation of the system or system part, &#xA;&#x9;&#x9; * such as the system must use a commercial off the shelf component.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Part</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConcernDefinition" declaredName="ConcernCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * ConcernCheck is the most general class for concern checking. ConcernCheck is the base type of &#xA;&#x9;&#x9; * all ConcernDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConcernUsage" isReference="true">
        <typings>ConcernCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="requirementChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>RequirementCheck</typings>
      <subsetting>constraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * requirementChecks is the base feature of all requirement usages.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="satisfiedRequirementChecks">
      <subsetting>requirementChecks</subsetting>
      <subsetting>assertedConstraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * satisfiedRequirementChecks is the subset of requirementChecks for Requirements asserted to be satisfied.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="notSatisfiedRequirementChecks" MultiLow="0" MultiHigh="*">
      <typings>RequirementCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <subsetting>negatedConstraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * notSatisfiedRequirementChecks is the subset of requirementChecks for Requirements asserted to be not satisfied.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConcernUsage" isAbstract="true" declaredName="concernChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>ConcernCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * concernChecks is the base feature of all ConcernUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
