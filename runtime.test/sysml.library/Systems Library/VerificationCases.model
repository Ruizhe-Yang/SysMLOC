<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="VerificationCases" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package defines the base types for verification cases and related behavioral elements &#xA;&#x9; * in the SysML language.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::Case"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::cases"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::RequirementCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:VerificationCaseDefinition" isAbstract="true" declaredName="VerificationCase">
      <superclassifiers>Case</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * VerificationCase is the most general class of performances of VerificationCaseDefinitions. &#xA;&#x9;&#x9; * VericationCase is the base class of all VerificationCaseDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" isReference="true" declaredName="self">
        <typings>VerificationCase</typings>
        <redefinitions>Case::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj">
        <redefinitions>Case::subj</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="verdict">
        <typings>VerdictKind</typings>
        <redefinitions>result</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="obj">
        <redefinitions>Case::obj</redefinitions>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" valuePart="VerificationCase::subj"/>
        <elements xsi:type="sysMLOC:RequirementUsage" declaredName="requirementVerifications" MultiLow="0" MultiHigh="*">
          <typings>RequirementCheck</typings>
          <subsetting>subrequirements</subsetting>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * A record of the evaluations of the RequirementChecks of requirements being verified.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" isReference="true" declaredName="requirementVerifications" MultiLow="0" MultiHigh="*" valuePart="obj.requirementVerifications">
        <typings>RequirementCheck</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Checks on whether the verifiedRequirements of the VerificationCase have been satisfied.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" isAbstract="true" declaredName="subVerificationCases" MultiLow="0" MultiHigh="*">
        <typings>VerificationCase</typings>
        <subsetting>verificationCases</subsetting>
        <subsetting>subcases</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The subcases of this VerificationCase that are VerificationCaseUsages.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:VerificationCaseUsage" isAbstract="true" declaredName="verificationCases" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>VerificationCase</typings>
      <subsetting>cases</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * verificationCases is the base feature of all VerificationCaseUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="VerdictKind">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * VerdictKind is an enumeration of the possible results of a VerificationCase.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="pass"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="fail"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="inconclusive"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="error"/>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="PassIf">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * PassIf returns a pass or fail VerdictKind depending on whether its argument is&#xA;&#x9;&#x9; * true or false.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="isPassing">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="verdict" valuePart="if isPassing? VerdictKind::pass else VerdictKind::fail">
        <typings>VerdictKind</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="VerificationMethod">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * VerificationMethod can be used as metadata annotating a verification case or action.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="kind" MultiLow="1" MultiHigh="*">
        <typings>VerificationMethodKind</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="VerificationMethodKind">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * VerificationMethodKind is an enumeration of the standard methods by which verification&#xA;&#x9;&#x9; * can be carried out.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="inspect"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="analyze"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="demo"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="test"/>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
