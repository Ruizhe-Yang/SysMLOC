<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Views" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * This package defines the base types for views, viewpoints, renderings and related elements &#xA;&#x9; * in the SysML language.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::RequirementCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::requirementChecks"/>
    <elements xsi:type="sysMLOC:ViewDefinition" isAbstract="true" declaredName="View">
      <superclassifiers>Part</superclassifiers>
      <elements xsi:type="sysMLOC:ViewUsage" isReference="true">
        <typings>View</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ViewUsage" isAbstract="true" isReference="true" declaredName="subviews" Multi1="0" Multi02="*">
        <typings>View</typings>
        <subsetting>views</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;    &#x9;&#x9; * Other Views that are used in the rendering of this View.&#xA;    &#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" declaredName="viewRendering" Multi1="0" Multi02="1">
        <typings>Rendering</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The rendering of this View.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ViewpointUsage" declaredName="viewpointSatisfactions" Multi1="0" Multi02="*">
        <typings>ViewpointCheck</typings>
        <subsetting>viewpointChecks</subsetting>
        <subsetting>checkedConstraints</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Checks that the View satisfies all required ViewpointUsages.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="viewpointConformance" satisfactionParameter="that">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * An assertion that all viewpointSatisfactions are true.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="viewpointSatisfactions" kind="require">
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The required ViewpointChecks.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" isDefault="true" valuePart="that.that">
            <redefinitions>ownedPerformances::this</redefinitions>
            <redefinitions>subperformances::this</redefinitions>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ViewpointDefinition" isAbstract="true" declaredName="ViewpointCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * ViewpointCheck is a RequirementCheck for checking if a View meets the concerns of viewpoint stakeholders. &#xA;&#x9;&#x9; * It is the base type of all ViewpointDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ViewpointUsage" isReference="true">
        <typings>ViewpointCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" Multi0="1">
        <typings>View</typings>
        <redefinitions>RequirementCheck::subj</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" isAbstract="true" declaredName="Rendering">
      <superclassifiers>Part</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * Rendering is the base type of all RenderingDefinitions.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:RenderingUsage" isReference="true">
        <typings>Rendering</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" declaredName="subrenderings" Multi1="0" Multi02="*">
        <typings>Rendering</typings>
        <subsetting>renderings</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Other Renderings used to carry out this Rendering.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="TextualRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A TextualRendering is a Rendering of a View into a textual format.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="GraphicalRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A GraphicalRendering is a Rendering of a View into a Graphical format.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="TabularRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * A TabularRendering is a Rendering of a View into a tabular format.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewUsage" isAbstract="true" declaredName="views" Multi1="0" Multi02="*" isNonunique="true">
      <typings>View</typings>
      <subsetting>parts</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * views is the base feature of all ViewUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewpointUsage" isAbstract="true" declaredName="viewpointChecks" Multi1="0" Multi02="*" isNonunique="true">
      <typings>ViewpointCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * viewpointChecks is the base feature of all ViewpointUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" declaredName="renderings" Multi1="0" Multi02="*" isNonunique="true">
      <typings>Rendering</typings>
      <subsetting>parts</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * renderings is the base feature of all RenderingUsages.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asTextualNotation" Multi0="1">
      <typings>TextualRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * asTextualNotation renders a View into textual notation as defined in the &#xA;&#x9;&#x9; * KerML and SysML specifications.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asTreeDiagram" Multi0="1">
      <typings>GraphicalRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * asTreeDiagram renders a View as a tree diagram, using the &#xA;&#x9;&#x9; * graphical notation defined in the SysML specification.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asInterconnectionDiagram" Multi0="1">
      <typings>GraphicalRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * asInterconnectionDiagram renders a View as an interconnection &#xA;&#x9;&#x9; * diagram, using the graphical notation defined in the SysML specification.&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asElementTable" Multi0="1">
      <typings>TabularRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9; * asElementTable  renders a View as a table, with one row for each exposed &#xA;&#x9;&#x9; * Element and columns rendered by applying the columnViews in order to the&#xA;&#x9;&#x9; * Element in each row.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ViewUsage" declaredName="columnView" Multi1="0" Multi02="*" isOrdered="true">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The Views to be rendered in the column cells, in order, of each rows of the table.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" Multi1="0" Multi02="1">
          <redefinitions>viewRendering</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" Multi1="0" Multi02="*" valuePart="columnView.viewRendering">
        <redefinitions>subrenderings</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
