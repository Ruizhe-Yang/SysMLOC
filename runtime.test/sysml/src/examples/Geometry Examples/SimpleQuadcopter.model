<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="SimpleQuadcopter">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SpatialItems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ShapeItems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RealFunctions::sqrt"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TrigFunctions::pi"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TrigFunctions::tan"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::CoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::TranslationRotationSequence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::Translation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::Rotation"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="motorShape">
      <typings>SpatialItem</typings>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Cylinder</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="18 [mm]">
          <redefinitions>radius</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="30 [mm]">
          <redefinitions>height</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Strut">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// By default will get same coordinateFrame.mRefs as owning SpatialItem, i.e.:&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// attribute :>> coordinateFrame { :>> mRefs = (mm, mm, mm); }&#xA;"/>
      <elements xsi:type="sysMLOC:Comment" body="/* rawStrut is a construction shape: a rectangular beam */"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="rawStrut">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage">
          <typings>Box</typings>
          <redefinitions>shape</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="160 [mm]">
            <redefinitions>length</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="15 [mm]">
            <redefinitions>width</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="8 [mm]">
            <redefinitions>height</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (0, shape.width/2, 0)[source]))">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* motorCutout is a construction shape: a cylinder of the same shape as the  */"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="motorCutout">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" valuePart="motorShape.shape">
          <redefinitions>shape</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (175, 0, -1)[source]))">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Strut shape is CSG difference of rawStrut minus motorCutout */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
        <subsetting>differencesOf</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" valuePart="(rawStrut, motorCutout)">
          <redefinitions>elements</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="PropellerMotorAssy">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// By default will get same coordinateFrame.mRefs as owning CompoundSpatialItem, i.e.:&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// attribute :>> coordinateFrame { :>> mRefs = (mm, mm, mm); }&#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="propeller">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage">
          <typings>Cylinder</typings>
          <redefinitions>shape</redefinitions>
          <elements xsi:type="sysMLOC:Documentation" body="/* propeller stay-out volume, without propeller shaft */"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="80 [mm]">
            <redefinitions>radius</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="6 [mm]">
            <redefinitions>height</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (175, 0, 31)[source]))">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="motor">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" valuePart="motorShape.shape">
          <redefinitions>shape</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (175, 0, 0)[source]))">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// By default the shape of a PropellerMotorAssy is the union of its owned composite items and parts that are SpatialItems.&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Camera">
      <superclassifiers>SpatialItem</superclassifiers>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// By default will get same coordinateFrame.mRefs as owning CompoundSpatialItem, i.e.:&#xA;"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// attribute :>> coordinateFrame { :>> mRefs = (mm, mm, mm); }&#xA;"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="cameraHousing">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage">
          <typings>Cylinder</typings>
          <redefinitions>shape</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="15 [mm]">
            <redefinitions>radius</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="24 [mm]">
            <redefinitions>height</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* The field of view is modeled as an item, since it is not a part of the quadcopter but rather a stay-out volume &#xA;         * that can for example be used to formulate a constraint.&#xA;         */"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="fieldOfView">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/* Conical field of view with half-top angle 20 degree */"/>
        <elements xsi:type="sysMLOC:ItemUsage">
          <typings>Cone</typings>
          <redefinitions>shape</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="height * tan(20 * pi/180) [mm]">
            <redefinitions>radius</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="500 [mm]">
            <redefinitions>height</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Rotation( (0, 1, 0)[source], 180['&#xb0;']))">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// By default the shape of a Camera is the union of its owned composite items and parts that are SpatialItems.&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="quadCopter">
      <typings>SpatialItem</typings>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="datum">
        <redefinitions>coordinateFrame</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* The datum is the top level coordinate frame of the system-of-interest, i.e., the quadcopter.&#xA;                 * By convention its origin is placed at the bottom of the mainBody with the +X axis pointing in the &#xA;                 * forward fligth (velocity) direction and the +Z axis pointing upward. The +Y axis completes the &#xA;                 * right-handed Cartesian coordinate system.&#xA;                 */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(mm, mm, mm)">
          <redefinitions>mRefs</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="mainBody">
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:Comment" body="/* rawBody is a construction shape: the enveloping rectangular box */"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rawBody">
          <subsetting>subSpatialParts</subsetting>
          <elements xsi:type="sysMLOC:ItemUsage">
            <typings>Box</typings>
            <redefinitions>shape</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="160 [mm]">
              <redefinitions>length</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="15 [mm]">
              <redefinitions>width</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="8 [mm]">
              <redefinitions>height</redefinitions>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>coordinateFrame</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <typings>TranslationRotationSequence</typings>
              <redefinitions>transformation</redefinitions>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (0, shape.width/2, 0)[source]))">
                <redefinitions>elements</redefinitions>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/* cuttingBox is a construction shape: the enveloping rectangular box */"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="cuttingCornersBox">
          <subsetting>subSpatialParts</subsetting>
          <elements xsi:type="sysMLOC:ItemUsage">
            <typings>Box</typings>
            <redefinitions>shape</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="105 [mm]">
              <redefinitions>length</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="105 [mm]">
              <redefinitions>width</redefinitions>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="60 [mm]">
              <redefinitions>height</redefinitions>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>coordinateFrame</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <typings>TranslationRotationSequence</typings>
              <redefinitions>transformation</redefinitions>
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (0, -shape.length/sqrt(2), -10)[source]), new Rotation((0, 0, 1)[source], 45['&#xb0;']) )">
                <redefinitions>elements</redefinitions>
              </elements>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/* Main body shape is the CSG intersection of rawBody and cuttingCornersBox */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" MultiValue="1">
          <subsetting>intersectionsOf</subsetting>
          <elements xsi:type="sysMLOC:ItemUsage" valuePart="(rawBody, cuttingCornersBox)">
            <redefinitions>elements</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Current syntax is not end-user friendly&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// It will be possible to specify following simple CSG expression:&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// item :>> shape = rawBody &amp; cuttingCornersBox;&#xA;"/>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Helper construction parameters&#xA;"/>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="xStrut" valuePart="49.60[mm]">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="yStrut" valuePart="24.65[mm]">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="zStrut" valuePart="25[mm]">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="zPMAssy" valuePart="12[mm]">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="strut1">
        <typings>Strut</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (xStrut.num, yStrut.num, zStrut.num)[source]), new Rotation((0, 0, 1)[source], 45['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="strut2">
        <typings>Strut</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (-xStrut.num, yStrut.num, zStrut.num)[source]), new Rotation((0, 0, 1)[source], 135['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="strut3">
        <typings>Strut</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (-xStrut.num, -yStrut.num, zStrut.num)[source]), new Rotation((0, 0, 1)[source], 225['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="strut4">
        <typings>Strut</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (xStrut.num, -yStrut.num, zStrut.num)[source]), new Rotation((0, 0, 1)[source], 315['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="propellerMotorAssy1">
        <typings>PropellerMotorAssy</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (xStrut.num, yStrut.num, zPMAssy.num)[source]), new Rotation((0, 0, 1)[source], 45['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="propellerMotorAssy2">
        <typings>PropellerMotorAssy</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (-xStrut.num, yStrut.num, zPMAssy.num)[source]), new Rotation((0, 0, 1)[source], 135['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="propellerMotorAssy3">
        <typings>PropellerMotorAssy</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (-xStrut.num, -yStrut.num, zPMAssy.num)[source]), new Rotation((0, 0, 1)[source], 225['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="propellerMotorAssy4">
        <typings>PropellerMotorAssy</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (xStrut.num, -yStrut.num, zPMAssy.num)[source]), new Rotation((0, 0, 1)[source], 315['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* The camera is placed protruding from the +X face of the main body, rotated about the +Y axis over 50&#xb0; downwards */"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="camera">
        <typings>Camera</typings>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <typings>TranslationRotationSequence</typings>
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(new Translation( (59, 0, 2)[source]), new Rotation((0, 1, 0)[source], 50['&#xb0;']) )">
              <redefinitions>elements</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
