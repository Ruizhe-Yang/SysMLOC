<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="RationaleMetadataExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ModelingMetadata::Rationale"/>
    <elements xsi:type="sysMLOC:Comment" body="/* Example: the following provides the rationale for selecting the engine4cyl based on a trade study analysis. &#xA;    The rationale could be contained in the vehicle configuration with the selected engine */"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="engine"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="engine4cyl">
      <subsetting>engine</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="engine6cyl">
      <subsetting>engine</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:MetadataUsage" declaredName="engineSelectionRationale" metadataTyping="Rationale">
      <annotatedElement>engine4cyl</annotatedElement>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="text" valuePart="&quot;This rationale for selecting the engine4cyl refers to the engineTradeOffAnalysis.&quot;"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="explanation" valuePart="engineTradeOffAnalysis"/>
    </elements>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TradeStudies" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="engineTradeOffAnalysis">
      <typings>TradeStudy</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="alternatives" MultiValue="2" valuePart="(engine4cyl, engine6cyl)">
        <subsetting>engine</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* ... */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="selectedEngine">
        <subsetting>engine</subsetting>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
