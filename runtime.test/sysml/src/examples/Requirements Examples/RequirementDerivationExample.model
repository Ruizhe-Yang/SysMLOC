<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="RequirementDerivationExample">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RequirementDerivation" isNamespace="true"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="Req1"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="Req1_1"/>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="Req1_2"/>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Req1_Derivation">
      <prefixMetadataExtension>#derivation</prefixMetadataExtension>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true" declaredName="r1">
        <prefixMetadataExtension>#original</prefixMetadataExtension>
        <typings>Req1</typings>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true" declaredName="r1_1">
        <prefixMetadataExtension>#derive</prefixMetadataExtension>
        <typings>Req1_1</typings>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" isEnd="true" declaredName="r1_2">
        <prefixMetadataExtension>#derive</prefixMetadataExtension>
        <typings>Req1_2</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="System"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Subsystem1"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Subsystem2"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="system">
      <typings>System</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="sub1">
        <typings>Subsystem1</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="sub2">
        <typings>Subsystem2</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="satisfactionContext">
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <redefinitions>system</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="req1" satisfactionParameter="system">
        <typings>Req1</typings>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="req1_1" satisfactionParameter="system.sub1">
        <typings>Req1_1</typings>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="req1_2" satisfactionParameter="system.sub2">
        <typings>Req1_2</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <prefixMetadataExtension>#derivation</prefixMetadataExtension>
        <typings>Req1_Derivation</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="r1" isEnd="true">
          <references>req1</references>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="r1_1" isEnd="true">
          <references>req1_1</references>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="r1_2" isEnd="true">
          <references>req1_1</references>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
