<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Vehicle Decomposition'">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9; * Example from the SysML 1.6 spec, subclause 8.4.5 Constraining Decomposition.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="chs" MultiValue="1">
        <typings>'Chassis Assembly'</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rb">
          <redefinitions>'Chassis Assembly'::rb</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>w</redefinitions>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>lb</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng" MultiValue="1">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="cyl">
          <redefinitions>Engine::cyl</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="cylinderBR" MultiValue="*" valuePart="eng.cyl"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="rollBarBR" MultiValue="*" valuePart="chs.rb"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="lugBoltBR" MultiLow="24" MultiHigh="32" valuePart="chs.w.lb"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Chassis Assembly'">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="w" MultiValue="4">
        <typings>Wheel</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="rb" MultiLow="0" MultiHigh="1">
        <typings>RollBar</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="lb" MultiLow="6" MultiHigh="10">
        <typings>LugBolt</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LugBolt"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="RollBar"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HeavyRollBar">
      <superclassifiers>RollBar</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="LightRollBar">
      <superclassifiers>RollBar</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="cyl" MultiLow="4" MultiHigh="8">
        <typings>Cylinder</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Cylinder"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Vehicle Model 1'">
      <superclassifiers>Vehicle</superclassifiers>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiValue="4">
        <redefinitions>cylinderBR</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiValue="*">
        <typings>LightRollBar</typings>
        <redefinitions>rollBarBR</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiValue="24">
        <redefinitions>lugBoltBR</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Vehicle Model 2'">
      <superclassifiers>Vehicle</superclassifiers>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiLow="6" MultiHigh="8">
        <redefinitions>cylinderBR</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiValue="0">
        <redefinitions>rollBarBR</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" MultiLow="24" MultiHigh="28">
        <redefinitions>lugBoltBR</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// 6..7 per wheel&#xA;"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
