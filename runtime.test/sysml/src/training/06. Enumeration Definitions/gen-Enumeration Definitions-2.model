<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Enumeration Definitions-2'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Enumeration Definitions-1'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ClassificationLevel">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="code">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="color">
        <typings>TrafficLightColor</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="ClassificationKind">
      <superclassifiers>ClassificationLevel</superclassifiers>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="unclassified">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;uncl&quot;">
          <redefinitions>code</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="TrafficLightColor::green">
          <redefinitions>color</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="confidential">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;conf&quot;">
          <redefinitions>code</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="TrafficLightColor::yellow">
          <redefinitions>color</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="secret">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;secr&quot;">
          <redefinitions>code</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="TrafficLightColor::red">
          <redefinitions>color</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="GradePoints">
      <superclassifiers>Real</superclassifiers>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="A" valuePart="4.0"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="B" valuePart="3.0"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="C" valuePart="2.0"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="D" valuePart="1.0"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="F" valuePart="0.0"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
