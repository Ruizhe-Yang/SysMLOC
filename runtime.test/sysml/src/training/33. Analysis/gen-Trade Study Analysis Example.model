<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Trade Study Analysis Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TradeStudies" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="engine4cyl">
      <typings>Engine</typings>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="engine6cyl">
      <typings>Engine</typings>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="PowerRollup">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>ISQ::PowerValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="MassRollup">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>ISQ::MassValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="EfficiencyRollup">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="CostRollup">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="EngineEvaluation">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="power">
        <typings>ISQ::PowerValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass">
        <typings>ISQ::MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="efficiency">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="cost">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="evaluation">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Compute evaluation...&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseUsage" declaredName="engineTradeStudy">
      <typings>TradeStudy</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" valuePart="(engine4cyl, engine6cyl)">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <typings>MaximizeObjective</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage">
        <redefinitions>evaluationFunction</redefinitions>
        <elements xsi:type="sysMLOC:PartUsage" direction="in" declaredName="anEngine">
          <typings>Engine</typings>
          <redefinitions>alternative</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:CalculationUsage" declaredName="powerRollup">
          <typings>PowerRollup</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine" valuePart="anEngine"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="power"/>
        </elements>
        <elements xsi:type="sysMLOC:CalculationUsage" declaredName="massRollup">
          <typings>MassRollup</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine" valuePart="anEngine"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="mass"/>
        </elements>
        <elements xsi:type="sysMLOC:CalculationUsage" declaredName="efficiencyRollup">
          <typings>EfficiencyRollup</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine" valuePart="anEngine"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="efficiency"/>
        </elements>
        <elements xsi:type="sysMLOC:CalculationUsage" declaredName="costRollup">
          <typings>CostRollup</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="engine" valuePart="anEngine"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="cost"/>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" valuePart="EngineEvaluation( powerRollup.power, massRollup.mass, efficiencyRollup.efficiency, costRollup.cost )">
          <typings>Real</typings>
          <redefinitions>result</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReturn="true">
        <typings>Engine</typings>
        <redefinitions>selectedAlternative</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
