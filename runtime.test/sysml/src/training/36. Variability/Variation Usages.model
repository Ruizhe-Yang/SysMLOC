<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Variation Usages'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Variation Definitions'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="manualTransmission"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="automaticTransmission"/>
    <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="vehicleFamily">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="engine" MultiValue="1">
        <typings>EngineChoices</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="transmission" MultiValue="1">
        <typings>Transmission</typings>
        <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="manualTransmission"/>
        <elements xsi:type="sysMLOC:ReferenceVariantUsage" refElement="automaticTransmission"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="(engine == engine::'4cylEngine' and transmission == transmission::manualTransmission ) xor (engine == engine::'6cylEngine' and transmission == transmission::automaticTransmission )"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
