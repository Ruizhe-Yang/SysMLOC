<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Metadata Example-1'">
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="SafetyFeature"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="SecurityFeature">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>SysML::PartDefinition</typings>
        <subsetting>annotatedElement</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>SysML::PartUsage</typings>
        <subsetting>annotatedElement</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="SafetyFeature">
      <annotatedElement>vehicle::interior::seatBelt</annotatedElement>
      <annotatedElement>vehicle::interior::driverAirBag</annotatedElement>
      <annotatedElement>vehicle::bodyAssy::bumper</annotatedElement>
    </elements>
    <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="SecurityFeature">
      <annotatedElement>vehicle::interior::alarm</annotatedElement>
      <annotatedElement>vehicle::bodyAssy::keylessEntry</annotatedElement>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="interior">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="alarm"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="seatBelt" MultiValue="2"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontSeat" MultiValue="2"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="driverAirBag"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="bodyAssy">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="body"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="bumper"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="keylessEntry"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
