<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Metadata Example-2'">
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="computeDynamics">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AnalysisTooling" isNamespace="true"/>
      <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolExecution">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="toolName" valuePart="&quot;ModelCenter&quot;"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="uri" valuePart="&quot;aserv://localhost/Vehicle/Equation1&quot;"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="dt">
        <typings>ISQ::TimeValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;deltaT&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="a">
        <typings>ISQ::AccelerationValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;mass&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_in">
        <typings>ISQ::SpeedValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;v0&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_in">
        <typings>ISQ::LengthValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;x0&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="v_out">
        <typings>ISQ::SpeedValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;v&quot;"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="x_out">
        <typings>ISQ::LengthValue</typings>
        <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="ToolVariable">
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="name" valuePart="&quot;x&quot;"/>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
