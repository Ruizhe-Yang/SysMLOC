<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'3c-Function-based Behavior-structure mod-3'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleFrame"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HitchBall"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Trailer"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerFrame"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerCoupler"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleFrame">
        <typings>VehicleFrame</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="hitch">
          <typings>HitchBall</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="trailer">
      <typings>Trailer</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trailerFrame">
        <typings>TrailerFrame</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="coupler">
          <typings>TrailerCoupler</typings>
          <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="hitch">
            <typings>HitchBall</typings>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage">
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Insert the vehicle HitchBall into the TrailerCoupler.&#xA;"/>
      <elements xsi:type="sysMLOC:AssignmentNode" declaredName="'connect trailer to vehicle'" featureChain="trailer.trailerFrame.coupler.hitch" NodeParameter="vehicle.vehicleFrame.hitch"/>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// Remove the HitchBall from the TrailerCoupler.&#xA;"/>
      <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" declaredName="'disconnect trailer from vehicle'" featureChain="trailer.trailerFrame.coupler.hitch" NodeParameter="null"/>
    </elements>
  </elements>
</sysMLOC:Namespace>
