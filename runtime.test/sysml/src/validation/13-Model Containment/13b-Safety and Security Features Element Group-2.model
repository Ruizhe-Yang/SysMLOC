<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'13b-Safety and Security Features Element Group-2'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="AnnotationDefinitions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="PartsTree" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="AnnotationDefinitions">
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Safety">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isMandatory">
          <typings>Boolean</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Security"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="PartsTree">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
        <elements xsi:type="sysMLOC:PartUsage" declaredName="interior">
          <elements xsi:type="sysMLOC:PartUsage" declaredName="alarm">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Security"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="seatBelt" MultiValue="2">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="true"/>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontSeat" MultiValue="2"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="driverAirBag">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="false"/>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="bodyAssy">
          <elements xsi:type="sysMLOC:PartUsage" declaredName="body"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="bumper">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="true"/>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="keylessEntry">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Security"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="wheelAssy">
          <elements xsi:type="sysMLOC:PartUsage" declaredName="wheel" MultiValue="2"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="antilockBrakes" MultiValue="2">
            <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Safety">
              <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="isMandatory" valuePart="false"/>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Safety Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true">
        <filterPackageExpression>@Safety</filterPackageExpression>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Security Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to security. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true">
        <filterPackageExpression>@Security</filterPackageExpression>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Safety &amp; Security Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety OR security. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true">
        <filterPackageExpression>@Safety or @Security</filterPackageExpression>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Mandatory Saftey Features'">
      <elements xsi:type="sysMLOC:Comment" body="/* Parts that contribute to safety AND are mandatory. */"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="vehicle" isRecursive="true">
        <filterPackageExpression>@Safety and Safety::isMandatory</filterPackageExpression>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
