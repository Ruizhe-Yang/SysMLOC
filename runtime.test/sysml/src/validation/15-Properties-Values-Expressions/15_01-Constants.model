<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_01-Constants'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RealFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Comment" body="/* Note: Value properties that are bound to specific values are constants and have the specified&#xA;     * values in all contexts. It is not legal to redefine them.&#xA;     */"/>
    <elements xsi:type="sysMLOC:Package" declaredName="'Mathematical Constants'">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;     * Standard mathematical constants&#xA;&#x9;     * &#xA;&#x9;     * Irrational constants cannot be represented exactly with finite precision.&#xA;&#x9;     * However, they can be required to be implemented with a attribute that is accurate&#xA;&#x9;     * to at least a certain precision.&#xA;&#x9;     * &#xA;&#x9;     * (The decimal literals here should be interpreted as being fixed point and exact.)&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="e">
        <typings>Real</typings>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <resultExpressionParameter resultExpression="round(e * 1E20) == 271828182845904523536.0"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pi">
        <typings>Real</typings>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <resultExpressionParameter resultExpression="round(pi * 1E20) == 314159265358979323846.0"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Fundamental Physical Constants'">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;     * Standard fundamental physical constants&#xA;&#x9;     * &#xA;&#x9;     * Physical constants have a standard measured attribute to a finite precision.&#xA;&#x9;     *&#xA;&#x9;     * The reference source is:&#xA;&#x9;     * CODATA - Task Group on Fundamental Physical Constants (TGFC) - 2018 CODATA recommended values&#xA;&#x9;     * See https://codata.org/initiatives/strategic-programme/fundamental-physical-constants/&#xA;&#x9;     * For the actual values see https://pml.nist.gov/cuu/Constants/ &#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'fine structure constant'" valuePart="7.2973525693E-3[one]">
        <typings>DimensionOneValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// 2018 CODATA attribute 7.2973525693E-3;  uncertainty = 0.0000000011E-3&#xA;"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'electron to proton mass ratio'" valuePart="5.44617021487E-4[one]">
        <typings>DimensionOneValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// 2018 CODATA attribute 5.44617021487E-4; uncertainty = 0.00000000033E-4 &#xA;"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'speed of light in vacuum'" valuePart="299792458[m/s]">
        <typings>SpeedValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// 2018 CODATA attribute 299792458 m s^-1; (exact)&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Global Context'">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'nominal earth gravitational acceleration'" valuePart="9.80665['m/s&#xb2;']">
        <typings>AccelerationValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Model X Context'">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="'amplifier gain'" valuePart="3.5[one]">
        <typings>DimensionOneValue</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
