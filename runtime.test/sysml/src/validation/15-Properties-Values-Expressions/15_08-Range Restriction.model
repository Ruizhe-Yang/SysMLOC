<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_08-Range Restriction'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'15_01-Constants'::'Mathematical Constants'::pi"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HeadLightsTiltKnob">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="headLightsTile" MultiValue="1">
        <typings>LightBeamTiltAngleValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="LightBeamTiltAngleValue">
      <superclassifiers>PlaneAngleValue</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="angle">
        <typings>LightBeamTiltAngleValue</typings>
        <redefinitions>self</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * Tilt angle shall be limited to the range between 50 and 80 degrees (inclusive).&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="angle >= 50 ['&#xb0;'] and angle &lt;= 80 ['&#xb0;']"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
