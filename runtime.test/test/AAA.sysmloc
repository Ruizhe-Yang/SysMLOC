<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="AAA">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="BBB"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="CCC"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Parent"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="AAA">
      <superclassifiers>BBB</superclassifiers>
      <superclassifiers>CCC</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="ChildClass">
      <superclassifiers>Parent</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="a">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="c">
        <elements xsi:type="sysMLOC:PartDefinition" declaredName="eee"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="ggg">
          <elements xsi:type="sysMLOC:PortDefinition" declaredName="bbbb"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="AA">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="d">
        <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
        <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="a::c::ggg" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="ff">
          <typings>bbbb</typings>
        </elements>
        <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="ee">
          <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="h"/>
          <elements xsi:type="sysMLOC:RequirementUsage" declaredName="hh">
            <typings>h</typings>
          </elements>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="aa" isEnd="true">
            <typings>bbbb</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="no1">
            <superclassifiers>String</superclassifiers>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="noo1" valuePart="&quot;00&quot;">
            <typings>no1</typings>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="no2" valuePart="NaturalFunctions::ToNatural(noo1)"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="no3" valuePart="IntegerFunctions::sum(1)"/>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="no4" valuePart="1.0[SI::s]"/>
          <elements xsi:type="sysMLOC:CodeAnnotation" body="//part gg : ff;&#xD;&#xA;"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SysML" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="Apartusage">
      <typings>Parts::Part</typings>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="port1">
        <subsetting>ownedPorts</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="action1">
        <subsetting>ownedActions</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="aaa" valuePart="Apartusage.done"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="aaaq" valuePart="Apartusage.spaceTimeEnclosedOccurrences"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="aaaa" valuePart="Apartusage.sameLifeOccurrences"/>
    <elements xsi:type="sysMLOC:RequirementUsage" declaredName="ARequirementUsage">
      <typings>Requirements::PerformanceRequirementCheck</typings>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="Apartusage"/>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
