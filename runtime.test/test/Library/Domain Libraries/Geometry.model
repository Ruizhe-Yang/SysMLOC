      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ufre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tfrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ufre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="urre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="trrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="urre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="brrv"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Meeting edges */"/>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="tsre"/>
        <connectorPart MultiLow="1" refElement="tsre"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="ufre"/>
        <connectorPart MultiLow="1" refElement="ufre"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="urre"/>
        <connectorPart MultiLow="1" refElement="urre"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="bsre"/>
        <connectorPart MultiLow="1" refElement="bsre"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Meeting vertices  */"/>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="2" refElement="tfrv"/>
        <connectorPart MultiLow="2" refElement="tfrv"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="2" refElement="trrv"/>
        <connectorPart MultiLow="2" refElement="trrv"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RectangularCuboid">
      <superclassifiers>Cuboid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RectangularCuboid is a Cuboid with all Rectangular sides.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>width</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>height</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>tf</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::length">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::height">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>bf</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::length">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::height">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>ff</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::length">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::width">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>rf</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::length">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::width">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>slf</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::height">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::width">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>srf</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::height">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularCuboid::width">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="Box" memberElement="RectangularCuboid"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Pyramid">
      <superclassifiers>Polyhedron</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Pyramid is a Polyhedron with the sides of a polygon (base) forming the bases of triangles&#xD;&#xA;&#x9;&#x9; * that join at an apex point.&#x9;Its height is the perpendicular distance from the base to the apex,&#xD;&#xA;&#x9;&#x9; * and its offsets are between this perpendicular at the base and the center of the base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>height</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>yoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="base" MultiLow="1">
        <subsetting>faces</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="wall">
        <typings>Triangle</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Triangle::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Triangle::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="wallNumber" valuePart="size(wall)">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(faces) == wallNumber + 1"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(wall) == size(base.edges)"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(edges) == wallNumber * 4"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="apex" valuePart="wall.apex">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(apex) == wallNumber"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Base to wall and wall to wall edge mating. */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="(1..wallNumber)->forAll {in i; includes(wall#(i).base.matingOccurrences, Pyramid::base.edges#(i) ) and includes((wall#(i).edges#(3) as Item).matingOccurrences, wall#(if i==wallNumber ? 1 else i+1).edges#(2) ) }"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Meeting apices. */"/>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="wallNumber" refElement="apex"/>
        <connectorPart MultiLow="wallNumber" refElement="apex"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Tetrahedron">
      <superclassifiers>Pyramid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Tetrahedron is Pyramid with a triangular base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>baseLength</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>baseWidth</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Triangle</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Triangle::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Triangle::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Tetrahedron::baseLength">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Tetrahedron::baseWidth">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RectangularPyramid">
      <superclassifiers>Pyramid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RectangularPyramid is Pyramid with a rectangular base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>baseLength</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>baseWidth</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Rectangle</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Rectangle::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Rectangle::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularPyramid::baseLength">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="RectangularPyramid::baseWidth">
          <redefinitions>width</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: ShapeItems.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: SpatialItems.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="SpatialItems" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package models physical items that have a spatial extent and act as a spatial frame of reference&#xD;&#xA;&#x9; * for obtaining position and displacement vectors of points within them.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::Point"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SpatialFrames::SpatialFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::VectorQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::ThreeDCoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences::nullTransformation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time::Clock"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time::TimeInstantValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::universalCartesianSpatial3dCoordinateFrame"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::Position3dVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::Displacement3dVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VectorFunctions::isZeroVector"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SpatialItem">
      <superclassifiers>SpatialFrame</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A SpatialItem is an Item with a three-dimensional spatial extent that also acts as a SpatialFrame of reference.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" isReference="true" MultiLow="1" isDefault="true" valuePart="Time::universalClock">
        <typings>Clock</typings>
        <redefinitions>localClock</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A local Clock to be used as the corresponding time reference within this SpatialItem. &#xD;&#xA;&#x9;&#x9;&#x9; * By default this is the singleton universalClock.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="coordinateFrame" MultiLow="1" isDefault="true" valuePart="universalCartesianSpatial3dCoordinateFrame">
        <typings>ThreeDCoordinateFrame</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * The three-dimensional CoordinateFrame to be used as the measurement reference for position &#xD;&#xA;             * and displacement vector values relative to this SpatialItem.&#xD;&#xA;             * By default this is the singleton universalCartesianSpatial3dCoordinateFrame.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="originPoint" MultiLow="1">
        <typings>Point</typings>
        <subsetting>spaceShots</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Point at the origin of the coordinateFrame of this SpatialItem.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="originPointConstraint">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The CurrentPositionOf the originPoint must always be a zero vector.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="isZeroVector(CurrentPositionOf(originPoint, that))"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="subSpatialItems" MultiLow="1" MultiHigh="*">
        <typings>SpatialItem</typings>
        <subsetting>subitems</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subitems::localClock</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="subSpatialParts" MultiLow="1" MultiHigh="*">
        <typings>SpatialItem</typings>
        <subsetting>subSpatialItems</subsetting>
        <subsetting>subparts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subSpatialItems::localClock</redefinitions>
          <redefinitions>subparts::localClock</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="componentItems" MultiLow="1" MultiHigh="*">
        <typings>SpatialItem</typings>
        <subsetting>subSpatialItems</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A SpatialItem with componentItems is entirely made up of those items (the SpatialItem occurs only&#xD;&#xA;&#x9;&#x9;&#x9; * as a collection of its componentItems).  By default they have the same localClock and equivalent&#xD;&#xA;&#x9;&#x9;&#x9; * coordinate frame as the SpatialItem they make up.  A SpatialItem without componentItems occurs&#xD;&#xA;&#x9;&#x9;&#x9; * on its own, separately from its subitems.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true" isDefault="true" valuePart="(that as SpatialItem).localClock">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>subSpatialItems::localClock</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>coordinateFrame</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="(that.that as SpatialItem).coordinateFrame.mRefs">
            <redefinitions>mRefs</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" isDefault="true" valuePart="nullTransformation">
            <redefinitions>transformation</redefinitions>
            <elements xsi:type="sysMLOC:AttributeUsage" isDefault="true" valuePart="(that.that.that as SpatialItem).coordinateFrame">
              <redefinitions>source</redefinitions>
            </elements>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="cunionNum" MultiLow="1" valuePart="if isEmpty(componentItems) ? 0 else 1">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="componentUnion" MultiLow="cunionNum">
        <subsetting>unionsOf</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A SpatialItem with componentItems is is a spatial union of them.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="*" valuePart="componentItems">
          <typings>SpatialItem</typings>
          <redefinitions>elements</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="componentParts" MultiLow="1" MultiHigh="*">
        <typings>SpatialItem</typings>
        <subsetting>componentItems</subsetting>
        <subsetting>subSpatialParts</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>SpatialItem::localClock</redefinitions>
          <redefinitions>componentItems::localClock</redefinitions>
          <redefinitions>subSpatialParts::localClock</redefinitions>
          <redefinitions>subparts::localClock</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="PositionOf">
      <superclassifiers>SpatialFrames::PositionOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The PositionOf a Point relative to a SpatialItem, at a specific TimeInstantValue relative to a given Clock,&#xD;&#xA;&#x9;&#x9; * is a positionVector that is a VectorQuantityValue in the coordinateFrame of the SpatialItem.&#xD;&#xA;&#x9;&#x9; * The default Clock is the localClock of the SpatialItem.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInstant" MultiLow="1">
        <typings>TimeInstantValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enclosingItem" MultiLow="1">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="enclosingItem.localClock">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="positionVector" MultiLow="1">
        <typings>Position3dVector</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="enclosingItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="CurrentPositionOf">
      <superclassifiers>SpatialFrames::CurrentPositionOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The CurrentPositionOf a Point relative to a SpatialItem and a Clock is the PositionOf&#xD;&#xA;&#x9;&#x9; * the Point relative to the SpatialItem at the currentTime of the Clock.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="enclosingItem" MultiLow="1">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="enclosingItem.localClock">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="positionVector" MultiLow="1">
        <typings>Position3dVector</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="enclosingItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="DisplacementOf">
      <superclassifiers>SpatialFrames::DisplacementOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The DisplacementOf two Points relative to a SpatialItem, at a specific TimeInstantValue relative to a&#xD;&#xA;&#x9;&#x9; * given Clock, is the displacementVector computed as the difference between the PositionOf the &#xD;&#xA;&#x9;&#x9; * first Point and PositionOf the second Point, relative to that SpatialItem, at that timeInstant.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point1" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point2" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInstant" MultiLow="1">
        <typings>TimeInstantValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="spatialItem" MultiLow="1">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="spatialItem.localClock">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="displacementVector" MultiLow="1">
        <typings>Displacement3dVector</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="spatialItem.coordinateFrame">
          <redefinitions>mRef</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="CurrentDisplacementOf">
      <superclassifiers>SpatialFrames::CurrentDisplacementOf</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The CurrentDisplacementOf two Points relative to a SpatialItem and a Clock is the DisplacementOf&#xD;&#xA;&#x9;&#x9; * the Points relative to the SpatialItem, at the currentTime of the Clock.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point1" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="point2" MultiLow="1">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="spatialItem" MultiLow="1">
        <typings>SpatialItem</typings>
        <redefinitions>'frame'</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="spatialItem.localClock">
        <typings>Clock</typings>
