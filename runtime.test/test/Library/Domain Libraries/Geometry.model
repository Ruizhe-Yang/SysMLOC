<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: ShapeItems.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="ShapeItems" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a model of items that represent basic geometric shapes. &#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQSpaceTime" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQBase" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::m"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::MatesWith"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::Item"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::equals"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::'if'"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::exists"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::scalarQuantities"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="PlanarCurve">
      <superclassifiers>Curve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A PlanarCurve is a Curve with a given length embeddable in a plane.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="notEmpty(outerSpaceDimension) &amp; outerSpaceDimension &lt;= 2"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="PlanarSurface">
      <superclassifiers>Surface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A PlanarSurface is a flat Surface with a given area.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>area</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="2">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>PlanarCurve</typings>
        <redefinitions>shape</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Line">
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Line is a Curve that is a straight line of a given length.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="1">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isAbstract="true" declaredName="Path">
      <superclassifiers>StructuredSpaceObject::StructuredCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Path is the most general structured Curve.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="*">
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0" MultiHigh="2">
          <redefinitions>vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="*" valuePart="edges.vertices">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//isClosed == vertices->forAll{&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//in p1 : Point;&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//vertices->exists{&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//&#x9;p2 : Point; p1 != p2 and includes(p1.matingOccurrences, p2)&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//}&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//} &#xD;&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiMajorAxis" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiMinorAxis" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="xoffset" MultiLow="0" MultiHigh="*" isDefault="true" valuePart="0 [m]">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="yoffset" MultiLow="0" MultiHigh="*" isDefault="true" valuePart="0 [m]">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="baseLength" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="baseWidth" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConicSection">
      <superclassifiers>Path</superclassifiers>
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConicSection is a closed PlanarCurve, possibly disconnected, see Hyperbola.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="2">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Ellipse">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An Ellipse is a ConicSection in the shape of an ellipse of a given semiaxes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Circle">
      <superclassifiers>Ellipse</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Circle is an Ellipse with semiaxes equal to its radius.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="length" MultiLow="1" valuePart="Circle::radius * TrigFunctions::pi * 2"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Parabola">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Parabola is a ConicSection in the shape of a parabola of a given focal length.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="focalDistance" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Hyperbola">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Hyperbola is a ConicSection in the shape of a hyperbola with given axes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tranverseAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="conjugateAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Polygon">
      <superclassifiers>Path</superclassifiers>
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Polygon is a closed planar Path with straight edges.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Line</typings>
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2">
          <redefinitions>vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
        <redefinitions>isClosed</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="(1..size(edges))->forAll {in i; edges#(i).vertices->equals((vertices#((2*i)-1), vertices#(2*i))) and includes((edges#(i).vertices#(2) as Item).matingOccurrences, edges#(if i==size(edges) ? 1 else i+1).vertices#(1) ) }"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Triangle">
      <superclassifiers>Polygon</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Triangle is three-sided Polygon  with given length (base), width (perpendicular distance&#xD;&#xA;&#x9;&#x9; * from base to apex), and offset of this perpendicular at the base from the center of the base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>width</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" valuePart="(base, e2, e3)">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="base" MultiLow="1">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="length" valuePart="Triangle::length"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e2" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e3" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="6">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v12" MultiLow="2" isOrdered="true" valuePart="(vertices#(2), vertices#(3))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="apex" MultiLow="2" isOrdered="true" valuePart="(vertices#(4), vertices#(5))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v31" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(1))"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightTriangle">
      <superclassifiers>Triangle</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightTriangle is a Triangle with sides opposite the hypotenuse at right angles.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="length / 2">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e2</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Triangle::width">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="hypotenuse">
        <redefinitions>e3</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="( Triangle::length^2 + Triangle::width^2 )">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Quadrilateral">
      <superclassifiers>Polygon</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Quadrilateral is a four-sided Polygon.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="4" valuePart="(e1, e2, e3, e4)">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e1" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e2" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e3" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e4" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="8">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v12" MultiLow="2" isOrdered="true" valuePart="(vertices#(2), vertices#(3))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v23" MultiLow="2" isOrdered="true" valuePart="(vertices#(4), vertices#(5))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v34" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(7))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v41" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(1))"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Rectangle">
      <superclassifiers>Quadrilateral</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Rectangle is a Quadrilateral four right angles and given length and width.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>width</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e1</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Rectangle::length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e2</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Rectangle::width">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e3</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="e1.length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e4</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="e2.length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isAbstract="true" declaredName="Shell">
      <superclassifiers>StructuredSpaceObject::StructuredSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Shell is the most general structured Surface.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Disc">
      <superclassifiers>Shell</superclassifiers>
      <superclassifiers>PlanarSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Disc is a Shell bound by an Ellipse.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Ellipse</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Disc::semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Disc::semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>PlanarSurface</typings>
        <redefinitions>faces</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
          <redefinitions>edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" valuePart="shape">
        <typings>Ellipse</typings>
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Shell::edges::innerSpaceDimension</redefinitions>
          <redefinitions>Ellipse::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>Shell::edges::vertices</redefinitions>
          <redefinitions>Ellipse::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularDisc">
      <superclassifiers>Disc</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularDisc is a Disc bound by a Circle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Circle</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::shape::semiMajorAxis</redefinitions>
          <redefinitions>Circle::semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::shape::semiMinorAxis</redefinitions>
          <redefinitions>Circle::semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Circle</typings>
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConicSurface">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConicSurface is a Surface that has ConicSection cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="2">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Ellipsoid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An Ellipsoid is a ConicSurface with only elliptical cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis1" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis2" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis3" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Sphere">
      <superclassifiers>Ellipsoid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Sphere is an Ellipsoid with all the same semiaxes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis1</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis2</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis3</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Paraboloid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Paraboloid is a ConicSurface with only parabolic cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="focalDistance" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Hyperboloid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Hyperboloid is a ConicSurface with only hyperbolic cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="transverseAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="conjugateAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Toroid">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Toroid is a surface generated from revolving a planar closed curve about an line coplanar&#xD;&#xA;&#x9;&#x9; * with the curve. It is single sided with one hole.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="revolutionRadius" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="revolvedCurve" MultiLow="1">
        <typings>PlanarCurve</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
          <redefinitions>isClosed</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="1">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Torus">
      <superclassifiers>Toroid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Torus is a revolution of a Circle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="majorRadius">
        <redefinitions>revolutionRadius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="minorRadius" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Circle</typings>
        <redefinitions>revolvedCurve</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="minorRadius">
          <redefinitions>radius</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RectangularToroid">
      <superclassifiers>Toroid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RectangularToroid is a revolution of a Rectangle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="rectangleLength" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="rectangleWidth" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Rectangle</typings>
        <redefinitions>revolvedCurve</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="rectangleLength">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="rectangleWidth">
          <redefinitions>width</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>revolvedCurve::isClosed</redefinitions>
          <redefinitions>Rectangle::isClosed</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConeOrCylinder">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConeOrCylinder is Shell that a Cone or a Cylinder with a given elliptical base,&#xD;&#xA;&#x9;&#x9; * height, width (perpendicular distance from the base to the center of the top side or vertex),&#xD;&#xA;&#x9;&#x9; * and offsets of this perpendicular at the base from the center of the base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>height</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>yoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="3">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="base" MultiLow="1">
        <typings>Disc</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>Disc::edges::innerSpaceDimension</redefinitions>
            <redefinitions>ConeOrCylinder::faces::edges::innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="af" MultiLow="0" MultiHigh="1">
        <typings>Disc</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>Disc::edges::innerSpaceDimension</redefinitions>
            <redefinitions>ConeOrCylinder::faces::edges::innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="cf" MultiLow="1">
        <typings>Surface</typings>
        <subsetting>faces</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="4" valuePart="faces.edges">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="be" MultiLow="2">
        <subsetting>edges</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="ConeOrCylinder::semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="ConeOrCylinder::semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ae" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="be.semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="be.semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(ae) == (if isEmpty(af) ? 0 else 2) and size(edges) == (if isEmpty(af) ? 2 else 4)"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0" MultiHigh="1" valuePart="faces.vertices">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="isEmpty(af) == notEmpty(vertices)"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind face edges to specific edges */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="base.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Meeting edges */"/>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="be"/>
        <connectorPart MultiLow="1" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Cone">
      <superclassifiers>ConeOrCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Cone has one elliptical sides joined to a point by a curved side.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="apex">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind face vertices to specific vertices */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="apex"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="EccentricCone">
      <superclassifiers>Cone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EccentricCone is a Cone with least one positive offset.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="xoffset > 0 or yoffset > 0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularCone">
      <superclassifiers>Cone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularCone is a Cone with a circular base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>base::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightCircularCone">
      <superclassifiers>CircularCone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightCircularCone is a CircularCone with zero offsets.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>xoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>yoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Cylinder">
      <superclassifiers>ConeOrCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Cylinder has two elliptical sides joined by a curved side.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>af</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="ae"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="ae"/>
        <connectorPart MultiLow="1" refElement="ae"/>
        <elements xsi:type="sysMLOC:Documentation" body="/* Meeting edges */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="EccentricCylinder">
      <superclassifiers>Cylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * An EccentricCylinder is a Cylinder with least one positive offset.&#xD;&#xA;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="xoffset > 0 or yoffset > 0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularCylinder">
      <superclassifiers>Cylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularCylinder is a Cylinder with two circular sides.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>base::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>af</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>af::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightCircularCylinder">
      <superclassifiers>CircularCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightCircularCylinder is a CircularCylinder with zero offsets.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>xoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>yoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Polyhedron">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Polyhedron is a closed Shell with polygonal sides.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
        <redefinitions>isClosed</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="*">
        <typings>Polygon</typings>
        <redefinitions>faces</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Polygon::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Polygon::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" valuePart="faces.edges">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="if size(faces) > 2 ? 3 else 2">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CuboidOrTriangularPrism">
      <superclassifiers>Polyhedron</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CuboidOrTriangularPrism is a Polyhedron that is either a Cuboid or TriangularPrism.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="5" MultiHigh="6">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ff" MultiLow="1">
        <typings>Polygon</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" MultiHigh="4">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>faces::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="rf" MultiLow="1">
        <typings>Polygon</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" MultiHigh="4">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>faces::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="slf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="srf" MultiLow="0" MultiHigh="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(edges) == 18 or size(edges) == 24"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tfe" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tsle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tsre" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bfe" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bsle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bsre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ufle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ufre" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
