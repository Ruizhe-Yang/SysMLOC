<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: ImageMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="ImageMetadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides attributive data and metadata to allow a model element to be&#xD;&#xA;&#x9; * annotated with an image to be used in its graphical rendering or as a marker to&#xD;&#xA;&#x9; * adorn graphical or textual renderings.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Image">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Image provides the data necessary for the physical definition of &#xD;&#xA;&#x9;&#x9; * a graphical image.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="content" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Binary data for the image according to the given MIME type, &#xD;&#xA;&#x9;&#x9;&#x9; * encoded as given by the encoding.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="encoding" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Describes how characters in the content are to be decoded into &#xD;&#xA;&#x9;&#x9;&#x9; * binary data. At least &quot;base64&quot;, &quot;hex&quot;, &quot;identify&quot;, and &quot;JSONescape&quot;&#xD;&#xA;&#x9;&#x9;&#x9; * shall be supported.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="type" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The MIME type according to which the content should be interpreted.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="location" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A URI for the location of a resource containing the image content,&#xD;&#xA;&#x9;&#x9;&#x9; * as an alternative for embedding it in the content attribute.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Icon">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Icon metadata can be used to annotate a model element with an image to be used&#xD;&#xA;&#x9;&#x9; * to show render the element on a diagram and/or a small image to be used as an&#xD;&#xA;&#x9;&#x9; * adornment on a graphical or textual rendering. Alternatively, another metadata&#xD;&#xA;&#x9;&#x9; * definition can be annotated with an Icon to indicate that any model element &#xD;&#xA;&#x9;&#x9; * annotated by the containing metadata can be rendered according to the Icon.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fullImage" MultiLow="0" MultiHigh="1">
        <typings>Image</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A full-sized image that can be used to render the annotated element on a&#xD;&#xA;&#x9;&#x9;&#x9; * graphical view, potentially as an alternative to its standard rendering.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="smallImage" MultiLow="0" MultiHigh="1">
        <typings>Image</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A smaller image that can be used as an adornment on the graphical rendering&#xD;&#xA;&#x9;&#x9;&#x9; * of the annotated element or as a marker in a textual rendering.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: ImageMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: ModelingMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="ModelingMetadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains definitions of metadata generally useful for annotating models.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RiskMetadata::Risk"/>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="StatusKind">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * StatusKind enumerates the possible statuses of work on a model element.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="open">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is open.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="tbd">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is to be determined.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="tbr">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is to be resolved.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="tbc">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is to be confirmed.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="done">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is done.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="closed">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Status is closed.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="StatusInfo">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * StatusInfo is used to annotate a model element with status information.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="originator" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The originator of the annotated element.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="owner" MultiLow="0" MultiHigh="1">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The current owner of the annotated element.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="status">
        <typings>StatusKind</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The current status of work on the annotated element (required).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="risk" MultiLow="0" MultiHigh="1">
        <typings>Risk</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * An assessment of risk for the annotated element.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Rationale">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Rationale is used to explain a choice or other decision made related to the&#xD;&#xA;&#x9;&#x9; * annotated element.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="text">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A textual description of the rationale (required).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="explanation" MultiLow="0" MultiHigh="1">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A reference to a feature that provides a formal explanation of the rationale.&#xD;&#xA;&#x9;&#x9;&#x9; * (For example, a trade study whose result explains the choice of a certain alternative).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Issue">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Issue is used to record some issue concerning the annotated element.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="text">
        <typings>String</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A textual description of the issue.&#xD;&#xA;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="refinement" declaredName="Refinement">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Refinement is used to identify a dependency as modeling a refinement relationship.&#xD;&#xA;&#x9;&#x9; * In such a relationship, the source elements of the relationship provide a more precise and/or &#xD;&#xA;&#x9;&#x9; * accurate representation than the target elements.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>SysML::Dependency</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: ModelingMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: ParametersOfInterestMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="ParametersOfInterestMetadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains definitions of metadata to identify key parameters of interest,&#xD;&#xA;&#x9; * including measures of effectiveness (MOE) and other key measures of performance (MOP).&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="measuresOfEffectiveness" MultiLow="*" isNonunique="true">
      <elements xsi:type="sysMLOC:Documentation" body="/* Base feature for attributes that are measures of effectiveness. */"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="measuresOfPerformance" MultiLow="*" isNonunique="true">
      <elements xsi:type="sysMLOC:Documentation" body="/* Base feature for attributes that are measures of performance. */"/>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="moe" declaredName="MeasureOfEffectiveness">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; &#x9; * MeasureOfEffectiveness is semantic metadata for identifying an attribute as a&#xD;&#xA;&#x9; &#x9; * measure of effectiveness.&#xD;&#xA;&#x9; &#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>SysML::Usage</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="measuresOfEffectiveness meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="mop" declaredName="MeasureOfPerformance">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; &#x9; * MeasureOfPerformance is semantic metadata for identifying an attribute as a&#xD;&#xA;&#x9; &#x9; * measure of performance.&#xD;&#xA;&#x9; &#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>SysML::Usage</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="measuresOfPerformance meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: ParametersOfInterestMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: RiskMetadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="RiskMetadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines metadata for annotating model elements with assessments of risk.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Level">
      <superclassifiers>Real</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Level is a Real number in the interval 0.0 to 1.0, inclusive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="that >= 0.0 and that &lt;= 1.0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="LevelEnum">
      <superclassifiers>Level</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LevelEnum provides standard probability Levels for low, medium and high risks.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="low" valuePart="0.25"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="medium" valuePart="0.50"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="high" valuePart="0.75"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="RiskLevel">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * RiskLevel gives the probability of a risk occurring and, optionally, the impact&#xD;&#xA;&#x9;&#x9; * if the risk occurs.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="probability">
        <typings>Level</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The probability that a risk will occur.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="impact" MultiLow="0" MultiHigh="1">
        <typings>Level</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The impact of the risk if it occurs (with 0.0 being no impact and 1.0 being &#xD;&#xA;&#x9;&#x9;&#x9; * the most severe impact).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="RiskLevelEnum">
      <superclassifiers>RiskLevel</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * RiskLevelEnum enumerates standard RiskLevels for low, medium and high risks&#xD;&#xA;&#x9;&#x9; * (without including impact).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="low" valuePart="new RiskLevel(probability = LevelEnum::low)"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="medium" valuePart="new RiskLevel(probability = LevelEnum::medium)"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="high" valuePart="new RiskLevel(probability = LevelEnum::high)"/>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Risk">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Risk is used to annotate a model element with an assessment of the risk related to it&#xD;&#xA;&#x9;&#x9; * in some typical risk areas.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="totalRisk" MultiLow="0" MultiHigh="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The total risk associated with the annotated element.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="technicalRisk" MultiLow="0" MultiHigh="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The risk of unresolved technical issues regarding the annotated element.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="scheduleRisk" MultiLow="0" MultiHigh="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The risk that work on the annotated element will not be completed on schedule.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="costRisk" MultiLow="0" MultiHigh="1">
        <typings>RiskLevel</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The risk that work on the annotated element will exceed its planned cost.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: RiskMetadata.sysml =====&#xD;&#xA;"/>
</sysMLOC:RootNamespace>
