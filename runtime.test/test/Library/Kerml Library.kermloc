  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="SequenceFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines functions that operate on general sequences of values. (For functions that&#xD;&#xA;&#x9; * operate on Collection values, see CollectionFunctions.)&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'#'">
      <subsetting>BaseFunctions::'#'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="equals">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="size(x) == size(y) and (1..size(x))->forAll {in i; x#(i) == y#(i)}" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="same">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="size(x) == size(y) and (1..size(x))->forAll {in i; x#(i) === y#(i)}" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="size">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="if isEmpty(seq)? 0 else size(tail(seq)) + 1" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="seq == null" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="notEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="not isEmpty(seq)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="includes">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="seq2->forAll {in x; seq1->exists{in y; x == y}}" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="includesOnly">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="seq1->includes(seq2) and seq2->includes(seq1)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="excludes">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="seq2->forAll {in x; seq1->excludes(x)}" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="union">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="(seq1, seq2)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="intersection">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="seq1->select {in x; seq2->includes(x)}" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="including">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="union(seq, values)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="includingAt">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="(seq->subsequence(1, index - 1), values, seq->subsequence(index + 1))" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="excluding">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="seq->reject {in x; values->includes(x)}" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="excludingAt">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="startIndex" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="endIndex" MultiLow="1" isDefault="true" valuePart="startIndex" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="(seq->subsequence(1, startIndex - 1), seq->subsequence(endIndex + 1))" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="subsequence">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="startIndex" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="endIndex" MultiLow="1" isDefault="true" valuePart="size(seq)" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" valuePart="(startIndex..endIndex)->collect {in i; seq#(i)}" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="head">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="seq#(1)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="tail">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="subsequence(seq, 2)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="last">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="seq#(size(seq))" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="add">
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="newSeq" valuePart="seq->including(values)" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true">
        <typings>add</typings>
        <redefinitions>endShot</redefinitions>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="seq"/>
          <connectorPart refElement="newSeq"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="addAt">
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="newSeq" valuePart="seq->includingAt(values, index)" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true">
        <typings>addAt</typings>
        <redefinitions>endShot</redefinitions>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="seq"/>
          <connectorPart refElement="newSeq"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="remove">
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="newSeq" valuePart="seq->excluding(values)" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true">
        <typings>remove</typings>
        <redefinitions>endShot</redefinitions>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="seq"/>
          <connectorPart refElement="newSeq"/>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="removeAt">
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="startIndex" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="endIndex" MultiLow="1" isDefault="true" valuePart="startIndex" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="newSeq" valuePart="seq->excludingAt(startIndex, endIndex)" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true">
        <typings>removeAt</typings>
        <redefinitions>endShot</redefinitions>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart refElement="seq"/>
          <connectorPart refElement="newSeq"/>
        </elements>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: SequenceFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: StringFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="StringFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines functions on String values, including those corresponding to string concatenation &#xD;&#xA;&#x9; * and comparison operators in the KerML expression notation.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'+'">
      <subsetting>ScalarFunctions::'+'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="Length">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="Substring">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="lower" MultiLow="1" isSemicolon="true">
        <typings>Integer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="upper" MultiLow="1" isSemicolon="true">
        <typings>Integer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'&lt;'">
      <subsetting>ScalarFunctions::'&lt;'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'>'">
      <subsetting>ScalarFunctions::'>'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'&lt;='">
      <subsetting>ScalarFunctions::'&lt;='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'>='">
      <subsetting>ScalarFunctions::'>='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>DataFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToString">
      <subsetting>BaseFunctions::ToString</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="x" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: StringFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: TrigFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="TrigFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines basic trigonometric functions on real numbers.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues::Real"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="pi" isFeature="true" isSemicolon="true">
      <typings>Real</typings>
    </elements>
    <elements xsi:type="kerMLOC:Invariant" declaredName="piPrecision">
      <resultExpressionParameter resultExpression="RealFunctions::round(pi * 1E20) == 314159265358979323846.0"/>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="deg">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta_rad" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="theta_rad * 180 / pi" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="rad">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta_deg" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="theta_deg * pi / 180" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="UnitBoundedReal">
      <subsetting>Real</subsetting>
      <elements xsi:type="kerMLOC:Invariant" declaredName="unitBound">
        <resultExpressionParameter resultExpression="-1.0 &lt;= that &amp; that &lt;= 1.0"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="sin">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>UnitBoundedReal</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cos">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>UnitBoundedReal</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="tan">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" valuePart="sin(theta) / cos(theta)" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cot">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="theta" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" valuePart="cos(theta) / sin(theta)" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="arcsin">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>UnitBoundedReal</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="arccos">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>UnitBoundedReal</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="arctan">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: TrigFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: VectorFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="VectorFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines abstract functions on VectorValues corresponding to the algebraic operations&#xD;&#xA;&#x9; * provided by a vector space with inner product. It also includes concrete implementations of these&#xD;&#xA;&#x9; * functions specifically for CartesianVectorValues.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::NumericalValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="NumericalFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="RealFunctions::sqrt"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="TrigFunctions::arccos"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="VectorValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Comment" body="/* Generic arithmetic functions for all VectorValues. */"/>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="isZeroVector">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Return whether a VectorValue is a zero vector.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'+'">
      <subsetting>DataFunctions::'+'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * With two arguments, returns the sum of two VectorValues. With one argument, returns that VectorValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="u" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="zeroAddition">
        <resultExpressionParameter resultExpression="w == null or isZeroVector(w) implies u == w"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="commutivity">
        <resultExpressionParameter resultExpression="w != null implies u == w + v"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'-'">
      <subsetting>DataFunctions::'-'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * With two arguments, returns the difference of two VectorValues. With one arguments, returns the inverse&#xD;&#xA;&#x9;&#x9; * of the given VectorValue, that is, the VectorValue that, when added to the original VectorValue, results in&#xD;&#xA;&#x9;&#x9; * the zeroVector.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="u" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="negation">
        <resultExpressionParameter resultExpression="w == null implies isZeroVector(v + u)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="difference">
        <resultExpressionParameter resultExpression="w != null implies v + u == w"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="sum0">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Return the sum of a collection of VectorValues. If the collection is empty, return a given zero vector.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="coll" MultiLow="*" isNonunique="true" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="zero" MultiLow="1" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="precondition">
        <resultExpressionParameter resultExpression="isZeroVector(zero)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="s" MultiLow="1" valuePart="coll->reduce '+' ?? zero" isSemicolon="true">
        <typings>VectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Comment" body="/* Functions specific to NumericalVectorValues. */"/>
    <elements xsi:type="kerMLOC:Function" declaredName="VectorOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Construct a NumericalVectorValue whose elements are a non-empty list of component NumericalValues.&#xD;&#xA;&#x9;&#x9; * The dimension of the NumericalVectorValue is equal to the number of components.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="components" MultiLow="1" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>NumericalVectorValue</typings>
        <elements xsi:type="kerMLOC:Feature" valuePart="size(components)" isSemicolon="true">
          <redefinitions>dimension</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" valuePart="components" isSemicolon="true">
          <redefinitions>elements</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="scalarVectorMult">
      <subsetting>DataFunctions::'*'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Scalar product of a NumericalValue and a NumericalVectorValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="w" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="scaling">
        <resultExpressionParameter resultExpression="norm(w) == x * norm(v)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="zeroLength">
        <resultExpressionParameter resultExpression="isZeroVector(w) implies isZero(norm(w))"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:AliasElement" memberName="'*'" memberElement="scalarVectorMult"/>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="vectorScalarMult">
      <subsetting>DataFunctions::'*'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Scalar product of a NumericalVectorValue and a NumericalValue, which has the same value as the scalar product of the&#xD;&#xA;&#x9;&#x9; * NumericalValue and the NumericalVectorValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="w" MultiLow="1" isDefault="true" valuePart="scalarVectorMult(x, v)" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="vectorScalarDiv">
      <subsetting>DataFunctions::'/'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Scalar quotient of a NumericalVectorValue and a NumericalValue, defined as the scalar product of the inverse of the &#xD;&#xA;&#x9;&#x9; * NumericalValue and the NumericalVectorValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="w" MultiLow="1" valuePart="scalarVectorMult(1.0 / x, v)" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="inner">
      <subsetting>DataFunctions::'*'</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Inner product of two NumericalVectorValues.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="commmutivity">
        <resultExpressionParameter resultExpression="x == inner(w, v)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="zeroInner">
        <resultExpressionParameter resultExpression="isZeroVector(v) or isZeroVector(w) implies isZero(x)"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="norm">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The norm (magnitude) of a NumericalVectorValue, as a NumericalValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="l" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="squareNorm">
        <resultExpressionParameter resultExpression="l * l == inner(v,v)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="lengthZero">
        <resultExpressionParameter resultExpression="isZero(l) == isZeroVector(v)"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="angle">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * The angle between two NumericalVectorValues, as a NumericalValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="1" isSemicolon="true">
        <typings>NumericalVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="theta" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="commutivity">
        <resultExpressionParameter resultExpression="theta == angle(w, v)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="lengthInsensitive">
        <resultExpressionParameter resultExpression="theta == angle(w / norm(w), v / norm(v))"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Comment" body="/* Specialized functions with concrete definitions for CartesianVectorValues. */"/>
    <elements xsi:type="kerMLOC:Function" declaredName="CartesianVectorOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Construct a CartesianVectorValue whose elements are a non-empty list of Real components.&#xD;&#xA;&#x9;&#x9; * The dimension of the NumericalVectorValue is equal to the number of components.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="components" MultiLow="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>CartesianVectorValue</typings>
        <elements xsi:type="kerMLOC:Feature" valuePart="size(components)" isSemicolon="true">
          <redefinitions>dimension</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" valuePart="components" isSemicolon="true">
          <redefinitions>elements</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="CartesianThreeVectorOf">
      <subsetting>CartesianVectorOf</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="components" MultiLow="3" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1">
        <typings>CartesianThreeVectorValue</typings>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>CartesianVectorOf::result::dimension</redefinitions>
          <redefinitions>CartesianThreeVectorValue::dimension</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="cartesianZeroVector" MultiLow="3" valuePart="( CartesianVectorOf(0.0), CartesianVectorOf((0.0, 0.0)), CartesianThreeVectorOf((0.0, 0.0, 0.0)) )" isFeature="true">
      <typings>CartesianVectorValue</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Cartesian zero vectors of 1, 2 and 3 dimensions.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="cartesian3DZeroVector" MultiLow="1" valuePart="cartesianZeroVector#(3)" isFeature="true" isSemicolon="true">
      <typings>CartesianThreeVectorValue</typings>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isCartesianZeroVector">
      <subsetting>isZeroVector</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CartesianVectorValue is a zero vector if all its elements are zero.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="v.elements->forAll{in x; x == 0.0}" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'cartesian+'">
      <subsetting>'+'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="precondition">
        <resultExpressionParameter resultExpression="w != null implies v.dimension == w.dimension"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="u" MultiLow="1" valuePart="if w == null? v else CartesianVectorOf( (1..w.dimension)->collect{in i : Positive; v#(i) + w#(i)} )" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'cartesian-'">
      <subsetting>'-'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="precondition">
        <resultExpressionParameter resultExpression="w != null implies v.dimension == w.dimension"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="u" MultiLow="1" valuePart="CartesianVectorOf( if w == null? CartesianVectorOf(v.elements->collect{in x : Real; -x}) else CartesianVectorOf( (1..v.dimension)->collect{in i : Positive; v#(i) - w#(i)} ) )" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cartesianScalarVectorMult">
      <subsetting>scalarVectorMult</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="w" MultiLow="1" valuePart="CartesianVectorOf( v.elements->collect{in y : Real; x * y} )" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cartesianVectorScalarMult">
      <subsetting>vectorScalarMult</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="w" MultiLow="1" valuePart="cartesianScalarVectorMult(x, v)" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cartesianInner">
      <subsetting>inner</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="precondition">
        <resultExpressionParameter resultExpression="v.dimension == w.dimension"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="x" MultiLow="1" valuePart="(1..v.dimension)->collect{in i : Positive; v#(i) * w#(i)}->reduce RealFunctions::'+'" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cartesianNorm">
      <subsetting>norm</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="l" MultiLow="1" valuePart="sqrt(cartesianInner(v, v))" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="cartesianAngle">
      <subsetting>angle</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="v" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="w" MultiLow="1" isSemicolon="true">
        <typings>CartesianVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="precondition">
        <resultExpressionParameter resultExpression="v.dimension == w.dimension"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="theta" MultiLow="1" valuePart="arccos(cartesianInner(v, w) / (norm(v) * norm(w)))" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="sum">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="coll" MultiLow="*" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="sum0(coll, cartesian3DZeroVector)" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: VectorFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Kernel Function Library.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Kernel Semantic Library.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Base.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Base" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the classifiers and features that provide the bases for the typing&#xD;&#xA;&#x9; * of all elements in the language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:Classifier" isAbstract="true" declaredName="Anything">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * Anything is the top level generalized type in the language. &#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" MultiLow="1" isFeature="true">
        <typings>Anything</typings>
        <subsetting>things</subsetting>
        <chainingFeature>things.that</chainingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The source of a SelfLink of this thing to itself. self is thus a feature that&#xD;&#xA;&#x9;&#x9;&#x9; * relates everything to itself. It is also the value of the nested &quot;that&quot; feature&#xD;&#xA;&#x9;&#x9;&#x9; * of all other things featured by this thing.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="DataValue">
      <subsetting>Anything</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Value is the most general classifier of entities that are values that do not change&#xD;&#xA;&#x9;&#x9; * over time.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true" isSemicolon="true">
        <typings>DataValue</typings>
        <redefinitions>Anything::self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="things" MultiLow="1" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>Anything</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * things is the top-level feature in the language.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="that" MultiLow="1" isFeature="true">
        <typings>Anything</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * For each value of things, the &quot;featuring instance&quot; of that value. &#xD;&#xA;&#x9;&#x9;&#x9; * This is enforced by declaring Anything::self to be the chaining of things.that, &#xD;&#xA;&#x9;&#x9;&#x9; * restricting it the single value of self.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="dataValues" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>DataValue</typings>
      <subsetting>things</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * dataValues is a specialization of things restricted to type DataValue.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="naturals" MultiLow="0" MultiHigh="*" isFeature="true">
      <typings>ScalarValues::Natural</typings>
      <subsetting>dataValues</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * naturals is a specialization of dataValues restricted to type Natural. &#xD;&#xA;&#x9;&#x9; * It is the root feature of all multiplicities, which map from a feature to&#xD;&#xA;&#x9;&#x9; * the set of Natural numbers representing allowable cardinalities of the feature.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Multiplicity" declaredName="exactlyOne" MultiLow="1" MultiHigh="1">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * exactlyOne is a multiplicity range requiring a cardinality of exactly one.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Multiplicity" declaredName="zeroOrOne" MultiLow="0" MultiHigh="1">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * zeroOrOne is a multiplicity range requiring a cardinality of zero or one.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Multiplicity" declaredName="oneToMany" MultiLow="1" MultiHigh="*">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * oneToMany is a multiplicity range allowing any cardinality of one or more.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Multiplicity" declaredName="zeroToMany" MultiLow="0" MultiHigh="*">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * zeroToMany is a multiplicity range allowing any cardinality of zero or more&#xD;&#xA;&#x9;&#x9; * (that is, no restriction).&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Base.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Clocks.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Clocks" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package models Clocks that provide an advancing numerical reference &#xD;&#xA;&#x9; * usable for quantifying the time of an Occurrence.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::NumericalValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Life"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="kerMLOC:Structure" visibility="private" declaredName="UniversalClockLife" MultiLow="1">
      <subsetting>Clock</subsetting>
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * UniversalClockLife is the classifier of the singleton Life of the universalClock.&#xD;&#xA;&#x9;     */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="universalClock" MultiLow="1" isFeature="true">
      <typings>UniversalClockLife</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * universalClock is a single Clock that can be used as a default universal&#xD;&#xA;&#x9;&#x9; * time reference.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="Clock">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Clock provides a numerical currentTime that advances montonically&#xD;&#xA;&#x9;&#x9; * over its lifetime. Clock is an abstract base Structure that can be&#xD;&#xA;&#x9;&#x9; * specialized for different kinds of time quantification (e.g., discrete&#xD;&#xA;&#x9;&#x9; * time, continuous time, time with units, etc.).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="thisClock" isSemicolon="true">
        <typings>Clock</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="currentTime" MultiLow="1" isFeature="true">
        <typings>NumericalValue</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A scalar time reference that advances over the lifetime of the Clock. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="timeFlowConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The currentTime of a snapshot of a Clock is equal to&#xD;&#xA;&#x9;&#x9;&#x9; * the TimeOf the snapshot relative to that Clock.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="snapshots->forAll{in s : Clock; TimeOf(s, thisClock) == s.currentTime }"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="TimeOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * TimeOf returns a numerical timeInstant for a given Occurrence relative to&#xD;&#xA;&#x9;&#x9; * a given Clock. The timeInstant is the time of the start of the Occurrence,&#xD;&#xA;&#x9;&#x9; * which is considered to be synchronized with the snapshot of the Clock &#xD;&#xA;&#x9;&#x9; * with a currentTime equal to the returned timeInstant.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="o" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="timeInstant" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="startTimeConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The TimeOf an Occurrence is equal to the time of its start snapshot.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="timeInstant == TimeOf(o.startShot, clock)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="timeOrderingConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * If one Occurrence happens before another, then the TimeOf the end&#xD;&#xA;&#x9;&#x9;&#x9; * snapshot of the first Occurrence is no greater than the TimeOf the &#xD;&#xA;&#x9;&#x9;&#x9; * second Occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="o.predecessors->forAll{in p : Occurrence; TimeOf(p.endShot, clock) &lt;= timeInstant }"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="timeContinuityConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * If one Occurrence happens immediately before another, then the TimeOf &#xD;&#xA;&#x9;&#x9;&#x9; * the end snapshot of the first Occurrence equals the TimeOf the second&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="o.immediatePredecessors->forAll{in p : Occurrence; TimeOf(p.endShot, clock) == timeInstant }"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="DurationOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * DurationOf returns the duration of a given Occurrence relative to a&#xD;&#xA;&#x9;&#x9; * given Clock, which is equal to the TimeOf the end snapshot of the&#xD;&#xA;&#x9;&#x9; * Occurrence minus the TimeOf its start snapshot.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="o" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="duration" valuePart="TimeOf(o.endShot, clock) - TimeOf(o.startShot, clock)" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="BasicClock">
      <subsetting>Clock</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A BasicClock is a Clock whose currentTime is a Real number.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" isFeature="true" isSemicolon="true">
        <typings>Real</typings>
        <redefinitions>currentTime</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="BasicTimeOf">
      <subsetting>TimeOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * BasicTimeOf returns the TimeOf an Occurrence as a Real number relative&#xD;&#xA;&#x9;&#x9; * to a BasicClock.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="o" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isSemicolon="true">
        <typings>BasicClock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="BasicDurationOf">
      <subsetting>DurationOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * BasicDurationOf returns the DurationOf an Occurrence as a Real number relative&#xD;&#xA;&#x9;&#x9; * to a BasicClock.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="o" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isSemicolon="true">
        <typings>BasicClock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Clocks.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: ControlPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="ControlPerformances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines Behaviors to be used to type Steps that control the sequencing of performance&#xD;&#xA;&#x9; * of other Steps. &#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::BooleanEvaluation"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="DecisionPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A DecisionPerformance is a Performance that represents the selection of one of the Successions&#xD;&#xA;&#x9;&#x9; * that have the DecisionPerforance behavior as their source. All such Successions must subset the &#xD;&#xA;&#x9;&#x9; * outgoingHBLink feature of the source DecisionPerformance. For each instance of DecisionPerformance, &#xD;&#xA;&#x9;&#x9; * the outgoingHBLink is an instance of exactly one of the Successions, ordering the DecisionPerformance&#xD;&#xA;&#x9;&#x9; * as happening before an instance of the target of that Succcession.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="outgoingHBLink" MultiLow="1" isFeature="true">
        <typings>HappensBefore</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Specializations subset this by all&#xD;&#xA;&#x9;&#x9;&#x9; * successions going out of a decision step.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <subsetting>that</subsetting>
          <redefinitions>earlierOccurrence</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="MergePerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A MergePerformance is a Performance that represents the merging of all Successions that&#xD;&#xA;&#x9;&#x9; * target the MergePerforance behavior. All such Successions must subset the incomingHBLink&#xD;&#xA;&#x9;&#x9; * feature of the target MergePerformance. For each instance of MergePerformance, the&#xD;&#xA;&#x9;&#x9; * incomingHBLink is an instance of exactly one of the Successions, ordering the&#xD;&#xA;&#x9;&#x9; * MergePerformance as happening after an instance of the source of that Succession.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="incomingHBLink" MultiLow="1" isFeature="true">
        <typings>HappensBefore</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Specializations subset this by all&#xD;&#xA;&#x9;&#x9;&#x9; * successions coming into a merge step.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <subsetting>that</subsetting>
          <redefinitions>laterOccurrence</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="IfPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfPerformance is a Performance that determines whether the ifTest evaluation result is true &#xD;&#xA;&#x9;&#x9; * (by whether ifTrue has a value).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="ifTest" MultiLow="1" isSemicolon="true">
        <typings>BooleanEvaluation</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="IfThenPerformance">
      <subsetting>IfPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfThenPerformance is an IfPerformance where the thenClause occurs after and only after the &#xD;&#xA;&#x9;&#x9; * ifTest evaluation result is true.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isSemicolon="true">
        <redefinitions>ifTest</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="thenClause" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart MultiLow="1" refElement="ifTest"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="thenClause"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="ifTest() == thenClause->notEmpty()"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="IfElsePerformance">
      <subsetting>IfPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfElsePerformance is an IfPerformance where the elseClause occurs after and only &#xD;&#xA;&#x9;&#x9; * after the ifTest evaluation result is not true.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isSemicolon="true">
        <redefinitions>ifTest</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="elseClause" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart MultiLow="1" refElement="ifTest"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="elseClause"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="not ifTest() == elseClause->notEmpty()"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="IfThenElsePerformance">
      <subsetting>IfThenPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfThenElsePerformance is an IfThenPerformance with an additional elseClause that&#xD;&#xA;&#x9;&#x9; * occurs after and only after the ifTest evaluation is false.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isSemicolon="true">
        <redefinitions>ifTest</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" isSemicolon="true">
        <redefinitions>thenClause</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="elseClause" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart MultiLow="1" refElement="ifTest"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="elseClause"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="not ifTest() == elseClause->notEmpty()"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="LoopPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A LoopPerformance is a Performance where the body occurs repeatedly in sequence (iterates) &#xD;&#xA;&#x9;&#x9; * as long as the whileTest evaluation result is true before each iteration (and after the &#xD;&#xA;&#x9;&#x9; * previous one, except the first time) and the untilTest evaluation result is not true after &#xD;&#xA;&#x9;&#x9; * each iteration and before the next one (except the last one).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="whileTest" MultiLow="1" MultiHigh="*" isSemicolon="true">
        <typings>BooleanEvaluation</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="body" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="untilTest" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>BooleanEvaluation</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="whileDecision" MultiLow="1" MultiHigh="*">
        <typings>IfThenPerformance</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="untilDecision" MultiLow="0" MultiHigh="*">
        <typings>IfElsePerformance</typings>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="1" refElement="whileDecision.ifTest"/>
        <connectorPart MultiLow="1" refElement="whileTest"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="1" refElement="whileDecision.thenClause"/>
        <connectorPart MultiLow="1" refElement="body"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart refElement="body"/>
        <connectorPart refElement="untilDecision"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="1" refElement="untilDecision.ifTest"/>
        <connectorPart MultiLow="1" refElement="untilTest"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" declaredName="loopBack" isOf="true">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="untilDecision.elseClause"/>
        <connectorPart MultiLow="1" refElement="whileDecision"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="loopBack->size() == whileDecision->size() - 1"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: ControlPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: FeatureReferencingPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="FeatureReferencingPerformances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines Behaviors used to read, write and monitor values of a referenced Feature of an &#xD;&#xA;&#x9; * Occurrence.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensWhile"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensJustBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Evaluation"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::equals"/>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="FeatureReferencingPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A FeatureReferencingPerformance is the base Performance for specialized behaviors related &#xD;&#xA;&#x9;&#x9; * to values of a referenced Feature of a given Occurrence, as identified in specializations &#xD;&#xA;&#x9;&#x9; * of this Behavior.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isAbstract="true" declaredName="onOccurrence" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrence with values for the referenced feature in specializations of this behavior.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="values" MultiLow="*" isNonunique="true" isFeature="true">
        <typings>Anything</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Values of the referenced feature, as specified in specializations of this behavior.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="FeatureAccessPerformance">
      <subsetting>FeatureReferencingPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A FeatureAccessPerformance is a FeatureReferencingPerformance where the result values&#xD;&#xA;&#x9;&#x9; * are all the values of a feature of onOccurrence at the time the Performance ends. The&#xD;&#xA;&#x9;&#x9; * feature is specified by restricting accessedFeature in specializations or usages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isAbstract="true" declaredName="onOccurrence" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="startingAt" MultiLow="1" isFeature="true">
          <typings>Occurrence</typings>
          <subsetting>timeSlices</subsetting>
          <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="accessedFeature" MultiLow="*" isNonunique="true" isFeature="true" isSemicolon="true">
            <typings>Anything</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensWhile</typings>
        <connectorPart refElement="onOccurrence.startingAt.startShot"/>
        <connectorPart refElement="endShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Requires some time slice of onOccurrence to start when this performance&#xD;&#xA;&#x9;&#x9;&#x9; * ends (this connector), with particular feature values (following connector).&#xD;&#xA;&#x9;&#x9;&#x9; * The feature is specified by restricting the onOccurrence::accessedFeature &#xD;&#xA;&#x9;&#x9;&#x9; * on usages of this behavior.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>SelfSameLifeLink</typings>
        <connectorPart refElement="onOccurrence.startingAt.accessedFeature"/>
        <connectorPart refElement="values"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="FeatureReadEvaluation">
      <subsetting>FeatureAccessPerformance</subsetting>
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A FeatureReadEvaluation is a FeatureAccessPerformance that is a function providing as&#xD;&#xA;&#x9;&#x9; * its result the values of a feature on an occurrence at the time its evaluation ends.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="onOccurrence" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="resultValues" MultiLow="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>result</redefinitions>
        <redefinitions>values</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="FeatureWritePerformance">
      <subsetting>FeatureAccessPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A FeatureWritePerformance is a FeatureAccessPerformance that assigns the values of a &#xD;&#xA;&#x9;&#x9; * feature on an occurrence to the given replacementValues at time its performance ends.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="onOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>onOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="replacementValues" MultiLow="*" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>values</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="FeatureMonitorPerformance">
      <subsetting>FeatureReferencingPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A FeatureMonitorPerformance is a FeatureReferencingPerformance that waits for values&#xD;&#xA;&#x9;&#x9; * of monitoredFeature to change on onOccurrence from what they were when the performance &#xD;&#xA;&#x9;&#x9; * started. The values before and after the change are given by beforeValues and afterValues.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" isFeature="true">
        <redefinitions>onOccurrence</redefinitions>
        <elements xsi:type="kerMLOC:Feature" declaredName="monitoredOccurrence" MultiLow="1" isFeature="true">
          <typings>Occurrence</typings>
          <subsetting>timeSlices</subsetting>
          <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="monitoredFeature" MultiLow="*" isNonunique="true" isFeature="true" isSemicolon="true">
            <typings>Anything</typings>
          </elements>
          <elements xsi:type="kerMLOC:Feature" declaredName="beforeTimeSlice" MultiLow="1" isFeature="true">
            <typings>Occurrence</typings>
            <subsetting>timeSlices</subsetting>
            <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
              <redefinitions>monitoredFeature</redefinitions>
            </elements>
          </elements>
          <elements xsi:type="kerMLOC:Feature" declaredName="afterSnapshot" MultiLow="1" isFeature="true">
            <typings>Occurrence</typings>
            <subsetting>snapshots</subsetting>
            <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
              <redefinitions>monitoredFeature</redefinitions>
            </elements>
          </elements>
          <elements xsi:type="kerMLOC:Connector" isFrom="true">
            <typings>HappensJustBefore</typings>
            <connectorPart refElement="beforeTimeSlice"/>
            <connectorPart refElement="afterSnapshot"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="out" declaredName="afterValues" isFeature="true" isSemicolon="true">
        <redefinitions>values</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="out" declaredName="beforeValues" MultiLow="*" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="not beforeValues->equals(afterValues)"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensWhile</typings>
        <connectorPart MultiLow="1" refElement="onOccurrence.monitoredOccurrence.beforeTimeSlice.startShot"/>
        <connectorPart MultiLow="1" refElement="startShot"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>SelfSameLifeLink</typings>
        <connectorPart MultiLow="1" refElement="onOccurrence.monitoredOccurrence.beforeTimeSlice.monitoredFeature"/>
        <connectorPart MultiLow="1" refElement="beforeValues"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>SelfSameLifeLink</typings>
        <connectorPart MultiLow="1" refElement="onOccurrence.monitoredOccurrence.afterSnapshot.monitoredFeature"/>
        <connectorPart MultiLow="1" refElement="afterValues"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="protected" declaredName="endWhen" isFrom="true">
        <typings>HappensBefore</typings>
        <connectorPart MultiLow="1" refElement="onOccurrence.monitoredOccurrence.afterSnapshot"/>
        <connectorPart MultiLow="1" refElement="endShot"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="EvaluationResultMonitorPerformance">
      <subsetting>FeatureMonitorPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EvaluationResultMonitorPerformance is a FeatureMonitorPerformance that waits for changes &#xD;&#xA;&#x9;&#x9; * in the result of an Evaluation identified by onOccurrence. The Predicate being evaluated must &#xD;&#xA;&#x9;&#x9; * be able to produce multiple results over time, for example by only using BindingConnectors &#xD;&#xA;&#x9;&#x9; * between Steps, rather than Successions or Flows, including in its Step behaviors.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="onOccurrence" isFeature="true">
        <typings>Evaluation</typings>
        <redefinitions>onOccurrence</redefinitions>
        <elements xsi:type="kerMLOC:ExpressionClass" visibility="protected" declaredName="monitoredOccurrence" MultiLow="1">
          <typings>Evaluation</typings>
          <redefinitions>monitoredOccurrence</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="*" isSemicolon="true">
            <typings>Anything</typings>
            <redefinitions>result</redefinitions>
            <redefinitions>monitoredFeature</redefinitions>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="BooleanEvaluationResultMonitorPerformance">
      <subsetting>EvaluationResultMonitorPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A BooleanEvaluationResultMonitorPerformance is a EvaluationResultMonitorPerformance&#xD;&#xA;&#x9;&#x9; * that waits for changes in the result of a BooleanEvaluation identified by onOccurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:BooleanExpression" direction="in">
        <redefinitions>onOccurrence</redefinitions>
        <elements xsi:type="kerMLOC:BooleanExpression" visibility="protected" MultiLow="1">
          <redefinitions>monitoredOccurrence</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="1" isSemicolon="true">
            <typings>Boolean</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="out" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
        <redefinitions>afterValues</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="out" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
        <redefinitions>beforeValues</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="BooleanEvaluationResultToMonitorPerformance">
      <subsetting>FeatureReferencingPerformance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A BooleanEvaluationResultToMonitorPerformance is a FeatureReferencingPerformance that waits &#xD;&#xA;&#x9;&#x9; * for the result of a BooleanEvaluation (identified by onOccurrence) to change to either true &#xD;&#xA;&#x9;&#x9; * or false, as indicated by isToTrue (defaulting to true). If the result is already true (or false), &#xD;&#xA;&#x9;&#x9; * the performance waits for the result to become false (or true) before waiting again for it to &#xD;&#xA;&#x9;&#x9; * change back.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:BooleanExpression" direction="in">
        <redefinitions>onOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isToTrue" MultiLow="1" isDefault="true" valuePart="true" isFeature="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="out" declaredName="afterValues" MultiLow="1" valuePart="isToTrue" isSemicolon="true">
        <typings>Boolean</typings>
        <redefinitions>values</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="monitor1" MultiLow="1" isFeature="true">
        <typings>BooleanEvaluationResultMonitorPerformance</typings>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <typings>HappensJustBefore</typings>
          <redefinitions>endWhen</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="earlierOccurrence" isFeature="true" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="laterOccurrence" isFeature="true" isSemicolon="true"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="monitor2" MultiLow="1" isFeature="true">
        <typings>BooleanEvaluationResultMonitorPerformance</typings>
        <elements xsi:type="kerMLOC:Feature" isFeature="true">
          <typings>HappensJustBefore</typings>
          <redefinitions>endWhen</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="earlierOccurrence" isFeature="true" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="laterOccurrence" isFeature="true" isSemicolon="true"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensJustBefore</typings>
        <connectorPart MultiLow="1" refElement="monitor1"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="monitor2"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isEmpty(monitor2) == (monitor1.afterValues == isToTrue)"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" visibility="private">
        <connectorPart MultiLow="1" refElement="monitor1.onOccurrence"/>
        <connectorPart MultiLow="1" refElement="onOccurrence"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" visibility="private">
        <connectorPart MultiLow="1" refElement="monitor2.onOccurrence"/>
        <connectorPart MultiLow="1" refElement="onOccurrence"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: FeatureReferencingPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: KerML.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="KerML" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains a reflective KerML model of the KerML abstract syntax.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="Kernel" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Package" declaredName="Root">
      <elements xsi:type="kerMLOC:Metaclass" declaredName="AnnotatingElement">
        <subsetting>Element</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="annotatedElement" MultiLow="1" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isComposite="true" isVariable="true" declaredName="ownedAnnotatingRelationship" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Annotation</typings>
          <subsetting>annotation</subsetting>
          <subsetting>ownedRelationship</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owningAnnotatingRelationship" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Annotation</typings>
          <subsetting>owningRelationship</subsetting>
          <subsetting>annotation</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="annotation" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Annotation</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Annotation">
        <subsetting>Relationship</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="annotatedElement" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <redefinitions>target</redefinitions>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="annotatingElement" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>AnnotatingElement</typings>
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owningAnnotatedElement" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <subsetting>annotatedElement</subsetting>
          <subsetting>owningRelatedElement</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owningAnnotatingElement" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>AnnotatingElement</typings>
          <subsetting>annotatingElement</subsetting>
          <subsetting>owningRelatedElement</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isComposite="true" isVariable="true" declaredName="ownedAnnotatingElement" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>AnnotatingElement</typings>
          <subsetting>annotatingElement</subsetting>
          <subsetting>ownedRelatedElement</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Comment">
        <subsetting>AnnotatingElement</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="'locale'" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="body" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Dependency">
        <subsetting>Relationship</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="client" MultiLow="1" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="supplier" MultiLow="1" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Documentation">
        <subsetting>Comment</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="documentedElement" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <subsetting>owner</subsetting>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" isAbstract="true" declaredName="Element">
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="elementId" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="aliasIds" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="declaredShortName" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="declaredName" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="isImpliedIncluded" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Boolean</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="shortName" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="name" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="qualifiedName" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="isLibraryElement" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Boolean</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="owningRelationship" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Relationship</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isComposite="true" isVariable="true" declaredName="ownedRelationship" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Relationship</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owningMembership" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>OwningMembership</typings>
          <subsetting>owningRelationship</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owningNamespace" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Namespace</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="owner" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="ownedElement" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="documentation" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Documentation</typings>
          <subsetting>ownedElement</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isComposite="true" isVariable="true" declaredName="ownedAnnotation" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Annotation</typings>
          <subsetting>ownedRelationship</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="textualRepresentation" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>TextualRepresentation</typings>
          <subsetting>ownedElement</subsetting>
        </elements>
      </elements>
