          <subsetting>'step'</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="result" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Feature</typings>
          <subsetting>output</subsetting>
          <subsetting>parameter</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="IndexExpression">
        <subsetting>OperatorExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="operator" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
          <redefinitions>operator</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" isAbstract="true" declaredName="InstantiationExpression">
        <subsetting>Expression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="argument" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="instantiatedType" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Type</typings>
          <subsetting>'member'</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Interaction">
        <subsetting>Association</subsetting>
        <subsetting>Behavior</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Invariant">
        <subsetting>BooleanExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="isNegated" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Boolean</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="InvocationExpression">
        <subsetting>InstantiationExpression</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LibraryPackage">
        <subsetting>Package</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="isStandard" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Boolean</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralBoolean">
        <subsetting>LiteralExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="value" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Boolean</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralExpression">
        <subsetting>Expression</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralInfinity">
        <subsetting>LiteralExpression</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralInteger">
        <subsetting>LiteralExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="value" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Integer</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralRational">
        <subsetting>LiteralExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="value" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Rational</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="LiteralString">
        <subsetting>LiteralExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="value" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Metaclass">
        <subsetting>Structure</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="MetadataAccessExpression">
        <subsetting>Expression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="referencedElement" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Element</typings>
          <subsetting>'member'</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="MetadataFeature">
        <subsetting>AnnotatingElement</subsetting>
        <subsetting>Feature</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="'metaclass'" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Metaclass</typings>
          <subsetting>'type'</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="MultiplicityRange">
        <subsetting>Multiplicity</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="lowerBound" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
          <subsetting>bound</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="upperBound" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
          <subsetting>bound</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="bound" MultiLow="1" MultiHigh="2" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
          <subsetting>ownedMember</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="NullExpression">
        <subsetting>Expression</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="OperatorExpression">
        <subsetting>InvocationExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="operator" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Package">
        <subsetting>Namespace</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="filterCondition" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
          <subsetting>ownedMember</subsetting>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="ParameterMembership">
        <subsetting>FeatureMembership</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isComposite="true" isVariable="true" declaredName="ownedMemberParameter" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Feature</typings>
          <redefinitions>ownedMemberFeature</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="PayloadFeature">
        <subsetting>Feature</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Predicate">
        <subsetting>Function</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="ResultExpressionMembership">
        <subsetting>FeatureMembership</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isComposite="true" isVariable="true" declaredName="ownedResultExpression" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Expression</typings>
          <redefinitions>ownedMemberFeature</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="ReturnParameterMembership">
        <subsetting>ParameterMembership</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="SelectExpression">
        <subsetting>OperatorExpression</subsetting>
        <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="operator" MultiLow="1" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>String</typings>
          <redefinitions>operator</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Step">
        <subsetting>Feature</subsetting>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="'behavior'" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Behavior</typings>
          <subsetting>'type'</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isVariable="true" declaredName="parameter" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
          <typings>Feature</typings>
          <redefinitions>directedFeature</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Structure">
        <subsetting>Class</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="Succession">
        <subsetting>Connector</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Metaclass" declaredName="SuccessionFlow">
        <subsetting>Succession</subsetting>
        <subsetting>Flow</subsetting>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: KerML.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Links.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Links" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines associations and features that are related to the typing of links.&#xD;&#xA;     */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:Association" isAbstract="true" declaredName="Link">
      <subsetting>Anything</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * Link is the most general association between two or more things.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="participant" MultiLow="2" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="BinaryLink" isSufficient="true">
      <subsetting>Link</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * BinaryLink is the most general binary association between exactly two things, &#xD;&#xA;         * nominally directed from source to target.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="participant" MultiLow="2" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>Link::participant</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>participant</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>participant</subsetting>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SelfLink" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * SelfLink is a binary association in which the things at the two ends are asserted&#xD;&#xA;         * to be the same.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <subsetting>sameThing</subsetting>
        <crosses>sameThing.self</crosses>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sameThing" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="self2" MultiLow="1"/>
        <typings>Anything</typings>
        <subsetting>thisThing</subsetting>
        <redefinitions>target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="links" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>Link</typings>
      <subsetting>things</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * links is the most general feature of links between individuals.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="binaryLinks" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>BinaryLink</typings>
      <subsetting>links</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * binaryLinks is a specialization of links restricted to type BinaryLink.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="selfLinks" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>SelfLink</typings>
      <subsetting>binaryLinks</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * selfLinks is a specialization of binaryLinks restricted to type SelfLink.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>SelfLink::thisThing</redefinitions>
        <redefinitions>binaryLinks::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sameThing" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
        <redefinitions>SelfLink::sameThing</redefinitions>
        <redefinitions>binaryLinks::target</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Links.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Metaobjects.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Metaobjects" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines Metaclasses and Features that are related to the typing of syntactic and semantic metadata.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::objects"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="KerML::Element"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="KerML::Type"/>
    <elements xsi:type="kerMLOC:Metaclass" isAbstract="true" declaredName="Metaobject">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Metaobject contains syntactic or semantic information about one or more annotatedElements. &#xD;&#xA;&#x9;&#x9; * It is the most general Metaclass. All other Metaclasses must subclassify it directly or indirectly.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>Metaobject</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="annotatedElement" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Element</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Elements annotated by this Metaobject. This is set automatically when a Metaobject is&#xD;&#xA;&#x9;&#x9;&#x9; * instantiated as the value of a MetadataFeature.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Metaclass" isAbstract="true" declaredName="SemanticMetadata">
      <subsetting>Metaobject</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SemanticMetadata is a Metaobject that requires its single annotatedType to directly or indirectly specialize &#xD;&#xA;&#x9;&#x9; * a baseType that models the semantics for the annotatedType.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isAbstract="true" MultiLow="1" isFeature="true">
        <typings>Type</typings>
        <redefinitions>annotatedElement</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The single annotatedElement of this SemanticMetadata, which must be a Type.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="baseType" MultiLow="1" isFeature="true">
        <typings>Type</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The required base Type for the annotatedType.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="metaobjects" MultiLow="0" MultiHigh="*" isFeature="true">
      <typings>Metaobject</typings>
      <subsetting>objects</subsetting>
      <elements xsi:type="kerMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9; * metaobjects is a specialization of objects restricted to type Metadata. It is the most general &#xD;&#xA;&#x9;&#x9; * MetadataFeature. All other MetadataFeatures must subset it directly or indirectly.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Metaobjects.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Objects.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Objects" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines classifiers and features that are related to the typing of objects, including link objects.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::occurrences"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::WithinBoth"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::performances"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::union"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="CollectionFunctions::contains"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Integer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="Object">
      <subsetting>Occurrence</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Object is the most general class of structural occurrences that may change over time.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true" isSemicolon="true">
        <typings>Object</typings>
        <redefinitions>Occurrence::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="subobjects" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <subsetting>objects</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>objects</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The suboccurrences of this Object that are also Objects.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="involvingPerformances" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Performance</typings>
        <subsetting>performances</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Performances in which this object is involved.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="enactedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>involvingPerformances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <intersecting>involvingPerformances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Performances that are enacted by this object.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="ownedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>involvingPerformances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>involvingPerformances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Performances that are owned by this object.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="that" isFeature="true">
          <redefinitions>this</redefinitions>
          <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * The owning object is the default &quot;this&quot; reference for all ownedPerformances.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="structuredSpaceBoundary" MultiLow="0" MultiHigh="1">
        <typings>StructuredSpaceObject</typings>
        <subsetting>spaceBoundary</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A space boundary that is a structured space object.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:AssociationStructure" isAbstract="true" declaredName="LinkObject">
      <subsetting>Link</subsetting>
      <subsetting>Object</subsetting>
      <intersecting>Link</intersecting>
      <intersecting>Object</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LinkObject is the most general association structure, being both a Link and an Object.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:AssociationStructure" declaredName="BinaryLinkObject">
      <subsetting>BinaryLink</subsetting>
      <subsetting>LinkObject</subsetting>
      <intersecting>BinaryLink</intersecting>
      <intersecting>LinkObject</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * BinaryLinkObject is the most general binary association structure, being both a &#xD;&#xA;&#x9;&#x9; * BinaryLink and a LinkObject.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="objects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>Object</typings>
      <subsetting>occurrences</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * objects is a specialization of occurrences restricted to type Object.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="linkObjects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>LinkObject</typings>
      <subsetting>links</subsetting>
      <subsetting>objects</subsetting>
      <intersecting>links</intersecting>
      <intersecting>objects</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * linkObjects is a specializations of links and objects restricted to type LinkObjects. &#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="binaryLinkObjects" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true">
      <typings>BinaryLinkObject</typings>
      <subsetting>binaryLinks</subsetting>
      <subsetting>linkObjects</subsetting>
      <intersecting>binaryLinks</intersecting>
      <intersecting>linkObjects</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * binaryLinkObjects is a specialization of binaryLinks and linkObjects restricted to &#xD;&#xA;&#x9;&#x9; * type BinaryLinkObjects.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Body" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Body is an Object of inner space dimension 3.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="3" isFeature="true" isSemicolon="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Surface" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Surface is an Object of inner space dimension 2.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="2" isFeature="true" isSemicolon="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/* The number of  &quot;holes&quot; in this Surface, assuming it isClosed. */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="genus" MultiLow="0" MultiHigh="1" isDefault="true" valuePart="0" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="notEmpty(genus) implies isClosed"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Curve" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Curve is an Object of inner space dimension 1.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="1" isFeature="true" isSemicolon="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="Point" isSufficient="true">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Point is an Object of inner space dimension 0.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="0" isFeature="true" isSemicolon="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="StructuredSpaceObject">
      <subsetting>Object</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A StructuredSpaceObject is an Object that is broken up into smaller structured space objects (cells) of&#xD;&#xA;&#x9;&#x9; * the same or lower inner space dimension: faces that are surfaces, edges that are curves, and vertices&#xD;&#xA;&#x9;&#x9; * that are points, with edges and vertices on the boundary of faces, and vertices on the boundary of&#xD;&#xA;&#x9;&#x9; * edges. Cells meet when a structured space object is closed, as required to be a space boundary of&#xD;&#xA;&#x9;&#x9; * an object (faces meet at their edges and/or vertices, while edges meet at their vertices). The&#xD;&#xA;&#x9;&#x9; * inner space dimension of structured space object is the highest of their cells.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isAbstract="true" isPortion="true" declaredName="structuredSpaceObjectCells" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>StructuredSpaceObject</typings>
        <subsetting>Occurrence::spaceSlices</subsetting>
        <elements xsi:type="kerMLOC:Feature" declaredName="cellOrientation" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Integer</typings>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(cellOrientation) implies (cellOrientation >= -1 &amp; cellOrientation &lt;= 1)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9; * The structures StructuredSurface, StructuredCurve and StructuredPoint provide common, necessary redefinitions of&#xD;&#xA;&#x9;&#x9; * innerSpaceDimension. They also provide single types for the StructuredSpaceObject features faces, edges and&#xD;&#xA;&#x9;&#x9; * vertices, which avoids problems when these features are related by connectors with ends that have owned&#xD;&#xA;&#x9;&#x9; * cross features.&#xD;&#xA;&#x9;&#x9; */">
        <annotatedElement>StructuredSurface</annotatedElement>
        <annotatedElement>StructuredCurve</annotatedElement>
        <annotatedElement>StructuredPoint</annotatedElement>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredSurface">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Surface</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Surface::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredCurve">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Curve</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Curve::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Structure" declaredName="StructuredPoint">
        <subsetting>StructuredSpaceObject</subsetting>
        <subsetting>Point</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>StructuredSpaceObject::innerSpaceDimension</redefinitions>
          <redefinitions>Point::innerSpaceDimension</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="faces" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>StructuredSurface</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <typings>StructuredSpaceObject</typings>
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <subsetting>that.edges</subsetting>
          <redefinitions>edges</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <subsetting>that.vertices</subsetting>
          <redefinitions>vertices</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isFeature="true" isSemicolon="true">
          <redefinitions>spaceBoundary</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isEmpty(spaceBoundary) == isEmpty(union(edges, vertices))"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(spaceBoundary) implies contains(spaceBoundary.unionsOf, union(edges, vertices))"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="edges" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>StructuredCurve</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <typings>StructuredSpaceObject</typings>
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <subsetting>that.vertices</subsetting>
          <redefinitions>vertices</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDerived="true" isFeature="true" isSemicolon="true">
          <redefinitions>spaceBoundary</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isEmpty(spaceBoundary) == isEmpty(vertices)"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(spaceBoundary) implies contains(spaceBoundary.unionsOf, vertices)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="vertices" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true" isSemicolon="true">
        <typings>StructuredPoint</typings>
        <subsetting>structuredSpaceObjectCells</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDerived="true" valuePart="if notEmpty(faces) ? 2 else if notEmpty(edges) ? 1 else 0" isFeature="true" isSemicolon="true">
        <redefinitions>innerSpaceDimension</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Objects.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Observation.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Observation" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package models a framework for monitoring Boolean conditions and notifying&#xD;&#xA;&#x9; * registered observers when they change from false to true.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Life"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::including"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::excluding"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::select"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::DecisionPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::IfThenPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="FeatureReferencingPerformances::FeatureWritePerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="FeatureReferencingPerformances::BooleanEvaluationResultToMonitorPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::TransferBefore"/>
    <elements xsi:type="kerMLOC:Structure" visibility="private" declaredName="DefaultMonitorLife" MultiLow="1">
      <subsetting>ChangeMonitor</subsetting>
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * DefaultMonitorLife is the classifier of the singleton Life of the defaultMonitor.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="defaultMonitor" MultiLow="1" isFeature="true">
      <typings>DefaultMonitorLife</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * defaultMonitor is a single ChangeMonitor that can be used as a default.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="ChangeSignal">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ChangeSignal is a signal to be sent when the Boolean result of its&#xD;&#xA;&#x9;&#x9; * changeCondition Expression changes from false to true.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:BooleanExpression" declaredName="signalCondition">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A BooleanExpression whose result is being monitored.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="signalMonitor" isFeature="true">
        <typings>ChangeMonitor</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ChangeMonitor responsible for monitoring the signalCondition.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" visibility="private" declaredName="ObserveChange">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Each Performance of ObserveChange waits for the result of the Boolean &#xD;&#xA;&#x9;&#x9; * condition of a given ChangeSignal to change from false to true, and, when &#xD;&#xA;&#x9;&#x9; * it does, sends the ChangeSignal to a given observer Occurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeObserver" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeSignal" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>ChangeSignal</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="wait">
        <typings>IfThenPerformance</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * If the result of the changeSignal.signalCondition is false, then wait for &#xD;&#xA;&#x9;&#x9;&#x9; * it to become true.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:BooleanExpression" direction="in">
          <redefinitions>ifTest</redefinitions>
          <resultExpressionParameter resultExpression="not changeSignal.signalCondition()"/>
        </elements>
        <elements xsi:type="kerMLOC:Step" direction="in">
          <typings>BooleanEvaluationResultToMonitorPerformance</typings>
          <redefinitions>thenClause</redefinitions>
          <elements xsi:type="kerMLOC:BooleanExpression" direction="in" declaredName="onOccurrence" valuePart="changeSignal.signalCondition"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart refElement="wait"/>
        <connectorPart refElement="transfer"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="transfer" MultiLow="1">
        <typings>TransferBefore</typings>
        <subsetting>changeObserver.incomingTransfers</subsetting>
        <redefinitions>outgoingTransfersFromSelf</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Then send changeSignal to changeObserver.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true">
          <elements xsi:type="kerMLOC:Feature" valuePart="changeSignal" isFeature="true" isSemicolon="true">
            <redefinitions>sourceOutput</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" declaredName="ChangeMonitor">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ChangeMonitor is a collection of ongoing ChangeSignal observations &#xD;&#xA;&#x9;&#x9; * for various observer Occurrences. It provides convenient operations for &#xD;&#xA;&#x9;&#x9; * starting and canceling the observations it manages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="thisMonitor" isSemicolon="true">
        <typings>ChangeMonitor</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" isComposite="true" declaredName="observations" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
        <typings>ObserveChange</typings>
      </elements>
      <elements xsi:type="kerMLOC:Behavior" visibility="private" declaredName="AssignObservations">
        <subsetting>FeatureWritePerformance</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Assign a replacement set of observations as those being managed by a&#xD;&#xA;&#x9;&#x9;&#x9; * given ChangeMonitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" isFeature="true">
          <typings>ChangeMonitor</typings>
          <redefinitions>onOccurrence</redefinitions>
          <elements xsi:type="kerMLOC:Feature" isFeature="true">
            <redefinitions>startingAt</redefinitions>
            <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
              <redefinitions>accessedFeature</redefinitions>
              <redefinitions>observations</redefinitions>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="inout" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>ObserveChange</typings>
          <redefinitions>replacementValues</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="startObservation">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Start an observation of a given ChangeSignal for a given Occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" MultiLow="1" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" MultiLow="1" isSemicolon="true">
          <typings>ChangeSignal</typings>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="observation">
          <typings>ObserveChange</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeObserver" valuePart="observer" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="changeSignal" valuePart="signal" isSemicolon="true"/>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="addObservation" MultiLow="1">
          <typings>AssignObservations</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" valuePart="thisMonitor" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="replacementValues" valuePart="observations->including(observation)" isSemicolon="true"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="cancelObservation">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Cancel all observations of a given ChangeSignal for a given Occurrence. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" MultiLow="1" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" MultiLow="1" isSemicolon="true">
          <typings>ChangeSignal</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="observations" MultiLow="0" MultiHigh="*" valuePart="observations->select{in observation : ObserveChange; observation.changeObserver == observer and observation.changeSignal == signal }" isFeature="true" isSemicolon="true">
          <typings>ObserveChange</typings>
        </elements>
        <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="removeObservation" MultiLow="1">
          <typings>AssignObservations</typings>
          <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" valuePart="thisMonitor" isSemicolon="true"/>
          <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="replacementValues" valuePart="observations->excluding(observations)" isSemicolon="true"/>
        </elements>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Observation.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Occurrences.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Occurrences" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines modeling constructs for anything existing or occurring in time and space, with&#xD;&#xA;&#x9; * associations between them that assert temporal and spatial relationships.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::DataValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Clocks" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Collections::Set"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Collections::OrderedSet"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="CollectionFunctions::contains"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::union"/>
    <elements xsi:type="kerMLOC:Class" isAbstract="true" declaredName="Occurrence">
      <subsetting>Anything</subsetting>
      <disjoining>DataValue</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * Occurrence is the most general classifier of entities that have identity and&#xD;&#xA;         * occur over time and space.&#xD;&#xA;         *&#xD;&#xA;         * The features of Occurrence specify the semantics of associations between occurrences that&#xD;&#xA;         * assert complete inclusion and exclusion in time or space, or both, which includes&#xD;&#xA;         * portions of an occurrence (having the same identity).  Portions include slices and shots&#xD;&#xA;         * over time and space.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions" isNamespace="true"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="portionOfLife" MultiLow="1" isDefault="true" valuePart="self" isFeature="true" isSemicolon="true">
        <typings>Life</typings>
        <subsetting>portionOf</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <subsetting>timeSlices</subsetting>
        <subsetting>spaceSlices</subsetting>
        <subsetting>spaceTimeCoincidentOccurrences</subsetting>
        <subsetting>sameLifeOccurrences</subsetting>
        <redefinitions>Anything::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="sameLifeOccurrences" MultiLow="1" MultiHigh="*" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <subsetting>things</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="this" MultiLow="1" isDefault="true" valuePart="self" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The &quot;context&quot; Occurrence within which this Occurrence takes place. By default, it is this&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrence itself. However, this is overridden for ownedPerformances of Objects and&#xD;&#xA;&#x9;&#x9;&#x9; * subperformances of Performances.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="self"/>
        <connectorPart MultiLow="1" refElement="this"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="localClock" MultiLow="1" isDefault="true" valuePart="universalClock" isFeature="true">
        <typings>Clock</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A local Clock to be used as the corresponding time reference for this Occurrence&#xD;&#xA;&#x9;&#x9;&#x9; * and, by default, all ownedOccurrences. By default this is the singleton universalClock.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isComposite="true" declaredName="suboccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>occurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Composite suboccurrences of this Occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Occurrence).localClock" isFeature="true">
          <redefinitions>localClock</redefinitions>
          <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; &#x9; * The localClock of a suboccurrence defaults to the localClock of its containing&#xD;&#xA;&#x9;&#x9;&#x9; &#x9; * Occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; &#x9; */"/>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Occurrence).incomingTransferSort" isFeature="true" isSemicolon="true">
          <redefinitions>incomingTransferSort</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/* Occurrences may be suboccurrences of no more than one other occurrence. */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="superoccurrence" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <subsetting>occurrences</subsetting>
        <invertingFeature>suboccurrences</invertingFeature>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="withoutOccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <unioning>successors</unioning>
        <unioning>predecessors</unioning>
        <unioning>outsideOfOccurrences</unioning>
        <invertingFeature>withoutOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that are completely separate either in time or space or both.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Comment" body="/* withoutOccurrences is irreflexive. */"/>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="(that as Occurrence) != (that.that as Occurrence)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="predecessors" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>withoutOccurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that end before this occurrence starts.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="successors" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>withoutOccurrences</subsetting>
        <invertingFeature>predecessors</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that start after this occurrence ends.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Comment" body="/* successors is transitive. */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="earlierOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="laterOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="laterOccurrence.successors" subsettedFeature="earlierOccurrence.successors"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="immediatePredecessors" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>predecessors</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that end just before this occurrence starts, with no&#xD;&#xA;&#x9;&#x9;&#x9; * possibility of other occurrences happening in the time between them.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="immediateSuccessors" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>successors</subsetting>
        <invertingFeature>immediatePredecessors</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that start just after this occurrence ends, with no&#xD;&#xA;&#x9;&#x9;&#x9; * possibility of other occurrences happening in the time between them.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Disjoining" typeDisjoined="earlierOccurrence.successors" disjoiningType="laterOccurrence.predecessors"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="timeEnclosedOccurrences" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>occurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that start no earlier than and end no later than&#xD;&#xA;&#x9;&#x9;&#x9; * this occurrence, including at least this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * timeEnclosedOccurrences and successors constrain each other. All successors of&#xD;&#xA;&#x9;&#x9;&#x9; * (occurrences happening after) time enclosing occurrences (inverse of&#xD;&#xA;&#x9;&#x9;&#x9; * timeEnclosedOccurrences) are also successors of their timeEnclosedOccurrences.&#xD;&#xA;&#x9;&#x9;&#x9; * And predecessors of (occurrences happening before) time enclosing occurrences&#xD;&#xA;&#x9;&#x9;&#x9; * are predecessors of their timeEnclosedOccurrences.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="longerOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="shorterOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="longerOccurrence.predecessors" subsettedFeature="shorterOccurrence.predecessors"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="longerOccurrence.successors" subsettedFeature="shorterOccurrence.successors"/>
        <elements xsi:type="kerMLOC:Comment" body="/* timeEnclosedOccurrences is transitive. */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="shorterOccurrence.timeEnclosedOccurrences" subsettedFeature="longerOccurrence.timeEnclosedOccurrences"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="timeCoincidentOccurrences" MultiLow="1" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <invertingFeature>timeCoincidentOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that start at the same time and end at the same time as this occurrence,&#xD;&#xA;&#x9;&#x9;&#x9; * including at least this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="thatOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>longerOccurrence</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="thisOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>shorterOccurrence</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* timeCoincidentOccurrences occurrences happen during each other. */"/>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>HappensDuring</typings>
          <connectorPart MultiLow="1" delcaredName="shorterOccurrence" refElement="thisOccurrence"/>
          <connectorPart MultiLow="1" delcaredName="longerOccurrence" refElement="thatOccurrence"/>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* timeCoincidentOccurrences is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="thatOccurrence.timeCoincidentOccurrences" subsettedFeature="thisOccurrence.timeCoincidentOccurrences"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceEnclosedOccurrences" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>occurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that this one completely includes in space (not necessarily in time),&#xD;&#xA;&#x9;&#x9;&#x9; * including this one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="largerSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="smallerSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceEnclosedOccurrences is transitive. */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="smallerSpace.spaceEnclosedOccurrences" subsettedFeature="largerSpace.spaceEnclosedOccurrences"/>
        <elements xsi:type="kerMLOC:Comment" body="/* smallerSpace are outside occurrences that are outside their largerSpace */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="smallerSpace.outsideOfOccurrences" subsettedFeature="largerSpace.outsideOfOccurrences"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceTimeEnclosedOccurrences" MultiLow="1" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <subsetting>spaceEnclosedOccurrences</subsetting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <intersecting>spaceEnclosedOccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that this one completely includes in both space and time,&#xD;&#xA;&#x9;&#x9;&#x9; * including this one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceTimeEnclosedOccurrences is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="largerSpace.spaceTimeEnclosedOccurrences" subsettedFeature="smallerSpace.spaceTimeEnclosedOccurrences"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceTimeEnclosedPoints" MultiLow="1" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceTimeEnclosedOccurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * All space time enclosed occurrences that take up zero time and space.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" valuePart="0" isSemicolon="true">
          <redefinitions>innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart MultiLow="1" refElement="startShot"/>
          <connectorPart MultiLow="1" refElement="endShot"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceTimeCoincidentOccurrences" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeCoincidentOccurrences</subsetting>
        <subsetting>spaceEnclosedOccurrences</subsetting>
        <subsetting>spaceTimeEnclosedOccurrences</subsetting>
        <intersecting>timeCoincidentOccurrences</intersecting>
        <intersecting>spaceEnclosedOccurrences</intersecting>
        <invertingFeature>spaceTimeCoincidentOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that this one completely includes in both space and time,&#xD;&#xA;&#x9;&#x9;&#x9; * and vice-versa, including this one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <subsetting>largerSpace</subsetting>
          <redefinitions>thatOccurrence</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <subsetting>smallerSpace</subsetting>
          <redefinitions>thisOccurrence</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceTimeCoincidentOccurrences occurrences are inside of each other. */"/>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>InsideOf</typings>
          <connectorPart MultiLow="1" delcaredName="largerSpace" refElement="thatOccurrence"/>
          <connectorPart MultiLow="1" delcaredName="smallerSpace" refElement="thisOccurrence"/>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceTimeCoincidentOccurrences is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="thatOccurrence.spaceTimeCoincidentOccurrences" subsettedFeature="thisOccurrence.spaceTimeCoincidentOccurrences"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="outsideOfOccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>withoutOccurrences</subsetting>
        <invertingFeature>outsideOfOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that do not overlap in space (not necessarily in time, see successors).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="justOutsideOfOccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>outsideOfOccurrences</subsetting>
        <invertingFeature>justOutsideOfOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that have no space between some of their space slices and some space slices of this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="separateSpaceToo" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="separateSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Connector" MultiLow="1" MultiHigh="*" isFrom="true">
          <typings>MatesWith</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="separateSpaceToo" refElement="separateSpaceToo.spaceSlices"/>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="separateSpace" refElement="separateSpace.spaceSlices"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="matingOccurrences" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>justOutsideOfOccurrences</subsetting>
        <invertingFeature>matingOccurrences</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that have no space between them and this one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="matingSpaceToo" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="matingSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="matingOccurrence" MultiLow="1" isFeature="true">
          <typings>Occurrence</typings>
          <elements xsi:type="kerMLOC:Feature" isPortion="true" MultiLow="1" isFeature="true" isSemicolon="true">
            <redefinitions>spaceBoundary</redefinitions>
          </elements>
          <elements xsi:type="kerMLOC:Invariant">
            <resultExpressionParameter resultExpression="contains(unionsOf, union(matingSpaceToo, matingSpace))"/>
          </elements>
          <elements xsi:type="kerMLOC:Feature" isPortion="true" MultiLow="0" isFeature="true" isSemicolon="true">
            <redefinitions>spaceInterior</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="innerSpaceDimension" MultiLow="1" isFeature="true">
        <typings>Natural</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The number of variables needed to identify space points in this occurrence, from 0&#xD;&#xA;&#x9;&#x9;&#x9; * to 3, without regard to higher dimensional spaces it might be embedded in.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="innerSpaceDimension &lt;= 3"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="outerSpaceDimension" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Natural</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * For occurrences of innerSpaceDimension 1 or 2, the number of variables needed to&#xD;&#xA;&#x9;&#x9;&#x9; * identify their space points in higher dimensions they might be embedded in, from&#xD;&#xA;&#x9;&#x9;&#x9; * the innerSpaceDimension to 3. An outerSpaceDimension equal to innerSpaceDimension&#xD;&#xA;&#x9;&#x9;&#x9; * indicates the occurrence is spatially straight (innerSpaceDimension 1 embedded in&#xD;&#xA;&#x9;&#x9;&#x9; * 2 or 3 dimensions) or flat (innerSpaceDimension 2 embedded in 3 dimensions).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="notEmpty(outerSpaceDimension) implies (outerSpaceDimension >= innerSpaceDimension &amp; outerSpaceDimension &lt;= 3)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="portions" MultiLow="1" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceTimeEnclosedOccurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * All spaceTimeEnclosedOccurrences that have the same portionOfLife (considered the same&#xD;&#xA;&#x9;&#x9;&#x9; * thing occurring).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isPortion="true" valuePart="(that as Occurrence).portionOfLife" isSemicolon="true">
          <redefinitions>portionOfLife</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="portionOf" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <invertingFeature>portions</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences of which this occurrence is a portion, including at&#xD;&#xA;&#x9;&#x9;&#x9; * least this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="timeSlices" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>portions</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Portions of an occurrence taking up all of its space over some period of time,&#xD;&#xA;&#x9;&#x9;&#x9; * including at least this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="timeSliceOf" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>portionOf</subsetting>
        <invertingFeature>timeSlices</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences of which this occurrence is a time slice, including at least this&#xD;&#xA;&#x9;&#x9;&#x9; * occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="timeSliceOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="timeSlicedOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* timeSliceOf is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="timeSlicedOccurrence.timeSliceOf" subsettedFeature="timeSliceOccurrence.timeSliceOf"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="snapshots" MultiLow="1" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeSlices</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Time slices of an occurrence that happen at a single instant of time&#xD;&#xA;&#x9;&#x9;&#x9; * (i.e., have no duration).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:BindingConnector">
          <connectorPart MultiLow="1" refElement="startShot"/>
          <connectorPart MultiLow="1" refElement="endShot"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="snapshots == union(startShot, union(middleTimeSlice.snapshots, endShot))"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="snapshotOf" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeSliceOf</subsetting>
        <invertingFeature>snapshots</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences of which this occurrence is a snapshot.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="startShot" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>snapshots</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The snapshot representing the start of the occurrence in time.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="middleTimeSlice" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>timeSlices</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A time slice that takes all the time between the start shot and end shot. There&#xD;&#xA;&#x9;&#x9;&#x9; * is none when the startShot and endShot are the same.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isEmpty((that as Occurrence).middleTimeSlice) == ((that as Occurrence).startShot == (that as Occurrence).endShot)"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensJustBefore</typings>
        <connectorPart MultiLow="1" delcaredName="earlierOccurrence" refElement="startShot"/>
        <connectorPart MultiLow="0" MultiHigh="1" delcaredName="laterOccurrence" refElement="middleTimeSlice"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The startShot happens immediately before the middle time slice.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="endShot" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>snapshots</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The snapshot at the end of the occurrence in time.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Comment" body="/* suboccurrences at the end of an Occurrence must also end. */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="subendshot" MultiLow="0" MultiHigh="*" isFeature="true">
          <typings>Occurrence</typings>
          <chainingFeature>self.suboccurrences.endShot</chainingFeature>
          <elements xsi:type="kerMLOC:Feature" declaredName="superendshot" MultiLow="1" isFeature="true" isSemicolon="true">
            <typings>Occurrence</typings>
            <subsetting>that</subsetting>
          </elements>
          <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="superendshot" subsettedFeature="self.timeCoincidentOccurrences"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensJustBefore</typings>
        <connectorPart MultiLow="0" MultiHigh="1" delcaredName="earlierOccurrence" refElement="middleTimeSlice"/>
        <connectorPart MultiLow="1" delcaredName="laterOccurrence" refElement="endShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The endShot happens after the middle time slice.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="spaceSlices" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>portions</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Portions of this occurrence that extend for exactly the same time and some or all&#xD;&#xA;&#x9;&#x9;&#x9; * the space, relative to spatial location of this occurrence, including at least&#xD;&#xA;&#x9;&#x9;&#x9; * this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceSliceOf" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>portionOf</subsetting>
        <invertingFeature>spaceSlices</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences of which this occurrence is a space slice, including at least this&#xD;&#xA;&#x9;&#x9;&#x9; * occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceSliceOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceSlicedOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="spaceSliceOccurrence.innerSpaceDimension &lt;= spaceSlicedOccurrence.innerSpaceDimension"/>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceSliceOf is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="spaceSlicedOccurrence.spaceSliceOf" subsettedFeature="spaceSliceOccurrence.spaceSliceOf"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="spaceShots" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceSlices</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * All spaceSlices of this occurrence that are of a lower inner space dimension than it.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceShotOf" MultiLow="0" MultiHigh="*" isSufficient="true" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceSliceOf</subsetting>
        <invertingFeature>spaceShots</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * All occurrences of which this occurrence is a space shot.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceShotOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceShottedOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="spaceShotOccurrence.innerSpaceDimension &lt; spaceShottedOccurrence.innerSpaceDimension"/>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* spaceShotOf is transitive */"/>
        <elements xsi:type="kerMLOC:Subsetting" subsettingFeature="spaceShottedOccurrence.spaceShotOf" subsettedFeature="spaceShotOccurrence.spaceShotOf"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="unionsOf" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Set</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Sets of occurrences, where the time and space taken by all the occurrences in each&#xD;&#xA;&#x9;&#x9;&#x9; * set together is the same as taken by this occurrence (all four dimensional points in&#xD;&#xA;&#x9;&#x9;&#x9; * the occurrences of each set are at the same time and space as those of this&#xD;&#xA;&#x9;&#x9;&#x9; * occurrence).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <redefinitions>elements</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="union" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Within</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="smallerOccurrence" refElement="elements"/>
          <connectorPart MultiLow="1" delcaredName="largerOccurrence" refElement="union"/>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Within</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="smallerOccurrence" refElement="union.spaceTimeEnclosedPoints"/>
          <connectorPart MultiLow="1" MultiHigh="*" delcaredName="largerOccurrence" refElement="elements"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="unionsOf.union"/>
        <connectorPart MultiLow="1" refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="intersectionsOf" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Set</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Sets of occurrences, where the time and space taken in common between the occurrences&#xD;&#xA;&#x9;&#x9;&#x9; * in each set is at the same as taken by this occurrence (all four dimensional points&#xD;&#xA;&#x9;&#x9;&#x9; * common to the occurrences in each set are at the same time and space as those in this&#xD;&#xA;&#x9;&#x9;&#x9; * occurrence).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" MultiLow="0" MultiHigh="*" isFeature="true">
          <typings>Occurrence</typings>
          <redefinitions>elements</redefinitions>
          <elements xsi:type="kerMLOC:Feature" declaredName="notIntersection" MultiLow="0" MultiHigh="*" isSufficient="true" isFeature="true" isSemicolon="true">
            <typings>Occurrence</typings>
            <subsetting>spaceTimeEnclosedPoints</subsetting>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="intersection" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Within</typings>
          <connectorPart MultiLow="1" delcaredName="smallerOccurrence" refElement="intersection"/>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="largerOccurrence" refElement="elements"/>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Without</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="separateOccurrenceToo" refElement="elements.notIntersection"/>
          <connectorPart MultiLow="1" delcaredName="separateOccurrence" refElement="intersection"/>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Without</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="separateOccurrenceToo" refElement="elements.notIntersection"/>
          <connectorPart MultiLow="1" MultiHigh="*" delcaredName="separateOccurrence" refElement="elements"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="intersectionsOf.intersection"/>
        <connectorPart MultiLow="1" refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="differencesOf" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>OrderedSet</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Ordered sets of occurrences, where the time and space taken by first occurrence in&#xD;&#xA;&#x9;&#x9;&#x9; * each set that is not in the time and space taken by the remaining occurrences is the&#xD;&#xA;&#x9;&#x9;&#x9; * same as taken by this occurrence (all four dimensional points in the minuend that are&#xD;&#xA;&#x9;&#x9;&#x9; * not in any subtrahend are at the same time and space as those in this occurrence).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <redefinitions>elements</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="difference" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="minuend" MultiLow="0" MultiHigh="1" valuePart="head(elements)" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>elements</subsetting>
          <subsetting>interdiff.elements</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="subtrahend" MultiLow="*" valuePart="tail(elements)" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>elements</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="interdiff" MultiLow="0" MultiHigh="1" isFeature="true">
          <typings>Set</typings>
          <elements xsi:type="kerMLOC:Feature" MultiLow="1" MultiHigh="*" isFeature="true" isSemicolon="true">
            <typings>Occurrence</typings>
            <redefinitions>elements</redefinitions>
          </elements>
          <elements xsi:type="kerMLOC:Feature" declaredName="notSubtrahend" MultiLow="0" MultiHigh="*" isSufficient="true" isFeature="true" isSemicolon="true">
            <typings>Occurrence</typings>
            <subsetting>elements</subsetting>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>Without</typings>
          <connectorPart MultiLow="0" MultiHigh="*" delcaredName="separateOccurrenceToo" refElement="interdiff.notSubtrahend"/>
          <connectorPart MultiLow="1" MultiHigh="*" delcaredName="separateOccurrence" refElement="subtrahend"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isEmpty(difference) == isEmpty(interdiff)"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(difference) implies (difference.intersectionsOf == interdiff)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="differencesOf.difference"/>
        <connectorPart MultiLow="1" refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="spaceInterior" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceSlices</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A space slice of this occurrence that includes all its space shots except the&#xD;&#xA;&#x9;&#x9;&#x9; * space boundary, which must exist and be outsideOf it.  The space interior must be&#xD;&#xA;&#x9;&#x9;&#x9; * of the same inner space dimension as this occurrence, except if it is zero,&#xD;&#xA;&#x9;&#x9;&#x9; * whereupon there is no space interior.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceInteriorOf" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceSliceOf</subsetting>
        <invertingFeature>spaceInterior</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * An Occurrence of which this one is the space interior.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="notEmpty(spaceInterior) implies spaceInterior.innerSpaceDimension == innerSpaceDimension"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isPortion="true" declaredName="spaceBoundary" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceShots</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The space shot of this Occurrence that is not among those of its space interior,&#xD;&#xA;&#x9;&#x9;&#x9; * which must be outside it. It must not have a spaceBoundary.&#x9;It can be divided&#xD;&#xA;&#x9;&#x9;&#x9; * into space slices that also have no spaceBoundary, where the outer one surrounds&#xD;&#xA;&#x9;&#x9;&#x9; * the inner ones.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isClosed == true"/>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceBounder" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="outer" MultiLow="0" MultiHigh="1" isFeature="true">
          <typings>Occurrence</typings>
          <subsetting>spaceSlices</subsetting>
          <elements xsi:type="kerMLOC:Feature" valuePart="true" isFeature="true" isSemicolon="true">
            <redefinitions>isClosed</redefinitions>
          </elements>
          <elements xsi:type="kerMLOC:Feature" valuePart="spaceBounder.innerSpaceDimension" isFeature="true" isSemicolon="true">
            <redefinitions>innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="inner" MultiLow="0" MultiHigh="*" isFeature="true">
          <typings>Occurrence</typings>
          <subsetting>spaceSlices</subsetting>
          <elements xsi:type="kerMLOC:Feature" valuePart="true" isFeature="true" isSemicolon="true">
            <redefinitions>isClosed</redefinitions>
          </elements>
          <elements xsi:type="kerMLOC:Feature" valuePart="spaceBounder.innerSpaceDimension" isFeature="true" isSemicolon="true">
            <redefinitions>innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(inner) implies notEmpty(outer)"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="notEmpty(outer) implies contains(unionsOf, union(outer, inner))"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="spaceBoundaryOf" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>spaceShotOf</subsetting>
        <invertingFeature>spaceBoundary</invertingFeature>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * An Occurrence of which this one is the space boundary.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="spaceBounderOf" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="spaceBounderOf.spaceBoundary == that.that"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="not isClosed implies contains((that as Occurrence).unionsOf, union(spaceBoundary, spaceInterior))"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="innerSpaceDimension == 0 implies isEmpty(spaceBoundary)"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>SurroundedBy</typings>
        <connectorPart MultiLow="0" MultiHigh="*" delcaredName="surroundedSpace" refElement="spaceInterior"/>
        <connectorPart MultiLow="1" delcaredName="surroundingSpace" refElement="spaceBoundary.outer"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>SurroundedBy</typings>
        <connectorPart MultiLow="0" MultiHigh="*" delcaredName="surroundedSpace" refElement="spaceBoundary.inner"/>
        <connectorPart MultiLow="1" delcaredName="surroundingSpace" refElement="spaceInterior"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="innerSpaceOccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>outsideOfOccurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that completely occupy the space surrounded by an inner space boundary of this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" MultiLow="0" isFeature="true" isSemicolon="true">
          <redefinitions>innerSpaceOccurrences</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Comment" body="/* innerSpace is the spaceInterior of hOccurrence, which is formed from an inner space boundary of outerSpace. */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="outerSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="innerSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="hOccurrence" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
        </elements>
        <elements xsi:type="kerMLOC:Connector" declaredName="hbi" MultiLow="0" MultiHigh="1" isFrom="true">
          <typings>WithinBoth</typings>
          <connectorPart MultiLow="0" MultiHigh="1" refElement="hOccurrence.spaceBoundary"/>
          <connectorPart MultiLow="0" MultiHigh="1" refElement="outerSpace.spaceBoundary.inner"/>
        </elements>
        <elements xsi:type="kerMLOC:Connector" declaredName="hbo" MultiLow="0" MultiHigh="1" isFrom="true">
          <typings>WithinBoth</typings>
          <connectorPart MultiLow="0" MultiHigh="1" refElement="hOccurrence.spaceBoundary"/>
          <connectorPart MultiLow="0" MultiHigh="1" refElement="outerSpace"/>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>WithinBoth</typings>
          <connectorPart MultiLow="1" refElement="hOccurrence.spaceInterior"/>
          <connectorPart MultiLow="1" refElement="innerSpace"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="(isEmpty(hbi) == notEmpty(hbo)) &amp; (notEmpty(hbo) == outerSpace.isClosed)"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="surroundedByOccurrences" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Occurrence</typings>
        <subsetting>outsideOfOccurrences</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Occurrences that have inner spaces that completely include this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="surroundedSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>that</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="surroundingSpace" MultiLow="1" isFeature="true" isSemicolon="true">
          <typings>Occurrence</typings>
          <subsetting>self</subsetting>
        </elements>
        <elements xsi:type="kerMLOC:Connector" isFrom="true">
          <typings>InsideOf</typings>
          <connectorPart MultiLow="0" MultiHigh="1" delcaredName="smallerOccurrence" refElement="surroundedSpace"/>
          <connectorPart MultiLow="1" MultiHigh="*" delcaredName="largerOccurrence" refElement="surroundingSpace.innerSpaceOccurrences"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isClosed" MultiLow="1" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Tells whether an occurrence has a spaceBoundary, true if it does, false otherwise.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isClosed == isEmpty((that as Occurrence).spaceBoundary)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="incomingTransfers" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Transfers::Transfer</typings>
        <subsetting>Transfers::transfers</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The incoming transfers received by this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isDispatch" MultiLow="1" isDefault="true" valuePart="false" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Determines whether transfers to the dispatch scope might be accepted more than once.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="dispatchScope" MultiLow="1" isDefault="true" valuePart="self" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="self"/>
        <connectorPart MultiLow="1" refElement="dispatchScope"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isRunToCompletion" MultiLow="1" isDefault="true" valuePart="true" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Determines whether transition performances might happen during state entry performances&#xD;&#xA;&#x9;&#x9;&#x9; * within the run to completion scope.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="runToCompletionScope" MultiLow="1" isDefault="true" valuePart="self" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="self"/>
        <connectorPart MultiLow="1" refElement="runToCompletionScope"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="incomingTransferSort" MultiLow="0" MultiHigh="*" isDefault="true" valuePart="earlierFirstIncomingTransferSort" isFeature="true">
        <typings>IncomingTransferSort</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Determines which transfer to accept when multiple are available and which of the unaccepted &#xD;&#xA;&#x9;&#x9;&#x9; * transfers are never to be accepted (dispatched).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="incomingTransfersToSelf" isSufficient="true" isFeature="true">
        <subsetting>incomingTransfers</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The incoming transfers with this occurrence as the target.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" valuePart="that" isFeature="true" isSemicolon="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="outgoingTransfers" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Transfers::Transfer</typings>
        <subsetting>Transfers::transfers</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The outgoing transfers sent from this occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isVariable="true" declaredName="outgoingTransfersFromSelf" isSufficient="true" isFeature="true">
        <subsetting>outgoingTransfers</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The outgoing transfers with this occurrence as the source.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" valuePart="that" isFeature="true" isSemicolon="true">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
          <redefinitions>target</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Class" isAbstract="true" declaredName="Life" isSufficient="true">
      <subsetting>Occurrence</subsetting>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="portionOf"/>
        <connectorPart refElement="self"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Lives are only portions of themselves.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="occurrences" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true" isSemicolon="true">
      <typings>Occurrence</typings>
      <subsetting>things</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:Predicate" declaredName="IncomingTransferSort">
      <subsetting>Performances::BooleanEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="t1" MultiLow="1" isSemicolon="true">
        <typings>Transfers::Transfer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="t2" MultiLow="1" isSemicolon="true">
        <typings>Transfers::Transfer</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="t1First" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:BooleanExpression" declaredName="earlierFirstIncomingTransferSort">
      <typings>IncomingTransferSort</typings>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="t1First" valuePart="includes(t1.endShot.successors, t2.endShot)" isSemicolon="true"/>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SelfSameLifeLink" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SelfSameLifeLink is a binary association that is equivalent to SelfLink if the&#xD;&#xA;&#x9;&#x9; * linked things are DataValues, but asserts that the linked things are portions of&#xD;&#xA;&#x9;&#x9; * the same Life if they are Occurrences. &#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="myselfSameLife" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="myselfSameLives" MultiLow="1" MultiHigh="*"/>
        <typings>Anything</typings>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="selfSameLife" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="selfSameLives" MultiLow="1" MultiHigh="*"/>
        <typings>Anything</typings>
        <redefinitions>target</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="sourceOccurrence" MultiLow="0" MultiHigh="1" isSufficient="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <subsetting>myselfSameLife</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="targetOccurrence" MultiLow="0" MultiHigh="1" isSufficient="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <subsetting>selfSameLife</subsetting>
        <subsetting>sourceOccurrence.sameLifeOccurrences</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" declaredName="oSelf" isOf="true">
        <connectorPart refElement="sourceOccurrence.portionOfLife"/>
        <connectorPart refElement="targetOccurrence.portionOfLife"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="sourceDataValue" MultiLow="0" MultiHigh="1" isSufficient="true" isFeature="true" isSemicolon="true">
        <typings>DataValue</typings>
        <subsetting>myselfSameLife</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="targetDataValue" MultiLow="0" MultiHigh="1" isSufficient="true" isFeature="true" isSemicolon="true">
        <typings>DataValue</typings>
        <subsetting>selfSameLife</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" declaredName="dSelf" isOf="true">
        <connectorPart refElement="sourceDataValue"/>
        <connectorPart refElement="targetDataValue"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Subclassification" subclassifier="SelfLink" superclassifier="SelfSameLifeLink"/>
    <elements xsi:type="kerMLOC:Association" declaredName="HappensLink">
      <subsetting>BinaryLink</subsetting>
      <disjoining>Occurrence</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * HappensLink is the most general associations that assert temporal relationships between a&#xD;&#xA;&#x9;&#x9; * sourceOccurrence and a targetOccurrence. Because HappensLinks assert temporal&#xD;&#xA;&#x9;&#x9; * relationships, they cannot also be Occurrences that happen in time.  Therefore&#xD;&#xA;&#x9;&#x9; * HappensLink is disjoint with LinkObject, that is, no HappensLink can also be a&#xD;&#xA;&#x9;&#x9; * LinkObject.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sourceOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="targetOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="HappensDuring" isSufficient="true">
      <subsetting>HappensLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * HappensDuring asserts that the shorterOccurrence happens during the longerOccurrence.&#xD;&#xA;&#x9;&#x9; * That is, the time interval of the shorterOccurrence is completely within that of the&#xD;&#xA;&#x9;&#x9; * longerOccurrence, or every snapshot of the shorterOccurrence happens while (at the&#xD;&#xA;&#x9;&#x9; * same time as) some snapshot of the longerOccurrence. Note that this means every&#xD;&#xA;&#x9;&#x9; * Occurrence HappensDuring itself and that HappensDuring is transitive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="shorterOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>longerOccurrence.timeEnclosedOccurrences</crosses>
        <redefinitions>sourceOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="longerOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="happensDuring" MultiLow="1" MultiHigh="*"/>
        <typings>Occurrence</typings>
        <redefinitions>targetOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="HappensWhile" isSufficient="true">
      <subsetting>HappensDuring</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * HappensWhile asserts that two occurrences happen during each other, that is, they&#xD;&#xA;&#x9;&#x9; * each start at the same time and end at the same time.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>thatOccurrence.timeCoincidentOccurrences</crosses>
        <redefinitions>shorterOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thatOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="happensWhile" MultiLow="1" MultiHigh="*">
          <subsetting>timeCoincidentOccurrences</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>longerOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SpaceLink">
      <subsetting>BinaryLink</subsetting>
      <disjoining>Occurrence</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * SpaceLink is the most general association that asserts spatial relationships between a&#xD;&#xA;         * sourceOccurrence and a targetOccurrence. Because SpaceLinks assert spatial&#xD;&#xA;         * relationships, they cannot also be Occurrences that happen in space.  Therefore&#xD;&#xA;         * SpaceLink is disjoint with LinkObject, that is, no SpaceLink can also be a&#xD;&#xA;         * LinkObject.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="sourceOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="targetOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="InsideOf" isSufficient="true">
      <subsetting>SpaceLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * InsideOf asserts that its largerSpace completely overlaps its smallerSpace in space (not&#xD;&#xA;&#x9;&#x9; * necessarily in time, see HappensDuring). That is, all four dimensional points of the&#xD;&#xA;&#x9;&#x9; * smallerSpace are in the spatial extent of the largerSpace. Note that this means every&#xD;&#xA;&#x9;&#x9; * Occurrence is InsideOf itself and that InsideOf is transitive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="smallerSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>largerSpace.spaceEnclosedOccurrences</crosses>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="largerSpace" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="insideOf" MultiLow="1" MultiHigh="*"/>
        <typings>Occurrence</typings>
        <redefinitions>target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="Within" isSufficient="true">
      <subsetting>HappensDuring</subsetting>
      <subsetting>InsideOf</subsetting>
      <intersecting>HappensDuring</intersecting>
      <intersecting>InsideOf</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Within asserts that its largerOccurrence completely overlaps its smallerOccurrence in&#xD;&#xA;&#x9;&#x9; * time and space. That is, all four dimensional points of the smallerOccurrence happen&#xD;&#xA;&#x9;&#x9; * during and are included in the space of the largerOccurrence. This means every occurrence&#xD;&#xA;&#x9;&#x9; * is Within itself and Within is transitive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="smallerOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>largerOccurrence.spaceTimeEnclosedOccurrences</crosses>
        <redefinitions>shorterOccurrence</redefinitions>
        <redefinitions>smallerSpace</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="largerOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="within" MultiLow="1" MultiHigh="*"/>
        <typings>Occurrence</typings>
        <redefinitions>longerOccurrence</redefinitions>
        <redefinitions>largerSpace</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="WithinBoth" isSufficient="true">
      <subsetting>Within</subsetting>
      <subsetting>HappensWhile</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * WithinBoth asserts that two occurrences are Within each other, that is, they occupy the&#xD;&#xA;&#x9;&#x9; * same four dimensional region.  Note that this means every Occurrence is WithinBoth with&#xD;&#xA;&#x9;&#x9; * itself and transitive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thisOccurrence" isFeature="true" isSemicolon="true">
        <crosses>thatOccurrence.spaceTimeCoincidentOccurrences</crosses>
        <redefinitions>smallerOccurrence</redefinitions>
        <redefinitions>HappensWhile::thisOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="thatOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="withinBoth">
          <subsetting>spaceTimeCoincidentOccurrences</subsetting>
        </crossingFeature>
        <redefinitions>largerOccurrence</redefinitions>
        <redefinitions>HappensWhile::thatOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="PortionOf" isSufficient="true">
      <subsetting>Within</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * PortionOf asserts one occurrence is a portion of another, including at least itself.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="portionOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>portionedOccurrence.portions</crosses>
        <redefinitions>smallerOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="portionedOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="portionWithin">
          <subsetting>portionOf</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>largerOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="TimeSliceOf" isSufficient="true">
      <subsetting>PortionOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * TimeSliceOf asserts one occurrence is a time slice of another, including at least itself.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="timeSliceOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>timeSlicedOccurrence.timeSlices</crosses>
        <redefinitions>portionOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="timeSlicedOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="timeSliceWithin">
          <subsetting>timeSliceOf</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>portionedOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SnapshotOf" isSufficient="true">
      <subsetting>TimeSliceOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SnapshotsOf asserts one occurrence is a snapshot of another.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="snapshotOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>snapshottedOccurrence.snapshots</crosses>
        <redefinitions>timeSliceOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="snapshottedOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="snapshotWithin">
          <subsetting>snapshotOf</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>timeSlicedOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SpaceSliceOf" isSufficient="true">
      <subsetting>PortionOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SpaceSliceOf asserts that its spaceSliceOccurrence extends for exactly the same time and&#xD;&#xA;&#x9;&#x9; * some or all the space of the spaceSlicedOccurrence and that the spaceSliceOccurrence is&#xD;&#xA;&#x9;&#x9; * of the same of lower innerSpaceDimension than the spaceSliceOccurrence.  Note that this&#xD;&#xA;&#x9;&#x9; * means every occurrence is a SpaceSliceOf itself and SpaceSliceOf is transitive.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="spaceSliceOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>spaceSlicedOccurrence.spaceSlices</crosses>
        <redefinitions>portionOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="spaceSlicedOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="spaceSliceWithin">
          <subsetting>spaceSliceOf</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>portionedOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SpaceShotOf" isSufficient="true">
      <subsetting>SpaceSliceOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SpaceShotOf asserts that its spaceShotOccurrence is of a lower inner space dimension than&#xD;&#xA;&#x9;&#x9; * it spaceShottedOccurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="spaceShotOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>spaceShottedOccurrence.spaceShots</crosses>
        <redefinitions>spaceSliceOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="spaceShottedOccurrence" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="spaceShotWithin">
          <subsetting>spaceSliceOf</subsetting>
        </crossingFeature>
        <typings>Occurrence</typings>
        <redefinitions>spaceSlicedOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="Without" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <unioning>HappensBefore</unioning>
      <unioning>OutsideOf</unioning>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Without is the most general association that asserts complete separation (no overlap) in&#xD;&#xA;&#x9;&#x9; * either space or time, or both, between two occurrences.  That is, no four dimensional&#xD;&#xA;&#x9;&#x9; * points are in both occurrences. Note that this means no Occurrence is Without itself.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="separateOccurrenceToo" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateOccurrence.withoutOccurrences</crosses>
        <redefinitions>BinaryLink::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="separateOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateOccurrenceToo.withoutOccurrences</crosses>
        <redefinitions>BinaryLink::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="HappensBefore" isSufficient="true">
      <subsetting>HappensLink</subsetting>
      <subsetting>Without</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * HappensBefore asserts that the earlierOccurrence is completely separated in time (not&#xD;&#xA;&#x9;&#x9; * necessarily in space, see OutsideOf), with the earlierOccurrence happening completely&#xD;&#xA;&#x9;&#x9; * before the laterOccurrence.&#x9;That is, no snapshot of the earlierOccurrence happens at the&#xD;&#xA;&#x9;&#x9; * same time as any snapshot of the laterOccurrence, with all snapshots of earlierOccurrence&#xD;&#xA;&#x9;&#x9; * happening before those the laterOccurrence, including the endShot of the earlierOccurrence&#xD;&#xA;&#x9;&#x9; * and startShot of the laterOccurrence. Note that this means no Occurrence HappensBefore&#xD;&#xA;&#x9;&#x9; * itself.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="earlierOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>laterOccurrence.predecessors</crosses>
        <redefinitions>sourceOccurrence</redefinitions>
        <redefinitions>separateOccurrenceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="laterOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>earlierOccurrence.successors</crosses>
        <redefinitions>targetOccurrence</redefinitions>
        <redefinitions>separateOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="HappensJustBefore" isSufficient="true">
      <subsetting>HappensBefore</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * HappensJustBefore is HappensBefore asserting that there is no possibility of another&#xD;&#xA;&#x9;&#x9; * occurrences happening in the time between the earlierOccurrence and laterOccurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>laterOccurrence.immediatePredecessors</crosses>
        <redefinitions>earlierOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>earlierOccurrence.immediateSuccessors</crosses>
        <redefinitions>laterOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="happensBeforeLinks" MultiLow="0" MultiHigh="*" isNonunique="true" isSufficient="true" isFeature="true">
      <typings>HappensBefore</typings>
      <subsetting>binaryLinks</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * happensBeforeLinks is a specialization of binaryLinks restricted to type HappensBefore.&#xD;&#xA;&#x9;&#x9; * It is the default subsetting for succession connectors.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="earlierOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>HappensBefore::earlierOccurrence</redefinitions>
        <redefinitions>binaryLinks::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="laterOccurrence" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>HappensBefore::laterOccurrence</redefinitions>
        <redefinitions>binaryLinks::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="OutsideOf" isSufficient="true">
      <subsetting>SpaceLink</subsetting>
      <subsetting>Without</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * OutsideOf asserts that two occurrences do not overlap in space (not necessarily in time,&#xD;&#xA;&#x9;&#x9; * see HappensBefore).&#x9;That is, no four dimensional points of the occurrences are in the&#xD;&#xA;&#x9;&#x9; * spatial extent of both of them. This means no Occurrence is OutsideOf itself.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="separateSpaceToo" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateSpace.outsideOfOccurrences</crosses>
        <redefinitions>sourceOccurrence</redefinitions>
        <redefinitions>separateOccurrenceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="separateSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateSpaceToo.outsideOfOccurrences</crosses>
        <redefinitions>targetOccurrence</redefinitions>
        <redefinitions>separateOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="JustOutsideOf" isSufficient="true">
      <subsetting>OutsideOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * JustOutsideOf is an OutsideOf asserting that two occurrences have some space slices with&#xD;&#xA;&#x9;&#x9; * no space between them.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateSpace.justOutsideOfOccurrences</crosses>
        <redefinitions>separateSpaceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>separateSpaceToo.justOutsideOfOccurrences</crosses>
        <redefinitions>separateSpace</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="MatesWith" isSufficient="true">
      <subsetting>JustOutsideOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * MatesWith is an OutsideOf asserting that two occurrences have no space between them.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="matingSpaceToo" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>matingSpace.matingOccurrences</crosses>
        <redefinitions>separateSpaceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="matingSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>matingSpaceToo.matingOccurrences</crosses>
        <redefinitions>separateSpace</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="InnerSpaceOf" isSufficient="true">
      <subsetting>OutsideOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * InnerSpaceOf is an OutsideOf asserting that the space surrounded by an inner space boundary&#xD;&#xA;&#x9;&#x9; * of one occurrence (outer space) is completely occupied by another occurrence (inner space).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="outerSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>separateSpaceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="innerSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>outerSpace.innerSpaceOccurrences</crosses>
        <redefinitions>separateSpace</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="SurroundedBy" isSufficient="true">
      <subsetting>OutsideOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SurroundedBy is an OutsideOf asserting that one occurrence (surrounded space) is included&#xD;&#xA;&#x9;&#x9; * in space by an inner space occurrence of another (surrounding space).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="surroundedSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>separateSpaceToo</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="surroundingSpace" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <crosses>surroundedSpace.surroundedByOccurrences</crosses>
        <redefinitions>separateSpace</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Occurrences.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Performances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Performances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines classifiers and features that related to the typing of performances and evaluations.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::things"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::occurrences"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links::BinaryLink"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::Transfer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::transfers"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::TransferBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::transfersBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="Performance">
      <subsetting>Occurrence</subsetting>
      <disjoining>Object</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Performance is the most general class of behavioral Occurrences that may be performed over time.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true" isSemicolon="true">
        <typings>Performance</typings>
        <redefinitions>Occurrence::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="involvedObjects" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Objects that are involved in this Performance.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="performers" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Object</typings>
        <subsetting>involvedObjects</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Objects that enact this Performance.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="true" isFeature="true" isSemicolon="true">
        <redefinitions>isDispatch</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="thisPerformance" isFeature="true" isSemicolon="true">
        <redefinitions>dispatchScope</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="enclosedPerformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>performances</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <intersecting>performances</intersecting>
        <intersecting>timeEnclosedOccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * timeEnclosedOccurrences of this Performance that are also Performances.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="thisPerformance" MultiLow="1" isDefault="true" valuePart="self" isFeature="true">
        <typings>Performance</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Defaults to the root of the subperformance composition tree.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="self"/>
        <connectorPart MultiLow="1" refElement="thisPerformance"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" isComposite="true" declaredName="subperformances" MultiLow="0" MultiHigh="*">
        <typings>Performance</typings>
        <subsetting>enclosedPerformances</subsetting>
        <subsetting>suboccurrences</subsetting>
        <intersecting>enclosedPerformances</intersecting>
        <intersecting>suboccurrences</intersecting>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * enclosedPerformances that are composite. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Performance).this" isFeature="true">
          <redefinitions>this</redefinitions>
          <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * The default &quot;this&quot; context of a subperformance is the same as that of its owning Performance.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * This means that the context for any Performance that is in a composition tree rooted&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * in a Performance that is not itself owned by an Object is the root Performance. If the&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * root Performance is an ownedPerformance of an Object, then that Object is the context.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="(that as Performance).thisPerformance" isFeature="true" isSemicolon="true">
          <redefinitions>thisPerformance</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="Evaluation">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Evaluation is the most general class of functions that may be evaluated to compute&#xD;&#xA;&#x9;&#x9; * a result.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Predicate" isAbstract="true" declaredName="BooleanEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * BooleanEvaluation is a specialization of Evaluation that is the most general class of&#xD;&#xA;&#x9;&#x9; * Predicates that may be evaluated to produce a Boolean truth value.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="MetadataAccessEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * MetadataAccessEvaluation is a specialization of Evaluation for the case of MetadataAccessExpressions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" MultiHigh="*" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LiteralEvaluation is a specialization of Evaluation for the case of LiteralExpressions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Predicate" isAbstract="true" declaredName="LiteralBooleanEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <subsetting>BooleanEvaluation</subsetting>
      <intersecting>LiteralEvaluation</intersecting>
      <intersecting>BooleanEvaluation</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LiteralBooleanEvaluation is a specialization of LiteralEvaluation for the case of LiteralBooleans.&#xD;&#xA;&#x9;&#x9; * It is also a predicate and thus a specialization of BooleanEvaluation. &#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralIntegerEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LiteralIntegerEvaluation is a specialization of LiteralEvaluation for the case of LiteralIntegers.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Integer</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralRationalEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LiteralRationalEvaluation is a specialization of LiteralEvaluation for the case of LiteralRationals.&#xD;&#xA;&#x9;&#x9; * (Note: Return type is Real to allow easy type conformance of LiteralRationals when a Real result is expected.)&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="LiteralStringEvaluation">
      <subsetting>LiteralEvaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * LiteralStringEvaluation is a specialization of LiteralEvaluation for the case of LiteralStrings.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="NullEvaluation">
      <subsetting>Evaluation</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * NullEvaluation is a specialization of Evaluation for the case of NullExpressions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="0" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="InvolvedIn" isSufficient="true">
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * InvolvedIn asserts that the involvedObject is involved in the Behavior carried out by the &#xD;&#xA;&#x9;&#x9; * involvingPerformance.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="involvedObject" isFeature="true" isSemicolon="true">
        <typings>Object</typings>
        <crosses>involvingPerformance.involvedObjects</crosses>
        <redefinitions>source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="involvingPerformance" isFeature="true" isSemicolon="true">
        <typings>Performance</typings>
        <crosses>involvedObject.involvingPerformances</crosses>
        <redefinitions>target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Association" declaredName="Performs" isSufficient="true">
      <subsetting>InvolvedIn</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Performs asserts that the performer enacts the Behavior carried out by the performance.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="performerObject" isFeature="true" isSemicolon="true">
        <typings>Object</typings>
        <crosses>performance.performers</crosses>
        <redefinitions>involvedObject</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="performance" isFeature="true" isSemicolon="true">
        <typings>Performance</typings>
        <crosses>performerObject.enactedPerformances</crosses>
        <redefinitions>involvingPerformance</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="performances" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Performance</typings>
      <subsetting>occurrences</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * performances is the most general feature for performances of Behaviors.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="evaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Evaluation</typings>
      <subsetting>performances</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * evaluations is a specialization of performances for evaluations of Functions.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="constructorEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * constructorEvaluations is a specialization of evaluations that restricts the multiplicity &#xD;&#xA;&#x9;     * of its result parameter to 1..1, requiring a constructorEvaluation to result in a single value.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="result" MultiLow="1" MultiHigh="1" isSemicolon="true"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="booleanEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>BooleanEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * booleanEvaluations is a specialization of evaluations restricted to type BooleanEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="trueEvaluations">
      <subsetting>booleanEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * trueEvaluations is a subset of booleanEvaluations that result in true. It is the most general&#xD;&#xA;&#x9;&#x9; * feature of invariants that are not negated. &#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="trueValue" valuePart="true" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="result"/>
        <connectorPart refElement="trueValue"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="falseEvaluations">
      <subsetting>booleanEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * falseEvaluations is a subset of booleanEvaluations that result in false. It is the most general&#xD;&#xA;&#x9;&#x9; * feature of invariants that are negated.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="falseValue" valuePart="false" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="result"/>
        <connectorPart refElement="falseValue"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="metadataAccessEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>MetadataAccessEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * metadataAccessEvaluations is a specialization of evaluations restricted to type MetadataAccessEvaluation. &#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * literalEvaluations is a specialization of evaluations restricted to type LiteralEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalBooleanEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralBooleanEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <subsetting>booleanEvaluations</subsetting>
      <intersecting>literalEvaluations</intersecting>
      <intersecting>booleanEvaluations</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * literaBooleanlEvaluations is a specialization of literalEvaluations and booleanEvaluations restricted &#xD;&#xA;&#x9;&#x9; * to type LiteralBooleanEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalIntegerEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralIntegerEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * literalEvaluations is a specialization of evaluations restricted to type LiteralEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalRationalEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralRationalEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * literalRationalEvaluations is a specialization of literalEvaluations restricted to type LiteralRationalEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="literalStringEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LiteralStringEvaluation</typings>
      <subsetting>literalEvaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * literalStringEvaluations is a specialization of literalEvaluations restricted to type LiteralStringEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:ExpressionClass" isAbstract="true" declaredName="nullEvaluations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>NullEvaluation</typings>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * nullEvaluations is a specialization of evaluations restricted to type NullEvaluation.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Performances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: SpatialFrames.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="SpatialFrames" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;     * This package models spatial frames of reference for quantifying the position of points &#xD;&#xA;     * in a three-dimensional space. &#xD;&#xA;     */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Clocks" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::NumericalValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="VectorValues::ThreeVectorValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="VectorValues::CartesianThreeVectorValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="VectorFunctions::isZeroVector"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Life"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Body"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Point"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:Structure" visibility="private" declaredName="DefaultFrameLife" MultiLow="1">
      <subsetting>SpatialFrame</subsetting>
      <subsetting>Life</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * DefaultFrameLife is the classifier of the singleton Life of the defaultFrame.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Feature" declaredName="defaultFrame" MultiLow="1" isFeature="true">
      <typings>DefaultFrameLife</typings>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * defaultFrame is a fixed SpatialFrame used as a universal default.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="SpatialFrame">
      <subsetting>Body</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * A SpatialFrame is a three-dimensional Body that provides a spatial extent that &#xD;&#xA;         * acts as a frame of reference for defining the physical position and displacement &#xD;&#xA;         * vectors of Points over time.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="PositionOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The PositionOf a Point relative to a SpatialFrame, at a specific time relative to a given&#xD;&#xA;         * Clock, as a positionVector that is a ThreeVectorValue.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="time" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isDefault="true" valuePart="defaultFrame" isSemicolon="true">
        <typings>SpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="positionVector" MultiLow="1" isSemicolon="true">
        <typings>ThreeVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="positionTimePrecondition">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The given point must exist at the given time.&#xD;&#xA;             */"/>
        <resultExpressionParameter resultExpression="TimeOf(point.startShot) &lt;= time and time &lt;= TimeOf(point.endShot)"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="spacePositionConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The result positionVector is equal to the PositionOf the Point spaceShot of the&#xD;&#xA;             * frame that encloses the given point, at the given time.&#xD;&#xA;             */"/>
        <resultExpressionParameter resultExpression="(frame.spaceShots as Point)->forAll{in p : Point; p.spaceTimeEnclosedOccurrences->includes(point) implies positionVector == PositionOf(p, time, frame) }"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="CurrentPositionOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The CurrentPositionOf a Point relative to a SpatialFrame and a Clock is the PositionOf&#xD;&#xA;         * the Point relative to the SpatialFrame at the currentTime of the Clock.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isDefault="true" valuePart="defaultFrame" isSemicolon="true">
        <typings>SpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="positionVector" MultiLow="1" valuePart="PositionOf(point, clock.currentTime, frame, clock)" isSemicolon="true">
        <typings>ThreeVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="DisplacementOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The DisplacementOf two Points relative to a SpatialFrame, at a specific time relative to a&#xD;&#xA;         * given Clock, is the displacementVector computed as the difference between the PositionOf the &#xD;&#xA;         * first Point and PositionOf the second Point, relative to that SpatialFrame, at that time.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point1" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point2" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="time" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isDefault="true" valuePart="defaultFrame" isSemicolon="true">
        <typings>SpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="displacementVector" MultiLow="1" valuePart="PositionOf(point2, time, frame, clock) - PositionOf(point1, time, frame, clock)" isSemicolon="true">
        <typings>ThreeVectorValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" declaredName="zeroDisplacementConstraint">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * If either point1 or point2 occurs within the other, then the displacementVector is&#xD;&#xA;         * the zero vector.&#xD;&#xA;         */"/>
        <resultExpressionParameter resultExpression="(point1.spaceTimeEnclosedOccurrences->includes(point2) or point2.spaceTimeEnclosedOccurrences->includes(point1) ) implies isZeroVector(displacementVector)"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="CurrentDisplacementOf">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The CurrentDisplacementOf two Points relative to a SpatialFrame and Clock is the DisplacementOf&#xD;&#xA;         * the Points relative to the SpatialFrame at the currentTime of the Clock.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point1" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point2" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isDefault="true" valuePart="defaultFrame" isSemicolon="true">
        <typings>SpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="displacementVector" MultiLow="1" valuePart="DisplacementOf(point1, point2, clock.currentTime, frame, clock)" isSemicolon="true">
        <typings>ThreeVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Structure" isAbstract="true" declaredName="CartesianSpatialFrame">
      <subsetting>SpatialFrame</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * A CartesianSpatialFrame is a SpatialFrame relative to which all position and displacement&#xD;&#xA;         * vectors can be represented as CartesianThreeVectorValues.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="CartesianPositionOf">
      <subsetting>PositionOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The PositionOf a Point relative to a CartesianSpatialFrame is a CartesianThreeVectorValue.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="time" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isSemicolon="true">
        <typings>CartesianSpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="positionVector" MultiLow="1" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="CartesianCurrentPositionOf">
      <subsetting>CurrentPositionOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The CurrentPositionOf a Point relative to a CartesianSpatialFrame is a CartesianThreeVectorValue.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isSemicolon="true">
        <typings>CartesianSpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="positionVector" MultiLow="1" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="CartesianDisplacementOf">
      <subsetting>DisplacementOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The DisplacementOf two Points relative to a CartesianSpatialFrame is a CartesianThreeVectorValue.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point1" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point2" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="time" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isSemicolon="true">
        <typings>CartesianSpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="displacementVector" MultiLow="1" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="CartesianCurrentDisplacementOf">
      <subsetting>CurrentDisplacementOf</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * The CurrentDisplacementOf two Points relative to a CartesianSpatialFrame is a CartesianThreeVectorValue.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point1" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="point2" MultiLow="1" isSemicolon="true">
        <typings>Point</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="frame" MultiLow="1" isSemicolon="true">
        <typings>CartesianSpatialFrame</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="frame.localClock" isSemicolon="true">
        <typings>Clock</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="displacementVector" MultiLow="1" isSemicolon="true">
        <typings>CartesianThreeVectorValue</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: SpatialFrames.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: StatePerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="StatePerformances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains a library model of the semantics of state-based behavior,&#xD;&#xA;&#x9; * including the performance of (behavioral) states and the transitions between them.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="TransitionPerformances::TransitionPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::Transfer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::MessageTransfer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::DecisionPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::select"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::collect"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Behavior" declaredName="StatePerformance">
      <subsetting>DecisionPerformance</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="isTriggerDuring" isDefault="true" valuePart="true" isFeature="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="middle" MultiLow="1" MultiHigh="*">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * All modeler-defined steps must subset this.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Comment" body="/* &#xD;&#xA;&#x9;&#x9; * Note: All steps are implicitly considered to be enclosedPerformances,&#xD;&#xA;&#x9;&#x9; * and hence happening during the state performance.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Step" declaredName="entry" MultiLow="1"/>
      <elements xsi:type="kerMLOC:Step" declaredName="do" MultiLow="1">
        <subsetting>middle</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="exit" MultiLow="1"/>
      <elements xsi:type="kerMLOC:Step" declaredName="nonDoMiddle" MultiLow="*" valuePart="middle->excluding(do)">
        <subsetting>middle</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="1" refElement="entry"/>
        <connectorPart MultiLow="*" refElement="middle"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="1" refElement="do.startShot"/>
        <connectorPart MultiLow="*" refElement="nonDoMiddle.startShot"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="middle"/>
        <connectorPart MultiLow="1" refElement="exit"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="incomingTransitionTrigger" MultiLow="0" MultiHigh="1" isDefault="true" valuePart="null" isFeature="true">
        <typings>MessageTransfer</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Transfer that triggered a transition into this state performance. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" visibility="private">
        <resultExpressionParameter resultExpression="isEmpty(accepted) == isEmpty(acceptable)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="accepted" MultiLow="0" MultiHigh="1" isFeature="true">
        <typings>Transfer</typings>
        <subsetting>acceptable</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/* A transfer to the trigger target of an outgoing transition performance&#xD;&#xA;&#x9;&#x9;&#x9; * for an outgoing successon that is taken for this state occurrence.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="deferrable" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>Transfer</typings>
        <subsetting>acceptable</subsetting>
        <elements xsi:type="kerMLOC:Documentation" body="/* Transfers to trigger targets of outgoing transition performances can be&#xD;&#xA;&#x9;&#x9;&#x9; * considered for acceptance more than once.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isAbstract="true" declaredName="acceptable" MultiLow="*" isFeature="true">
        <typings>Transfer</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Transfers that might be accepted. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="thatSP" MultiLow="1" valuePart="that as StatePerformance" isFeature="true" isSemicolon="true">
          <typings>StatePerformance</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="accableT" isFeature="true" isSemicolon="true">
          <typings>Transfer</typings>
          <redefinitions>self</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="accT" valuePart="thatSP.accepted" isFeature="true" isSemicolon="true">
          <typings>Transfer</typings>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="accableT == accT | incomingTransferSort(accT, accableT)"/>
        </elements>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="isDispatch implies allSubstatePerformances(dispatchScope)->forAll{in oSP : StatePerformance; oSP == thatSP | isEmpty(oSP.accepted) | includes(thatSP.exit.startShot.successors, oSP.exit.startShot) | ( oSP.accepted != accableT &amp; ( incomingTransferSort(oSP.accepted, accableT) | includes(oSP.deferrable, accableT) ) ) }"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Function" declaredName="allSubstatePerformances">
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="p" MultiLow="1" isSemicolon="true">
          <typings>Performance</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="substatePerformances" MultiLow="*" valuePart="p.subperformances->select{in subp:Performance; subp istype StatePerformance}" isFeature="true" isSemicolon="true">
          <typings>StatePerformance</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="*" valuePart="union(substatePerformances, substatePerformances->collect{in sp:StatePerformance; allSubstatePerformances(sp) } )" isSemicolon="true">
          <typings>StatePerformance</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="acceptable"/>
        <connectorPart MultiLow="1" refElement="exit"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="this.isRunToCompletion" isFeature="true" isSemicolon="true">
        <redefinitions>isRunToCompletion</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isDefault="true" valuePart="this.runToCompletionScope" isFeature="true" isSemicolon="true">
        <redefinitions>runToCompletionScope</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isRunToCompletion implies allSubtransitionPerformances(runToCompletionScope)->forAll{in tp : TransitionPerformance; includes(tp.successors, entry) | includes(tp.predecessors, entry) }"/>
      </elements>
      <elements xsi:type="kerMLOC:Function" declaredName="allSubtransitionPerformances">
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="p" MultiLow="1" isSemicolon="true">
          <typings>Performance</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" declaredName="subtransitionPerformances" MultiLow="*" valuePart="p.subperformances->select{in subp:Performance; subp istype StateTransitionPerformance }" isFeature="true" isSemicolon="true">
          <typings>TransitionPerformance</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="*" valuePart="union(subtransitionPerformances, subtransitionPerformances->collect{in sp:TransitionPerformance; allSubtransitionPerformances(sp) } )" isSemicolon="true">
          <typings>TransitionPerformance</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="StateTransitionPerformance">
      <subsetting>TransitionPerformance</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="isTriggerDuring" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="not transitionLinkSource.isTriggerDuring | isTriggerDuring"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="transitionLinkSource" isFeature="true">
        <typings>StatePerformance</typings>
        <redefinitions>TransitionPerformance::transitionLinkSource</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>accepted</redefinitions>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>StatePerformance::acceptable</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="transitionLinkSource.nonDoMiddle"/>
        <connectorPart MultiLow="1" refElement="Performance::self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="transitionLinkTarget" MultiLow="0" MultiHigh="1" valuePart="transitionLink.laterOccurrence" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Invariant">
          <resultExpressionParameter resultExpression="(that istype StatePerformance) implies (that as StatePerformance).incomingTransitionTrigger == trigger"/>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="acceptable" MultiLow="*" isFeature="true" isSemicolon="true">
        <typings>Transfer</typings>
        <subsetting>transitionLinkSource.acceptable</subsetting>
        <subsetting>triggerTarget.incomingTransfersToSelf</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="trigger" isFeature="true">
        <subsetting>acceptable</subsetting>
        <subsetting>transitionLinkSource.accepted</subsetting>
        <redefinitions>TransitionPerformance::trigger</redefinitions>
        <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
          <redefinitions>endShot</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="tdNum" MultiLow="1" valuePart="if not isTriggerDuring ? 0 else size(trigger)" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="linkTriggerDuring" MultiLow="tdNum" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="*" refElement="trigger.endShot"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLinkSource"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private" isSufficient="true">
        <connectorPart MultiLow="*" refElement="acceptable"/>
        <connectorPart MultiLow="*" refElement="guard"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="guard"/>
        <connectorPart MultiLow="1" refElement="transitionLinkSource.exit"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="accNum" refElement="accept"/>
        <connectorPart MultiLow="1" refElement="transitionLinkSource.exit"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: StatePerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Transfers.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Transfers" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines the transfer interactions used to type flows.&#xD;&#xA;     */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Links" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::BinaryLinkObject"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::performances"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Interaction" declaredName="Transfer">
      <subsetting>Performance</subsetting>
      <subsetting>BinaryLink</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * A Transfer represents the transfer of a payload from the source of the interaction &#xD;&#xA;         * to the target of the interaction.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::source</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The entity whose output is the source of the payload to be transferred.&#xD;&#xA;             */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="sourceOutput" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>Anything</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true">
        <typings>Occurrence</typings>
        <redefinitions>BinaryLink::target</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The entity whose input is the target of the payload to be transferred.&#xD;&#xA;             */"/>
        <elements xsi:type="kerMLOC:Feature" declaredName="targetInput" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true">
          <typings>Anything</typings>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isInstant" MultiLow="1" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isInstance is true, then the transfer is instantaneous.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="payload" MultiLow="1" MultiHigh="*" isFeature="true">
        <typings>Anything</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The things that are to be transferred.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="payloadNum" MultiLow="1" valuePart="size(payload)" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="instantNum" MultiLow="1" valuePart="if isInstant? 1 else 0" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" visibility="private" declaredName="instant" MultiLow="instantNum" isOf="true">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="startShot"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="endShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isInstant is true, then the start and end of the transfer happen at the same time.&#xD;&#xA;             */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Interaction" declaredName="MessageTransfer">
      <subsetting>Transfer</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * A MessageTransfer is a Transfer that does not specify where the payload is picked&#xD;&#xA;         * up and dropped off (see FlowTransfer). They are sent by SendPerformances and&#xD;&#xA;         * accepted by AcceptPerformances.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Interaction" declaredName="FlowTransfer">
      <subsetting>Transfer</subsetting>
      <disjoining>MessageTransfer</disjoining>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * A FlowTransfer is a Transfer identifying an output feature of the source from which&#xD;&#xA;         * to pick up a payload and an input feature of the target to which to drop it off. They can&#xD;&#xA;         * start when the payload is available at the source and move or copy it to the target.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="isMove" MultiLow="1" isDefault="true" valuePart="true" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isMove is true, then the entire payload leaves the source at the start&#xD;&#xA;             * of the transfer.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="isPush" MultiLow="1" isDefault="true" valuePart="true" isFeature="true">
        <typings>Boolean</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isPush is true, then the transfer begins when the payload is available&#xD;&#xA;             * at the source.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="sourceOutputLink" MultiLow="payloadNum">
        <typings>BinaryLinkObject</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The output of the payloads from the sourceOutput.&#xD;&#xA;             */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="transferSource" isFeature="true" isSemicolon="true">
          <crossingFeature MultiLow="1"/>
          <references>source</references>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="transferPayload" isFeature="true" isSemicolon="true">
          <crossingFeature MultiLow="payloadNum"/>
          <subsetting>transferSource.sourceOutput</subsetting>
          <references>payload</references>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" declaredName="targetInputLink" MultiLow="payloadNum">
        <typings>BinaryLinkObject</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The input of the payload to the targetInput.&#xD;&#xA;             */"/>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="transferTarget" isFeature="true" isSemicolon="true">
          <crossingFeature MultiLow="1"/>
          <references>target</references>
        </elements>
        <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="transferPayload" isFeature="true" isSemicolon="true">
          <crossingFeature MultiLow="payloadNum"/>
          <subsetting>transferTarget.targetInput</subsetting>
          <references>payload</references>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="sending" MultiLow="payloadNum" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="1" refElement="startShot"/>
        <connectorPart MultiLow="payloadNum" refElement="sourceOutputLink"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The start of the transfer happens during the output of each of the payloads from the&#xD;&#xA;             * source. &#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="moving" MultiLow="0" MultiHigh="*" isFrom="true">
        <typings>HappensWhile</typings>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="sourceOutputLink.endShot"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="startShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isMove is true, then all payloads leave the source at the start&#xD;&#xA;             * of the transfer.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" visibility="private">
        <resultExpressionParameter resultExpression="isMove implies size(moving) == size(sourceOutputLink)"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="pushing" MultiLow="0" MultiHigh="*" isFrom="true">
        <typings>HappensWhile</typings>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="sourceOutputLink.startShot"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="startShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * If isPush is true, then the transfer begins when the payloads are available&#xD;&#xA;             * at the source.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="kerMLOC:Invariant" visibility="private">
        <resultExpressionParameter resultExpression="isPush implies size(pushing) == size(sourceOutputLink)"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="delivering" MultiLow="payloadNum" isFrom="true">
        <typings>HappensWhile</typings>
        <connectorPart MultiLow="payloadNum" refElement="targetInputLink.startShot"/>
        <connectorPart MultiLow="1" refElement="endShot"/>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;             * The input of each of the payloads to the target starts at the end of the transfer.&#xD;&#xA;             */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Interaction" declaredName="TransferBefore">
      <subsetting>Transfer</subsetting>
      <subsetting>HappensBefore</subsetting>
      <intersecting>Transfer</intersecting>
      <intersecting>HappensBefore</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * TransferBefore is a specialization of Transfer in which the source happens before&#xD;&#xA;         * the transfer, which happens before the target.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::source</redefinitions>
        <redefinitions>HappensBefore::earlierOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::target</redefinitions>
        <redefinitions>HappensBefore::laterOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="self" isFeature="true" isSemicolon="true">
        <typings>TransferBefore</typings>
        <redefinitions>Performance::self</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart refElement="source"/>
        <connectorPart refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart refElement="self"/>
        <connectorPart refElement="target"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Interaction" declaredName="FlowTransferBefore">
      <subsetting>TransferBefore</subsetting>
      <subsetting>FlowTransfer</subsetting>
      <intersecting>FlowTransfer</intersecting>
      <intersecting>TransferBefore</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * FlowTransferBefore is a FlowTransfer that is also a TransferBefore. &#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::source</redefinitions>
        <redefinitions>TransferBefore::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::target</redefinitions>
        <redefinitions>TransferBefore::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="transfers" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Transfer</typings>
      <subsetting>performances</subsetting>
      <subsetting>binaryLinks</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * transfers is a specialization of performances and binaryLinks restricted to type &#xD;&#xA;         * Transfer.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::source</redefinitions>
        <redefinitions>binaryLinks::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>Transfer::target</redefinitions>
        <redefinitions>binaryLinks::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="messageTransfers" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>MessageTransfer</typings>
      <subsetting>transfers</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * messageTransfers is a specialization of transfers restricted to type MessageTransfers.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>MessageTransfer::source</redefinitions>
        <redefinitions>transfers::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>MessageTransfer::target</redefinitions>
        <redefinitions>transfers::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Flow" isAbstract="true" declaredName="flowTransfers" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>FlowTransfer</typings>
      <subsetting>transfers</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * flowTransfers is a specialization of transfers restricted to type FlowTransfers.&#xD;&#xA;         * It is the default subsetting for non-succession flows.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>FlowTransfer::source</redefinitions>
        <redefinitions>transfers::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>FlowTransfer::target</redefinitions>
        <redefinitions>transfers::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Flow" isAbstract="true" declaredName="transfersBefore" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>TransferBefore</typings>
      <subsetting>transfers</subsetting>
      <subsetting>happensBeforeLinks</subsetting>
      <intersecting>transfers</intersecting>
      <intersecting>happensBeforeLinks</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * transfersBefore is a specialization of transfers and happensBeforeLinks restricted to&#xD;&#xA;         * type TransferBefore.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>TransferBefore::source</redefinitions>
        <redefinitions>transfers::source</redefinitions>
        <redefinitions>happensBeforeLinks::earlierOccurrence</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>TransferBefore::target</redefinitions>
        <redefinitions>transfers::target</redefinitions>
        <redefinitions>happensBeforeLinks::laterOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Flow" isAbstract="true" declaredName="flowTransfersBefore" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>FlowTransferBefore</typings>
      <subsetting>flowTransfers</subsetting>
      <subsetting>transfersBefore</subsetting>
      <intersecting>flowTransfers</intersecting>
      <intersecting>transfersBefore</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * flowTransfersBefore is a specialization of flowTransfers and transfersBefore that is restricted&#xD;&#xA;         * to type FlowTransferBefore. IT is the default subsetting for succession flows.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="source" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>FlowTransferBefore::source</redefinitions>
        <redefinitions>flowTransfers::source</redefinitions>
        <redefinitions>transfersBefore::source</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="target" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
        <redefinitions>FlowTransferBefore::target</redefinitions>
        <redefinitions>flowTransfers::target</redefinitions>
        <redefinitions>transfersBefore::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="SendPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * SendPerformances are Performance that require an outgoingTransferFromSelf &#xD;&#xA;         * from a designated sender Occurrence carrying a given payload, optionally to a designated receiver.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="payload" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="sender" MultiLow="1" isDefault="true" valuePart="this" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="receiver" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="sentTransfer" MultiLow="1" isFeature="true">
        <typings>MessageTransfer</typings>
        <subsetting>sender.outgoingTransfersFromSelf</subsetting>
        <elements xsi:type="kerMLOC:Feature" valuePart="SendPerformance::payload" isFeature="true" isSemicolon="true">
          <redefinitions>payload</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="receiver.incomingTransfersToSelf"/>
        <connectorPart MultiLow="1" refElement="sentTransfer"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart refElement="self"/>
        <connectorPart refElement="sentTransfer"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="AcceptPerformance">
      <subsetting>Performance</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * AcceptPerformance is a performance that requires an incomingTransferToSelf&#xD;&#xA;         * of a desigated receiver Occurrence, providing its payload as output.&#xD;&#xA;         */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="payload" MultiLow="0" MultiHigh="*" isFeature="true" isSemicolon="true"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="receiver" MultiLow="1" isDefault="true" valuePart="this" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="acceptedTransfer" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>MessageTransfer</typings>
        <subsetting>receiver.incomingTransfersToSelf</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Succession">
        <connectorPart refElement="acceptedTransfer"/>
        <connectorPart refElement="self.endShot"/>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="payload"/>
        <connectorPart refElement="acceptedTransfer.payload"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="sendPerformances" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>SendPerformance</typings>
      <subsetting>performances</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * sendPerformances is a specialization of performances for SendPerformances.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="kerMLOC:Step" isAbstract="true" declaredName="acceptPerformances" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>AcceptPerformance</typings>
      <subsetting>performances</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;         * acceptPerformances is a specialization of performances for AcceptPerformances.&#xD;&#xA;         */"/>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Transfers.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: TransitionPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="TransitionPerformances" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains a library model of the semantics of conditional transitions between occurrences, &#xD;&#xA;&#x9; * including the performance of specified Behaviors when the transition occurs.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensBefore"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Performances::Evaluation"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::MessageTransfer"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::AcceptPerformance"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Transfers::acceptPerformances"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::allTrue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:Behavior" isAbstract="true" declaredName="TransitionPerformance">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="transitionLinkSource" MultiLow="1" isFeature="true" isSemicolon="true">
        <typings>Performance</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="trigger" MultiLow="*" isFeature="true" isSemicolon="true">
        <typings>MessageTransfer</typings>
      </elements>
      <elements xsi:type="kerMLOC:BooleanExpression" declaredName="guard" MultiLow="*">
        <subsetting>enclosedPerformances</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="effect" MultiLow="*">
        <subsetting>enclosedPerformances</subsetting>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="triggerTarget" MultiLow="1" isDefault="true" valuePart="this" isFeature="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="transitionLink" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
        <typings>HappensBefore</typings>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector" visibility="private">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLink.earlierOccurrence"/>
        <connectorPart MultiLow="1" refElement="transitionLinkSource"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="1" refElement="transitionLinkSource"/>
        <connectorPart MultiLow="*" refElement="effect"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="effect"/>
        <connectorPart MultiLow="1" refElement="transitionLink.laterOccurrence"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLink"/>
        <connectorPart MultiLow="1" MultiHigh="*" refElement="trigger"/>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="guardConstraint" MultiLow="*" isSufficient="true" isFrom="true">
        <typings>TPCGuardConstraint</typings>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLink"/>
        <connectorPart MultiLow="*" refElement="guard"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private" isSufficient="true">
        <connectorPart MultiLow="*" refElement="trigger"/>
        <connectorPart MultiLow="*" refElement="guard"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private" isSufficient="true">
        <connectorPart MultiLow="*" refElement="guard"/>
        <connectorPart MultiLow="*" refElement="effect"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="accNum" MultiLow="1" valuePart="if isEmpty(trigger) ? 0 else 1" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" declaredName="accept" MultiLow="accNum">
        <typings>AcceptPerformance</typings>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <subsetting>acceptPerformances</subsetting>
        <elements xsi:type="kerMLOC:Feature" valuePart="trigger" isFeature="true" isSemicolon="true">
          <redefinitions>acceptedTransfer</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="kerMLOC:BindingConnector">
        <connectorPart refElement="accept.receiver"/>
        <connectorPart refElement="triggerTarget"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="*" refElement="guard"/>
        <connectorPart MultiLow="accNum" refElement="accept"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="NonStateTransitionPerformance">
      <subsetting>TransitionPerformance</subsetting>
      <elements xsi:type="kerMLOC:Feature" declaredName="isTriggerAfter" isDefault="true" valuePart="true" isFeature="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart MultiLow="1" refElement="transitionLinkSource"/>
        <connectorPart MultiLow="1" refElement="Performance::self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="taNum" MultiLow="1" valuePart="if isTriggerAfter ? size(trigger) else 0" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private" declaredName="triggerAfter" MultiLow="taNum" isFirst="true">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLinkSource"/>
        <connectorPart MultiLow="*" refElement="trigger.endShot"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private" isSufficient="true">
        <connectorPart MultiLow="*" refElement="guard"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="transitionLink.laterOccurrence"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:AssociationStructure" declaredName="TPCGuardConstraint">
      <elements xsi:type="kerMLOC:Feature" isEnd="true" declaredName="constrainedHBLink" isFeature="true" isSemicolon="true">
        <crossingFeature declaredName="guardedLink" MultiLow="0" MultiHigh="1"/>
        <typings>HappensBefore</typings>
      </elements>
      <elements xsi:type="kerMLOC:BooleanExpression" isEnd="true" declaredName="constrainedGuard"/>
      <elements xsi:type="kerMLOC:Invariant" visibility="private">
        <resultExpressionParameter resultExpression="allTrue(constrainedGuard())"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: TransitionPerformances.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Triggers.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Triggers" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains functions that return ChangeSignals for triggering&#xD;&#xA;&#x9; * when a Boolean condition changes from false to true, at a specific time&#xD;&#xA;&#x9; * or after a specific time delay.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::NumericalValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="Clocks" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="Observation" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Structure" declaredName="TimeSignal">
      <subsetting>ChangeSignal</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TimeSignal is a ChangeSignal whose condition is the currentTime&#xD;&#xA;&#x9;&#x9; * of a given Clock reaching a specific signalTime.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="signalTime" MultiLow="1" isFeature="true">
        <typings>NumericalValue</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The time at which the TimeSignal should be sent.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="signalClock" MultiLow="1" isFeature="true">
        <typings>Clock</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Clock whose currentTime is being monitored.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:BooleanExpression" visibility="private">
        <redefinitions>signalCondition</redefinitions>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Boolean condition of the currentTime of the signalClock being&#xD;&#xA;&#x9;&#x9;&#x9; * equal to the signalTime.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <resultExpressionParameter resultExpression="signalClock.currentTime == signalTime"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="TriggerWhen">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * TriggerWhen returns a monitored ChangeSignal for a given condition,&#xD;&#xA;&#x9;&#x9; * to be sent to a given receiver when the condition occurs.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:BooleanExpression" direction="in" declaredName="condition" MultiLow="1">
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The BooleanExpression to be monitored for changing from &#xD;&#xA;&#x9;&#x9;&#x9; * false to true.&#xD;&#xA;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="receiver" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Occurrence to which the ChangeSignal is to be sent.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" MultiLow="1" isDefault="true" valuePart="defaultMonitor" isFeature="true">
        <typings>ChangeMonitor</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ChangeMonitor to be used to monitor the ChangeSignal condition.&#xD;&#xA;&#x9;&#x9;&#x9; * The default is the Observation::defaultMonitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="changeSignal" MultiLow="1" valuePart="new ChangeSignal(condition, monitor)" isFeature="true">
        <typings>ChangeSignal</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ChangeSignal for the condition, as monitored by the monitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step">
        <subsetting>monitor.startObservation</subsetting>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" valuePart="receiver" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" valuePart="changeSignal" isSemicolon="true"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="TriggerAt">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * TriggerAt returns a monitored TimeSignal to be sent to a receiver when&#xD;&#xA;&#x9;&#x9; * the currentTime of a given Clock reaches a specific timeInstant. &#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="timeInstant" MultiLow="1" isFeature="true">
        <typings>NumericalValue</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The time instant, relative to the clock, at which the TimeSignal should be sent. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="receiver" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Occurrence to which the TimeSignal is to be sent.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="localClock" isFeature="true">
        <typings>Clock</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Clock to be used as the reference for the timeInstant. The default is&#xD;&#xA;&#x9;&#x9;&#x9; * the localClock, which will be bound when the function is invoked. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" MultiLow="1" isDefault="true" valuePart="defaultMonitor" isFeature="true">
        <typings>ChangeMonitor</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ChangeMonitor to be used to monitor the TimeSignal condition.&#xD;&#xA;&#x9;&#x9;&#x9; * The default is the Observation::defaultMonitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="timeSignal" MultiLow="1" valuePart="new TimeSignal(timeInstant, clock, monitor)" isFeature="true">
        <typings>TimeSignal</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The TimeSignal for the given timeInstant, as monitored by the monitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Step">
        <subsetting>monitor.startObservation</subsetting>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="observer" valuePart="receiver" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="signal" valuePart="timeSignal" isSemicolon="true"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="TriggerAfter">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * TriggerAfter returns a monitored TimeSignal to be sent to a receiver after&#xD;&#xA;&#x9;&#x9; * a certain time delay relative to a given Clock.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="delay" MultiLow="1" isFeature="true">
        <typings>NumericalValue</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The time duration, relative to the clock, after which the TimeSignal is sent.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="receiver" MultiLow="1" isFeature="true">
        <typings>Occurrence</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Occurrence to which the TimeSignal is to be sent.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="clock" MultiLow="1" isDefault="true" valuePart="localClock" isFeature="true">
        <typings>Clock</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Clock to be used as the reference for the time delay. The default is&#xD;&#xA;&#x9;&#x9;&#x9; * the localClock, which will be bound when the function is invoked. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="monitor" MultiLow="1" isDefault="true" valuePart="defaultMonitor" isFeature="true">
        <typings>ChangeMonitor</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ChangeMonitor to be used to monitor the TimeSignal condition.&#xD;&#xA;&#x9;&#x9;&#x9; * The default is the Observation::defaultMonitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" declaredName="signal" MultiLow="1" valuePart="TriggerAt(clock.currentTime + delay, receiver, clock, monitor)">
        <typings>TimeSignal</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The TimeSignal for the currentTime of the clock when the function is invoked&#xD;&#xA;&#x9;&#x9;&#x9; * plus the given time delay, as monitored by the monitor.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Triggers.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Kernel Semantic Library.kerml =====&#xD;&#xA;"/>
</kerMLOC:RootNamespace>
