  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: NumericalFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="NumericalFunctions" isStandard="true" isLibrary="true">
