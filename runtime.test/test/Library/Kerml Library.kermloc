        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'&lt;='">
      <subsetting>ScalarFunctions::'&lt;='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'>='">
      <subsetting>ScalarFunctions::'>='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="max">
      <subsetting>ScalarFunctions::max</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="min">
      <subsetting>ScalarFunctions::min</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="sum">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="product">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="sum0">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>NumericalValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="zero" MultiLow="1" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isZero(zero)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" valuePart="collection->reduce '+' ?? zero" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="product1">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="collection" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="one" MultiLow="1" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="isUnit(one)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" valuePart="collection->reduce '*' ?? one" isSemicolon="true">
        <typings>ScalarValue</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: NumericalFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: OccurrenceFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="OccurrenceFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines utility functions that operate on occurrences, primarily related to &#xD;&#xA;&#x9; * time during which those occurrences exist.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::add"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::addAt"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::remove"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::removeAt"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'==='">
      <subsetting>BaseFunctions::'==='</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Test whether two occurrences are portions of the same life. That is, whether they &#xD;&#xA;&#x9;&#x9; * represent different portions of the same entity (colloquially, whether they have&#xD;&#xA;&#x9;&#x9; * the same &quot;identity&quot;).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="x.portionOfLife == y.portionOfLife" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isDuring">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Test whether a performance of this function happens during the input occurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="occ" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" declaredName="during" MultiLow="0" MultiHigh="1" isSufficient="true" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart refElement="self"/>
        <connectorPart refElement="occ"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="notEmpty(during)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="create">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Ensure that the start of a given occurrence happens during a performance of this&#xD;&#xA;&#x9;&#x9; * function. The occurrence is also returned from the function.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart refElement="occ.startShot"/>
        <connectorPart refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="destroy">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Ensure that the end of a given occurrence happens during a performance of this&#xD;&#xA;&#x9;&#x9; * function. The occurrence is also returned from the function.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Connector" visibility="private" isFrom="true">
        <typings>HappensDuring</typings>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="occ.endShot"/>
        <connectorPart refElement="self"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="occ" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="addNew">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Add a newly created occurrence to the given group of occurrences and return the&#xD;&#xA;&#x9;&#x9; * new occurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true">
        <typings>add</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq1" valuePart="group" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" valuePart="create(occ)" isSemicolon="true"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="addNewAt">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Add a newly created occurrence to the given ordered group of occurrences at the given&#xD;&#xA;&#x9;&#x9; * index and return the new occurrence.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true">
        <typings>addAt</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" valuePart="group" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" valuePart="create(occ)" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="startIndex" valuePart="index" isSemicolon="true"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="occ" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Behavior" declaredName="removeOld">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Remove a given occurrence from a group of occurrences and destroy it.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="group" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="removeStep">
        <typings>remove</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="seq" valuePart="group" isSemicolon="true"/>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" valuePart="occ" isSemicolon="true"/>
      </elements>
      <elements xsi:type="kerMLOC:Succession" visibility="private">
        <connectorPart refElement="removeStep"/>
        <connectorPart refElement="destroyStep"/>
      </elements>
      <elements xsi:type="kerMLOC:Step" visibility="private" isComposite="true" declaredName="destroyStep">
        <typings>destroy</typings>
        <elements xsi:type="kerMLOC:Feature" direction="inout" declaredName="occ" valuePart="removeOld::occ" isSemicolon="true"/>
