<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Kernel Data Type Library.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Collections.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="Collections" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines a standard set of Collection data types. Unlike sequences of values &#xD;&#xA;&#x9; * defined directly using multiplicity, these data types allow for the possibility of collections &#xD;&#xA;&#x9; * as elements of collections.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="IntegerFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="Collection">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Collection is the top level abstract supertype of all collection types.&#xD;&#xA;&#x9;&#x9; * The name elements is used to denote the members or contents of the collection.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isNonunique="true" isFeature="true" isSemicolon="true"/>
    </elements>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="OrderedCollection">
      <subsetting>Collection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * OrderedCollection is the abstract supertype for all ordered collection types.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <redefinitions>Collection::elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="UniqueCollection">
      <subsetting>Collection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * UniqueCollection is the abstract supertype for all collection types with unique elements.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isFeature="true">
        <redefinitions>Collection::elements</redefinitions>
        <elements xsi:type="kerMLOC:Comment" body="/* Note: Redefinition of 'elements' is unique by default. */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Array">
      <subsetting>OrderedCollection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * An Array is a fixed size, multi-dimensional Collection of which the elements are nonunique and ordered. &#xD;&#xA;&#x9;     * Its dimensions specify how many dimensions the array has, and how many elements there are in each dimension. &#xD;&#xA;&#x9;     * The rank is equal to the number of dimensions. The flattenedSize is equal to the total number of elements &#xD;&#xA;&#x9;     * in the array.&#xD;&#xA;&#x9;     * &#xD;&#xA;&#x9;     * Feature elements is a flattened sequence of all elements of an Array and can be accessed by a tuple of indices. &#xD;&#xA;&#x9;     * The number of indices is equal to rank. The elements are packed according to row-major convention, as in the C programming language.&#xD;&#xA;&#x9;     * &#xD;&#xA;&#x9;     * The elements of an Array can be assessed by a tuple of indices. The number of indices in such tuple is equal to rank. &#xD;&#xA;&#x9;&#x9; * The packing of the elements, i.e. the flattened representation, follows the row-major convention, &#xD;&#xA;&#x9;&#x9; * as in the C programming language.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note 1. Feature dimensions may be empty, which denotes a zero dimensional array, allowing an Array to collapse to a single element. &#xD;&#xA;&#x9;&#x9; * This is useful to allow for specialization of an Array into a type restricted to represent a scalar. &#xD;&#xA;&#x9;&#x9; * The flattenedSize of a zero dimensional array is 1.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note 2: An Array can represent the generalized mathematical concept of an infinite matrix of any rank, i.e. not limited to rank two.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="dimensions" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true">
        <typings>Positive</typings>
        <elements xsi:type="kerMLOC:Documentation" body="/* Feature `dimensions` defines the N-dimensional shape of the Array&#xD;&#xA;             * The alternative name `shape` (as used in many programming languages) is not used as it would interfere with a geometric shape feature.&#xD;&#xA; &#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="rank" MultiLow="1" valuePart="size(dimensions)" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="flattenedSize" MultiLow="1" valuePart="dimensions->reduce '*' ?? 1" isFeature="true" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Invariant">
        <resultExpressionParameter resultExpression="flattenedSize == size(elements)"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Bag">
      <subsetting>Collection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Bag is a variable-size, unordered collection of nonunique elements.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Set">
      <subsetting>UniqueCollection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Set is a variable-size, unordered collection of unique elements.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="OrderedSet">
      <subsetting>OrderedCollection</subsetting>
      <subsetting>UniqueCollection</subsetting>
      <intersecting>OrderedCollection</intersecting>
      <intersecting>UniqueCollection</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * OrderedSet is a variable-size, ordered collection of unique elements.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <redefinitions>OrderedCollection::elements</redefinitions>
        <redefinitions>UniqueCollection::elements</redefinitions>
        <elements xsi:type="kerMLOC:Comment" body="/* Note: Redefinition of `elements` is unique by default. */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="List">
      <subsetting>OrderedCollection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * List is a variable-size, ordered collection of nonunique elements.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="KeyValuePair">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * KeyValuePair is a tuple of a key and a value for use in Map collections.&#xD;&#xA;&#x9;&#x9; * The key must be immutable.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="key" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" declaredName="val" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isFeature="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Map">
      <subsetting>Collection</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Map is a variable-size, unordered collection of elements that are key-value pairs.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isFeature="true">
        <typings>KeyValuePair</typings>
        <redefinitions>Collection::elements</redefinitions>
        <elements xsi:type="kerMLOC:Comment" body="/* Note: Redefinition of `elements` is unique by default. &#xD;&#xA;&#x9;&#x9;&#x9; * The `key` of any `KeyValuePair` must be unique over the collection of `KeyValuePair`. &#xD;&#xA;&#x9;&#x9;&#x9; * The `val` does not need to be unique. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="OrderedMap">
      <subsetting>Map</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * OrderedMap is a variable-size, ordered collection of elements that are key-value pairs. &#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="elements" MultiLow="0" MultiHigh="*" isOrdered="true" isFeature="true">
        <typings>KeyValuePair</typings>
        <redefinitions>Map::elements</redefinitions>
        <elements xsi:type="kerMLOC:Comment" body="/* Note: Redefinition of `elements` is unique by default. */"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Collections.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: ScalarValues.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="ScalarValues" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains a basic set of primitive scalar (non-collection) data types. &#xD;&#xA;&#x9; * These include Boolean and String types and a hierarchy of concrete Number types, from &#xD;&#xA;&#x9; * the most general type of Complex numbers to the most specific type of Positive integers.&lt;/p>&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::DataValue"/>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="ScalarValue">
      <subsetting>DataValue</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Boolean">
      <subsetting>ScalarValue</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="String">
      <subsetting>ScalarValue</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="NumericalValue">
      <subsetting>ScalarValue</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="Number">
      <subsetting>NumericalValue</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Complex">
      <subsetting>Number</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Real">
      <subsetting>Complex</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Rational">
      <subsetting>Real</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Integer">
      <subsetting>Rational</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Natural">
      <subsetting>Integer</subsetting>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="Positive">
      <subsetting>Natural</subsetting>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: ScalarValues.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: VectorValues.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="VectorValues" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a basic model of abstract vectors as well as concrete vectors&#xD;&#xA;&#x9; * whose components are numerical values. The package VectorFunctions defines the &#xD;&#xA;&#x9; * corresponding vector-space functions.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::NumericalValue"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Collections::Array"/>
    <elements xsi:type="kerMLOC:DataType" isAbstract="true" declaredName="VectorValue">
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A VectorValue is an abstract data type whose values may be operated on using&#xD;&#xA;&#x9;&#x9; * VectorFunctions.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="NumericalVectorValue">
      <subsetting>VectorValue</subsetting>
      <subsetting>Array</subsetting>
      <intersecting>VectorValue</intersecting>
      <intersecting>Array</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A NumericalVectorValue is a kind of VectorValue that is specifically represented&#xD;&#xA;&#x9;&#x9; * as a one-dimensional array of NumericalValues. The dimension is allowed to be empty,&#xD;&#xA;&#x9;&#x9; * permitting a NumericalVectorValue of rank 0, which is essentially isomorphic to a&#xD;&#xA;&#x9;&#x9; * scalar NumericalValue.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" declaredName="dimension" MultiLow="0" MultiHigh="1" isFeature="true" isSemicolon="true">
        <redefinitions>dimensions</redefinitions>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>NumericalValue</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="CartesianVectorValue">
      <subsetting>NumericalVectorValue</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * CartesianVectorValue is a specialization Numerical VectorValue for which there are &#xD;&#xA;&#x9;&#x9; * specific implementations in VectorFunctions of the abstract vector-space functions.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: The restriction of the element type to Real is to facilitate&#xD;&#xA;&#x9;&#x9; * the complete definition of these functions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" isFeature="true" isSemicolon="true">
        <typings>Real</typings>
        <redefinitions>elements</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="ThreeVectorValue">
      <subsetting>NumericalVectorValue</subsetting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ThreeVectorValue is a NumericalVectorValue that has dimension 3.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="kerMLOC:Feature" valuePart="3" isFeature="true" isSemicolon="true">
        <redefinitions>dimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:DataType" declaredName="CartesianThreeVectorValue">
      <subsetting>CartesianVectorValue</subsetting>
      <subsetting>ThreeVectorValue</subsetting>
      <intersecting>CartesianVectorValue</intersecting>
      <intersecting>ThreeVectorValue</intersecting>
      <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CartesianThreeVectorValue is a NumericalVectorValue that is both Cartesian and&#xD;&#xA;&#x9;&#x9; * has dimension 3.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: VectorValues.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: Kernel Data Type Library.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: Kernel Function Library.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: BaseFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="BaseFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines a basic set of functions defined on all kinds of values. &#xD;&#xA;&#x9; * Most correspond to similarly named operators in the KerML expression syntax.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="KerML::Metaclass"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'=='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'!='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="not (x == y)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'==='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'!=='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="not (x === y)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="ToString">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'['">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'#'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="','">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'all'">
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Object</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'istype'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'hastype'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'@'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'@@'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
