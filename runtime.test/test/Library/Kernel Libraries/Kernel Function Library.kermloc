<?xml version="1.0" encoding="ASCII"?>
<kerMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:kerMLOC="http://www.control.dut/kermloc/KerMLOC">
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: BaseFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="BaseFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines a basic set of functions defined on all kinds of values. &#xD;&#xA;&#x9; * Most correspond to similarly named operators in the KerML expression syntax.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="KerML::Metaclass"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'=='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'!='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="not (x == y)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'==='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'!=='">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="not (x === y)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="ToString">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'['">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'#'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="','">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq1" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq2" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'all'">
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Object</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'istype'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'hastype'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'@'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'@@'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="'type'" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'as'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" isAbstract="true" declaredName="'meta'">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="seq" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Metaobject</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: BaseFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: BooleanFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="BooleanFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines functions on Boolean values, including those corresponding to &#xD;&#xA;&#x9; * (non-conditional) logical operators in the KerML expression notation.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'not'">
      <subsetting>ScalarFunctions::'not'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'xor'">
      <subsetting>ScalarFunctions::'xor'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'|'">
      <subsetting>ScalarFunctions::'|'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'&amp;'">
      <subsetting>ScalarFunctions::'&amp;'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>DataFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="y" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToString">
      <subsetting>BaseFunctions::ToString</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="ToBoolean">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="x" MultiLow="1" isSemicolon="true">
        <typings>String</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: BooleanFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: CollectionFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="CollectionFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines functions on Collections (as defined in the Collections package). &#xD;&#xA;&#x9; * For functions on general sequences of values, see the SequenceFunctions package.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::equals"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::exists"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="Collections" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Function" declaredName="'=='">
      <subsetting>BaseFunctions::'=='</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col1" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col2" MultiLow="0" MultiHigh="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="col1.elements->equals(col2.elements)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="size">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::size(col.elements)" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="isEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::isEmpty(col.elements)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="notEmpty">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="SequenceFunctions::notEmpty(col.elements)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="contains">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="values" MultiLow="*" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="col.elements->includes(values)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="containsAll">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col1" MultiLow="1" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col2" MultiLow="2" isSemicolon="true">
        <typings>Collection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" valuePart="contains(col1, col2.elements)" isSemicolon="true">
        <typings>Boolean</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="head">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="SequenceFunctions::head(col.elements)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="tail">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="*" isOrdered="true" isNonunique="true" valuePart="SequenceFunctions::tail(col.elements)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="last">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="SequenceFunctions::last(col.elements)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'#'">
      <subsetting>BaseFunctions::'#'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="col" MultiLow="1" isSemicolon="true">
        <typings>OrderedCollection</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="index" MultiLow="1" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Cast ensures this function is not called recursively if the elements of col are OrderedCollections.&#xD;&#xA;"/>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="(col.elements as Anything)#(index)" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="'array#'">
      <subsetting>BaseFunctions::'#'</subsetting>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="arr" MultiLow="1" isSemicolon="true">
        <typings>Array</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="indexes" MultiLow="n" isOrdered="true" isNonunique="true" isSemicolon="true">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" visibility="private" declaredName="n" MultiLow="1" valuePart="arr.rank" isFeature="true" isSemicolon="true">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="kerMLOC:CodeAnnotation" body="// Assumes row-major ordering for elements.&#xD;&#xA;"/>
      <elements xsi:type="kerMLOC:Function" visibility="private" declaredName="index">
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="arr" MultiLow="1" isSemicolon="true">
          <typings>Array</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="i" isSemicolon="true">
          <typings>Natural</typings>
        </elements>
        <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="indexes" MultiLow="1" MultiHigh="*" isSemicolon="true">
          <typings>Positive</typings>
        </elements>
        <resultExpressionParameter resultExpression="if i &lt;= 1? indexes#(1) else arr.dimensions#(i) * (index(arr, i-1, indexes) - 1) + indexes#(i)"/>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="0" MultiHigh="1" valuePart="if n == 0 or (1..n)->exists {in i; indexes#(i) > arr.dimensions#(i)}? null else arr.elements#(index(arr, n, indexes))" isSemicolon="true">
        <typings>Anything</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== END: CollectionFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:CodeAnnotation" body="// ===== BEGIN: ComplexFunctions.kerml =====&#xD;&#xA;"/>
  <elements xsi:type="kerMLOC:LibraryPackage" declaredName="ComplexFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="kerMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines functions on Complex values, including concrete specializations of the &#xD;&#xA;&#x9; * general arithmetic and comparison operations.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="kerMLOC:ImportElement" visibility="public" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="kerMLOC:Feature" declaredName="i" MultiLow="1" valuePart="rect(0.0, 1.0)" isFeature="true" isSemicolon="true">
      <typings>Complex</typings>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="rect">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="re" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="im" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="kerMLOC:Feature" isReturn="true" MultiLow="1" isSemicolon="true">
        <typings>Complex</typings>
      </elements>
    </elements>
    <elements xsi:type="kerMLOC:Function" declaredName="polar">
      <elements xsi:type="kerMLOC:Feature" direction="in" declaredName="abs" MultiLow="1" isSemicolon="true">
        <typings>Real</typings>
      </elements>
