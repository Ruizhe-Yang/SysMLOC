    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-35.2 speed of light, light speed */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpeedOfLightValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-35.2 speed of light, light speed&#xD;&#xA;         * symbol(s): `c_0`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: SpeedOfLight&#xD;&#xA;         * quantity dimension: L^1*T^-1&#xD;&#xA;         * measurement unit(s): m/s&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: speed of electromagnetic waves in vacuum; `c_0 = 299792458` m/s&#xD;&#xA;         * remarks: For this value of `c_0` see ISO 80000-3, item 3-1.a. `c_0 = 1/sqrt(&#x3b5;_0 &#x3bc;_0)`. See IEC 60050-111, item 111-13-07.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>SpeedOfLightUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
