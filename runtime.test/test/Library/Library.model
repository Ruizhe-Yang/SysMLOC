      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-52.4 modulus of admittance */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ModulusOfAdmittanceValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-52.4 modulus of admittance&#xD;&#xA;         * symbol(s): `Y`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: ModulusOfAdmittance&#xD;&#xA;         * quantity dimension: L^-2*M^-1*T^3*I^2&#xD;&#xA;         * measurement unit(s): S&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: `Y = |underline(Y)|` where `underline(Y)` is admittance (item 6-52.1)&#xD;&#xA;         * remarks: Apparent admittance is defined more generally as the quotient of rms electric current voltage and rms voltage; it is often denoted by `Y`.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>ModulusOfAdmittanceUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="modulusOfAdmittance" MultiLow="*" isNonunique="true">
      <typings>ModulusOfAdmittanceValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ModulusOfAdmittanceUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
