    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'mol/kg'" declaredName="'mole per kilogram'" valuePart="mol/kg">
      <typings>MolalityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'mol/L'" declaredName="'mole per l'" valuePart="mol/L">
      <typings>AmountOfSubstanceConcentrationUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'mol/m&#xb3;'" declaredName="'mole per cubic metre'" valuePart="mol/m^3">
      <typings>EquilibriumConstantOnConcentrationBasisUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'N&#x22c5;m'" declaredName="'newton metre'" valuePart="N*m">
      <typings>MomentOfForceUnit</typings>
      <typings>TorqueUnit</typings>
