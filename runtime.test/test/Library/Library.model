    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-10.1 coefficient of heat transfer */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CoefficientOfHeatTransferValue">
