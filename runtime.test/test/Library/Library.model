    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-9 item 9-8 molar entropy */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MolarEntropyValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 9-8 molar entropy&#xD;&#xA;         * symbol(s): `S_m`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MolarEntropy&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-2*&#x398;^-1*N^-1&#xD;&#xA;         * measurement unit(s): J/(mol*K), kg*m^2*s^-2*K^-1*mol^-1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of entropy `S` (ISO 80000-5) and amount `n` of substance (item 9-2): `S_m = S/n`&#xD;&#xA;         * remarks: Conditions (constant pressure or volume etc.) must be specified.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>MolarEntropyUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="molarEntropy" MultiLow="*" isNonunique="true">
      <typings>MolarEntropyValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MolarEntropyUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
