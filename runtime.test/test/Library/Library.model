    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianMassFlow3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-30.1 mass flow (vector)&#xD;&#xA;         * symbol(s): `vec(j_m)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MassFlow&#xD;&#xA;         * quantity dimension: L^-2*M^1*T^-1&#xD;&#xA;         * measurement unit(s): kg*m^-2*s^-1&#xD;&#xA;         * tensor order: 1&#xD;&#xA;         * definition: vector (ISO 80000-2) quantity characterizing a flowing fluid by the product of its local mass density `&#x3c1;` (item 4-2) and local velocity `vec(v)` (ISO 80000-3): `vec(j_m) = &#x3c1; vec(v)`&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>CartesianMassFlow3dCoordinateFrame</typings>
