        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-5 item 5-14 thermal diffusivity */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ThermalDiffusivityValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 5-14 thermal diffusivity&#xD;&#xA;         * symbol(s): `a`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: ThermalDiffusivity&#xD;&#xA;         * quantity dimension: L^2*T^-1&#xD;&#xA;         * measurement unit(s): m^2*s^-1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of thermal conductivity and the product of mass density and specific heat capacity: `a = &#x3bb; / (&#x3c1; C_p)` where `&#x3bb;` is thermal conductivity (item 5-9), `&#x3c1;` is mass density (ISO 80000-4), and `c_p` is specific heat capacity at constant pressure (item 5-16.2)&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>ThermalDiffusivityUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="thermalDiffusivity" MultiLow="*" isNonunique="true">
      <typings>ThermalDiffusivityValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
