          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianAcceleration3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 3-11 acceleration (vector)&#xD;&#xA;         * symbol(s): `vec(a)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: Acceleration&#xD;&#xA;         * quantity dimension: L^1*T^-2&#xD;&#xA;         * measurement unit(s): m*s^-2&#xD;&#xA;         * tensor order: 1&#xD;&#xA;         * definition: vector (ISO 80000-2) quantity giving the rate of change of velocity (item 3-10)&#xD;&#xA;         * remarks: The acceleration vector is given by: `vec(a) = (d vec(v))/(dt)` where `vec(v)` denotes the velocity (item 3-10.1) and `t` the duration (item 3-9). The magnitude (ISO 80000-2) of the acceleration of free fall is usually denoted by `g`.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>CartesianAcceleration3dCoordinateFrame</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
