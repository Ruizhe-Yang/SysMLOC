    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-25 magnetic field strength, magnetizing field */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MagneticFieldStrengthValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-25 magnetic field strength, magnetizing field (magnitude)&#xD;&#xA;         * symbol(s): `H`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MagneticFieldStrength&#xD;&#xA;         * quantity dimension: L^-1*I^1&#xD;&#xA;         * measurement unit(s): A/m&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: `vec(H) = vec(B)/&#x3bc;_0 - vec(M)` where `vec(B)` is magnetic flux density (item 6-21), `&#x3bc;_0` is the magnetic constant (item 6-26.1), and `vec(M)` is magnetization (item 6-24)&#xD;&#xA;         * remarks: The magnetic field strength is related to the total current density `vec(J_(t ot))` (item 6-20) via `rot vec(H) = vec(J_(t ot))`. See IEC 60050-121, item 121-11-56.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>MagneticFieldStrengthUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="magneticFieldStrength" MultiLow="*" isNonunique="true">
      <typings>MagneticFieldStrengthValue</typings>
