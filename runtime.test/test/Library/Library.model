    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpectralIrradianceValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 7-7.2 spectral irradiance&#xD;&#xA;         * symbol(s): `E_(e,&#x3bb;)`, `(E_&#x3bb;)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: SpectralIrradiance&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-3&#xD;&#xA;         * measurement unit(s): W/(m^2*nm), kg*m^-1*s^-3&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: density of irradiance with respect to wavelength, expressed by `E_(e,&#x3bb;) = (d E_e)/(d&#x3bb;)`, where `E_e` is irradiance (item 7-7.1) in terms of wavelength `&#x3bb;` (ISO 80000-3)&#xD;&#xA;         * remarks: The integral of (total) irradiance is determined by the wavelength interval `(&#x3bb;_1, &#x3bb;_2)` under consideration: `E_e = int_(&#x3bb;_1)^(&#x3bb;_2) E_(e,&#x3bb;) d &#x3bb;` .&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>SpectralIrradianceUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="spectralIrradiance" MultiLow="*" isNonunique="true">
      <typings>SpectralIrradianceValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
