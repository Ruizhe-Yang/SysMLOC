    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-23 magnetic moment, magnetic area moment */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MagneticMomentValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-23 magnetic moment, magnetic area moment (magnitude)&#xD;&#xA;         * symbol(s): `m`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MagneticMoment&#xD;&#xA;         * quantity dimension: L^2*I^1&#xD;&#xA;         * measurement unit(s): A*m^2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: `vec(m) = I vec(e_n) A` where `I` is electric current (item 6-1) in a small closed loop, `vec(e_n)` is a unit vector perpendicular to the loop, and `A` is area (ISO 80000-3, item 3-3) of the loop&#xD;&#xA;         * remarks: The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain. See IEC 60050-121, items 121-11-49 and 121-11-50.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>MagneticMomentUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="magneticMoment" MultiLow="*" isNonunique="true">
      <typings>MagneticMomentValue</typings>
      <subsetting>scalarQuantities</subsetting>
