    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-9 item 9-6.4 molar Gibbs energy */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="MolarGibbsEnergyValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 9-6.4 molar Gibbs energy&#xD;&#xA;         * symbol(s): `G_m`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MolarGibbsEnergy&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-2*N^-1&#xD;&#xA;         * measurement unit(s): J/mol, kg*m^2*s^-2*mol^-1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of the Gibbs energy `G` (ISO 80000-5) and amount `n` of substance (item 9-2): `G_m = G/n`&#xD;&#xA;         * remarks: Molar quantities are normally only used with reference to pure substances.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>MolarGibbsEnergyUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="molarGibbsEnergy" MultiLow="*" isNonunique="true">
      <typings>MolarGibbsEnergyValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
