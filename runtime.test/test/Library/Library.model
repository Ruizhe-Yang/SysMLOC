        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>MomentOfForceUnit::quantityDimension::quantityPowerFactors</redefinitions>
          <redefinitions>TorqueUnit::quantityDimension::quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'N&#x22c5;m&#x22c5;s'" declaredName="'newton metre second'" valuePart="N*m*s">
      <typings>AngularImpulseUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'N&#x22c5;m&#x22c5;s&#x207b;&#xb9;'" declaredName="'newton metre second to the power minus 1'" valuePart="N*m*s^-1">
      <typings>PowerUnit</typings>
    </elements>
