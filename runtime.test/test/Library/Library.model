    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianDisplacementCurrentDensity3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-18 displacement current density (vector)&#xD;&#xA;         * symbol(s): `vec(J_D)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: DisplacementCurrentDensity&#xD;&#xA;         * quantity dimension: L^-2*I^1&#xD;&#xA;         * measurement unit(s): A/m^2&#xD;&#xA;         * tensor order: 1&#xD;&#xA;         * definition: `vec(J_D) = (del vec(D))/(del t)` where `vec(D)` is electric flux density (item 6-12) and `t` is time (ISO 80000-3, item 3-7) &#xD;&#xA;         * remarks: See IEC 60050-121, item 121-11-42.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
