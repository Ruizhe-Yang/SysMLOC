<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Analysis.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: AnalysisTooling.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="AnalysisTooling" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains definitions for metadata annotations related&#xD;&#xA;&#x9; * to analysis tool integration.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ToolExecution">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ToolExecution metadata identifies an external analysis tool to be&#xD;&#xA;&#x9;&#x9; * used to implement the annotated action.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="toolName">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="uri">
        <typings>String</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ToolVariable">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ToolVariable metadata is used in the context of an action that has&#xD;&#xA;&#x9;&#x9; * been annotated with ToolExecution metadata. It is used to annotate&#xD;&#xA;&#x9;&#x9; * a parameter or other feature of the action with the name of the&#xD;&#xA;&#x9;&#x9; * variable in the tool that is to correspond to the annotated&#xD;&#xA;&#x9;&#x9; * feature.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="name">
        <typings>String</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: AnalysisTooling.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: SampledFunctions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="SampledFunctions" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a library model of discretely sampled mathematical functions.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Collections::KeyValuePair"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Collections::OrderedMap"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::collect"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::select"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SamplePair">
      <superclassifiers>KeyValuePair</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * SamplePair is a key-value pair of a domain-value and a range-value, used as a sample element in SampledFunction.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="domainValue">
        <redefinitions>key</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="rangeValue">
        <redefinitions>val</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SampledFunction">
      <superclassifiers>OrderedMap</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * SampledFunction is a variable-size, ordered collection of 'SamplePair' elements that represents a generic, discretely sampled, &#xD;&#xA;&#x9;     * uni-variate or multi-variate mathematical function. The function must be montonic, either strictly increasing or strictly&#xD;&#xA;&#x9;     * decreasing.&#xD;&#xA;&#x9;     * &#xD;&#xA;&#x9;     * It maps discrete domain values to discrete range values.&#xD;&#xA;&#x9;     * The domain of the function is represented by the sequence of 'domainValue' of each 'SamplePair' in 'samples', and &#xD;&#xA;&#x9;     * the range of the function is represented by the sequence of 'rangeValue' of each 'SamplePair' in 'samples'.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="samples" MultiLow="0" MultiHigh="*" isOrdered="true">
        <typings>SamplePair</typings>
        <redefinitions>elements</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Note: Assumes the functions '&lt;' and '>' are defined for the domain type.&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Strictly increasing&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Strictly decreasing&#xD;&#xA;"/>
        <resultExpressionParameter resultExpression="(1..size(samples)-1)->forAll { in i; (samples.domainValue#(i) &lt; samples.domainValue#(i+1)) } or (1..size(samples)-1)->forAll { in i; (samples.domainValue#(i) > samples.domainValue#(i+1)) }"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Domain">
      <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9; * Domain returns the sequence of the domainValues of all samples in a SampledFunction.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fn">
        <typings>SampledFunction</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="0" MultiHigh="*" valuePart="fn.samples.domainValue">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Range">
      <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9; * Range returns the sequence of the rangeValues of all samples in a SampledFunction.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="fn">
        <typings>SampledFunction</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" MultiLow="0" MultiHigh="*" valuePart="fn.samples.rangeValue">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Sample">
      <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9; * Sample returns a SampledFunction that samples a given calculation over a sequence of domainValues.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:CalculationUsage" direction="in" declaredName="calculation">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="domainValues" MultiLow="0" MultiHigh="*"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="sampling" valuePart="new SampledFunction ( samples = domainValues->collect { in x; new SamplePair(x, calculation(x)) } )"/>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="Interpolate">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An Interpolate calculation returns an interpolated range value from a given SampledFunction for a given domain value.&#xD;&#xA;&#x9;&#x9; * If the input domain value is outside the bounds of the domainValues of the SampleFunction, null is returned.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="fn">
        <typings>SampledFunction</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="value"/>
      <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="result"/>
    </elements>
    <elements xsi:type="sysMLOC:CalculationUsage" declaredName="interpolateLinear">
      <typings>Interpolate</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * interpolateLinear is an Interpolate calculation assuming a linear functional form between SamplePairs.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="fn">
        <typings>SampledFunction</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="value"/>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="domainValues" valuePart="Domain(fn)"/>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="index" MultiLow="0" MultiHigh="1" valuePart="(1..size(domainValues))->select { in i : Positive; domainValues#(i) &lt;= value }#(1)">
        <typings>Positive</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationDefinition" visibility="private" declaredName="Linear">
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="lowerSample">
          <typings>SamplePair</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="upperSample">
          <typings>SamplePair</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="value"/>
        <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="f" valuePart="(value - lowerSample.domainValue) / (lowerSample.domainValue - upperSample.domainValue)"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" valuePart="upperSample.rangeValue + f * (lowerSample.rangeValue - upperSample.rangeValue)"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" MultiLow="0" MultiHigh="1" valuePart="if index == null or index == size(domainValues)? null else if domainValues#(index) &lt; domainValues#(index+1)? Linear(fn.samples#(index), fn.samples#(index+1), value) else Linear(fn.samples#(index+1), fn.samples#(index), value)"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: SampledFunctions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: StateSpaceRepresentation.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="StateSpaceRepresentation" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a model of the foundational state-space system representation, &#xD;&#xA;&#x9; * commonly used in control systems.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ::DurationValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::VectorQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="VectorCalculations" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" isAbstract="true" declaredName="StateSpace">
      <superclassifiers>VectorQuantityValue</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" isAbstract="true" declaredName="Input">
      <superclassifiers>VectorQuantityValue</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" isAbstract="true" declaredName="Output">
      <superclassifiers>VectorQuantityValue</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="GetNextState">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeStep">
        <typings>DurationValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>StateSpace</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="GetOutput">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>Output</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="StateSpaceEventDef">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;    &#x9; * Events to be received.&#xD;&#xA;    &#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ZeroCrossingEventDef">
      <superclassifiers>StateSpaceEventDef</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="StateSpaceItem">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;    &#x9; * Item for SSR connection&#xD;&#xA;    &#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="StateSpaceDynamics">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * StateSpaceDynamics is the simplest form of State Space Representation,&#xD;&#xA;&#x9;     * and nextState directly computes the stateSpace of the next timestep. &#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="getNextState">
        <typings>GetNextState</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="getOutput">
        <typings>GetOutput</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="out" declaredName="output" valuePart="getOutput(input, stateSpace)">
        <typings>Output</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" isAbstract="true" declaredName="StateDerivative">
      <superclassifiers>VectorQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * The definition of the time derivative of StateSpace, which means dx/dt, where x is StateSpace&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage">
        <resultExpressionParameter resultExpression="stateSpace.order == order"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="GetDerivative">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * Computes the time derivative of stateSpace, which corresponds dx/dt = f(u, x), where u is input and x is stateSpace.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>StateDerivative</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="Integrate">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * Integrates stateSpace to compute the next stateSpace, which corresponds to x + int dx/dt dt.&#xD;&#xA;&#x9;     * Its actual implementation should be given by a solver. &#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="getDerivative">
        <typings>GetDerivative</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="initialState">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInterval">
        <typings>DurationValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result">
        <typings>StateSpace</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="ContinuousStateSpaceDynamics">
      <superclassifiers>StateSpaceDynamics</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * ContinuousStateSpaceDynamics represents continuous behavior.&#xD;&#xA;&#x9;     * derivative needs to return a time derivative of stateSpace, i.e. dx/dt.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="getDerivative">
        <typings>GetDerivative</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage">
        <typings>GetNextState</typings>
        <redefinitions>getNextState</redefinitions>
        <elements xsi:type="sysMLOC:Comment" body="/* We compute nextState by Integrate defined above by giving derivative calc. */"/>
        <elements xsi:type="sysMLOC:CalculationUsage" declaredName="integrate">
          <typings>Integrate</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="getDerivative" valuePart="ContinuousStateSpaceDynamics::getDerivative"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input" valuePart="GetNextState::input"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="initialState" valuePart="GetNextState::stateSpace"/>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="timeInterval" valuePart="GetNextState::timeStep"/>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" valuePart="integrate.result"/>
      </elements>
      <elements xsi:type="sysMLOC:EventOccurrenceUsage" MultiLow="0" MultiHigh="*" declaredName="zeroCrossingEvents">
        <typings>ZeroCrossingEventDef</typings>
        <elements xsi:type="sysMLOC:Comment" body="/* ContinuousStateSpaceDynamics may cause zero crossings anomaly. */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="GetDifference">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * Computes difference of stateSpace by one timestep, that is x(k+1) - x(k),&#xD;&#xA;&#x9;     * where k is the timestep number. &#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="input">
        <typings>Input</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="stateSpace">
        <typings>StateSpace</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true">
        <typings>StateSpace</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="DiscreteStateSpaceDynamics">
      <superclassifiers>StateSpaceDynamics</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * DiscreteStateSpaceDynamics represents discrete behavior.&#xD;&#xA;&#x9;     * differences needs to return difference of the stateSpace for each timestep.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="getDifference">
        <typings>GetDifference</typings>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage">
        <typings>GetNextState</typings>
        <redefinitions>getNextState</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="diff" valuePart="getDifference(input, stateSpace)">
          <typings>StateSpace</typings>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" valuePart="stateSpace + diff"/>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: StateSpaceRepresentation.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: TradeStudies.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="TradeStudies" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a simple framework for defining trade-off study analysis cases.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="EvaluationFunction">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EvaluationFunction is a calculation that evaluates a TradeStudy alternative,&#xD;&#xA;&#x9;&#x9; * producing a ScalarValue that can be comparted with the evaluation of other&#xD;&#xA;&#x9;&#x9; * alternatives.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="alternative">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The alternative to be evaluated.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="result" MultiLow="1">
        <typings>ScalarValue</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A ScalarValue representing the evaluation of the given alternative.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" isAbstract="true" declaredName="TradeStudyObjective">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TradeStudyObjective is the base definition for the objective of a TradeStudy.&#xD;&#xA;&#x9;&#x9; * The requirement is to choose from a given set of alternatives the selectedAlternative&#xD;&#xA;&#x9;&#x9; * for that has the best evaluation according to a given EvaluationFunction. What&#xD;&#xA;&#x9;&#x9; * value is considered &quot;best&quot; is not defined in the abstract base definition but must be&#xD;&#xA;&#x9;&#x9; * computed in any concrete specialization.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="selectedAlternative">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The alternative that should be selected, as evaluated using the given &#xD;&#xA;&#x9;&#x9;&#x9; * ObjectiveFunction.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="alternatives" MultiLow="1" MultiHigh="*">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The alternatives being considered in the TradeStudy for which this TradeStudyObjective &#xD;&#xA;&#x9;&#x9;&#x9; * is the objective.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage" direction="in" declaredName="eval">
        <typings>EvaluationFunction</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The EvaluationFunction to be used in evaluating the given alternatives.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="best">
        <typings>ScalarValue</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Out of the evaluation results of all the given alternatives, the one that is considered &#xD;&#xA;&#x9;&#x9;&#x9; * &quot;best&quot;, in the sense that it is the value the selectedAlternative should have. This &#xD;&#xA;&#x9;&#x9;&#x9; * value must be computed in any concrete specialization of TradeStudyObjective.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
        <resultExpressionParameter resultExpression="eval(selectedAlternative) == best"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MinimizeObjective">
      <superclassifiers>TradeStudyObjective</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A MinimizeObjective is a TradeStudyObjective that requires that the &#xD;&#xA;&#x9;&#x9; * selectedAlternative have the minimum ObjectiveFunction value of all the&#xD;&#xA;&#x9;&#x9; * given alternatives.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * For a MinimizeObjective, the best value is the minimum one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="alternatives->minimize { in x; eval(x) }">
        <redefinitions>best</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="MaximizeObjective">
      <superclassifiers>TradeStudyObjective</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A MaximizeObjective is a TradeStudyObjective that requires that the &#xD;&#xA;&#x9;&#x9; * selectedAlternative have the maximum ObjectiveFunction value of all the&#xD;&#xA;&#x9;&#x9; * given alternatives.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * For a MinimizeObjective, the best value is the maximum one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="alternatives->maximize { in x; eval(x) }">
        <redefinitions>best</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" isAbstract="true" declaredName="TradeStudy">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TradeStudy is an analysis case whose subject is a set of alternatives&#xD;&#xA;&#x9;&#x9; * (at least one) and whose result is a selection of one of those alternatives.&#xD;&#xA;&#x9;&#x9; * The alternatives are evaluated based on a given ObjectiveFunction and the&#xD;&#xA;&#x9;&#x9; * selection is made such that it satisfies the objective of the TradeStudy&#xD;&#xA;&#x9;&#x9; * (which must be a TradeStudyObjective).&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="studyAlternatives" MultiLow="1" MultiHigh="*">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The set of alternatives being considered in this TradeStudy. &#xD;&#xA;&#x9;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9;&#x9; * In a TradeStudy usage, bind this feature to the actual collection of&#xD;&#xA;&#x9;&#x9;&#x9; * alternatives to be considered.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="evaluationFunction">
        <typings>EvaluationFunction</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The EvaluationFunction to be used to evaluate the alternatives.&#xD;&#xA;&#x9;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9;&#x9; * In a TradeStudy usage, redefine this feature to provide the desired&#xD;&#xA;&#x9;&#x9;&#x9; * calculation (or bind it to a calculation usage that does so).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="tradeStudyObjective">
        <typings>TradeStudyObjective</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The objective of this TradeStudy.&#xD;&#xA;&#x9;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9;&#x9; * Redefine this feature to give it a definition that is a concrete&#xD;&#xA;&#x9;&#x9;&#x9; * specialization of TradeStudyObjective. That can either be one of the&#xD;&#xA;&#x9;&#x9;&#x9; * specializations provided in this package, or a more specific user-&#xD;&#xA;&#x9;&#x9;&#x9; * defined one.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:SubjectUsage">
          <redefinitions>selectedAlternative</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" valuePart="studyAlternatives">
          <redefinitions>alternatives</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:CalculationUsage" direction="in" valuePart="evaluationFunction">
          <redefinitions>eval</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The alternative selected by this TradeStudy, which is the one that meets the&#xD;&#xA;&#x9;&#x9;&#x9; * requirement of the tradeStudyObjective.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="selectedAlternative" valuePart="studyAlternatives->selectOne {in ref a ; tradeStudyObjective(selectedAlternative = a)}">
        <typings>Anything</typings>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: TradeStudies.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Analysis.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Cause and Effect.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: CausationConnections.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="CausationConnections" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9; * This package provides a library model modeling causes, effects, and causation connections &#xD;&#xA;&#x9; * between them.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::intersection"/>
    <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="causes" MultiLow="*">
      <elements xsi:type="sysMLOC:Documentation" body="/* Occurrences that are causes. */"/>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" declaredName="effects" MultiLow="*">
      <elements xsi:type="sysMLOC:Documentation" body="/* Occurrences that are effects. */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" isAbstract="true" declaredName="Multicausation">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Multicausation connection models the situation in which one set of&#xD;&#xA;&#x9;&#x9; * occurrences causes another.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * To create a Multicausation connection, specialize this connection definition&#xD;&#xA;&#x9;&#x9; * adding specific end features of the relavent types. Ends representing causes&#xD;&#xA;&#x9;&#x9; * should subset 'causes', while ends representing effects should subset 'effects'.&#xD;&#xA;&#x9;&#x9; * There must be at least one cause and at least one effect.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" isConstant="true" isReference="true" declaredName="causes" MultiLow="1" MultiHigh="*">
        <subsetting>participant</subsetting>
        <redefinitions>causes</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9;&#x9; * The causing occurrences. (Constant for each Multicausation instance.)&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isAbstract="true" isConstant="true" isReference="true" declaredName="effects" MultiLow="1" MultiHigh="*">
        <subsetting>participant</subsetting>
        <redefinitions>effects</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9;&#x9; * The effect occurrences caused by the causing occurrences. &#xD;&#xA;&#x9;&#x9;&#x9; * (Constant for each Multicausation instance.)&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage" visibility="private" declaredName="disjointCauseEffect">
        <elements xsi:type="sysMLOC:Documentation" body="/* causes must be disjoint from effects. */"/>
        <resultExpressionParameter resultExpression="isEmpty(intersection(causes, effects))"/>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage" visibility="private" declaredName="causalOrdering">
        <connectorPart MultiLow="nCauses" refElement="causes.startShot"/>
        <connectorPart MultiLow="nEffects" refElement="effects"/>
        <elements xsi:type="sysMLOC:Documentation" body="/* All causes must exist before all effects. */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="nCauses" valuePart="size(causes)"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="nEffects" valuePart="size(effects)"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="multicausations" MultiLow="*">
      <typings>Multicausation</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/* multicausations is the base feature for Multicausation ConnectionUsages. */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Causation">
      <superclassifiers>Multicausation</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Causation is a binary Multicausation in which a single cause occurrence&#xD;&#xA;&#x9;&#x9; * causes a single effect occurrence. (However, a single cause can separately&#xD;&#xA;&#x9;&#x9; * have multiple effects, and a single effect can have separate Causation&#xD;&#xA;&#x9;&#x9; * connections with multiple causes.)&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="theCause">
        <crossEndUsage MultiLow="*" declaredName="theCauses"/>
        <subsetting>causes</subsetting>
        <redefinitions>source</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* The single causing occurrence. */"/>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="theEffect">
        <crossEndUsage MultiLow="*" declaredName="theEffects"/>
        <subsetting>effects</subsetting>
        <redefinitions>target</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* The single effect occurrence resulting from the cause. */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="causations" MultiLow="*">
      <typings>Causation</typings>
      <subsetting>multicausations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/* causations is the base feature for Causation ConnectionUsages. */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: CausationConnections.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: CauseAndEffect.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="CauseAndEffect" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/* This package provides language-extension metadata for cause-effect modeling. */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="CausationConnections" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::SemanticMetadata"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="cause" declaredName="CauseMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * CauseMetadata identifies a usage as being a cause occurrence.&#xD;&#xA;&#x9;&#x9; * It is intended to be used to tag the cause ends of a Multicausation.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <typings>SysML::Usage</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="causes as SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="effect" declaredName="EffectMetadata">
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * EffectMetadata identifies a usage as being an effect occurrence.&#xD;&#xA;&#x9;&#x9; * It is intended to be used to tag the effect ends of a Multicausation.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <typings>SysML::Usage</typings>
        <redefinitions>annotatedElement</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="effects as SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="CausationMetadata">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * CausationMetadata allows for the specification of additional metadata about&#xD;&#xA;&#x9;&#x9; * a cause-effect connection definition or usage.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <typings>SysML::ConnectionDefinition</typings>
        <subsetting>annotatedElement</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <typings>SysML::ConnectionUsage</typings>
        <subsetting>annotatedElement</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isNecessary" isDefault="true" valuePart="false">
        <typings>Boolean</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9;&#x9; * Whether all the causes are necessary for all the effects to occur.&#xD;&#xA;&#x9;&#x9;&#x9; * If this is false (the default), then some or all of the effects may &#xD;&#xA;&#x9;&#x9;&#x9; * still have occurred even if some of the causes did not.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isSufficient" isDefault="true" valuePart="false">
        <typings>Boolean</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Whether the causes were sufficient for all the effects to occur.&#xD;&#xA;&#x9;&#x9;&#x9; * If this is false (the default), then it may be the case that some&#xD;&#xA;&#x9;&#x9;&#x9; * other occurrences were also necessary for some or all of the effects&#xD;&#xA;&#x9;&#x9;&#x9; * to have occurred.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="probability" MultiLow="0" MultiHigh="1">
        <typings>Real</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/* The probability that the causes will actually result in effects occurring. */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="multicausation" declaredName="MulticausationSemanticMetadata">
      <superclassifiers>CausationMetadata</superclassifiers>
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * MulticausationMetadata is SemanticMetadata for a Multicausation connection.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="multicausations meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredShortName="causation" declaredName="CausationSemanticMetadadata">
      <superclassifiers>CausationMetadata</superclassifiers>
      <superclassifiers>SemanticMetadata</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * CausationMetadata is SemanticMetadata for a Causation connection.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="causations meta SysML::Usage">
        <redefinitions>baseType</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: CauseAndEffect.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Cause and Effect.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Geometry.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: ShapeItems.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="ShapeItems" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package provides a model of items that represent basic geometric shapes. &#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQSpaceTime" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQBase" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::m"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::MatesWith"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::Item"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::equals"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::'if'"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::exists"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::scalarQuantities"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="PlanarCurve">
      <superclassifiers>Curve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A PlanarCurve is a Curve with a given length embeddable in a plane.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="notEmpty(outerSpaceDimension) &amp; outerSpaceDimension &lt;= 2"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="PlanarSurface">
      <superclassifiers>Surface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A PlanarSurface is a flat Surface with a given area.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>area</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="2">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>PlanarCurve</typings>
        <redefinitions>shape</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Line">
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Line is a Curve that is a straight line of a given length.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="1">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isAbstract="true" declaredName="Path">
      <superclassifiers>StructuredSpaceObject::StructuredCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Path is the most general structured Curve.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="*">
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0" MultiHigh="2">
          <redefinitions>vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="*" valuePart="edges.vertices">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//isClosed == vertices->forAll{&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//in p1 : Point;&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//vertices->exists{&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//&#x9;p2 : Point; p1 != p2 and includes(p1.matingOccurrences, p2)&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//}&#xD;&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="//} &#xD;&#xA;"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiMajorAxis" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiMinorAxis" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="xoffset" MultiLow="0" MultiHigh="*" isDefault="true" valuePart="0 [m]">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="yoffset" MultiLow="0" MultiHigh="*" isDefault="true" valuePart="0 [m]">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="baseLength" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="baseWidth" MultiLow="0" MultiHigh="*">
      <typings>LengthValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConicSection">
      <superclassifiers>Path</superclassifiers>
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConicSection is a closed PlanarCurve, possibly disconnected, see Hyperbola.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="2">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Ellipse">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An Ellipse is a ConicSection in the shape of an ellipse of a given semiaxes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Circle">
      <superclassifiers>Ellipse</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Circle is an Ellipse with semiaxes equal to its radius.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="length" MultiLow="1" valuePart="Circle::radius * TrigFunctions::pi * 2"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Parabola">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Parabola is a ConicSection in the shape of a parabola of a given focal length.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="focalDistance" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Hyperbola">
      <superclassifiers>ConicSection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Hyperbola is a ConicSection in the shape of a hyperbola with given axes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tranverseAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="conjugateAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Polygon">
      <superclassifiers>Path</superclassifiers>
      <superclassifiers>PlanarCurve</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Polygon is a closed planar Path with straight edges.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Line</typings>
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2">
          <redefinitions>vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
        <redefinitions>isClosed</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="(1..size(edges))->forAll {in i; edges#(i).vertices->equals((vertices#((2*i)-1), vertices#(2*i))) and includes((edges#(i).vertices#(2) as Item).matingOccurrences, edges#(if i==size(edges) ? 1 else i+1).vertices#(1) ) }"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Triangle">
      <superclassifiers>Polygon</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Triangle is three-sided Polygon  with given length (base), width (perpendicular distance&#xD;&#xA;&#x9;&#x9; * from base to apex), and offset of this perpendicular at the base from the center of the base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>width</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" valuePart="(base, e2, e3)">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="base" MultiLow="1">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="length" valuePart="Triangle::length"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e2" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e3" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="6">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v12" MultiLow="2" isOrdered="true" valuePart="(vertices#(2), vertices#(3))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="apex" MultiLow="2" isOrdered="true" valuePart="(vertices#(4), vertices#(5))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v31" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(1))"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightTriangle">
      <superclassifiers>Triangle</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightTriangle is a Triangle with sides opposite the hypotenuse at right angles.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="length / 2">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e2</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Triangle::width">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="hypotenuse">
        <redefinitions>e3</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="( Triangle::length^2 + Triangle::width^2 )">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Quadrilateral">
      <superclassifiers>Polygon</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Quadrilateral is a four-sided Polygon.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="4" valuePart="(e1, e2, e3, e4)">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e1" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e2" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e3" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="e4" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="8">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v12" MultiLow="2" isOrdered="true" valuePart="(vertices#(2), vertices#(3))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v23" MultiLow="2" isOrdered="true" valuePart="(vertices#(4), vertices#(5))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v34" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(7))"/>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="v41" MultiLow="2" isOrdered="true" valuePart="(vertices#(6), vertices#(1))"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Rectangle">
      <superclassifiers>Quadrilateral</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Rectangle is a Quadrilateral four right angles and given length and width.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>length</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>width</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e1</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Rectangle::length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e2</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Rectangle::width">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e3</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="e1.length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>e4</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="e2.length">
          <redefinitions>length</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" isAbstract="true" declaredName="Shell">
      <superclassifiers>StructuredSpaceObject::StructuredSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Shell is the most general structured Surface.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Disc">
      <superclassifiers>Shell</superclassifiers>
      <superclassifiers>PlanarSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Disc is a Shell bound by an Ellipse.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Ellipse</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Disc::semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="Disc::semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>PlanarSurface</typings>
        <redefinitions>faces</redefinitions>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
          <redefinitions>edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" valuePart="shape">
        <typings>Ellipse</typings>
        <redefinitions>edges</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Shell::edges::innerSpaceDimension</redefinitions>
          <redefinitions>Ellipse::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true">
          <redefinitions>Shell::edges::vertices</redefinitions>
          <redefinitions>Ellipse::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularDisc">
      <superclassifiers>Disc</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularDisc is a Disc bound by a Circle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Circle</typings>
        <redefinitions>shape</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::shape::semiMajorAxis</redefinitions>
          <redefinitions>Circle::semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::shape::semiMinorAxis</redefinitions>
          <redefinitions>Circle::semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>Circle</typings>
        <redefinitions>edges</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConicSurface">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConicSurface is a Surface that has ConicSection cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1" MultiHigh="2">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Ellipsoid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An Ellipsoid is a ConicSurface with only elliptical cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis1" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis2" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="semiAxis3" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Sphere">
      <superclassifiers>Ellipsoid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Sphere is an Ellipsoid with all the same semiaxes.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis1</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis2</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiAxis3</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Paraboloid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Paraboloid is a ConicSurface with only parabolic cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="focalDistance" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Hyperboloid">
      <superclassifiers>ConicSurface</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Hyperboloid is a ConicSurface with only hyperbolic cross-sections.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="transverseAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="conjugateAxis" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Toroid">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Toroid is a surface generated from revolving a planar closed curve about an line coplanar&#xD;&#xA;&#x9;&#x9; * with the curve. It is single sided with one hole.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="revolutionRadius" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="revolvedCurve" MultiLow="1">
        <typings>PlanarCurve</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
          <redefinitions>isClosed</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="1">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Torus">
      <superclassifiers>Toroid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Torus is a revolution of a Circle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="majorRadius">
        <redefinitions>revolutionRadius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="minorRadius" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Circle</typings>
        <redefinitions>revolvedCurve</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="minorRadius">
          <redefinitions>radius</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RectangularToroid">
      <superclassifiers>Toroid</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RectangularToroid is a revolution of a Rectangle.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="rectangleLength" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="rectangleWidth" MultiLow="1">
        <typings>LengthValue</typings>
        <subsetting>scalarQuantities</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <typings>Rectangle</typings>
        <redefinitions>revolvedCurve</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="rectangleLength">
          <redefinitions>length</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="rectangleWidth">
          <redefinitions>width</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>revolvedCurve::isClosed</redefinitions>
          <redefinitions>Rectangle::isClosed</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="ConeOrCylinder">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ConeOrCylinder is Shell that a Cone or a Cylinder with a given elliptical base,&#xD;&#xA;&#x9;&#x9; * height, width (perpendicular distance from the base to the center of the top side or vertex),&#xD;&#xA;&#x9;&#x9; * and offsets of this perpendicular at the base from the center of the base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>height</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>xoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>yoffset</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="3">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="base" MultiLow="1">
        <typings>Disc</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>Disc::edges::innerSpaceDimension</redefinitions>
            <redefinitions>ConeOrCylinder::faces::edges::innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="af" MultiLow="0" MultiHigh="1">
        <typings>Disc</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Disc::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
          <elements xsi:type="sysMLOC:AttributeUsage">
            <redefinitions>Disc::edges::innerSpaceDimension</redefinitions>
            <redefinitions>ConeOrCylinder::faces::edges::innerSpaceDimension</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Disc::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="cf" MultiLow="1">
        <typings>Surface</typings>
        <subsetting>faces</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="4" valuePart="faces.edges">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="be" MultiLow="2">
        <subsetting>edges</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="ConeOrCylinder::semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="ConeOrCylinder::semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ae" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="be.semiMajorAxis">
          <redefinitions>semiMajorAxis</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="be.semiMinorAxis">
          <redefinitions>semiMinorAxis</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(ae) == (if isEmpty(af) ? 0 else 2) and size(edges) == (if isEmpty(af) ? 2 else 4)"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="0" MultiHigh="1" valuePart="faces.vertices">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="isEmpty(af) == notEmpty(vertices)"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind face edges to specific edges */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="base.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Meeting edges */"/>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="be"/>
        <connectorPart MultiLow="1" refElement="be"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Cone">
      <superclassifiers>ConeOrCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Cone has one elliptical sides joined to a point by a curved side.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="apex">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind face vertices to specific vertices */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="apex"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="EccentricCone">
      <superclassifiers>Cone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An EccentricCone is a Cone with least one positive offset.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="xoffset > 0 or yoffset > 0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularCone">
      <superclassifiers>Cone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularCone is a Cone with a circular base.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>base::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightCircularCone">
      <superclassifiers>CircularCone</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightCircularCone is a CircularCone with zero offsets.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>xoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>yoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Cylinder">
      <superclassifiers>ConeOrCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Cylinder has two elliptical sides joined by a curved side.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="1">
        <redefinitions>af</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="*" refElement="cf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="*" refElement="ae"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>MatesWith</typings>
        <connectorPart MultiLow="1" refElement="ae"/>
        <connectorPart MultiLow="1" refElement="ae"/>
        <elements xsi:type="sysMLOC:Documentation" body="/* Meeting edges */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="EccentricCylinder">
      <superclassifiers>Cylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * An EccentricCylinder is a Cylinder with least one positive offset.&#xD;&#xA;&#x9; */"/>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="xoffset > 0 or yoffset > 0"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CircularCylinder">
      <superclassifiers>Cylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CircularCylinder is a Cylinder with two circular sides.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <redefinitions>radius</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMajorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1" valuePart="radius">
        <redefinitions>semiMinorAxis</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>base</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>base::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <typings>CircularDisc</typings>
        <redefinitions>af</redefinitions>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>af::edges</redefinitions>
          <redefinitions>CircularDisc::edges</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="RightCircularCylinder">
      <superclassifiers>CircularCylinder</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A RightCircularCylinder is a CircularCylinder with zero offsets.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>xoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>yoffset</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="Polyhedron">
      <superclassifiers>Shell</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A Polyhedron is a closed Shell with polygonal sides.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
        <redefinitions>isClosed</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="2" MultiHigh="*">
        <typings>Polygon</typings>
        <redefinitions>faces</redefinitions>
        <elements xsi:type="sysMLOC:AttributeUsage">
          <redefinitions>Polygon::innerSpaceDimension</redefinitions>
          <redefinitions>faces::innerSpaceDimension</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Polygon::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" valuePart="faces.edges">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="if size(faces) > 2 ? 3 else 2">
        <redefinitions>outerSpaceDimension</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="0">
        <redefinitions>genus</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="CuboidOrTriangularPrism">
      <superclassifiers>Polyhedron</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A CuboidOrTriangularPrism is a Polyhedron that is either a Cuboid or TriangularPrism.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" MultiLow="5" MultiHigh="6">
        <redefinitions>faces</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ff" MultiLow="1">
        <typings>Polygon</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" MultiHigh="4">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>faces::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="rf" MultiLow="1">
        <typings>Polygon</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ItemUsage" MultiLow="3" MultiHigh="4">
          <redefinitions>Polygon::edges</redefinitions>
          <redefinitions>faces::edges</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="slf" MultiLow="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="srf" MultiLow="0" MultiHigh="1">
        <typings>Quadrilateral</typings>
        <subsetting>faces</subsetting>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::edges</redefinitions>
          <redefinitions>ConeOrCylinder::faces::edges</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <redefinitions>Quadrilateral::vertices</redefinitions>
          <redefinitions>ConeOrCylinder::faces::vertices</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>edges</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(edges) == 18 or size(edges) == 24"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tfe" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tsle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tsre" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bfe" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bsle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bsre" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ufle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="ufre" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="urle" MultiLow="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="urre" MultiLow="0" MultiHigh="2">
        <subsetting>edges</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="( isEmpty(srf) implies isEmpty(tsre) ) and ( isEmpty(tsre) == isEmpty(ufre) ) and ( isEmpty(ufre) == isEmpty(urre) )"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage">
        <redefinitions>vertices</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="size(vertices) == size(edges)"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tflv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="tfrv" MultiLow="0" MultiHigh="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="trlv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="trrv" MultiLow="0" MultiHigh="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bflv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="bfrv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="brlv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="brrv" MultiLow="3">
        <subsetting>vertices</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="( isEmpty(tfrv) == isEmpty(trrv) )"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind face edges to specific edges */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tfe"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tre"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tsle"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfe"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bre"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsle"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsre"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ff.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tfe"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ff.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfe"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ff.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ufle"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="rf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tre"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="rf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bre"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="rf.edges"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="urle"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* Bind edge vertices to specific vertices */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tfe.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tflv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="trlv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tsle.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tflv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="tsle.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="trlv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfe.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bflv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfe.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="brlv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="brrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsle.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bflv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsle.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="brlv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bfrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="bsre.vertices"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="brrv"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage" MultiLow="1">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="ufle.vertices"/>
