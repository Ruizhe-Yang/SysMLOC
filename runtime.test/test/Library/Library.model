    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Pa&#x207b;&#xb9;'" declaredName="'pascal to the power minus 1'" valuePart="Pa^-1">
      <typings>CompressibilityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Pa&#xb2;&#x22c5;s'" declaredName="'pascal to the power 2 second'" valuePart="Pa^2*s">
      <typings>SoundExposureUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'rad&#x22c5;m&#xb2;/kg&#xb9;'" declaredName="'radian metre squared per kilogram to the power 1'" valuePart="rad*m^2/kg^1">
      <typings>SpecificOpticalRotatoryPowerUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'rad&#x22c5;m&#xb2;/mol'" declaredName="'radian metre squared per mole'" valuePart="rad*m^2/mol">
      <typings>MolarOpticalRotatoryPowerUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'rad&#x22c5;s&#x207b;&#xb9;'" declaredName="'radian second to the power minus 1'" valuePart="rad*s^-1">
      <typings>AngularVelocityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'rad&#x22c5;s&#x207b;&#xb2;'" declaredName="'radian second to the power minus 2'" valuePart="rad*s^-2">
      <typings>AngularAccelerationUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'rad/m'" declaredName="'radian per metre'" valuePart="rad/m">
      <typings>PhaseCoefficientUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'s&#x22c5;A'" declaredName="'second ampere'" valuePart="s*A">
      <typings>ElectricChargeUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'S&#x22c5;m&#xb2;/mol'" declaredName="'siemens metre squared per mole'" valuePart="S*m^2/mol">
      <typings>MolarConductivityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'S/m'" declaredName="'siemens per metre'" valuePart="S/m">
      <typings>ConductivityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'s&#x207b;&#xb9;'" declaredName="'second to the power minus 1'" valuePart="s^-1">
      <typings>AngularVelocityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'s&#x207b;&#xb9;&#x22c5;sr&#x207b;&#xb9;'" declaredName="'second to the power minus 1 steradian to the power minus 1'" valuePart="s^-1*sr^-1">
      <typings>PhotonIntensityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'s&#x207b;&#xb2;'" declaredName="'second to the power minus 2'" valuePart="s^-2">
      <typings>AngularAccelerationUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Sh/s'" declaredName="'shannon per second'" valuePart="Sh/s">
      <typings>AverageInformationRateUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Sv/s'" declaredName="'sievert per second'" valuePart="Sv/s">
      <typings>DoseEquivalentUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'V&#x22c5;A'" declaredName="'volt ampere'" valuePart="V*A">
      <typings>PowerUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'V/K'" declaredName="'volt per kelvin'" valuePart="V/K">
      <typings>SeebeckCoefficientForSubstancesAAndBUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'V/m'" declaredName="'volt per metre'" valuePart="V/m">
      <typings>ElectricFieldStrengthUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'V&#xb2;/K&#xb2;'" declaredName="'volt to the power 2 per kelvin to the power 2'" valuePart="V^2/K^2">
      <typings>LorenzCoefficientUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W&#x22c5;h'" declaredName="'watt hour'" valuePart="W*h">
      <typings>EnergyUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(m&#x22c5;K)'" declaredName="'watt per metre kelvin'" valuePart="W/(m*K)">
      <typings>ThermalConductivityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(m&#xb2;&#x22c5;K)'" declaredName="'watt per square metre kelvin'" valuePart="W/(m^2*K)">
      <typings>CoefficientOfHeatTransferUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(m&#xb2;&#x22c5;nm)'" declaredName="'watt per square metre nm'" valuePart="W/(m^2*nm)">
      <typings>SpectralIrradianceUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(sr&#x22c5;m&#xb2;)'" declaredName="'watt per steradian square metre'" valuePart="W/(sr*m^2)">
      <typings>RadianceUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(sr&#x22c5;m&#xb2;&#x22c5;nm)'" declaredName="'watt per steradian square metre nm'" valuePart="W/(sr*m^2*nm)">
      <typings>SpectralRadianceUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/(sr&#x22c5;nm)'" declaredName="'watt per steradian nm'" valuePart="W/(sr*nm)">
      <typings>SpectralRadiantIntensityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/K'" declaredName="'watt per kelvin'" valuePart="W/K">
      <typings>ThermalConductanceUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/kg'" declaredName="'watt per kilogram'" valuePart="W/kg">
      <typings>DoseEquivalentUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/m&#xb2;'" declaredName="'watt per square metre'" valuePart="W/m^2">
      <typings>DensityOfHeatFlowRateUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/nm'" declaredName="'watt per nm'" valuePart="W/nm">
      <typings>SpectralRadiantFluxUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'W/sr'" declaredName="'watt per steradian'" valuePart="W/sr">
      <typings>RadiantIntensityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Wb&#x22c5;m'" declaredName="'weber metre'" valuePart="Wb*m">
      <typings>MagneticDipoleMomentUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'Wb/m'" declaredName="'weber per metre'" valuePart="Wb/m">
      <typings>MagneticVectorPotentialUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'&#x3a9;&#x22c5;m'" declaredName="'ohm metre'" valuePart="'&#x3a9;'*m">
      <typings>ResistivityUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="'m/s&#xb2;'" memberElement="'m&#x22c5;s&#x207b;&#xb2;'"/>
    <elements xsi:type="sysMLOC:Comment" body="/*&#xD;&#xA;     * Prefixed units&#xD;&#xA;     */"/>
    <elements xsi:type="sysMLOC:Comment" body="/* Length */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="nm" declaredName="nanometre">
      <typings>LengthUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="nano">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="m">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="mm" declaredName="millimetre">
      <typings>LengthUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="milli">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="m">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="cm" declaredName="centimetre">
      <typings>LengthUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="centi">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="m">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="km" declaredName="kilometre">
      <typings>LengthUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="kilo">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="m">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Volume */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="mL" declaredName="millilitre">
      <typings>VolumeUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="milli">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="L">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Force */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="mN" declaredName="millinewton">
      <typings>ForceUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="milli">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="N">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Energy */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="kJ" declaredName="kilojoule">
      <typings>EnergyUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="kilo">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="J">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="MJ" declaredName="megajoule">
      <typings>EnergyUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="mega">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="J">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="GJ" declaredName="gigajoule">
      <typings>EnergyUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="giga">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="J">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Power */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="kW" declaredName="kilowatt">
      <typings>PowerUnit</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage">
        <typings>ConversionByPrefix</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="kilo">
          <redefinitions>prefix</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="W">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* Speed */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'km/h'" declaredName="'kilometre per hour'" valuePart="km/h">
      <typings>SpeedUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* &#xD;&#xA;&#x9; * Celsius units&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'&#xb0;C'" declaredName="'degree celsius (temperature difference)'">
      <typings>TemperatureDifferenceUnit</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * degree Celsius unit for temperature interval (i.e. temperature difference) quantities&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>ConversionByConvention</typings>
        <redefinitions>unitConversion</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="K">
          <redefinitions>referenceUnit</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>conversionFactor</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'&#xb0;C_abs'" declaredName="'degree celsius (absolute temperature scale)'">
      <typings>IntervalScale</typings>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;     * degree Celsius interval scale for absolute (thermodynamic) temperature quantities&#xD;&#xA;&#x9;     *&#xD;&#xA;&#x9;     * The interval scale is defined with an explicit transformation with respect to &#xD;&#xA;&#x9;     * the kelvin thermodynamic temperature scale that specifies the zero shift.&#xD;&#xA;&#x9;     */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="'&#xb0;C'">
        <redefinitions>unit</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="temperatureWaterAtFreezingPointInC">
        <typings>DefinitionalQuantityValue</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0">
          <redefinitions>num</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;temperature in degree Celsius of pure water at freezing point&quot;">
          <redefinitions>definition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="temperatureWaterAtTriplePointInC">
        <typings>DefinitionalQuantityValue</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1/100">
          <redefinitions>num</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;temperature in degree Celsius of pure water at the triple point&quot;">
          <redefinitions>definition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="celsiusToKelvinScaleMapping">
        <typings>QuantityValueMapping</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="temperatureWaterAtTriplePointInC">
          <redefinitions>mappedQuantityValue</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="K.temperatureOfWaterAtTriplePointInK">
          <redefinitions>referenceQuantityValue</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="(temperatureWaterAtTriplePointInC, temperatureWaterAtFreezingPointInC)">
        <redefinitions>definitionalQuantityValues</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="celsiusToKelvinScaleMapping">
        <redefinitions>quantityValueMapping</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* CoordinateFramePlacement (zero shift) w.r.t. the kelvin thermodynamic temperature scale */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="zeroDegreeCelsiusInKelvin" valuePart="273.15 [K]">
        <typings>ThermodynamicTemperatureValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="zeroDegreeCelsiusToKelvinShift">
        <typings>CoordinateFramePlacement</typings>
        <redefinitions>transformation</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="K">
          <redefinitions>source</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="zeroDegreeCelsiusInKelvin">
          <redefinitions>origin</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: SI.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: SIPrefixes.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="SIPrefixes" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * Definition of SI unit prefixes as specified in ISO/IEC 80000-1&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Comment" body="/*&#xD;&#xA;&#x9; * ISO/IEC 80000-1 prefixes for decimal multiples and sub-multiples&#xD;&#xA;&#x9; * &#xD;&#xA;&#x9; * See also https://en.wikipedia.org/wiki/Unit_prefix&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="yocto">
      <typings>UnitPrefix</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;yocto&quot;">
        <redefinitions>longName</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;y&quot;">
        <redefinitions>symbol</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1E-24">
        <redefinitions>conversionFactor</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="zepto">
      <typings>UnitPrefix</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;zepto&quot;">
        <redefinitions>longName</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;z&quot;">
        <redefinitions>symbol</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1E-21">
        <redefinitions>conversionFactor</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="atto">
      <typings>UnitPrefix</typings>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;atto&quot;">
        <redefinitions>longName</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="&quot;a&quot;">
        <redefinitions>symbol</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1E-18">
        <redefinitions>conversionFactor</redefinitions>
