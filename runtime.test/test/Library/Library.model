      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 6-29 magnetic polarization (vector)&#xD;&#xA;         * symbol(s): `vec(J_m)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MagneticPolarization&#xD;&#xA;         * quantity dimension: M^1*T^-2*I^-1&#xD;&#xA;         * measurement unit(s): T&#xD;&#xA;         * tensor order: 1&#xD;&#xA;         * definition: `vec(J_m) = &#x3bc;_0 vec(M)` where `&#x3bc;_0` is the magnetic constant (item 6-26.1), and `vec(M)` is magnetization (item 6-24)&#xD;&#xA;         * remarks: See IEC 60050-121, item 121-11-54.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>CartesianMagneticPolarization3dCoordinateFrame</typings>
