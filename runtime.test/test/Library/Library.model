    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-7 item 7-9.2 spectral radiant exposure */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="SpectralRadiantExposureValue">
