    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-19.3 modulus of compression, bulk modulus */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ModulusOfCompressionValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-19.3 modulus of compression, bulk modulus&#xD;&#xA;         * symbol(s): `K`, `K_m`, `B`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: ModulusOfCompression&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: negative of the quotient of pressure `p` (item 4-14.1) and relative volume strain `&#x3b8;` (item 4-17.4): `K = -(p/&#x3b8;)`&#xD;&#xA;         * remarks: Conditions should be specified (e.g. isentropic or isothermal process).&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>ModulusOfCompressionUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="modulusOfCompression" MultiLow="*" isNonunique="true">
      <typings>ModulusOfCompressionValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ModulusOfCompressionUnit">
