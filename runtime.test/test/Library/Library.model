      <superclassifiers>DimensionOneValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-17.2 relative linear strain&#xD;&#xA;         * symbol(s): `&#x3b5;`, `(e)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: RelativeLinearStrain (specializes DimensionOneQuantity)&#xD;&#xA;         * quantity dimension: 1&#xD;&#xA;         * measurement unit(s): 1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of change in length `&#x394;l` (ISO 80000-3) of an object and its length `l` (ISO 80000-3): `&#x3b5; = (&#x394;l)/l`&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="relativeLinearStrain">
      <typings>RelativeLinearStrainValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-17.3 shear strain */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ShearStrainValue">
      <superclassifiers>DimensionOneValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-17.3 shear strain&#xD;&#xA;         * symbol(s): `&#x3b3;`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: ShearStrain (specializes DimensionOneQuantity)&#xD;&#xA;         * quantity dimension: 1&#xD;&#xA;         * measurement unit(s): 1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of parallel displacement `&#x394;x` (ISO 80000-3) of two surfaces of a layer and the thickness `d` (ISO 80000-3) of the layer: `&#x3b3; = (&#x394;x)/d`&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="shearStrain">
      <typings>ShearStrainValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-17.4 relative volume strain */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="RelativeVolumeStrainValue">
      <superclassifiers>DimensionOneValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-17.4 relative volume strain&#xD;&#xA;         * symbol(s): `&#x3b8;`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: RelativeVolumeStrain (specializes DimensionOneQuantity)&#xD;&#xA;         * quantity dimension: 1&#xD;&#xA;         * measurement unit(s): 1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of change in volume `&#x394;V` (ISO 80000-3) of an object and its volume `V_0` (ISO 80000-3): `&#x3b8; = (&#x394;V)/V_0`&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="relativeVolumeStrain">
