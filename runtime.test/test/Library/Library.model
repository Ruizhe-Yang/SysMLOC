        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-13 angular impulse */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AngularImpulseValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-13 angular impulse (magnitude)&#xD;&#xA;         * symbol(s): `H`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: AngularImpulse&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-1&#xD;&#xA;         * measurement unit(s): N*m*s, kg*m^2*s^-1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: vector (ISO 80000-2) quantity describing the effect of moment of force during a time interval: `vec(H)(t_1; t_2) = int_(t_1)^(t_2) vec(M) dt` where `vec(M)` is moment of force (item 4-12.1), `t` is time (ISO 80000-3) and `[t_1, t_2]` is considered time interval&#xD;&#xA;         * remarks: For a time interval `[t_1, t_2]`, `vec(H)(t_1, t_2) = vec(L)(t_1) - vec(L)(t_2) = vec(&#x394;L)` where `vec(L)` is angular momentum.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>AngularImpulseUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="angularImpulse" MultiLow="*" isNonunique="true">
      <typings>AngularImpulseValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="AngularImpulseUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianAngularImpulse3dVector">
      <superclassifiers>'3dVectorQuantityValue'</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-13 angular impulse (vector)&#xD;&#xA;         * symbol(s): `vec(H)`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: AngularImpulse&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-1&#xD;&#xA;         * measurement unit(s): N*m*s, kg*m^2*s^-1&#xD;&#xA;         * tensor order: 1&#xD;&#xA;         * definition: vector (ISO 80000-2) quantity describing the effect of moment of force during a time interval: `vec(H)(t_1; t_2) = int_(t_1)^(t_2) vec(M) dt` where `vec(M)` is moment of force (item 4-12.1), `t` is time (ISO 80000-3) and `[t_1, t_2]` is considered time interval&#xD;&#xA;         * remarks: For a time interval `[t_1, t_2]`, `vec(H)(t_1, t_2) = vec(L)(t_1) - vec(L)(t_2) = vec(&#x394;L)` where `vec(L)` is angular momentum.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>CartesianAngularImpulse3dCoordinateFrame</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cartesianAngularImpulse3dVector">
      <typings>CartesianAngularImpulse3dVector</typings>
      <subsetting>vectorQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CartesianAngularImpulse3dCoordinateFrame">
      <superclassifiers>'3dCoordinateFrame'</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="true">
        <redefinitions>isOrthogonal</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="3">
        <typings>AngularImpulseUnit</typings>
        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-14.1 pressure */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PressureValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-14.1 pressure&#xD;&#xA;         * symbol(s): `p`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: Pressure&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of the component of a force normal to a surface and its area: `p = (vec(e_n) * vec(F)) / A` where `vec(e_n)` is unit vector of the surface normal, `vec(F)` is force (item 4-9.1) and `A` is area (ISO 80000-3)&#xD;&#xA;         * remarks: None.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>PressureUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pressure" MultiLow="*" isNonunique="true">
      <typings>PressureValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PressureUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-14.2 gauge pressure */"/>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="gaugePressure">
      <typings>PressureValue</typings>
      <subsetting>scalarQuantities</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-14.2 gauge pressure&#xD;&#xA;         * symbol(s): `p_e`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: GaugePressure (specializes Pressure)&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: pressure `p` (item 4-14.1) decremented by ambient pressure `p_amb` : `p_e = p - p_amb`&#xD;&#xA;         * remarks: Often, `p_amb` is chosen as a standard pressure. Gauge pressure is positive or negative.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-15 stress */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="StressValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-15 stress (magnitude)&#xD;&#xA;         * symbol(s): `&#x3c3;`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: Stress&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: tensor (ISO 80000-2) quantity representing state of tension of matter&#xD;&#xA;         * remarks: Stress tensor is symmetric and has three normal-stress and three shear-stress (Cartesian) components.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>StressUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="stress" MultiLow="*" isNonunique="true">
      <typings>StressValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="StressUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Cartesian3dStressTensor">
      <superclassifiers>TensorQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-15 stress (tensor)&#xD;&#xA;         * symbol(s): `vec(vec(&#x3c3;))`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: Stress&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 2&#xD;&#xA;         * definition: tensor (ISO 80000-2) quantity representing state of tension of matter&#xD;&#xA;         * remarks: Stress tensor is symmetric and has three normal-stress and three shear-stress (Cartesian) components.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="9">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>Cartesian3dStressMeasurementReference</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="stressTensor">
      <typings>Cartesian3dStressTensor</typings>
      <subsetting>tensorQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="Cartesian3dStressMeasurementReference">
      <superclassifiers>TensorMeasurementReference</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="(3, 3)">
        <redefinitions>dimensions</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="false">
        <redefinitions>isBound</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="9">
        <typings>StressUnit</typings>
        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-16.1 normal stress */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="NormalStressValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-16.1 normal stress&#xD;&#xA;         * symbol(s): `&#x3c3;_n`, `&#x3c3;`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: NormalStress&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: scalar (ISO 80000-2) quantity describing surface action of a force into a body equal to: `&#x3c3;_n = (d F_n)/(dA)` where `F_n` is the normal component of force (item 4-9.1) and `A` is the area (ISO 80000-3) of the surface element&#xD;&#xA;         * remarks: A couple of mutually opposite forces of magnitude `F` acting on the opposite surfaces of a slice (layer) of homogenous solid matter normal to it, and evenly distributed, cause a constant normal stress `&#x3c3;_n = F A` in the slice (layer).&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>NormalStressUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="normalStress" MultiLow="*" isNonunique="true">
      <typings>NormalStressValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="NormalStressUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>quantityDimension</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="(lengthPF, massPF, durationPF)">
          <redefinitions>quantityPowerFactors</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* ISO-80000-4 item 4-16.2 shear stress */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ShearStressValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-16.2 shear stress&#xD;&#xA;         * symbol(s): `&#x3c4;_s`, `&#x3c4;`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: ShearStress&#xD;&#xA;         * quantity dimension: L^-1*M^1*T^-2&#xD;&#xA;         * measurement unit(s): Pa, N*m^-2, kg*m^-1*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: scalar (ISO 80000-2) quantity describing surface action of a force into a body equal to: `&#x3c4;_s = (d F_t)/(dA)` where `F_t` is the tangential component of force (item 4-9.1) and `A` is the area (ISO 80000-3) of the surface element&#xD;&#xA;         * remarks: A couple of mutually opposite forces of magnitude `F` acting on the opposite surfaces of a slice (layer) of homogenous solid matter parallel to it, and evenly distributed, cause a constant shear stress `&#x3c4; = F/A` in the slice (layer).&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>ShearStressUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="shearStress" MultiLow="*" isNonunique="true">
      <typings>ShearStressValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="ShearStressUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="massPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.M">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="1">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="durationPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.T">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="-2">
          <redefinitions>exponent</redefinitions>
        </elements>
      </elements>
