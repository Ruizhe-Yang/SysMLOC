      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 9-7 molar heat capacity&#xD;&#xA;         * symbol(s): `C_m`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: MolarHeatCapacity&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-2*&#x398;^-1*N^-1&#xD;&#xA;         * measurement unit(s): J/(mol*K), kg*m^2*s^-2*K^-1*mol^-1&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quotient of heat capacity `C` (ISO 80000-5) and amount of substance `n` (item 9-2): `C_m = C/n`&#xD;&#xA;         * remarks: Conditions (constant pressure or volume etc.) must be specified.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>MolarHeatCapacityUnit</typings>
        <redefinitions>mRef</redefinitions>
