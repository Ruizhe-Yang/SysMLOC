        <redefinitions>mRefs</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="CartesianElectricDisplacement3dCoordinateFrame" memberElement="CartesianElectricFluxDensity3dCoordinateFrame"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="cartesianElectricDisplacement3dVector" memberElement="cartesianElectricFluxDensity3dVector"/>
    <elements xsi:type="sysMLOC:Comment" body="/* IEC-80000-6 item 6-13 capacitance */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="CapacitanceValue">
