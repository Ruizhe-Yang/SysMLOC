    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TorqueValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * source: item 4-12.2 torque&#xD;&#xA;         * symbol(s): `T`, `M_Q`&#xD;&#xA;         * application domain: generic&#xD;&#xA;         * name: Torque&#xD;&#xA;         * quantity dimension: L^2*M^1*T^-2&#xD;&#xA;         * measurement unit(s): N*m, kg*m^2*s^-2&#xD;&#xA;         * tensor order: 0&#xD;&#xA;         * definition: quantity described by the scalar product: `T = vec(M)*vec(e_Q)` where `vec(M)` is moment of force (item 4-12.1) and `vec(e_Q)` is unit vector of direction with respect to which the torque is considered&#xD;&#xA;         * remarks: For example, torque is the twisting moment of force with respect to the longitudinal axis of a beam or shaft.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <typings>Real</typings>
        <redefinitions>num</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" MultiLow="1">
        <typings>TorqueUnit</typings>
        <redefinitions>mRef</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="torque" MultiLow="*" isNonunique="true">
      <typings>TorqueValue</typings>
      <subsetting>scalarQuantities</subsetting>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TorqueUnit">
      <superclassifiers>DerivedUnit</superclassifiers>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="lengthPF" MultiLow="1">
        <typings>QuantityPowerFactor</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="isq.L">
          <redefinitions>quantity</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="2">
          <redefinitions>exponent</redefinitions>
        </elements>
