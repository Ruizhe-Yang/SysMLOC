      <typings>SurfaceTensionUnit</typings>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredShortName="'N&#x22c5;m&#x207b;&#xb2;'" declaredName="'newton metre to the power minus 2'" valuePart="N*m^-2">
      <typings>PressureUnit</typings>
    </elements>
