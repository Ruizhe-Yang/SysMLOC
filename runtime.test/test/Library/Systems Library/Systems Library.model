<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Actions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Actions" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for actions and related behavioral elements in the&#xD;&#xA;&#x9; * SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensWhile"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::Performance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::performances"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::SendPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::sendPerformances"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::AcceptPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::acceptPerformances"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="FeatureReferencingPerformances::FeatureWritePerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::MergePerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::DecisionPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::IfThenPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::IfThenElsePerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlPerformances::LoopPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TransitionPerformances::TransitionPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="TransitionPerformances::NonStateTransitionPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::MessageTransfer"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Flows::MessageAction"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="OccurrenceFunctions::destroy"/>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="Action">
      <superclassifiers>Performance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Action is the most general class of Performances of ActionDefinitions in a system or &#xD;&#xA;&#x9;&#x9; * part of a system. Action is the base class of all ActionDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ActionUsage" isReference="true" declaredName="self">
        <typings>Action</typings>
        <redefinitions>Performance::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isReference="true" declaredName="incomingTransfers">
        <redefinitions>Performance::incomingTransfers</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="start">
        <typings>Action</typings>
        <redefinitions>startShot</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The starting snapshot of an Action. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="done">
        <typings>Action</typings>
        <redefinitions>endShot</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ending snapshot of an Action.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="subactions" MultiLow="0" MultiHigh="*">
        <typings>Action</typings>
        <subsetting>actions</subsetting>
        <subsetting>subperformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subperformances of this Action that are Actions. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:OccurrenceUsage" isReference="true" valuePart="(that as Action).this">
          <redefinitions>Action::this</redefinitions>
          <redefinitions>actions::this</redefinitions>
          <redefinitions>subperformances::this</redefinitions>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * The &quot;this&quot; reference of a subaction is always the same as that of&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * its owning Action.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="sendSubactions" MultiLow="0" MultiHigh="*">
        <typings>SendAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>sendActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are SendActions. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="acceptSubactions" MultiLow="0" MultiHigh="*">
        <typings>AcceptAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>acceptActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are AcceptActions. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="terminateSubactions" MultiLow="0" MultiHigh="*">
        <typings>TerminateAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>terminateActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are TerminateActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="controls" MultiLow="0" MultiHigh="*">
        <typings>ControlAction</typings>
        <subsetting>subactions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are ControlActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="merges" MultiLow="0" MultiHigh="*">
        <typings>MergeAction</typings>
        <subsetting>controls</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The controls of this Action that are MergeActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="decisions">
        <typings>DecisionAction</typings>
        <subsetting>controls</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The controls of this Action that are DecisionActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="joins">
        <typings>JoinAction</typings>
        <subsetting>controls</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The controls of this Action that are JoinActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="forks">
        <typings>ForkAction</typings>
        <subsetting>controls</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The controls of this Action that are ForkActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="transitions" MultiLow="0" MultiHigh="*">
        <typings>TransitionAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>transitionActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are TransitionActions. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="decisionTransitions" MultiLow="0" MultiHigh="*">
        <typings>DecisionTransitionAction</typings>
        <subsetting>transitions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are DecisionTransitionActions. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="assignments" MultiLow="0" MultiHigh="*">
        <typings>AssignmentAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>assignmentActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are AssignmentActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="target"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="ifSubactions" MultiLow="0" MultiHigh="*">
        <typings>IfThenAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>ifThenActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are IfThenActions (including IfThenElseActions).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="loops" MultiLow="0" MultiHigh="*">
        <typings>LoopAction</typings>
        <subsetting>subactions</subsetting>
        <subsetting>loopActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Action that are LoopActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="whileLoops" MultiLow="0" MultiHigh="*">
        <typings>WhileLoopAction</typings>
        <subsetting>loops</subsetting>
        <subsetting>whileLoopActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The loops of this Action that are WhileLoopActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="forLoops" MultiLow="0" MultiHigh="*">
        <typings>ForLoopAction</typings>
        <subsetting>loops</subsetting>
        <subsetting>forLoopActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The loops of this Action that are ForLoopActions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="actions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Action</typings>
      <subsetting>performances</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * actions is the base feature for all ActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="SendAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>SendPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A SendAction is an Action used to type SendActionUsages. It initiates an outgoingTransferFromSelf &#xD;&#xA;&#x9;&#x9; * from a designated sender Occurrence with a given payload, optionally to a designated receiver.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" MultiLow="0" MultiHigh="*">
        <redefinitions>payload</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="sentMessage">
        <typings>MessageTransfer</typings>
        <typings>MessageAction</typings>
        <redefinitions>sentTransfer</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
          <redefinitions>MessageTransfer::payload</redefinitions>
          <redefinitions>MessageAction::payload</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="sendActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>SendAction</typings>
      <subsetting>actions</subsetting>
      <subsetting>sendPerformances</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * sendActions is the base feature for all SendActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AcceptMessageAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>AcceptPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An AcceptMessageAction is an Action that identifies an incomingTransferToSelf&#xD;&#xA;&#x9;&#x9; * of a designated receiver Occurrence, providing its payload as output.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="inout">
        <redefinitions>payload</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="acceptedMessage">
        <typings>MessageTransfer</typings>
        <typings>MessageAction</typings>
        <redefinitions>acceptedTransfer</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
          <redefinitions>MessageTransfer::payload</redefinitions>
          <redefinitions>MessageAction::payload</redefinitions>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AcceptAction">
      <superclassifiers>AcceptMessageAction</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An AcceptAction is an AcceptMessageAction used to type AcceptActionUsages that are&#xD;&#xA;&#x9;&#x9; * not accepters for TransitionActions. It waits for a payload or message of the specified &#xD;&#xA;&#x9;&#x9; * kind to be accepted by a nested state transition.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" valuePart="aState.aTransition.accepter.acceptedMessage">
        <redefinitions>acceptedMessage</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" declaredName="aState">
        <elements xsi:type="sysMLOC:TransitionUsage" declaredName="aTransition" transitionSourceElement="start">
          <acceptParameter declaredName="apayload" isVia="true" viaNodeParameter="receiver">
            <typings>Anything</typings>
          </acceptParameter>
          <transitionSuccessionElement refElement="done"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="payload"/>
        <connectorPart refElement="aState.aTransition.apayload"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="acceptActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>AcceptAction</typings>
      <subsetting>actions</subsetting>
      <subsetting>acceptPerformances</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * acceptActions is the base feature for standalone AcceptActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="TerminateAction">
      <superclassifiers>Action</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TerminateAction is an Action that terminates a given Occurrence, meaning &#xD;&#xA;&#x9;&#x9; * that the Occurrence ends during the performance of this Action. TerminateAction&#xD;&#xA;&#x9;&#x9; * is the base type for all TerminateActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" direction="in" declaredName="terminatedOccurrence" MultiLow="1">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Occurrence to be terminated.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="terminateOccurrence" MultiLow="1">
        <typings>destroy</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="occ" valuePart="terminatedOccurrence"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="terminateActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>TerminateAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * terminateActions is the base feature for all TerminateActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" direction="in" declaredName="terminatedOccurrence" isDefault="true" valuePart="that as Occurrence">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The default terminatedOccurrence for a terminateAction is its&#xD;&#xA;&#x9;&#x9;&#x9; * featuring occurrence (which will generally be a containing Action).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="ControlAction">
      <superclassifiers>Action</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ControlAction is the Action of a control node, which has no inherent behavior.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="start"/>
        <connectorPart refElement="done"/>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A ControlAction is instantaneous.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="MergeAction">
      <superclassifiers>ControlAction</superclassifiers>
      <superclassifiers>MergePerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A MergeAction is the ControlAction for a merge node.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: Incoming succession connectors to a MergeAction must have source multiplicity &#xD;&#xA;&#x9;&#x9; * 0..1 and subset the incomingHBLink feature inherited from MergePerformance.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="DecisionAction">
      <superclassifiers>ControlAction</superclassifiers>
      <superclassifiers>DecisionPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A DecisionAction is the ControlAction for a decision node.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: Outgoing succession connectors from a DecisionAction must have target multiplicity&#xD;&#xA;&#x9;&#x9; * 0..1 and subset the outgoingHBLink feature inherited from DecisionPerformance.&#xD;&#xA;&#x9;&#x9; * If an outgoing succession has a guard, it should have a transitionStep typed by &#xD;&#xA;&#x9;&#x9; * DecisionTransition.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="JoinAction">
      <superclassifiers>ControlAction</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A JoinAction is the ControlAction for a JoinNode.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: Join behavior results from requiring that the source multiplicity of all&#xD;&#xA;&#x9;&#x9; * incoming succession connectors be 1..1.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ForkAction">
      <superclassifiers>ControlAction</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ForkAction is the ControlAction for a ForkNode.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: Fork behavior results from requiring that the target multiplicity of all&#xD;&#xA;&#x9;&#x9; * outgoing succession connectors be 1..1.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="TransitionAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>TransitionPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TransitionAction is a TransitionPerformance with an Action as transitionLinkSource.&#xD;&#xA;&#x9;&#x9; * It is the base type of all TransitionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transitionLinkSource">
        <typings>Action</typings>
        <redefinitions>TransitionPerformance::transitionLinkSource</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="acceptedMessage">
        <typings>MessageTransfer</typings>
        <typings>MessageAction</typings>
        <redefinitions>trigger</redefinitions>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
          <redefinitions>MessageTransfer::payload</redefinitions>
          <redefinitions>MessageAction::payload</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="receiver">
        <redefinitions>triggerTarget</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="accepter">
        <typings>AcceptMessageAction</typings>
        <redefinitions>'accept'</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="receiver"/>
        <connectorPart refElement="accepter.receiver"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="acceptedMessage"/>
        <connectorPart refElement="accepter.acceptedMessage"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="effect">
        <typings>Action</typings>
        <redefinitions>TransitionPerformance::effect</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="DecisionTransitionAction">
      <superclassifiers>TransitionAction</superclassifiers>
      <superclassifiers>NonStateTransitionPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A DecisionTransitionAction is a TransitionAction and NonStateTransitionPerformance that has a &#xD;&#xA;&#x9;&#x9; * guard, but no trigger or effects. It is the base type of TransitionUsages used as &#xD;&#xA;&#x9;&#x9; * conditional successions in action models.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ActionUsage" isReference="true" MultiLow="0" MultiHigh="0">
        <redefinitions>accepter</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isReference="true" MultiLow="0" MultiHigh="0">
        <redefinitions>effect</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="transitionActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>TransitionAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * transitionActions is the base feature for all TransitionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AssignmentAction">
      <superclassifiers>FeatureWritePerformance</superclassifiers>
      <superclassifiers>Action</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An AssignmentAction is an Action, used to type an AssignmentActionUsage. It is also a&#xD;&#xA;&#x9;&#x9; * FeatureWritePerformance that updates the accessedFeature of its target Occurrence with&#xD;&#xA;&#x9;&#x9; * the given replacementValues.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="target" MultiLow="1">
        <typings>Occurrence</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="inout" declaredName="replacementValues" MultiLow="0" MultiHigh="*" isNonunique="true">
        <typings>Anything</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="assignmentActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>AssignmentAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * assignmentActions is the base feature for all AssignmentActionsUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="target" MultiLow="1" isDefault="true" valuePart="that as Occurrence">
        <typings>Occurrence</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * The default target for assignmentActions is its featuring instance (if that is &#xD;&#xA;             * an Occurrence).&#xD;&#xA;             */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="IfThenAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>IfThenPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfThenAction is a Kernel IfThenPerformance that is also an Action. &#xD;&#xA;&#x9;&#x9; * It is the base type for all IfActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="ifTest" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="thenClause" MultiLow="0" MultiHigh="1"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="IfThenElseAction">
      <superclassifiers>IfThenAction</superclassifiers>
      <superclassifiers>IfThenElsePerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An IfThenElseAction is a Kernel IfThenElsePeformance that is also an IfThenAction. &#xD;&#xA;&#x9;&#x9; * It is the base type for all IfActionUsages that have an elseAction.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="ifTest" MultiLow="1"/>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="thenClause" MultiLow="0" MultiHigh="1"/>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="elseClause" MultiLow="0" MultiHigh="1"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="ifThenActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>IfThenAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ifThenActions is the base feature for all IfActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="ifThenElseActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>IfThenElseAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ifThenElseActions is the base feature for all IfActionUsages that have an elseAction.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" isAbstract="true" declaredName="LoopAction">
      <superclassifiers>Action</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A LoopAction is the base type for all LoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="iterator"/>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="body" MultiLow="0" MultiHigh="*">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The action that is performed repeatedly in the loop.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="WhileLoopAction">
      <superclassifiers>LoopAction</superclassifiers>
      <superclassifiers>LoopPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A WhileLoopAction is a Kernel LoopPerformance that is also a LoopAction.&#xD;&#xA;&#x9;&#x9; * It is the base type for all WhileLoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="whileTest" isDefault="true" valuePart="{true}">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A Boolean expression that must be true for the loop to continue.&#xD;&#xA;&#x9;&#x9;&#x9; * It is evaluated before the body is performed and is always evaluated at &#xD;&#xA;&#x9;&#x9;&#x9; * least once.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="body">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The action that is performed while the whileTest is true and the&#xD;&#xA;&#x9;&#x9;&#x9; * untilTest is false.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="untilTest" isDefault="true" valuePart="{false}">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A Boolean expression that must be false for the loop to continue.&#xD;&#xA;&#x9;&#x9;&#x9; * It is evaluated after the body is performed.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ForLoopAction">
      <superclassifiers>LoopAction</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A ForLoopAction is a LoopAction that iterates over an ordered sequence of values.&#xD;&#xA;&#x9;&#x9; * It is the base type for all ForLoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" visibility="protected" declaredName="var" MultiLow="0" MultiHigh="1">
        <subsetting>seq</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The loop variable that is assigned successive elements of seq on each&#xD;&#xA;&#x9;&#x9;&#x9; * iteration of the loop.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" direction="in" declaredName="seq">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The sequence of values over which the loop iterates.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" direction="in" declaredName="body">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The action that is performed on each iteration of the loop.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="index">
        <typings>Positive</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The index of the element of seq assigned to var on the current iteration&#xD;&#xA;&#x9;&#x9;&#x9; * of the loop.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssignmentNode" visibility="private" declaredName="initialization" featureChain="index" NodeParameter="1"/>
      <elements xsi:type="sysMLOC:WhileLoopNode" isThen="true" visibility="private" declaredName="whileLoop" whileConditionExpression="index &lt;= size(seq)">
        <elements xsi:type="sysMLOC:AssignmentNode" featureChain="var" NodeParameter="seq#(index)"/>
        <elements xsi:type="sysMLOC:PerformActionUsage" isThen="true" refElement="body"/>
        <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" featureChain="index" NodeParameter="index + 1"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="loopActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>LoopAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * loopActions is the base feature for all LoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="whileLoopActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>WhileLoopAction</typings>
      <subsetting>loopActions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * whileLoopActions is the base feature for all WhileLoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="forLoopActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>ForLoopAction</typings>
      <subsetting>loopActions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * forLoopActions is the base feature for all ForLoopActionUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Actions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Allocations.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Allocations" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for allocations and related structural elements&#xD;&#xA;&#x9; * in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AllocationDefinition" declaredName="Allocation">
      <superclassifiers>BinaryConnection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Allocation is the most general class of allocation, represented as a connection &#xD;&#xA;&#x9;&#x9; * between the source of the allocation and the target. Allocation is the base type &#xD;&#xA;&#x9;&#x9; * of all AllocationDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="source" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryConnection::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="target" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryConnection::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AllocationUsage" isAbstract="true" declaredName="allocations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Allocation</typings>
      <subsetting>binaryConnections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * allocations is the base feature of all AllocationUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Allocations.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: AnalysisCases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="AnalysisCases" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for analysis cases and related behavioral elements &#xD;&#xA;&#x9; * in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::Evaluation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::evaluations"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Calculations::Calculation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::Case"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::cases"/>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" isAbstract="true" declaredName="AnalysisCase">
      <superclassifiers>Case</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * AnalysisCase is the most general class of performances of AnalysisCaseDefinitions. &#xD;&#xA;&#x9;&#x9; * AnalysisCase is the base class of all AnalysisCaseDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" isReference="true" declaredName="self">
        <typings>AnalysisCase</typings>
        <redefinitions>Case::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj">
        <redefinitions>Case::subj</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AnalysisCaseUsage" isAbstract="true" declaredName="subAnalysisCases" MultiLow="0" MultiHigh="*">
        <typings>AnalysisCase</typings>
        <subsetting>analysisCases</subsetting>
        <subsetting>subcases</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Other AnalysisCases carried out as part of the performance of this AnalysisCase.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseUsage" isAbstract="true" declaredName="analysisCases" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>AnalysisCase</typings>
      <subsetting>cases</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * analysisCases is the base feature of all AnalysisCaseUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: AnalysisCases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Attributes.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Attributes" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA; * This package defines the base types for attributes and related structural elements &#xD;&#xA; * in the SysML language.&#xD;&#xA; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::DataValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::dataValues"/>
    <elements xsi:type="sysMLOC:AliasElement" memberName="AttributeValue" memberElement="DataValue">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * AttributeValue is the most general type of data values that represent qualities or characteristics &#xD;&#xA;&#x9;&#x9; * of a system or part of a system. AttributeValue is the base type of all AttributeDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:AliasElement" memberName="attributeValues" memberElement="dataValues">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * attributeValues is the base feature for all AttributeUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Attributes.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Calculations.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Calculations" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for calculations and related behavioral elements in the&#xD;&#xA;&#x9; * SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::Evaluation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::evaluations"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::actions"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" isAbstract="true" declaredName="Calculation">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>Evaluation</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Calculation is the most general class of evaluations of CalculationDefinitions in a&#xD;&#xA;&#x9;&#x9; * system or part of a system. Calculation is the base class of all CalculationDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:CalculationUsage" isReference="true" declaredName="self">
        <typings>Calculation</typings>
        <redefinitions>Action::self</redefinitions>
        <redefinitions>Evaluation::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="subcalculations">
        <typings>Calculation</typings>
        <subsetting>calculations</subsetting>
        <subsetting>subactions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this Calculation that are Calculations.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CalculationUsage" isAbstract="true" declaredName="calculations" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Calculation</typings>
      <subsetting>actions</subsetting>
      <subsetting>evaluations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * calculations is the base Feature for all CalculationUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Calculations.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Cases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Cases" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for cases and related behavioral elements &#xD;&#xA;&#x9; * in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::RequirementCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Calculations::Calculation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Calculations::calculations"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:CaseDefinition" isAbstract="true" declaredName="Case">
      <superclassifiers>Calculation</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Case is the most general class of performances of CaseDefinitions. &#xD;&#xA;&#x9;&#x9; * Case is the base class of all CaseDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:CaseUsage" isReference="true" declaredName="self">
        <typings>Case</typings>
        <redefinitions>Calculation::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" MultiLow="1">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subject that was investigated by this Case.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="actors" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <subsetting>parts</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Parts that fill the role of actors for this Case.&#xD;&#xA;&#x9;&#x9;&#x9; * (Note: This is not itself an actor parameter, because specific actor&#xD;&#xA;&#x9;&#x9;&#x9; * parameters will be added for specific Cases.)&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="obj" MultiLow="1">
        <typings>RequirementCheck</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * A check of whether the objective RequirementUsage was satisfied for this Case.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" isDefault="true" valuePart="Case::result"/>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage" isReturn="true" declaredName="result" MultiLow="0" MultiHigh="*">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The result determined by the case, which should satisfy the case objective.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:CaseUsage" isAbstract="true" declaredName="subcases" MultiLow="0" MultiHigh="*">
        <typings>Case</typings>
        <subsetting>cases</subsetting>
        <subsetting>subcalculations</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Other Cases carried out as part of the performance of this Case.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CaseUsage" isAbstract="true" declaredName="cases" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Case</typings>
      <subsetting>calculations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * cases is the base Feature of all CaseUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Cases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Connections.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Connections" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines the base types for connections and related structural elements &#xD;&#xA;     * in the SysML language.&#xD;&#xA;     */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::LinkObject"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::linkObjects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::BinaryLinkObject"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::binaryLinkObjects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::Transfer"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::transfers"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::FlowTransfer"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::flowTransfers"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::FlowTransferBefore"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::flowTransfersBefore"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::actions"/>
    <elements xsi:type="sysMLOC:ConnectionDefinition" isAbstract="true" declaredName="Connection">
      <superclassifiers>LinkObject</superclassifiers>
      <superclassifiers>Part</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Connection is the most general class of links between things within some &#xD;&#xA;         * containing structure. Connection is the base type of all ConnectionDefinitions.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" isAbstract="true" declaredName="BinaryConnection">
      <superclassifiers>BinaryLinkObject</superclassifiers>
      <superclassifiers>Connection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * BinaryConnection is the most general class of binary links between two things &#xD;&#xA;         * within some containing structure. BinaryConnection is the base type of all &#xD;&#xA;         * ConnectionDefinitions with exactly two ends.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="source" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryLinkObject::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="target" isEnd="true">
        <typings>Anything</typings>
        <redefinitions>BinaryLinkObject::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="connections" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Connection</typings>
      <subsetting>linkObjects</subsetting>
      <subsetting>parts</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * connections is the base feature of all ConnectionUsages.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionUsage" isAbstract="true" declaredName="binaryConnections" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Connection</typings>
      <subsetting>connections</subsetting>
      <subsetting>binaryLinkObjects</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * binaryConnections is the base feature of all binary ConnectionUsages.&#xD;&#xA;         */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Connections.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Constraints.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Constraints" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for constraints and related elements in the&#xD;&#xA;&#x9; * SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::BooleanEvaluation"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::booleanEvaluations"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::trueEvaluations"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Performances::falseEvaluations"/>
    <elements xsi:type="sysMLOC:ConstraintDefinition" isAbstract="true" declaredName="ConstraintCheck">
      <superclassifiers>BooleanEvaluation</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ConstraintCheck is the most general class for constraint checking. ConstraintCheck is the base&#xD;&#xA;&#x9;&#x9; * type of all ConstraintDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConstraintUsage" isReference="true" declaredName="self">
        <typings>ConstraintCheck</typings>
        <redefinitions>BooleanEvaluation::self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintUsage" isAbstract="true" declaredName="constraintChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>ConstraintCheck</typings>
      <subsetting>booleanEvaluations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * constraintChecks is the base feature of all ConstraintUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintUsage" isAbstract="true" declaredName="assertedConstraintChecks">
      <subsetting>constraintChecks</subsetting>
      <subsetting>trueEvaluations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * assertedConstraintChecks is the subset of constraintChecks for ConstraintChecks asserted to be true.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConstraintUsage" isAbstract="true" declaredName="negatedConstraintChecks">
      <subsetting>constraintChecks</subsetting>
      <subsetting>falseEvaluations</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * negatedConstraintChecks is the subset of constraintChecks for ConstraintChecks asserted to be false.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Constraints.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Flows.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Flows" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines the base types for flows and related behavioral elements &#xD;&#xA;     * in the SysML language.&#xD;&#xA;     */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Links::Link"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensDuring"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::binaryLinkObjects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::Transfer"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::transfers"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::FlowTransfer"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::flowTransfers"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::FlowTransferBefore"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Transfers::flowTransfersBefore"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::actions"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:FlowDefinition" isAbstract="true" declaredName="MessageAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>Link</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * MessageAction is the most general class of actions that represent&#xD;&#xA;         * interactions between linked things. It is the base type of all&#xD;&#xA;         * FlowDefinitions.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="payload" MultiLow="0" MultiHigh="*">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         &#x9; * A payload that may be transferred during the interaction.&#xD;&#xA;         &#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:FlowDefinition" isAbstract="true" declaredName="Message">
      <superclassifiers>MessageAction</superclassifiers>
      <superclassifiers>Transfer</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Message is the subclass of message connections that represent &#xD;&#xA;         * a transfer of objects or values between two occurrences. It is &#xD;&#xA;         * the base type of all FlowUsages.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="payload">
        <redefinitions>MessageAction::payload</redefinitions>
        <redefinitions>Transfer::payload</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" visibility="private" isReference="true" declaredName="thisConnection" valuePart="self"/>
      <elements xsi:type="sysMLOC:EventOccurrenceUsage" direction="in" MultiLow="1" declaredName="sourceEvent" isDefault="true" valuePart="thisConnection.start">
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;             * An occurrence happening during the source of this message&#xD;&#xA;             * that is either the start of the mssage or happens before it.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:EventOccurrenceUsage" direction="in" MultiLow="1" declaredName="targetEvent" isDefault="true" valuePart="thisConnection.done">
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;             * An occurrence happening during the target of this message&#xD;&#xA;             * that is either the end of the message or happens after it.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>HappensDuring</typings>
        <connectorPart refElement="sourceEvent"/>
        <connectorPart MultiLow="1" refElement="source"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <typings>HappensDuring</typings>
        <connectorPart refElement="targetEvent"/>
        <connectorPart MultiLow="1" refElement="target"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="seBeforeNum" MultiLow="1" valuePart="if sourceEvent==thisConnection.start ? 0 else 1">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="teAfterNum" MultiLow="1" valuePart="if targetEvent==thisConnection.done ? 0 else 1">
        <typings>Natural</typings>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage" MultiLow="seBeforeNum">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="sourceEvent"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="self"/>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage" MultiLow="teAfterNum">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="self"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="targetEvent"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:FlowDefinition" isAbstract="true" declaredName="Flow">
      <superclassifiers>Message</superclassifiers>
      <superclassifiers>FlowTransfer</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Flow is a subclass of messages that are also flow transfers.&#xD;&#xA;         * It is the base type for FlowUsages that identify their source output and&#xD;&#xA;         * target input.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="source">
        <typings>Occurrence</typings>
        <redefinitions>Message::source</redefinitions>
        <redefinitions>FlowTransfer::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="target">
        <typings>Occurrence</typings>
        <redefinitions>Message::target</redefinitions>
        <redefinitions>FlowTransfer::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:FlowDefinition" isAbstract="true" declaredName="SuccessionFlow">
      <superclassifiers>Flow</superclassifiers>
      <superclassifiers>FlowTransferBefore</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * SuccessionFlow is a subclass of flowss that appen after their source and &#xD;&#xA;         * before their target. It is the base type for all SuccessionFlowUsages.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>SuccessionFlow</typings>
        <redefinitions>Flow::self</redefinitions>
        <redefinitions>FlowTransferBefore::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="source">
        <typings>Occurrence</typings>
        <redefinitions>Flow::source</redefinitions>
        <redefinitions>FlowTransferBefore::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="target">
        <typings>Occurrence</typings>
        <redefinitions>Flow::target</redefinitions>
        <redefinitions>FlowTransferBefore::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Message" isAbstract="true" declaredName="messages" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Message</typings>
      <subsetting>transfers</subsetting>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * messages is the base feature of all FlowUsages.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:FlowUsage" isAbstract="true" declaredName="flows" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Flow</typings>
      <subsetting>messages</subsetting>
      <subsetting>flowTransfers</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * flows is the base feature for FlowUsages that identify their source output&#xD;&#xA;         * and target input.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="source">
        <typings>Occurrence</typings>
        <redefinitions>Flow::source</redefinitions>
        <redefinitions>messages::source</redefinitions>
        <redefinitions>flowTransfers::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="target">
        <typings>Occurrence</typings>
        <redefinitions>Flow::target</redefinitions>
        <redefinitions>messages::target</redefinitions>
        <redefinitions>flowTransfers::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:FlowUsage" isAbstract="true" declaredName="successionFlows" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>SuccessionFlow</typings>
      <subsetting>flows</subsetting>
      <subsetting>flowTransfersBefore</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * successionFlows is the base feature of all SuccessionFlowUsages.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="source">
        <typings>Occurrence</typings>
        <redefinitions>SuccessionFlow::source</redefinitions>
        <redefinitions>flows::source</redefinitions>
        <redefinitions>flowTransfersBefore::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:OccurrenceUsage" isEnd="true" declaredName="target">
        <typings>Occurrence</typings>
        <redefinitions>SuccessionFlow::target</redefinitions>
        <redefinitions>flows::target</redefinitions>
        <redefinitions>flowTransfersBefore::target</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Flows.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Interfaces.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Interfaces" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines the base types for interfaces and related structural elements in the SysML language.&#xD;&#xA;     */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::Connection"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::connections"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::BinaryConnection"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Connections::binaryConnections"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Ports::Port"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Natural"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::excludingAt"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::selectOne"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:CalculationDefinition" visibility="private" declaredName="excludingOnce">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Return a sequence that is the same as the input sequence, but with a single&#xD;&#xA;         * instance of a given value removed. The given value must be in the input sequence.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="seq" MultiLow="1" MultiHigh="*" isOrdered="true" isNonunique="true"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="value" MultiLow="1">
        <subsetting>seq</subsetting>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" visibility="private" declaredName="position" MultiLow="1" valuePart="(1..size(seq))->selectOne{in i; seq#(i) == value}">
        <typings>Natural</typings>
      </elements>
      <resultExpressionParameter resultExpression="seq->excludingAt(position)"/>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceDefinition" isAbstract="true" declaredName="Interface">
      <superclassifiers>Connection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Interface is the most general class of links between Ports on Parts &#xD;&#xA;         * within some containing structure. Interface is the base type of all&#xD;&#xA;         * InterfaceDefinitions. &#xD;&#xA;         * &#xD;&#xA;         * Transfers outgoing from any one of the participant Ports of an Interface &#xD;&#xA;         * may be targeted to one of the other participant Ports (depending on any &#xD;&#xA;         * other Interfaces in which the Port is also participating).&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:PortUsage" isReference="true" MultiLow="2" MultiHigh="*" isOrdered="true" isNonunique="true">
        <typings>Port</typings>
        <redefinitions>participant</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * The participants of an Interface must be Ports. The interfacingPorts of&#xD;&#xA;             * each participant Port include all the other participants in the Interface.&#xD;&#xA;             */"/>
        <elements xsi:type="sysMLOC:ReferenceUsage" visibility="protected" declaredName="thisParticipant">
          <redefinitions>self</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ReferenceUsage" visibility="protected" declaredName="otherParticipants" MultiLow="1" MultiHigh="*" isNonunique="true" isDefault="true" valuePart="participant->excludingOnce(thisParticipant)">
          <typings>Port</typings>
          <subsetting>interfacingPorts</subsetting>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceDefinition" isAbstract="true" declaredName="BinaryInterface">
      <superclassifiers>Interface</superclassifiers>
      <superclassifiers>BinaryConnection</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * BinaryInterface is the most general class of links between two Ports &#xD;&#xA;         * on Parts within some containing structure. BinaryInterface is the base &#xD;&#xA;         * type of all binary InterfaceDefinitions which have exactly two ends. &#xD;&#xA;         * &#xD;&#xA;         * Transfers outgoing from each participant Port of a BinaryInterface may be &#xD;&#xA;         * targeted to the other participant Port (depending on any other Interfaces &#xD;&#xA;         * in which the Port is also participating).&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:PortUsage" isReference="true" MultiLow="2" isOrdered="true" isNonunique="true">
        <redefinitions>Interface::participant</redefinitions>
        <redefinitions>BinaryConnection::participant</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="source">
        <typings>Port</typings>
        <redefinitions>BinaryConnection::source</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="target">
        <typings>Port</typings>
        <redefinitions>BinaryConnection::target</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceUsage" isAbstract="true" declaredName="interfaces" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Interface</typings>
      <subsetting>connections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * interfaces is the base feature of all InterfaceUsages.&#xD;&#xA;         */"/>
    </elements>
    <elements xsi:type="sysMLOC:InterfaceUsage" isAbstract="true" declaredName="binaryInterfaces" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>BinaryInterface</typings>
      <subsetting>interfaces</subsetting>
      <subsetting>binaryConnections</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * interfaces is the base feature of all binary InterfaceUsages.&#xD;&#xA;         */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Interfaces.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Items.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Items" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for items and related structural elements in the&#xD;&#xA;&#x9; * SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::objects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::HappensWhile"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::JustOutsideOf"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::StructuredSpaceObject"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::ConstraintCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::constraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="CollectionFunctions::contains"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::isEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::includes"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::union"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::forAll"/>
    <elements xsi:type="sysMLOC:ItemDefinition" isAbstract="true" declaredName="Item">
      <superclassifiers>Object</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Item is the most general class of objects that are part of, exist in or flow through a system. &#xD;&#xA;&#x9;&#x9; * Item is the base type of all ItemDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>Item</typings>
        <redefinitions>Object::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="start">
        <typings>Item</typings>
        <redefinitions>startShot</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="done">
        <typings>Item</typings>
        <redefinitions>endShot</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="shape">
        <typings>Item</typings>
        <redefinitions>spaceBoundary</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The shape of an Item is its spatial boundary.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="envelopingShapes" MultiLow="0" MultiHigh="*">
        <typings>Item</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Each enveloping shape is the shape of an Item that spacially overlaps this Item for its&#xD;&#xA;&#x9;&#x9;&#x9; * entire lifetime.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="envelopedItem">
          <redefinitions>that</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;                 * Enables two dimensional items to be enveloped by two or three dimensional shapes.&#xD;&#xA;                 */"/>
          <resultExpressionParameter resultExpression="innerSpaceDimension == (if envelopedItem.innerSpaceDimension == 3 | envelopedItem.outerSpaceDimension == 3 ? 2 else envelopedItem.outerSpaceDimension - 1 )"/>
        </elements>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <resultExpressionParameter resultExpression="(that as Item).innerSpaceDimension &lt; 3 implies notEmpty(outerSpaceDimension)"/>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" declaredName="envelopingItem" MultiLow="1"/>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * This constraint prevents an envelopingShape from being a portion.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <resultExpressionParameter resultExpression="envelopingItem.shape.spaceTimeCoincidentOccurrences->includes(that) and envelopingItem.spaceTimeEnclosedOccurrences->includes(that.that)"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="boundingShapes" MultiLow="0" MultiHigh="*">
        <typings>StructuredSpaceObject</typings>
        <subsetting>envelopingShapes</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * envelopingShapes that are structured space objects with every face or every edge&#xD;&#xA;&#x9;&#x9;&#x9; * intersecting this Item.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="boundingShape">
          <typings>Item</typings>
          <redefinitions>self</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" visibility="private">
          <redefinitions>faces</redefinitions>
          <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="face">
            <redefinitions>self</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" declaredName="inter" MultiLow="1"/>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="contains(inter.intersectionsOf, union(face, boundingShape))"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" visibility="private">
          <redefinitions>edges</redefinitions>
          <elements xsi:type="sysMLOC:ItemUsage" isReference="true" declaredName="edge">
            <redefinitions>self</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" declaredName="inter" MultiLow="1"/>
          <elements xsi:type="sysMLOC:AssertConstraintUsage">
            <resultExpressionParameter resultExpression="isEmpty(faces) implies contains(inter.intersectionsOf, union(edge, boundingShape))"/>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" declaredName="voids" MultiLow="0" MultiHigh="*">
        <redefinitions>innerSpaceOccurrences</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Voids are inner space occurrences of this Item.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="isSolid" valuePart="isEmpty(voids)">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * An Item is solid if it has no voids.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isAbstract="true" declaredName="subitems" MultiLow="0" MultiHigh="*">
        <typings>Item</typings>
        <subsetting>items</subsetting>
        <subsetting>subobjects</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Items that are composite subitems of this Item.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:ReferenceUsage" visibility="private">
          <redefinitions>Item::incomingTransferSort</redefinitions>
          <redefinitions>subobjects::incomingTransferSort</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="subparts" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <subsetting>subitems</subsetting>
        <subsetting>parts</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subitems of this Item that are Parts.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" isAbstract="true" declaredName="checkedConstraints" MultiLow="0" MultiHigh="*">
        <typings>ConstraintCheck</typings>
        <subsetting>constraintChecks</subsetting>
        <subsetting>ownedPerformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Constraints that have been checked by this Item.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="Touches">
      <superclassifiers>JustOutsideOf</superclassifiers>
      <superclassifiers>HappensWhile</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Touching items are just outside each other and happen at the same time.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="touchedItemToo">
        <crossEndUsage MultiLow="0" MultiHigh="*" declaredName="touchesToo"/>
        <redefinitions>separateSpaceToo</redefinitions>
        <redefinitions>thisOccurrence</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ItemUsage" isEnd="true" declaredName="touchedItem">
        <crossEndUsage MultiLow="0" MultiHigh="*" declaredName="touches"/>
        <redefinitions>separateSpace</redefinitions>
        <redefinitions>thatOccurrence</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemUsage" isAbstract="true" declaredName="items" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Item</typings>
      <subsetting>objects</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * items is the base feature of all ItemUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Items.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Metadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Metadata" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA; * This package defines the base types for metadata definitions and related &#xD;&#xA; * metadata annotations in the SysML language.&#xD;&#xA; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::Metaobject"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Metaobjects::metaobjects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::Item"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::items"/>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="MetadataItem" isAbstract="true">
      <superclassifiers>Metaobject</superclassifiers>
      <superclassifiers>Item</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * MetadataItem is the most general class of Items that represent Metaobjects. &#xD;&#xA;&#x9;&#x9; * MetadataItem is the base type of all MetadataDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>MetadataItem</typings>
        <redefinitions>Metaobject::self</redefinitions>
        <redefinitions>Item::self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ItemUsage" isAbstract="true" declaredName="metadataItems" MultiLow="0" MultiHigh="*">
      <typings>MetadataItem</typings>
      <subsetting>metaobjects</subsetting>
      <subsetting>items</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * metadataItems is the base feature of all MetadataUsages.&#xD;&#xA;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9; * Note: It is not itself a MetadataUsage, because it is not being used as an&#xD;&#xA;&#x9;&#x9; * AnnotatingElement here.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Metadata.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Parts.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Parts" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA; * This package defines the base types for parts and related structural elements in the&#xD;&#xA; * SysML language.&#xD;&#xA; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::objects"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::Item"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Items::items"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Ports::Port"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Ports::ports"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::actions"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="States::StateAction"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="States::stateActions"/>
    <elements xsi:type="sysMLOC:PartDefinition" isAbstract="true" declaredName="Part">
      <superclassifiers>Item</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Part is the most general class of objects that represent all or a part of a system.&#xD;&#xA;&#x9;&#x9; * Part is the base type of all PartDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>Part</typings>
        <redefinitions>Item::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="start">
        <typings>Part</typings>
        <redefinitions>Item::start</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="done">
        <typings>Part</typings>
        <redefinitions>Item::done</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isAbstract="true" declaredName="ownedPorts" MultiLow="0" MultiHigh="*">
        <typings>Port</typings>
        <subsetting>ports</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Ports that are owned by this Part.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" isReference="true" declaredName="performedActions" MultiLow="0" MultiHigh="*">
        <typings>Action</typings>
        <subsetting>actions</subsetting>
        <subsetting>enactedPerformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Actions that are performed by this Part.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="ownedActions" MultiLow="0" MultiHigh="*">
        <typings>Action</typings>
        <subsetting>actions</subsetting>
        <subsetting>ownedPerformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Actions that are owned by this Part.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="this" valuePart="that as Part">
          <typings>Part</typings>
          <redefinitions>Action::this</redefinitions>
          <redefinitions>ownedPerformances::this</redefinitions>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * The &quot;this&quot; reference of an ownedAction is always its owning Part.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isAbstract="true" isReference="true" declaredName="exhibitedStates" MultiLow="0" MultiHigh="*">
        <typings>StateAction</typings>
        <subsetting>stateActions</subsetting>
        <subsetting>performedActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * StateActions that are exhibited by this Part.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isAbstract="true" declaredName="ownedStates" MultiLow="0" MultiHigh="*">
        <typings>StateAction</typings>
        <subsetting>stateActions</subsetting>
        <subsetting>ownedActions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * StateActions that are owned by this Part.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" isAbstract="true" declaredName="parts" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Part</typings>
      <subsetting>items</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * parts is the base feature of all part properties.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Parts.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Ports.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Ports" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;     * This package defines the base types for ports and related structural elements &#xD;&#xA;     * in the SysML language.&#xD;&#xA;     */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::Object"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Objects::objects"/>
    <elements xsi:type="sysMLOC:PortDefinition" isAbstract="true" declaredName="Port">
      <superclassifiers>Object</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * Port is the most general class of objects that represent connection points&#xD;&#xA;         * for interacting with a Part. Port is the base type of all PortDefinitions.&#xD;&#xA;         * &#xD;&#xA;         * Transfers outgoing from a Port are always targeted to a Port connected to&#xD;&#xA;         * the original Port by an Interface.&#xD;&#xA;         */"/>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="self">
        <typings>Port</typings>
        <redefinitions>Object::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="subports" MultiLow="0" MultiHigh="*">
        <typings>Port</typings>
        <subsetting>ports</subsetting>
        <subsetting>timeEnclosedOccurrences</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * The Ports that are subports of this Port.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isAbstract="true" isReference="true" declaredName="interfacingPorts" MultiLow="0" MultiHigh="*" isNonunique="true">
        <typings>Port</typings>
        <subsetting>ports</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * Ports that are connected to this Port by an Interface.&#xD;&#xA;             */"/>
      </elements>
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <subsetting>interfacingPorts.incomingTransfersToSelf</subsetting>
        <redefinitions>outgoingTransfersFromSelf</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/* &#xD;&#xA;             * The target of each of the outgoingTransfersFromSelf of a Port must be an interfacingPort.&#xD;&#xA;             */"/>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="source"/>
        <elements xsi:type="sysMLOC:ReferenceUsage" isEnd="true" declaredName="target"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortUsage" isAbstract="true" declaredName="ports" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Port</typings>
      <subsetting>objects</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * ports is the base feature of all PortUsages.&#xD;&#xA;         */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Ports.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Requirements.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Requirements" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for requirements and related elements in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Base::Anything"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::String"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions::allTrue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::constraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::assertedConstraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Constraints::negatedConstraintChecks"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Interfaces::Interface"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Attributes::AttributeValue"/>
    <elements xsi:type="sysMLOC:ConstraintDefinition" visibility="private" isAbstract="true" declaredName="RequirementConstraintCheck">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * RequirementConstraintCheck is the base ConstraintCheck for RequirementCheck, defining the&#xD;&#xA;&#x9;&#x9; * separate assumptions and required constraints such that, if all the assumptions are true,&#xD;&#xA;&#x9;&#x9; * then all the required constraints must be true.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="assumptions" MultiLow="0" MultiHigh="*">
        <subsetting>constraintChecks</subsetting>
        <subsetting>subperformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Assumptions that must hold for the required constraints to apply.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="constraints" MultiLow="0" MultiHigh="*">
        <subsetting>constraintChecks</subsetting>
        <subsetting>subperformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The required constraints that are to be checked.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="result" valuePart="allTrue(assumptions()) implies allTrue(constraints())">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * If all the assumptions are true, then all the required constraints must hold.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" isAbstract="true" declaredName="RequirementCheck">
      <superclassifiers>RequirementConstraintCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * RequirementCheck is the most general class for requirements checking. RequirementsCheck is the base&#xD;&#xA;&#x9;&#x9; * type of all requirement definitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:RequirementUsage" isReference="true">
        <typings>RequirementCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" MultiLow="1">
        <typings>Anything</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The entity that is being checked for satisfaction of the required constraints.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="actors" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Parts that fill the role of actors for this RequirementCheck.&#xD;&#xA;&#x9;&#x9;&#x9; * (Note: This is not itself an actor parameter, because specific actor&#xD;&#xA;&#x9;&#x9;&#x9; * parameters will be added for specific RequirementChecks.)&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="stakeholders" MultiLow="0" MultiHigh="*">
        <typings>Part</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Parts that represent stakeholders interested in the concern being checked.&#xD;&#xA;&#x9;&#x9;&#x9; * (Note: This is not itself a stakeholder parameter, because specific stakeholder&#xD;&#xA;&#x9;&#x9;&#x9; * parameters will be added for specific RequirementChecks.)&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/* &#xD;&#xA;&#x9;&#x9; * Note: assumptions and constraints are redefined here solely to simplify the&#xD;&#xA;&#x9;&#x9; * resolution of their qualified names as library elements.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="assumptions">
        <redefinitions>RequirementConstraintCheck::assumptions</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ConstraintUsage" declaredName="constraints">
        <redefinitions>RequirementConstraintCheck::constraints</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="subrequirements" MultiLow="0" MultiHigh="*">
        <subsetting>requirementChecks</subsetting>
        <subsetting>constraints</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Nested requirements, which are also required constraints.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ConcernUsage" isAbstract="true" declaredName="concerns" MultiLow="0" MultiHigh="*">
        <subsetting>concernChecks</subsetting>
        <subsetting>subrequirements</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The checks of any concerns being addressed (as required constraints).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="FunctionalRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A functional requirement specifies an action that a system, or part of a system, must perform.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Action</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="InterfaceRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * An interface requirement specifies an interface for connecting systems and system parts, which&#xD;&#xA;&#x9;&#x9; * optionally may include item flows across the interface and/or interface constraints.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Interface</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="PerformanceRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A performance requirement quantitavely measures the extent to which a system, or a system part, &#xD;&#xA;&#x9;&#x9; * satisfies a required capability or condition.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>AttributeValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="PhysicalRequirementCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A physical requirement specifies physical characteristics and/or physical constraints of the &#xD;&#xA;&#x9;&#x9; * system, or a system part.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Part</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementDefinition" declaredName="DesignConstraintCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A design constraint specifies a constraint on the implementation of the system or system part, &#xD;&#xA;&#x9;&#x9; * such as the system must use a commercial off the shelf component.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:SubjectUsage">
        <typings>Part</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ConcernDefinition" declaredName="ConcernCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ConcernCheck is the most general class for concern checking. ConcernCheck is the base type of &#xD;&#xA;&#x9;&#x9; * all ConcernDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ConcernUsage" isReference="true">
        <typings>ConcernCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="requirementChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>RequirementCheck</typings>
      <subsetting>constraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * requirementChecks is the base feature of all requirement usages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="satisfiedRequirementChecks">
      <subsetting>requirementChecks</subsetting>
      <subsetting>assertedConstraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * satisfiedRequirementChecks is the subset of requirementChecks for Requirements asserted to be satisfied.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RequirementUsage" isAbstract="true" declaredName="notSatisfiedRequirementChecks" MultiLow="0" MultiHigh="*">
      <typings>RequirementCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <subsetting>negatedConstraintChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * notSatisfiedRequirementChecks is the subset of requirementChecks for Requirements asserted to be not satisfied.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ConcernUsage" isAbstract="true" declaredName="concernChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>ConcernCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * concernChecks is the base feature of all ConcernUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Requirements.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: StandardViewDefinitions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="StandardViewDefinitions" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;         * This package defines the standard view definitions for the SysML language.&#xD;&#xA;         */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="SysML" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="gv" declaredName="GeneralView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present any members of exposed model element(s).&#xD;&#xA;             * This is the most general view, enabling presentation of any model element.&#xD;&#xA;             * The typical rendering in graphical notation is as a graph of nodes and edges.&#xD;&#xA;             * Specializations of GeneralView can be specified through appropriate selection of filters, e.g.:&#xD;&#xA;             * - package view, filtering on Package, Package containment, package Import&#xD;&#xA;             * - definition and usage view, filtering on Definition, Usage, Specialization, FeatureTyping (covering defined by)&#xD;&#xA;             * - requirement view, filtering on RequirementDefinition, RequirementUsage, Specialization, FeatureTyping, &#xD;&#xA;             *   SatisfyRequirementUsage, AllocationDefinition, AllocationUsage,&#xD;&#xA;             * - view and viewpoint view, filtering on ViewDefinition, ViewUsage, ViewpointDefinition, ViewpointUsage, &#xD;&#xA;             *   RenderingDefinition, RenderingUsage, ConcernDefinition, ConcernUsage, StakeholderMembership, ...&#xD;&#xA;             * - language extension view, filtering on Metaclass, MetadataFeature, MetadataAccessExpression, ...&#xD;&#xA;             * Note: filters are specified by referencing concepts from the KerML.kerml and SysML.sysml standard library packages.&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="iv" declaredName="InterconnectionView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present exposed features as nodes, nested features as&#xD;&#xA;             * nested nodes, and connections between features&#xD;&#xA;             * as edges between (nested) nodes. Nested nodes may present boundary features&#xD;&#xA;             * (e.g., ports, parameters).&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="afv" declaredName="ActionFlowView">
      <superclassifiers>InterconnectionView</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present connections between actions.&#xD;&#xA;             * Valid nodes and edges in an ActionFlowView are:&#xD;&#xA;             * - Actions with nested actions&#xD;&#xA;             * - Parameters with direction&#xD;&#xA;             * - Flow connection usages (e.g., kinds of transfers from output to input)&#xD;&#xA;             * - Binding connections between parameters (e.g., delegate a parameter from&#xD;&#xA;             *   one level of nesting to another)&#xD;&#xA;             * - Proxy connection points&#xD;&#xA;             * - Swim lanes&#xD;&#xA;             * - Conditional succession&#xD;&#xA;             * - Control nodes (fork, join, decision, merge)&#xD;&#xA;             * - Control structures, e.g., if-then-else, until-while-loop, for-loop&#xD;&#xA;             * - Send and accept actions&#xD;&#xA;             * - Change and time triggers&#xD;&#xA;             * - Compartments on actions and parameters&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="stv" declaredName="StateTransitionView">
      <superclassifiers>InterconnectionView</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present states and their transitions.&#xD;&#xA;             * Valid nodes and edges in a StateTransitionView are:&#xD;&#xA;             * - States with nested states&#xD;&#xA;             * - Entry, do, and exit actions&#xD;&#xA;             * - Transition usages with triggers, guards, and actions&#xD;&#xA;             * - Compartments on states&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="sv" declaredName="SequenceView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present time ordering of event occurrences on lifelines&#xD;&#xA;             * of exposed features.&#xD;&#xA;             * Valid nodes and edges in a SequenceView are:&#xD;&#xA;             * - Features such as parts with their lifelines&#xD;&#xA;             * - Event occurrences on the lifelines&#xD;&#xA;             * - Messages sent from one part to another with and without a type of flow&#xD;&#xA;             * - Succession between event occurrences&#xD;&#xA;             * - Nested sequence view (e.g., a reference to a view)&#xD;&#xA;             * - Compartments&#xD;&#xA;             * The typical rendering in graphical notation depicts the exposed features&#xD;&#xA;             * horizontally along the top, with vertical lifelines. The time axis is&#xD;&#xA;             * vertical, with time increasing from top to bottom.&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="gev" declaredName="GeometryView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present a visualization of exposed spatial items in two&#xD;&#xA;             * or three dimensions&#xD;&#xA;             * Valid nodes and edges in a GeometryView are:&#xD;&#xA;             * - Spatial item, including shape&#xD;&#xA;             * - Coordinate frame&#xD;&#xA;             * - Feature related to spatial item, such as a quantity (e.g. temperature)&#xD;&#xA;             *   of which values are to be rendered on a color scale&#xD;&#xA;             * The typical rendering in graphical notation would include a number of&#xD;&#xA;             * visualization parameters, such as:&#xD;&#xA;             * - 2D or 3D view&#xD;&#xA;             * - viewing direction&#xD;&#xA;             * - zoom level&#xD;&#xA;             * - light sources&#xD;&#xA;             * - object projection mode, e.g., isometric, perspective, orthographic&#xD;&#xA;             * - object rendering mode, e.g., shaded, wireframe, hidden line&#xD;&#xA;             * - object pan (placement) and rotate (orientation) settings&#xD;&#xA;             * - color maps&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="grv" declaredName="GridView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present exposed model elements and their relationships,&#xD;&#xA;             * arranged in a rectangular grid.&#xD;&#xA;             * GridView is the generalization of the following more specialized views:&#xD;&#xA;             * - Tabular view&#xD;&#xA;             * - Data value tabular view&#xD;&#xA;             * - Relationship matrix view, e.g. presenting allocation or dependency relationships&#xD;&#xA;             */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredShortName="bv" declaredName="BrowserView">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;             * View definition to present the hierarchical membership structure of model&#xD;&#xA;             * elements starting from one or more exposed root elements.&#xD;&#xA;             * The typical rendering in graphical notation is as an indented list of rows,&#xD;&#xA;             * consisting of dynamically collapsible-expandable nodes that represent&#xD;&#xA;             * branches and leaves of the tree, as in graphical user interface widgets.&#xD;&#xA;             */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: StandardViewDefinitions.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: States.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="States" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for states and related behavioral elements in the&#xD;&#xA;&#x9; * SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Occurrences::Occurrence"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="StatePerformances::StatePerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="StatePerformances::StateTransitionPerformance"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::Action"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::TransitionAction"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::transitionActions"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::AcceptAction"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Actions::actions"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::notEmpty"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:StateDefinition" isAbstract="true" declaredName="StateAction">
      <superclassifiers>Action</superclassifiers>
      <superclassifiers>StatePerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A StateAction is a kind of Action that is also a StatePerformance. It is the base type for all&#xD;&#xA;&#x9;&#x9; * StateDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EntryActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="entryAction">
          <redefinitions>'entry'</redefinitions>
        </performedActionParameterPart>
      </elements>
      <elements xsi:type="sysMLOC:DoActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="doAction">
          <typings>Action</typings>
          <redefinitions>'do'</redefinitions>
        </performedActionParameterPart>
      </elements>
      <elements xsi:type="sysMLOC:ExitActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" declaredName="exitAction">
          <typings>Action</typings>
          <redefinitions>'exit'</redefinitions>
        </performedActionParameterPart>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage">
        <redefinitions>isTriggerDuring</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isReference="true" declaredName="self">
        <typings>StateAction</typings>
        <redefinitions>Action::self</redefinitions>
        <redefinitions>StatePerformance::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isReference="true" declaredName="start">
        <typings>StateAction</typings>
        <redefinitions>Action::start</redefinitions>
        <redefinitions>StatePerformance::startShot</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isReference="true" declaredName="done">
        <typings>StateAction</typings>
        <redefinitions>Action::done</redefinitions>
        <redefinitions>StatePerformance::endShot</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage">
        <subsetting>middle</subsetting>
        <redefinitions>subactions</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subperformances of this StateAction that are Actions, other than the entry and exit Actions. &#xD;&#xA;&#x9;&#x9;&#x9; * These subactions all take place in the &quot;middle&quot; of the StatePerformance, that is, after the &#xD;&#xA;&#x9;&#x9;&#x9; * entry Action and before the exit Action. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="substates" MultiLow="0" MultiHigh="*">
        <typings>StateAction</typings>
        <subsetting>stateActions</subsetting>
        <subsetting>subactions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subactions of this state that are states.&#xD;&#xA;&#x9;&#x9;&#x9; * &#xD;&#xA;&#x9;&#x9;&#x9; * NOTE: This feature is declared as an ActionUsage, not a StateUsage, so that the constraint &#xD;&#xA; &#x9;&#x9;&#x9; * checkStateUsageExclusiveStateSpecialization does not apply to it, since this constraint &#xD;&#xA;&#x9;&#x9;&#x9; * would otherwise incorrectly require that &quot;substates&quot; subset &quot;exclusiveStates&quot;.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:StateUsage" isAbstract="true" declaredName="exclusiveStates" MultiLow="0" MultiHigh="*">
        <typings>StateAction</typings>
        <subsetting>substates</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The substates of this state that are mutually exclusive, that is, whose performances do not&#xD;&#xA;&#x9;&#x9;&#x9; * overlap in time.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isAbstract="true" declaredName="stateTransitions" MultiLow="0" MultiHigh="*">
        <typings>StateTransitionAction</typings>
        <subsetting>transitions</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The transitions of this state that are state transitions.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage" declaredName="stateSequencing">
        <connectorPart MultiLow="0" MultiHigh="1" refElement="exclusiveStates"/>
        <connectorPart MultiLow="0" MultiHigh="1" refElement="exclusiveStates"/>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Exclusive states cannot overlap, so it must be possible to strictly sequence them in time.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="notEmpty(exclusiveStates) implies size(stateSequencing) == size(exclusiveStates) - 1"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="StateTransitionAction">
      <superclassifiers>TransitionAction</superclassifiers>
      <superclassifiers>StateTransitionPerformance</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A StateTransitionAction is a TransitionAction and a StateTransitionPerformance whose transitionLinkSource &#xD;&#xA;&#x9;&#x9; * is a State. It is the base type of TransitionUsages used transitions in state models.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="transitionLinkSource" MultiLow="1">
        <typings>StateAction</typings>
        <redefinitions>TransitionAction::transitionLinkSource</redefinitions>
        <redefinitions>StateTransitionPerformance::transitionLinkSource</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="inout" declaredName="payload" MultiLow="0" MultiHigh="*"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in">
        <redefinitions>receiver</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="payload"/>
        <connectorPart refElement="accepter.payload"/>
      </elements>
      <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
        <connectorPart refElement="receiver"/>
        <connectorPart refElement="accepter.receiver"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" isAbstract="true" declaredName="stateActions" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>StateAction</typings>
      <subsetting>actions</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * stateActions is the base feature for all StateUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: States.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: SysML.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="SysML" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package contains a reflective KerML model of the KerML abstract syntax.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="Systems" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Systems">
      <elements xsi:type="sysMLOC:ImportElement" visibility="public" declaredName="KerML::Kernel" isNamespace="true"/>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AcceptActionUsage">
        <superclassifiers>ActionUsage</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="receiverArgument" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="payloadParameter" MultiLow="1" MultiHigh="1">
          <typings>ReferenceUsage</typings>
          <subsetting>nestedReference</subsetting>
          <subsetting>parameter</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="payloadArgument" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ActionDefinition">
        <superclassifiers>Behavior</superclassifiers>
        <superclassifiers>OccurrenceDefinition</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="'action'" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>ActionUsage</typings>
          <subsetting>step</subsetting>
          <subsetting>usage</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ActionUsage">
        <superclassifiers>Step</superclassifiers>
        <superclassifiers>OccurrenceUsage</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="actionDefinition" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>Behavior</typings>
          <subsetting>Metadata::metadataItems</subsetting>
          <redefinitions>behavior</redefinitions>
          <redefinitions>occurrenceDefinition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="ActorMembership">
        <superclassifiers>ParameterMembership</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" declaredName="ownedActorParameter" MultiLow="1" MultiHigh="1">
          <typings>PartUsage</typings>
          <subsetting>Metadata::metadataItems</subsetting>
          <redefinitions>ownedMemberParameter</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AllocationDefinition">
        <superclassifiers>ConnectionDefinition</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="'allocation'" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>AllocationUsage</typings>
          <subsetting>usage</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AllocationUsage">
        <superclassifiers>ConnectionUsage</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="allocationDefinition" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>AllocationDefinition</typings>
          <subsetting>Metadata::metadataItems</subsetting>
          <redefinitions>connectionDefinition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AnalysisCaseDefinition">
        <superclassifiers>CaseDefinition</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="resultExpression" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>expression</subsetting>
          <subsetting>ownedFeature</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AnalysisCaseUsage">
        <superclassifiers>CaseUsage</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="analysisCaseDefinition" MultiLow="0" MultiHigh="1">
          <typings>AnalysisCaseDefinition</typings>
          <subsetting>Metadata::metadataItems</subsetting>
          <redefinitions>caseDefinition</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="resultExpression" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>ownedFeature</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AssertConstraintUsage">
        <superclassifiers>ConstraintUsage</superclassifiers>
        <superclassifiers>Invariant</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="assertedConstraint" MultiLow="1" MultiHigh="1">
          <typings>ConstraintUsage</typings>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AssignmentActionUsage">
        <superclassifiers>ActionUsage</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="targetArgument" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="valueExpression" MultiLow="0" MultiHigh="1">
          <typings>Expression</typings>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="referent" MultiLow="1" MultiHigh="1">
          <typings>Feature</typings>
          <subsetting>member</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AttributeDefinition">
        <superclassifiers>DataType</superclassifiers>
        <superclassifiers>Definition</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="AttributeUsage">
        <superclassifiers>Usage</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" isDerived="true" declaredName="isReference" MultiLow="1" MultiHigh="1">
          <typings>Boolean</typings>
          <redefinitions>isReference</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="attributeDefinition" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>DataType</typings>
          <subsetting>Metadata::metadataItems</subsetting>
          <redefinitions>definition</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="BindingConnectorAsUsage">
        <superclassifiers>BindingConnector</superclassifiers>
        <superclassifiers>ConnectorAsUsage</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="CalculationDefinition">
        <superclassifiers>Function</superclassifiers>
        <superclassifiers>ActionDefinition</superclassifiers>
        <elements xsi:type="sysMLOC:ItemUsage" isDerived="true" isReference="true" declaredName="calculation" MultiLow="0" MultiHigh="*" isOrdered="true">
          <typings>CalculationUsage</typings>
          <subsetting>'action'</subsetting>
          <subsetting>expression</subsetting>
          <subsetting>Metadata::metadataItems</subsetting>
