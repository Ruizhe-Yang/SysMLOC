  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="UseCases" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for use cases and related behavioral elements in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::Case"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::cases"/>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="UseCase">
      <superclassifiers>Case</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * UseCase is the most general class of performances of UseCaseDefinitions. &#xD;&#xA;&#x9;&#x9; * UseCase is the base class of all UseCaseDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:UseCaseUsage" isReference="true" declaredName="self">
        <typings>UseCase</typings>
        <redefinitions>Case::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj">
        <redefinitions>Case::subj</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="obj">
        <redefinitions>Case::obj</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:UseCaseUsage" isReference="true" declaredName="start">
        <typings>UseCase</typings>
        <redefinitions>start</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The starting snapshot of a Use Case. &#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:UseCaseUsage" isReference="true" declaredName="done">
        <typings>UseCase</typings>
        <redefinitions>done</redefinitions>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The ending snapshot of a Use Case.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:UseCaseUsage" isAbstract="true" declaredName="subUseCases" MultiLow="0" MultiHigh="*">
        <typings>UseCase</typings>
        <subsetting>useCases</subsetting>
        <subsetting>subcases</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Other UseCases carried out as part of the performance of this UseCase.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:UseCaseUsage" isAbstract="true" isReference="true" declaredName="includedUseCases" MultiLow="0" MultiHigh="*">
        <typings>UseCase</typings>
        <subsetting>useCases</subsetting>
        <subsetting>enclosedPerformances</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Other UseCases included by this UseCase (i.e., as modeled by an &#xD;&#xA;&#x9;&#x9;&#x9; * IncludeUseCaseUsage).&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="useCases" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>UseCase</typings>
      <subsetting>cases</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * useCases is the base feature of all UseCaseUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: UseCases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: VerificationCases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="VerificationCases" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for verification cases and related behavioral elements &#xD;&#xA;&#x9; * in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::Case"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Cases::cases"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::RequirementCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Boolean"/>
    <elements xsi:type="sysMLOC:VerificationCaseDefinition" isAbstract="true" declaredName="VerificationCase">
      <superclassifiers>Case</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * VerificationCase is the most general class of performances of VerificationCaseDefinitions. &#xD;&#xA;&#x9;&#x9; * VericationCase is the base class of all VerificationCaseDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" isReference="true" declaredName="self">
        <typings>VerificationCase</typings>
        <redefinitions>Case::self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj">
        <redefinitions>Case::subj</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="verdict">
        <typings>VerdictKind</typings>
        <redefinitions>result</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="obj">
        <redefinitions>Case::obj</redefinitions>
        <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" valuePart="VerificationCase::subj"/>
        <elements xsi:type="sysMLOC:RequirementUsage" declaredName="requirementVerifications" MultiLow="0" MultiHigh="*">
          <typings>RequirementCheck</typings>
          <subsetting>subrequirements</subsetting>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * A record of the evaluations of the RequirementChecks of requirements being verified.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RequirementUsage" isReference="true" declaredName="requirementVerifications" MultiLow="0" MultiHigh="*" valuePart="obj.requirementVerifications">
        <typings>RequirementCheck</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Checks on whether the verifiedRequirements of the VerificationCase have been satisfied.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:VerificationCaseUsage" isAbstract="true" declaredName="subVerificationCases" MultiLow="0" MultiHigh="*">
        <typings>VerificationCase</typings>
        <subsetting>verificationCases</subsetting>
        <subsetting>subcases</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The subcases of this VerificationCase that are VerificationCaseUsages.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:VerificationCaseUsage" isAbstract="true" declaredName="verificationCases" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>VerificationCase</typings>
      <subsetting>cases</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * verificationCases is the base feature of all VerificationCaseUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="VerdictKind">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * VerdictKind is an enumeration of the possible results of a VerificationCase.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="pass"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="fail"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="inconclusive"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="error"/>
    </elements>
    <elements xsi:type="sysMLOC:CalculationDefinition" declaredName="PassIf">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * PassIf returns a pass or fail VerdictKind depending on whether its argument is&#xD;&#xA;&#x9;&#x9; * true or false.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="isPassing">
        <typings>Boolean</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" isReturn="true" declaredName="verdict" valuePart="if isPassing? VerdictKind::pass else VerdictKind::fail">
        <typings>VerdictKind</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="VerificationMethod">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * VerificationMethod can be used as metadata annotating a verification case or action.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="kind" MultiLow="1" MultiHigh="*">
        <typings>VerificationMethodKind</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="VerificationMethodKind">
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * VerificationMethodKind is an enumeration of the standard methods by which verification&#xD;&#xA;&#x9;&#x9; * can be carried out.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="inspect"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="analyze"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="demo"/>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="test"/>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: VerificationCases.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== BEGIN: Views.sysml =====&#xD;&#xA;"/>
  <elements xsi:type="sysMLOC:LibraryPackage" declaredName="Views" isStandard="true" isLibrary="true">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * This package defines the base types for views, viewpoints, renderings and related elements &#xD;&#xA;&#x9; * in the SysML language.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::Part"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Parts::parts"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::RequirementCheck"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Requirements::requirementChecks"/>
    <elements xsi:type="sysMLOC:ViewDefinition" isAbstract="true" declaredName="View">
      <superclassifiers>Part</superclassifiers>
      <elements xsi:type="sysMLOC:ViewUsage" isReference="true">
        <typings>View</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:ViewUsage" isAbstract="true" isReference="true" declaredName="subviews" MultiLow="0" MultiHigh="*">
        <typings>View</typings>
        <subsetting>views</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;    &#x9;&#x9; * Other Views that are used in the rendering of this View.&#xD;&#xA;    &#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" declaredName="viewRendering" MultiLow="0" MultiHigh="1">
        <typings>Rendering</typings>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The rendering of this View.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:ViewpointUsage" declaredName="viewpointSatisfactions" MultiLow="0" MultiHigh="*">
        <typings>ViewpointCheck</typings>
        <subsetting>viewpointChecks</subsetting>
        <subsetting>checkedConstraints</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Checks that the View satisfies all required ViewpointUsages.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" declaredName="viewpointConformance" satisfactionParameter="that">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * An assertion that all viewpointSatisfactions are true.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" refElement="viewpointSatisfactions" kind="require">
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; * The required ViewpointChecks.&#xD;&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:ReferenceUsage" isDefault="true" valuePart="that.that">
            <redefinitions>ownedPerformances::this</redefinitions>
            <redefinitions>subperformances::this</redefinitions>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ViewpointDefinition" isAbstract="true" declaredName="ViewpointCheck">
      <superclassifiers>RequirementCheck</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * ViewpointCheck is a RequirementCheck for checking if a View meets the concerns of viewpoint stakeholders. &#xD;&#xA;&#x9;&#x9; * It is the base type of all ViewpointDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ViewpointUsage" isReference="true">
        <typings>ViewpointCheck</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="subj" MultiLow="1">
        <typings>View</typings>
        <redefinitions>RequirementCheck::subj</redefinitions>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" isAbstract="true" declaredName="Rendering">
      <superclassifiers>Part</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * Rendering is the base type of all RenderingDefinitions.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:RenderingUsage" isReference="true">
        <typings>Rendering</typings>
        <redefinitions>self</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" declaredName="subrenderings" MultiLow="0" MultiHigh="*">
        <typings>Rendering</typings>
        <subsetting>renderings</subsetting>
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Other Renderings used to carry out this Rendering.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="TextualRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TextualRendering is a Rendering of a View into a textual format.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="GraphicalRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A GraphicalRendering is a Rendering of a View into a Graphical format.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingDefinition" declaredName="TabularRendering">
      <superclassifiers>Rendering</superclassifiers>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * A TabularRendering is a Rendering of a View into a tabular format.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewUsage" isAbstract="true" declaredName="views" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>View</typings>
      <subsetting>parts</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * views is the base feature of all ViewUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewpointUsage" isAbstract="true" declaredName="viewpointChecks" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>ViewpointCheck</typings>
      <subsetting>requirementChecks</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * viewpointChecks is the base feature of all ViewpointUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" declaredName="renderings" MultiLow="0" MultiHigh="*" isNonunique="true">
      <typings>Rendering</typings>
      <subsetting>parts</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * renderings is the base feature of all RenderingUsages.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asTextualNotation" MultiLow="1">
      <typings>TextualRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * asTextualNotation renders a View into textual notation as defined in the &#xD;&#xA;&#x9;&#x9; * KerML and SysML specifications.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asTreeDiagram" MultiLow="1">
      <typings>GraphicalRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * asTreeDiagram renders a View as a tree diagram, using the &#xD;&#xA;&#x9;&#x9; * graphical notation defined in the SysML specification.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asInterconnectionDiagram" MultiLow="1">
      <typings>GraphicalRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * asInterconnectionDiagram renders a View as an interconnection &#xD;&#xA;&#x9;&#x9; * diagram, using the graphical notation defined in the SysML specification.&#xD;&#xA;&#x9;&#x9; */"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asElementTable" MultiLow="1">
      <typings>TabularRendering</typings>
      <subsetting>renderings</subsetting>
      <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9; * asElementTable  renders a View as a table, with one row for each exposed &#xD;&#xA;&#x9;&#x9; * Element and columns rendered by applying the columnViews in order to the&#xD;&#xA;&#x9;&#x9; * Element in each row.&#xD;&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:ViewUsage" declaredName="columnView" MultiLow="0" MultiHigh="*" isOrdered="true">
        <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The Views to be rendered in the column cells, in order, of each rows of the table.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:RenderingUsage" isAbstract="true" isReference="true" MultiLow="0" MultiHigh="1">
          <redefinitions>viewRendering</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:RenderingUsage" MultiLow="0" MultiHigh="*" valuePart="columnView.viewRendering">
        <redefinitions>subrenderings</redefinitions>
      </elements>
    </elements>
  </elements>
  <elements xsi:type="sysMLOC:CodeAnnotation" body="// ===== END: Views.sysml =====&#xD;&#xA;"/>
</sysMLOC:Namespace>
