<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:RootNamespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="VehicleDefinitions">
    <elements xsi:type="sysMLOC:Documentation" body="/*&#xD;&#xA;&#x9; * Example vehicle definitions model.&#xD;&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="MeasurementReferences" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Comment" body="/* PART DEFINITIONS */"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <subsetting>ISQ::mass</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="leftMountingPoint">
        <typings>AxleMountIF</typings>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" declaredName="rightMountingPoint">
        <typings>AxleMountIF</typings>
      </elements>
      <elements xsi:type="sysMLOC:CodeAnnotation" body="// aaaaa aaaa.qqqqq&#xD;&#xA;"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="hub">
        <typings>WheelHubIF</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Lugbolt">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tighteningTorque">
        <subsetting>ISQ::torque</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* PORT DEFINITIONS */"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="DriveIF">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="driveTorque">
        <subsetting>ISQ::torque</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// aaaaa aaaa.&#xD;&#xA;"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="AxleMountIF">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="transferredTorque">
        <subsetting>ISQ::torque</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="WheelHubIF">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="appliedTorque">
        <subsetting>ISQ::torque</subsetting>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Comment" body="/* INTERFACE DEFINITIONS */"/>
    <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="Mounting">
      <elements xsi:type="sysMLOC:Documentation" body="/* The definition of the interface for mounting a Wheel to an Axle. */"/>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="axleMount" isEnd="true">
        <typings>AxleMountIF</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="hub" isEnd="true">
        <typings>WheelHubIF</typings>
      </elements>
      <elements xsi:type="sysMLOC:FlowUsage">
        <FlowEnd>axleMount.transferredTorque</FlowEnd>
        <FlowEnd>hub.appliedTorque</FlowEnd>
      </elements>
    </elements>
  </elements>
</sysMLOC:RootNamespace>
