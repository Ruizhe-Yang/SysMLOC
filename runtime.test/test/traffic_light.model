      </elements>
      <elements xsi:type="sysMLOC:DoActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="traffic_light_controller.check_status"/>
      </elements>
      <elements xsi:type="sysMLOC:ExitActionNode"/>
    </elements>
    <elements xsi:type="sysMLOC:StateUsage" declaredName="stop_sign"/>
