    <elements xsi:type="sysMLOC:StateUsage" declaredName="init">
      <elements xsi:type="sysMLOC:EntryActionNode">
        <performedActionParameterPart xsi:type="sysMLOC:PerformActionUsage" referencedFeature="traffic_light_controller.power_up_test"/>
