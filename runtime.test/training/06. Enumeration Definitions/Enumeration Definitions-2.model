        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>color</redefinitions>
          <valuePart>TrafficLightColor::yellow</valuePart>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="secret">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>code</redefinitions>
          <valuePart>&quot;secr&quot;</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage">
          <redefinitions>color</redefinitions>
          <valuePart>TrafficLightColor::red</valuePart>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="GradePoints">
      <superclassifiers>Real</superclassifiers>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="A">
        <valuePart>4.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="B">
        <valuePart>3.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="C">
        <valuePart>2.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="D">
        <valuePart>1.0</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="F">
