<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="'Interface Decomposition Example'">
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="SpigotBank"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="Spigot"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="Faucet"/>
    <elements xsi:type="sysMLOC:PortDefinition" declaredName="FaucetInlet"/>
    <elements xsi:type="sysMLOC:InterfaceDefinition" declaredName="WaterDelivery">
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="suppliedBy">
        <typings>SpigotBank</typings>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="hot">
          <typings>Spigot</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="cold">
          <typings>Spigot</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="deliveredTo">
        <typings>Faucet</typings>
        <Multiplicity>1</Multiplicity>
        <Multiplicity>*</Multiplicity>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="hot">
          <typings>FaucetInlet</typings>
        </elements>
        <elements xsi:type="sysMLOC:PortUsage" declaredName="cold">
          <typings>FaucetInlet</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <connectorPart refElement="suppliedBy.hot"/>
        <connectorPart refElement="deliveredTo.hot"/>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <connectorPart refElement="suppliedBy.cold"/>
        <connectorPart refElement="deliveredTo.cold"/>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
