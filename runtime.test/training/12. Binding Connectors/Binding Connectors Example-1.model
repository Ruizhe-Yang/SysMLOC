<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Binding Connectors Example-1'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Port Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="FuelPump"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="FuelTank"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="tank">
        <typings>FuelTankAssembly</typings>
        <elements xsi:type="sysMLOC:PortUsage">
          <redefinitions>fuelTankPort</redefinitions>
          <elements xsi:type="sysMLOC:ItemUsage" direction="out">
            <redefinitions>fuelSupply</redefinitions>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" direction="in">
            <redefinitions>fuelReturn</redefinitions>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="fuelTankPort.fuelSupply"/>
          <connectorPart refElement="pump.pumpOut"/>
        </elements>
        <elements xsi:type="sysMLOC:BindingConnectorAsUsage">
          <connectorPart refElement="fuelTankPort.fuelReturn"/>
          <connectorPart refElement="tank.fuelIn"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="pump">
          <typings>FuelPump</typings>
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="pumpOut">
            <typings>Fuel</typings>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="pumpIn">
            <typings>Fuel</typings>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="tank">
          <typings>FuelTank</typings>
          <elements xsi:type="sysMLOC:ItemUsage" direction="out" declaredName="fuelOut">
            <typings>Fuel</typings>
          </elements>
          <elements xsi:type="sysMLOC:ItemUsage" direction="in" declaredName="fuelIn">
            <typings>Fuel</typings>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
