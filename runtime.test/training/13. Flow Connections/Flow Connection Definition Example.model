<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Flow Connection Definition Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Port Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:FlowConnectionDefinition" declaredName="FuelFlow">
      <elements xsi:type="sysMLOC:ReferenceUsage">
        <typings>Fuel</typings>
        <redefinitions>payload</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="supplierPort">
        <typings>FuelOutPort</typings>
      </elements>
      <elements xsi:type="sysMLOC:PortUsage" isEnd="true" declaredName="consumerPort">
        <typings>FuelInPort</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
      <typings>Vehicle</typings>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="tankAssy">
        <typings>FuelTankAssembly</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="eng">
        <typings>Engine</typings>
      </elements>
      <elements xsi:type="sysMLOC:FlowConnectionUsage">
        <typings>FuelFlow</typings>
        <FlowEnd>tankAssy.fuelTankPort.fuelSupply</FlowEnd>
        <FlowEnd>eng.engineFuelPort.fuelSupply</FlowEnd>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
