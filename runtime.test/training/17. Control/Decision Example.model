<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Decision Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="BatteryCharged"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="battery"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="powerSystem"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="MonitorBattery">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="charge">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="AddCharge">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="charge">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="EndCharging"/>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="ChargeBattery">
      <elements xsi:type="sysMLOC:InitialNode" memberElement="start"/>
      <elements xsi:type="sysMLOC:CommonNode" isThen="true" declaredName="continueCharging"/>
      <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="monitor">
        <typings>MonitorBattery</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="batteryCharge">
          <typings>Real</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:CommonNode" isThen="true" nodeKind="decide"/>
      <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="monitor.batteryCharge &lt; 100">
        <transitionSuccessionElement refElement="addCharge"/>
      </elements>
      <elements xsi:type="sysMLOC:IfNode" ifConditionExpression="monitor.batteryCharge >= 100">
        <transitionSuccessionElement refElement="endCharging"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="addCharge">
        <typings>AddCharge</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="charge" valuePart="monitor.batteryCharge"/>
      </elements>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="continueCharging"/>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="endCharging">
        <typings>EndCharging</typings>
      </elements>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="done"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
