<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="'Interaction Example-2'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Event Occurrence Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SetSpeed"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SensedSpeed"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="FuelCommand"/>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="CruiseControlInteraction">
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="driver">
        <typings>Driver</typings>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="setSpeedMessage.sourceEvent"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="vehicle">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="cruiseController">
          <typings>CruiseController</typings>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="setSpeedMessage.targetEvent"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="sensedSpeedMessage.targetEvent"/>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" refElement="fuelCommandMessage.sourceEvent"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="speedometer">
          <typings>Speedometer</typings>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="sensedSpeedMessage.sourceEvent"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
          <typings>Engine</typings>
          <elements xsi:type="sysMLOC:EventOccurrenceUsage" refElement="fuelCommandMessage.targetEvent"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="setSpeedMessage">
        <itemFeatureParameter payloadFeatureElement="SetSpeed"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" isThen="true" declaredName="sensedSpeedMessage">
        <itemFeatureParameter payloadFeatureElement="SensedSpeed"/>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="fuelCommandMessage">
        <itemFeatureParameter payloadFeatureElement="FuelCommand"/>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
