<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <packages declaredName="'Message Payload Example'">
    <elements xsi:type="sysMLOC:NamespaceImport" visibility="private" declaredName="'Event Occurrence Example'"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SetSpeed"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="SensedSpeed"/>
    <elements xsi:type="sysMLOC:ItemDefinition" declaredName="FuelCommand">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelFlow">
        <typings>ScalarValues::Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="EngineController"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1">
      <subsetting>vehicle</subsetting>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="engineController">
        <typings>EngineController</typings>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" declaredName="fuelCommandReceived"/>
        <elements xsi:type="sysMLOC:EventOccurrenceUsage" isThen="true" declaredName="fuelCommandForwarded"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:OccurrenceDefinition" declaredName="CruiseControlInteraction">
      <elements xsi:type="sysMLOC:PartUsage" isReference="true">
        <redefinitions>driver</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isReference="true" declaredName="vehicle">
        <redefinitions>vehicle1</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:Message" declaredName="setSpeedMessage">
        <itemFeatureParameter payloadFeatureElement="SetSpeed"/>
        <FlowEnd>driver.setSpeedSent</FlowEnd>
        <FlowEnd>vehicle.cruiseController.setSpeedReceived</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:Message" isThen="true" declaredName="sensedSpeedMessage">
        <itemFeatureParameter payloadFeatureElement="SensedSpeed"/>
        <FlowEnd>vehicle.speedometer.sensedSpeedSent</FlowEnd>
        <FlowEnd>vehicle.cruiseController.sensedSpeedReceived</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:Message" isThen="true" declaredName="fuelCommandMessage">
        <itemFeatureParameter declaredName="fuelCommand">
          <typings>FuelCommand</typings>
        </itemFeatureParameter>
        <FlowEnd>vehicle.cruiseController.fuelCommandSent</FlowEnd>
        <FlowEnd>vehicle.engineController.fuelCommandReceived</FlowEnd>
      </elements>
      <elements xsi:type="sysMLOC:Message" isThen="true" declaredName="fuelCommandForwardingMessage">
        <itemFeatureParameter declaredName="fuelCommand">
          <typings>FuelCommand</typings>
          <valuePart>fuelCommandMessage.fuelCommand</valuePart>
        </itemFeatureParameter>
        <FlowEnd>vehicle.engineController.fuelCommandForwarded</FlowEnd>
        <FlowEnd>vehicle.engine.fuelCommandReceived</FlowEnd>
      </elements>
    </elements>
  </packages>
</sysMLOC:Namespace>
