<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Analytical Constraints'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Calculation Definitions'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="StraightLineDynamicsEquations">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p">
        <typings>PowerValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="dt">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_i">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_i">
        <typings>SpeedValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_f">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_f">
        <typings>SpeedValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="a">
        <typings>AccelerationValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v_avg">
        <typings>SpeedValue</typings>
        <valuePart>(v_i + v_f)/2</valuePart>
      </elements>
      <resultExpressionParameter resultExpression="a == Acceleration(p, m, v_avg) and v_f == Velocity(dt, v_i, a) and x_f == Position(dt, x_i, v_avg)"/>
    </elements>
    <elements xsi:type="sysMLOC:ActionDefinition" declaredName="StraightLineDynamics">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="power">
        <typings>PowerValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="mass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="delta_t">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_in">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_in">
        <typings>SpeedValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="x_out">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="v_out">
        <typings>SpeedValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="a_out">
        <typings>AccelerationValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="dynamics">
        <typings>StraightLineDynamicsEquations</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="p">
          <valuePart>power</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="m">
          <valuePart>mass</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="dt">
          <valuePart>delta_t</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_i">
          <valuePart>x_in</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_i">
          <valuePart>v_in</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="x_f">
          <valuePart>x_out</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="v_f">
          <valuePart>v_out</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="a">
          <valuePart>a_out</valuePart>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
