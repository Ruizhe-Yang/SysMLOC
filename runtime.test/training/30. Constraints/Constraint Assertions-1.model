<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Constraint Assertions-1'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="NumericalFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Engine"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Transmission"/>
    <elements xsi:type="sysMLOC:ConstraintDefinition" declaredName="MassConstraint">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" Multi1="0" Multi02="*">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="massLimit">
        <typings>MassValue</typings>
      </elements>
      <resultExpressionParameter resultExpression="sum(partMasses) &lt;= massLimit"/>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:AssertConstraintUsage" declaredName="massConstraint">
        <typings>MassConstraint</typings>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="partMasses" valuePart="(chassisMass, engine.mass, transmission.mass)"/>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="massLimit" valuePart="2500[kg]"/>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="chassisMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="engine">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <typings>MassValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="transmission">
        <typings>Engine</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <typings>MassValue</typings>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
