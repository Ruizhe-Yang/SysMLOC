<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Analysis Case Definition Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Calculation Definitions'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Analytical Constraints'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="USCustomaryUnits" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SequenceFunctions::size"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Quantities::ScalarQuantityValue"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ControlFunctions" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Positive"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="DistancePerVolumeValue">
      <superclassifiers>ScalarQuantityValue</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="cargoMass">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="wheelDiameter">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="driveTrainEfficiency">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelEconomy_city">
        <typings>DistancePerVolumeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="fuelEconomy_highway">
        <typings>DistancePerVolumeValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="WayPoint">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="time">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="position">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="speed">
        <typings>SpeedValue</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AnalysisCaseDefinition" declaredName="FuelEconomyAnalysis">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage" declaredName="fuelEconomyAnalysisObjective">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * The objective of this analysis is to determine whether the&#xD;&#xA;&#x9;&#x9;&#x9; * subject vehicle can satisfy the fuel economy requirement.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage">
          <resultExpressionParameter resultExpression="vehicle.wheelDiameter == 33 ['in'] &amp; vehicle.driveTrainEfficiency == 0.4"/>
        </elements>
        <elements xsi:type="sysMLOC:RequirementConstraintUsage" kind="require">
          <resultExpressionParameter resultExpression="fuelEconomyResult > 30 [mi / gal]"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" direction="in" declaredName="scenario">
        <typings>WayPoint</typings>
        <Multiplicity>*</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" declaredName="solveForPower">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="power">
          <typings>PowerValue</typings>
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="acceleration">
          <typings>AccelerationValue</typings>
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Solve for the required engine power as a function of time&#xD;&#xA;&#x9;&#x9;&#x9; * to support the scenario.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:AssertConstraintUsage">
          <resultExpressionParameter resultExpression="(1..size(scenario)-1)->forAll {in i: Positive; StraightLineDynamicsEquations ( power#(i), vehicle.mass, scenario.time#(i+1) - scenario.time#(i), scenario.position#(i), scenario.speed#(i), scenario.position#(i+1), scenario.speed#(i+1), acceleration#(i+1) ) }"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="solveForFuelConsumption">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="in" declaredName="power" valuePart="solveForPower.power">
          <typings>PowerValue</typings>
          <Multiplicity>*</Multiplicity>
        </elements>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="out" declaredName="fuelEconomy">
          <typings>DistancePerVolumeValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xD;&#xA;&#x9;&#x9;&#x9; * Solve the engine equations to determine how much fuel is&#xD;&#xA;&#x9;&#x9;&#x9; * consumed.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" isReturn="true" declaredName="fuelEconomyResult" valuePart="solveForFuelConsumption.fuelEconomy">
        <typings>DistancePerVolumeValue</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
