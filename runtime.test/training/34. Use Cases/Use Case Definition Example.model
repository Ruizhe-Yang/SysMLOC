<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Use Case Definition Example'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Person"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Environment"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Fuel Station'"/>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="'Provide Transportation'">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver">
        <typings>Person</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="passengers">
        <typings>Person</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>4</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="environment">
        <typings>Environment</typings>
      </elements>
      <elements xsi:type="sysMLOC:ObjectiveRequirementUsage">
        <elements xsi:type="sysMLOC:Documentation" body="/* Transport driver and passengers from starting location &#xD;&#xA;&#x9;&#x9;&#x9; * to ending location.&#xD;&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="'Enter Vehicle'">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver">
        <typings>Person</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="passengers">
        <typings>Person</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>4</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseDefinition" declaredName="'Exit Vehicle'">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver">
        <typings>Person</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="passengers">
        <typings>Person</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>4</Multiplicity>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
