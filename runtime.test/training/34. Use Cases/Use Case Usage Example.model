<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Use Case Usage Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Use Case Definition Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Fuel Station'"/>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="'provide transportation'">
      <typings>'Provide Transportation'</typings>
      <elements xsi:type="sysMLOC:InitialNode" memberElement="start"/>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" isThen="true" declaredName="'enter vehicle'">
        <typings>'Enter Vehicle'</typings>
        <elements xsi:type="sysMLOC:ActorUsage" valuePart="'provide transportation'::driver">
          <redefinitions>driver</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ActorUsage" valuePart="'provide transportation'::passengers">
          <redefinitions>passengers</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:UseCaseUsage" isThen="true" declaredName="'drive vehicle'">
        <elements xsi:type="sysMLOC:ActorUsage" declaredName="driver" valuePart="'provide transportation'::driver"/>
        <elements xsi:type="sysMLOC:ActorUsage" declaredName="environment" valuePart="'provide transportation'::environment"/>
        <elements xsi:type="sysMLOC:IncludeUseCaseUsage" refElement="'add fuel'">
          <Multiplicity>0</Multiplicity>
          <Multiplicity>*</Multiplicity>
          <elements xsi:type="sysMLOC:ActorUsage" valuePart="driver">
            <redefinitions>fueler</redefinitions>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:IncludeUseCaseUsage" isThen="true" declaredName="'exit vehicle'">
        <typings>'Exit Vehicle'</typings>
        <elements xsi:type="sysMLOC:ActorUsage" valuePart="'provide transportation'::driver">
          <redefinitions>driver</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:ActorUsage" valuePart="'provide transportation'::passengers">
          <redefinitions>passengers</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ThenNode">
        <thenElement refElement="done"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:UseCaseUsage" declaredName="'add fuel'">
      <elements xsi:type="sysMLOC:SubjectUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="fueler">
        <typings>Person</typings>
      </elements>
      <elements xsi:type="sysMLOC:ActorUsage" declaredName="'fuel station'">
        <typings>'Fuel Station'</typings>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
