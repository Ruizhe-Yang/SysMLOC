<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'User Keyword Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Semantic Metadata Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="RiskMetadata::LevelEnum"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Device">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="battery">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="power">
          <typings>Real</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ExtendedDefinition" declaredName="DeviceFailure">
      <prefixMetadataExtension>#scenario</prefixMetadataExtension>
      <elements xsi:type="sysMLOC:ReferenceUsage" declaredName="device">
        <typings>Device</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="minPower">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" declaredName="'battery old'">
        <prefixMetadataExtension>#cause</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="0.01">
          <redefinitions>probability</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage">
        <prefixMetadataExtension>#causation</prefixMetadataExtension>
        <connectorPart refElement="'battery old'"/>
        <connectorPart refElement="'power low'"/>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" declaredName="'power low'">
        <prefixMetadataExtension>#situation</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:ConstraintUsage">
          <resultExpressionParameter resultExpression="device.battery.power &lt; minPower"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:SuccessionAsUsage">
        <prefixMetadataExtension>#causation</prefixMetadataExtension>
        <connectorPart refElement="'power low'"/>
        <connectorPart refElement="'device shutoff'"/>
      </elements>
      <elements xsi:type="sysMLOC:ExtendedUsage" declaredName="'device shutoff'">
        <prefixMetadataExtension>#failure</prefixMetadataExtension>
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" valuePart="LevelEnum::high">
          <redefinitions>severity</redefinitions>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
