<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'Views Example'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Views" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Viewpoint Example'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Filtering Example-2'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ViewDefinition" declaredName="'Part Structure View'">
      <elements xsi:type="sysMLOC:SatisfyRequirementUsage" refElement="'system structure perspective'"/>
      <elements xsi:type="sysMLOC:ElementFilterElement" filterExpression="@SysML::PartUsage"/>
    </elements>
    <elements xsi:type="sysMLOC:ViewUsage" declaredName="'vehicle structure view'">
      <typings>'Part Structure View'</typings>
      <elements xsi:type="sysMLOC:ExposeElement" declaredName="vehicle" isRecursive="true"/>
      <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTreeDiagram"/>
    </elements>
    <elements xsi:type="sysMLOC:RenderingUsage" declaredName="asTextualNotationTable">
      <subsetting>asElementTable</subsetting>
      <elements xsi:type="sysMLOC:ViewUsage">
        <redefinitions>columnView</redefinitions>
        <Multiplicity>1</Multiplicity>
        <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTextualNotation"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:ViewUsage" declaredName="'vehicle tabular views'">
      <elements xsi:type="sysMLOC:ViewUsage" declaredName="'safety features view'">
        <typings>'Part Structure View'</typings>
        <elements xsi:type="sysMLOC:ExposeElement" declaredName="vehicle" isRecursive="true">
          <filterPackageExpression>@Safety</filterPackageExpression>
        </elements>
        <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTextualNotationTable"/>
      </elements>
      <elements xsi:type="sysMLOC:ViewUsage" declaredName="'non-safety features view'">
        <typings>'Part Structure View'</typings>
        <elements xsi:type="sysMLOC:ExposeElement" declaredName="vehicle" isRecursive="true">
          <filterPackageExpression>not (@Safety)</filterPackageExpression>
        </elements>
        <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTextualNotationTable"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
