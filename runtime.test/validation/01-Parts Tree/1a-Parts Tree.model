<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'1a-Parts Tree'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI::kg"/>
    <elements xsi:type="sysMLOC:Package" declaredName="Definitions">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
          <elements xsi:type="sysMLOC:Documentation" body="/*&#xA;&#x9;&#x9;&#x9; * The 'mass' attribute property is declared here to be a &#xA;&#x9;&#x9;&#x9; * specialization (subset) of the general 'mass' quantity &#xA;&#x9;&#x9;&#x9; * from the 'ISQ' (International System of Quantities) &#xA;&#x9;&#x9;&#x9; * library model.&#xA;&#x9;&#x9;&#x9; */"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="FrontAxle">
        <superclassifiers>Axle</superclassifiers>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="steeringAngle">
          <typings>ScalarValues::Real</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Usages">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Definitions" isNamespace="true">
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * A &quot;private&quot; private import makes the imported names private to the&#xA;&#x9;&#x9;&#x9; * imported package.&#xA;&#x9;&#x9;&#x9; */"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * 'vehicle1' is a package-owned part of type Vehicle.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <redefinitions>Vehicle::mass</redefinitions>
          <valuePart>1750 [kg]</valuePart>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * This redefines the 'mass' attribute property from 'Vehicle' to &#xA;&#x9;&#x9;&#x9;&#x9; * give it a fixed attribute.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * 'frontAxleAssembly' is a nested part of part 'vehicle1'.&#xA;&#x9;&#x9;&#x9;&#x9; * It is a composite part of the containing part.&#xA;&#x9;&#x9;&#x9;&#x9; * &#xA;&#x9;&#x9;&#x9;&#x9; * (And similarly for 'rearAxleAssembly'.)&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle">
            <typings>Axle</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel" isOrdered="true">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * 'frontWheel' is a nested part of type 'Wheel' with&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * multiplicity &quot;2&quot;. This means that this axle assembly&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * must have exactly two wheels. However, there is still&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * only one 'frontWheel' part. The part is &quot;ordered&quot;,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * so that the first wheel can be distinguished from the&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * second.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
            <typings>Axle</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel" isOrdered="true">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle1_c1">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * 'vehicle1_c1' is a modified copy of 'vehicle1'. There is no&#xA;&#x9;&#x9;&#x9; * connection between this copy and the original version in the&#xA;&#x9;&#x9;&#x9; * model.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <redefinitions>Vehicle::mass</redefinitions>
          <valuePart>2000 [kg]</valuePart>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * The mass attribute has been modified.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle">
            <typings>FrontAxle</typings>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * The part 'frontAxle' has been modified to have type 'FrontAxle'.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel" isOrdered="true">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * The parts 'frontWheel_1' and 'frontWheel_2' have been added&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * as subsets of 'frontWheel'. These are separate parts from&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * 'frontWheel', but essentially provide alternate names for&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * each of the two wheels, as given by their defining expressions.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel_1">
            <subsetting>frontWheel</subsetting>
            <valuePart>frontWheel#(1)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel_2">
            <subsetting>frontWheel</subsetting>
            <valuePart>frontWheel#(2)</valuePart>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
          <typings>AxleAssembly</typings>
          <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9; * 'rearAxleAssembly' has also been modified to add subsetting parts&#xA;&#x9;&#x9;&#x9;&#x9; * for 'rearWheel'.&#xA;&#x9;&#x9;&#x9;&#x9; */"/>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
            <typings>Axle</typings>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel" isOrdered="true">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel_1">
            <subsetting>rearWheel</subsetting>
            <valuePart>rearWheel#(1)</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel_2">
            <subsetting>rearWheel</subsetting>
            <valuePart>rearWheel#(2)</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
