<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'3c-Function-based Behavior-structure mod-1'">
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleFrame"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="HitchBall"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerCoupler"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="Trailer"/>
    <elements xsi:type="sysMLOC:PartDefinition" declaredName="TrailerFrame"/>
    <elements xsi:type="sysMLOC:ConnectionDefinition" declaredName="TrailerHitch">
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="hitch" isEnd="true">
        <typings>HitchBall</typings>
      </elements>
      <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="coupler" isEnd="true">
        <typings>TrailerCoupler</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="'vehicle-trailer system'">
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleFrame">
          <typings>VehicleFrame</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="hitch">
            <typings>HitchBall</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage" declaredName="trailerHitch" Multi1="0" Multi02="1">
        <typings>TrailerHitch</typings>
        <connectorPart refElement="vehicle.vehicleFrame.hitch"/>
        <connectorPart refElement="trailer.trailerFrame.coupler"/>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="trailer">
        <typings>Trailer</typings>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="trailerFrame">
          <typings>TrailerFrame</typings>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="coupler">
            <typings>TrailerCoupler</typings>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ActionUsage">
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Create a link and assign it as the TrailerHitch connection.&#xA;"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Link participants are determined from inherited ends.&#xA;"/>
        <elements xsi:type="sysMLOC:AssignmentNode" declaredName="'connect trailer to vehicle'" featureChain="'vehicle-trailer system'.trailerHitch" NodeParameter="new TrailerHitch()"/>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Destroy the link object.&#xA;"/>
        <elements xsi:type="sysMLOC:ActionUsage" isThen="true" declaredName="'destroy connection of trailer to vehicle'">
          <typings>OccurrenceFunctions::destroy</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage" direction="inout" declaredName="occ" valuePart="'vehicle-trailer system'.trailerHitch"/>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// Remove the link from the TrailerHitch connection.&#xA;"/>
        <elements xsi:type="sysMLOC:AssignmentNode" isThen="true" declaredName="'disconnect trailer from vehicle'" featureChain="'vehicle-trailer system'.trailerHitch" NodeParameter="null"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
