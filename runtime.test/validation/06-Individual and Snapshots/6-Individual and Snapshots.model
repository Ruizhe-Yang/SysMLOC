<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'6-Individual and Snapshots'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues::Real"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Time::DateTime"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ISQ" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="'Part Definitions'">
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="'Temporal-Spatial Reference'">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="referenceTime">
          <typings>DateTime</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="referenceCoordinateSystem"/>
      </elements>
      <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9; * Note that space and time coordinatization have not&#xA;&#x9;&#x9; * been fully specified yet.&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleRoadContext">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t">
          <typings>TimeValue</typings>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="VehicleA">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <typings>MassValue</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="position">
          <typings>Real</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="velocity">
          <typings>Real</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="acceleration">
          <typings>Real</typings>
        </elements>
        <elements xsi:type="sysMLOC:ExhibitStateUsage" declaredName="vehicleStates">
          <elements xsi:type="sysMLOC:EntryActionNode"/>
          <elements xsi:type="sysMLOC:TransitionUsage">
            <transitionSuccessionElement refElement="on"/>
          </elements>
          <elements xsi:type="sysMLOC:StateUsage" declaredName="on"/>
          <elements xsi:type="sysMLOC:TransitionUsage">
            <transitionSuccessionElement refElement="off"/>
          </elements>
          <elements xsi:type="sysMLOC:StateUsage" declaredName="off"/>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Road">
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="angle">
          <typings>Real</typings>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="surfaceFriction">
          <typings>Real</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Individual Definitions'">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Part Definitions'" isNamespace="true"/>
      <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9; * An individual definition restricts the instances of a part def to&#xA;&#x9;&#x9; * those that are portions of the same life (&quot;identity&quot;).&#xA;&#x9;&#x9; */"/>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="'Temporal-Spatial Reference_ID1'" isIndividual="true">
        <superclassifiers>'Temporal-Spatial Reference'</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="VehicleRoadContext_ID1" isIndividual="true">
        <superclassifiers>VehicleRoadContext</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="VehicleA_ID1" isIndividual="true">
        <superclassifiers>VehicleA</superclassifiers>
      </elements>
      <elements xsi:type="sysMLOC:IndividualDefinition" declaredName="Road_ID1" isIndividual="true">
        <superclassifiers>Road</superclassifiers>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="Values">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t0">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="t1">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="tn">
        <typings>TimeValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="m">
        <typings>MassValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="p0">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="p1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="pn">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v0">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="v1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="vn">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="a0">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="a1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="an">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="theta0">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="theta1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="thetan">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sf0">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sf1">
        <typings>Real</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="sfn">
        <typings>Real</typings>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="'Individuals and Snapshots'">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'Individual Definitions'" isNamespace="true"/>
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Values" isNamespace="true"/>
      <elements xsi:type="sysMLOC:IndividualUsage" declaredName="reference" isIndividual="true">
        <typings>'Temporal-Spatial Reference_ID1'</typings>
        <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9; * An individual usage must be typed by an individual definition,&#xA;&#x9;&#x9;&#x9; * representing the condition of that individual during some or all&#xA;&#x9;&#x9;&#x9; * of its life.&#xA;&#x9;&#x9;&#x9; */"/>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="context_t0" portionKind="snapshot">
          <typings>VehicleRoadContext_ID1</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>t</redefinitions>
            <valuePart>t0</valuePart>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * This is a concise notation for showing the redefinition&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * of a attribute property.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="vehicle_ID1_t0" portionKind="snapshot">
            <typings>VehicleA_ID1</typings>
            <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * A snapshot is a kind of individual usage restricted to&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; * a single instant of time.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>mass</redefinitions>
              <valuePart>m</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>position</redefinitions>
              <valuePart>p0</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>velocity</redefinitions>
              <valuePart>v0</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>acceleration</redefinitions>
              <valuePart>a0</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ExhibitStateUsage" refElement="vehicleStates.on">
              <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * This asserts that the snapshot exhibits the referenced &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * state, which means that the vehicle must me in the state &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; * at the time of the snapshot.&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; */"/>
            </elements>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="road_ID1_t0" portionKind="snapshot">
            <typings>Road_ID1</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>angle</redefinitions>
              <valuePart>theta0</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>surfaceFriction</redefinitions>
              <valuePart>sf0</valuePart>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="context_t1" portionKind="snapshot">
          <typings>VehicleRoadContext_ID1</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>t</redefinitions>
            <valuePart>t1</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="vehicle_ID1_t1" portionKind="snapshot">
            <typings>VehicleA_ID1</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>mass</redefinitions>
              <valuePart>m</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>position</redefinitions>
              <valuePart>p1</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>velocity</redefinitions>
              <valuePart>v1</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>acceleration</redefinitions>
              <valuePart>a1</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ExhibitStateUsage" refElement="vehicleStates.on"/>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="road_ID1_t1" portionKind="snapshot">
            <typings>Road_ID1</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>angle</redefinitions>
              <valuePart>theta1</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>surfaceFriction</redefinitions>
              <valuePart>sf1</valuePart>
            </elements>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:CodeAnnotation" body="// ...&#xA;"/>
        <elements xsi:type="sysMLOC:PortionUsage" declaredName="context_tn" portionKind="snapshot">
          <typings>VehicleRoadContext_ID1</typings>
          <elements xsi:type="sysMLOC:DefaultReferenceUsage">
            <redefinitions>t</redefinitions>
            <valuePart>tn</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="vehicle_ID1_tn" portionKind="snapshot">
            <typings>VehicleA_ID1</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>mass</redefinitions>
              <valuePart>m</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>position</redefinitions>
              <valuePart>pn</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>velocity</redefinitions>
              <valuePart>vn</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>acceleration</redefinitions>
              <valuePart>an</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:ExhibitStateUsage" refElement="vehicleStates.off"/>
          </elements>
          <elements xsi:type="sysMLOC:PortionUsage" declaredName="road_ID1_tn" portionKind="snapshot">
            <typings>Road_ID1</typings>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>angle</redefinitions>
              <valuePart>theta1</valuePart>
            </elements>
            <elements xsi:type="sysMLOC:DefaultReferenceUsage">
              <redefinitions>surfaceFriction</redefinitions>
              <valuePart>sfn</valuePart>
            </elements>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
