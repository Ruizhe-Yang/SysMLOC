<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'7a1-Variant Configuration - General Concept-a'">
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="doX"/>
    <elements xsi:type="sysMLOC:ActionUsage" declaredName="doY"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part1"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part2"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part3">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="p1"/>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part4"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part5">
      <elements xsi:type="sysMLOC:PortUsage" declaredName="p2"/>
      <elements xsi:type="sysMLOC:PerformActionUsage" isVariation="true" declaredName="doXorY">
        <elements xsi:type="sysMLOC:PerformActionUsage" isVariant="true" refElement="doX"/>
        <elements xsi:type="sysMLOC:PerformActionUsage" isVariant="true" refElement="doY"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part6"/>
    <elements xsi:type="sysMLOC:PartDefinition" isAbstract="true" declaredName="SubsystemA">
      <elements xsi:type="sysMLOC:PartUsage" isAbstract="true">
        <redefinitions>part3</redefinitions>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>1</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartDefinition" isAbstract="true" declaredName="SubsystemB">
      <elements xsi:type="sysMLOC:PartUsage" isAbstract="true">
        <redefinitions>part5</redefinitions>
        <Multiplicity>1</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="anyVehicleConfig">
      <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="subsystemA">
        <typings>SubsystemA</typings>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem1">
          <typings>SubsystemA</typings>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part1</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part2</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem2">
          <typings>SubsystemA</typings>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part2</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part3</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage" isVariation="true" declaredName="subsystemB">
        <typings>SubsystemB</typings>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem3">
          <typings>SubsystemB</typings>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part4</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part5</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" isVariant="true" declaredName="subsystem4">
          <typings>SubsystemB</typings>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part5</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage">
            <redefinitions>part6</redefinitions>
            <Multiplicity>1</Multiplicity>
          </elements>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ConnectionUsage">
        <connectorPart refElement="subsystemA.part3.p1">
          <Multiplicity>0</Multiplicity>
          <Multiplicity>1</Multiplicity>
        </connectorPart>
        <connectorPart refElement="subsystemB.part5.p2">
          <Multiplicity>1</Multiplicity>
        </connectorPart>
      </elements>
      <elements xsi:type="sysMLOC:AssertConstraintUsage">
        <resultExpressionParameter resultExpression="subsystemA != subsystemA::subsystem2 | subsystemB == subsystemB::subsystem3"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicleConfigA">
      <subsetting>anyVehicleConfig</subsetting>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>subsystemA</redefinitions>
        <valuePart>subsystemA::subsystem1</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>subsystemB</redefinitions>
        <valuePart>subsystemB::subsystem3</valuePart>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>part5</redefinitions>
          <elements xsi:type="sysMLOC:PerformActionUsage">
            <redefinitions>doXorY</redefinitions>
            <valuePart>doX</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="VehicleConfigB">
      <subsetting>anyVehicleConfig</subsetting>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>subsystemA</redefinitions>
        <valuePart>subsystemA::subsystem2</valuePart>
      </elements>
      <elements xsi:type="sysMLOC:PartUsage">
        <redefinitions>subsystemB</redefinitions>
        <valuePart>subsystemB::subsystem4</valuePart>
        <elements xsi:type="sysMLOC:PartUsage">
          <redefinitions>part5</redefinitions>
          <elements xsi:type="sysMLOC:PerformActionUsage">
            <redefinitions>doXorY</redefinitions>
            <valuePart>doY</valuePart>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
