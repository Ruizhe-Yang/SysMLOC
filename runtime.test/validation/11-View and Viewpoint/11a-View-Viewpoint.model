<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'11a-View-Viewpoint'">
    <elements xsi:type="sysMLOC:Package" declaredName="SystemModel">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="SI" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Vehicle"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="AxleAssembly"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Axle"/>
      <elements xsi:type="sysMLOC:PartDefinition" declaredName="Wheel"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="vehicle">
        <typings>Vehicle</typings>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
          <subsetting>ISQ::mass</subsetting>
          <valuePart>2500[SI::kg]</valuePart>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxleAssembly">
          <typings>AxleAssembly</typings>
          <Multiplicity>1</Multiplicity>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
            <valuePart>150[kg]</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontWheel">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="frontAxle">
            <typings>Axle</typings>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass"/>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="steeringAngle"/>
          </elements>
        </elements>
        <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxleAssembly">
          <typings>AxleAssembly</typings>
          <Multiplicity>1</Multiplicity>
          <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass">
            <subsetting>ISQ::mass</subsetting>
            <valuePart>250[kg]</valuePart>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearWheel">
            <typings>Wheel</typings>
            <Multiplicity>2</Multiplicity>
          </elements>
          <elements xsi:type="sysMLOC:PartUsage" declaredName="rearAxle">
            <typings>Axle</typings>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:AttributeUsage" declaredName="mass"/>
          </elements>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:Package" declaredName="ViewModel">
      <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="Views" isNamespace="true"/>
      <elements xsi:type="sysMLOC:PartUsage" declaredName="'systems engineer'"/>
      <elements xsi:type="sysMLOC:ConcernUsage" declaredName="'system breakdown'">
        <elements xsi:type="sysMLOC:SubjectUsage"/>
        <elements xsi:type="sysMLOC:StakeholderUsage">
          <redefinitions>'systems engineer'</redefinitions>
        </elements>
      </elements>
      <elements xsi:type="sysMLOC:ViewpointUsage" declaredName="'system structure perspective'">
        <elements xsi:type="sysMLOC:FramedConcernUsage" refElement="'system breakdown'"/>
      </elements>
      <elements xsi:type="sysMLOC:ViewUsage" declaredName="'system structure generation'">
        <elements xsi:type="sysMLOC:SatisfyRequirementUsage" refElement="'system structure perspective'"/>
        <elements xsi:type="sysMLOC:ExposeElement" declaredName="SystemModel::vehicle" isRecursive="true">
          <filterPackageExpression>@SysML::PartUsage</filterPackageExpression>
        </elements>
        <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asElementTable">
          <elements xsi:type="sysMLOC:ViewUsage">
            <redefinitions>columnView</redefinitions>
            <Multiplicity>1</Multiplicity>
            <elements xsi:type="sysMLOC:ViewRenderingUsage" refElement="asTextualNotation"/>
          </elements>
        </elements>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
