<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'14a-Language Extensions'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="'User Defined Extensions'" isNamespace="true"/>
    <elements xsi:type="sysMLOC:Package" declaredName="'User Defined Extensions'">
      <elements xsi:type="sysMLOC:EnumerationDefinition" declaredName="ClassificationLevel">
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="uncl"/>
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="conf"/>
        <elements xsi:type="sysMLOC:EnumeratedValue" declaredName="secret"/>
      </elements>
      <elements xsi:type="sysMLOC:MetadataDefinition" declaredName="Classified">
        <elements xsi:type="sysMLOC:ReferenceUsage">
          <typings>SysML::PartUsage</typings>
          <redefinitions>annotatedElement</redefinitions>
        </elements>
        <elements xsi:type="sysMLOC:AttributeUsage" declaredName="classificationLevel" Multi0="1">
          <typings>ClassificationLevel</typings>
        </elements>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part_X">
      <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Classified">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="classificationLevel" valuePart="ClassificationLevel::conf"/>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:CodeAnnotation" body="// Alternative shorthand notation&#xA;"/>
    <elements xsi:type="sysMLOC:PartUsage" declaredName="part_Y">
      <elements xsi:type="sysMLOC:MetadataUsage" metadataTyping="Classified">
        <elements xsi:type="sysMLOC:DefaultReferenceUsage" declaredName="classificationLevel" valuePart="ClassificationLevel::conf"/>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
