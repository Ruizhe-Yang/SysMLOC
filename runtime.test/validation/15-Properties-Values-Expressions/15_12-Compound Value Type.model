<?xml version="1.0" encoding="ASCII"?>
<sysMLOC:Namespace xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:sysMLOC="http://www.control.dut/sysmloc/SysMLOC">
  <elements xsi:type="sysMLOC:Package" declaredName="'15_12-Compound Value Type'">
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="ScalarValues" isNamespace="true"/>
    <elements xsi:type="sysMLOC:ImportElement" visibility="private" declaredName="USCustomaryUnits::'in'"/>
    <elements xsi:type="sysMLOC:Comment" body="/*&#xA;&#x9; * Real world user models would use quantity and vector types&#xA;&#x9; * from library models. They are included here for the purpose&#xA;&#x9; * of showing how such attribute defs can be defined.&#xA;&#x9; */"/>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="PositionVector">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="x">
        <typings>Real</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="y">
        <typings>Real</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="z">
        <typings>Real</typings>
        <Multiplicity>1</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="LengthValue">
      <superclassifiers>Real</superclassifiers>
    </elements>
    <elements xsi:type="sysMLOC:AttributeDefinition" declaredName="TireInfo">
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="manufacturer">
        <typings>String</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="hubDiameter">
        <typings>LengthValue</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="width">
        <typings>Integer</typings>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" declaredName="placement">
        <typings>PositionVector</typings>
        <Multiplicity>0</Multiplicity>
        <Multiplicity>1</Multiplicity>
      </elements>
    </elements>
    <elements xsi:type="sysMLOC:AttributeUsage" declaredName="frenchTireInfo">
      <typings>TireInfo</typings>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="&quot;Michelin&quot;">
        <redefinitions>manufacturer</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="18.0['in']">
        <redefinitions>hubDiameter</redefinitions>
      </elements>
      <elements xsi:type="sysMLOC:AttributeUsage" valuePart="245">
        <redefinitions>width</redefinitions>
      </elements>
    </elements>
  </elements>
</sysMLOC:Namespace>
